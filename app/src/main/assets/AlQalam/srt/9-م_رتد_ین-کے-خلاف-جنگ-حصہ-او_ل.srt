1
00:00:23,070 --> 00:00:24,531
اَعُوْذُ بِاللهِ مِنَّ الشِّيْطَانِ الرَّجِيْمِ۝

2
00:00:24,555 --> 00:00:25,880
بِسْمِ اللهِ الرَّحْمَانِ الرَّحِيْمَ۝

3
00:00:26,426 --> 00:00:32,357
اَلْحَمْدُ لله ، وَالصَّلَاةُ وَالسَّلَامُ عَلى سَيِّدِنَا محمد وَعَلَى اَلِهِ وَصَحْبِهِ وَسَلِّمْ تَسْلِيْمًا كَثِيْرا

4
00:00:34,303 --> 00:00:44,437
عرب کے چند قبائل کے سفیر مدینہ آئے

5
00:00:44,479 --> 00:00:52,167
وہ مسلمانوں کے خلیفہ حضرت ابوبکر صدیقؓ سے مذاکرات کرنے کے لیے آئے

6
00:00:52,202 --> 00:00:55,250
انہوں نے کہا؛ ہم نے کبھی اسلام سے رُوگردانی نہیں کی

7
00:00:55,301 --> 00:00:58,570
ہم گواہی دیتے ہیں اور ایمان رکھتے ہیں کہ اللہ کے سوا کوئی معبود نہیں

8
00:00:58,611 --> 00:01:01,527
اور یہ کہ حضرت محمدﷺ اللہ کے رسول ہیں

9
00:01:01,572 --> 00:01:11,110
انھوں نے کہا؛ اور ہم اللہ عَزَّوَجَلْ کی عبادت کرتے ہیں، لیکن ہم آپؓ کو زکوٰۃ ہرگز ادا نہیں کریں گے

10
00:01:11,153 --> 00:01:18,477
اور ان عرب قبائل نے بہت اعلیٰ سطح کے سفیر بھیجے

11
00:01:18,522 --> 00:01:25,257
اُن میں مدینہ کے معززین سے کچھ پرانے روابط رکھنے والے لوگ تھے

12
00:01:25,294 --> 00:01:32,273
چنانچہ فلاں سردار کے رفقاء نے اس مدنی سردار کے ہاں قیام کیا ، اور فلاں سردار کے دوست اُس انصاری کے پاس ٹھہرے

13
00:01:32,318 --> 00:01:35,378
اس لیے وہ قبائلی سفیر نہ صرف خلیفہ سے براہ راست مذاکرات کر رہے تھے

14
00:01:35,429 --> 00:01:43,327
بلکہ ان کے ساتھ مسلمانوں کے چند عمائدین بھی تھے، جو ان کی حمایت میں بول رہے تھے

15
00:01:43,379 --> 00:01:46,270
 اور اس سے سارا دباؤ خلیفہ پر بڑھتا جا رہا تھا

16
00:01:46,326 --> 00:01:54,903
 علاوہ ازیں، مذہبی نقطہ نظر سے صحابہ کے لیے یہ ابھی تک غیر مبہم تھا

17
00:01:54,950 --> 00:02:01,850
 حتیٰ کی حضرت عمر بن خطابؓ بھی اس معاملے پر خلیفہ حضرت ابوبکرؓ سے بحث و مباحثہ کر رہے تھے

18
00:02:01,893 --> 00:02:09,323
اب ایسا ہر گز نہیں تھا کہ حضرت عمر بن خطابؓ کسی دباؤ کے زیر أسکتے تھے، یا اُن قبائل کے ساتھ آپؓ کا کوئی تعلق تھا، نہیں

19
00:02:09,361 --> 00:02:15,620
آپؓ شرعی شواہد پر اپنے فہم کے مطابق بحث ومباحثہ فرما رہے تھے

20
00:02:15,655 --> 00:02:20,927
چنانچہ آپؓ خلیفہ کے پاس تشریف لائے اور فرمایا، اور یہ بخاری شریف میں مذکور ہے

21
00:02:20,981 --> 00:02:23,160
كيفَ تُقَاتِلُ النَّاسَ؟

22
00:02:23,913 --> 00:02:27,157
وقدْ قالَ رَسولُ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ

23
00:02:27,587 --> 00:02:32,397
 أُمِرْتُ أنْ أُقَاتِلَ النَّاسَ حتَّى يقولوا: لا إلَهَ إلَّا اللَّهُ،

24
00:02:32,622 --> 00:02:40,372
فمَن قالَهَا فقَدْ عَصَمَ مِنِّي مَالَهُ ونَفْسَهُ إلَّا بحَقِّهِ، وحِسَابُهُ علَى اللَّهِ

25
00:02:41,524 --> 00:02:45,387
حضرت عمر بن خطابؓ نے فرمایا ؛ آپؓ ان سے کیسے جنگ کر سکتے ہیں؟

26
00:02:45,476 --> 00:02:48,290
جب کہ رسول اللہؐ نے فرمایا؛

27
00:02:48,332 --> 00:02:55,123
"مجھے اللہ نے حکم دیا کہ لوگوں سے جنگ کروں، یہاں تک کہ وہ گواہی دیں کہ اللہ کے سوا کوئی معبود نہیں ہے"

28
00:02:55,173 --> 00:03:01,837
"اگر وہ ایسا کرتے ہیں تو انہوں نے خود کو اور اپنے مال کو محفوظ کرلیا"

29
00:03:01,887 --> 00:03:02,843
اب یہ حدیث ہے؛

30
00:03:02,883 --> 00:03:04,917
 أُمِرْتُ أنْ أُقَاتِلَ النَّاسَ

31
00:03:05,982 --> 00:03:13,263
 یہ مختلف اجتماعات میں بیان ہوئی، لیکن یہ حدیث متواتر ہے

32
00:03:13,297 --> 00:03:16,210
 مستند ترین حدیث ہے

33
00:03:16,249 --> 00:03:23,137
متواتر حدیث وہ حدیث ہے جو روایت در روایت مروی ہوتی چلی آرہی ہو

34
00:03:23,170 --> 00:03:27,133
اس کی تردید کرنا ناممکن ہو جاتا ہے

35
00:03:27,171 --> 00:03:30,650
یہ حدیث کی صداقت کی اعلیٰ ترین سطح ہے

36
00:03:30,684 --> 00:03:34,883
 بہت سارے صحابہ نے اس حدیث کا حوالہ دیا ہے، اُن میں سے چند نام ہیں؛

37
00:03:34,930 --> 00:03:38,390
حضرت ابوہریرہؓ،حضرت انس بن مالکؓ،حضرت ابن عباسؓ

38
00:03:38,426 --> 00:03:44,253
حضرت نعمان بن مشیرؓ، بہت سے صحابہ ہیں، میرے خیال میں بیس سے زائد صحابہ نے اس حدیث کو روایت کیا ہے

39
00:03:44,293 --> 00:03:58,480
اور یہ حدیث ؛ بخاری، مسلم ، ابو داؤد ، ترمذی، نسائی، ابن ماجہ، الحاکم، الدارمي، طبراني مسند امام احمد میں مذکور ہے

40
00:03:58,510 --> 00:04:01,816
پس اس حدیث کی روایت بہت مضبوط ہے اور حدیث کی نص ہے؛

41
00:04:01,840 --> 00:04:06,487
"مجھے لوگوں سے جنگ کرنے کا حکم دیا گیا، یہاں تک کہ وہ گواہی دیں کہ اللہ کے سوا کوئی معبود نہیں"

42
00:04:06,517 --> 00:04:12,218
اب جب اس حدیث کا حوالہ دیا گیا تو لوگ سمجھتے ہیں کہ یہ قرآن کی آیت کے برعکس ہے

43
00:04:12,243 --> 00:04:13,457
لَآ إِكْرَاهَ فِى ٱلدِّينِ ۖ

44
00:04:13,482 --> 00:04:15,853
دین میں کوئی جبر(زبردستی) نہیں

45
00:04:15,883 --> 00:04:19,719
کیونکہ آیت کہتی ہے؛ دین میں کوئی جبر نہیں ہے، جبکہ یہ حدیث کہتی ہے؛

46
00:04:19,744 --> 00:04:23,638
"مجھے حکم دیا گیا کہ لوگوں سے اس وقت تک لڑوں جب تک وہ گواہی نہ دیں کہ اللہ کے سوا کوئی معبود نہیں ہے"

47
00:04:23,662 --> 00:04:27,070
اور یہ کہ حضرت محمدﷺ اللہ کے رسول ہیں اور دوسری روایت میں ہے

48
00:04:27,115 --> 00:04:28,737
ويقيموا الصلواة ويؤتوا الزكوة

49
00:04:28,764 --> 00:04:32,207
اور وہ نماز قائم کریں اور زکوٰۃ دیں

50
00:04:32,253 --> 00:04:38,387
تو ہم اس(ان دو) نص اور متن کو کیسے یکجا کر سکتے ہیں؟

51
00:04:38,423 --> 00:04:49,957
 خیر، علماء کی طرف سے اس حدیث کا حوالہ دیتے ہوئے مختلف تشریحات دی گئیں ہیں؛ ان میں سے ایک یہ ہے کہ

52
00:04:49,995 --> 00:04:54,083
رسول اللہؐ کو لوگوں سے جنگ کرنے کا حکم دیا گیا

53
00:04:54,121 --> 00:05:00,553
جب تک وہ اسلام یا جزیہ قبول نہ کر لیں

54
00:05:00,583 --> 00:05:06,570
پس جزیہ قبول کر کے اگرچہ وہ مسلمان نہ ہوئے ہوں، لیکن اُنہوں نے اسلام کی حکمرانی قبول کرلی

55
00:05:06,604 --> 00:05:10,313
اُنہوں نے اللہ کے حکم کو تسلیم کیا

56
00:05:10,343 --> 00:05:15,030
اور یہ کہ پوری زمین پر اللہ عَزَّوَجَلْ کا قانون نافذ ہونا چاہیئے

57
00:05:15,077 --> 00:05:20,427
لیکن پھر انفرادی طور پر اسلام کو اُن پر مسلط نہیں کیا جا سکتا

58
00:05:20,465 --> 00:05:24,183
لہذا آپ کسی شخص پر جبراً مذہب مسلط نہیں کرسکتے

59
00:05:24,218 --> 00:05:28,873
کیونکہ یہ ایک ایسا معاملہ ہے جو عقائد پر مبنی ہے

60
00:05:28,911 --> 00:05:29,817
 یہ "من أعمال القلب" ہے ،

61
00:05:29,847 --> 00:05:35,634
یہ وہ چیز ہے جو کسی شخص کے دل میں ہوتی ہے آپ کسی شخص کو کسی چیز پہ قائل ہونے پر مجبور نہیں کر سکتے

62
00:05:35,683 --> 00:05:37,237
اس لیے دین میں جبر نہیں ہے

63
00:05:37,267 --> 00:05:44,217
لیکن جہاں تک اللہ تبارک وتعالٰی کے قانون کا تقاضہ ہے؛ لوگوں سے جنگ کرنے کی ضرورت ہے حتٰی کہ اللہ عَزَّوَجَلْ کا قانون نافذ نہ ہو جائے

64
00:05:44,247 --> 00:05:47,863
بہرحال، حضرت عمر بن خطابؓ خلیفہ کے پاس تشریف لائے اور فرمایا؛

65
00:05:47,888 --> 00:05:49,487
آپؓ ان سے کیسے جنگ کر سکتے ہیں، وہ کہہ رہے ہیں؛

66
00:05:49,525 --> 00:05:52,338
أشهدو ان لا إله إلا الله، واشهدو ان محمدًا رسول الله

67
00:05:52,362 --> 00:05:57,223
اور وہ نماز پڑھتے ہیں، آپؓ ان سے کیسے جنگ کر سکتے ہیں؟

68
00:05:57,269 --> 00:06:03,983
اب شاید حضرت عُمرؓ یا حضرت ابوبکرؓ اِس حدیث کی مختلف روایات سے ناواقف تھے

69
00:06:04,020 --> 00:06:06,697
 جو بیان کرتی ہے؛اور وہ نماز پڑھیں اور زکوٰۃ دیں

70
00:06:06,729 --> 00:06:10,003
کیونکہ اگر وہ اس روایت پر متفق ہوتے تو شاید بحث کی نوبت نہ آتی

71
00:06:10,034 --> 00:06:12,286
حضرت ابوبکر صدیقؓ کا ردِعمل کیا تھا؟

72
00:06:12,311 --> 00:06:14,423
 آپؓ نے فرمایا؛

73
00:06:14,492 --> 00:06:19,646
واللهِ لَأُقاتِلَنَّ مَن فرَّق بيْنَ الصَّلاةِ والزَّكاةِ؛

74
00:06:19,892 --> 00:06:30,080
فإنَّ الزكاةَ حَقُّ المالِ ، واللهِ لو مَنَعُونِي عَنَاقًا كانوا يُؤَدُّونها إلى رسولِ الله صلَّى اللهُ عليه وسلَّمَ لَقاتَلْتُهم على مَنْعِها

75
00:06:30,480 --> 00:06:37,123
 آپؓ نے فرمایا ؛اللہ کی قسم! میں اس شخص سے جنگ کروں گا جو نماز اور زکوٰۃ میں فرق رکھے گا

76
00:06:37,154 --> 00:06:39,980
 اور اگر وہ زکوٰۃ کی ادائیگی میں ایک اونٹ کی بھی کمی کریں گے

77
00:06:40,005 --> 00:06:44,105
اور دوسری روایت میں ہے کہ ایک رسی جس سے آپ اونٹ کی گردن باندھتے ہیں

78
00:06:44,135 --> 00:06:49,250
اگر وہ مجھے ادائیگی کرتے ہوئے اس کی بھی کمی کریں گے اور وہ رسول اللہؐ کو اس کی ادائیگی کرتے تھے، میں اس پر ان سے جنگ کروں گا

79
00:06:49,297 --> 00:06:50,757
حضرت عمر بن خطابؓ فرماتے ہیں؛

80
00:06:50,789 --> 00:06:54,717
جب میں نے حضرت ابوبکر صدیقؓ کے پُختہ نظریئے کو دیکھا

81
00:06:54,758 --> 00:06:57,293
میں سمجھ گیا کہ حقیقت یہی ہے

82
00:06:57,353 --> 00:07:03,477
چنانچہ یہاں پھرسے حضرت ابوبکر صدیقؓ اپنے بعد آنے والے خلفاء کے لیے اصول متعین فرما رہے ہیں

83
00:07:03,507 --> 00:07:06,353
حضرت عمر بن خطابؓ سوچ رہے تھے

84
00:07:06,407 --> 00:07:14,641
 آیا کہ کیا رسول اللہؐ کے بعد کسی شخص کا حق ہے؛ ان لوگوں سے جنگ کرنا، جو مسلمان ہونے کا دعویٰ کرتے ہیں

85
00:07:14,680 --> 00:07:18,997
لیکن وہ اسلام کے تمام احکام وفرائض کوادا نہیں کررہے؟

86
00:07:19,037 --> 00:07:20,474
لیکن حضرت ابوبکر صدیقؓ فرما رہے ہیں

87
00:07:20,498 --> 00:07:23,917
یہ خلیفہ کے عہدے کی زمہ داریوں میں سے ہے

88
00:07:23,956 --> 00:07:30,033
یہ اس شخص کے فرائض میں شامل ہے جو رسول اللہؐ کے وصال کے بعد آپؐ کا منصب سنبھال رہا ہے

89
00:07:30,079 --> 00:07:36,430
اور آپؓ اپنے بعد آنے والے خلفاء سے فرما رہے ہیں کہ اسلام کے قانون کو نافذ کرنا تمہاری ذمہ داری ہے

90
00:07:36,463 --> 00:07:40,017
 چاہے اس قانون کو توڑنے والے مسلمان ہونے کا دعویٰ ہی کیوں نہ کریں

91
00:07:40,047 --> 00:07:46,417
چنانچہ یہ ایک اور واقعہ اور مثال ہے جس میں حضرت ابوبکر صدیقؓ فقی اعتبار سے صحابہ پر غالِب آئے

92
00:07:46,442 --> 00:07:50,919
 اور یہ واقع بطور ِحق قائم ہوا، حالانکہ کہ حضرت عمرؓ اور کئی صحابہ بھی آپؓ کے خلاف تھے

93
00:07:50,972 --> 00:07:55,680
حضرت عمرؓ نے فرمایا کہ مجھے احساس ہوا کہ آپؓ کی رائے درست تھی

94
00:07:55,710 --> 00:08:07,570
پس ایک بار پھر، یہ سب اسلامی سیاست سے متعلق مسائل ہیں،یا آپ کہہ سکتے ہیں کہ یہ وہ اختیارات ہیں جو صرف مسلم خلیفہ سرانجام دے سکتا ہے

95
00:08:07,615 --> 00:08:11,793
تو حضرت ابوبکرؓ ایک سنت قائم کر رہے تھے

96
00:08:11,827 --> 00:08:19,137
آپؓ نے تمام مندوبین پر یہ بات واضح کردی اور وہ بغیر کسی معاہدے کے چلے گئے

97
00:08:19,184 --> 00:08:24,987
اب حضرت عمر بن خطابؓ، حضرت ابوبکر صدیقؓ کے پاس گئے اور فرمایا؛

98
00:08:25,075 --> 00:08:30,323
یا خليفة رسول الله تعلف الناس ورفق بهم

99
00:08:31,108 --> 00:08:34,190
 حضرت عمر بن خطابؓ نے فرمایا ؛ اے خلیفہ رسول اللہؐ

100
00:08:34,249 --> 00:08:35,177
تعلف الناس

101
00:08:35,207 --> 00:08:36,463
انہیں قریب لائیں

102
00:08:36,489 --> 00:08:37,354
ورفق بھم

103
00:08:37,380 --> 00:08:39,687
ان کے ساتھ نرمی کرو

104
00:08:39,744 --> 00:08:42,650
آپؓ نے فرمایا؛ آپؓ جانتے ہیں کہ ہم جس صورتحال سے دوچار ہیں

105
00:08:42,719 --> 00:08:45,977
آپؓ کو نرمی برتنے کی ضرورت ہے، آپؓ کو لوگوں کے ساتھ باہم لین دین کی ضرورت ہے

106
00:08:46,023 --> 00:08:49,993
فرمایا؛ آپؓ کو انہیں لچکدار پہلو دکھانے کی ضرورت ہے

107
00:08:50,030 --> 00:08:57,908
ظاہر ہےحضرت عمر بن خطابؓ کا یہ بیان آپ کو عجیب لگے گا

108
00:08:57,933 --> 00:08:59,900
یہ وہ حضرت عمرؓ نہیں ہیں جن سے ہم واقف ہیں

109
00:08:59,930 --> 00:09:05,070
لیکن حضرت عمر بن خطابؓ نے درپیش حالات و واقعات کو مدنظر رکھے ہوئے تھے

110
00:09:05,100 --> 00:09:11,900
 میرا مطلب ہے کہ، مدینہ خطرے میں ہے، بلکہ پورا مذہب خطرے میں ہے، مسلم معاشرہ خطرے میں ہے

111
00:09:11,945 --> 00:09:15,378
حضرت عمر بن خطابؓ کسی مذہبی مسئلے پر مذاکرات کرنے کو نہیں کہہ رہے تھے

112
00:09:15,408 --> 00:09:20,137
لیکن آپؓ صرف اتنا کہہ رہے تھے کہ ان قبائل کے ساتھ تھوڑا سا لچکدار رویہ اختیار کریں

113
00:09:20,172 --> 00:09:23,037
کم از کم وہ مسلمان ہونے کا دعویٰ تو کرتے ہیں

114
00:09:23,068 --> 00:09:27,930
لہذا، ان کے ساتھ مصالحت کریں اور ایک معاہدہ طے کرنے کی کوشش کریں

115
00:09:27,981 --> 00:09:29,587
حضرت ابوبکرؓ کا ردِعمل کیا تھا؟

116
00:09:29,617 --> 00:09:33,370
حضرت ابوبکرؓ نے حضرت عمر بن خطابؓ کی داڑھی پکڑلی اور فرمایا؛

117
00:09:33,404 --> 00:09:38,563
يا أبن الخطاب : ألجبارٌ في الجاهلية خوارٌ في الإسلام

118
00:09:38,613 --> 00:09:43,650
آپؓ نے فرمایا ؛ اے ابن خطابؓ ! آپؓ مسلمان ہونے سے پہلے جابر تھے

119
00:09:43,689 --> 00:09:50,057
اور اب جب آپؓ مسلمان ہو چکے ہیں تو آپؓ اپاہج، ضعیف اور کمزور بننا چاہتے ہیں

120
00:09:50,110 --> 00:09:51,870
اور پھر فرمایا؛

121
00:09:51,905 --> 00:09:55,863
إنه قد انقطع الوحي وتم الدين أينقص وأنا حي ؟

122
00:09:55,894 --> 00:10:00,397
 آپؓ نے فرمایا ؛ کہ حضرت محمدﷺ دین کو مکمل کر کے گئے ہیں

123
00:10:00,447 --> 00:10:04,843
کیا آپ کو لگتا ہے کہ میں اس میں تخفیف ہونے دوں گا، جب تک میں زندہ ہوں؟

124
00:10:04,881 --> 00:10:08,503
میں اللہ عَزَّوَجَلْ کے دین میں کمی نہیں ہونے دوں گا

125
00:10:08,539 --> 00:10:12,317
جب تک میں زندہ ہوں میں اس دیں کو پستی کی طرف نہیں جانے دوں گا

126
00:10:12,361 --> 00:10:15,635
جب تک میں زندہ ہوں اس مذہب کی خاطر برسرِپیکار رہوں گا

127
00:10:15,681 --> 00:10:23,040
چنانچہ حضرت ابوبکر صدیقؓ جنہیں کئی قبیلے نومولود اونٹ کا باپ پکار رہے تھے

128
00:10:23,070 --> 00:10:29,270
آپؓ ان کی سوچ کے برعکس شخصیت ثابت ہو رہے تھے

129
00:10:29,317 --> 00:10:32,543
 حضرت ابوبکرصدیقؓ سفیروں کے جانے کے بعد صحابہ کے پاس تشریف لائے

130
00:10:32,593 --> 00:10:33,967
اور آپؓ نے ان سے فرمایا؛

131
00:10:33,999 --> 00:10:38,518
إن الارض كافرة، وقد رأى وفدهم منكم قلة،

132
00:10:39,336 --> 00:10:43,040
وإنكم لا تدرون اليلا تؤتون أم نهارا

133
00:10:43,565 --> 00:10:50,097
وأدناهم منكم على بريد، وقد كان القوم يؤملون أن نقبل منهم ونوادعهم

134
00:10:50,121 --> 00:10:55,468
 وقد أبينا عليهم، ونبضنا علیھم فاستعدوا وأعدوا

135
00:10:56,750 --> 00:10:59,310
حضرت ابوبکر صدیقؓ نے مسلمانوں کو جمع کرنے کے بعد فرمایا؛

136
00:10:59,365 --> 00:11:06,110
زمین کفر کی تاریکی میں ڈوب چکی ہے اور ان کے وفد نے دیکھا کہ آپ چند ہی لوگ ہیں

137
00:11:06,153 --> 00:11:11,376
یہ نہ ہو کہ آپ لوگ بے خبر رہیں؛ آپ پر دن یا رات میں چڑھائی ہوسکتی ہے

138
00:11:11,415 --> 00:11:14,608
کچھ قبائل محض آپ سے چند لمحوں کی مسافت پر ہیں

139
00:11:14,668 --> 00:11:19,395
وہ قبائل جو امید کر رہے تھے کہ ہم انہیں قبول کر لیں گے اور ان کے ساتھ مصالحت کر لیں گے

140
00:11:19,436 --> 00:11:24,223
لیکن ہم نے انکار کر دیا اور ان کے معاہدے کو منسوخ کردیا، لہذا تیار ہو جاؤ

141
00:11:24,272 --> 00:11:28,170
 آپؓ نے فرمایا؛ وہ ہم سے معاہدہ کرنا چاہتے تھے لیکن ہم نے انکار کر دیا

142
00:11:28,200 --> 00:11:31,583
اور وہ لوگ مدینہ آئے اور انہوں نے دیکھا ہے کہ ہم تعداد میں کتنے کم ہیں

143
00:11:31,608 --> 00:11:35,770
کیونکہ جب انہوں نے حضرت اسامہؓ کے لشکر کو دیکھا تو ان کا خیال تھا کہ

144
00:11:35,814 --> 00:11:37,723
شاید مدینہ میں بھی اتنی ہی بڑی فوج موجود ہو

145
00:11:37,748 --> 00:11:42,040
لیکن اب جب مدینہ آئے تو حقیقت دیکھی، کہ یہاں زیادہ لوگ نہیں تھے

146
00:11:42,085 --> 00:11:47,777
پس مسلمانوں کی کمزوری ان کی تعداد کی کمی کے حوالے سے کُھل کر سامنے آگئی

147
00:11:47,824 --> 00:11:51,583
اور آپؓ نے فرمایا ؛ مستعد رہو، کیونکہ وہ کسی بھی وقت ہم پر حملہ آور ہو سکتے ہیں

148
00:11:51,614 --> 00:11:55,850
اسلام کے دفاع کے لیےحضرت ابوبکر صدیقؓ کا منصوبہ کیا تھا؟

149
00:11:55,880 --> 00:11:59,204
نمبر ایک، آپؓ نے سپاہیوں کو مسجد کی قیام گاہ میں سُلایا

150
00:11:59,229 --> 00:12:03,023
 تاکہ وہ مدینہ کی حفاظت کے لیے ہمہ وقت مستعد رہیں

151
00:12:03,056 --> 00:12:07,303
 آپؓ نہیں چاہتے تھے کہ کوئی بھی اپنے گھر میں ٹھہرے

152
00:12:07,344 --> 00:12:13,387
 آپؓ کے پاس فوج تیار تھی، اور انہوں نے مسجد نبوی میں اپنا مرکز بنایا

153
00:12:13,426 --> 00:12:13,900
یہ نمبر ایک ہے

154
00:12:13,925 --> 00:12:15,166
نمبر دو،

155
00:12:15,191 --> 00:12:21,137
مدینہ کی طرف جانے والے تمام پہاڑی راستوں پر آپؓ کے محافظ تھے

156
00:12:21,169 --> 00:12:27,513
تاکہ وہ مدینہ میں مسلمانوں کو کسی بھی قسم کے حملے کی صورت میں پیشگی اطلاع دے سکیں

157
00:12:27,543 --> 00:12:31,077
اور آپؓ نے ان محافظوں پر امیر مقرر فرمائے،

158
00:12:31,117 --> 00:12:34,307
حضرت علی ابن ابی طالبؓ اور حضرت زبیر بن عوامؓ، حضرت طلحہ بن عبيد اللہؓ

159
00:12:34,331 --> 00:12:37,197
اور حضرت سعد بن ابی وقاصؓ، حضرت عبدالرحمن بن عوفؓ

160
00:12:37,233 --> 00:12:38,677
اورحضرت عبداللہ بن مسعودؓ

161
00:12:38,710 --> 00:12:45,130
یہ اُن محافظ دستوں کے سالار تھے جو مدینہ کو ہر سمت سے گھیرے ہوئے تھے

162
00:12:45,171 --> 00:12:51,822
اور تیسرے نمبر پر،آپؓ نے مدینہ کے گردوپیش کے اُن عرب قبائل کو متحرک کرنے کی کوشش کی، جو ابھی تک مسلمان تھے

163
00:12:51,869 --> 00:12:58,403
جیسے کہ غفار اور جہینہ اور اسلم؛ اور ان بدو قبائل نے بہت امداد کی

164
00:12:58,484 --> 00:13:06,100
 مثال کے طور پر جہینہ قبیلے نے بہت سے اونٹ مدینہ میں بھیجے، اور انہوں نے یہ اونٹ خلیفہؓ کی ملکیت میں دے دیے،

165
00:13:06,130 --> 00:13:12,193
آپؓ جیسے مناسب سمجھیں انہیں استعمال کریں، تو انہوں نے کچھ مدد کی

166
00:13:12,224 --> 00:13:15,543
تین دن کے اندر، جیسا کہ خلیفہ کی توقع تھی

167
00:13:15,627 --> 00:13:21,663
 جو قبائل مدینہ میں آئے تھے انہوں نے مدینہ پر حملہ کرنے کے لیے لشکر تیار کیا

168
00:13:21,711 --> 00:13:24,717
اور انہوں نے مدینہ پر چڑھائی کی

169
00:13:24,757 --> 00:13:31,447
تو اُن قبائل کا سامنا، اُن صحابہ سے ہوا جو اونٹوں پرسوار ہوکر لڑ رہے تھے

170
00:13:31,488 --> 00:13:37,931
 اب دشمن نے اونٹوں کو ڈرانے کا یہ عجیب طریقہ ڈھونڈ نکالا

171
00:13:37,956 --> 00:13:43,370
  اُنھوں نے جانوروں کی کھال سے بنے غباروں کی مانند گولے استعمال کیے

172
00:13:43,412 --> 00:13:51,723
غبارے جنہیں وہ پُھلاتے اور پھر ان غباروں کو اونٹوں کے آگے  لڑھکا دیتے

173
00:13:51,757 --> 00:13:59,277
اور اں غباروں کو ٹھوکر مارنے سے یہ اونٹوں کے آگے لڑھک گئے، اور اس سے اونٹ ڈر کر بدک گئے اور اونٹ بھاگ گئے

174
00:13:59,332 --> 00:14:08,383
 اونٹ اس قدر خوف میں مبتلاء ہوئے کہ اونٹ پلٹے اور تمام صحابہ کو ساتھ۔ لیئے مدینہ لوٹ گئے

175
00:14:08,442 --> 00:14:15,150
پس اونٹ بے قابو ہو گئے اور صحابہ انہیں واپس نہ لا سکے

176
00:14:15,197 --> 00:14:20,410
اس سے دشمن یہ سمجھے کہ مسلمان کمزور ہیں اس لیئے وہ بھاگ گئے

177
00:14:20,449 --> 00:14:27,517
پس یہ اللہ کی قدرت تھی کہ انہیں اس طرح گھسیٹ کر مدینہ لے جایا جائے

178
00:14:27,547 --> 00:14:31,780
اس دوران حضرت ابوبکر صدیقؓ ایک بڑا لشکر تیار کر رہے تھے

179
00:14:31,827 --> 00:14:39,263
اور آپؓ نے خود ہی اس لشکر کی قیادت کی اور آپؓ رات کے وقت دشمن پر گھات لگانے کے لیے نکلے

180
00:14:39,298 --> 00:14:42,924
 اور دشمن کو معلوم نہ تھا کہ مسلمان آ رہے ہیں

181
00:14:42,949 --> 00:14:46,187
  دشمن کو امید نہیں تھی کہ مسلمان ان کا سامنا کرنے آئیں گے

182
00:14:46,210 --> 00:14:50,163
اور اچانک ہر غیر متوقع سمت سے مسلمان ان پر حملہ آور ہوئے

183
00:14:50,193 --> 00:14:53,317
فجر سے پہلے جب ابھی اندھیرا تھا

184
00:14:53,356 --> 00:15:00,010
چنانچہ جب سورج طلوع ہو رہا تھا، دشمن پیٹھ پھیر کر بھاگ رہا تھا

185
00:15:00,041 --> 00:15:02,800
 اور یہ پہلی فتح تھی جو مسلمانوں کو نصیب ہوئی

186
00:15:02,844 --> 00:15:05,288
اوریہ وہ فتح تھی جسے انہوں نے بدائة الفتح کہا

187
00:15:05,328 --> 00:15:07,663
یہ فتوحات کے سلسلے کا آغاز تھا

188
00:15:07,712 --> 00:15:16,367
یہ خبر پھیل گئی تو اسی رات صحابہ کرام نے کچھ لوگوں کو مدینہ آتے ہوئے دیکھا

189
00:15:16,387 --> 00:15:20,737
اور وہ ہمیشہ کی طرح یہ سمجھے کہ یہ دشمن کا حملہ ہے

190
00:15:20,777 --> 00:15:25,263
اور حضرت ابوبکر صدیقؓ نے صحابہ سے فرمایا ؛ نہیں! یہ خوشخبری ہے

191
00:15:25,309 --> 00:15:28,977
اور وہ سمجھ گئے کہ یہ لوگ اپنی زکوٰۃ لے کر آئے ہیں

192
00:15:29,022 --> 00:15:32,530
ان میں سے بعض قبائل اپنی زکوٰۃ ادا کرنے آئے

193
00:15:32,589 --> 00:15:36,177
ایک قبیلہ آیا اور رات کے پہلے پہر میں اپنی زکوٰۃ ادا کر گیا

194
00:15:36,222 --> 00:15:41,623
دوسرا قبیلہ آدھی رات، اور تیسرا قبیلہ رات کے آخری پہر میں زکوٰۃ ادا کرنے آیا

195
00:15:41,675 --> 00:15:46,040
تو فوراً ہی ایک دن کے اندر، چیزیں بدل رہی تھیں، اور پلٹ رہی تھیں

196
00:15:46,083 --> 00:15:49,097
حضرت ابوبکر صدیقؓ دوبارہ جنگ کے لیے روانہ ہوئے

197
00:15:49,131 --> 00:15:52,650
حضرت علی ابن ابی طالبؓ اور دیگر صحابہ کرامؓ،حضرت ابوبکرؓ کے پاس حاضر ہوئے اور عرض کی؛

198
00:15:52,700 --> 00:15:57,270
"آپؓ باہر نکل کر خود جنگ نہ لڑیں، کسی کو لشکر کی قیادت کے لیے مقرر فرمائیں"

199
00:15:57,309 --> 00:16:01,063
"کیونکہ اگر آپؓ شہید ہو گئے تو مسلمانوں کے لیے یہ بہت بڑی مشکل ہوجائے گی"

200
00:16:01,103 --> 00:16:04,757
"اور یہ اللہ کے دشمنوں کے لیے بہت بڑی فتح ہوگی"

201
00:16:04,819 --> 00:16:10,223
صحابہ نے فرمایا؛"کسی اور کو زمہ دار بنائیں کہ وہ اِن جنگوں کی قیادت کرے"

202
00:16:10,253 --> 00:16:13,857
حضرت ابوبکر صدیقؓ نے فرمایا؛ نہیں! میں پیچھے کھڑا نہیں رہوں گا

203
00:16:13,906 --> 00:16:18,290
"اور میں آپ کو اپنی ذات کے ذریعے ایک مثال دوں گا"

204
00:16:18,330 --> 00:16:23,663
"چنانچہ ایک عمر رسیدہ شخص جو اپنی زندگی کے ساٹھ برس گزار چُکا تھا"

205
00:16:23,716 --> 00:16:26,470
"وہ خود جنگ کی قیادت کر رہا تھا اور لڑ رہا تھا"

206
00:16:26,508 --> 00:16:32,597
اور آپؓ نے یہ کام لگاتار تین مہمات میں کیا

207
00:16:32,643 --> 00:16:34,730
حضرت ضرار ابن ازورؓ

208
00:16:34,772 --> 00:16:37,906
آپ کو یہ بتانے کے لیے کہ حضرت ابوبکر صدیقؓ حالات سے کیسے نمٹ رہے تھے

209
00:16:37,930 --> 00:16:41,143
میرا مطلب ہے، یہ ایسے واقعات ہیں جو بہت تیزی سے رونما ہو رہے تھے

210
00:16:41,182 --> 00:16:44,480
رسول اللہؐ کا وصال، خلیفہ کی تقرری، ردّہ

211
00:16:44,521 --> 00:16:45,858
مرتدین کے خلاف جنگ

212
00:16:45,898 --> 00:16:55,163
عرب کے کونے کونے سے خبریں آرہی تھیں کہ فوجیں جمع ہو رہی ہیں اور مسلمانوں پر حملہ کرنے کی تیاری کر رہی ہیں

213
00:16:55,217 --> 00:17:00,084
اورحضرت ابوبکر صدیقؓ ان تمام تباہ کن خبروں سے کیسے نمٹے؟

214
00:17:00,138 --> 00:17:02,103
جو ہر سمت سے آرہی تھیں

215
00:17:02,142 --> 00:17:09,133
حضرت ضرار بن ازورؓ، جو طلیحہ اسدی کے خلاف شمال مشرق کی طرف مہم کی قیادت کر رہے تھے

216
00:17:09,158 --> 00:17:14,257
 طلیحہ اسدی ان تین اشخاص میں سے ایک تھا جنہوں نے رسول اللہؐ کے دور میں نبوت کا دعویٰ کیا تھا

217
00:17:14,291 --> 00:17:17,983
اور حالات مزید بدترین ہوگئے جب رسول اللہؐ کا وصال ہوا

218
00:17:18,015 --> 00:17:21,520
طلیحہ کی دعوت جنگل کی آگ کی طرح تیزی سے پھیل رہی تھی

219
00:17:21,554 --> 00:17:29,657
لہٰذا اس کی فوج میں روز بروز اضافہ ہوتا جا رہا تھا، وہ زیادہ سے زیادہ جنگجو حاصل کر رہا تھا

220
00:17:29,687 --> 00:17:35,170
چنانچہ ایک صحابی حضرت ضرار بن ازورؓ، جو طلیحہ سے جنگ کرنے والے لشکر کی قیادت پر مامور تھے

221
00:17:35,203 --> 00:17:39,770
 آپؓ مدینہ واپس آئے اور حضرت ابوبکر صدیقؓ کو اہم معلومات دیں

222
00:17:39,813 --> 00:17:41,267
اور آپؓ نے فرمایا؛

223
00:17:41,307 --> 00:17:46,597
فما رأيت أحدا ليس رسول الله صلى الله عليه وسلم أملا بحرب شعواء من أبى بكر

224
00:17:46,788 --> 00:17:50,732
فجعلنا نخبره ولك أنَّما نخبره بما له لا ما عليه

225
00:17:51,556 --> 00:17:55,740
 آپؓ فرماتے ہیں؛ میں نے رسول اللہؐ کے بعد کسی شخص کو نہیں دیکھا

226
00:17:55,775 --> 00:18:01,650
جو حضرت ابوبکر صدیقؓ کی طرح آڑے وقت میں پُرسکون ہو

227
00:18:01,683 --> 00:18:04,636
حضرت ضرارؓ فرماتے ہیں کہ میں آپؓ کو طلیحہ اسدی کے متعلق خبر پہنچاتا

228
00:18:04,667 --> 00:18:10,717
اور ایسا محسوس ہوتا جیسے میں آپؓ کو خوشخبری دے رہا ہوں اور آپؓ کو بری خبر نہیں دے رہا

229
00:18:10,780 --> 00:18:14,870
چنانچہ آپؓ،حضرت ابوبکر صدیقؓ سے پوچھتے، وہ بعد میں بتاتے ہیں؛

230
00:18:14,909 --> 00:18:23,537
لقد نزل بك مالو نزل بالجبال لهاضها وبالبحار لغاظها ومانراك ضعفت

231
00:18:23,588 --> 00:18:28,790
انہوں نے آپؓ سے فرمایا؛ آپؓ اپنے کندھے پر ایک بھاری زمہ داری کا بوجھ اٹھائے ہوئے ہیں

232
00:18:28,823 --> 00:18:33,203
اگر اسے پہاڑ کی چوٹی پر رکھا جائے تو وہ بھی بکھر جائے

233
00:18:33,238 --> 00:18:38,197
اور اگر اسے سمندروں پر رکھا جائے تو وہ پانی سے خالی ہو جائے

234
00:18:38,248 --> 00:18:40,597
اور ہم نے کبھی نہیں دیکھا کہ آپؓ کبھی کمزور پڑے ہوں

235
00:18:40,637 --> 00:18:42,850
حضرت ابوبکر صدیقؓ نے فرمایا؛

236
00:18:42,868 --> 00:18:48,587
  غار ثور میں رسول اللہؐ کے ہمراہ دن گزارنے کے بعد میں نے کبھی خوف محسوس نہیں کیا

237
00:18:48,643 --> 00:18:53,757
 اس دن میں ڈر گیا تھا، میں نے رسول اللہؐ سے عرض کیا؛

238
00:18:53,792 --> 00:18:58,503
اگر ان(کفار) میں سے کوئی نیچے اپنے پیروں کے جانب دیکھے تو وہ ہمیں دیکھ لیں گے

239
00:18:58,534 --> 00:19:04,277
 رسول اللہؐ نے مجھ سے فرمایا کہ اُن دو کے بارے میں تمہارا کیا خیال ہے اور جن کے ساتھ تیسری زات اللہ کی ہے

240
00:19:04,323 --> 00:19:06,247
اور اللہ عَزَّوَجَلْ فرماتا ہے؛

241
00:19:06,278 --> 00:19:08,920
فأنزل سكينته عليه

242
00:19:09,096 --> 00:19:11,863
اللہ عَزَّوَجَلْ نے اُن پرسکون نازل فرمایا

243
00:19:11,897 --> 00:19:16,490
تو رسول اللہؐ اور حضرت ابوبکر صدیقؓ دونوں کو سکون عطاء ہوا

244
00:19:16,524 --> 00:19:19,243
تو حضرت ابوبکرؓ کو کوئی خوف کیسے ہو سکتا ہے

245
00:19:19,277 --> 00:19:23,747
اس کے بعد کہ اللہ سبحانہ وتعالی نے غار میں ان دونوں(رسول اللہؐ اور حضرت ابوبکرؓ) پر سکون نازل فرمایا

246
00:19:23,791 --> 00:19:26,478
 آپؓ نے فرمایا؛ اس کے بعد میں نے کبھی خوف محسوس نہیں کیا

247
00:19:26,508 --> 00:19:33,823
اور ان تمام آزمائش کے طوفانوں کے سامنے آپؓ کتنے پُرسکون اور ثابت قدم رہے

248
00:19:33,858 --> 00:19:40,783
حضرت ابوبکر صدیقؓ نے مرتدین سے جنگ کرنے کے لیے مختلف طریقے اپنائے

249
00:19:40,822 --> 00:19:45,537
 آپؓ نے گیارہ لشکر مختلف سمتوں میں مرتدین کی سرکوبی کے لیے روانہ کیے

250
00:19:45,603 --> 00:19:54,497
 آپؓ نے مرتد قبائل کے اندر مسلمانوں کو مستحکم کرنے کا طریقہ بھی استعمال کیا

251
00:19:54,541 --> 00:20:01,263
کیونکہ ارتداد ایک ایسی تحریک کی طرح نہیں تھا جہاں سب اسلام سے منحرف ہو گئے ہوں

252
00:20:01,296 --> 00:20:05,237
بعض صورتوں میں، ایک پورا قبیلے نے اسلام کو ترک کردیا

253
00:20:05,278 --> 00:20:09,783
بعض صورتوں میں، قبیلے کی اکثریت

254
00:20:09,824 --> 00:20:12,403
بعض صورتوں میں قبیلے کی اقلیت نے اسلام کو ترک کردیا

255
00:20:12,447 --> 00:20:16,110
بعض صورتوں میں قبائل اسلام پر قائم اور ثابت قدم تھے

256
00:20:16,160 --> 00:20:21,410
چنانچہ حضرت ابوبکر صدیقؓ جب بھی کسی قبیلے کے بارے میں سنتے جو مرتد ہو گیا

257
00:20:21,443 --> 00:20:25,230
 آپؓ اندرون خانہ مسلمانوں کے ساتھ روابط قائم کرنے کی کوشش کرتے

258
00:20:25,277 --> 00:20:31,880
اور عہدیداران کو اُن قبائل کی ذمہ داری سونپتے کہ اُن کو اسلام میں واپس لایا جائے یا اُن سے لڑا جائے

259
00:20:31,914 --> 00:20:35,757
کیونکہ آپؓ انصار اور مہاجرین پر بوجھ کم کرنا چاہتے تھے

260
00:20:35,808 --> 00:20:42,103
مہاجرین اور انصار ایک ہی وقت میں ہر ایک قبیلے سے نہیں لڑ سکتے تھے

261
00:20:42,159 --> 00:20:46,410
چنانچہ آپؓ نے زمہ داری سونپنا چاہی، مثال کے طور پر یمن میں

262
00:20:46,456 --> 00:20:50,697
حضرت ابوبکر صدیقؓ نے اسود انسی سے نمٹنے کے لیے کوئی فوج نہیں بھیجی

263
00:20:50,743 --> 00:20:57,230
بلکہ آپؓ نے وہیں موجود مومنین کے ساتھ روابط قائم کرنے کی کوشش کی

264
00:20:57,262 --> 00:21:08,557
کیونکہ آپؓ اس وقت خطرناک ترین مرتدین سے لڑنے کے لیے صحابہ کو وقف کرنا چاہتے تھے، جوکہ مسیلمہ کذاب اور  طلیحہ اسدی کا ردّہ تھا

265
00:21:08,622 --> 00:21:12,303
چونکہ یہاں آپؓ کے سامنے مسیلمہ تھا، آپ کے پاس طلیحہ اسدی تھا

266
00:21:12,341 --> 00:21:17,213
اور آپؓ کے شمال میں سجاح نامی عورت تھی اور پھر یمن میں آپؓ کا سامنا اسود عنسی سے تھا

267
00:21:17,251 --> 00:21:24,223
آپؓ خطوط کا طریقہ بھی استعمال کرتے تھے، خطوط بھیجتے تھے، مرتدین کو دعوت دیتے تھے

268
00:21:24,261 --> 00:21:30,857
 اور آپؓ نے ان پر واضح کر دیا کہ میں تم سے ماسوائے اسلام کے کسی بات کی توقع نہیں رکھتا

269
00:21:30,892 --> 00:21:36,440
اور اگر تم مذہب کے دائرہ میں واپس نہ آئے تو تمہیں تلوار کا سامنا کرنا پڑے گا

270
00:21:36,486 --> 00:21:40,380
 آپؓ ان شرائط کو واضح فرما رہے تھے

271
00:21:40,432 --> 00:21:43,283
آئیے شروع کرتے ہیں اسود عنسی سے

272
00:21:43,339 --> 00:21:48,647
اسود عنسی یمن میں صنعاء کے قریب عنس سے تھا

273
00:21:48,690 --> 00:21:54,503
 اس نے دس ہجری میں رسول اللہؐ کے دور میں نبوت کا دعویٰ کیا

274
00:21:54,536 --> 00:21:59,430
اور وہ شیاطین سے وحی حاصل کرتا تھا

275
00:21:59,467 --> 00:22:05,330
  اس شخص کا تعلق شیطان سے تھا ، اس کے قبضے میں جنات تھیں

276
00:22:05,375 --> 00:22:13,510
اس نے آغاز میں اپنا مشن چھپ کر شروع کیا اور پھر اس نے نبوت کا اعلان کردیا

277
00:22:13,550 --> 00:22:19,703
اور اچانک اس کی دعوت تیزی سے پھیلنے لگی

278
00:22:19,742 --> 00:22:25,220
شروع میں اسود نے اہل عنس کو اپنے فتنے کی لپیٹ میں لے لیا اور پھر یہ پھیلنا شروع ہوگیا

279
00:22:25,255 --> 00:22:28,373
اور پھر وہ صنعاء کی طرف بڑھا

280
00:22:28,409 --> 00:22:31,597
اور اسود نے شھر بن باذان سے جنگ کی

281
00:22:31,628 --> 00:22:37,490
جب یمن میں اسلام آیا تو صنعا پر ایک فارسی خاندان کی حکومت تھی

282
00:22:37,526 --> 00:22:44,130
کیونکہ یمن پر کچھ عرصہ پہلے ابرہہ اشرم نے چڑھائی کی تھی، اور قابض رہا تھا

283
00:22:44,176 --> 00:22:47,862
چنانچہ انہوں نے اپنی معاونت کے لیے سلطنت فارس سے مدد طلب کی

284
00:22:47,886 --> 00:22:53,423
چنانچہ فارس(ایران) نے یمن کی طرف ایک لشکر روانہ کیا جس نے ابرہہ سے جنگ کی اور اسے شکست دی

285
00:22:53,467 --> 00:22:59,083
اور پھر انہوں نے اقتدار سنبھال لیا، چنانچہ یمن میں بچے کُچے فارسی موجود تھے

286
00:22:59,131 --> 00:23:04,230
جب رسول اللہؐ نے اسلام کی دعوت دینے کے لیے اُنھیں خطوط بھیجے

287
00:23:04,285 --> 00:23:05,700
یہ فارسی مسلمان ہو گئے

288
00:23:05,734 --> 00:23:10,517
باذان جو اس وقت صنعاء پرحکومت کررہا تھا، وہ مسلمان ہو گیا

289
00:23:10,566 --> 00:23:18,060
اور رسول اللہؐ نے اسے(باذان کو) صنعاء کے گورنر کے عہدے پر فائز کیا

290
00:23:18,100 --> 00:23:21,211
اور رسول اللہؐ نے اسے پورے یمن پر حکومت کرنے کے لیے مقرر فرمایا

291
00:23:21,254 --> 00:23:26,760
جب اُن کا انتقال ہو گیا، تو رسول اللہؐ نے یمن کا مختلف ریاستوں میں بٹوارا کردیا

292
00:23:26,793 --> 00:23:31,623
اور بازان کا بیٹا صنعاء پر حکومت کرتا رہا، اُن کے بیٹے کا نام "شھر" ہے

293
00:23:31,663 --> 00:23:35,143
اسود عنسی اب صنعاء پر چڑھائی کررہا تھا

294
00:23:35,196 --> 00:23:40,357
اور اس کا سامنا شھر بن باذان سے شعب میں ہوا، جو صنعاء کے ساتھ واقعہ ہے

295
00:23:40,396 --> 00:23:44,997
اور اسود نے اسے شکست دی، چنانچہ اب اسود عنسی صنعاء پر حکومت کر رہا تھا

296
00:23:45,028 --> 00:23:48,517
اور پھر اس نے اپنے لشکر بھیجے، اور وہ نجران پر قابض ہوا

297
00:23:48,573 --> 00:23:50,810
اور یہاں تک کہ وہ لحج تک پہنچ گیا

298
00:23:50,860 --> 00:23:55,977
اس لیے اسود کا دائرہ کار بڑھتا چلا جا رہا تھا

299
00:23:56,028 --> 00:24:03,860
رسول اللہؐ نے یمن میں اپنے أمراء کو پیغام بھیجا

300
00:24:03,893 --> 00:24:11,377
اسود عنسی کے فتنہ کو طاقت یا چالبازی سے کچلا جائے،

301
00:24:11,408 --> 00:24:15,090
 مطلب آپ یا تو اندرونی طور پر اُس سے نمٹیں

302
00:24:15,122 --> 00:24:21,170
یا پھر آپ بیرونی قوتوں اور افواج کی مدد سے اس کا سامنا کریں

303
00:24:21,210 --> 00:24:27,903
جب اسود عنسی نے یمن کے فارسی شہنشاہ شھر بن باذان کو قتل کیا

304
00:24:27,953 --> 00:24:32,247
اسود نے اس کی بیوی آزاد  سے شادی کر لی

305
00:24:32,303 --> 00:24:35,873
اور اس نے "ألأبناء" کے ساتھ قریبی تعلقات قائم کرنے کی کوشش کی

306
00:24:35,898 --> 00:24:41,823
"ألأبناء" یمن کے فارسی تھے، ان میں فیروز اور دیگر شامل تھے

307
00:24:41,891 --> 00:24:47,880
اور اسود عنسی کی فوج کے سپہ سالار کا نام قیس تھا

308
00:24:47,937 --> 00:24:57,423
لہٰذا اب فیروز نے اسود عنسی سے چھٹکارہ پانے کے لیے اندرونی طور ایک سازشی جال بچھانا شروع کر دیا

309
00:24:57,453 --> 00:25:04,523
فوج کے ساتھ اسود کا سامنا کرنے کے بجائے کیوں نہ ہم اسود عنسی کو قتل کر کے خود اس معاملے سے نمٹ لیں؟

310
00:25:04,612 --> 00:25:10,600
کیونکہ اگر اس ایک شخص کو ختم کر دیا جائے تو سارا مسئلہ حل ہو جائے گا

311
00:25:10,630 --> 00:25:16,007
چنانچہ فیروز اپنے گردوپیش سے کچھ ہم خیال لوگوں کو جمع کرنے میں کامیاب ہو گیا

312
00:25:16,032 --> 00:25:21,927
ایسے لوگ جو ابھی تک اسلام پر ثابت قدم تھے اور اسلام کے لیے قربانی دینے کے لیے تیار تھے

313
00:25:21,952 --> 00:25:29,070
اور پھر وہ قیس کے پاس گئے جو اسود عنسی کی فوج کا سپہ سالار تھا

314
00:25:29,095 --> 00:25:32,530
انہوں نے سنا کہ دونوں(اسود اور قیس) کے درمیان جھگڑا چل رہا ہے

315
00:25:32,570 --> 00:25:35,017
چنانچہ وہ قیس کے پاس گئے اور اس سے کہنے لگے؛

316
00:25:35,073 --> 00:25:39,783
ہم آپ کے ساتھ مل کر اسود عنسی سے جان چھڑانے کے لیے تیار ہیں اور قیس نے ان سے اتفاق کر لیا

317
00:25:39,825 --> 00:25:45,037
اب ضروری نہیں کہ قیس واپس اسلام قبول کرنے کے لیئے رضا مند ہوا ہو

318
00:25:45,079 --> 00:25:50,023
اس کی وجہ یہ تھی کہ اس کا اسودعنسی کے ساتھ اقتدار پر سیاسی تنازعہ تھا

319
00:25:50,065 --> 00:25:53,347
اور اسے(قیس کو) ڈر تھا کہ اسود عنسی اس سے چھٹکارا حاصل کر لے گا

320
00:25:53,377 --> 00:25:59,550
اور پھر فیروز نے اسود عنسی کی بیوی(آزاد) سے مشورہ کیا، جو فارسی عورت تھی

321
00:25:59,601 --> 00:26:02,543
اس(فیروز) نے کہا؛ یہ ہماری حکمتِ عملی ہے، آپ ہماری مدد کیسے کر سکتی ہیں؟

322
00:26:02,574 --> 00:26:06,213
اس(آزاد) نے کہا؛ اسود عنسی ہمیشہ محافظوں کے حصار میں ہوتا ہے

323
00:26:06,244 --> 00:26:11,903
وہ اسے کبھی اکیلا نہیں چھوڑتے، جب تک کہ وہ اس کمرہ خاص میں نہ آ جائے

324
00:26:11,935 --> 00:26:15,850
تو آپ کے لیے اسود عنسی تک پہنچنے کا کوئی راستہ نہیں ہے

325
00:26:15,894 --> 00:26:20,743
جب تک کہ آپ فلاں سمت سے نہ آئیں اور اس نے انہیں محل کا نقشہ دے دیا

326
00:26:20,775 --> 00:26:27,037
یہ خاص کمرہ، جہاں اسود عنسی اپنے خاندان کے ساتھ محوِِآرام ہوتا

327
00:26:27,072 --> 00:26:36,707
یہ واحد جگہ تھی جہاں محافظ نہیں ہوتے، وہاں تک رسائی کا ایک بیرونی راستہ تھا

328
00:26:36,745 --> 00:26:43,230
اور اس(آزاد) نے انہیں اس کمرے میں داخل ہونے کا منصوبہ اور نقشہ اور طریقہ بتا دیا

329
00:26:43,279 --> 00:26:44,957
اب چونکہ رات ہو چکی ہے

330
00:26:44,995 --> 00:26:53,100
اس(آزاد) نے کہا؛ میں اس مخصوص کمرے میں تمہارے لیے ایک چراغ اور ہتھیار رکھ دوں گی

331
00:26:53,132 --> 00:27:00,377
اب فیروز کے لیے آمدورفت اور آزاد سے ملاقات کرنا مشکل نہیں تھا کیونکہ وہ اس کا عم زاد تھا

332
00:27:00,409 --> 00:27:04,003
 تو اسود عنسی کو شک نہیں ہوا

333
00:27:04,033 --> 00:27:10,343
تو اب آزاد نے ان کی مدد کی، اورپھر انہوں نے فیصلہ کیا کہ ہم اسی رات اس منصوبے پر عمل درآمد کریں گے

334
00:27:10,385 --> 00:27:14,990
چنانچہ فیروز دوآدمیوں کے ساتھ اسود کے کمرے میں گھس گیا

335
00:27:15,026 --> 00:27:20,197
اور جیسے ہی وہ چراغ اور ہتھیار حاصل کرنے کے لیے بڑھے

336
00:27:20,227 --> 00:27:23,460
شیطان اسودعنسی کے پاس اس وقت آیا جب وہ سو رہا تھا

337
00:27:23,508 --> 00:27:28,650
اور اسے سیدھا بٹھایا اور فیروز سے بات کرنے لگا

338
00:27:28,691 --> 00:27:31,130
اب اسودعنسی خود سو رہا تھا

339
00:27:31,173 --> 00:27:34,243
لیکن شیطان اس کی زبان میں بول رہا تھا

340
00:27:34,289 --> 00:27:37,893
اور وہ کہہ رہا تھا فیروز میں جانتا ہوں تم کیا کرنا چاہتے ہو

341
00:27:37,925 --> 00:27:42,917
اسود عنسی ایک بہت ضیغم اور مضبوط ورزشی جسم کا آدمی تھا

342
00:27:42,959 --> 00:27:46,837
فیروز،اسود عنسی کے اس طرح مخاطب کرنے پہ گھبرا گیا

343
00:27:46,879 --> 00:27:54,083
اور پہلے اس (فیروز) نے سوچا کہ یہ اصل میں اسود عنسی اسے مخاطب کررہا ہے، لیکن یہ شیطان تھا،جو اس سے بات کر رہا تھا

344
00:27:54,108 --> 00:28:00,430
تو اس(فیروز) نے خود سے کہا؛اب اگر میں پیچھے ہٹوں تو ہمارا منصوبہ ناکام ہو جائے گا

345
00:28:00,463 --> 00:28:03,490
اور اس کے پاس جا کر ہتھیار لینے کا وقت نہیں تھا

346
00:28:03,533 --> 00:28:05,990
تو اس نے فوراً اسود عنسی پر چھلانگ لگا دی

347
00:28:06,028 --> 00:28:11,930
اور اس کے اوپر چڑھ کر اس کا سر دبوچ لیا اور اس کی گردن توڑ دی اور پھر باہر نکل گیا

348
00:28:11,960 --> 00:28:14,914
آزاد نے سوچا کہ وہ فرار ہو رہا ہے

349
00:28:14,939 --> 00:28:16,106
اس(آزاد) نے فیروز سے کہا؛ تم کہاں جا رہے ہو؟

350
00:28:16,146 --> 00:28:18,150
وہ نہیں جانتی تھی کہ اسود مارا گیا ہے

351
00:28:18,194 --> 00:28:21,090
اس نے کہا؛ میں جا کر اپنے دونوں ساتھیوں کو خبر کر دوں

352
00:28:21,137 --> 00:28:25,140
چنانچہ فیروز نے دوسرے کمرے سے انہیں بلایا اور وہ اندر آگئے

353
00:28:25,170 --> 00:28:27,250
یہ معلوم کرنے کے لیے کہ اسودعنسی ابھی تک مرا نہیں تھا

354
00:28:27,297 --> 00:28:31,067
وہ کمرے میں اِدھر اُدھر اُچھل رہا تھا، حالانکہ اُس کی گردن ٹوٹی چکی تھی

355
00:28:31,109 --> 00:28:33,800
اللہ اعلم، اس کے اندر جن تھے یا کیا؟

356
00:28:33,849 --> 00:28:36,880
لیکن وہ کمرے میں جھٹکے کھاتا اُچھل رہا تھا

357
00:28:36,915 --> 00:28:39,310
تو فیروز کہتا ہے کہ؛ میں نے اسے پکڑنے کی کوشش کی، لیکن مجھے ناکامی ہوئی

358
00:28:39,335 --> 00:28:41,789
وہ آدمی اتنا مضبوط اور طاقتور تھا، جو بس اِدھر اُدھر اُچھلتا تھا

359
00:28:41,814 --> 00:28:44,490
تو باقی دو ساتھیوں کو آنا پڑا اور اسے میرے لیئے قابو کیا

360
00:28:44,531 --> 00:28:47,183
یہاں تک کہ میں نے خنجر نکال لیا اور میں نے اس کا سر قلم کردیا

361
00:28:47,223 --> 00:28:51,217
اس کے بعد ہم نے کمرے میں انتظار کیا یہاں تک کہ فجر ہو گئی، ہم وہاں ہی رہے

362
00:28:51,261 --> 00:28:55,577
ویسے، فیروز نے کہا؛ جب اس نے اسود عنسی کا سر قلم کیا

363
00:28:55,615 --> 00:28:57,637
اسود بہت زور سے دھاڑا

364
00:28:57,683 --> 00:29:01,247
تو محافظ دوڑتے ہوئے آئے اور کہنے لگے؛ کیا ہو رہا ہے؟

365
00:29:01,277 --> 00:29:02,648
تو اسود عنسی کی بیوی نے کہا؛

366
00:29:02,673 --> 00:29:05,817
"پریشان نہ ہوں، نبی پر وحی آ رہی ہے"

367
00:29:05,859 --> 00:29:12,433
بہرحال وہ کمرے میں انتظار کرتے رہے، یہاں تک کہ فجر ہو گئی اور انہوں نے باہر نکل کر اذان دی

368
00:29:12,466 --> 00:29:14,967
جو کافی عرصے سے نہیں سنی گئی تھی

369
00:29:15,023 --> 00:29:17,540
تو سب محافظ حیران رہ گئے

370
00:29:17,618 --> 00:29:25,077
اور یہ فیروز کے سپاہیوں کے لیے ایک اشارہ تھا جب اُنھوں نے اذان سنی

371
00:29:25,114 --> 00:29:28,363
 چنانچہ فیروز کے لشکر نے حملہ کیا

372
00:29:28,402 --> 00:29:32,803
اور انہوں نے اسود عنسی کا سر اس کے حامیوں کے سامنے پھینک دیا

373
00:29:32,835 --> 00:29:37,223
اور یہ اسود عنسی کا خاتمہ تھا

374
00:29:37,264 --> 00:29:44,050
جس رات اسود عنسی جہنم واصل ہوا

375
00:29:44,091 --> 00:29:49,043
حضرت جبرائیلؑ، حضرت محمدﷺ کے پاس حاضر ہوئے اور آپؐ کو خوش خبری دی

376
00:29:49,080 --> 00:29:53,727
چنانچہ رسول اللہؐ اگلی صبح صحابہ سے فرما رہے تھے؛

377
00:29:53,762 --> 00:29:55,980
"اسود عنسی مارا گیا ہے"

378
00:29:56,018 --> 00:30:00,303
"اور وہ ایک بابرکت خاندان کے ایک بابرکت آدمی کے ہاتھوں قتل ہوا ہے"

379
00:30:00,358 --> 00:30:02,290
صحابہ کہنے لگے؛ کون تھا؟ آپؐ نے فرمایا ؛ 'فیروز"

380
00:30:02,345 --> 00:30:05,713
تو فیروز ایک بابرکت شخص تھے

381
00:30:05,750 --> 00:30:07,117
اور آپ کا خاندان بھی بابرکت تھا،

382
00:30:07,147 --> 00:30:11,117
کیونکہ یہ ایسا منصوبہ تھا جو عام طور پر فارسی سرانجام دیا کرتے ہیں

383
00:30:11,165 --> 00:30:13,690
 مزید برآں، آزاد جو ایک فارسی عورت تھی

384
00:30:13,734 --> 00:30:16,803
تو رسول اللہؐ نے اسے مبارک خاندان کہا

385
00:30:16,840 --> 00:30:22,403
اور ویسے، فیروز کی یہ کہانی ثبوت کے طور پر فقہاء استعمال کرتے ہیں

386
00:30:22,435 --> 00:30:28,050
جس میں قتلِ خفیفہ کے ذریعے مرتد حکومت کا تختہ الٹا جاتا ہے

387
00:30:28,082 --> 00:30:30,183
کیونکہ یمن پر اسلام کی حکومت تھی

388
00:30:30,245 --> 00:30:34,700
اور پھر آپ کے سامنے یمن پر اسود عنسی ایک مرتد کی حکومت آگئی

389
00:30:34,725 --> 00:30:38,983
اور رسول اللہؐ نے ان کے اِس عمل کی توثیق فرمائی

390
00:30:39,023 --> 00:30:43,637
البتہ جب رسول اللہؐ کے وصال کی خبر یمن پہنچی

391
00:30:43,663 --> 00:30:50,123
اسودعنسی کی بقیہ ماندہ فوج نے دوبارہ بغاوت شروع کردی

392
00:30:50,143 --> 00:30:56,328
اس بار ردّہ بدترین تھا کیونکہ یہ مختلف جگہوں پر پھیل رہا تھا

393
00:30:56,371 --> 00:31:01,721
نجران میں، صنعاء میں،حضرالموت میں، کندہ میں، مهرة میں

394
00:31:01,764 --> 00:31:03,774
لحج میں، عدن میں

395
00:31:03,829 --> 00:31:06,628
 بلکل ایسے ہی باقی جزیرہ نما عرب میں تھا

396
00:31:06,663 --> 00:31:12,481
جہاں بھی نومسلم تھے، جن کا ایمان ابھی تک کمزور تھا، آپ کو وہاں ردّہ کا سامنا تھا

397
00:31:12,513 --> 00:31:17,241
قیس، جو اسود عنسی کی فوج کا سربراہ تھا

398
00:31:17,272 --> 00:31:20,201
جو اسود عنسی کو قتل کرنے کی سازش میں شامل ہوا تھا

399
00:31:20,242 --> 00:31:22,861
مرتدین کی افواج میں شامل ہوگیا۔ کیوں؟

400
00:31:22,886 --> 00:31:29,894
کیونکہ حضرت ابوبکر صدیقؓ نے فیروز کو صنعاء کا امیر مقرر فرمایا

401
00:31:29,930 --> 00:31:38,174
اور قیس کو یہ ناگوار گزرا، اس لیے اس نے پھوٹ ڈالی، اور وہ مرتدین کی فوجوں میں شامل ہو گیا

402
00:31:38,201 --> 00:31:48,624
تو اب حضرت مہاجر بن امیہؓ اور حضرت معاذ بن جبلؓ اور دیگر صحابہ جو یمن میں تھے، مختلف علاقوں میں اُن کے مرتدین سے جنگی معرکے ہوئے

403
00:31:48,660 --> 00:31:59,481
اور آہستہ آہستہ، صحابہ سب مرتدین کو شکست دے رہے تھے ، یہاں تک کہ پورا ملک دوبارہ شریعت کے تابع ہو گیا

404
00:31:59,526 --> 00:32:02,479
تو یہ اسود عنسی کا ردّہ(فتنہ) تھا

405
00:32:02,503 --> 00:32:07,201
 دوبارہ دھراتا ہوں؛ جس کا آغاز رسول اللہؐ کی زندگی میں ہوا

406
00:32:07,237 --> 00:32:10,508
میں نے اسے بہت مختصر بیان کیا ہے، میں تفصیل میں نہیں گیا

407
00:32:10,563 --> 00:32:15,361
سب سے پہلے چونکہ بہت سارے نام اور مقامات اور واقعات ہیں، یہ الجھن کا باعث ہو سکتا ہیں

408
00:32:15,421 --> 00:32:20,068
دوسرا، ہمارا مقصد سبق سیکھنا ہے

409
00:32:20,117 --> 00:32:25,731
اس لیے جہاں بھی مجھے لگا کہ اس میں مدلل اسباق موجود ہیں میں آپ کے سامنے وہ واقعہ یا کہانی کا ذکر کروں گا

410
00:32:25,761 --> 00:32:30,307
کیونکہ دوبارہ دھراتا ہوں؛ ہم حضرت ابوبکر صدیقؓ کے بارے میں بات کر رہے ہیں،  اورحضرت ابوبکر صدیقؓ کا دورِ خلافت کے متعلق بیان کر رہے ہیں

411
00:32:30,348 --> 00:32:34,108
اور اگر ہم ہر چیز کے بارے میں بات کرتے ہیں تو اس کے لیے بہت زیادہ وقت درکار ہوگا

412
00:32:34,139 --> 00:32:37,261
یمن میں پیش آنے والے چند واقعات

413
00:32:37,286 --> 00:32:40,848
 اور پھر ہم طلیحہ اسدی کے ردّہ کے متعلق بات کریں گے

414
00:32:40,873 --> 00:32:45,468
نیک عورت کی مثال اور بدکار عورت کی

415
00:32:45,488 --> 00:32:51,108
 آزاد ایک صالح عورت کی مثال تھی

416
00:32:51,139 --> 00:32:53,124
 جنہوں نے اپنے دین کے لیے قربانی دی

417
00:32:53,174 --> 00:32:56,794
 جیسا کہ فرعون کی بیوی حضرت آسیہ بنت مزاحمؑ نے کیا

418
00:32:56,837 --> 00:33:00,654
حضرت آسیہ بنت مزاحمؑ، فرعون کی بیوی تھی

419
00:33:00,702 --> 00:33:03,438
فرعون روئے زمین پر سب سے طاقتور بادشاہ تھا

420
00:33:03,463 --> 00:33:09,481
اس کے پاس وہ سب کچھ تھا جو دنیاوی حرص و ہوس کے تابع شخص کو چاہئیے ہوتا ہے

421
00:33:09,519 --> 00:33:14,841
وہ سب سے بڑے محل میں رہ رہی تھی، وہ محل جس کا ذکر قرآن میں ہے،

422
00:33:14,883 --> 00:33:16,173
الْأَنْهَارُ تَجْرِي مِن تَحْتِي ۖ

423
00:33:16,197 --> 00:33:19,681
ترجمہ ؛ " میرے (محل) نیچے بہتی ہوئی ندیاں ہیں،

424
00:33:19,734 --> 00:33:26,761
حضرت آسیہؑ کے پاس من چاہا مال و دولت موجود تھا، لیکن آپؑ اس سے مطمئن نہیں تھیں

425
00:33:26,804 --> 00:33:34,171
اورآپؑ اللہ عَزَّوجَل سے درخواست کر رہی تھیں کہ زمین پر اس محل کے بجائے، اُن کے لیے جنت میں ایک محل بنا دے

426
00:33:34,208 --> 00:33:42,108
آزاد،اسود عنسی کی بیوی تھیں جو اپنے دور میں یمن کا سب سے طاقتور آدمی تھا،

427
00:33:42,138 --> 00:33:48,228
لیکن وہ(آزاد) مسلمان تھی اور آپ(آزاد) نے اپنے شوہر،اسود عنسی  کے بارے میں یوں بیان کیا ہے؛

428
00:33:48,258 --> 00:33:55,188
اللہ تعالیٰ نے میرے نزدیک اسود عنسي سے بڑھ کر کسی ناپسندیدہ انسان کو پیدا نہیں فرمایا

429
00:33:55,226 --> 00:33:59,421
میں نے اپنی زندگی میں کبھی کسی سے اتنی نفرت نہیں کی جتنی مجھے اس شخص سے نفرت تھی

430
00:33:59,452 --> 00:34:07,348
اس نے کہا؛ اسود نے کوئی اچھا کام نہیں کیا، اس کے تمام کام شیطانی تھے

431
00:34:07,378 --> 00:34:13,861
اور آزاد نے قربانی دی اور جو کچھ اس نے کیا ہو سکتا اسے اس کی بھاری قیمت چُکانا پڑتی

432
00:34:13,931 --> 00:34:18,695
اگر اسود عنسی کے سامنے اس سازش کا پردہ فاش ہو جاتا تو اسے(آزاد کو) قتل کر دیا جاتا

433
00:34:18,719 --> 00:34:23,021
اور اسود عنسی کا مسلمانوں کے ساتھ رویہ بہیمانہ تھا

434
00:34:23,073 --> 00:34:27,928
وہ اُن کے ٹکڑے کرتا اور اُنہیں ازیت سے مارتا

435
00:34:27,971 --> 00:34:32,221
 دوسری طرف، آپ کے سامنے شرانگیز عورتیں ہیں

436
00:34:32,266 --> 00:34:40,481
اللہ عَزَّوَجَلْ نے قرآن میں دونوں کی مثالیں دی ہیں، حضرت آسیہؑ کی مثال اور ساتھ میں حضرت لوطؑ اور حضرت نوحؑ کی بیوی کی مثال ہے

437
00:34:40,530 --> 00:34:43,648
اور دونوں اقسام کی خواتین کی مثالیں سلطنتِ یمن میں بھی موجود ہیں

438
00:34:43,694 --> 00:34:50,574
جب بھی کہیں اسلامی حکومت آئے گی وہاں ایسے لوگ موجود ہوں گے جو اس سے ناخوش ہوں گے

439
00:34:50,638 --> 00:34:54,241
ہر کوئی اسلام کی حمایت نہیں کرے گا

440
00:34:54,281 --> 00:35:00,728
ایسے لوگ ہوں گے جنہیں اللہ کے قوانین سے شدید نفرت ہو گی

441
00:35:00,768 --> 00:35:07,388
اور اُن کے خیال میں یہ قوانین ان کی آزادی اور خود مختاری میں حائل ہوتے ہیں

442
00:35:07,429 --> 00:35:12,764
اور یہ لوگ ملکی اشرافیہ میں سے ہوتے ہیں

443
00:35:12,806 --> 00:35:21,821
وہ لوگ جو اپنے لطف و انبساط اور دنیاوی آلائشوں اور اپنے ہیجان انگیز احساسات پر کوئی حد/ پابندی برداشت نہیں کرتے

444
00:35:21,851 --> 00:35:30,161
 ایسے لوگ ہر جگہ، ہر اس ریاست میں موجود ہوتے ہیں جہاں اللہ تعالیٰ کے احکامات پرمبنی نظامِ حکومت قائم ہوتی ہے

445
00:35:30,191 --> 00:35:36,768
حضرالموت میں ایک تحریک چلی جسے "طوائفوں کی تحریک" کہتے تھے

446
00:35:36,813 --> 00:35:42,574
یہ حضرالموت کے مختلف دیہات سے تعلق رکھنے والی بیس سے زائد طوائفوں کی تحریک تھی

447
00:35:42,620 --> 00:35:47,708
جنہوں نے رسول اللہؐ کا وصال پہ اپنے ہاتھ حنا(مہندی) سے مکمل رنگ لیے

448
00:35:47,756 --> 00:35:53,921
اور معازاللہ انہوں نے رسول اللہؐ کے وصال کی خوشی میں گیت گائے

449
00:35:53,967 --> 00:35:59,781
کیونکہ یہ بدکارعورتیں تھیں انہیں لگتا تھا کہ اسلام نے ان کی زندگی کو محدود کر دیا ہے

450
00:35:59,820 --> 00:36:03,188
وہ اُن مکھیوں کی طرح تھیں، جو صرف غلاظت پر ہی زندہ رہ سکتی تھیں

451
00:36:03,222 --> 00:36:09,328
اور جب اسلام آیا اور ان کی غلاظت کو دور کیا تو اُنھیں محسوس ہوا کہ وہ بھوک سے مر رہی ہیں

452
00:36:09,363 --> 00:36:12,228
انہیں لگا کہ وہ سانس نہیں لے پا رہیں، ان کا دم گُھٹ رہا ہے

453
00:36:12,274 --> 00:36:16,618
چنانچہ جب رسول اللہؐ کا وصال ہوا تو وہ مطعون خوش تھیں اور خوشیاں منا رہی تھیں

454
00:36:16,657 --> 00:36:23,161
چنانچہ حضر الموت کے ایک آدمی نے خلیفہ حضرت ابوبکر صدیقؓ کو ایک نظم بھیجی

455
00:36:23,204 --> 00:36:26,361
صورتحال کو بیان کیا اور مدد طلب کرنے کی درخواست کی

456
00:36:26,397 --> 00:36:34,834
چنانچہ خلیفہ نے حضر الموت پر اپنے گورنر حضرت مہاجر ابن ابی امیہؓ کو خط بھیجا، آپؓ نے ان سے فرمایا؛

457
00:36:34,875 --> 00:36:42,964
"میں تمہیں حکم دیتا ہوں کہ فوج لے جاؤ اور ان عورتوں کے بازو کاٹ دو"

458
00:36:43,018 --> 00:36:45,761
اور اگر کوئی آپ کے راستے میں رکاوٹ بنے

459
00:36:45,801 --> 00:36:51,894
 تو ان تک اللہ عَزَّوَجَلْ کا پیغام پہنچا دیں اور اُنھیں اسلام کی دعوت دیں اور اگر وہ انکار کر دیں تو ان سے جنگ کریں

460
00:36:51,944 --> 00:36:58,334
کیونکہ حضرت ابوبکر صدیقؓ کو معلوم تھا کہ یہ عورتیں(طوائفیں) اپنی طرف سے نہیں بول رہیں

461
00:36:58,375 --> 00:37:01,561
 وہ معاشرے کے ایک مخصوص طبقے کی نمائندگی کر رہی ہیں

462
00:37:01,596 --> 00:37:05,468
اور معاشرے کا یہ طبقہ ان کے دفاع کے لیے دوڑ پڑے گا

463
00:37:05,513 --> 00:37:12,281
کیونکہ جب بھی حق، باطل کے خلاف معرکہ آراء ہوتا ہے تو  برائی ہمیشہ متحد ہو کر صف آراء ہوجاتی ہے

464
00:37:12,317 --> 00:37:18,574
لہٰذا یہ تمام برے لوگ، جنہوں نے محسوس کیا کہ اسلام انہیں ان کے طرز زندگی سے محروم کر رہا ہے

465
00:37:18,612 --> 00:37:22,001
وہ ان ملعون خواتین کی حفاظت کے لیے اکٹھے ہوئے

466
00:37:22,047 --> 00:37:25,394
اور وہ حضرت مہاجرؓ سے جنگ کے لیے آگے بڑھے

467
00:37:25,451 --> 00:37:29,074
چنانچہ حضرت مہاجرؓ نے انھیں مخاطب کیا اور انہیں اللہ کے پیغام کی دعوت دی

468
00:37:29,098 --> 00:37:35,421
اور آپؓ نے انہیں ان کی بداعمالیوں کے نتائج بتائے، ان میں سے بہت سے لوگوں نے دعوت قبول کی

469
00:37:35,475 --> 00:37:37,601
اور پھر، حضرت مہاجرؓ نے باقی مرتدین سے جنگ کی

470
00:37:37,635 --> 00:37:40,219
اور پھر آپؓ نے آگے بڑھ کر ان عورتوں کے بازو کاٹ ڈالے

471
00:37:40,243 --> 00:37:42,170
اور ان میں سے بہت ساری عورتیں اس وجہ سے مر گئیں

472
00:37:42,200 --> 00:37:47,548
اور بعض نے حضرالموت کو خیرباد کہہ دیا اور کوفہ اوردیگر مختلف مقامات پر قیام پزیر ہو گئیں، بہرحال

473
00:37:47,585 --> 00:37:54,094
پس ہر دور اور زمانے میں ایسے لوگ ہوں گے جو حق کے خلاف برسرِ پیکار رہیں گے

474
00:37:54,133 --> 00:37:57,348
 آخری لمحے تک

475
00:37:57,388 --> 00:38:04,048
ایک کرامت تھی جو اللہ عَزَّوَجَلْ کے ایک ولی حضرت ابو مسلم خولانیؓ کو عطا ہوئی

476
00:38:04,080 --> 00:38:10,081
حضرت ابو مسلم خولانیؓ تابعین میں سے ہیں

477
00:38:10,122 --> 00:38:14,864
اسود عنسی نے آپؓ کو گرفتار کر لیا اور کہنے لگا؛

478
00:38:14,894 --> 00:38:20,101
کیا تم گواہی دیتے ہو کہ میں اللہ کا رسول ہوں؟

479
00:38:20,131 --> 00:38:22,201
 آپؓ نے فرمایا؛ مجھے تمہاری بات سنائی نہیں دے رہی

480
00:38:22,252 --> 00:38:26,104
اس نے پھر کہا؛ کیا تم گواہی دیتے ہو کہ حضرت محمدﷺ، اللہ کے رسول ہیں؟

481
00:38:26,149 --> 00:38:28,304
 آپؓ نے فرمایا؛ ہاں

482
00:38:28,350 --> 00:38:31,428
اس نے پھر کہا؛ کیا تم گواہی دیتے ہو کہ میں اللہ کا رسول ہوں؟

483
00:38:31,466 --> 00:38:33,214
 آپؓ نے فرمایا؛ میں تمہاری بات سن نہیں سکتا

484
00:38:33,254 --> 00:38:36,036
 اس نے پھر کیا تم گواہی دیتے ہو کہ حضرت محمد ﷺ،اللہ کے رسول ہیں؟

485
00:38:36,079 --> 00:38:41,161
 آپؓ نے فرمایا ؛ ہاں! اور اس نے یہ سوال تین بار دُہرایا

486
00:38:41,213 --> 00:38:47,094
چنانچہ اسود عنسی نے حکم دیا کہ آپؓ کو دہکتی آگ میں ڈال دیا جائے

487
00:38:47,130 --> 00:38:51,474
چنانچہ انہوں نے حضرت ابو مسلم خولانیؓ کو جلا دیا

488
00:38:51,523 --> 00:38:57,101
اور حضرت ابو مسلم الخولانیؓ بحُکمِ خداوندی بغیر کسی نقصان کے اس آگ سے باہر نکل آئے

489
00:38:57,132 --> 00:39:01,588
صرف وہ رسی جلی، جس سے انہوں نے آپؓ کو باندھ رکھا تھا

490
00:39:01,633 --> 00:39:07,756
تو اسود عنسی کے پیروکاروں نے کہا؛ تمہیں اسے(حضرت مسلمؓ کو) اپنا وطن چھوڑنے پر مجبور کرنا پڑے گا

491
00:39:07,781 --> 00:39:10,334
ورنہ آپؓ دیگر عوام الناس کے لیے فتنہ بن جائیں گے

492
00:39:10,373 --> 00:39:14,530
یہ کرامت لوگوں کے دوبارہ اسلام کی طرف جانے کا سبب بن سکتا ہے

493
00:39:14,554 --> 00:39:19,801
اس لیے ہم چاہتے ہیں کہ تم اسے(حضرت مسلمؓ کو) ملک بدر کردو

494
00:39:19,841 --> 00:39:24,901
چنانچہ آپؓ مدینہ تشریف لے گئے اور مسجد میں چلے گئے اور آپؓ نماز پڑھ رہے تھے

495
00:39:24,963 --> 00:39:28,288
اور حضرت عمر بن خطابؓ نے فرمایا؛ یہ شخص کہاں کا باشندہ ہے؟  لوگوں نے بتایا؛ وہ یمن کا رہنے والا ہے

496
00:39:28,346 --> 00:39:30,521
چنانچہ آپؓ نے نماز سے فارغ ہونے کے بعد حضرت مسلمؓ کو  بلایا

497
00:39:30,576 --> 00:39:38,828
 آپؓ نے فرمایا؛میں چاہتا ہوں کہ آپؓ مجھے اس شخص کے بارے میں بتائیں جسے اسود عنسی نے آگ میں جلایا تھا

498
00:39:38,866 --> 00:39:40,561
حضرت مسلمؓ نے فرمایا؛ وہ شخص عبداللہ بن ثوب تھے

499
00:39:40,607 --> 00:39:43,874
اس کا نام عبداللہ بن ثوب ہے

500
00:39:43,919 --> 00:39:45,508
 آپؓ نے فرمایا؛ کیا آپ وہی ہیں؟

501
00:39:45,539 --> 00:39:48,974
میں آپ سے اللہ کا نام لے کر پوچھتا ہوں، کیا آپ وہی ہیں؟ حضرت مسلمؓ نے فرمایا؛ ہاں! وہ میں ہوں

502
00:39:49,029 --> 00:39:54,148
حضرت عمر بن خطابؓ نے فوراً آپؓ کو گلے لگایا اور رونے لگے

503
00:39:54,181 --> 00:39:59,794
اور آپؓ نے فرمایا؛ الحمدللہ ، اللہ کا شکر ہے جس نے مجھے زندہ رکھا

504
00:39:59,852 --> 00:40:08,228
یہاں تک کہ میں ایک ایسے آدمی کو دیکھوں جسے اللہ تعالیٰ نے آگ سے بچایا جس طرح حضرت ابراہیمؑ کو بچایا تھا

505
00:40:08,262 --> 00:40:17,643
 آپؓ نے فرمایا؛ الحمدللہ ، جس نے مجھے زندہ رکھا یہاں تک کہ میں حضرت محمدﷺ کا وہ امتی دیکھ سکوں جسے اللہ نے آگ سے محفوظ رکھا،

506
00:40:17,663 --> 00:40:21,181
 جس طرح حضرت ابراہیمؑ کو آگ سے محفوظ رکھا گیا

507
00:40:21,228 --> 00:40:26,948
تو یہ ایک کرامت تھی جو حضرت محمد ﷺ کے پیروکار پہ ظاہر ہوئی

508
00:40:26,983 --> 00:40:31,314
اور یہ ایک ایسے معجزہ کے مشابہہ ہے جو اللہ عَزَّوَجَلْ کے ایک نبی کو پیش آیا

509
00:40:31,346 --> 00:40:38,321
حضرت ابو مسلم خولانیؓ تابعین میں سے ایک دلچسپ شخصیت تھے

510
00:40:38,367 --> 00:40:43,494
ان کے بارے میں بہت سی کہانیاں ہیں لیکن میں ان کے انتقال سے متعلق صرف ایک کا ذکر کروں گا

511
00:40:43,545 --> 00:40:50,385
آپؓ ،حضرت بشر بن ارطاؓ کے ہمراہ رومیوں کے خلاف جنگ لڑ رہے تھے

512
00:40:50,406 --> 00:40:53,898
چنانچہ آپؓ کے امیر حضرت بشر بن ارطاؓ تھے

513
00:40:53,927 --> 00:40:57,294
اور حضرت ابو مسلم خولانیؓ زخمی ہوگئے

514
00:40:57,335 --> 00:41:03,811
چنانچہ مرنے سے پہلے آپؓ نے فوج کے امیر حضرت بشر بن ارطاؓ کو بلایا اور فرمایا؛

515
00:41:03,850 --> 00:41:11,948
جب میں مر جاؤں تو میں چاہتا ہوں کہ آپ مجھے دشمن کی سرزمین کے پَرلے کونے میں دفن کریں

516
00:41:12,007 --> 00:41:17,581
فرمایا ؛ میں چاہتا ہوں کہ میری قبر باقی تمام شہداء کی قبروں سے آگے ہو

517
00:41:17,630 --> 00:41:23,454
اور پھر میں چاہتا ہوں کہ آپ مجھے شہداء پر امیر مقرر کریں

518
00:41:23,489 --> 00:41:27,798
فرمایا ؛ اور مجھے جنگ کا جھنڈا دیں جو آپؓ میرے ساتھ دفن کریں

519
00:41:27,837 --> 00:41:31,034
تاکہ قیامت کے دن جب ہم دوبارہ اٹھائے جائیں

520
00:41:31,099 --> 00:41:36,642
میں وہ جھنڈا اُٹھا سکوں اور قیامت کے دن شہداء کی قیادت کروں

521
00:41:36,684 --> 00:41:39,701
تو آپؓ نہیں چاہتے تھے کہ آپؓ کا جہاد اس دنیا میں رک جائے

522
00:41:39,725 --> 00:41:48,328
  آپؓ اسے آخرت میں جاری رکھنا چاہتے تھے، آپؓ قیامت کے دن جہاد کا پرچم اٹھائے اور شہداء کی قیادت کرنا چاہتے تھے

523
00:41:48,370 --> 00:41:55,262
تو یہ کرامت ہے جو حضرت ابو مسلم خولانیؓ کے ساتھ ظاہر ہوئی

524
00:41:55,293 --> 00:42:02,555
حضرت ابوبکرصدیقؓ کا بعض مرتدین کے ساتھ رویہ انتہائی سخت تھا

525
00:42:02,600 --> 00:42:07,228
اور آپؓ نے کچھ دیگر مرتدین کے ساتھ نرمی کا مظاہرہ کیا،

526
00:42:07,258 --> 00:42:12,332
صورتحال کے مطابق کوئی ایک معیار نہیں تھا

527
00:42:12,372 --> 00:42:16,915
 حضرت ابوبکر صدیقؓ حالات کے مطابق فیصلہ فرماتے

528
00:42:16,945 --> 00:42:25,042
جب بھی آپؓ دیکھتے کہ مستقبل میں کچھ لوگ اسلام کی خدمت کر سکتے ہیں

529
00:42:25,072 --> 00:42:27,248
 آپؓ انہیں سخت سزا دیے بغیر جانے کی اجازت دیتے

530
00:42:27,296 --> 00:42:37,168
چنانچہ آپؓ نے عمرو بن معدیکرب، اور قیس بن مرادی، جو اسود عنسی کی فوج کا سربراہ تھا کو معاف فرما دیا

531
00:42:37,215 --> 00:42:42,048
 آپؓ نے اسے آزاد کر دیا اور اشعث بن قیس کو بھی معاف کردیا

532
00:42:42,086 --> 00:42:45,952
جس نے حضرالموت میں صحابہؓ کے خلاف جنگ بھی لڑی

533
00:42:45,982 --> 00:42:51,783
اور سبحان اللہ یہ حضرت ابوبکر صدیقؓ کا نقطہ نظر تھا کہ ان تینوں کو درگزر کیا جائے

534
00:42:51,810 --> 00:42:58,837
 کیونکہ ان تینوں اشخاص نے حضرت عمربن خطابؓ کے دورِخلافت میں جہاد کے دوران بہت اہم کردار ادا کیے تھے

535
00:42:58,857 --> 00:43:03,350
حضرت ابوبکرؓ کے زمانے میں دیکھیں کہ انہوں نے اپنی ہدایات جاری کیں

536
00:43:03,396 --> 00:43:08,563
کہ کسی بھی مرتد کو غزوۃ فتح میں شرکت کی اجازت نہ دی جائے

537
00:43:08,616 --> 00:43:10,897
جب ارتداد کی جنگیں ختم ہوگئیں

538
00:43:10,952 --> 00:43:15,037
اور اب فارس اور رومی سلطنت کے خلاف لڑنے کے لیے لشکر روانہ کیے گئے

539
00:43:15,101 --> 00:43:21,870
حضرت ابوبکر صدیقؓ نے ہدایات دیں، کہ مرتدین میں سے کوئی بھی ان لشکروں میں شریک نہ ہو

540
00:43:21,919 --> 00:43:26,353
یہ قانون حضرت عمر بن خطابؓ کے زمانے میں ختم ہوا

541
00:43:26,422 --> 00:43:33,407
اور اس کی کچھ وجوہات تھیں، اگر ہمیں وقت ملا ان شاء اللہ، ہم اس پر بعد میں بات کریں گے

542
00:43:33,437 --> 00:43:35,313
ایک اور واقعہ قابل ذکر ہے

543
00:43:35,359 --> 00:43:40,863
حضرت ابوبکر صدیقؓ نے عکرمہ بن ابوجہل کو بھیجا، ابوجہل کا بیٹا حضرت عکرمہؓ جو اب مسلمان تھا

544
00:43:40,894 --> 00:43:49,023
 آپؓ نے اسے سات سو گھڑ سواروں کے لشکر کی قیادت دے کر مسیلمہ بن کذاب کی سرزمین پر بھیجا

545
00:43:49,067 --> 00:43:54,157
حضرت عکرمہؓ کو جلدی تھی، اس لیے آپؓ کا بنو حنیفہ سے قبل از وقت تصادم ہو گیا

546
00:43:54,193 --> 00:43:57,010
اور اُنھیں (حضرت عکرمہؓ کو) شکست ہو گئی

547
00:43:57,047 --> 00:43:58,963
حضرت ابوبکرؓ تک خبر پہنچی

548
00:43:58,999 --> 00:44:02,250
حضرت ابوبکرؓ نے حضرت عکرمہؓ کو فوری طور پر تاکیدی پیغام بھیجا کہ

549
00:44:02,292 --> 00:44:06,530
 میں آپؓ کو نہیں دیکھنا چاہتا! آپؓ واپس مت آنا

550
00:44:06,562 --> 00:44:09,983
کیونکہ اس سے ہماری افواج کے حوصلے پست ہوں گے

551
00:44:10,021 --> 00:44:13,037
اور فرمایا کہ میں چاہتا ہوں کہ تم فوراً یمن چلے جاؤ

552
00:44:13,078 --> 00:44:19,277
اور وہاں موجود مسلمانوں کی مدد کرو اور عمان سے یمن میں داخل ہونا

553
00:44:19,322 --> 00:44:20,603
اس کے پیچھے کیا حکمت تھی؟

554
00:44:20,628 --> 00:44:27,883
حضرت ابوبکر صدیقؓ نہیں چاہتے تھے کہ وہ مسلمان جنہیں مسیلمہ کی فوجوں کے خلاف جنگ میں شکست ہوئی ہے

555
00:44:27,930 --> 00:44:31,530
وہ کسی بھی ایسی فوج سے ملیں جو اسی سمت جا رہی ہو

556
00:44:31,572 --> 00:44:37,637
کیونکہ اس طرح ان میں اطلاعات ومعلومات کا تبادلہ ہوگا اور دشمن کی قوتوں کے بارے میں بات کریں گے

557
00:44:37,681 --> 00:44:41,943
اور اس سے مسلمانوں کے حوصلے پست ہوں گے، جو اس سمت میں جہاد کے لیے جا رہے ہیں

558
00:44:41,979 --> 00:44:45,450
تو آپؓ نے حضرت عکرمہؓ  سے فرمایا کہ فوراً چلے جاؤ اور میں نہیں چاہتا کہ تم مدینہ واپس آؤ

559
00:44:45,481 --> 00:44:50,080
کیونکہ اس سے اہل مدینہ کے حوصلے پست ہوں گے، عمان چلے جائیں

560
00:44:50,119 --> 00:44:55,403
تاکہ صحابہ مختلف لوگوں کے ساتھ ایک مختلف جنگ، اور مختلف میدان جنگ میں لڑیں، اس لیئے أپ سب عمان چلے جاؤ

561
00:44:55,423 --> 00:45:02,577
 اور آپؓ عمان، المحرہ سے ہوتے ہوئے آئے اور پھر فوج میں یمن میں دیگر صحابہ کے ہمراہ جنگ میں شریک ہوگئے

562
00:45:02,615 --> 00:45:07,363
تو یہ حضرت ابوبکر صدیقؓ کی قیادت میں حکمت کو ظاہر کرتا ہے

563
00:45:07,396 --> 00:45:10,117
جب حضرت معاذ بن جبلؓ مدینہ واپس آئے

564
00:45:10,157 --> 00:45:15,237
کیونکہ آپؓ کو رسول اللہؐ نے یمن میں لوگوں کو اسلام کی تعلیم دینے کے لیے مقرر فرمایا تھا

565
00:45:15,267 --> 00:45:16,543
چنانچہ جب آپؓ واپس آئے

566
00:45:16,577 --> 00:45:22,957
حضرت ابوبکرؓ کا طریقہ یہ تھا کہ جب بھی کوئی گورنر واپس آتا تو آپؓ ،اس کے ساتھ بیٹھ جاتے

567
00:45:23,004 --> 00:45:26,203
اور تمام حالات و واقعات کے شواہد کا تجزیہ کیا جاتا

568
00:45:26,234 --> 00:45:35,317
اور آپؓ، اس گورنر سے ہر اس چیز کا احتساب لیتے جو کچھ اس کے دورِِحکومت میں ہوا تھا

569
00:45:35,357 --> 00:45:38,210
 جب ایسا ہوا توحضرت معاذ بن جبلؓ نے عرض کیا

570
00:45:38,264 --> 00:45:42,303
آپ چاہتے ہیں کہ میں دو حسابوں سے گزروں، ایک اللہ کو حساب دوں اور ایک آپ کو حساب دوں

571
00:45:42,364 --> 00:45:45,170
میں اب آپؓ کی طرف سے قیادت کا عہدہ کبھی نہیں سنبھالوں گا

572
00:45:45,216 --> 00:45:48,263
اور اس کے بعد آپؓ کبھی امیر نہیں بنے

573
00:45:48,295 --> 00:45:51,208
 آپؓ نے فرمایا؛ مجھے پہلے ہی اللہ عَزَّوَجَلْ کے حضور حساب کا خوف ہے

574
00:45:51,232 --> 00:45:53,357
اور اب آپؓ بھی میرا احتساب کرنا چاہتے ہیں

575
00:45:53,394 --> 00:45:55,518
لیکن حضرت ابوبکر صدیقؓ کا طرزِ عمل یہی تھا

576
00:45:55,542 --> 00:46:01,067
اور حضرت عمر ابن خطابؓ نے انہی قوانین کا نفاذ جاری رکھا

577
00:46:01,097 --> 00:46:04,703
ہم یمن میں ردّہ کے متعلق گفتگو مکمل کر چکے ہیں

578
00:46:04,739 --> 00:46:08,423
ہم طلیحہ اسدی کے ارتدّاد کی طرف بڑھتے ہیں

579
00:46:08,476 --> 00:46:17,410
یہ ردّہ چار عرب قبائل اسد ، غطفان اور عبس اور ذبیان کے درمیان تھا

580
00:46:17,444 --> 00:46:21,910
طلیحہ اسدی ایک مسلمان تھا

581
00:46:21,950 --> 00:46:28,997
وہ اور اسد کا ایک وفد رسول اللہؐ کے پاس آیا اور عرض کی؛

582
00:46:29,028 --> 00:46:35,510
ہم آپؐ کی بیعت کرنے آئے ہیں، ہم مسلمان ہیں

583
00:46:35,544 --> 00:46:42,803
اور کہنے لگے کہ آپؐ نے ہمیں آنے کے لیے نہیں کہا، ہم خود آئے ہیں

584
00:46:42,844 --> 00:46:49,077
 اور ہم مسلمان ہیں اور وہ اس پر شیخیاں مارتے رہے

585
00:46:49,107 --> 00:46:51,243
پس اللہ عَزَّوَجَلْ نے آیت نازل فرمائی

586
00:46:51,303 --> 00:46:53,336
يَمُنُّونَ عَلَيْكَ أَنْ أَسْلَمُوا ۖ

587
00:46:53,656 --> 00:46:55,629
قُل لَّا تَمُنُّوا عَلَيَّ إِسْلَامَكُم ۖ

588
00:46:55,869 --> 00:46:59,990
بَلِ اللَّهُ يَمُنُّ عَلَيْكُمْ أَنْ هَدَاكُمْ لِلْإِيمَانِ إِن كُنتُمْ صَادِقِينَ۝

589
00:47:00,743 --> 00:47:05,723
ترجمہ ؛ یہ آپؐ پر احسان سمجھتے ہیں کہ انہوں نے اسلام قبول کر لیا

590
00:47:05,757 --> 00:47:09,244
کہہ دیں کہ اپنے اسلام کو مجھ پر احسان نہ سمجھو

591
00:47:09,268 --> 00:47:15,043
بلکہ اللہ نے تم پر یہ احسان کیا ہے کہ اس نے تمہیں ایمان کا راستہ دکھایا ہے

592
00:47:15,084 --> 00:47:16,383
آپ کو حق پرست ہونا چاہئے

593
00:47:16,438 --> 00:47:19,243
یہ سورۃ حجرات کی آیت نمبر سترہ میں ہے

594
00:47:19,274 --> 00:47:23,082
ترجمہ؛" یہ تم پر اللہ کا فضل ہے، اور تم محمدﷺ کے پاس آکر شیخی مت کرو"

595
00:47:23,106 --> 00:47:25,770
"یہ کہہ کر کہ ہم نے مسلمان ہو کر تم پر(آپؐ پر) احسان کیا ہے"

596
00:47:25,813 --> 00:47:29,870
 "یہ اللہ کا احسان ہے کہ اس نے آپ کو مسلمان ہونے کے قابل کیا"

597
00:47:29,918 --> 00:47:32,843
 "اللہ نے بہرحال سیدھے راستے کی طرف رہنمائی عطا کی"

598
00:47:32,880 --> 00:47:37,917
بعد میں طلیحہ اسدی کی نیت بدل گئی اور اس نے نبی ہونے کا دعویٰ کردیا

599
00:47:37,954 --> 00:47:43,463
کیونکہ جب وہ صحرا میں تھے اور ان کے پاس پانی نہیں تھا

600
00:47:43,518 --> 00:47:48,466
طلیحہ اسدی کے اونٹ پر سوار شخص کو پانی ملا

601
00:47:48,506 --> 00:47:53,013
 اس لیے وہ اسے ایک بابرکت اونٹ سمجھنے لگے جو اسے بابرکت شخص سے منسوب کرنے لگے

602
00:47:53,050 --> 00:47:58,090
اس (طلیحہ اسدی) نے اس سے فائدہ اٹھایا اور دعویٰ کیا کہ وہ اللہ کا نبی ہے(معاذاللہ)

603
00:47:58,125 --> 00:48:02,883
اور پھر وہ اسے مضحکہ خیز سورتیں بنائے گا، ، بالکل اسی طرح جیسے مسیلمہ کذاب سورتیں گڑھتا تھا

604
00:48:02,927 --> 00:48:10,823
طلیحہ اسدی ایک بہت ہی دلیر آدمی، طاقتور جنگجو، بہت باصلاحیت سردار تھا

605
00:48:10,864 --> 00:48:15,170
تو ایسے آدمی کی طرف سے یہ دعویٰ بہت خطرناک تھا

606
00:48:15,211 --> 00:48:18,487
طلیحہ اسدی اپنے قبیلے اسد کو قائل کیا

607
00:48:18,519 --> 00:48:24,503
اور پھر ان کا غطفان کے ساتھ معاہدہ طے ہوا، تو غطفان اس میں شامل ہو گئے

608
00:48:24,551 --> 00:48:28,977
اور پھر انہیں عبس اور ذبیان کی شمولیت سے تقویت ملی

609
00:48:29,025 --> 00:48:34,157
تو اب یہ چار بڑے قبائل تھے، یہ سب طلیحہ کی قیادت میں تھے

610
00:48:34,203 --> 00:48:40,710
 ویسے؛ ان تمام نت نئے جھوٹے انبیاء کے ساتھ جو ہر طرف سے ابھر رہے تھے

611
00:48:40,742 --> 00:48:46,823
 ایسا نہیں تھا کہ عرب مذہبی لوگ تھے، ایسا نہیں ہے کہ ان کو ان جھوٹے انبیاء پر یقین تھا

612
00:48:46,862 --> 00:48:52,093
 بدویوں کی فطرت یہ ہوتی ہے کہ وہ مذہبی نہیں ہوتے

613
00:48:52,145 --> 00:48:57,210
اور لوگ سمجھتے ہیں کہ آپ کا یہ گمان ہوسکتا ہے کہ قریش کے لوگ بہت مذہبی تھے

614
00:48:57,241 --> 00:49:01,713
اور اسی وجہ سے وہ اسلام کے بہت مخالف تھے، یہ حقیقت سے بہت دور تھا

615
00:49:01,757 --> 00:49:05,637
قریش کے لوگ زیادہ مذہبی نہیں تھے

616
00:49:05,671 --> 00:49:09,543
اور وہ مذہب کے حوالے سے بھی غیر متعصب تھے

617
00:49:09,585 --> 00:49:12,437
اور یہ وہ چیز ہے جسے لوگ نہیں سمجھتے

618
00:49:12,470 --> 00:49:19,530
عام طور پر، جب مذہبی عمل کی بات آتی ہے تو عرب سب سے زیادہ روادار قوموں میں سے تھے

619
00:49:19,566 --> 00:49:26,250
دنیا کے دیگر حصوں میں، یہ توقع کی جاتی تھی کہ سب ایک ہی مذہب کے پیروکار ہوں یکساں معاشرے کا تصور تھا

620
00:49:26,290 --> 00:49:29,537
فارس میں ، زرتشت(آتش پرستی)

621
00:49:29,569 --> 00:49:32,557
رومیوں میں، وہ غیرمسیحیوں پر ظلم و جبر کرتے تھے

622
00:49:32,599 --> 00:49:34,663
مقدس سرزمین(بیت المقدس) میں یہودیوں کو ستایا گیا

623
00:49:34,704 --> 00:49:37,129
 اس لیے توقع کی جاتی تھی کہ سب ایک ہی مذہب کے پیروکار ہوں

624
00:49:37,153 --> 00:49:41,603
جب کہ عرب میں، مثال کے طور پر یمن میں، یہودی موجود تھے ، عیسائی موجود تھے

625
00:49:41,642 --> 00:49:49,477
 اُن طوائفوں کے ساتھ، ان میں جو سب سے مشہور اور اس تحریک کی سرگرم رہنما تھی، جسے طوائفوں کی تحریک کہا جاتا تھا، ایک یہودی تھی

626
00:49:49,524 --> 00:49:52,017
اس کا نام حر بن یامین الیہودیہ تھا

627
00:49:52,054 --> 00:49:58,483
اور درحقیقت اس طوائف نے جسم فروشی میں ریکارڈ قائم کیا، کہ وہ ایک مثال بن گئی، وہ کہتے؛

628
00:49:58,530 --> 00:49:59,360
أذنا من ھر

629
00:49:59,715 --> 00:50:01,941
جب بھی کسی عورت پر فحاشی کا الزام لگایا جاتا تو کہتے

630
00:50:01,965 --> 00:50:06,283
کہ وہ فحاشی میں "ھر" سے بڑھ کر ہے

631
00:50:06,326 --> 00:50:10,652
لہذا یمن میں آپ دیکھیں کہ یہودی موجود تھے، عیسائی تھے، اور مشرک بھی تھے

632
00:50:10,676 --> 00:50:14,917
اور آپ کے سامنے زرتشتی فارسی(آگ کی عبادت کرنے والے) تھے، اور لوگ ان مذاہب کے بارے میں غیر متعصب تھے

633
00:50:14,964 --> 00:50:18,090
مکہ میں ورقہ بن نوفل عیسائی تھے

634
00:50:18,133 --> 00:50:22,457
زید،حضرت ابراہیمؑ کے مذہب کے پیروکار حنیفی تھے

635
00:50:22,497 --> 00:50:26,830
اور پھر آپ کے سامنے ایسے لوگ بھی تھے جو بالکل بھی مذہب کی پیروی نہیں کرتے تھے، الدہریون یعنی لادین

636
00:50:26,867 --> 00:50:32,070
درحقیقت، عکاظ کا میلہ جہاں مقررین جاتے اور حالاتِ حاضرہ کے ہر موضوع پر بات کرتے

637
00:50:32,104 --> 00:50:36,303
موجودہ ہائیڈ پارک سے مختلف نہیں تھا

638
00:50:36,361 --> 00:50:39,690
مذہب کی بات کی جائے تو یہ(عرب) بہت روادار معاشرہ تھا

639
00:50:39,750 --> 00:50:43,757
زید بن نفیل، وہ جب کعبہ کے پاس کھڑے ہوتے

640
00:50:43,798 --> 00:50:48,170
 اور قریش کے لوگوں سے کہتے کہ تمہارا دین باطل ہے

641
00:50:48,202 --> 00:50:49,717
لستم على شئ

642
00:50:49,865 --> 00:50:55,677
اور وہ ان(قریش) سے کہتے کہ تم ان بتوں کی لیئے قربانی نہ کرو، اور کوئی زید بن نفیل کو نقصان نہیں پہنچاتا تھا

643
00:50:55,709 --> 00:51:01,503
جب رسول اللہؐ کی دعوت توحید کا آغاز ہوا تو وہ(عرب بدوی قبائل) عدم برداشت کا شکار ہو گئے

644
00:51:01,547 --> 00:51:07,010
لہٰذا، جب اسلام کی بات آتی ہے تو ایک انتہائی روادار معاشرہ بھی عدم برداشت کا شکار ہو سکتا ہے

645
00:51:07,048 --> 00:51:10,597
تو جو کچھ تم دیکھتے ہو اس سے دھوکا مت کھاؤ

646
00:51:10,655 --> 00:51:13,297
اہل مکہ اسلام دشمنی میں سب کو پیچھے چھوڑ گئے

647
00:51:13,337 --> 00:51:18,937
دنیا کے سب سے زیادہ روادار معاشروں میں سے ایک معاشرے میں جب اسلام کی بات آئی تو وہ سب سے زیادہ عدم برداشت کا شکار ہو گیا

648
00:51:18,996 --> 00:51:19,624
کیوں؟

649
00:51:19,742 --> 00:51:25,370
کیونکہ اب ان کا سامنا صرف مذہب سے نہیں تھا، ان کا سامنا حق سے تھا

650
00:51:25,441 --> 00:51:30,770
اور وہ جانتے تھے کہ جب حق آتا ہے تو وہ باطل مٹ جاتا ہے

651
00:51:30,820 --> 00:51:32,570
 دونوں ایک ساتھ نہیں رہ سکتے،

652
00:51:32,600 --> 00:51:37,113
برائی برائی کے ساتھ رہ سکتی ہے، ان میں تھوڑا اِختلاف ہے

653
00:51:37,146 --> 00:51:41,503
لیکن جب بات حق کی ہوتی ہے، تو یا تو حق ہوتا ہے یا باطل

654
00:51:41,550 --> 00:51:46,947
چنانچہ یہ قبائل قوم پرستی، قبائلیت کی وجہ سے طلیحة اسدی کے ساتھ شامل ہو رہے تھے

655
00:51:46,996 --> 00:51:50,113
وہ قریش کے کسی آدمی کے سامنے سر تسلیم خم نہیں کرنا چاہتے تھے

656
00:51:50,152 --> 00:51:53,433
میرا مطلب ہے کہ اس سے پہلے نبیؐ تھے لیکن اب حضرت ابوبکرؓ، ابوبکرؓ کون ہیں؟

657
00:51:53,476 --> 00:51:58,073
ہم حضرت ابوبکرصدیقؓ کو بیعت نہیں دیں گے

658
00:51:58,107 --> 00:51:59,527
وہ کون ہیں؟

659
00:51:59,576 --> 00:52:03,170
 چنانچہ وہ طلیحہ اسدی کے جھنڈے تلے آگئے

660
00:52:03,213 --> 00:52:07,910
اب اس اہم مہم کے لیے حضرت ابوبکر صدیقؓ نے

661
00:52:07,950 --> 00:52:09,920
عقد الرایة لِخالد إبن ولید

662
00:52:10,123 --> 00:52:14,067
 آپؓ نے رایۃ(لشکر کا علامتی پرچم)، جھنڈا حضرت خالد بن ولیدؓ کودیا

663
00:52:14,121 --> 00:52:18,797
آپؓ وہ شخص تھے جس کے بارے میں رسول اللہؐ نے فرمایا کہ وہ(حضرت خالد بن ولیدؓ) اللہ کی تلواروں میں سے ایک تلوار ہے

664
00:52:18,851 --> 00:52:22,430
جو(تلوار) کفار اور منافقین کے خلاف تیار کی گئی تھی

665
00:52:22,463 --> 00:52:28,243
سیف من سیوف الله سلّه الله على الكفار والمنافقين

666
00:52:28,363 --> 00:52:35,717
 آپؓ نے لشکر کا پرچم ایک ایسے شخص کو دیا جس نے کبھی جنگ کے میدان میں اپنا پرچم گرنے نہیں دیا

667
00:52:35,760 --> 00:52:44,450
حضرت خالد بن ولیدؓ اپنی زندگی میں چاہے قبولِ اسلام سے قبل یا بعد کی جنگ ہو، کبھی شکست نہیں کھائی

668
00:52:44,511 --> 00:52:48,377
 آپؓ نے اُنھیں طلیحہ سے جنگ کے لیے بھیجا تھا

669
00:52:48,425 --> 00:52:52,393
 اور حضرت ابوبکر صدیقؓ نے حضرت عدی بن حاتمؓ سے فرمایا؛

670
00:52:52,438 --> 00:53:00,423
"جاؤ اور اپنے لوگوں کو بچاؤ، ایسا نہ ہو کہ طلیحہ انہیں گمراہ کر دے"

671
00:53:00,455 --> 00:53:06,410
طائی کا قبیلہ، جو طلیحہ کے علاقے کے قرب و جوار میں واقعہ تھا

672
00:53:06,464 --> 00:53:09,793
یہ قبیلہ ابھی تک طلیحہ کے ساتھ شامل نہیں ہوا تھا

673
00:53:09,830 --> 00:53:19,490
چنانچہ حضرت ابوبکر صدیقؓ چاہتے تھے کہ حضرت عدیؓ جو اپنے قبیلے کے سردار تھے، جتنی جلدی ممکن ہو آپؓ جائیں اور اپنے لوگوں کو جہنم کی آگ سے بچائیں

674
00:53:19,542 --> 00:53:21,110
 حضرت ابوبکر صدیقؓ نے فرمایا؛

675
00:53:21,134 --> 00:53:24,450
أدرك قومك لا يلحقوا بطليحة فيكون دمارهم

676
00:53:24,935 --> 00:53:31,173
اپنی قوم کی طرف جلد سے جلد جاؤ اور انہیں طلیحہ کے فتنے سے بچاؤ، کیونکہ یہ ان کا نقصان ہوگا

677
00:53:31,215 --> 00:53:35,577
حضرت ابوبکرؓ اس مسئلے سے پہلے ہی جانچ چکے تھے، طلیحہ شکست خوردہ ہو چکا تھا

678
00:53:35,615 --> 00:53:40,303
اس لیے آپؓ نے حضرت عدیؓ سے فرمایا کہ جلد جاؤ اور اپنے لوگوں کو بچاؤ اس سے پہلے کہ وہ ہلاک ہو جائیں

679
00:53:40,336 --> 00:53:44,850
حضرت ابوبکرؓ کے یہ کوئی غیر مبہم چیز نہیں تھی، آپؓ پہلے سے ہی نتائج سے آگاہ تھے

680
00:53:44,891 --> 00:53:48,043
 اگر آپ طلیحہ کی حمایت کرتے ہیں تو آپ خسارے میں ہیں

681
00:53:48,083 --> 00:53:50,037
تو آپؓ نے حضرت عدیؓ سے فرمایا؛ جاؤ اور ان کو بچاؤ

682
00:53:50,100 --> 00:53:53,563
اور حضرت عدی بن حاتمؓ مسلمان تھے

683
00:53:53,599 --> 00:53:57,170
جنہوں نے رسول اللہؐ کی خدمت میں حاضر ہو کر اسلام کی بیعت کی تو آپؓ صحابہ میں سے ہیں

684
00:53:57,223 --> 00:54:02,743
آپؓ وہ شخص تھے جو صلیب پہنے ہوئے داخل ہوئے، آپؓ عیسائی تھے

685
00:54:02,775 --> 00:54:06,920
 آپؓ صلیب پہنے ہوئے تھے جب حضرت محمدﷺ سے ملاقات کے لیے آئے

686
00:54:06,957 --> 00:54:10,936
چنانچہ جب رسول اللہؐ نے ان کے سینے پر صلیب لٹکتی دیکھی، آپؐ نے فرمایا؛

687
00:54:10,960 --> 00:54:14,970
اتَّخَذُوا أَحْبَارَهُمْ وَرُهْبَانَهُمْ أَرْبَابًا مِّن دُونِ اللَّهِ

688
00:54:15,014 --> 00:54:20,277
ترجمہ؛" انہوں نے اللہ کو چھوڑ کر اپنے ربی(یہودی علماء) اور پجاریوں(عیسائی راہبوں) کو معبود بنا لیا ہے"

689
00:54:20,312 --> 00:54:24,207
حضرت عدیؓ نے عرض کی؛ ہم اپنے راہبوں کو خدا نہیں مانتے

690
00:54:24,243 --> 00:54:28,223
حضرت عدیؓ عیسائیت کے بارے میں رسول اللہؐ کی معلومات کی اصلاح کرنے کی کوشش کر رہے تھے

691
00:54:28,260 --> 00:54:32,597
  آپؓ نے فرمایا ؛ ہم اپنے علما, کو خدا نہیں مانتے

692
00:54:32,652 --> 00:54:34,603
 رسول اللہؐ نے فرمایا؛

693
00:54:34,646 --> 00:54:38,710
کیا ان پادریوں نے جو حلال تھا اسے حرام نہیں بنایا؟

694
00:54:38,763 --> 00:54:40,940
اور جو حرام تھا اسے حلال کیا؟

695
00:54:40,975 --> 00:54:44,970
جس چیز کو اللہ نے حلال کیا اسے انہوں نے حرام کر دیا اور جس کو اللہ نے حرام قرار دیا اسے انہوں نے حلال کر دیا

696
00:54:45,017 --> 00:54:50,793
حضرت عدیؓ نے فرمایا ؛جی ہاں! آپﷺ نے فرمایا کہ یہ اللہ کے سوا مخلوق کی عبادت کرنے کے مترادف ہے

697
00:54:50,829 --> 00:54:55,290
جب سینٹ پال کہتا ہے کہ بائبل کا تمام قانون اب تحلیل ہو چکا ہے

698
00:54:55,335 --> 00:54:57,900
آپ کو تورات کے قانون پر عمل کرنے کی ضرورت نہیں ہے

699
00:54:57,935 --> 00:55:01,813
وہ کیا ہے؟ یہ حرام کو حلال بنا رہا ہے

700
00:55:01,861 --> 00:55:07,750
جب حضرت عیسیٰ ابن مریمؑ فرماتے ہیں کہ میں شریعت کی تکمیل حکمِ خداوندی کے عین مطابق؛ حرف بہ حرف  کروانے آیا ہوں

701
00:55:07,788 --> 00:55:10,623
اور پھر سینٹ پال نے ان قوانین کو مسترد کردیا

702
00:55:10,662 --> 00:55:14,690
 اور وہ کہتا ہے؛ نہیں! آپ کو قانون پر عمل کرنے کی ضرورت نہیں ہے

703
00:55:14,726 --> 00:55:19,460
یعنی یہ اللہ عَزَّوَجَلْ کے علاوہ اس(سینٹ پال) کی عبادت کرنے کے مترادف ہے

704
00:55:19,500 --> 00:55:25,797
عربوں کے مذہب کے معاملے پر واپس جائیں تو شمالی قبائل عیسائی تھے

705
00:55:25,862 --> 00:55:30,383
چنانچہ حضرت علی بن ابی طالبؓ سے ان سے خریدہ ہوا گوشت کھانے کے بارے میں پوچھا گیا کیونکہ وہ عیسائی تھے

706
00:55:30,427 --> 00:55:31,903
 حضرت علی بن ابی طالبؓ نے فرمایا؛

707
00:55:31,938 --> 00:55:36,903
وہ عیسائیت کے بارے میں کچھ نہیں جانتے مگر شراب پیتے ہیں، بس، وہ اس کے بارے میں یہی جانتے ہیں

708
00:55:36,971 --> 00:55:39,463
ليس لهم من النصراني ألأشرب من الخمر

709
00:55:39,502 --> 00:55:43,290
یہ لوگ مذہبی نہیں ہیں، یہ مذہب کے دائرے میں نہیں ہیں

710
00:55:43,343 --> 00:55:48,947
چنانچہ حضرت عدی بن حاتمؓ اپنی قوم سے درخواست کرنے گئے

711
00:55:48,985 --> 00:55:51,330
اور آپؓ نے حضرت خالد بن ولیدؓ سے فرمایا؛ مجھے تین دن کی مہلت دیں

712
00:55:51,376 --> 00:55:54,730
کیونکہ حضرت خالدؓ طائی قبیلے پر حملہ کرنے کے لیے تیار تھے

713
00:55:54,763 --> 00:56:01,240
حضرت عدیؓ نے فرمایا ؛ ٹھہرو، کیونکہ طائی نے طلیحہ کے ساتھ شامل ہونے کے لیے کچھ جنگجو بھیجے ہیں

714
00:56:01,290 --> 00:56:08,037
اس لیے وہ پہلے ہی فتنے میں پڑ چکے تھے وہ سب نہیں لیکن انھوں نے اپنے کچھ آدمیوں کو طلیحہ کے لشکر میں جنگ لڑنے کے لیے بھیج دیا تھا

715
00:56:08,100 --> 00:56:10,042
چنانچہ حضرت خالدؓ ان پر حملہ کرنے کے لیے تیار تھے حضرت عدیؓ نے فرمایا؛

716
00:56:10,172 --> 00:56:13,037
مجھے صرف تین دن کی مہلت دیں، پھرآپؓ نے حضرت خالد بن ولیدؓ سے فرمایا؛

717
00:56:13,069 --> 00:56:18,290
کیا یہ بہتر نہیں کہ میں انہیں جہنم کی آگ سے بچاؤں؟

718
00:56:18,332 --> 00:56:25,407
کیا آپ چاہتے ہیں کہ وہ جہنم میں جائیں، یا جہنم سے بچ جائیں، اور آپ سے جنگ نہ کریں

719
00:56:25,451 --> 00:56:27,770
تو حضرت خالد بن ولیدؓ نے فرمایا ؛ میں آپؓ کو تین دن کی مہلت دوں گا

720
00:56:27,800 --> 00:56:30,040
چنانچہ حضرت عدیؓ اپنے قبیلے میں گئے، ان کی قوم نے کہا؛

721
00:56:30,067 --> 00:56:35,610
ہم کبھی بھی نومولود اونٹ کے باپ "ابوالفصیل" کی بیعت نہیں کریں گے

722
00:56:35,652 --> 00:56:41,583
کیونکہ میں نے بتایا تھا کہ بکر کا مطلب نوجوان اونٹ ہے جو بہت طاقتور ہوتا ہے

723
00:56:41,630 --> 00:56:46,683
لیکن وہ آپؓ کو ابوالفصیل کہہ رہے تھے، فصيل" نومولود اونٹ" ہے، جو کمزور ہوتا ہے

724
00:56:46,754 --> 00:56:50,113
چنانچہ وہ حضرت ابوبکرؓ کو "کمزور اونٹ کے باپ" کا لقب دے رہے تھے

725
00:56:50,178 --> 00:56:52,727
وہ آپؓ کو کمزور آدمی سمجھتے تھے، وہ کہنے لگے

726
00:56:52,757 --> 00:56:58,603
 تم چاہتے ہو کہ ہم طائی قبیلے والے نومولود اونٹ کے باپ کی بیعت کریں

727
00:56:58,628 --> 00:57:06,037
حضرت عدی بن حاتمؓ نے فرمایا؛ سنو، آپؓ کی فوجیں یکے بعد دیگرے تمہاری سرزمین پر چڑھیں گی

728
00:57:06,085 --> 00:57:12,103
 اور وہ آپ کو سبق سکھائیں گی کہ ابوبکرؓ ایک طاقتور اونٹ کا باپ ہے نہ کہ نومولود اونٹ کا

729
00:57:12,137 --> 00:57:15,650
 آپؓ نے فرمایا؛ میری بات سُنو اور اپنی بیعت انھیں دے دو

730
00:57:15,695 --> 00:57:16,843
انہوں نے انکار کر دیا

731
00:57:16,898 --> 00:57:23,335
آپؓ وہاں ٹھہرے رہے ، کوشش کرتے رہے، بار بار ان سے بات چیت کرتے رہے، تین دن تک انہیں قائل کرنے کی کوشش کرتے رہے

732
00:57:23,415 --> 00:57:26,657
حتیٰ کہ آپؓ طائی کی ایک شاخ کو قائل کرنے میں کامیاب ہوگئے

733
00:57:26,700 --> 00:57:29,993
طائی قبیلے کی دو ذیلی شاخیں تھی،آپؓ نے ایک کو قائل کرلیا

734
00:57:30,023 --> 00:57:31,133
آپؓ واپس حضرت خالدؓ کے پاس گئے اور فرمایا؛

735
00:57:31,157 --> 00:57:35,200
مجھے کچھ وقت دیں، کیونکہ میں نے ایک حصے کو بچا لیا ہے، مجھے دوسرے حصے کو بچانے کے لیے کچھ وقت دیں

736
00:57:35,250 --> 00:57:36,683
حضرت خالدؓ نے فرمایا ؛ آگے بڑھو

737
00:57:36,743 --> 00:57:43,050
 آپؓ نے اپنی پوری کوشش کی اور وہ طائی قبائل کا طلیحہ کے ساتھ قائم کردہ اتحاد توڑنے میں کامیاب ہو گئے

738
00:57:43,087 --> 00:57:47,230
اب انہوں نے کہا؛ ہمیں طلیحہ کے لشکر سے اپنے جنگجوؤں کو واپس بلانا ہے

739
00:57:47,311 --> 00:57:52,423
کیونکہ اگر طلیحہ نے سن لیا کہ اب ہم مسلمان ہیں تو وہ ہمارے آدمیوں کو مار ڈالے گا

740
00:57:52,483 --> 00:57:55,750
اور وہ انھیں واپس بلانے میں کامیاب ہوگئے

741
00:57:55,805 --> 00:57:57,056
چنانچہ ابن کثیرؒ فرماتے ہیں؛

742
00:57:57,080 --> 00:58:01,597
حضرت عدی بن حاتمؓ کو اپنی قوم کے لیے سب سے بابرکت آدمی سمجھا جاتا تھا

743
00:58:01,631 --> 00:58:04,140
آپؓ نے انہیں جہنم کی آگ سے بچا لیا

744
00:58:04,169 --> 00:58:14,957
حضرت خالد بن ولیدؓ نے دو صحابہ کو طلیحہ کی فوج کے لیے جاسوسی کے مشن پر روانہ کیا

745
00:58:14,990 --> 00:58:19,723
یہ دونوں صحابی حضرت عکاشہ بن محصنؓ، اور حضرت ثابت بن قیس بن شماسؓ تھے

746
00:58:19,766 --> 00:58:21,817
دونوں ممتاز صحابہ میں سے تھے

747
00:58:21,874 --> 00:58:26,973
طلیحہ اسدی اور اس کا بھائی بھی مسلمانوں کی جاسوسی کر رہے تھے

748
00:58:27,008 --> 00:58:33,937
 طلیحہ بہت دلیر آدمی تھا، وہ اکیلا اپنے بھائی کے ساتھ باہر نکلا تھا

749
00:58:33,985 --> 00:58:40,310
اور انہوں نے حضرت عکاشہؓ اور حضرت ثابت بن قیسؓ کو شہید کر دیا

750
00:58:40,340 --> 00:58:45,913
چنانچہ جب وہ واپس نہ آئے تو حضرت خالد بن ولیدؓ اپنے لشکر کے ساتھ اُنہیں تلاش کرنے نکلے، اور انہوں نے دونوں صحابہ کے جسدِ خاکی دیکھے

751
00:58:45,963 --> 00:58:50,130
تاریخ کی کتابوں میں لکھا ہے کہ مسلمانوں کے لیے یہ بہت بڑا دھچکا تھا

752
00:58:50,173 --> 00:58:57,303
رسول اللہؐ کے دو عظیم ساتھیوں کو ایک لمحے میں، بالکل اچانک کھونے سے انہیں بہت رنجھ ہوا

753
00:58:57,350 --> 00:59:01,327
چنانچہ مسلمانوں کے لیے یہ بہت مشکل لمحہ تھا

754
00:59:01,360 --> 00:59:08,177
لیکن حضرت خالد بن ولیدؓ نے اپنی جنگی چال چلی اور انہوں نے حملہ کیا اور آپؓ، طلیحہ اسدی کو شکست دینے میں کامیاب ہو گئے

755
00:59:08,215 --> 00:59:11,517
اب طلیحہ کے اتحادیوں میں سے عیینہ بن حصن تھے

756
00:59:11,577 --> 00:59:18,287
 عیینہ بن حصن ان لوگوں میں سے تھا جنہوں نے  رسول اللہؐ کی بارگاہ میں حاضر ہو کر بیعت کی، اور پھر اس نے یہ بیعت توڑ دی اور دوبارہ آیا

757
00:59:18,317 --> 00:59:22,647
یہ بدّو اپنے عہد کو توڑتے اور پھر تجدید کرتے، یہ ڈگمگانے والے اعراب جانے جاتے تھے

758
00:59:22,694 --> 00:59:26,277
چنانچہ عيينة بن حصن نے طليحہ کے ساتھ اتحاد کر لیا

759
00:59:26,320 --> 00:59:31,317
چنانچہ جب جنگ ہو رہی تھی، طلیحة اسدی اپنے خیمے میں موجود تھا

760
00:59:31,372 --> 00:59:33,390
 وحی آنے کا انتظار کررہا تھا

761
00:59:33,425 --> 00:59:37,103
تو عیینہ اس کے پاس گیا اور کہا؛ کیا تمہارے پاس حضرت جبرائیلؑ تشریف لائے، اس نے کہا؛ نہیں

762
00:59:37,160 --> 00:59:40,727
وہ گیا اور لڑائی میں شامل ہوا پھر واپس آیا اور پوچھا؛ کیا حضرت جبرائیل کی تشریف آوری ہوئی؟ اس نے کہا؛  نہیں

763
00:59:40,748 --> 00:59:43,843
 وہ تیسری بار آیا، کیا حضرت جبرئیلؑ تشریف لائے؟ تو اس نے کہا؛ ہاں

764
00:59:43,897 --> 00:59:48,364
عیینہ نے پوچھا ؛ انھوں نے تمہیں کو کیا بتایا؟ اس نے کہا؛ میں تمہیں دانا پیسنے والی چکی اور ایک بڑی خبر دیتا ہوں

765
00:59:48,422 --> 00:59:54,113
 عیینہ ایسی وحی کا انتظار نہیں کر رہا تھا، اُسے کسی اور چیز کا انتطار تھا۔۔اس نے کہا بتاؤ ہم کیا کریں؟

766
00:59:54,143 --> 00:59:57,390
اس نے کہا؛ ٹھیک ہے، آپ کو کوئی اچھی خبر ملنے والی ہے، عیینہ وہاں سے چلا گیا

767
00:59:57,415 --> 01:00:00,523
اور اس نے اپنے تمام جنگجوؤں کو حکم دیا کہ طلیحہ کو چھوڑ دو

768
01:00:00,593 --> 01:00:03,510
اور یہ طلیحہ کے انجام کار کا آغاز تھا

769
01:00:03,542 --> 01:00:05,630
جب طلیحہ کو احساس ہوا کہ اسے شکست ہو رہی ہے

770
01:00:05,675 --> 01:00:14,607
وہ اور اس کا بھائی اور اس کی بیوی اور اس کے کچھ قریبی دوست اپنے اونٹوں اور گھوڑوں پر سوار ہوئے، اور عراق اور شام کی طرف فرار ہو گئے

771
01:00:14,655 --> 01:00:18,797
اور یہ طلیحہ اسدی کے فتنے کا خاتمہ تھا

772
01:00:18,848 --> 01:00:24,063
اب یہ خبر حضرت ابوبکرؓ تک پہنچی، یہ بہت بڑی فتح تھی

773
01:00:24,130 --> 01:00:26,383
 آپؓ نے حضرت خالدؓ کو یہ بتانے کے لیےخط بھیجا

774
01:00:26,425 --> 01:00:31,287
کہ اللہ تعالیٰ نے اپنے فضل سے آپؓ کو جن نعمتوں سے نوازا ہے اللہ آپؓ کے لیے اس میں اضافہ فرمائے

775
01:00:31,318 --> 01:00:38,170
فرمایا ؛ اپنے معاملات میں اللہ سے ڈرو، بے شک اللہ ان لوگوں کے ساتھ ہے جو پرہیزگار ہیں اور اچھے کام کرتے ہیں

776
01:00:38,219 --> 01:00:46,983
اللہ کے حکم پر سنجیدگی سے عمل پیرا رہیں اور نرمی نہ کریں، اور کفار میں سے جو آپ کے ہاتھ آئے، جنہوں نے مسلمانوں سے جنگ کی

777
01:00:47,008 --> 01:00:51,380
پھر آپؓ نے ان کو سخت سے سخت سزا دیں اور دوسروں کے لیے عبرت کی مثال بنا دیں

778
01:00:51,426 --> 01:00:56,743
پس جس کو چاہیں قتل کریں ان میں سے جنہوں نے اللہ سے دشمنی کی یا اس کی مخالفت کی

779
01:00:56,782 --> 01:00:59,840
اگر آپ کو لگتا ہے کہ ایسا کرنے میں کوئی فائدہ ہوگا

780
01:00:59,886 --> 01:01:07,917
چنانچہ خلیفہ کے ان احکامات کی وجہ سے جو کہ مرتدین کو سخت ترین سزا دینے اور انھیں عبرت کی ایک مثال بنانے کے لیے تھے

781
01:01:07,978 --> 01:01:16,217
حضرت خالد بن ولیدؓ پورے مہینے تک گردوپیش، قرب وجوار اور اس علاقے میں رہے اور مرتدین کو گرفتار کرتے رہے

782
01:01:16,255 --> 01:01:28,543
اور اُن کو آگ میں جلا کر، سنگسار کر کے، پہاڑوں کی چوٹیوں سے پھینک کر اور کنوؤں میں ڈال کر، اور ان کو تیروں سے چھید کر قتل کرتے رہے، یہ ایک بہت سخت سزا تھی

783
01:01:28,631 --> 01:01:32,143
لیکن آپؓ یہ کام باقی مرتدین کے لیے ایک عبرت ناک مثال قائم کرنے کے لیے کر رہے تھے

784
01:01:32,178 --> 01:01:35,423
کہ ردَّة کو برداشت نہیں کیا جائے گا

785
01:01:35,480 --> 01:01:42,510
الفجاع ان میں سے ایک مرتد تھا جو حضرت ابوبکر صدیقؓ کے پاس آیا

786
01:01:42,544 --> 01:01:48,063
اور کہنے لگا ؛ میں مرتدین سے جنگ لڑنے جا رہا ہوں، مجھے ایک لشکر دیں

787
01:01:48,088 --> 01:01:52,090
حضرت ابوبکرؓ نے انہیں اونٹ اور ہتھیار فراہم کئے

788
01:01:52,148 --> 01:01:58,823
الفجاع چلا گیا اور اس نے خلیفہ کے دیے ہوئے وہ ہتھیار اور اونٹ کو غلط استعمال کیا

789
01:01:58,866 --> 01:02:07,770
 ایک صحرائی ڈاکو کی حیثیت سے ہر مسلم و غیر مسلم پر چھاپہ مار کر سازوسامان لوٹتا

790
01:02:07,822 --> 01:02:12,990
جب خلیفہ کو اس کی خبر ملی تو آپؓ نے اس کے تعاقب کے لیے ایک لشکر بھیجا

791
01:02:13,049 --> 01:02:17,970
انہوں نے الفجاع کو گرفتار کر لیا اور وہ اسے باندھ کر مدینہ واپس لے آئے

792
01:02:18,002 --> 01:02:30,480
چنانچہ خلیفہ نے حکم دیا کہ اس کے جرم کی سزا کے طور پر، اسے بقیع میں سب کے سامنے جلا دیا جائے

793
01:02:30,541 --> 01:02:35,470
طلیحہ بعد میں مسلمان ہوگیا، اسے اپنے کیے پر پچھتاوا تھا

794
01:02:35,495 --> 01:02:38,260
 اور اس نے حضرت ابوبکر صدیقؓ کے زمانے میں عمرہ کیا

795
01:02:38,338 --> 01:02:42,350
تو انہوں نے حضرت ابوبکرؓ کو بتایا کہ طلیحہ یہاں ہے

796
01:02:42,397 --> 01:02:47,277
حضرت ابوبکرؓ نے فرمایا ؛ میں اس کے ساتھ کیا سلوک کروں، وہ مسلمان ہو چکا ہے

797
01:02:47,323 --> 01:02:51,903
لیکن، اس پر کسی بھی مسلم فوج میں شرکت پر پابندی لگا دی گئی

798
01:02:51,957 --> 01:02:55,557
 اس کے بعد وہ بہت سی فتوحات کا حصہ بنے

799
01:02:55,596 --> 01:03:01,657
اور انھوں نے ہمت اور بہادری کی چند حیرت انگیز مثالیں قائم کیں فی سبیل اللہ

800
01:03:01,701 --> 01:03:05,877
پس اللہ جسے چاہے ہدایت دے ۔ یہ وہ شخص ہے جس نے نبوت کا دعویٰ کیا تھا

801
01:03:05,916 --> 01:03:12,650
اس کی وجہ سے سینکڑوں لوگ جہنم میں چلے گئے اور آخرکار وہ مسلمان ہو گیا

802
01:03:12,704 --> 01:03:15,990
راہِ ہدایت دیکھیں، یہ اللہ تبارک تعالٰی کی قدر ہے

803
01:03:16,042 --> 01:03:22,023
ابو طالب، جنھوں نے ساری زندگی رسول اللہؐ کی مدد کی وہ جہنم میں جائیں گے

804
01:03:22,074 --> 01:03:27,043
اور حضرت ابوسفیانؓ جو ساری زندگی رسول اللہؐ کے خلاف سرگرمِ عمل رہے، وہ مومن بن گئے

805
01:03:27,104 --> 01:03:30,903
ہدایت اللہ عَزَّوَجَلْ کے ہاتھ میں ہے

806
01:03:30,937 --> 01:03:34,180
قبیلہ اسد اور غطفان کو اپنے کیے پر ندامت تھی

807
01:03:34,209 --> 01:03:42,057
جب طلیحہ نے انہیں چھوڑ دیا، اور وہ خلیفہ حضرت ابوبکر صدیقؓ کے پاس آئے

808
01:03:42,106 --> 01:03:47,690
اور وہ تائب ہونا چاہتے تھے، وہ خلیفہ کے پاس آئے اور کہنے لگے؛

809
01:03:47,756 --> 01:03:51,977
ہم آپؓ سے صلح کرنا چاہتے ہیں

810
01:03:52,008 --> 01:03:53,703
خلیفہ نے کیا فرمایا؟

811
01:03:53,747 --> 01:03:58,290
 آپؓ نے فرمایا ؛ میں آپ کو دو میں سے ایک راستہ منتخب کرنے کا موقع دیتا ہوں، میرے پاس آپ کے لیے یہی ہے

812
01:03:58,333 --> 01:04:01,686
فأما الحرب المجلية أو الخطة المخزية

813
01:04:02,706 --> 01:04:09,130
یا تو تباہی کی جنگ، یا ذلت آمیز معاہدہ

814
01:04:09,182 --> 01:04:13,420
وہ کہنے لگے؛ ہم جانتے ہیں کہ جنگِ فنا کا کیا مطلب ہے، اس کا مطلب ہے کہ آپؓ ہم سب کو قتل کر دیں گے

815
01:04:13,452 --> 01:04:17,203
لیکن ذلت آمیز معاہدے کا کیا مطلب ہے؟

816
01:04:17,239 --> 01:04:25,677
 آپؓ نے فرمایا ؛ نمبر ایک، تم اپنے تمام ہتھیار ہمارے حوالے کر دو اور صرف اپنے اونٹوں کے ساتھ منسلک ہو جاؤ

817
01:04:25,708 --> 01:04:31,027
آپ جانتے ہیں، ان کے نزدیک، ان کے ہتھیار چھیننا ان کی توہین تھی

818
01:04:31,061 --> 01:04:34,411
اب، مسلمانوں کے لیے یہ کوئی مسئلہ نہیں ہے کہ لوگ اس طرح ہی کی زندگی گزار رہے ہیں

819
01:04:34,435 --> 01:04:38,890
وہ اس کو مسئلہ نہیں سمجھتے، لیکن ان کے لیے زمانہ جاہلیت سے ہی یہ اصول تھا

820
01:04:38,938 --> 01:04:41,084
اپنے ہتھیاروں کے بغیر جینا ذلت تھی

821
01:04:41,108 --> 01:04:44,833
تو آپؓ کا مطلب تھا کہ یہ ایسے ہے کہ تم اور تمہارا اونٹ ایک مثل ہیں

822
01:04:44,864 --> 01:04:47,320
 اپنے ہتھیاروں کے بغیر، آپ اب اونٹ سے مختلف نہیں

823
01:04:47,375 --> 01:04:51,637
آپؓ نے فرمایا ؛ تم اپنے ہتھیار چھوڑ دو اور صرف اپنے اونٹوں پالو

824
01:04:51,676 --> 01:04:58,077
یہاں تک کہ اللہ تعالی، خلیفہُ رسول اللہؓ اور مومنین کے دل میں آپ کے لیے نرمی ڈال دے

825
01:04:58,138 --> 01:05:00,310
کہ آپ کی معافی قبول کرلی جائے

826
01:05:00,361 --> 01:05:02,303
تو تم اپنے ہتھیار ہمارے حوالے کر دو

827
01:05:02,339 --> 01:05:08,314
اور پھر جب بھی اللہ، خلیفہ اور مومنین آپ کی معذرت قبول کریں

828
01:05:08,352 --> 01:05:11,753
 ہم تمہیں معاف کر دیں گے، لیکن میں آپ سے وعدہ نہیں کر سکتا کہ کب تک؟

829
01:05:11,798 --> 01:05:19,850
خلیفہ نے فرمایا؛ نمبر دو، آپ سرِعام اعلان کریں کہ آپ میں سے جو لوگ مارے گئے وہ جہنم جانے والے ہیں

830
01:05:19,911 --> 01:05:23,223
 اور ہم میں سے جو مارے گئے وہ جنت میں جانے والے ہیں

831
01:05:23,263 --> 01:05:28,010
میں آپ سے یہ سب کے سامنے، آپ کے لوگوں کے سامنے عوامی طور پر سننا چاہتا ہوں

832
01:05:28,073 --> 01:05:33,374
نمبر تین، تم ان لوگوں کے لیے قصاص کی رقم ادا کرو گے، جنہیں تم نے قتل کیا ہے

833
01:05:33,398 --> 01:05:36,717
اور تم میں سے جن کو ہم نے قتل کیا ہے اس کے بدلے ہم تمہیں کچھ  ادا نہیں کریں گے

834
01:05:36,772 --> 01:05:41,127
حضرت عمر بن خطابؓ نے فرمایا ؛ میں اس آخری بات سے اختلاف کرتا ہوں

835
01:05:41,179 --> 01:05:43,967
آپؓ نے فرمایا ؛ ہمیں قصاص کی رقم نہیں چاہیئے

836
01:05:44,007 --> 01:05:46,917
کیونکہ ہم میں سے قتل ہونے والے شہداء ہیں

837
01:05:46,953 --> 01:05:49,637
اور وہ اللہ کی راہ میں شہید ہوئےہیں

838
01:05:49,675 --> 01:05:53,070
اس لیے ہمارا کوئی نقصان نہیں ہے ، یہ ان کے لیے اعزاز کی بات ہے

839
01:05:53,118 --> 01:05:55,087
لیکن پھر آپؓ نے فرمایا ؛ میں باقی تمام شرائط سے متفق ہوں

840
01:05:55,136 --> 01:05:57,070
 میرا مطلب ہے، حضرت عمر بن خطابؓ بھی یہی چاہتے تھے

841
01:05:57,094 --> 01:05:59,557
 میرا مطلب یہ ہے، جی ہاں، ٹھیک ہے! زبردست

842
01:05:59,582 --> 01:06:06,793
حضرت ابوبکر صدیقؓ نے ان کو یہ سبق دیا کہ وہ نومولود اونٹ کا باپ نہیں بلکہ ایک طاقتور اونٹ کا باپ ہے

843
01:06:06,843 --> 01:06:12,277
اور انہیں اپنے اونٹوں کی دموں کے پیچھے چلتے ہوئے اپنے ہتھیاروں سے دستبردار ہونا پڑا

844
01:06:12,331 --> 01:06:19,617
جب تک کہ بعد میں آپ کا خلیفہ فیصلہ کرے گا کہ آپ کی معافی کب قبول کرنی ہے، جس گناہ کے آپ مرتکب ہوئے تھے

845
01:06:19,666 --> 01:06:23,340
صَلَّى الله عَلى سَيَّدِنَا محمد وَعَلى اَلِهِ وَ صَحْبِهِ وَسَلِّمْ

