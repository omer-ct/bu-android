1
00:00:21,597 --> 00:00:24,512
اَعُوْذُ بِاللهِ مِنَّ الشِّيْطَانِ الرَّجِيْمِ۝بِسْمِ اللهِ الرَّحْمَانِ الرَّحِيْمَ۝

2
00:00:24,536 --> 00:00:33,170
اَلْحَمْدُ لله ، وَالصَّلَاةُ وَالسَّلَامُ عَلى سَيِّدِنَا محمد وَعَلَى اَلِهِ وَصَحْبِهِ وَسَلِّمْ تَسْلِيْمًا كَثِيْرا

3
00:00:34,363 --> 00:00:44,190
مسلمانوں نے چالیس(40) سے پینتالیس(45) ہزار مجاہدین پر مشتمل لشکر تیار کیا

4
00:00:44,221 --> 00:00:51,263
جبکہ، ان کے مخالفین کا لشکر تقریباً اڑھائی لاکھ(250,000) جنگجوؤں پر مشتمل تھا

5
00:00:51,307 --> 00:01:03,663
اور ہرقل نے تمام فوج کے سپہ سالار اپنے بھائی تھیوڈر کو خط بھیج کر ایسے میدانِ جنگ کا انتخاب کرنے کو کہا

6
00:01:03,708 --> 00:01:16,517
ہرقل نے بھائی سے کہا؛ ایسی جگہ کا انتخاب کرو جو جنگ کے لیے وسیع میدان فراہم کرے لیکن پسپائی اختیار کرنے کی گنجائش نہ ہو

7
00:01:16,554 --> 00:01:19,169
کیونکہ وہ اپنے سپاہیوں کو آخری لمحے تک لڑنے پر مجبور کرنا چاہتا تھا

8
00:01:19,194 --> 00:01:25,315
وہ پہلے بھی چند محاذوں پر مسلمانوں سے جنگ سے لڑنے کا تجربہ کر چُکے تھے

9
00:01:25,340 --> 00:01:30,107
آپ کے سامنے جنگ موتہ اور پھر اجنادین کا محاز ہے، جو جنگِ یرموک سے پہلے پیش آئے

10
00:01:30,130 --> 00:01:31,890
جس کے متعلق ہم نے پچھلی بار بات کی تھی

11
00:01:31,918 --> 00:01:36,143
جس میں حضرت خالد بن ولیدؓ، فلسطین میں حضرت عمرو بن عاصؓ کو بحفاظت نکالنے کے لیے گئے تھے

12
00:01:36,186 --> 00:01:42,903
اور انہوں نے رومی فوج کو آ گھیرا اور یہ رومی شہنشاہ کے لیے عبرتناک شکست تھی

13
00:01:42,937 --> 00:01:48,337
چنانچہ اب ہرقل نے ایک بڑا لشکر تیار کیا اور اس نے اپنے بھائی تھیوڈور سے کہا؛

14
00:01:48,386 --> 00:01:52,277
 اس بات کو یقینی بناؤ کہ میدانِ جنگ میں پسپا ہونے کی کوئی گُنجائش نہ ہو

15
00:01:52,322 --> 00:01:55,450
تاکہ ہم اپنے فوجیوں کو لڑنے پر مجبور کر سکیں

16
00:01:55,493 --> 00:02:03,190
علاوہ ازیں، چٹان کی طرف پشت کئے ہوئے رومی، یرموک کی وادی میں تاحدِ نگاہ پھیلے ہوئے تھے

17
00:02:03,231 --> 00:02:11,900
ان کے ساتھ ایسی پیادہ فوج بھی تھی، جوکہ آہنی زنجیروں سے باہم منسلک دس، دس سپاہیوں پر مشتمل دستے تھے

18
00:02:11,928 --> 00:02:20,137
لہذا دس سپاہیوں کے ہر دستے کے پاس ایک آہنی زنجیر تھی، جو انہیں ایک دوسرے سے باندھے ہوئے تھی

19
00:02:20,178 --> 00:02:25,980
تاکہ اگر کوئی سپاہی میدان جنگ سے پسپائی اختیار کرنا چاہے تو اسے اپنے پورے دستے کو قائل کرنا پڑے

20
00:02:25,996 --> 00:02:31,583
 علاوہ ازیں، اِس وجہ سے ان سپاہیوں کی نقل و حرکت بھی کافی مشکل ہو گئی تھی، لہذا وہ لوگ تقریباً ایک مخصوص انداز سے ہی لڑ سکتے تھے

21
00:02:31,622 --> 00:02:36,250
تمام پیادہ سپاہی ایسے نہیں تھے لیکن ان کی کافی بڑی تعداد زنجیروں سے باہمی بندھی ہوئی تھی

22
00:02:36,282 --> 00:02:40,710
اور میرے کہنے کا مطلب یہ ہے کہ یہ جنگی حکمتِ عملی پہلی بار اختیار نہیں کی گئی تھی

23
00:02:40,743 --> 00:02:47,000
کیونکہ غزوہ ذات ألسلاسل میں حضرت عمرو بن عاصؓ کو بھی ایسی صورتحال کا سامنا کرنا پڑا تھا

24
00:02:47,034 --> 00:02:53,890
 لہذا یہ ایک جنگی حکمتِ عملی تھی جو دراصل ان فوجیوں کو لڑنے پر مجبور کرنے کے لیے استعمال کی گئی تھی

25
00:02:53,933 --> 00:02:58,592
تو اب رومیوں نے ہی اس میدانِ جنگ کا انتخاب کیا

26
00:02:58,617 --> 00:03:01,031
اور جب حضرت عمرو بن عاصؓ نے دیکھا تو مسلمانوں سے فرمایا؛

27
00:03:01,056 --> 00:03:05,339
أبشروا فقلما جاء محصور بخير

28
00:03:05,466 --> 00:03:12,557
خوش ہوجاؤ کہ یہ فتح کی نوید ہے، شازونادر ہی ایسا ہوتا ہے کہ میدان جنگ میں ایک کونے سے آنے والا حریف فاتح بن جائے

29
00:03:12,596 --> 00:03:16,157
یہ وہ دشمن ہے جس نے جنگ میں اپنے لشکر کے لئے میدانِ جنگ کا ایک کونہ منتخب کیا ہے

30
00:03:16,190 --> 00:03:21,663
تو یہ فتح کی نوید ہے، یہ ہمارے لیے نیک شگون ہے

31
00:03:21,713 --> 00:03:31,677
رومی فوج منظم دستوں پہ مشتمل تھی جو ان کا جنگ لڑنے کا انداز تھا

32
00:03:31,725 --> 00:03:35,269
جب کہ عرب میں جنگ کرنے کے لئے یہ طریقہ رائج  نہیں تھا

33
00:03:35,293 --> 00:03:38,487
لیکن پہلی بار اس جنگی انداز کو یرموک میں استعمال کیا گیا

34
00:03:38,502 --> 00:03:42,020
اور حضرت خالد بن ولیدؓ نے اس طرزِ جنگ کو استعمال کرنے کا مشورہ دیا

35
00:03:42,057 --> 00:03:48,823
چنانچہ آپؓ نے اسلامی فوج کو دستوں میں تقسیم کیا، ہر دستہ ایک ہزار سپاہیوں پر مشتمل تھا

36
00:03:48,848 --> 00:03:53,817
چنانچہ آپؓ کے لشکر میں چالیس سے پنتالیس دستے تھے

37
00:03:53,855 --> 00:03:59,357
اور آپؓ نے ہر دستے کا ایک سپہ سالار مقرر فرمایا

38
00:03:59,397 --> 00:04:07,017
لشکر کا وسطی یا مرکزی حصہ تقریباً اٹھارہ دستوں پہ مشتمل تھا، اس لیے ہم اٹھارہ ہزار فوجیوں کے بارے میں بات کر رہے ہیں

39
00:04:07,038 --> 00:04:10,343
اور اس کی قیادت حضرت ابوعبیدہ عمرو بن جراحؓ  کر رہے تھے

40
00:04:10,371 --> 00:04:15,330
دائیں جانب دس دستے تھے، مطلب ہم دس ہزار سپاہیوں کے بارے میں بات کر رہے ہیں

41
00:04:15,363 --> 00:04:18,843
اور اس کی قیادت حضرت عمرو بن عاصؓ کر رہے تھے

42
00:04:18,884 --> 00:04:22,117
اور شرحبیل بن حسنہؓ، حضرت عمرو بن عاصؓ کے نائب سپہ سالار تھے

43
00:04:22,148 --> 00:04:28,290
اور بائیں جانب دس دستے تھے اور اس کی قیادت حضرت یزید ابن ابی سفیانؓ کر رہے تھے

44
00:04:28,320 --> 00:04:33,217
حضرت خالد بن ولیدؓ نے لشکر کے اگلے حصے میں گھڑ سواروں کا ایک بہت چھوٹا سا دستہ متعین کیا

45
00:04:33,241 --> 00:04:40,046
جو مستعد و برق رفتار تھے اور ان کی نقل و حرکت بھی دشوار نہیں تھی

46
00:04:40,071 --> 00:04:43,463
آپؓ نے ان گھڑسواروں کو آگے، پیچھے دفاعی اور جارحانہ انداز میں متعین کیا

47
00:04:43,496 --> 00:04:48,797
آپؓ نے پانچ ہزار سپاہی حضرت سعید بن زیدؓ کی زیرِ قیادت مقرر کئے

48
00:04:48,840 --> 00:05:01,423
اور پانچ ہزار سپاہیوں پر مشتمل اس دستے کا کام دفاع کرنا تھا، اور مسلمان خاندانوں اور ان کی املاک کو دشمن سے محفوظ رکھنا تھا

49
00:05:01,480 --> 00:05:08,983
 آپ دیکھیں؛ یہ تمام مجاہدین اپنے اہل و عیال، اپنے مال و دولت، سب کچھ لیے فی سبیل اللہ حاضر ہو گئے

50
00:05:09,017 --> 00:05:12,477
اور آپ انہیں بغیر حفاظتی اقدامات کے کہیں نہیں چھوڑ سکتے

51
00:05:12,507 --> 00:05:17,830
لہٰذا انہیں تحفظ دینے کے لئے لشکر کے قریب رکھا گیا

52
00:05:17,882 --> 00:05:19,375
تو ایسے جنگ لڑنا صحابہ کے لئے جان جوکھم کا کام تھا،

53
00:05:19,395 --> 00:05:24,302
آپ یہ نہ سوچیں کہ صحابہ اور جو لوگ ان میں شامل ہوئے، ان سب کے لئے یہ ایک آسان کارِ خیر تھا

54
00:05:24,326 --> 00:05:31,637
 میرا مطلب ہے کہ ایسا نہیں تھا کہ آپ صرف فوج میں بھرتی ہو جائیں اور جا کر چھ مہینے دشمن کے خلاف لڑیں اور پھر واپسی، نہیں یہ ایک بہت بڑی قربانی بھی تھی

55
00:05:31,675 --> 00:05:34,466
اب تمام مجاہدین اپنے اہل و عیال کو ساتھ نہیں آئے تھے

56
00:05:34,491 --> 00:05:38,450
لیکن وہ مجاہدین جو بہت دور دراز علاقوں سے آئے تھے

57
00:05:38,475 --> 00:05:41,757
وہ اپنے خاندانوں کو ساتھ لے کے آئے اور وہ اس جگہ آباد ہو گئے

58
00:05:41,795 --> 00:05:49,750
اور ان میں سے بہت سے مجاہدین ، شام کی فتح کے بعد وہ اپنے وطن واپس نہیں گئے، بلکہ وہیں مستقل طور پہ آباد ہوگئے

59
00:05:49,788 --> 00:05:54,430
اور انہوں نے ان علاقوں کو آباد کیا اور دین کو پھیلایا اور انہوں نے دعوت وتبلیغ کو آگے بڑھایا

60
00:05:54,459 --> 00:05:59,280
چنانچہ انھوں نے اپنی پوری زندگی اللہ عَزَّوَجَلْ کی خوشنودی کے لئے جہاد اور دعوت و تبلیغ میں گزار دی

61
00:05:59,305 --> 00:06:02,397
الدعوۃ والجہاد، یہی ان کا مقصدِ حیات تھا

62
00:06:02,422 --> 00:06:06,083
چنانچہ یہ مسلم فوج کی ترتیب و تشکیل تھی

63
00:06:06,108 --> 00:06:12,970
اور حضرت ابو درداءؓ کو فوج کا قاضی مقرر کیا گیا

64
00:06:13,002 --> 00:06:15,150
اگر آپ تنازعات اور مسائل کا شکار ہو جائیں

65
00:06:15,175 --> 00:06:20,397
لہٰذا فوج میں ایک قاضی ہونا ضروری ہے اور یہ زمہ داری حضرت ابو درداءؓ کو سونپی گئی

66
00:06:20,421 --> 00:06:22,569
حضرت عبداللہ بن مسعودؓ،آپؓ خزانچی/قوطہ دار تھے

67
00:06:22,594 --> 00:06:24,703
 اسلامی لشکر کے مالی معاملات آپؓ کی زیرِ نگرانی تھے

68
00:06:24,726 --> 00:06:29,923
حضرت مقداد بن عمرو بن اسودؓ ، آپؓ فوج کے قاری تھے

69
00:06:29,944 --> 00:06:33,537
یہ وہ روایت تھی جس کا آغاز رسول اللہؐ نے جنگ بدر میں کیا تھا

70
00:06:33,554 --> 00:06:36,797
 رسول اللہؐ نے حضرت مقدادؓ کو یہ زمہ داری سونپی تھی

71
00:06:36,835 --> 00:06:41,567
کہ آپؓ اسلامی لشکر میں سورہ جہاد یعنی سورۃ انفال کی تلاوت کرتے ہوئے چکر لگائیں

72
00:06:41,599 --> 00:06:46,690
چنانچہ آپؓ سورۃ الانفال کی آیات پڑھتے ہوئے میدان جنگ میں مسلم لشکر میں گھومتے تھے

73
00:06:46,718 --> 00:06:51,360
اور یہ روایت بعد میں بھی جاری رہی اور جنگِ یرموک میں بھی اس روایت کو برقرار رکھا گیا

74
00:06:51,386 --> 00:06:53,930
اور حضرت خالدؓ نے بھی اسی شخصیت(حضرت مقدادؓ) کو یہ(قاری کی) زمہ داری سونپی

75
00:06:53,972 --> 00:06:57,310
حضرت مقداد بن اسودؓ جنہوں نے جنگ بدر میں رسول اللہؐ کی زیرِ قیادت یہ فریضہ سرانجام دیا تھا

76
00:06:57,347 --> 00:07:03,223
اور پھر فوج کا جوش و ولولہ بڑھانے کے لیے ایک محرک تھا؛الواعظ

77
00:07:03,271 --> 00:07:06,817
الواعظ وہ جو میدان میں مسلم سپاہیوں کی حوصلہ افزائی کرتا ہوا گھومتا تھا کیونکہ

78
00:07:06,837 --> 00:07:08,895
 شیطان آپ کے ایمان کو کمزور کرنے لازمی آئے گا

79
00:07:08,919 --> 00:07:11,375
 اور وہ(شیطان) آپ کو آپ کے خاندان کے بارے میں یاد دلائے گا

80
00:07:11,400 --> 00:07:12,812
اور وہ آپ کو آپ کے مال و دولت کے بارے میں یاد دلائے گا

81
00:07:12,837 --> 00:07:15,902
اور وہ یہ مختلف وسوسے آپ کے دل میں ڈال دے گا

82
00:07:15,927 --> 00:07:19,077
تو کوئی ایسا ہونا چاہیے جو آپ کو نصیحت کرے

83
00:07:19,110 --> 00:07:23,087
سورۃ العصر میں دیکھیں اللہ عَزَّوَجَلْ اس کا حل بتاتا ہے

84
00:07:23,128 --> 00:07:25,660
ایک خسارے کی کیفیت جس سے ہر انسان گزرتا ہے

85
00:07:25,698 --> 00:07:28,917
وَالْعَصْرِ ۝ إِنَّ الْإِنْسَانَ لَفِي خُسْرٍ۝

86
00:07:28,948 --> 00:07:32,720
ترجمہ؛ قسم ہے زمانے کی، انسان سخت خسارے میں ہے

87
00:07:32,763 --> 00:07:36,343
إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ ۝

88
00:07:36,363 --> 00:07:39,020
وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ۝

89
00:07:39,044 --> 00:07:41,582
سوائے ان لوگوں کے جو ایمان لائے

90
00:07:41,645 --> 00:07:43,441
آمَنُوا وَعَمِلُوا الصَّالِحَاتِ۝

91
00:07:43,465 --> 00:07:44,330
جنہوں نے نیک عمل کئے

92
00:07:44,367 --> 00:07:46,843
وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ۝

93
00:07:46,868 --> 00:07:54,490
اور جو ایک دوسرے کو حق اور صبر کی تلقین کرتے رہے

94
00:07:54,538 --> 00:07:58,403
وہ ایک دوسرے کو حق یعنی اسلام کی پیروی کرنے کی نصیحت کرتے ہیں، جو راہِ حق ہے

95
00:07:58,428 --> 00:08:01,557
 اور صبر، وہ ایک دوسرے کو صبر کرنے کی تلقین کرتے ہیں

96
00:08:01,586 --> 00:08:05,043
پس جب آپ مجھے دلگرفتہ و مایوس دیکھتے ہیں تو میرا حوصلہ بڑھاتے ہیں

97
00:08:05,075 --> 00:08:08,250
اور جب میں آپ کو ہمت ہارتے دیکھوں گا تو میں بھی یہی طرزِ عمل اختیار کروں گا، وہ یہ ہے

98
00:08:08,286 --> 00:08:09,380
وَتَوَاصَوْا بِالصَّبْرِ۝

99
00:08:09,403 --> 00:08:11,897
وہ ایک دوسرے کو صبر کرنے کی تلقین کریں گے

100
00:08:11,922 --> 00:08:18,203
مسلم فوج میں یہ فریضہ حضرت ابو سفیان ابن حربؓ نے ادا کیا تھا

101
00:08:18,233 --> 00:08:20,510
اور یہ اسلام کا کرشمہ ہے

102
00:08:20,535 --> 00:08:28,123
 ابوسفیانؓ جو حضرت محمدﷺ کے خلاف کی جانے والی تمام سازشوں کا سرغنہ تھے

103
00:08:28,148 --> 00:08:32,010
دعوت و تبلیغ کے ابتدائی ایام سے لے کر حضرت محمدﷺ کے وصال سے کچھ وقت پہلے تک

104
00:08:32,038 --> 00:08:35,723
آپؓ کی شخصیت یکسر بدل گئی اور آپؓ مسلمان ہو گئے

105
00:08:35,758 --> 00:08:40,143
آپؓ نہ صرف مسلمان ہوگئے بلکہ بہت پرجوش مردِ مجاہد تھے

106
00:08:40,165 --> 00:08:41,798
بالکل بدل گئے

107
00:08:41,838 --> 00:08:50,650
اب سے کچھ وقت قبل، جو اسلام دشمن عناصر اور تمام قبائل کو حضرت محمدﷺ کے خلاف محاذ آرائی پہ متحرک کرتا تھا

108
00:08:50,675 --> 00:08:56,677
اب وہی شخص انہیں(مجاہدین کو) حضرت محمد ﷺ کے دشمنوں سے لڑنے کی ترغیب دے رہا ہے

109
00:08:56,706 --> 00:09:02,683
چنانچہ حضرت ابوسفیانؓ ہر دستے کی طرف جاتے اور ان کا جزبہ بڑھانے کے لئے پر جوش خطاب کرتے

110
00:09:02,713 --> 00:09:06,497
اور پھر آپؓ عورتوں کے پاس جاتے اور انہیں بھی "موعظہ" یعنی حوصلہ بلند رکھنے کی نصیحت کرتے

111
00:09:06,526 --> 00:09:09,303
کیونکہ خواتین کا کردار بھی بہت اہم تھا

112
00:09:09,338 --> 00:09:13,377
وہ اپنے مردوں کے حفاظتی حصار والے خیموں میں صرف بیٹھی ہوئیں نہیں تھی

113
00:09:13,408 --> 00:09:16,883
خواتین کے ذمے بھی مسلم لشکر کی کچھ خدمات تھیں

114
00:09:16,916 --> 00:09:19,230
جنگ میں شرکت کے علاوہ بھی ان کی زمہ داریاں تھی

115
00:09:19,251 --> 00:09:27,346
اور جنگ یرموک میں بھی خواتین نے جنگ میں حصہ لیا اور ہم اس پہ بات کریں گے اور جنگ میں خواتین کی شرکت کے محرکات کیا تھے

116
00:09:27,382 --> 00:09:31,210
اور سپہ سالارِ اعلیٰ حضرت خالد بن ولیدؓ تھے

117
00:09:31,243 --> 00:09:38,357
حضرت خالد بن ولیدؓ نے فوج کو دستوں میں تقسیم کرنے کا یہ طریقہ رائج کیا، کیونکہ یہ ایک بڑا لشکر تھا

118
00:09:38,384 --> 00:09:43,337
اس سے پہلے کبھی مسلمانوں کے پاس چالیس ہزار(40,000) کی منظم فوج نہیں تھی

119
00:09:43,386 --> 00:09:48,208
مسلم فوج کی تعداد کم ہوتی تھی، اس لیے آپ کو فوج کو اس طرح تقسیم کرنے کی ضرورت نہیں تھی

120
00:09:48,232 --> 00:09:51,739
بدر کی جنگ میں ان کی تعداد تین سو سے کچھ اوپر تھی

121
00:09:51,777 --> 00:09:52,824
انہیں تقسیم کرنے کی نوبت نہیں آئی

122
00:09:52,849 --> 00:09:58,617
رسول اللہؐ جس انداز میں لشکر کی تشکیل فرماتے، اس میں دستے، لشکر کے مرکز، دائیں اور بائیں جانب متعین ہوتے

123
00:09:58,651 --> 00:10:00,503
اور یہ جنگی حکمتِ عملی بعد ازاں جاری رہی

124
00:10:00,523 --> 00:10:08,657
اور بہت سے دیگر محاذوں میں، مخصوص جنگی انداز اپنایا گیا، جو یک مشت حملہ اور پھر پسپائی اختیار کرتے ہوئے دوبارہ پلٹ کر وار کرنے کا طریقہ تھا

125
00:10:08,703 --> 00:10:11,990
آپ فوج کو اتنے منظم انداز میں ترتیب و تشکیل نہیں دے سکتے

126
00:10:12,026 --> 00:10:17,350
لیکن اب چونکہ یہ ایک بڑی فوج تھی اس لیے اسے مزید منظم کرنے کی ضرورت تھی

127
00:10:17,375 --> 00:10:21,227
چنانچہ آپؓ(حضرت خالدؓ) نے لشکر کو دستوں میں تقسیم کردیا

128
00:10:21,252 --> 00:10:25,743
حضرت خالد بن ولیدؓ نے فوج سے گفتگو کی، آپؓ نے اپنے لشکر کو خطبہ دیا اور فرمایا؛

129
00:10:25,768 --> 00:10:27,810
هذا يومٌ من أيَّام الله

130
00:10:27,835 --> 00:10:32,483
یہ اللہ کے عطاء کردہ دنوں میں سے ایک دن ہے

131
00:10:32,508 --> 00:10:36,920
دیکھیں، ہر دن اللہ کا ہے لیکن جب وہ کہتا ہے کہ یہ اللہ کے دنوں میں سے ایک دن ہے

132
00:10:36,945 --> 00:10:40,210
اس کا مطلب ہے کہ یہ ایک خاص دن ہے

133
00:10:40,235 --> 00:10:44,397
یہ جنگیں تاریخ کے فیصلہ کن معرکے تھے

134
00:10:44,422 --> 00:10:46,290
ان میں سے بہت سی جنگوں کا فیصلہ ایک دن میں ہوا

135
00:10:46,315 --> 00:10:50,963
بدر کی جنگ ایک دن کی تھی، احد کا معرکہ ایک دن پرمبنی تھا

136
00:10:50,988 --> 00:10:53,070
فتح مکہ کا معرکہ ایک دن تھا

137
00:10:53,095 --> 00:10:59,903
 لیکن یہ واقعات مسلم معاشرے کے لئے انقلابی ثابت ہوئے اور انھوں نے تاریخ کا دھارا بدل دیا

138
00:10:59,928 --> 00:11:05,590
چنانچہ جنگ سے پہلے حضرت خالد بن ولیدؓ، اپنے مجاہدین سے فرمارہے تھے کہ یہ اللہ کے دنوں میں سے ایک دن ہے،

139
00:11:05,615 --> 00:11:10,870
اس میں نہ غرور ہونا چاہیے اور نہ ظلم، سارا تکبر اُتار پھینکو

140
00:11:10,895 --> 00:11:15,897
کیونکہ اب حضرت خالدؓ مختلف پسِ منظر، مختلف قبائل کے مختلف لوگوں سے نمٹ رہے تھے

141
00:11:15,922 --> 00:11:23,817
لہذا مقابلہ کرنے، فخر کرنے اور برتر ثابت کرنے کے بہت سے مواقع تھے

142
00:11:23,842 --> 00:11:28,037
تو حضرت خالد بن ولیدؓ فرمارہے ہیں؛ ان تمام آلائشوں سے چھٹکارہ پاؤ، ان سب سے کنارہ کش ہو جاؤ

143
00:11:28,062 --> 00:11:30,570
اور یہ گناہ کرنے کا دن نہیں ہے

144
00:11:30,595 --> 00:11:35,143
ہر روز ہمیں گناہوں سے دور رہنا چاہیے، لیکن یہ ایک خاص دن ہے

145
00:11:35,168 --> 00:11:42,837
لہٰذا اس دن گناہوں سے محتاط رہنے پہ زیادہ زور دیا گیا، معمول سے بڑھ کر اللہ تبارک وتعالٰی کے قریب ہوجائیں

146
00:11:42,862 --> 00:11:45,275
اپنی نیک عمل کی کاوش اخلاص سے سرانجام دیں

147
00:11:45,300 --> 00:11:47,490
آپؓ انہیں(مجاہدین کو) اخلاص کی نصیحت فرما رہے تھے

148
00:11:47,515 --> 00:11:51,903
اِخلاص ہر عبادت سے زیادہ اہم ہے، خاص کر جہاد سے

149
00:11:51,924 --> 00:11:55,150
 کیونکہ آپ اگلے ہی لمحے مر سکتے ہیں

150
00:11:55,170 --> 00:11:57,339
تو آپ کو اپنا ہر صالح عمل اخلاص سے کرنا ہوگا

151
00:11:57,364 --> 00:12:03,259
اس دن آپ اپنے عمل سے اللہ کی خوشنودی اور اس کی رضا میں پنہاں حکمت تلاش کریں

152
00:12:03,284 --> 00:12:09,345
اور پھر حضرت ابوسفیانؓ لشکر کا حوصلہ بڑھاتے

153
00:12:09,370 --> 00:12:14,702
بحان، رومیوں کے سرداروں میں سے ایک سردار تھا

154
00:12:14,727 --> 00:12:19,912
وہ حضرت خالد بن ولیدؓ سے ملنا چاہتا تھا، اس لیے وہ آگے آیا

155
00:12:19,937 --> 00:12:23,432
اور اس نے حضرت خالد بن ولیدؓ کو پکارا اور آپؓ کو سامنے آنے کے لئے کہا

156
00:12:23,457 --> 00:12:24,445
چنانچہ وہ ایک دوسرے کے روبرو آئے

157
00:12:24,470 --> 00:12:33,365
بحان کہنے لگا؛ ہم نے سنا ہے کہ آپ(حضرت خالدؓ) مالِ غنیمت کی تلاش میں نکلے ہیں

158
00:12:33,390 --> 00:12:38,359
کیونکہ آپ لوگ فاقہ زدہ غریب اور مفلس ہیں

159
00:12:38,384 --> 00:12:49,659
اس لیے میں آپؓ کو فی سپاہی دس دینار، ایک جوڑا کپڑوں کا اور اشیائے خوردنی کی پیشکش کرتا ہوں

160
00:12:49,679 --> 00:12:52,949
اور اگلے سال بھی ہم آپ کو یہی ادائیگی کریں گے

161
00:12:52,977 --> 00:12:59,632
اب سب سے پہلے تو یہ عرب کے قبائل کی شہرت تھی

162
00:12:59,665 --> 00:13:02,555
کہ ان کی زندگی کی گزر اوقات دوسروں پر چھاپے مارنے پر مبنی تھی

163
00:13:02,580 --> 00:13:11,922
نمبر دو، بہت سے لوگ جہاد فی سبیل اللہ کے اصل محرکات کو نہیں سمجھ پاتے

164
00:13:11,958 --> 00:13:16,852
وہ جہاد کی اصل روح سے نآشنا ہیں اور آج تک وہ اس کے مقاصد سمجھ نہیں پائے

165
00:13:16,901 --> 00:13:21,199
وہ یہ سمجھنے میں ناکام ہیں کہ یہ عمل خالصتاً اللہ عَزَّوَجَلْ کی رضا کے لیے ہے

166
00:13:21,224 --> 00:13:28,699
جو شخص جان کی بازی لگا رہا ہے وہ اللہ کی رضا کے لیے، جنت کے حصول کے لیے، اللہ رب العزت کی خوشنودی کے لیے

167
00:13:28,738 --> 00:13:32,592
جس شخص کی سوچ اس دنیا تک محدود ہو

168
00:13:32,613 --> 00:13:38,395
اور اس(دنیا) سے بڑھ کر وہ سوچ نہیں سکتا، وہ جہاد کے تصور کو نہیں سمجھ سکتا

169
00:13:38,433 --> 00:13:41,754
کیوں اپنے آپ کو اس خطرے میں ڈال رہے ہو، کیوں اپنی زندگی داؤ پہ لگا رہے ہو؟

170
00:13:41,779 --> 00:13:44,905
تم ایسا کیسے کر رہے ہو؟

171
00:13:44,934 --> 00:13:48,325
تو وہ(بحان) کہہ رہا تھا کہ اگر تم(حضرت خالدؓ) یہاں دولت کے لیے آئے ہو تو میں تمہیں دولت دوں گا

172
00:13:48,364 --> 00:13:51,492
اپنی سرزمین پر واپس لوٹ جاؤ

173
00:13:51,520 --> 00:13:56,182
 اور الله أعلم، حضرت خالد بن ولیدؓ نے بحان کو کیسے یہ جواب دیا؟

174
00:13:56,204 --> 00:13:59,105
شاید آپؓ نے اس شخص کا طنزیہ انداز محسوس کرلیا

175
00:13:59,140 --> 00:14:05,513
میں طنزیہ نہیں کہنا چاہتا لیکن شاید بحان اس طرح کے بیان سے مسلمانوں کی تذلیل کر رہا تھا

176
00:14:05,538 --> 00:14:10,452
لیکن حضرت خالد بن ولیدؓ نے فرمایا؛ نہیں، ہم اس(مالِ غنیمت) لیے نہیں آئے

177
00:14:10,478 --> 00:14:13,479
ہم اس لئے آئے ہیں کیوں کہ ہم خون پیتے ہیں

178
00:14:13,517 --> 00:14:17,292
اور ہم نے سنا ہے کہ بہترین خون رومیوں کا خون ہے

179
00:14:17,328 --> 00:14:22,099
تو ظاہر ہے، یہ جواب بحان کے لئے ناگوار تھا

180
00:14:22,135 --> 00:14:25,695
بحان کہنے لگا؛ اچھا، ہم نے آپ کے بارے میں یہ سنا ہے

181
00:14:25,737 --> 00:14:31,579
اس لحاظ سے نہیں بلکہ اس لحاظ سے کہ تم لوگ بہت بے رحم ہو

182
00:14:31,613 --> 00:14:34,559
اور یہ حضرت خالد بن ولیدؓ کی وجہ شہرت تھی

183
00:14:34,598 --> 00:14:37,202
حضرت خالد بن ولیدؓ کو دیکھیں، آپؓ سے متعلق گردوپیش میں قصے کہانیاں پھیل رہے تھے

184
00:14:37,227 --> 00:14:41,112
ان میں کچھ صداقت پر مبنی تھیں اور کہیں کہیں مبالغہ آرائی بھی تھی

185
00:14:41,148 --> 00:14:43,745
کیونکہ بعد میں جب جنگ شروع ہوئی

186
00:14:43,788 --> 00:14:49,875
ایک شخص جس کا تذکرہ طبری میں جرجا کے نام سے کیا گیا ہے، جو غالباً جارج ہے

187
00:14:49,912 --> 00:14:53,645
آپ جانتے ہیں، عربی کبھی کبھی غیر عربی نام کو

188
00:14:53,695 --> 00:14:56,892
جب عربی لہجے میں تبدیل کرتے ہیں تو اس نام کی تلفظ بدل جاتا ہے

189
00:14:56,932 --> 00:15:01,599
اس لیے اس نے تلاش کرنے کی کوشش کی کہ اس تلفظ سے مشابہہ لاطینی نام کون سا ہے، کیونکہ یہ لاطینی نام تھے

190
00:15:01,633 --> 00:15:05,132
تو غالب امکان یہی ہے کہ جرجہ سے مراد جارج ہوگا

191
00:15:05,173 --> 00:15:07,162
وہ رومی جرنیلوں میں سے تھا

192
00:15:07,206 --> 00:15:09,459
 جنگ کے دوران وہ حضرت خالد بن ولیدؓ کے پاس آیا

193
00:15:09,485 --> 00:15:12,922
اور کہنے لگا؛ میں آپؓ سے ملاقات کرنا چاہتا ہوں، چنانچہ ان کی ملاقات ہوئی، جارج کہنے لگا؛

194
00:15:12,964 --> 00:15:18,232
میں آپؓ کو خدا کی قسم دے کر پوچھوں گا اور میں چاہتا ہوں کہ آپ مجھے سچ بتائیں اور مجھ سے جھوٹ نہ بولیں

195
00:15:18,260 --> 00:15:20,472
کیونکہ آزاد آدمی جھوٹ نہیں بولتا

196
00:15:20,506 --> 00:15:27,039
کیونکہ وہ ہتھیاروں سے لیس تھے اور وہ حضرت خالد بن ولیدؓ سے کہہ رہے ہیں؛ آپؓ آزاد شخص ہیں، میں ایک آزاد آدمی ہوں

197
00:15:27,076 --> 00:15:29,372
آپ کو میرے ساتھ راست باز ہونا پڑے گا، میں آپ کے ساتھ راست باز رہوں گا

198
00:15:29,397 --> 00:15:32,399
تو اس(جارج) نے کہا؛ میں چاہتا ہوں کہ آپؓ مجھے درست حقائق بتائیں

199
00:15:32,435 --> 00:15:35,515
حضرت خالد بن ولیدؓ نے فرمایا؛ میں تم سے سچ بولوں گا

200
00:15:35,545 --> 00:15:45,225
اس(جارج) نے کہا؛ کیا یہ سچ ہے کہ تمہارے نبیؐ کو خدا کی طرف سے تلوار ملی اور پھر انھوں نے وہ تلوار آپؓ کو دے دی؟

201
00:15:45,250 --> 00:15:49,205
 تو اسی وجہ سے آپؓ کبھی کسی جنگ میں نہیں ہارتے؟

202
00:15:49,237 --> 00:15:51,909
حضرت خالد بن ولیدؓ یہ کہہ سکتے تھے؛ ہاں یہ درست ہے

203
00:15:51,947 --> 00:15:56,019
اور اپنی اس شہرت کو برقرار رکھ سکتے تھے جو پہلے سے قائم تھی

204
00:15:56,068 --> 00:15:58,672
اور اپنی ذات سے منصوب قصوں پہ صداقت کی مہر لگا دیتے اور انھیں بڑھاوا دیتے

205
00:15:58,706 --> 00:16:01,455
لیکن آپؓ نے ایسا نہیں کیا، آپؓ نے فرمایا؛ نہیں، یہ حقیقت نہیں ہے

206
00:16:01,503 --> 00:16:09,412
ہوا یہ کہ اللہ عَزَّوَجَلْ نے ہمارے لیے ایک نبیؐ بھیجا، جنہوں نے ہمیں حق کی دعوت دی

207
00:16:09,456 --> 00:16:14,319
ہم میں سے کچھ آپؐ پر ایمان لائے اور کچھ آپؐ کے خلاف محاذ آراء ہوگئے

208
00:16:14,356 --> 00:16:18,809
میں آپؐ کے خلاف محاذ آرائی کرنے والوں میں شامل تھا

209
00:16:18,833 --> 00:16:31,155
یہاں تک کہ اللہ سبحانہ وتعالی نے ہمارے دلوں کو پھیر دیا، ہمارے دلوں کو اپنی طرف مائل کردیا، اور ہمیں اسلام سے بہرہ مند فرمایا،

210
00:16:31,175 --> 00:16:32,315
 چنانچہ میں مسلمان ہو گیا

211
00:16:32,340 --> 00:16:36,359
چنانچہ حضرت خالد بن ولیدؓ دوسرے لفظوں میں یہ فرما رہے ہیں کہ ہم آپؐ کے مخالف تھے

212
00:16:36,397 --> 00:16:40,762
لیکن پھر اللہ عَزَّوَجَلْ نے ہمارے دلوں کو اپنی رحمت سے ڈھانپ لیا اور ہمیں اسلام سے سرفراز فرمایا

213
00:16:40,861 --> 00:16:44,279
یہ عمل اخلاصِ نیت سے بغیر کسی جبر کے کیا گیا تھا

214
00:16:44,304 --> 00:16:47,399
حضرت محمدﷺ نے اسلام کو زبردستی ہم پر مسلط نہیں کیا

215
00:16:47,424 --> 00:16:50,819
 اللہ تبارک وتعالٰی نے ہمارے دلوں کو آپؐ کے قریب کر لیا

216
00:16:50,855 --> 00:16:53,872
حضرت عمرو بن عاصؓ نے انتقال سے پہلے فرمایا؛

217
00:16:53,897 --> 00:17:01,292
 ایک وقت تھا جب میرے نزدیک حضرت محمدﷺ سب سے زیادہ قابلِ اعتراض شخصیت تھے

218
00:17:01,317 --> 00:17:10,872
اور اس وقت میری سب سے بڑی خواہش یہ تھی کہ میں آپؐ پہ ہاتھ اُٹھاؤں اور اگر ممکن ہو تو آپؐ کو جان سے مار ڈالوں

219
00:17:10,922 --> 00:17:14,539
لیکن پھر اللہ عَزَّوَجَلْ نے میرے دل میں اسلام کی محبت ڈال دی

220
00:17:14,584 --> 00:17:19,785
تو حضرت محمدﷺ مجھے سب سے زیادہ محبوب ہو گئے

221
00:17:19,820 --> 00:17:23,339
اور آپؓ نے فرمایا؛ میں آپؐ سے بہت محبت کرتا تھا اور آپؐ کی بہت عزت کرتا تھا

222
00:17:23,364 --> 00:17:28,679
میں کبھی بھی آپؐ کو آنکھ اُٹھا کہ نہیں دیکھتا تھا، جب بھی آپؐ کو دیکھتا تو نظریں جُھکا لیتا

223
00:17:28,720 --> 00:17:33,645
تو حضرت خالد بن ولیدؓ نے فرمایا؛ اللہ نے ہمارے دلوں کو پھیر دیا اور ہم مسلمان ہو گئے

224
00:17:33,670 --> 00:17:35,666
پھرحضرت محمدﷺ نے مجھ سے فرمایا؛

225
00:17:35,691 --> 00:17:39,319
أنت سيفٌ مِنْ سُيوفِ اللهِ، سَلَّهُ اللهُ على المشركين

226
00:17:40,065 --> 00:17:45,079
آپؐ نے مجھ سے فرمایا کہ" تم(حضرت خالدؓ) اللہ کی تلواروں میں سے ایک تلوار ہو"

227
00:17:45,111 --> 00:17:53,252
اور اللہ عَزَّوَجَلْ نے آپؓ کو کفار کے خلاف سینہ سپر ہونے کے لئے منتخب کیا ہے

228
00:17:53,295 --> 00:18:01,099
اس لیے مجھے اللہ کی تلوار(سیف اللہ) کا لقب ملا کیوں کہ مسلمانوں میں سے مَیں مشرکین کے معاملے میں سب سے زیادہ غیرلچکدار کرخت رویہ رکھتا ہوں

229
00:18:01,124 --> 00:18:06,112
مسلمانوں میں سے سب سے زیادہ میرا رویہ مشرکین کے خلاف سخت ہے

230
00:18:06,142 --> 00:18:09,368
تو حضرت خالد بن ولیدؓ کی سختی اور آپؓ کی جنگی مہارت اور آپؓ کی فہم و فراست

231
00:18:09,393 --> 00:18:15,045
اور آپؓ کی ذہانت، آپؓ کی رفتار، آپؓ کی خطرہ مول لینے کی خواہش

232
00:18:15,090 --> 00:18:19,402
ان تمام اوصاف نے حضرت خالد بن ولیدؓ کو ایک ناقابلِ تسخیر شخصیت بنایا

233
00:18:19,437 --> 00:18:23,925
جب میں نے حضرت خالد بن ولیدؓ کے(میدانِ جنگ سے) حج کرنے کی مہم جوئی کی بات کی

234
00:18:23,971 --> 00:18:28,712
اور پھر آپؓ کا صحرا کو عبور کرنے کا فیصلہ

235
00:18:28,751 --> 00:18:33,525
کہ آپؓ سے پہلے کسی اور نے وہ صحرا عبور نہیں کیا، جو کہ ایک نامعلوم علاقہ تھا

236
00:18:33,556 --> 00:18:39,229
یہ آپ کے سامنے ایک مہم جُو فطرت کی عکاسی ہے جسے آج مسلمانوں کی اکثریت کھو چکی ہے

237
00:18:39,260 --> 00:18:47,159
مسلمان بزدل ہو چکے ہیں، وہ اپنے طور طریقے، غلط رسم و رواج بدلنے پر آمادہ نہیں ہیں

238
00:18:47,196 --> 00:18:51,059
اور وہ ایک خاص طرزِ حیات اور مخصوص اندازِزندگی کے عادی ہو چکے ہیں

239
00:18:51,101 --> 00:18:54,472
اور وہ بہتری و بھلائی کے خواہاں نہیں ہیں

240
00:18:54,500 --> 00:19:01,085
اور ایسا لگتا ہے کہ جس قسم کا پیشہ ہم اپناتے ہیں ان کا اثر ہماری شخصیت پر پڑتا ہے

241
00:19:01,133 --> 00:19:04,472
 پیشہ یا معاش کا اثر شخصیت پر ضرور ہوتا ہے

242
00:19:04,511 --> 00:19:07,792
لیکن ایک مخصوص شعبے میں ملازمت کرنا

243
00:19:07,817 --> 00:19:12,339
جہاں آپ صرف کام کرتے ہوں اور پھر مہینے کے آخر میں آپ کو مقررہ تنخواہ ملتی ہو

244
00:19:12,364 --> 00:19:17,045
اور اس کام میں کوئی بھی پُرخطر ہدف شامل نہیں ہوتا، جو ایک شخص کو خوفزدہ کرے

245
00:19:17,078 --> 00:19:28,472
لہذا، مَیں صحابہ کرام کی اس مہم جُو فطرت کو انٹرپرائزنگ یا کاروباری صلاحیت کہوں گا

246
00:19:28,497 --> 00:19:32,900
صحابہ کی اس صلاحیت نے انہیں ناقابلِ تسخیر بننے کا موقع دیا جو کہ اللہ عَزَّوَجَلْ کی توفیق سے ممکن ہوا

247
00:19:32,925 --> 00:19:39,079
دیکھیں، میں اس بات کو یقینی بنانا چاہتا ہوں کہ جب بھی مَیں صحابہ کرامؓ میں سے کسی صحابی کی مہارت کا زکر کروں

248
00:19:39,104 --> 00:19:44,419
ہم ان کی کامیابی کو اس ذاتی قابلیت سے منسوب نہیں کرتے کیونکہ آخر میں یہ اللہ تعالی کی توفیق ہے

249
00:19:44,444 --> 00:19:49,652
دیکھیں، بحیثیت مسلمان آپ اللہ کی توفیق کے بغیر کسی چیز میں کامیاب نہیں ہو سکتے

250
00:19:49,715 --> 00:19:54,205
اللہ کی توفیق، اللہ عَزَّوَجَلْ کی رضا اور اس کی طرف سے عطا کردہ ہدایت ہے

251
00:19:54,230 --> 00:19:59,379
لہذٰا اس لیے ہم صحابہ کی صلاحیتوں سے کسی بھی کامیابی کو منسوب نہیں کر رہے ہیں

252
00:19:59,401 --> 00:20:03,052
اور یہ چیز ہمیں زیب نہیں دیتی، جیسا کہ قارون کی مثال میں ہے

253
00:20:03,077 --> 00:20:09,192
قارون، اور اس نے اللہ رب العزت کے عطا کردہ مال و دولت کے لئے اللہ کا شکر ادا نہیں کیا

254
00:20:09,223 --> 00:20:11,365
جب اس(قارون) سے پوچھا گیا کہ وہ اتنا دولت مند کیسے بنا؟ تو وہ کہنے لگا؛

255
00:20:11,390 --> 00:20:13,545
إِنَّمَا أُوتِيتُهُۥ عَلَىٰ عِلْمٍ عِندِى ۚ

256
00:20:13,570 --> 00:20:17,732
میں نے اپنی صلاحیتوں کی وجہ سے اپنی قسمت بنائی

257
00:20:17,757 --> 00:20:20,819
اس نے یہ نہیں کہا کیونکہ اللہ عَزَّوَجَلْ نے مجھے یہ سب عطا کیا ہے

258
00:20:20,844 --> 00:20:24,572
تو یہ ناشکری ہے؛ یہ "جهت انعمة"(کفرانِ نعمت) ہے

259
00:20:24,597 --> 00:20:28,345
یہ اللہ عَزَّوَجَلْ کی نعمت کو جھٹلانا ہے

260
00:20:28,370 --> 00:20:31,550
تو ہم ہر چیز کو اللہ عَزَّوَجَلْ کی عطا کردہ نعمت سمجھتے ہیں،

261
00:20:31,570 --> 00:20:38,299
 جب ہم کہتے ہیں؛ الحمدللہ؛ اللہ کا شکر ہے کہ اس نے ہمیں اس کی توفیق بخشی

262
00:20:38,324 --> 00:20:43,582
لیکن ہمیں اپنے آپ کو بہتر بنانا ہے اور ہمیں اس کے لئے کوشش کرنی ہوگی

263
00:20:43,596 --> 00:20:45,782
اور اللہ عَزَّوَجَلْ سے دعا کریں کہ وہ ہماری مدد کرے

264
00:20:45,802 --> 00:20:51,199
 اور جب ہم اپنی اصلاح کر لیں تو ہمیں کہنا چاہیے الحمدللہ ، کہ ہمیں اللہ نے اچھا انسان بننے کی توفیق دی

265
00:20:51,244 --> 00:20:53,845
اس لیے مسلمانوں کو اپنا طرز زندگی بدلنے کی ضرورت ہے

266
00:20:53,870 --> 00:20:57,085
اور جس طرح سے وہ مستقبل کو دیکھتے ہیں کہ اللہ عَزَّوَجَلْ آپ کو رزق عطا کرے گا

267
00:20:57,110 --> 00:21:00,642
رزق اللہ عَزَّوَجَلْ کے ہاتھ میں ہے

268
00:21:00,667 --> 00:21:04,299
بہت سے لوگ کسی دوسرے کے زیرِ تسلط جبری زندگی گزار رہے ہیں

269
00:21:04,324 --> 00:21:07,419
آپ اپنی تنخواہ کے لئے پورا مہینہ کام کرتے ہیں ، اگلے مہینے پھر اسی معمول کے مطابق کام کرتے ہیں

270
00:21:07,444 --> 00:21:10,725
کوئی دعوت و تبلیغ، کوئی اسلامی کام، کچھ نہیں

271
00:21:10,750 --> 00:21:11,392
کیوں؟

272
00:21:11,417 --> 00:21:15,085
کیونکہ مجھے اپنی گزراوقات کے لئے روزی کمانی ہے، مجھے تنخواہ کمانی ہے، یہ غلامی ہے

273
00:21:15,105 --> 00:21:19,299
بالکل ایک غلام کی طرح، جو روزی کمانے کے لیے دن رات محنت کر رہا ہے

274
00:21:19,333 --> 00:21:26,292
اور مستقبل کے لیے کوئی منصوبہ نہیں ہے، آنے والی زندگی میں کیا رونما ہونے والا ہے، اس سے متعلق کوئی واضح تصور نہیں؟

275
00:21:26,322 --> 00:21:32,742
اور یہی وجہ ہے کہ جب اسلام نے غلاموں کو آزاد کیا

276
00:21:32,762 --> 00:21:40,739
تو اس انداز سے انسانی غلامی سے نجات دلائی گئی کہ جسمانی آزادی سے پہلے وہ نفسیاتی قید سے رہائی پائیں

277
00:21:40,759 --> 00:21:47,812
کیونکہ اگر آپ غلامی میں طویل زندگی گزارنے کے بعد ایک غلام کو فوراً آزادی دے دیتے ہیں

278
00:21:47,859 --> 00:21:52,425
ایسا شخص شدید نفسیاتی دھچکے سے گزرتا ہے

279
00:21:52,456 --> 00:21:59,245
تو بعض اوقات وہ آزادی کی زندگی بھرپور طریقے سے جینے میں بھی ناکام ہوجاتے ہیں

280
00:21:59,265 --> 00:22:04,739
چنانچہ اسلام نے سب سے پہلے غلامی کے امتناہی اصولوں کو توڑا

281
00:22:04,764 --> 00:22:10,369
مثلََا عطاءؒ جیسے علماء، جو آزاد کردہ غلام تھے

282
00:22:10,389 --> 00:22:13,662
حضرت بلال بن رباحؓ ایک آزاد کردہ غلام تھے

283
00:22:13,717 --> 00:22:16,352
حضرت سلمان فارسیؓ آزاد کردہ غلام تھے

284
00:22:16,386 --> 00:22:21,305
اسلام نے پہلے ان کی نفسیات بدلی پھر اس کے بعد انھوں نے آزادی حاصل کی

285
00:22:21,330 --> 00:22:26,192
چنانچہ جب وہ آزاد ہوئے، تو وہ آزاد زندگی بہترین انداز میں گزارنے کے قابل تھے

286
00:22:26,224 --> 00:22:30,885
تو مذکورہ شخص جارج، اس نے حضرت خالد بن ولیدؓ سے پوچھا؛

287
00:22:30,910 --> 00:22:35,399
جارج نے آپؓ سے پوچھا؛ آپ کا مذہب آپ کو کیا سکھاتا ہے؟

288
00:22:35,424 --> 00:22:41,932
حضرت خالد بن ولیدؓ نے فرمایا؛ کہ ہم آپ کو اسلام کی دعوت دیتے ہیں

289
00:22:41,957 --> 00:22:44,965
جارج کہنے لگا؛ اور اگر ہم یہ دعوت قبول نہ کریں تو کیا ہوگا؟

290
00:22:44,990 --> 00:22:47,459
آپؓ نے فرمایا؛ پھر آپ کو جزیہ دینا ہوگا

291
00:22:47,484 --> 00:22:51,819
وہ کہنے لگا؛ اگر ہم یہ بھی ادا نہ کریں تو کیا ہوگا؟ آپؓ نے فرمایا؛ پھر ہم آپ سے لڑیں گے

292
00:22:51,844 --> 00:22:54,382
تو حضرت خالد بن ولیدؓ نے اسے تین درجے انتخاب کے لئے دیئے

293
00:22:54,407 --> 00:23:00,072
نمبر ایک، اسلام کی دعوت؛ اگر آپ اسے قبول کر لیں تو آپ ہماری جماعت میں شامل ہو جائیں گے

294
00:23:00,097 --> 00:23:03,805
اگر نہیں، تو اگلا مرحلہ جزیہ کی ادائیگی ہے

295
00:23:03,830 --> 00:23:08,025
اگر تم اس سے انکار کرتے ہو تو پھر قتال یعنی جنگ ہے

296
00:23:08,050 --> 00:23:10,022
تو جارج نے حضرت خالد بن ولیدؓ سے پھر سوال کیا،وہ کہنے لگا؛

297
00:23:10,047 --> 00:23:13,505
اور اگر کوئی مسلمان ہو جائے تو آپ کے درمیان اس کی کیا حیثیت ہوگی؟

298
00:23:13,530 --> 00:23:15,576
آپؓ نے فرمایا؛ آپ کا مقام بلاامتیاز ہمارے ساتھ ہمارے برابر ہوگا

299
00:23:15,601 --> 00:23:16,908
جرجا(جارج) کہنے لگا؛

300
00:23:16,928 --> 00:23:24,365
 مطلب جو پہلے مسلمان ہو چکے ہیں وہ برتر یا مقدم نہیں ہیں، کیا نومسلم ان لوگوں کے برابر ہو سکتا ہے؟

301
00:23:24,390 --> 00:23:27,279
حضرت خالد بن ولیدؓ نے فرمایا؛ اور تم ان سے بہتر مسلمان بن سکتے ہو

302
00:23:27,304 --> 00:23:28,652
جارج کہنے لگا؛ یہ کیسے ہو سکتا ہے؟

303
00:23:28,677 --> 00:23:32,739
حضرت خالد بن ولید نے فرمایا؛ کیونکہ ہم نے حضرت محمد ﷺ کے معجزات دیکھے ہیں

304
00:23:32,764 --> 00:23:38,845
ہم نے آپؐ کو آپؐ کے ( معجزات، اخلاق و آداب کو) اپنی آنکھوں سے دیکھا ہے، یہ یقینی بات ہے

305
00:23:38,870 --> 00:23:41,725
لیکن آپ نے حضرت محمدﷺ سے کبھی ملاقات نہیں کی

306
00:23:41,750 --> 00:23:44,262
آپ نے رسول اللہؐ کو نہیں دیکھا اور آپؐ نے اُن کے معجزات مشاہدہ نہیں کیے

307
00:23:44,287 --> 00:23:48,419
اس کے باوجود، آپ مسلمان ہوتے ہیں تو آپ کا مقام بلند ہوگا

308
00:23:48,444 --> 00:23:52,359
تو جارج کہنے لگا؛ اگر کوئی مسلمان ہونا چاہتا ہے تو اسے کیا کرنا ہے؟ آپؓ نے فرمایا؛ آپ پڑھو

309
00:23:52,387 --> 00:23:55,445
أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ وَأَشْهَدُ أَنَّ مُحَمَّدًا رَسُول الله

310
00:23:55,520 --> 00:24:01,005
اس(جارج) نے یہ الفاظ دہرائے، اور اللہ کے کرم سے وہ بدل گیا اور اس نے مسلمانوں کی طرف سے جنگ لڑی

311
00:24:01,030 --> 00:24:04,645
اور اس معرکے میں بطور شہید ان کا انتقال ہوا

312
00:24:04,670 --> 00:24:12,405
اور اسی لیے علماء کہتے ہیں کہ اسلام میں شہادت وہ مقبول عمل ہے جس سے بڑھ کر کسی عمل کی ضرورت نہیں

313
00:24:12,430 --> 00:24:14,840
شہید کو اس سے پہلے کچھ نہیں کرنا پڑتا

314
00:24:14,865 --> 00:24:19,632
شہادت ان کو جنت میں اعلیٰ مقام عطا کرنے کے لیے کافی ہے

315
00:24:19,657 --> 00:24:21,465
 بغیر کسی خصوصی عمل کے صرف شہادت کافی ہے

316
00:24:21,490 --> 00:24:25,259
کوئی نماز، روزہ نہ زکوٰۃ ، نہ ہی کوئی زکر کیا

317
00:24:25,284 --> 00:24:27,332
أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ وَأَشْهَدُ أَنَّ مُحَمَّدًا رَسُول الله

318
00:24:27,357 --> 00:24:30,759
اور صرف جامِ شہادت نوش کرتے ہی آپ جنت میں اعلیٰ مقام پہ فائز ہوگئے

319
00:24:30,810 --> 00:24:40,359
چنانچہ جنگ شروع ہوئی، حضرت خالد بن ولیدؓ نے لشکر کو دائیں اور بائیں جانب سے آگے بڑھنے کا حکم دیا

320
00:24:40,384 --> 00:24:48,459
انہوں نے حملہ کیا اور اب رومی تعداد کے لحاظ سے مسلمانوں پر غالب آ رہے تھے

321
00:24:48,484 --> 00:24:57,879
چنانچہ شروع میں جب مسلمانوں کی فوج کے دائیں اور بائیں جانب والے دستوں نے حملہ کیا، اور رومیوں نے جواب دیا

322
00:24:57,899 --> 00:25:08,152
اور جب رومیوں کی وافر افرادی قوت نے مسلم لشکر پر جوابی حملہ کیا کو اُن کے لیے سنبھلنا مشکل ہو گیا

323
00:25:08,177 --> 00:25:12,172
تو دائیں اور بائیں جانب کے مسلم دستے پسپا ہو گئے

324
00:25:12,196 --> 00:25:26,779
اور مسلمان اس حد تک پسپا ہوگئے کہ رومی سپاہی مسلمان عورتوں کے خیموں کے قریب پہنچنے میں کامیاب ہو گئے

325
00:25:26,804 --> 00:25:31,712
اور یہ وہ وقت تھا جب خواتین کو جنگ میں شامل ہو کر لڑنا پڑا، کیونکہ اب دشمن کی فوج سر پہ تھی

326
00:25:31,737 --> 00:25:37,872
پس مسلم دستوں کی پسپائی اس قدر شدید تھی کہ اس نے مسلم فوج کے قدم اُکھاڑ دیئے

327
00:25:37,897 --> 00:25:43,212
کہ وہ مسلم فوج کے قائم کردہ جنگی کیمپ تک پہنچ گئے

328
00:25:43,237 --> 00:25:46,335
تو خواتین میدانِ جنگ میں اُتریں اور انھوں نے جنگ لڑی

329
00:25:46,360 --> 00:25:50,519
حضرت ابوسفیانؓ کی بیٹی حضرت جویریہؓ لڑ رہی تھیں

330
00:25:50,544 --> 00:25:52,619
حضرت ام حکیمؓ لڑ رہی تھیں

331
00:25:52,644 --> 00:26:01,879
حضرت عمرو بن عاصؓ کی بیٹی پسپا ہوتے مجاہدین کو جوش دلا رہی تھیں، اور کہہ رہی تھیں کہ شرم کرو تم پیٹھ پھیر کر بھاگ رہے ہو

332
00:26:01,920 --> 00:26:03,922
چنانچہ خواتین کا دوہرا کردار تھا

333
00:26:03,947 --> 00:26:09,299
ان میں سے ایک؛ خواتین کا جنگ لڑنا ہے اور طبری میں مذکور ہے کہ انہوں نے اپنی تلواریں اٹھائیں اور اُنھوں نے دشمن سے جنگ کی

334
00:26:09,324 --> 00:26:15,425
اور دوسرا کردار ان مسلمان فوجیوں پر پتھر پھینکنا تھا، جو جنگ میں پیٹھ دکھا رہے تھے

335
00:26:15,450 --> 00:26:19,092
  انہیں واپس میدانِ جنگ میں بلانا اور دوبارہ جنگ کے لئے آمادہ کرنا

336
00:26:19,117 --> 00:26:26,259
چنانچہ یہ وہ کردار تھا جو مسلمان خواتین نے جنگ یرموک میں ادا کیا

337
00:26:26,284 --> 00:26:31,052
حضرت معاذ بن جبلؓ میدان میں مجاہدین کی حوصلہ افزائی کر رہے تھے

338
00:26:31,077 --> 00:26:33,822
ابوسفیانؓ میدان میں گشت کر رہے تھے

339
00:26:33,842 --> 00:26:35,725
ایک صحابی فرماتے ہیں؛

340
00:26:35,750 --> 00:26:40,135
جنگ میں پُرسکوت لمحات تھے

341
00:26:40,160 --> 00:26:45,718
جنگ میں گرم جوشی کا فقدان ہونے لگا تھا، پھر میں نے اچانک کسی کو کہتے سنا؛

342
00:26:45,743 --> 00:26:47,879
يَا نصرالله أقترب، يَا نصرالله أقترب

343
00:26:47,904 --> 00:26:51,199
اے ربِ زولجلال کی عطاء کردہ فتح قریب آ، اے اللہ کی عطا کردہ فتح ہمیں سرخرو فرما

344
00:26:51,224 --> 00:26:55,732
تو میں متجسس ہوا کہ یہ منادی کرنے والی آواز کس کی ہے

345
00:26:55,757 --> 00:27:03,142
اور میں آگے بڑھا تو دیکھا کہ حضرت ابوسفیانؓ اپنے بیٹے کے ساتھ سب کو تحریض دلا رہے تھے اور اللہ تبارک وتعالٰی سے مدد مانگ رہے تھے

346
00:27:03,167 --> 00:27:09,632
چنانچہ جنگِ یرموک میں حضرت ابوسفیانؓ اس قدر پُرجوش تھے

347
00:27:09,657 --> 00:27:11,985
تو حالات مسلمانوں کے حق میں قدرے سازگار ہو رہے تھے

348
00:27:12,010 --> 00:27:15,979
اور مسلمان رومیوں پہ غالب ہونے لگے تھے اور انہیں مزید پیچھے دھکیل رہے تھے

349
00:27:16,004 --> 00:27:21,739
چنانچہ مسلمانوں نے رومیوں کو، آغازِجنگ کے اصل مقام کی طرف واپس دھکیل دیا یا شاید اس سے بھی پیچھے

350
00:27:21,764 --> 00:27:25,479
تو اب جنگ کا پانسہ پلٹ رہا تھا

351
00:27:25,504 --> 00:27:34,552
حضرت خالد بن ولیدؓ تقریباً ایک سو گھڑ سواروں پہ مشتمل دستے کی قیادت کر رہے تھے

352
00:27:34,577 --> 00:27:38,275
جو بہت تیز اور چاک و چوبند تھا

353
00:27:38,300 --> 00:27:43,005
آپؓ نے رومی فوج پہ بائیں جانب سے حملہ کرنے کا فیصلہ کیا

354
00:27:43,030 --> 00:27:47,025
الله أعلم آپؓ نے حملہ کرنے کے لیے فوج کے اس حصے کو خاص طور پر کیوں منتخب کیا

355
00:27:47,050 --> 00:27:49,712
شاید یہ فیصلہ اس دستے کی موزوں ترین پوزیشن کی وجہ سے ہوا

356
00:27:49,737 --> 00:27:55,805
چنانچہ آپ‌ؓ نے حملہ کردیا اور یہ رومی فوج کے لیے ایک شدید دھچکا تھا

357
00:27:55,830 --> 00:28:00,052
اس ایک حملے میں چھ ہزار رومی جنگجو مارے گئے

358
00:28:00,077 --> 00:28:04,112
لہٰذا یہ فوج کے بائیں بازو پہ کاری وار تھا

359
00:28:04,137 --> 00:28:08,405
اور پھر حضرت خالدؓ پیچھے ہٹ گئے اور آپؓ نے اپنے مجاہدین کو مخاطب کیا، آپؓ نے فرمایا؛

360
00:28:08,430 --> 00:28:17,259
اللہ کی قسم، دشمن میں وہ دم خم اور طاقت نہیں ہے جو تم نے دیکھی ہے

361
00:28:17,284 --> 00:28:22,625
دوسرے الفاظ میں، ہم نے انہیں اس حد تک پسپا کر دیا ہے، وہ اس سے زیادہ اب کچھ نہیں کر سکتے

362
00:28:22,650 --> 00:28:30,065
جس کا مطلب ہے کہ ہمیں تھوڑا سا مزید پیچھے دھکیلنے کی ضرورت ہے حتیٰ کہ دشمن کی کمر توڑ کے رکھ دیں

363
00:28:30,090 --> 00:28:32,840
چنانچہ حضرت خالد بن ولیدؓ نے دوبارہ حملہ کیا

364
00:28:32,865 --> 00:28:39,305
اور حضرت عمرو بن عاص‌ؓ کی زیرِ قیادت دائیں طرف کے مسلم دستوں کو موثر پیش قدمی کے لئے متحرک کیا

365
00:28:39,330 --> 00:28:43,518
اور وہ رومی فوج کا محاصرہ(تطویق) کرنے میں میں کامیاب ہوئے

366
00:28:43,543 --> 00:28:47,945
تو زرا تصور کریں کہ پینتالیس ہزار نے اڑھائی لاکھ کو گھیر لیا

367
00:28:47,980 --> 00:28:51,732
چنانچہ وہ(مسلمان) اب ان کا محاصرہ کرنے میں کامیاب ہو گئے، کیونکہ حضرت خالد بن ولیدؓ نے فرمایا؛

368
00:28:51,757 --> 00:28:56,225
یہ رومیوں کا اختتام ہے، وہ لڑ نہیں سکتے، وہ شکست کے مقام پر پہنچ رہے ہیں

369
00:28:56,250 --> 00:28:58,871
اور أللہ أعلم کہ حضرت خالد بن ولیدؓ نے یہ اندازہ کیسے لگایا؟

370
00:28:58,896 --> 00:29:03,829
شاید رومیوں کی جوابی کاروائی یا پھر اُن کے چہروں کے تاثرات سے آپؓ نے ان کی شکست خوردگی کے آثار دیکھ لئے تھے

371
00:29:03,854 --> 00:29:07,962
آپؓ نے فرمایا؛ بس ان پر حملہ کرو اور انہیں گھیر لو

372
00:29:07,987 --> 00:29:15,205
چنانچہ انہوں نے لشکر کو تین اطراف سے گھیر لیا اور ان کی پشت پہ خندق تھی

373
00:29:15,230 --> 00:29:19,605
اب ظاہر ہے کہ محصور ہو جانے والا لشکر بہت بڑا تھا

374
00:29:19,625 --> 00:29:21,712
تو پھر حضرت خالد بن ولیدؓ نے حکمتِ عملی اختیار ہہ فرمائی کہ

375
00:29:21,737 --> 00:29:30,129
آپؓ نے اپنے سپاہیوں کو حکم دیا کہ وہ رومی فوج کے گھڑسواروں اور پیادہ دستوں کو ایک دوسرے سے جدا کر دیں

376
00:29:30,154 --> 00:29:31,769
چنانچہ وہ یہ جنگی چال چلنے میں کامیاب ہو گئے

377
00:29:31,794 --> 00:29:35,325
لہٰذا اب گھڑسوار فوج پیادہ فوج سے الگ ہو چکی تھی

378
00:29:35,350 --> 00:29:39,292
گھڑ سوار دستے پیدل دستوں سے جدا ہو چکے تھے

379
00:29:39,317 --> 00:29:42,379
اور پھر حضرت خالد بن ولیدؓ نے حضرت عمرو بن عاصؓ کو حکم دیا

380
00:29:42,404 --> 00:29:47,792
آپؓ نے فرمایا کہ گھڑسواروں کو میدان سے بھاگنے کا راستہ دیں

381
00:29:47,817 --> 00:29:52,179
حضرت خالد بن ولیدؓ جانتے تھے کہ ان کی جنگ کرنے کی ہمت اور سکت ختم ہو چکی ہے

382
00:29:52,204 --> 00:29:54,452
اور اب وہ صرف اپنی جان بچانا چاہتے ہیں

383
00:29:54,477 --> 00:29:58,352
آپؓ جانتے تھے کہ اب رومیوں کو مکمل دبوچ لیا گیا ہے اور اب وہ مقابلے کرنے کی سکت نہیں رکھتے

384
00:29:58,377 --> 00:30:02,125
چنانچہ آپؓ نے حضرت عمرو بن عاصؓ سے فرمایا کہ ان کے لئے ایک راہِ فرار کھول دیں کیونکہ اب وہ ہر طرف سے محصور تھے

385
00:30:02,145 --> 00:30:04,452
آپؓ نے فرمایا؛ محاصرہ کھول دیں، رومیوں کو فرار ہونے کا موقع دیں

386
00:30:04,477 --> 00:30:08,212
اور جیسے ہی حضرت عمرو بن عاصؓ نے اس حکم کی تعمیل کیا، رومیوں کے گھڑ سوار دستے فرار ہوگئے

387
00:30:08,237 --> 00:30:15,072
اور وہ صحرا کی طرف چلے گئے، ہر کوئی اپنی جان بچانے کی کوشش کر رہا تھا

388
00:30:15,097 --> 00:30:18,545
تو اب آپ کے سامنے بغیر کسی دفاع کے پیادہ سپاہی تھے

389
00:30:18,570 --> 00:30:25,832
اور یہ وہ لمحات تھے جب مسلم فوج نے انہیں مزید پیچھے دھکیلنا شروع کردیا

390
00:30:25,857 --> 00:30:37,499
اب علامہ طبریؒ فرماتے ہیں کہ جیسے ہی دس میں سے دو آدمیوں کو قتل کرنے کے بعد چٹان سے گرایا جاتا

391
00:30:37,524 --> 00:30:41,232
 وہ اپنے پورے دستے کو گھسیٹتے کھائی میں جا گرتے

392
00:30:41,257 --> 00:30:49,465
آپؒ فرماتے ہیں کہ اسی ہزار(80,000) رومی فوجی چٹان کے ساتھ گھاٹی میں جا گرے،

393
00:30:49,490 --> 00:30:57,665
رومی فوج کے مارے جانے والے سپاہیوں کی کل تعداد تقریباً(120,000) ایک لاکھ بیس ہزار تھی

394
00:30:57,690 --> 00:30:59,755
ان میں سے اسی ہزار (80,000) گہری کھائی میں گرے

395
00:30:59,775 --> 00:31:01,355
وہ کثیر تعداد میں قتل ہو رہے تھے،

396
00:31:01,375 --> 00:31:03,729
کیونکہ اب رات ہو چُکی تھی

397
00:31:03,754 --> 00:31:07,745
اور سپاہی بس بھاگ رہے تھے اور وہ نہیں جانتے تھے کہ کس سمت میں جانا ہے

398
00:31:07,770 --> 00:31:09,979
تو ان میں سے کچھ فرار ہونے کے لئے پہاڑ سے چھلانگ لگا رہے تھے

399
00:31:10,004 --> 00:31:15,705
اس کے علاوہ زنجیروں میں باہم جکڑے ہوئے سپاہی ایک دوسرے کی موت کا سبب بنے

400
00:31:15,730 --> 00:31:17,837
اور یہ حضرت عمرو بن عاصؓ کی پیشگوئی تھی، آپؓ نے فرمایا؛

401
00:31:17,862 --> 00:31:19,142
وقلما حياتي بمحصور بخير

402
00:31:19,167 --> 00:31:25,082
اِنہوں نے خود شکست مول لی ہے ، ایک تو خود کو باہم زنجیروں سے جکڑنا اور دوسرا چٹان کے ساتھ محصور ہونا، یہی مسلم لشکر کا حاصلِ مقصود تھا

403
00:31:25,107 --> 00:31:30,382
اور حضرت خالد بن ولیدؓ نے اپنی رات تھیوڈور کے خیمے میں گزاری

404
00:31:30,407 --> 00:31:31,885
تھیوڈور خود مارا جا چُکا تھا

405
00:31:31,910 --> 00:31:39,465
چنانچہ اب حضرت خالد بن ولیدؓ رومی جرنیل کے خیمے میں ٹھہرے ہوئے تھے اور رات کو جنگ جاری رہی

406
00:31:39,490 --> 00:31:46,079
اب مسلمان صرف باقی ماندہ رومی سپاہیوں کو ختم کر رہے تھے، جو فرار نہیں ہوسکے تھے

407
00:31:46,104 --> 00:31:50,385
تو یہ مسلمانوں کی بہت بڑی فتح تھی

408
00:31:50,405 --> 00:31:57,985
اور اسی لیے یوم یرموک تاریخ اسلام کا ایک یادگار واقعہ ہے

409
00:31:58,010 --> 00:32:01,160
نہ صرف جنگِ یرموک کے دن جو اہم واقع پیش آیا

410
00:32:01,185 --> 00:32:07,225
بلکہ اس لیے کہ یرموک کی فتح دراصل شام کی فتوحات کے سلسلے میں اہم موڑ تھا

411
00:32:07,250 --> 00:32:16,645
کیوںکہ جنگِ یرموک کے دوران جو کچھ ہوا، اس کی وجہ سے، شام میں رومی سلطنت کی مزاحمت ٹوٹ گئی

412
00:32:16,670 --> 00:32:24,279
اور اس کے بعد یکے بعد دیگرے مختلف شہروں کی فتوحات کا سلسلہ جاری ہوگیا

413
00:32:24,304 --> 00:32:29,772
اور شام، افریقہ اور یورپ کا داخلی دروازہ تھا

414
00:32:29,797 --> 00:32:35,482
اس طرح مسلمانوں نے مصر اور پھر شمالی افریقہ کو فتح کیا

415
00:32:35,507 --> 00:32:39,165
تو یہ(جنگِ یرموک) ایک بہت ہی اہم واقعہ تھا

416
00:32:39,190 --> 00:32:44,482
جنگِ یرموک میں تین ہزار مسلمان شہید ہوئے جن میں ایک بڑی تعداد صحابہ کی تھی

417
00:32:44,507 --> 00:32:49,075
ان شہداء میں سے ایک حضرت عکرمہ بن ابو جہلؓ بھی تھے

418
00:32:49,100 --> 00:32:51,186
اورحضرت عکرمہؓ کا احوال منفرد دلفریب ہے

419
00:32:51,211 --> 00:32:55,145
کیونکہ پہلی بات تو یہ کہ حضرت عکرمہؓ، ابوجہل کے بیٹے تھے

420
00:32:55,170 --> 00:33:01,272
رسول اللہؐ کا بدترین دشمن، اس امت کا فرعون، وہ اس امت کا فرعون ہے

421
00:33:01,297 --> 00:33:08,499
نمبر دو، حضرت عکرمہؓ خود بھی اسلام دشمنی میں اپنے والد سے مختلف نہیں تھے

422
00:33:08,524 --> 00:33:17,325
حضرت عکرمہؓ، غزوہ احد میں حضرت خالد بن ولیدؓ کے بعد دوسری اہم ترین شخصیت تھے

423
00:33:17,350 --> 00:33:20,085
حضرت خالد بن ولیدؓ بھی اس وقت مسلمانوں کے خلاف لڑ رہے تھے

424
00:33:20,110 --> 00:33:27,525
یہ خالد بن ولیدؓ اور عکرمہؓ ہی تھے، جنہوں نے مسلمانوں کے پیچھے سے وار کر کے، جنگ احد میں مسلمانوں کو شکست سے دوچار کیا

425
00:33:27,550 --> 00:33:34,135
حضرت عکرمہؓ بن ابو جہل، رسول اللہؐ کے، فتح مکہ تک بدترین دشمنوں میں سے تھے

426
00:33:34,160 --> 00:33:37,885
جنگ یرموک میں دیکھیں، حضرت عکرمہؓ نے کیا کیا؟

427
00:33:37,910 --> 00:33:45,299
حضرت عکرمہؓ نے فرمایا؛ میں بارہا رسول اللہؐ کے خلاف محاذ آراء ہوا ہوں

428
00:33:45,324 --> 00:33:49,339
اب آج کے دن کیا میں پیٹھ پھیر لوں؟

429
00:33:49,364 --> 00:33:55,559
میں نے حضرت محمدﷺ کے خلاف کئی بار جنگ کی ہے مجھے اس کا کفارہ ادا کرنا ہے

430
00:33:55,584 --> 00:34:00,945
تو آج کے دن جب اللہ مجھے موقع دے گا تو کیا میں پیچھے ہٹ جاؤں؟

431
00:34:00,970 --> 00:34:04,552
تو اس بات کو یقینی بنانے کے لیے کہ آپؓ آخری دم تک لڑیں گے

432
00:34:04,577 --> 00:34:10,779
آپؓ نے اپنے قریبی ساتھیوں کو بلایا اور آپؓ ایک دستے کی قیادت کر رہے تھے

433
00:34:10,799 --> 00:34:18,445
آپؓ نے اپنے قریبی ساتھیوں کو بلایا، ان میں آپؓ کے چچا حضرت حارث بن ہشامؓ، حضرت ضرار إبن أزورؓ اور بہت سے دیگر صحابہؓ شامل تھے

434
00:34:18,465 --> 00:34:18,952
 اور آپؓ نے فرمایا؛

435
00:34:18,972 --> 00:34:24,479
آئیے ایک دوسرے سے اللہ کے لیئے مر مٹنے پر بیعت کرتے ہیں

436
00:34:24,504 --> 00:34:32,329
دوسرے لفظوں میں، ہم دشمن کی صفوں میں گھسنے والے ہیں

437
00:34:32,354 --> 00:34:38,419
اور چونکہ ہم نے زندہ نہ رہنے کی قسم کھائی ہے، اس لیے ہم شہادت حاصل کرنے تک دشمن سے لڑیں گے

438
00:34:38,444 --> 00:34:41,505
یہ وہ بیعت ہے جو انھوں نے دی تھی

439
00:34:41,530 --> 00:34:43,736
ألبيعة ألموت، تبابعنا على الموت

440
00:34:43,761 --> 00:34:48,792
ہم مرنے پر بیعت کرتے ہیں، ہم زندہ واپس نہیں آئیں گے

441
00:34:48,817 --> 00:34:55,022
اور ویسے بھی یہ ایک مستند جواز ہے، جو علماء ربانی جنگ میں خُودکُش حملوں کی توثیق میں استعمال کرتے ہیں

442
00:34:55,047 --> 00:34:56,642
عملية الأستشهادية

443
00:34:56,667 --> 00:34:59,142
کہ جو مذکورہ صحابہ ہیں ، سب کے سب صحابہ میں سے نہیں تھے

444
00:34:59,167 --> 00:35:04,599
حضرت عکرمہؓ صحابی تھے، حضرت حارث بن ہشامؓ صحابی تھے اور حضرت ضرار ابن ازورؓ بھی صحابی تھے

445
00:35:04,619 --> 00:35:06,945
، سفرِ شہادت پہ روانہ ہونے والے صحابہ کا دستہ چارسو افراد پہ مشتمل تھا

446
00:35:06,970 --> 00:35:10,239
 چار سو مجاہدین کا یہ کوئی چھوٹا دستہ نہیں تھا، انہوں نے مرنے پر بیعت کی تھی

447
00:35:10,264 --> 00:35:15,495
علمائے ربانی نے عملیۃ الاستشھادیۃ کی تائید کے ثبوت کے طور پر، اس واقع کو کیوں استعمال کیا ہے؟

448
00:35:15,520 --> 00:35:21,419
  اس حقیقت کی وجہ سے کہ، انہوں نے مرنے کا وعدہ کیا تھا

449
00:35:21,444 --> 00:35:26,277
اور شہادت حاصل کرنے کی سر توڑ کوشش کی

450
00:35:26,302 --> 00:35:36,045
یہ چار سو مجاہدین میدانِ جنگ میں بے سُدھ پڑے تھے، سو انھوں نے اپنی قَسم پوری کی

451
00:35:36,070 --> 00:35:41,925
ان میں سے کچھ موقع پر شہید ہو گئے تھے اور باقی اتنے شدید زخمی تھے کہ وہ آگے نہیں بڑھ سکتے تھے

452
00:35:41,950 --> 00:35:44,552
تو انہوں نے حلف کو پورا کیا، انہوں نے شہادت کے لئے سر توڑ کوشش کی

453
00:35:44,577 --> 00:35:47,899
پس جو بچ گئے وہ اس لیئے زندہ نہیں رہے کہ انہوں نے قسم توڑ دی

454
00:35:47,919 --> 00:35:50,952
وہ بچ گئے کیونکہ ان کے زخم اتنے شدید تھے،

455
00:35:50,972 --> 00:35:56,072
کہ اس کی وجہ سے وہ معذور ہو گئے، وہ جنگ میں مزید شرکت نہ کر سکے

456
00:35:56,097 --> 00:36:02,859
اب آپ نے ان صحابہ کا قصہ تو سنا ہوگا جو جان بلب تھے اور پھر انہیں پانی پلایا گیا

457
00:36:02,884 --> 00:36:07,745
 تو اُن زخمی مجاہدین میں سے ہر ایک نے جزبہ ایثار کے تحت پانی پینے سے انکار کرتے ہوئے، اگلے زخمی مجاہد کو پانی پلانے کا کہا

458
00:36:07,770 --> 00:36:09,215
آپ یہ حکایت سُن چکے ہیں، ٹھیک ؟

459
00:36:09,240 --> 00:36:13,539
یہ واقعہ دراصل جنگِ یرموک میں خودکش مجاہدین کے اس گروہ کے ساتھ پیش آیا تھا

460
00:36:13,564 --> 00:36:20,132
انہوں نے ان میں سے ایک زخمی مجاہد کو پانی دیا، تو وہ کہنے لگا میرے بھائی کو پانی دے دو، اسے اس کی مجھ سے زیادہ ضرورت ہے

461
00:36:20,157 --> 00:36:22,883
لہٰذا پانی اس دوسرے مجاہد کو دیا گیا، تو وہ کہنے گا کہ میرے دوسرے بھائی کو یہ پانی دو

462
00:36:22,908 --> 00:36:24,819
جس کو مجھ سے زیادہ اس کی ضرورت ہے

463
00:36:24,844 --> 00:36:28,069
تو پانی ایک مکمل دائروی چکر لگا کر اسی شخص کے پاس واپس گیا

464
00:36:28,094 --> 00:36:33,102
جن کو یہ سب سے پہلے پیش کیا گیا تھا، لیکن اس وقت تک ان میں سے اکثر شہید ہو چکے تھے

465
00:36:33,127 --> 00:36:39,719
پس یہ بلا خوف و خطر اللہ کی رضا کے لئے بخوشی جان دینے کی اور ایثار کی زندہ و جاوید مثال ہے

466
00:36:39,744 --> 00:36:44,765
اپنے بھائی کے لیے قربانی دینا، اسے مجھ سے زیادہ پانی کی ضرورت ہے

467
00:36:44,790 --> 00:36:52,532
یہ مسلمانوں کی بہت بڑی فتح تھی لیکن جشن کی سب خوشیاں ماند پڑ گیئں

468
00:36:52,557 --> 00:36:58,092
کیونکہ خلیفہ کے وصال کی خبر کا اعلان کیا جا چکا تھا

469
00:36:58,117 --> 00:37:09,002
 طبریؒ کے روایت کردہ بیان کے مطابق، جنگ شروع ہونے سے قبل، حضرت خالد بن ولیدؓ کے پاس مدینہ سے ایک قاصد آیا،

470
00:37:09,027 --> 00:37:13,129
قاصد نے حضرت خالد بن ولیدؓ کو ایک مکتوب دیا

471
00:37:13,154 --> 00:37:17,979
جس میں یہ بیان ہوا تھا کہ خلیفہ حضرت ابوبکرؓ کا وصال ہوگیا ہے

472
00:37:18,004 --> 00:37:21,105
اور حضرت عمر بن خطابؓ نو منتخب خلیفہ ہیں

473
00:37:21,130 --> 00:37:29,335
اور یہ کہ حضرت عمر بن خطابؓ نے مسلم لشکر کی قیادت حضرت ابوعبیدہ عمرو بن جراحؓ کے ہاتھ میں دے دی ہے

474
00:37:29,360 --> 00:37:33,845
چنانچہ حضرت خالد بن ولیدؓ کو ان کے عہدے سے برطرف کر دیا گیا

475
00:37:33,870 --> 00:37:38,812
اور ان کی جگہ حضرت ابو عبیدہ عمرو بن جراحؓ  نے قیادت سنبھالیں

476
00:37:38,837 --> 00:37:43,245
طبریؒ کے مطابق حضرت خالد بن ولیدؓ نے اس خط کو مصلحتاً مخفی رکھا

477
00:37:43,270 --> 00:37:46,124
اور قاصد کو کہا کہ وہ کسی سے زکر نہ کرے،

478
00:37:46,144 --> 00:37:52,745
اور آپؓ نے دراصل اس قاصد کو اپنے خیمے میں پابند کر دیا، تاکہ اس بات کو یقینی بنایا جائے کہ وہ اس خبر کو لشکر میں نہ پھیلا سکے

479
00:37:52,779 --> 00:37:54,712
حضرت خالد بن ولیدؓ کو اندازہ تھا کہ

480
00:37:54,732 --> 00:38:01,662
اگر حضرت ابوبکرصدیقؓ کے وصال کی افسوسناک خبر، اس نازک صورتحال میں فوجیوں تک پہنچی تو یہ وقت کسی بھی صورت مناسب نہیں ہے

481
00:38:01,687 --> 00:38:05,789
اب انہیں یہ سوچنے کی ضرورت تھی کہ اس صورتحال کا سامنا کیسے کیا جائے

482
00:38:05,814 --> 00:38:07,459
جنگ ابھی شروع نہیں ہوئی تھی،

483
00:38:07,479 --> 00:38:13,389
اس لیے آپؓ نے سوچا کہ یہ افسوس ناک خبر سنا کر میں مجاہدین کے حوصلے پست نہیں کرنا چاہتا

484
00:38:13,414 --> 00:38:17,659
جو کہ خلیفہ حضرت ابوبکر صدیقؓ کے وصال کی خبر ہے

485
00:38:17,684 --> 00:38:19,419
چنانچہ آپؓ نے اس خبر کو مخفی رکھنے کا فیصلہ کیا،

486
00:38:19,439 --> 00:38:20,955
حتیٰ کہ جنگ ختم ہو گئی

487
00:38:20,979 --> 00:38:22,899
اور مسلم لشکر فتح یاب ہو گیا

488
00:38:22,924 --> 00:38:26,739
اور پھر آپؓ نے مسلمانوں کو یہ خبر سنائی اور آپؓ اپنے عہدے سے دست بردار ہو گئے

489
00:38:26,764 --> 00:38:31,325
اور آپؓ نے شام میں لشکر کی قیادت حضرت ابوعبیدہؓ کے سپرد کردی

490
00:38:31,350 --> 00:38:37,245
اور اس لحاظ سے یہ آخری موقع تھا جب حضرت خالد بن ولیدؓ نے قیادت کا عہدہ سنبھالا

491
00:38:37,270 --> 00:38:42,072
کیونکہ حضرت عمر بن خطابؓ نے یہ فیصلہ کیا

492
00:38:42,097 --> 00:38:46,985
حضرت خالد بن ولید‌ؓ کی تلوار کی دھار تیز ہے، یعنی آپؓ کے مزاج میں شدت پسندی ہے

493
00:38:47,010 --> 00:38:49,645
اور اب آپؓ کے عہدے پر کسی اور کو تعینات کرنے کا وقت آگیا ہے

494
00:38:49,670 --> 00:38:52,952
اب ابن تیمیہؒ کے بیان کو دیکھیں، جیسا کہ میں نے آپ سے پہلے ذکر کیا، آپؒ فرماتے ہیں کہ

495
00:38:52,977 --> 00:38:59,899
استدلال یہ ہے اور اس کے پیچھے حکمت یہ ہے کہ اگر خلیفہ سخت طبیعت کا ہو

496
00:38:59,924 --> 00:39:04,359
اس کا نائب یا قائم مقام ایسا شخص ہونا چاہیے جو تحمل مزاج ہو

497
00:39:04,384 --> 00:39:09,732
اور اگر خلیفہ نرم مزاج ہے تو اس کے ماتحت کوئی ایسا شخص ہونا چاہیے جو تند و تلخ ہو

498
00:39:09,757 --> 00:39:15,999
چنانچہ حضرت ابوبکر صدیق‌ؓ اور حضرت خالد بن ولیدؓ ایک ساتھ بہت اچھی مطابقت میں تھے

499
00:39:16,024 --> 00:39:18,925
ایک نرم مزاج بُردبار(حضرت ابوبکرؓ) اور دوسرا سخت مزاج(حضرت خالدؓ) تھا

500
00:39:18,950 --> 00:39:22,739
اورحضرت عمر بن خطابؓ اورحضرت ابوعبیدہؓ کے مزاج میں موافقت تھی

501
00:39:22,764 --> 00:39:27,812
کیونکہ حضرت عمر بن خطابؓ بہت سخت مزاج تھے اورحضرت ابوعبیدہ بہت نرم خو اور رحم دل تھے

502
00:39:27,837 --> 00:39:32,765
حضرت ابوبکر صدیقؓ نے ایک دن سخت سردی میں غسل کیا

503
00:39:32,790 --> 00:39:35,425
تو آپؓ کو بخار ہو گیا

504
00:39:35,450 --> 00:39:41,132
اور آپؓ کا بخار دن بدن بڑھتا جا رہا تھا اس لیے آپؓ کی حالت روز بروز بگڑ رہی تھی

505
00:39:41,157 --> 00:39:47,432
حضرت ابوبکر صدیقؓ نے محسوس کیا کہ یہ آپؓ کی زندگی کے آخری لمحات ہیں

506
00:39:47,457 --> 00:39:50,605
آپؓ کی زندگی کا سفر اختتام پزیر ہونے جا رہا ہے

507
00:39:50,630 --> 00:39:59,305
پس اب حضرت ابوبکر صدیقؓ کو یہ فکر لاحق تھی کہ میرا قائم مقام/جانشین کس کو مقرر کیا جائے

508
00:39:59,330 --> 00:40:04,712
چنانچہ آپؓ نے شوریٰ کا انعقاد کیا، آپؓ نے حضرت عبدالرحمن بن عوفؓ کو مدعو کیا

509
00:40:04,737 --> 00:40:10,205
حضرت عبدالرحمٰن بن عوف اندر تشریف لائے، حضرت ابوبکر صدیقؓ نے اُن سے پوچھا؛

510
00:40:10,230 --> 00:40:12,892
حضرت عمرؓ کے بارے میں آپؓ(حضرت عبدالرحمٰنؓ) کی کیا رائے ہے؟

511
00:40:12,917 --> 00:40:14,899
حضرت عمر بن خطابؓ کے بارے میں آپؓ کا کیا خیال ہے؟

512
00:40:14,924 --> 00:40:24,032
حضرت عبدالرحمٰن بن عوفؓ نے فرمایا؛ آپ نے مجھ سے جو کچھ دریافت کیا ہے اس کے متعلق آپؓ زیادہ بہتر جانتے ہیں

513
00:40:24,057 --> 00:40:29,859
حضرت عبدالرحمٰن بن عوفؓ فرما رہے ہیں کہ آپؓ ہم میں سے سب سے زیادہ باعلم شخصیت ہیں

514
00:40:29,884 --> 00:40:33,765
حضرت ابوبکر صدیقؓ نے فرمایا؛ میں آپؓ کی رائے سننا چاہتا ہوں

515
00:40:33,790 --> 00:40:37,025
حضرت عبدالرحمٰن بن عوفؓ نے فرمایا؛

516
00:40:37,050 --> 00:40:43,272
میرا خیال ہے کہ حضرت عمر بن خطابؓ، آپؓ کی سوچ سے بڑھ کر بہترین انسان ہیں

517
00:40:43,297 --> 00:40:47,305
حضرت عبدالرحمٰن بن عوفؓ جانتے تھے کہ حضرت ابوبکرؓ ان سے یہ سوال کیوں کر رہے تھے

518
00:40:47,330 --> 00:40:53,637
آپؓ جانتے تھے کہ آپؓ نئے خلیفہ کی تعیناتی کے تناظر میں یہ سوال کر رہے ہیں؛ کہ کون سا شخص منصبِ خلافت کے لیے موزوں ترین ہے

519
00:40:53,670 --> 00:40:56,552
تو حضرت عبدالرحمٰن بن عوفؓ فرماتے ہیں؛

520
00:40:56,577 --> 00:41:00,545
کہ حضرت عمرؓ، آپؓ کی سوچ سے بڑھ کر موزوں ہے

521
00:41:00,570 --> 00:41:04,585
دوسرے لفظوں میں حضرت عمرؓ مناسب ترین شخصیت ہیں

522
00:41:04,610 --> 00:41:09,402
ویسے حضرت عبدالرحمٰن بن عوفؓ بذاتِ خود بھی اس عہدے کے اُمیدواروں میں سے ایک ہو سکتے تھے

523
00:41:09,427 --> 00:41:11,195
آپؓ عشرہ مبشرہ بل جنۃ میں سے تھے

524
00:41:11,220 --> 00:41:17,605
اب ظاہر ہے کہ خلافت کا عہدہ ان دس صحابہ کے علاوہ کسی کے پاس نہیں جائے گا، جو حیات تھے

525
00:41:17,630 --> 00:41:20,392
اگر اُن عشرہ مبشرہ میں سے کوئی زندہ ہے،

526
00:41:20,417 --> 00:41:25,725
صحابہ کے اجماع کے مطابق یہ دس عظیم ترین شخصیات ہیں اور یہ عشرہ مبشرہ ہیں

527
00:41:25,750 --> 00:41:30,452
حضرت ابوبکرؓ، حضرت عمرؓ، حضرت عثمانؓ، حضرت علی بن ابو طالبؓ

528
00:41:30,477 --> 00:41:34,085
حضرت عبدالرحمٰن بن عوفؓ، حضرت طلحہ بن عبیداللہؓ

529
00:41:34,110 --> 00:41:38,592
حضرت زبیر بن عوامؓ، حضرت ابوعبیدہ عمرو بن جراحؓ

530
00:41:38,617 --> 00:41:44,125
حضرت سعید بن زید بن نفیلؓ اورحضرت سعد ابن ابی وقاصؓ

531
00:41:44,150 --> 00:41:45,619
یہ عشرہ مبشرہ ہیں

532
00:41:45,644 --> 00:41:48,632
چنانچہ حضرت عبدالرحمٰنؓ ان میں سے ایک ہیں

533
00:41:48,657 --> 00:41:52,095
تو آپؓ فرما رہے تھے کہ وہ(حضرت عمرؓ) آپ کی سوچ سے بڑھ کے مناسب شخصیت ہیں

534
00:41:52,115 --> 00:41:54,795
حضرت ابوبکر صدیقؓ نے فرمایا؛

535
00:41:54,826 --> 00:41:59,232
پھر اس بات کو راز رکھیں، اور اس گفتگو کے بارے میں کسی سے زکر نہ کریں

536
00:41:59,271 --> 00:42:02,172
حضرت عبدالرحمٰن بن عوفؓ نے فرمایا؛ یقینا! اور پھر آپؓ تشریف لے گئے

537
00:42:02,216 --> 00:42:07,379
حضرت ابوبکر صدیقؓ نے حضرت عثمان بن عفانؓ کو بُلایا

538
00:42:07,404 --> 00:42:12,122
چنانچہ حضرت عثمانؓ تشریف لائے، حضرت ابوبکر صدیقؓ نے فرمایا؛

539
00:42:12,170 --> 00:42:17,379
حضرت عمر بن خطابؓ کے بارے میں آپؓ کا کیا خیال ہے؟

540
00:42:17,413 --> 00:42:20,559
حضرت عثمان بن عفانؓ نے فرمایا؛

541
00:42:20,579 --> 00:42:27,505
 اللہ کی قسم، مجھے یقین ہے کہ حضرت عمر بن خطابؓ جو عمل خلوت میں کرتے ہیں

542
00:42:27,548 --> 00:42:31,312
اس عمل سے بہتر ہے جو آپؓ نے کھلم کھلا سرِعام کیا

543
00:42:31,361 --> 00:42:37,160
یعنی جو ہم حضرت عمر بن خطابؓ کے معمولات، آپؓ کی عظمت، اور آپؓ کے ظاہری عمل کو دیکھتے ہیں ،

544
00:42:37,192 --> 00:42:40,935
   لیکن جو آپؓ کے باطنی اعمال و معاملات جو آپؓ نجی طور پر سرانجام دیتے تھے، وہ اس سے کہیں بہتر ہیں

545
00:42:40,978 --> 00:42:42,222
 اور پھر فرمایا؛

546
00:42:42,265 --> 00:42:44,409
ولیس فینا مِثلَ

547
00:42:44,459 --> 00:42:47,835
اور ہم میں سے کوئی بھی آپؓ کی مثل نہیں ہے

548
00:42:47,867 --> 00:42:52,352
حضرت ابوبکر صدیقؓ نے حضرت عثمان بن عفانؓ کو بتایا، آپؓ نے فرمایا؛

549
00:42:52,389 --> 00:43:01,479
اگر میں نے حضرت عمر بن خطابؓ کو خلیفہ نہ چنا تو میرا دوسرا انتخاب آپؓ ہونگے

550
00:43:01,525 --> 00:43:04,492
اگر میں حضرت عمر بن خطابؓ کو منصبِ خلافت پہ مقرر کرنے کا فیصلہ نہیں کرتا

551
00:43:04,541 --> 00:43:09,219
تو آپؓ اس عہدے کی زمہ داری سنبھالیں گے

552
00:43:09,252 --> 00:43:16,412
 اور پھر حضرت اُسید بن خضیرؓ کو مدعو کیا اور اس معاملے پر آپؓ کی رائے پوچھی

553
00:43:16,444 --> 00:43:18,155
اور حضرت اُسید بن خضیرؓ نے فرمایا؛

554
00:43:18,180 --> 00:43:21,345
اللہمَّ أعْلم ألخير بعدك

555
00:43:21,418 --> 00:43:24,912
میرا خیال ہے کہ آپؓ کے بعد حضرت عمرؓ سب سے بہتر ہیں

556
00:43:24,945 --> 00:43:29,350
آپؓ ہر اس چیز سے خوش ہوتے ہیں جس سے مسلمان خوش ہوں

557
00:43:29,386 --> 00:43:34,381
آپؓ کی خوشی اس میں ہے جو مسلمانوں کو پسند ہے اور آپؓ کو ہر وہ بات ناگوار گزرتی ہے جو مسلمان کو ناگوار ہے

558
00:43:34,406 --> 00:43:38,919
یعنی آپؓ اُمت کے حق میں بہترین آدمی ہیں، آپؓ امت کا خیال رکھتے ہیں

559
00:43:38,941 --> 00:43:44,119
آپؓ اُمت کی فکر کرتے ہیں، اگر کوئی چیز امت کو خوشی دیتی ہے تو وہ آپؓ کے لئے بھی اہم ہے

560
00:43:44,147 --> 00:43:48,305
اگر کوئی چیز امت کو نقصان پہنچاتی ہو تو آپؓ کو بھی ناگوار گزرتی ہے

561
00:43:48,342 --> 00:43:53,042
آپؓ ایسے شخص نہیں ہیں جو اپنے مفاد کے لئے اُمت کا نقصان کرے

562
00:43:53,073 --> 00:43:57,009
آپؓ ایک ایسی شخصیت ہیں جنہوں نے اپنی زندگی اسلام اور مسلمانوں کے لئے وقف کردی ہے

563
00:43:57,050 --> 00:44:02,519
حضرت ابوبکر صدیقؓ نے حضرت عمرؓ سے متعلق جس سے بھی مشورہ طلب کیا، سب کا ایک ہی جواب تھا

564
00:44:02,553 --> 00:44:06,092
سب کی رائے ایک ہی تھی، سوائے حضرت طلحہ بن عبیداللہؓ کی رائے کے

565
00:44:06,139 --> 00:44:09,139
آپؓ وہ واحد صحابی تھے جن کی رائے مختلف تھی

566
00:44:09,178 --> 00:44:12,185
آپؓ نے حضرت ابوبکر صدیقؓ سے فرمایا؛

567
00:44:12,233 --> 00:44:20,105
اللہ عَزَّوَجَلْ کو قیامت کے دن آپؓ کیا جواب دیں گے جب وہ آپؓ سے سوال کرے گا؟

568
00:44:20,139 --> 00:44:27,535
حضرت عمر بن خطابؓ کو ہماری امامت کے لیے مقرر کرنے کے بارے میں، جب کہ آپؓ کو ان کی سخت مزاجی کا علم ہے

569
00:44:27,571 --> 00:44:31,665
حضرت عمر بن خطابؓ کی شخصیت بارُعب تھی، جو کہ آپؓ کی شخصیت کا فطری رنگ تھا

570
00:44:31,705 --> 00:44:35,272
آپؓ ایک مضبوط و مستحکم شخصیت کے حامل تھے

571
00:44:35,303 --> 00:44:38,999
اور آپؓ کا رُعب و جلال، آپؓ کی ظاہری شخصیت فطرتاً عزت و احترام کا متقاضی تھا

572
00:44:39,019 --> 00:44:42,819
اور آپؓ جسمانی لحاظ سے بھی مضبوط قدوقامت کے حامل تھے

573
00:44:42,858 --> 00:44:45,625
تو یہ سب آپؓ کی شخصیت کو مزید پُرکشش اور بارُعب بناتا تھا

574
00:44:45,657 --> 00:44:51,865
حضرت ابو موسیٰ اشعریؓ نے ایک دفعہ حضرت عمر بن خطابؓ کا دروازہ کھٹکھٹایا

575
00:44:51,898 --> 00:44:55,352
آپؓ نے تین بار دستک دی اور حضرت عمرؓ نے کوئی جواب نہیں دیا

576
00:44:55,406 --> 00:44:56,639
چنانچہ حضرت ابوموسیؓ واپس چلے گئے

577
00:44:56,685 --> 00:44:59,759
حضرت عمر بن خطابؓ باہر تشریف لائے اور سوال کیا؛ آپؓ کیوں واپس چلے گئے؟

578
00:44:59,799 --> 00:45:02,065
حضرت ابوموسٰیؓ نے فرمایا؛ کیونکہ میں نے رسول اللہؐ کو یہ فرماتے ہوئے سنا ہے

579
00:45:02,090 --> 00:45:06,519
اگر آپ کسی کے گھر میں داخل ہونے کے لئے تین بار اجازت طلب کریں اور آپ کو اجازت نہ دی جائے تو آپ واپس پلٹ جائیں

580
00:45:06,559 --> 00:45:09,705
حضرت عمر بن خطابؓ نے فرمایا؛ آپؓ اس حدیث سے متعلق ایک گواہ پیش کریں

581
00:45:09,746 --> 00:45:11,959
کہ رسول اللہؐ نے یہ مذکورہ بات بیان فرمائی تھی

582
00:45:11,996 --> 00:45:15,262
حضرت ابو موسیٰ اشعریؓ وہاں سے چلے گئے اور انصار کی مجلس میں تشریف لے گئے

583
00:45:15,299 --> 00:45:17,931
حضرت ابو سعید خدریؓ جنہوں نے یہ قصہ بیان فرمایا ہے،آپؓ فرماتے ہیں؛

584
00:45:17,963 --> 00:45:24,139
جب حضرت ابو موسیٰ تشریف لائے تو ان کا چہرہ زرد ہو گیا تھا، ان کے چہرے کا رنگ اُڑ گیا تھا

585
00:45:24,170 --> 00:45:25,705
سب پوچھنے لگے؛ تمہیں کیا ہوا؟

586
00:45:25,727 --> 00:45:28,465
آپؓ نے فرمایا؛ حضرت عمر بن خطابؓ نے کہا کہ مجھے اپنے بیان کی تصدیق کے لئے ایک گواہ لانا ہے

587
00:45:28,508 --> 00:45:30,392
کہ یہ رسول اللہؐ نے یہ فرمایا ہے

588
00:45:30,430 --> 00:45:36,619
حضرت ابو سعید خدریؓ نے فرمایا؛ ہم میں سے سب سے کم عمر شخص آپؓ کے ساتھ گواہی دے گا

589
00:45:36,656 --> 00:45:42,379
انصار کے چھوٹے بچے اس وقت رسول اللہؐ سے علمِ حدیث سیکھتے تھے

590
00:45:42,420 --> 00:45:45,579
جبکہ بعض صحابہ کرامؓ اس وقت اپنے روزمرہ کے کام میں مصروف ہوتے تھے

591
00:45:45,631 --> 00:45:49,197
ان کے پاس کاروباری مراکز تھے ان کے پاس کھیت تھے، ان کے پاس نوکریاں تھیں

592
00:45:49,221 --> 00:45:53,509
اس لیے وہ(صحابہ) اپنا سارا وقت رسول اللہؐ کے ساتھ نہیں گزار سکتے تھے

593
00:45:53,534 --> 00:45:57,925
سوائے نو عمر نوجوان کے جن کے خاندان اُن کی دیکھ بھال کر رہے ہوتے تھے

594
00:45:57,959 --> 00:46:01,519
وہ اپنا سارا وقت رسول اللہؐ کے ساتھ گزارنے کی استطاعت رکھتے تھے

595
00:46:01,566 --> 00:46:04,825
یا کچھ دیگر صحابہ جنہوں نے شعوری طور پہ اپنا وقت اس کام کے لئے وقف کیا

596
00:46:04,862 --> 00:46:08,488
حضرت ابوہریرہؓ کی طرح جنہوں نے اس کی قیمت ادا کی، آپؓ نے فرمایا؛

597
00:46:08,513 --> 00:46:11,739
وكُنْتُ ألْزَمُ رَسولَ اللَّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى مِلْءِ بَطْنِي،

598
00:46:11,959 --> 00:46:15,352
آپؓ نے فرمایا؛ میں فکرِ معاش میں مبتلا ہوئے بغیر رسول اللہؐ کے ساتھ وقت گزارتا تھا

599
00:46:15,377 --> 00:46:20,525
کیونکہ بعد میں جب حضرت ابوہریرہؓ نے یہ تمام احادیث بیان فرمائیں

600
00:46:20,561 --> 00:46:24,024
کچھ لوگ حضرت ابوہریرہؓ سے یہ سوال کرنے لگے

601
00:46:24,071 --> 00:46:26,211
 اور کہتے آپؓ کو یہ تمام احادیث کیسے معلوم ہوئیں؟

602
00:46:26,244 --> 00:46:30,959
جب کہ آپؓ سے پہلے مسلمان ہونے والے صحابہ کرامؓ کے پاس رسول اللہؐ کی ان تمام احادیث کا علم نہیں

603
00:46:31,012 --> 00:46:35,102
حضرت ابوہریرہؓ نے فرمایا؛ کیونکہ ان کے پاس کام کاج تھا، ان کے پاس کاروبار تھے، ان کے پاس کھیت تھے

604
00:46:35,135 --> 00:46:40,079
لیکن میرے پاس کچھ نہیں تھا اور میں بھوکا رہ کر رسول اللہؐ کے ہمراہ وقت گزارتا تھا

605
00:46:40,120 --> 00:46:44,146
چنانچہ ایک نوجوان صحابی گئے اور حضرت ابو موسیٰ اشعریؓ کے حق میں گواہی دی

606
00:46:44,186 --> 00:46:48,165
لیکن قابلِ توجہ نکتہ یہ ہے کہ یہ حضرت عمرؓ کی شخصیت کا رُعب تھا

607
00:46:48,209 --> 00:46:56,139
تو حضرت طلحہؓ نے حضرت ابوبکرؓ سے فرمایا کہ قیامت کے دن اللہ عَزَّوَجَلْ کو آپ کیا جواب دیں گے؟

608
00:46:56,172 --> 00:46:57,950
اب حضرت ابو بکر صدیقؓ نے فرمایا؛

609
00:46:57,970 --> 00:46:59,203
أجلِسُونِي

610
00:46:59,844 --> 00:47:06,219
کیونکہ آپؓ لیٹے ہوئے تھے، اس لیے آپؓ چاہتے تھے کہ حضرت طلحہؓ، آپؓ کو سیدھا بٹھا دیں

611
00:47:06,250 --> 00:47:10,569
حضرت ابوبکرؓ نے فرمایا؛ کیا آپؓ مجھے اللہ عَزَّوَجَلْ سے ڈرا رہے ہیں؟

612
00:47:10,607 --> 00:47:13,735
اگر اللہ عَزَّوَجَلْ مجھ سے پوچھے گا؛ میں نے عمرؓ کو کیوں خلیفہ مقرر فرمایا؟

613
00:47:13,760 --> 00:47:17,405
میں کہوں گا کیونکہ عمرؓ ہم میں سے بہترین انسان تھے

614
00:47:17,436 --> 00:47:22,305
ہر شخص کی شخصیت میں ایسی چیزیں ہوتی ہیں جو آپ کو ناپسند ہوتی ہیں

615
00:47:22,331 --> 00:47:25,912
لیکن عمرؓ آپ میں سے سب سے بہتر ہیں

616
00:47:25,954 --> 00:47:31,099
حضرت ابوبکر صدیقؓ نے حضرت طلحہؓ کی اس رائے کو سنجیدگی سے لیا

617
00:47:31,146 --> 00:47:32,961
کیونکہ اس میں اللہ عَزَّوَجَلْ کی بارگاہ میں جواب دہی کی یاد دہانی تھی

618
00:47:32,986 --> 00:47:35,333
تو حضرت ابوبکرؓ نے فرمایا؛ میرا جواب یہی ہوگا

619
00:47:35,370 --> 00:47:37,775
 ایک اور روایت میں ہے،

620
00:47:37,800 --> 00:47:40,222
 "أمَّرتُ عليهم ألقويُّ الأمين"

621
00:47:40,417 --> 00:47:43,805
اگر اللہ عَزَّوَجَلْ نے مجھ سے پوچھا کہ تم نے عمرؓ کو خلیفہ کیوں مقرر کیا تو میں کہوں گا

622
00:47:43,848 --> 00:47:48,172
کیونکہ آپؓ قوی اور امین ہیں، عمرؓ طاقتور اور امانت دار ہیں

623
00:47:48,215 --> 00:47:56,112
اور یہ وہی دو الفاظ تھے جو مدین کے آدمی(حضرت شعیبؑ) کی بیٹی نے اپنے باپ کے پاس جاکر مہربان اجنبی کے لئے استعمال کیے تھے

624
00:47:56,137 --> 00:48:01,685
 جب حضرت موسیٰؑ نے اُن کی بھیڑوں کو پانی پلایا تھا

625
00:48:01,733 --> 00:48:06,325
وہ اپنے والد(حضرت شعیبؑ) کے پاس واپس گئی اور کہنے لگی؛ ابا جان، آپ اس آدمی کو ملازمت کیوں نہیں دیتے؟

626
00:48:06,371 --> 00:48:10,379
کیونکہ ملازمت کے لیے بہترین اور موزوں ترین آدمی وہ ہے، جو طاقتور اور قابل اعتماد ہے

627
00:48:10,410 --> 00:48:17,052
اور اسی طرح حضرت موسیٰؑ کو مدین میں ملازمت مل گئی اور آپؑ دس سال تک وہاں مقیم رہے

628
00:48:17,098 --> 00:48:20,472
تو یہ عورت یا لڑکی اس وقت کم عمر تھی

629
00:48:20,497 --> 00:48:22,465
اس بیان سے اس کی فہم و فراست چھلک رہی تھی

630
00:48:22,483 --> 00:48:24,699
چنانچہ اللہ عَزَّوَجَلْ نے قرآن میں اس کا ذکر کیا ہے

631
00:48:24,738 --> 00:48:28,072
کہ اگر آپ کسی کو ملازمت پر رکھنا چاہتے ہیں تو اس کے دو تقاضے ہیں

632
00:48:28,107 --> 00:48:32,832
یہ وہ چیز ہے جو آپ ایک انٹرویو کے توسط سے تلاش کرتے ہیں، جب آپ کسی کو اپنے لیے کام کرنے کے لیے رکھنا چاہتے ہیں

633
00:48:32,873 --> 00:48:36,222
 کیا وہ مضبوط ہے؟ اور یہاں طاقت کا مطلب جسمانی طاقت نہیں ہے

634
00:48:36,254 --> 00:48:40,525
اس کا مطلب ہے اس مخصوص شعبے میں قابلیت/مہارت ہے

635
00:48:40,550 --> 00:48:42,459
تو کیا آپ کو اپنے شعبے میں عبور حاصل ہے؟

636
00:48:42,497 --> 00:48:44,872
آپ اس مخصوص شعبے میں ماہر ہیں

637
00:48:44,897 --> 00:48:49,165
اگر متعلقہ شعبہ جسمانی طور پہ کام کرنے کا تقاضا کرتا ہے، تو اس شخص کا جسمانی طور پر صحت مند ہونا ضروری ہے

638
00:48:49,206 --> 00:48:54,319
اگر زہنی صلاحیتوں کو بروئے کار لانا اس کام کا تقاضا ہے تو اس شخص کو ذہنی طور پر تندرست اور مضبوط ہونے کی ضرورت ہے

639
00:48:54,354 --> 00:48:58,079
حضرت عمر بن خطابؓ اس کردار کے لیے بہترین شخص تھے

640
00:48:58,105 --> 00:49:03,792
آپؓ بہت ذہین، بہت عقلمند، بہت مضبوط، بہت پرعزم شخصیت کے مالک تھے

641
00:49:03,831 --> 00:49:07,505
آپؓ مضبوط قوتِ ارادی کے مالک تھے، آپؓ فیصلہ سازی کی صلاحیت رکھتے تھے

642
00:49:07,537 --> 00:49:10,505
اورآپؓ کے گردوپیش سے لوگ آپؓ کو عزت وتوقیر کی نگاہ سے دیکھتے تھے

643
00:49:10,537 --> 00:49:14,365
اور اسی لیے حضرت ابوبکر صدیقؓ نے فرمایا؛ میں انھیں(حضرت عمرؓ کو) تمہاری امامت کے لیے مقرر کرنے والا ہوں

644
00:49:14,404 --> 00:49:24,170
حضرت ابوبکر صدیقؓ نے حضرت ابوعبیدہؓ کو حضرت عمرؓ کی بطور خلیفہ تقرری کو تحریر کرنے کے لیے بلایا، پس یہ تحریر لکھ دی گئی

645
00:49:24,211 --> 00:49:27,705
اور پھر مسجد میں اعلان کیا گیا

646
00:49:27,739 --> 00:49:31,919
اور پھر حضرت ابوبکرؓ نے عوام کو حضرت عمر بن خطابؓ کی بیعت  کرنے کا حکم دیا، جب آپؓ حیات تھے

647
00:49:31,966 --> 00:49:36,565
پس حضرت عمرؓ کی بیعت حضرت ابوبکر صدیقؓ کے وصال کے بعد نہیں ہوئی

648
00:49:36,607 --> 00:49:39,159
جیسے ہی حضرت ابوبکر صدیقؓ کا وصال ہوا

649
00:49:39,195 --> 00:49:43,125
حضرت عمر بن خطابؓ نے فوراً خلیفہ کا عہدہ سنبھال لیا

650
00:49:43,156 --> 00:49:53,059
حضرت ابوبکر صدیقؓ کے وصال کے بعد کوئی بیعت نہیں ہوئی، خلیفہ کی تقرری کا عمل آپؓ کے رحلت فرمانے سے پہلے ہی ہوچُکا تھا

651
00:49:53,096 --> 00:50:02,039
حضرت ابوبکر صدیقؓ کی بیماری شدت اختیار کر گئی اور آپؓ کی حالت روز بروز گرتی چلی گئی

652
00:50:02,087 --> 00:50:05,565
حتیٰ کہ آپؓ کی علالت کے پندرہواں دن تھا

653
00:50:05,614 --> 00:50:08,532
تو حضرت ابوبکرؓ نے اپنی بیٹی حضرت عائشہؓ سے دریافت کیا، آپؓ نے پوچھا؛

654
00:50:08,552 --> 00:50:11,812
رسول اللہؐ کا وصال کس دن ہوا تھا؟

655
00:50:11,848 --> 00:50:14,279
حضرت عائشہؓ نے فرمایا؛ آپؐ کا وصال پیر کے دن ہوا تھا،

656
00:50:14,299 --> 00:50:18,039
حضرت ابوبکرؓ نے فرمایا؛ اور آج سوموار ہے

657
00:50:18,075 --> 00:50:23,132
تو مجھے لگتا ہے کہ آج میرا آخری دن ہے

658
00:50:23,157 --> 00:50:26,772
اب یہ ایک بہت ہی دلچسپ بیان ہے

659
00:50:26,797 --> 00:50:31,279
حضرت ابوبکر صدیقؓ ، رسول اللہؐ کی مکمل پیروی کے ہمیشہ خواہشمند رہتے تھے

660
00:50:31,304 --> 00:50:36,939
 آپؓ کی خلافت کا دور اتباع سنت کی ایک زندہ و جاوید مثال ہے

661
00:50:36,964 --> 00:50:41,039
اور آپؓ نے  صرف ان معاملات میں سنت کی پیروی نہیں کی جو معمولی نوعیت کے ہوں

662
00:50:41,076 --> 00:50:46,505
آپؓ ایسے معاملات پر سنت کی پیروی کر رہے تھے جو پورے معاشرے اور آپؓ کی ذات کے لئے خطرے سے خالی نہیں تھی

663
00:50:46,530 --> 00:50:51,501
حضرت اسامہؓ کا لشکر روانہ کرنا کوئی معمولی قدم نہیں تھا

664
00:50:51,526 --> 00:50:54,425
یہ بہت سنگین خطرہ تھا

665
00:50:54,450 --> 00:50:57,645
اور پھر فوج کی قیادت حضرت اُسامہ کو سونپنے پر اصرار کرنا

666
00:50:57,670 --> 00:51:01,059
اور کسی تجربہ کار بالغ سپہ سالار کو مقرر نہ کرنا، آپؓ کی عمر صرف اٹھارہ(18) سال تھی

667
00:51:01,093 --> 00:51:06,445
اور پھر حقیقت یہ ہے کہ آپؓ نے رسول اللہؐ کی طرف سے مقررکردہ عہدہداران کو کبھی تبدیل نہیں کیا

668
00:51:06,465 --> 00:51:07,428
اور اس بات کو یقینی بنایا

669
00:51:07,452 --> 00:51:10,352
إِنَّمَا أَنَا مُتَّبِعٌ وَلَسْتُ بِمُبْتَدِعٍ

670
00:51:10,438 --> 00:51:14,665
کہ میں وہ شخص ہوں جو رسول اللہؐ کی پیروی کروں گا اور میں ایسا آدمی نہیں ہوں جو اختراع کروں

671
00:51:14,690 --> 00:51:18,565
میں رسول اللہؐ کی پیروی کرنے جا رہا ہوں اور میں بدعت پھیلانے والوں میں شامل نہیں گا

672
00:51:18,590 --> 00:51:27,785
آپؓ انتہائی حد تک رسول اللہؐ کی سنت پر عمل کرنے کے خواہاں تھے اور اس پہ ثابت قدم تھے

673
00:51:27,810 --> 00:51:32,299
اور ایسا لگتا ہے کہ آپؓ اپنی موت کے وقت میں بھی سنت رسولؐ کی پیروی کرنا چاہتے تھے

674
00:51:32,324 --> 00:51:37,005
اس لیے آپؓ کو امید تھی کہ وہ اسی دن اس دنیا سے جائیں گے جس دن رسول اللہؐ کا وصال ہوا تھا

675
00:51:37,030 --> 00:51:42,779
اور ایسا ہوا کہ آپؐ کا وصال پیر کو ہوا اور رسول اللہؐ کا وصال پیر کو ہوا تھا

676
00:51:42,804 --> 00:51:47,719
 رسول اللہؐ کا وصال تریسٹھ(63) سال کی عمر میں ہوا اور حضرت ابوبکرؓ کا وصال بھی تریسٹھ(63) سال کی عمر میں ہوا

677
00:51:47,744 --> 00:51:54,085
پس آپؓ اپنی زندگی اور موت کے وقت بھی رسول اللہؐ کی پیروی کر رہے تھے

678
00:51:54,110 --> 00:51:56,932
دنیا میں آپؓ کے آخری الفاظ تھے

679
00:51:56,971 --> 00:51:59,992
تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ

680
00:52:00,424 --> 00:52:06,085
"اے میرے رب مجھے بطور مسلمان دنیا سے اُٹھا اور مجھے صالحین کے ساتھ شامل کرنا"

681
00:52:06,127 --> 00:52:12,639
مجھے مسلمان بنا کر نیک لوگوں میں شامل کر، مجھے اپنے سب سے قریبی دوست حضرت محمدﷺ سے ملوا

682
00:52:12,682 --> 00:52:16,212
اور مجھے اُن صحابہ کرامؓ میں شامل کر دے جو پہلے دنیا سے گزر چُکے ہیں

683
00:52:16,244 --> 00:52:20,539
یہ دنیا میں آپؓ کے آخری الفاظ تھے

684
00:52:20,588 --> 00:52:26,739
آپؓ کا وصال 21 جمادی الآخرۃ، تیرہ(13) ہجری کو ہوا

685
00:52:26,782 --> 00:52:31,919
چنانچہ آپؓ کی خلافت کا عرصہ دوسال، تین ماہ اور دس دن تھا

686
00:52:31,944 --> 00:52:42,205
یہ تمام واقعات، جنگیں، دعوت و تبلیغ، دو سال، تین ماہ اور دس دن کے اندر کیا گیا تھا

687
00:52:42,230 --> 00:52:52,452
حضرت عمر بن خطابؓ کو حضرت ابوبکرصدیقؓ کی نماز جنازہ پڑھانے کا شرف حاصل ہوا

688
00:52:52,485 --> 00:52:57,925
اب جب میں اس منظر کے بارے میں سوچتا ہوں ، نماز جنازہ کا امام مرنے والے کے لیے دعا کرتا ہے

689
00:52:57,976 --> 00:53:04,222
امام دعا کرتا ہے اور امام کے پیچھے ہر شخص میت کے لیے دعا کرتا ہے

690
00:53:04,260 --> 00:53:11,552
تو آپ تصور کر سکتے ہیں کہ حضرت ابوبکر صدیقؓ کو ثوب یعنی سفید کپڑے سے ڈھانپ دیا گیا ہو

691
00:53:11,589 --> 00:53:17,380
 اور حضرت عمر بن خطابؓ، آپؓ کی میت پر نماز جنازہ، اور آپؓ ہی حضرت ابوبکر صدیقؓ کے لیے دعائے مغفرت پڑھا رہے ہوں

692
00:53:17,414 --> 00:53:24,125
یہ حضرت عمرؓ ہیں جو اپنے قریبی دوست حضرت ابو بکر صدیقؓ کے لیے دعا کر رہے ہیں

693
00:53:24,150 --> 00:53:28,665
اللہ عَزَّوَجَلْ سے دعا گو ہیں کہ وہ حضرت ابوبکرؓ کو جنت الفردوس میں اعلیٰ مقام عطا فرمائے(آمین)

694
00:53:28,690 --> 00:53:33,192
اور پھر حضرت عمر بن خطابؓ اور حضرت عثمان بن عفانؓ

695
00:53:33,217 --> 00:53:37,695
اور حضرت طلحہ بن عبیداللہؓ اور حضرت عبدالرحمٰن بن ابو بکرؓ

696
00:53:37,720 --> 00:53:44,792
یہ وہ لوگ تھے جنہوں نے حضرت ابوبکر صدیقؓ کو سپردِ خاک کیا

697
00:53:44,817 --> 00:53:52,812
حضرت ابوبکر صدیقؓ کی قبرمبارک، آپؓ کی صاحبزادی حضرت عائشہؓ کے حجرے میں بنی

698
00:53:52,837 --> 00:53:56,819
حضرت محمدﷺ کے روضہ اطہر کے عین برابر

699
00:53:56,844 --> 00:54:01,884
اور حضرت محمدﷺ کے ادب و توقیر کے پیشِ نظر،

700
00:54:01,904 --> 00:54:10,925
حضرت ابوبکرؓ کا سر، رسول اللہؐ کے شانوں کے برابر رکھا گیا

701
00:54:10,958 --> 00:54:16,519
تو آپؓ کا جسد مبارک رسول اللہؐ کے بلکل ساتھ  نہیں ہے، بلکہ تھوڑا سا نیچے ہٹ کر ہے

702
00:54:16,544 --> 00:54:21,592
 حضرت عبداللہ بن عمرؓ فرماتے ہیں کہ میں تیزی سے آیا، میں آپؓ کے جسدِ مبارک کو لحد میں اُتارنا چاہتا تھا

703
00:54:21,617 --> 00:54:26,199
لیکن میں موقع پہ نہیں پہنچ سکا اور آپؓ کا جسدِ مبارک پہلے ہی نیچے رکھ دیا گیا اور میرے والد نے مجھے بتایا کہ یہ عمل ہو چکا ہے

704
00:54:26,224 --> 00:54:34,015
لیکن جن لوگوں نے یہ آخری رسومات ادا کیں ،اُن میں حضرت عمرؓ، حضرت عثمانؓ، حضرت طلحہؓ، اورحضرت عبدالرحمٰن ابن ابی بکرؓ تھے

705
00:54:34,040 --> 00:54:42,365
حضرت ابوبکر صدیقؓ خلافت کے دو سال تین ماہ اور دس دن میں اِن متفرق امور پر آپؓ کامیاب ہوئے

706
00:54:42,410 --> 00:54:48,045
نمبر ایک، اسلام میں خلافت کے قوانین کا قیام

707
00:54:48,087 --> 00:54:56,659
نمبر دو، پوری دنیا میں دعوتِ توحید پہنچانے کے مشن کا آغاز

708
00:54:56,684 --> 00:55:04,925
کیونکہ حضرت محمد ﷺ کے زمانے میں، دعوت ابھی تک صرف جزیرہ نما عرب تک محدود تھی

709
00:55:04,950 --> 00:55:09,999
اور اس علاقے میں واحد استثناء موتہ اور تبوک تھا

710
00:55:10,024 --> 00:55:15,042
لیکن موتہ اور تبوک کے ساتھ بھی، اگرچہ وہ رومی علاقے میں تھے

711
00:55:15,067 --> 00:55:21,425
لیکن اب بھی شام کے ان جنوبی حصوں میں عرب قبائل آباد تھے

712
00:55:21,455 --> 00:55:33,205
لیکن یہ حضرت ابوبکر صدیقؓ ہی تھے جنہوں نے دنیا کی مختلف قوموں، فارسی، رومی اور ان سے بھی آگے علاقوں میں دعوت کا آغاز کیا

713
00:55:33,237 --> 00:55:43,279
چنانچہ آپؓ مجاہدین اور الدُعاء دونوں کے استاد اور رہنما تھے

714
00:55:43,304 --> 00:55:50,845
آپؓ نے خود کو کبھی فارغ البالی کی عیش نصیب نہ ہونے دی

715
00:55:50,870 --> 00:55:55,159
آپؓ نے اپنے آپ کو کبھی آرام کرنے کی اجازت نہیں دی

716
00:55:55,192 --> 00:56:01,012
اور آپؓ نے کبھی بھی اپنے عہدے سے مالی فائدہ نہ اٹھایا

717
00:56:01,037 --> 00:56:07,659
ہم نے پہلے حضرت ابوبکرؓ کی تنخواہ کے مطالبات اور یہاں تک کہ سودے بازی کے بارے میں بات کی تھی

718
00:56:07,684 --> 00:56:10,735
جب آپؓ نے فرمایا کہ یہ کافی نہیں ہے

719
00:56:10,783 --> 00:56:18,818
 لیکن آپؓ یہ سب اس لئے کر رہے تھے کیونکہ آپؓ کا ایک خاص معیار زندگی تھا کہ آپؓ کو اپنا اور اپنے خاندان کا خیال رکھنا تھا

720
00:56:18,888 --> 00:56:22,232
اس کے علاوہ آپؓ بہت سخی تھے

721
00:56:22,271 --> 00:56:30,279
وصال سے قبل، چونکہ آپؓ کے پاس اپنے کاروبار کی بدولت کچھ باقی ماندہ دولت تھی

722
00:56:30,304 --> 00:56:35,405
خلافت سے پہلے آپؓ کے پاس زمین کا کچھ حصہ بھی تھا

723
00:56:35,448 --> 00:56:39,232
آپؓ نے اپنی بیٹی حضرت عائشہؓ سے فرمایا کہ میں چاہتا ہوں کہ آپ میری جائیداد فروخت کر دو

724
00:56:39,257 --> 00:56:42,705
اور پھر مسلمانوں کے بیت المال میں وہ رقم واپس کرنا

725
00:56:42,730 --> 00:56:47,159
وہ تمام رقم جو میں نے خلیفہ کے طور پر بطور تنخواہ لی تھی

726
00:56:47,184 --> 00:56:51,419
میرے پاس جو رقم ہے، مسلمانوں کے خزانے میں واپس کر دو

727
00:56:51,444 --> 00:56:54,132
جب حضرت عمر بن خطابؓ نے یہ خبر سنی تو فرمایا؛

728
00:56:54,157 --> 00:56:57,272
رحم الله أبا بكر، لقد أتعب من بعده

729
00:56:57,297 --> 00:56:59,005
اللہ ابوبکرؓ پر رحم فرمائے

730
00:56:59,030 --> 00:57:02,415
آپؓ ان لوگوں کے لئے مشکل ہدف قائم کر رہے ہیں، جو آپؓ کے بعد آئیں گے

731
00:57:02,455 --> 00:57:07,592
آپؓ طرزِ حکمرانی کا بلند معیار قائم کر رہے ہیں ، جو ہمارے لیئے برقرار رکھنا بہت مشکل ہو گا

732
00:57:07,631 --> 00:57:10,100
 آپ نے خزانے سے جو پیسے لیے وہ سب واپس کر دیں

733
00:57:10,125 --> 00:57:12,535
حالانکہ یہ آپ کے لیے حلال تھا

734
00:57:12,560 --> 00:57:18,825
 یہ آپ کے شایانِ شان نہیں تھا، یہ اس سے کم تھا جس کے آپؓ حقدار تھے

735
00:57:18,850 --> 00:57:21,430
آپؓ کو پیسے اس لیے ملے کیونکہ آپ کو ایک خاندان کی کفالت کرنی تھی

736
00:57:21,455 --> 00:57:26,279
اور اب چونکہ آپؓ کے پاس پیسہ بچ گیا تھا، اس لیے آپؓ نے وہ رقم مسلم خزانے میں واپس کردی

737
00:57:26,304 --> 00:57:33,785
چنانچہ حضرت ابوبکرؓ نے جو کچھ لیا تھا وہ سب مسلم بیت المال کو واپس کر دیا

738
00:57:33,824 --> 00:57:40,545
صَّلَواةُ وَالسَّلَامُ عَلى سَيِّدِ ألأولين والآخرين محمد إبن عبدالله وَعلى اَلِهِ وَصَحْبِهِ وَسَلِّمْ

739
00:57:40,584 --> 00:57:47,169
سبحانك اللهم وبحمدك نشهد و الله إله إلَّا أنت نستغفرك ونتوب عليك

