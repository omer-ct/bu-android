1
00:00:22,837 --> 00:00:24,483
اَعُوْذُ بِاللهِ مِنَّ الشِّيْطَانِ الرَّجِيْمِ۝

2
00:00:24,543 --> 00:00:26,730
بِسْمِ اللهِ الرَّحْمَانِ الرَّحِيْمَ۝

3
00:00:27,058 --> 00:00:32,782
اَلْحَمْدُ لله  وَالصَّلَاةُ وَالسَّلَامُ عَلى سَيِّدِنَا محمد وَعَلَى اَلِهِ وَصَحْبِهِ وَسَلِّمْ تَسْلِيْمًا كَثِيْرا

4
00:00:33,832 --> 00:00:40,550
ہم نے سیدنا ابو بکر صدیقؓ کے قبولِ اسلام کے بارے میں بات کی

5
00:00:40,597 --> 00:00:42,517
آپؓ کی دعوتِ توحید کے بارے میں بات کی

6
00:00:42,556 --> 00:00:45,683
ہم نے اُن آزمائشوں کے بارے میں بات کی جن سے حضرت ابوبکرؓ گزرے

7
00:00:45,704 --> 00:00:56,367
اب بات اس دور کی ہے، جب رسول اللہؐ نے صحابہ کرامؓ کو مکہ چھوڑنے کی اجازت دے دی

8
00:00:56,407 --> 00:01:02,841
نبی پاکؐ نے صحابہ کو اجازت دی کہ جو بھی مکہ چھوڑ کرحبشہ جانا چاہتا ہے چلا جاۓ

9
00:01:02,896 --> 00:01:10,101
کیونکہ کفار کے مظالم اس حد تک بڑھ چکے تھے کہ برداشت کرنا مشکل ہو رہا تھا

10
00:01:10,173 --> 00:01:13,974
اور تمام صحابہ کرامؓ کے صبرواستقامت کے باوجود مظالم سہنا مشکل ہو گیا

11
00:01:14,027 --> 00:01:17,583
لیکن رسول اللہؐ، صحابہؓ کی آسانی کا کوئی راستہ نکالنا چاہتے تھے

12
00:01:17,607 --> 00:01:25,887
چنانچہ آپؐ نے صحابہ کو حبشہ جانے کی اجازت دے دی اور بہت سے صحابہ نے ہجرت فرمائی

13
00:01:25,907 --> 00:01:32,625
پیچھے رہ جانے والے صحابہ میں حضرت ابوبکر صدیقؓ بھی تھے جو اپنے محبوبؐ کے ساتھ رہنا چاہتے تھے

14
00:01:32,658 --> 00:01:41,717
لیکن پھر حضرت ابوبکرؓ نے فیصلہ کیا کہ انھیں بھی حبشہ جانا چاہئے

15
00:01:41,737 --> 00:01:52,497
چنانچہ آپؓ نے سفر کیا اور مکہ سے باہر کچھ دنوں کی مسافت پہ ایک مقام پر پہنچے

16
00:01:52,567 --> 00:01:55,782
اور حضرت ابو بکرؓ "برق الغماد" نامی جگہ پر پہنچے

17
00:01:55,837 --> 00:02:03,036
 اس جگہ حضرت ابوبکرؓ کی ملاقات "ابن دغنہ"سے ہوئی، جو القارا نامی قبیلے کا سردار تھا

18
00:02:03,078 --> 00:02:08,281
ابن دغنہ نے حضرت ابوبکر صدیقؓ سے پوچھا کہ آپ کہاں جارہے ہو؟

19
00:02:08,301 --> 00:02:11,202
حضرت ابو بکر صدیقؓ نے فرمایا؛

20
00:02:11,255 --> 00:02:18,717
أخرجني قومي فَأريدو أن أخرُجَ في الأرض أسيحو فيها وَأعبُدالله

21
00:02:18,786 --> 00:02:24,456
حضرت ابوبکرؓ نے فرمایا: میری قوم نے مجھے اپنی سرزمین سے نکال دیا ہے

22
00:02:24,516 --> 00:02:29,696
لہذا، میں ہجرت کرنا چاہتا ہوں اور اللہ عَزَّوَجَلْ کی عبادت کرنا چاہتا ہوں

23
00:02:29,747 --> 00:02:32,555
آپؓ نے فرمایا ؛ میں زمین میں سفر کرنے جا رہا ہوں، زمین اللہ کی ہے

24
00:02:32,601 --> 00:02:34,195
ألأرض لله

25
00:02:34,289 --> 00:02:38,195
اور میں اللہ عَزَّوَجَلْ کی عبادت کرنے جا رہا ہوں

26
00:02:38,264 --> 00:02:40,859
ابن دغنہ نے جواب میں کیا کہا؟

27
00:02:40,884 --> 00:02:45,761
اور آپ یاد رکھیں کہ یہ وہ شخص ہے جو مکہ سے نہیں ہے

28
00:02:45,829 --> 00:02:50,773
لیکن وہ حضرت ابوبکرؓ سے واقف ہے، اس نے ابو بکرؓ کے بارے میں سنا ہوا تھا، ابن دغنہ نے کہا؛

29
00:02:50,841 --> 00:02:56,752
يا أبابكر إنَّا مِثلك لا يَخرجُ ولا يُخرج،

30
00:02:57,129 --> 00:03:01,501
فَإنَّك تَكسب المعدوم، وتصل الرحم

31
00:03:01,579 --> 00:03:09,828
وتقرض ضعيف، وتعينو على نوائل بالحق، فاَنَ جعارلَّك

32
00:03:10,168 --> 00:03:19,430
اس نے کہا؛ آپ جیسے عالی مرتبہ شخص کو یہ زیب نہیں دیتا کہ وہ اپنا وطن چھوڑ دے

33
00:03:19,502 --> 00:03:23,140
اور نہ ہی آپؓ کے لیے مناسب ہے کہ آپؓ کو وطن سے نکال دیا جائے

34
00:03:23,201 --> 00:03:30,326
کیونکہ آپؓ ایک ایسے شخص ہیں جو ضرورت مندوں کی مدد کرتے ہیں اور رشتہ داروں کے ساتھ حسن سلوک کرتے ہیں

35
00:03:30,376 --> 00:03:32,879
اور ابن دغنہ نے کہا کہ آپؓ مہمان کے لیے فراخ دل میزبان ہیں

36
00:03:32,944 --> 00:03:37,848
اور آپ غریبوں کی حمایت کرتے ہیں اور آپ ہر نیک مقصد کے لیے کھڑے ہوتے ہیں

37
00:03:37,921 --> 00:03:43,974
اس لیے مکہ واپس جائیں اور میں آپؓ کوامان دوں گا

38
00:03:44,066 --> 00:03:47,454
عرب میں ایک نظام تھا جسے الاجارہ کہتے تھے

39
00:03:47,524 --> 00:03:51,390
جہاں آپ کسی بھی شخص کو امان دے سکتے ہیں

40
00:03:51,460 --> 00:03:57,345
اس نظام کا اصول یہ ہے کہ اگر میں معاشرے یا قبیلے میں بُلند عُہدے پر ہوں اور ایک قبیلے کا سردار ہوں

41
00:03:57,399 --> 00:04:00,665
تو میں کسی کو بھی تحفظ دے سکتا ہوں

42
00:04:00,721 --> 00:04:08,722
اب اصول یہ ہے کہ ؛ میں اس کی خلاف ورزی کی اجازت نہیں دوں گا چاہے اس کے لیے مجھے اپنی جان ہی کیوں نہ دینی پڑے

43
00:04:08,802 --> 00:04:11,661
اس لیے لوگ اجارہ کی تعظیم کرتے تھے

44
00:04:11,695 --> 00:04:18,700
کیونکہ وہ جانتے تھے کہ اگر تحفظ کی خلاف ورزی ہوئی تو خون بہے گا

45
00:04:18,761 --> 00:04:25,813
لہذا، ابن دغنہ کا یہ انداز ظاہر کرتا ہے کہ وہ حضرت ابوبکر صدیقؓ کی کتنی عزت کرتا تھا جبکہ وہ مشرک تھا

46
00:04:25,872 --> 00:04:28,926
میرا مطلب ہے کہ ابن دغنہ مشرک تھا، مسلمان نہیں تھا

47
00:04:28,967 --> 00:04:34,033
لیکن حضرت ابوبکرصدیقؓ کی نیک نامی کا چرچہ تھا اور سب لوگ آپؓ کو جانتے تھے

48
00:04:34,093 --> 00:04:37,999
 اس لیے ابن دغنہ حضرت ابوبکر صدیقؓ کو امان دینے کے لیے تیار تھا

49
00:04:38,023 --> 00:04:47,029
اب یاد رکھیں کہ عام طور پر قریش کے باہر کے لوگ، قریش میں سے کسی فرد کو امان نہیں دے سکتے تھے

50
00:04:47,102 --> 00:04:50,499
کیونکہ قریش کو تمام قبائل میں بلند سمجھا جاتا تھا

51
00:04:50,567 --> 00:04:57,718
اس لیے انہوں نے قریش میں سے کسی کو اجارہ دینا مناسب نہیں سمجھا

52
00:04:57,774 --> 00:05:01,623
لیکن ابن دغنہ یہ خطرہ مول لینے کو تیار تھا

53
00:05:01,674 --> 00:05:04,899
اورابن دغنہ آگے بڑھ کرحضرت ابوبکرؓ کو مکہ لے گیا اور اہلِ قریش کو پکار کر کہنے لگا

54
00:05:04,955 --> 00:05:08,842
"مَیں ابوبکرؓ کو تحفظ دے رہا ہوں"

55
00:05:08,900 --> 00:05:11,848
اب قریش کے لوگ ابن دغنہ کے پاس آئے اور کہنے لگے

56
00:05:11,935 --> 00:05:16,122
اگرچہ ہم آپ کے تحفظ کی خلاف ورزی نہیں کریں گے

57
00:05:16,204 --> 00:05:21,635
اہلِ قریش کہنے لگے ؛ ہم چاہتے ہیں کہ آپ ابوبکرؓ پر یہ شرط رکھیں کہ وہ گھر میں نماز پڑھیں

58
00:05:21,667 --> 00:05:25,710
ہم نہیں چاہتے کہ وہ اپنے گھر کے باہرسرِعام نماز ادا کرے

59
00:05:25,730 --> 00:05:30,683
کیونکہ اگر ابوبکرؓ ایسا کرے گا تو وہ ہماری عورتوں اور ہمارے بچوں کو گمراہ کرے گا

60
00:05:30,746 --> 00:05:36,108
اس لیے ابوبکرؓ کو پابند کریں کہ وہ گھر میں نماز پڑھیں، ہم تمہاری زبان(اِجارہ) کا احترام کریں گے

61
00:05:36,151 --> 00:05:38,638
ابن دغنہ ،حضرت ابوبکرؓ کے پاس گیا اور کہا؛ یہ معاہدہ ہے

62
00:05:38,719 --> 00:05:41,878
 ابوبکرؓ! کیا آپ اس شرط کو قبول کرتے ہیں؟ آپؓ نے فرمایا؛ ہاں میں قبول کرتا ہوں

63
00:05:41,942 --> 00:05:48,330
چنانچہ اب حضرت ابوبکر صدیقؓ گھر میں ہی نماز پڑھتے تھے

64
00:05:48,403 --> 00:05:54,143
کچھ عرصہ گزر گیا، آپ جانتے ہیں کہ یہ حضرت ابوبکر صدیقؓ کی فطرت کے خلاف تھا

65
00:05:54,217 --> 00:06:00,209
میرا مطلب ہے یہ وہی شخصیت ہیں جنہوں نے سب سے پہلے اعلانیہ دعوتِ توحید دینے کی بات کی تھی

66
00:06:00,254 --> 00:06:02,581
 حضرت ابوبکرؓ ہی وہ شخصیت ہیں جو رسول اللہؐ کے پاس گۓ اور فرمایا؛

67
00:06:02,632 --> 00:06:03,235
نَستَعْلَنْ

68
00:06:03,256 --> 00:06:07,322
ہم سرِعام اسلام کا اعلان کرنا چاہتے ہیں

69
00:06:07,376 --> 00:06:13,402
لہٰذا آپؓ کے لیے، گھر میں نماز پڑھنا خلافِ فطرت چیز تھی

70
00:06:13,457 --> 00:06:16,885
 آپؓ ہمیشہ سب کے سامنے سرعام عبادت کرنا چاہتے تھے

71
00:06:16,954 --> 00:06:22,649
چنانچہ حضرت ابوبکرؓ نے فیصلہ کیا کہ ابن دغنہ کے ساتھ جو معاہدہ کیا تھا، اسے نہ توڑا جائے

72
00:06:22,716 --> 00:06:27,511
آپؓ کو اپنے گھر کے صحن میں نماز پڑھنی چاہیئے

73
00:06:27,572 --> 00:06:32,147
تو آپؓ اب بھی گھر کے اندر ہی عبادت کرتے، لیکن آپؓ کو سب باآسانی دیکھ سکتے

74
00:06:32,216 --> 00:06:39,030
چنانچہ اب حضرت ابو بکر صدیقؓ اپنے گھر کے صحن میں نماز پڑھتے

75
00:06:39,075 --> 00:06:43,018
اورحضرت ابو بکر صدیقؓ کے بارے میں کہا گیا ہے کہ آپؓ انتہائی نرم دل تھے

76
00:06:43,043 --> 00:06:48,376
حضرت ابوبکرؓ جب بھی قرآنی آیات کی تلاوت کرتے تو اشکبار ہوجاتے، آنسو گال پر بہہ نکلتے

77
00:06:48,427 --> 00:06:56,449
اور اسی لیے جب رسول اللہؐ نے فرمایا کہ حضرت ابوبکر صدیقؓ سے نماز کی امامت کا کہیں

78
00:06:56,544 --> 00:07:03,606
حضرت عائشہؓ نے فرمایا کہ میرے والد بہت رقیق القلب ہیں اور جب آپؓ نماز پڑھتے تو آبدیدہ ہو جاتے ہیں

79
00:07:03,689 --> 00:07:05,791
 اس لیئے حضرت عمرؓ کو امامت کا کہیں

80
00:07:05,850 --> 00:07:11,663
تو یہ حضرت ابوبکر صدیقؓ کی نماز تھی، آپؓ بہت جلد آبدیدہ ہو جاتے تھے

81
00:07:11,723 --> 00:07:14,870
تو حضرت ابوبکر صدیقؓ اپنے صحن میں نماز پڑھتے

82
00:07:14,890 --> 00:07:21,603
اور تمام بچے اور عورتیں اور جوان جمع ہو کر حضرت ابوبکر صدیقؓ کو نماز پڑھتے ہوئے دیکھتے

83
00:07:21,623 --> 00:07:24,375
 یہ بہت متاثر کن منظر ہوتا تھا

84
00:07:24,432 --> 00:07:29,244
تو قریش کے لوگ غصے میں آ گئے کیونکہ وہ نماز کی سحر انگیز طاقت سے آگاہ تھے

85
00:07:29,325 --> 00:07:35,204
وہ جانتے تھے کہ اگر لوگ کسی کو خشوع و خضوع کے ساتھ نماز پڑھتے ہوۓ دیکھیں گے

86
00:07:35,258 --> 00:07:37,458
تو لوگ اسلام کی طرف راغب ہوں گے

87
00:07:37,506 --> 00:07:39,998
چنانچہ اہلِ قریش، ابن دغنہ کے پاس گئے اور انہوں نے کہا

88
00:07:40,061 --> 00:07:44,208
ہمارا آپ کے ساتھ معاہدہ یہ تھا کہ حضرت ابوبکرؓ سرعام نماز نہیں پڑھیں گے

89
00:07:44,244 --> 00:07:47,036
چنانچہ ابن دغنہ،حضرت ابوبکر صدیقؓ کے پاس گیا اور آپؓ سے کہنے لگا

90
00:07:47,060 --> 00:07:50,942
سنو! قریش کے لوگ آپؓ کو اعلانیہ عبادت کرنے کی اجازت نہیں دیں گے

91
00:07:50,966 --> 00:07:54,026
ابن دغنہ نے کہا؛ تو آپؓ یا تو واپس اپنے کمرے میں نماز پڑھیں

92
00:07:54,098 --> 00:07:56,806
وگرنہ آپ مجھے اپنی حفاظت کے فرض سے بری الذمہ کردیں

93
00:07:56,854 --> 00:07:58,975
حضرت ابوبکر صدیقؓ نے فرمایا؛

94
00:07:59,049 --> 00:08:04,181
میں تمہیں اپنی حفاظت سے بری الذمہ کر رہا ہوں اور میں اللہ کی حفاظت میں خوش ہوں

95
00:08:04,227 --> 00:08:05,931
أرضى بِجَوارالله

96
00:08:06,238 --> 00:08:11,667
میں اللہ عَزَّوَجَلْ کی پناہ میں خوش ہوں

97
00:08:11,772 --> 00:08:16,160
آپ کو یاد ہے کل ہم نے حضرت زنیرہؓ کے لیے اللہ کی طرف سے کی گئی آزمائش پر بات کی تھی

98
00:08:16,222 --> 00:08:19,787
جب اللہ نے حضرت زنیرہؓ کے ایمان کو جانچنے کے لیے آپؓ کی بینائی چھین لی

99
00:08:19,841 --> 00:08:25,797
حضرت ابوبکرؓ کے ساتھ بھی ایسا ہی ہوا جیسے ہی اجارہ ختم ہوا، تحفظ ختم ہو گیا

100
00:08:25,856 --> 00:08:28,666
 اور آپؓ کعبہ کے سامنے سرِعام نماز ادا کرنے گئے

101
00:08:28,721 --> 00:08:36,215
 مشرکینِ قریش میں سے قریش کا ایک جاہل آیا اور اس نے حضرت ابوبکر صدیقؓ کو مارا

102
00:08:36,284 --> 00:08:39,215
چنانچہ حضرت ابوبکر صدیقؓ، ولید بن مغیرہ سے مخاطب ہو کر فرما رہے تھے

103
00:08:39,279 --> 00:08:42,075
کیا تمہیں دکھائی نہیں دیتا کہ یہ جاہل کیا کر رہا ہے؟

104
00:08:42,119 --> 00:08:45,085
مغیرہ نے کہا؛ تم نےخود ہی اس مصیبت کو اپنے اوپر مسلط کیا ہے

105
00:08:45,131 --> 00:08:47,031
حضرت ابوبکر صدیقؓ صرف یہی فرماتے؛

106
00:08:47,090 --> 00:08:50,043
ربي إنك حليم ، ربي ما أحلمك، ربي ما أحلمك

107
00:08:50,067 --> 00:08:53,003
یا اللہ تو بہت مہربان اور نہایت رحم کرنے والا ہے

108
00:08:53,066 --> 00:08:54,926
 آپؓ پر تشدد کیا گیا لیکن آپؓ یہی کہتے رہے‌

109
00:08:54,951 --> 00:08:58,663
اے اللہ، تو بڑا مہربان اور نہایت رحم کرنے والا ہے، الحمدللہ۔

110
00:08:58,742 --> 00:09:00,999
آپ جانتے ہیں کہ ہم ہر بات کے لیے اللہ عَزَّوَجَلْ کی تعریف کرتے ہیں

111
00:09:01,051 --> 00:09:03,912
اگر کچھ اچھا ہوتا ہے تو ہم کہتے ہیں الحمدللہ۔

112
00:09:03,952 --> 00:09:08,654
اگر کچھ برا ہوتا ہے تو ہم کہتے ہیں الحمدللہ، یہ سب اللہ کی طرف سے ہے

113
00:09:08,716 --> 00:09:13,074
ہم اللہ کی مخلوق ہیں، وہ ہمارے ساتھ جو چاہے کرنے کا حق رکھتا ہے

114
00:09:13,142 --> 00:09:19,385
ہم نے حضرت ابوبکر صدیقؓ کے علم کے بارے میں بات کی، جسے فقہ الواقیہ کہتے ہیں، حالات حاضرہ کا علم

115
00:09:19,425 --> 00:09:25,570
 آپؓ مختلف قبائل کی خصوصیات کے بارے میں جانتے تھے

116
00:09:25,616 --> 00:09:33,599
چنانچہ رسول اللہﷺ ،حج کے موقع پر قبائل سے متعارف ہونے کے لیے حضرت ابو بکرؓ کو ساتھ لے کر گئے

117
00:09:33,673 --> 00:09:37,082
کیونکہ اس موقع پر تمام قبائل جمع ہوتے

118
00:09:37,154 --> 00:09:40,856
چنانچہ رسول اللہؐ مختلف قبائل میں تشریف لے جاتے

119
00:09:40,920 --> 00:09:48,516
آپؐ قبائل کو اسلام کی دعوت دیتے اور مسلمانوں کے لیے امان بھی طلب کرتے

120
00:09:48,579 --> 00:09:50,712
اور رسول اللہؐ ایک عرصے تک قبائل سے ملاقات کرتے رہے

121
00:09:50,737 --> 00:09:56,248
رسول اللہﷺ کو اسلام کے لیے ایک مضبوط پناہ گاہ کی تلاش تھی

122
00:09:56,305 --> 00:09:59,346
چنانچہ آپؐ اپنے ساتھ حضرت ابوبکر صدیقؓ کو لے جاتے

123
00:09:59,370 --> 00:10:04,909
اب یہ واقعہ جس کا میں ذکر کرنے جا رہا ہوں وہ حضرت علی بن ابی طالبؓ نے بیان کیا ہے

124
00:10:04,929 --> 00:10:11,474
حضرت علی بن ابی طالبؓ نے فرمایا؛ ہم مختلف قبائل کے عارضی پڑاؤ کا دورہ کر رہے تھے

125
00:10:11,526 --> 00:10:16,809
چنانچہ ہم ایک قبیلہ کے خیموں میں گۓ، حضرت ابوبکر صدیقؓ ترجمان کی حیثیت سے ساتھ تھے

126
00:10:16,876 --> 00:10:21,362
 حضرت ابوبکرؓ گۓ اوراس قبیلے کے افراد سے پوچھا کہ تم کہاں سے ہو؟

127
00:10:21,414 --> 00:10:24,444
انہوں نے کہا؛ ربیعہ سے

128
00:10:24,516 --> 00:10:27,217
آپؓ نے فرمایا؛ ربیعہ کے کس حصے سے؟

129
00:10:27,294 --> 00:10:27,768
وہ کہنے لگے

130
00:10:27,792 --> 00:10:29,637
من هامته العظمى

131
00:10:29,813 --> 00:10:31,936
آپؓ نے پوچھا؛ "هامته العظمى" کے کس حصے سے تعلق رکھتے ہو؟

132
00:10:32,001 --> 00:10:34,943
انہوں نے کہا؛"دهل الاكبر" سے تعلق ہے

133
00:10:35,074 --> 00:10:44,908
ربیعہ عراق کا قبیلہ ہے اور" هامته العظمى" اس کا زیلی قبیلہ ہے

134
00:10:44,982 --> 00:10:47,164
جس کا مطلب ہے عظیم المرتبت پیشانی

135
00:10:47,247 --> 00:10:50,651
اور پھر "دهل الاكبر" کا مطلب ہے، عظیم

136
00:10:50,727 --> 00:10:54,397
تو ایک "دھل" بڑا قبیلہ ہے اور ایک "دهل" چھوٹا قبیلہ ہے

137
00:10:54,441 --> 00:11:01,009
اور ان قبائل کے درمیان بہت کم فرق ہے کیونکہ یہ سب ربیعہ کے ماتحت آتے ہیں

138
00:11:01,068 --> 00:11:03,943
تو انہوں نے کہا ؛ ہم دهل الاكبر سے تعلق رکھتے ہیں

139
00:11:03,997 --> 00:11:08,425
جو ایک قسم کا قابل فخر نام ہے، عظیم دہل (دهل)

140
00:11:08,471 --> 00:11:10,161
حضرت ابوبکر صدیقؓ نے فرمایا؛

141
00:11:10,201 --> 00:11:16,210
اچھا، عوف نامی وہ شخص جس کے بارے میں کہا جاتا یے کہ اس کی وادی میں کوئی فرد آزاد نہیں تھا(اس کےرعب کی بنا پر)

142
00:11:16,270 --> 00:11:18,031
کیا وہ تمہارے قبیلے سے ہے؟

143
00:11:18,105 --> 00:11:19,638
وہ افراد کہنے لگے؛ نہیں

144
00:11:19,682 --> 00:11:22,484
آپؓ نے فرمایا؛ الحوفضان، قاتل الملوک کے بارے میں کیا خیال ہے؟

145
00:11:22,579 --> 00:11:24,437
وہ جو بادشاہوں کو قتل کرتا تھا

146
00:11:24,514 --> 00:11:26,890
آپؓ نے پوچھا ؛ کیا وہ آپ کے قبیلے سے ہے؟ کہنے لگے؛ نہیں

147
00:11:26,948 --> 00:11:29,869
آپؓ نے فرمایا؛ المزدلف صاحب الامام المفردہ کے بارے میں کیا خیال ہے؟

148
00:11:29,907 --> 00:11:32,519
المزدلف، جس کی منفرد پگڑی تھی

149
00:11:32,561 --> 00:11:34,099
کیا وہ آپ کے قبیلے سے تھا؟

150
00:11:34,151 --> 00:11:35,413
کہنے لگے؛ نہیں

151
00:11:35,494 --> 00:11:40,898
آپؓ نے پوچھا ؛ کیا تم کندہ کے سلاطین کے ننھیال سے ہو؟

152
00:11:40,919 --> 00:11:42,073
وہ کہنے لگے؛ نہیں

153
00:11:42,146 --> 00:11:45,657
آپؓ نے پھر فرمایا؛ کیا تم لخم کے بادشاہوں کے رشتہ دار ہو؟

154
00:11:45,734 --> 00:11:47,004
کہنے لگے؛ نہیں

155
00:11:47,042 --> 00:11:48,632
حضرت ابوبکر صدیقؓ نے فرمایا؛

156
00:11:48,678 --> 00:11:51,812
پھر تم بڑے"دهل" سے نہیں ہو، تم چھوٹے "دهل" قبیلے تعلق رکھتے سے ہو

157
00:11:51,866 --> 00:11:55,466
آپ کا تعلق بڑے دهل سے نہیں ہے، آپ کا تعلق چھوٹے دهل قبیلے سے ہے

158
00:11:55,538 --> 00:11:58,016
اور سامعین؛ آپ ان سوالات کو دیکھیں جو آپؓ پوچھ رہے تھے

159
00:11:58,086 --> 00:12:04,315
یہ سوالات حضرت ابوبکرؓ کے علم و دانش کو ظاہر کرتے ہیں

160
00:12:04,399 --> 00:12:06,326
چنانچہ حضرت ابوبکر صدیقؓ اس خیمے کو چھوڑ کر جانے والے تھے

161
00:12:06,351 --> 00:12:11,567
لیکن آپؓ نے ایک نوجوان کو دیکھا جس کی مسیں بھیگ رہی تھیں، ابھی داڑھی نکل رہی تھی

162
00:12:11,641 --> 00:12:14,852
وہ نوجوان حضرت ابوبکرؓ کے پاس آیا اور اس نے آپؓ کے اونٹ  کی مہار پکڑ لی

163
00:12:14,911 --> 00:12:18,022
اور وہ نوجوان کہنے لگا؛ آپؓ نے ہم سے ہمارے بارے میں پوچھا اور ہم نے جواب دیا

164
00:12:18,068 --> 00:12:21,588
اب ہماری باری ہے پوچھنے کی، اور آپؓ جواب دیں

165
00:12:21,629 --> 00:12:23,162
نوجوان نے پوچھا؛ آپؓ کہاں سے ہیں؟

166
00:12:23,225 --> 00:12:26,749
حضرت ابوبکر صدیقؓ نے فرمایا؛ میں قریش سے ہوں

167
00:12:26,811 --> 00:12:32,289
اس نوجوان نے کہا؛ اچھا تو آپ ہمارے پیشوا(سردار) ہیں، میرا مطلب ہے کہ وہ سب قریش کو پہچانتے تھے

168
00:12:32,374 --> 00:12:36,275
پھر نوجوان نے پوچھا؛ آپ قریش کے کس حصے سے ہیں؟ آپؓ نے فرمایا؛ تیم بن مرة سے

169
00:12:36,346 --> 00:12:41,874
قریش میں تیم کو بہت چھوٹا اور کمزور قبیلہ سمجھا جاتا

170
00:12:41,925 --> 00:12:47,364
بنو تیم رسول اللہؐ کے خاندان بنو ہاشم کی طرح بڑا قبیلہ نہیں تھا

171
00:12:47,465 --> 00:12:51,263
یہ حضرت خالد بن ولیدؓ کے قبیلے بنو مخزوم کی طرح بھی بڑا نہیں تھا

172
00:12:51,343 --> 00:12:56,127
یہ عظیم خاندان تھے یا بنو امیہ تھے جو کہ بڑا قبیلہ تھا

173
00:12:56,185 --> 00:13:01,764
لہذا، بنوں تیم تعداد میں بہت کم تھے اور قبائلی معاشرے میں زیادہ تعداد، طاقتور ہونے کی علامت تھی

174
00:13:01,820 --> 00:13:04,601
تو تمیم قریش کی ایک بہت چھوٹی شاخ تھی

175
00:13:04,656 --> 00:13:08,753
پس جب اس نوجوان نےحضرت ابوبکرؓ کو یہ کہتے سنا کہ میں تمیم سے ہوں

176
00:13:08,808 --> 00:13:12,820
اس نوجوان نے کہا، آپ نے نشانہ باز کو بتا دیا ہے کہ کہ کہاں نشانہ لگانا ہے

177
00:13:12,872 --> 00:13:16,336
 نوجوان کہنے لگا اس کا مطلب یہ ہے کہ اب آپ سے سوالات کرنے کا یہ میرا موقع ہے

178
00:13:16,381 --> 00:13:17,443
اُس نوجوان نےحضرت ابوبکرؓ سے پوچھا؟

179
00:13:17,519 --> 00:13:24,182
کہ وہ قصی بن کلاب، جس نے تمام حملہ آوروں کو شکست دی جو مکہ پر حملہ کرنا چاہتے تھے

180
00:13:24,240 --> 00:13:30,525
اور قریش کو باہم قریب لا کر انھیں متحد کیا، اس لیے قصی بن کلاب کو متحد کرنے والا کہا گیا

181
00:13:30,563 --> 00:13:32,809
 کیا قصی بن کلاب آپ کے قبیلے سے تھا؟

182
00:13:32,873 --> 00:13:34,575
حضرت ابوبکرؓ نے کہا؛ نہیں

183
00:13:34,645 --> 00:13:37,064
اس نوجوان نے پھر پوچھا؛ عبد مناف کے متعلق کیا خیال ہے؟

184
00:13:37,129 --> 00:13:41,305
 جس نے سب کچھ اپنے باپ سے وراثت میں حاصل کیا، کیا وہ تمہاری قوم سے تھا؟

185
00:13:41,365 --> 00:13:42,205
 حضرت ابوبکرؓ نے فرمایا؛ نہیں

186
00:13:42,258 --> 00:13:44,628
نوجوان نے پھر پوچھا عمرو بن عبد مناف کے بارے میں کیا خیال ہے؟

187
00:13:44,734 --> 00:13:51,155
وہ جو حاجیوں کی خدمت کے لیے یخنی میں روٹی چورتا تھا اور اسے ہاشم کہا جاتا تھا

188
00:13:51,208 --> 00:13:53,602
 کیا آپؓ اس کے قبیلے کے لوگ ہیں؟ حضرت ابوبکرؓ نے فرمایا؛ نہیں

189
00:13:53,661 --> 00:13:56,984
نوجوان نے پھر سوال کیا؛ شیبة الحمد یعنی عبد المطلب کے بارے میں کیا خیال ہے؟

190
00:13:57,023 --> 00:14:01,251
وہ جو خشکی کے جانوروں کو اور سمندر میں پرندوں کو کھانا کھلاتا تھا

191
00:14:01,317 --> 00:14:05,671
 ، وہ شخص(عبدالمطلب) کہ جس کا چہرہ دیکھو تو اندھیری رات کے چاند جیسا ہے

192
00:14:05,753 --> 00:14:07,414
کیا آپ اس کے خاندان سے ہیں؟

193
00:14:07,454 --> 00:14:09,120
حضرت ابوبکر صدیقؓ نے فرمایا؛ نہیں

194
00:14:09,168 --> 00:14:13,139
اور پھر اس نوجوان نے پوچھا، پھر کیا تم اہل افضاء میں سے ہو، جو حج کا خیال رکھتے ہیں؟

195
00:14:13,203 --> 00:14:14,040
 حضرت ابوبکرؓ نے فرمایا؛ نہیں

196
00:14:14,122 --> 00:14:17,873
اُس نے پھر پوچھا؛ کیا آپ حجابه سے تعلق رکھتے ہیں، جن کے پاس خانہ کعبہ کی کنجی ہے؟

197
00:14:17,943 --> 00:14:18,893
حضرت ابوبکرؓ نے فرمایا؛ نہیں

198
00:14:18,939 --> 00:14:24,153
اُس نوجوان نے پوچھا ؛ کیا آپؓ عمائدینِ قریش کی مشاورتیی کونسل ندوہ سے تعلق رکھتے ہیں؟

199
00:14:24,173 --> 00:14:25,097
حضرت ابوبکرؓ نے فرمایا؛ نہیں

200
00:14:25,117 --> 00:14:27,531
نوجوان نے سوال کیا؛ کیا آپؓ ان لوگوں میں سے ہیں جو حجاج کرام کو پانی فراہم کرتے ہیں؟

201
00:14:27,571 --> 00:14:28,417
حضرت ابوبکرؓ نے فرمایا؛ نہیں

202
00:14:28,437 --> 00:14:30,224
اُس نے پھر پوچھا ؛ کیا آپؓ ان لوگوں میں سے ہیں جو حاجیوں کو کھانا کھلاتے ہیں؟

203
00:14:30,264 --> 00:14:31,197
 آپؓ نے فرمایا؛ نہیں

204
00:14:31,217 --> 00:14:36,763
حضرت ابوبکر صدیقؓ ان تمام سوالات سے پریشان ہو رہے تھے، اس لیے آپؓ ہر سوال کے جواب میں"نہیں" کہنے پر اکتفا کر رہے تھے

205
00:14:36,783 --> 00:14:42,630
چنانچہ، حضرت ابوبکرؓ نے اپنے اونٹ کی مہار کھینچ لی اور اُس نوجوان کو چھوڑ کر آگے بڑھ گۓ

206
00:14:42,650 --> 00:14:45,614
کیونکہ یہ حضرت ابوبکرؓ کو غیر مناسب لگ رہا تھا

207
00:14:45,667 --> 00:14:48,461
تو وہ نوجوان مسکرایا اور کہنے لگا

208
00:14:48,530 --> 00:14:54,653
صدفه در السيلي درًا يدفع فتارةً يذهبه’ وتارةً يصدع

209
00:14:54,691 --> 00:14:56,717
اس نوجوان نے موقع کی مناسبت سے یہ اشعار پڑھے

210
00:14:56,742 --> 00:15:00,540
اس نوجوان نے کہا ؛ آپؓ کا علم و دانش میرے فہم سے اس طرح بڑھ کے ہیں جیسے ایک منہ زور ندی دریا پہ غالب آجاۓ

211
00:15:00,588 --> 00:15:04,245
وہ ندی جو دریا کا سینہ چاک کرے اور پھر اس کا رخ موڑ دے

212
00:15:04,317 --> 00:15:07,359
 وہ نوجوان کہنے لگا آپؓ نے ثابت کیا کہ ہم دہل الاصغر سے ہیں

213
00:15:07,414 --> 00:15:11,581
اور اگر آپؓ ٹھہر جاتے تو میں ثابت کرتا کہ آپکا تعلق کہاں سے ہے؟

214
00:15:11,637 --> 00:15:16,124
رسول اللہؐ نے یہ دیکھا اور مسکراۓ

215
00:15:16,185 --> 00:15:19,807
 حضرت علی بن ابی طالبؓ ، حضرت ابوبکر صدیقؓ کے پاس آئے اور کہا

216
00:15:19,926 --> 00:15:22,418
لقدوقع العرابي منك على باقية

217
00:15:22,481 --> 00:15:26,180
یہ بدو آپؓ کے لیے خفت کا باعث نکلا

218
00:15:26,261 --> 00:15:29,027
حضرت ابوبکر صدیقؓ نے فرمایا؛ ہاں

219
00:15:29,088 --> 00:15:33,914
ہر مسئلے کے ساتھ ایک بڑا مسئلہ ہوتا ہے اور ہمارے مسائل ہماری باتوں سے پیدا ہوتے ہیں

220
00:15:33,964 --> 00:15:38,120
حضرت ابوبکرؓ نے فرمایا کہ پہلے میں نے خود ہی اس مصیبت کو دعوت دی

221
00:15:38,165 --> 00:15:45,149
تو پھر وہ لوگ  دوسرے قبیلے کے خیموں کی طرف چلے گئے

222
00:15:45,229 --> 00:15:49,409
حضرت ابوبکر صدیقؓ نے ان کی طرف اشارہ کیا اور فرمایا؛

223
00:15:49,446 --> 00:15:51,007
هَا أولآء غرورٌ الناس

224
00:15:51,079 --> 00:15:55,298
یہ عظیم لوگ ہیں

225
00:15:55,339 --> 00:15:58,312
تو آئیے ان کے پاس چلتے ہیں

226
00:15:58,326 --> 00:16:00,913
چنانچہ وہ وہاں گئے اور یہ بنو شعیبان کے رہنے والے تھے

227
00:16:00,963 --> 00:16:03,239
بنو شعیبان بھی عراق کے قبیلے ہیں

228
00:16:03,273 --> 00:16:05,783
اور ویسے امام احمد بن حنبل کا تعلق بھی بنوشعیبان سے ہے

229
00:16:05,837 --> 00:16:09,445
امام احمد بن حنبل ألشعیبانی

230
00:16:09,481 --> 00:16:11,699
چنانچہ وہ بنو شعیبان کی طرف چلے گئے

231
00:16:11,740 --> 00:16:15,335
 اور وہاں اس قبیلے کے سردار موجود تھے، مفروق اور ہانی بن قبیسہ

232
00:16:15,368 --> 00:16:19,069
اور النعمان بن شریق  اور مثنى بن حارثه شعيباني

233
00:16:19,133 --> 00:16:23,374
 یہی سردار بعد میں مسلم افواج کے عظیم سپہ سالار بنے

234
00:16:23,454 --> 00:16:27,447
اور پھر دوبارہ بھی حضرت ابوبکرؓ ہی سرداروں سے گفتگو فرمارہے تھے

235
00:16:27,490 --> 00:16:31,256
حضرت محمدﷺ بات چیت نہیں فرماتے،بلکہ آپؓ ان کے ترجمان تھے

236
00:16:31,309 --> 00:16:34,043
آپؓ حضرت محمدﷺ کے ترجمان تھے

237
00:16:34,127 --> 00:16:36,505
چنانچہ حضرت ابوبکر صدیقؓ بنوشعیبان کے سرداروں کے پاس گئے

238
00:16:36,565 --> 00:16:41,612
اور پھرآپؓ نے مفروق سے پوچھا کہ کون آپ کے زیادہ قریب ہے؟

239
00:16:41,683 --> 00:16:47,741
آپؓ نے پھراس سے پوچھا تمہاری جنگی قوت کتنی ہے؟

240
00:16:47,806 --> 00:16:50,401
مفروق نے جواب دیا؛ ایک ہزار

241
00:16:50,473 --> 00:16:54,060
یہ صحرا میں ایک بڑی تعداد تھی

242
00:16:54,136 --> 00:16:54,511
آپؓ نے پھرفرمایا؛

243
00:16:54,561 --> 00:16:56,040
وكيف المنع فيكم

244
00:16:56,196 --> 00:16:58,413
اور آپ کے حفاظتی اقدامات کیسے ہیں؟

245
00:16:58,462 --> 00:17:02,115
 مفروق نےکہا : ہم بہترین حفاظتی تدابیر اختیار کرتے ہیں

246
00:17:02,135 --> 00:17:09,229
حضرت ابوبکرؓ نے پھر اس سے پوچھا، اور تمہارے دشمنوں کے خلاف تمہاری جنگوں کے نتائج کیا ہیں؟

247
00:17:09,281 --> 00:17:12,036
بلکہ درحقیقت آپؓ نے پہلے ایک اور سوال پوچھا تھا

248
00:17:12,101 --> 00:17:14,774
آپؓ نے مفروق سے پوچھا؛ تم جنگ میں کتنے مضبوط ہو؟

249
00:17:14,821 --> 00:17:20,068
مفروق نے جواب دیا کہ ہم اپنے گھوڑوں کو اولاد پر فوقیت دیتے ہیں

250
00:17:20,108 --> 00:17:23,783
اور ہم اپنے ہتھیاروں کو اونٹوں پر ترجیح دیتے ہیں

251
00:17:23,823 --> 00:17:28,369
حضرت ابوبکرؓ نے پوچھا؛ تو تمہارے دشمنوں سے تمہاری جنگوں کا کیا نتیجہ نکلا؟

252
00:17:28,406 --> 00:17:31,658
اس نے کہا؛ اللہ ہی فتح دیتا ہے

253
00:17:31,712 --> 00:17:37,761
مفروق نے کہا؛ کبھی ہم جیت جاتے ہیں،کبھی مات کھا جاتے ہیں

254
00:17:37,833 --> 00:17:45,215
ان سوالوں کی وجہ سے مفروق نے سوچا کہ پوچھنے والا شخص شاید حضرت محمدﷺ ہیں

255
00:17:45,235 --> 00:17:49,501
کیونکہ انہوں نے حضرت محمد ﷺ کے بارے میں سنا تھا اور وہ جانتے تھے کہ آپؐ پناہ کی تلاش میں ہیں

256
00:17:49,558 --> 00:17:52,466
اور یہ تمام سوالات اسی انداز سے پوچھے جا رہے تھے

257
00:17:52,512 --> 00:17:52,903
تو مفروق نے کہا؛

258
00:17:52,924 --> 00:17:54,517
لعلك اخى قريش

259
00:17:54,538 --> 00:17:56,197
کیا تم قریش سے تعلق رکھتے ہو؟

260
00:17:56,245 --> 00:17:58,170
حضرت ابوبکر صدیقؓ نے فرمایا؛

261
00:17:58,224 --> 00:18:03,166
اگر آپ اللہ کے رسول حضرت محمدﷺ کے متعلق استفسار کر رہے ہیں تو آپؐ وہ ہیں

262
00:18:03,235 --> 00:18:05,962
اور آپؓ نے حضرت محمد ﷺ کی طرف اشارہ کیا

263
00:18:06,005 --> 00:18:07,815
اس بات کے جواب میں مفروق نے کہا؛

264
00:18:07,884 --> 00:18:11,558
ہم نے سنا ہے کہ محمدﷺ، اللہ کا رسول ہونے کا دعویٰ کرتے ہیں

265
00:18:11,624 --> 00:18:14,718
 اگرچہ حضرت محمدﷺ کے متعلق انہیں خبر تھی لیکن انہوں نے ابھی تک آپؐ کو نہیں دیکھا تھا

266
00:18:14,777 --> 00:18:21,371
حضرت محمدﷺ کے اعلانِ نبوت کی خبر پورے عراق تک پھیل چکی تھی

267
00:18:21,457 --> 00:18:26,353
چنانچہ اب مفروق، حضرت محمدﷺ کی طرف متوجہ ہوا اورکہا

268
00:18:26,406 --> 00:18:27,783
إلى ماذا تدعو

269
00:18:28,039 --> 00:18:30,490
آپ کا پیغام کیا ہے؟

270
00:18:30,583 --> 00:18:37,683
رسول اللہؐ نے فرمایا؛ میرا پیغام لوگوں کو ایک اللہ کی طرف بُلانا ہے،اللہ کے سوا کوئی عبادت کے لائق نہیں

271
00:18:37,754 --> 00:18:41,767
اور یہ کہ میں اللہ کا رسولؐ ہوں

272
00:18:41,839 --> 00:18:47,361
اور آپؐ نے سورۃ الانعام کی کچھ آیات تلاوت کیں

273
00:18:47,417 --> 00:18:49,188
ان آیات میں اسلام کے اخلاقی قوانین کا زکر تھا

274
00:18:49,212 --> 00:18:52,733
اور ان آیات میں حلال و حرام چیزوں کا فرق واضح کیا گیا

275
00:18:52,786 --> 00:18:56,488
وہ قرآن کی آیات سے بہت متاثر ہوۓ اور مزید تلاوت سننے کی خواہش ظاہر کی

276
00:18:56,541 --> 00:18:59,678
 مفروق نے کہا؛ مجھے مزید بتائیں، تو رسول اللہؓ نے فرمایا

277
00:18:59,702 --> 00:19:02,808
إِنَّ ٱللَّهَ يَأْمُرُ بِٱلْعَدْلِ وَٱلْإِحْسَٰنِ وَإِيتَائِ ذِى ٱلْقُرْبَىٰ

278
00:19:02,975 --> 00:19:08,354
وَيَنْهَىٰ عَنِ ٱلْفَحْشَاءِ وَٱلْمُنكَرِ وَٱلْبَغْىِ ۚ يَعِظُكُمْ لَعَلَّكُمْ تَذَكَّرُونَ

279
00:19:09,079 --> 00:19:14,199
مفروق نے کہا؛ آپؐ کی دعوت ایک بہت عمدہ پیغام ہے

280
00:19:14,257 --> 00:19:22,359
اور جن لوگوں نے آپؐ کے ساتھ برا سلوک کیا وہ واقعی برے لوگ ہیں

281
00:19:22,426 --> 00:19:27,879
 اگر یہ آپؐ کا پیغام ہے تو وہ لوگ جو آپؐ کے خلاف ہیں، برے لوگ ہیں

282
00:19:27,939 --> 00:19:34,318
مفروق قرآنی آیات اور اسلام کے اخلاقی اصولوں سے حق کو پہچان چکا تھا

283
00:19:34,385 --> 00:19:40,348
لیکن پھر بھی مفروق مسلمان ہونے کا فیصلہ اکیلے نہیں کرنا چاہتا تھا کیونکہ اسے مشورہ کرنا تھا

284
00:19:40,418 --> 00:19:46,030
 مفروق نے کہا یہ ہمارے مذہبی پیشوا هاني بن قبيسه ہیں

285
00:19:46,096 --> 00:19:47,790
آپ ان کی رائے کیوں نہیں لیتے؟

286
00:19:47,829 --> 00:19:50,811
تو مفروق نے ھانی کی طرف اشارہ کیا اور رسول اللہؐ سے کہا؛

287
00:19:50,836 --> 00:19:53,096
آپ ان کی رائے کیوں نہیں لیتے؟

288
00:19:53,159 --> 00:19:59,435
هاني بن قبيسه نے کہا؛ ہاں آپؐ جس بات کی دعوت دیتے ہیں، وہ ایک عظیم پیغام ہے

289
00:19:59,485 --> 00:20:06,505
حالانکہ ہمیں یہ زیب نہیں دیتا کہ اس مذہب کو قبول کر کے اس میں شامل ہو جائیں

290
00:20:06,576 --> 00:20:10,197
 صرف ایک ملاقات کی وجہ سے جو ہماری آپؐ سے ہوئی

291
00:20:10,242 --> 00:20:14,419
ھانی بن قبیسہ نے کہا؛ یہ جلد بازی ہے اور یہ نادانی ہے

292
00:20:14,500 --> 00:20:21,430
لیکن ہم واپس جا کر اپنے لوگوں سے مشورہ کریں گے، اور ہم انتظار کریں گے، اور آپ بھی انتظار کریں

293
00:20:21,451 --> 00:20:24,917
لہٰذا ھانی بن قبیسہ نے اسلام کے بارے میں کچھ غلط نہیں کہا، لیکن اس نے کہا؛

294
00:20:24,938 --> 00:20:28,320
یہ ہمارے لیے مناسب نہیں ہے کہ فوراً فیصلہ کر لیں

295
00:20:28,340 --> 00:20:30,941
ہمیں اس کے بارے میں سوچنا ہے، ہمیں اپنے لوگوں سے مشورہ کرنا ہے

296
00:20:30,978 --> 00:20:35,076
ھانی بن قبیسہ نے کہا کہ ہم کچھ سرداروں کو پیچھے گھروں میں چھوڑ کے آۓ ہیں

297
00:20:35,110 --> 00:20:41,265
اور پھر اس نے المثنی بن حارثہ کی طرف توجہ مبذول کی

298
00:20:41,310 --> 00:20:43,632
اور کہا یہ المثنی بن حارثہ ہے

299
00:20:43,698 --> 00:20:46,074
تم وہ کیوں نہیں سنتے جو یہ کہنا چاہتے ہیں؟

300
00:20:46,118 --> 00:20:51,221
تو المثنی بن حارثہ نے کہا؛ میں هانی بن قبیسہ کی بات سے متفق ہوں

301
00:20:51,301 --> 00:20:54,949
کہ آپؐ کی دعوتِ توحید، ایک عظیم پیغام ہے

302
00:20:55,008 --> 00:20:58,132
المثنی بن حارثہ نے کہا ؛ لیکن ہم وہ لوگ ہیں جو دو پروں کے درمیان ہیں

303
00:20:58,202 --> 00:21:00,355
رسول اللہؐ نے فرمایا: وہ کیا ہے؟

304
00:21:00,385 --> 00:21:06,215
 اس نے کہا؛ ہمارے ایک طرف فارس ہے اور ایک طرف عربوں کی سرزمین ہے

305
00:21:06,273 --> 00:21:11,845
  بنو شعیبان سلطنت فارس کی سرحد پر تھے

306
00:21:11,877 --> 00:21:15,159
المثنی بن حارثه نے کہا؛

307
00:21:15,234 --> 00:21:24,669
فارسیوں کے ساتھ ہمارا معاہدہ یہ ہے کہ ہم کسی ایسے شخص کو پناہ نہیں دے سکتے، جس نے جرم کیا ہو

308
00:21:24,729 --> 00:21:29,803
اور میرا خیال ہے کہ آپ جو دعوت دے رہے ہیں، وہ ایسی چیز ہے جو بادشاہوں کو پسند نہیں ہے

309
00:21:29,893 --> 00:21:34,695
سبحان اللہ، ان کی عقل و دانش دیکھیں اور یہ پہلی ملاقات تھی

310
00:21:34,784 --> 00:21:40,815
المثنیٰ نے کہا؛ میرا خیال ہے کہ جو دعوت آپ دے رہے ہیں، یہ دین بادشاہوں کو پسند نہیں ہے

311
00:21:40,907 --> 00:21:45,257
اس لیے ہم آپؐ کو عربوں کی طرف سے تحفظ دینے کا وعدہ کر سکتے ہیں

312
00:21:45,309 --> 00:21:49,374
لیکن ہم آپؐ کو فارسیوں کی طرف سے تحفظ دینے کا وعدہ نہیں کر سکتے

313
00:21:49,443 --> 00:21:55,144
کیونکہ اہلِ فارس معاف نہیں کرتے، یہ ایک سلطنت ہے

314
00:21:55,203 --> 00:21:58,589
المثنیٰ نے کہا؛ اہلِ فارس معاف نہیں کریں گے لیکن اہلِ عرب کے ساتھ لین دین کیا جا سکتا ہے

315
00:21:58,661 --> 00:22:04,176
 عرب ہماری طرح کے قبائل ہیں(اُن کو ذیل کیا جا سکتا ہے) لیکن آپ کو فارسیوں کی طرف سے تحفظ دلانے کا وعدہ نہیں کرسکتے

316
00:22:04,229 --> 00:22:07,401
 تو یہ ادھورا سا معاملہ تھا، یہ کچھ نہ ہونے سے بہتر تھا

317
00:22:07,447 --> 00:22:11,488
مکہ میں رسول اللہؐ کے پاس کوئی تحفظ نہیں تھا وہاں سب کچھ اُنکے خلاف تھا

318
00:22:11,543 --> 00:22:18,662
کم از کم بنوشعیبان، رسول اللہؐ کو صرف اہلِ عرب کی طرف دعوت اور تحفظ دینے کو تیار تھے

319
00:22:18,701 --> 00:22:22,471
لیکن کیا رسول اللہؐ نے اس پیشکش کو قبول کیا یا آپؐ نے انکار کیا؟

320
00:22:22,534 --> 00:22:24,485
رسول اللہؐ نے فرمایا؛

321
00:22:24,537 --> 00:22:26,005
ما أسئل تم الرد

322
00:22:26,116 --> 00:22:30,451
آپ کا جواب بہت اچھا تھا، بہت شائستہ تھا

323
00:22:30,518 --> 00:22:35,091
ولكن الهذالأمر لايقوم إلَّا لِمن أحاطه من كُلِّ جوانب

324
00:22:35,583 --> 00:22:41,907
لیکن یہ ایک ایسا مذہب ہے جو اس وقت تک قائم نہیں رہ سکتا جب تک اسے ایک محفوظ حصار نہ ملے

325
00:22:41,974 --> 00:22:48,595
آپؐ نے فرمایا ؛ یہ ایک ایسا مذہب ہے جو اس وقت تک قائم نہیں ہو سکتا جب تک آپ اسے ہر طرف سے تحفظ فراہم نہ کریں

326
00:22:48,646 --> 00:22:52,262
 مسئلہ یہ ہے کہ اسلام کو قائم کرنے کے لۓ ہر سمت سے محفوظ کرنے کی ضرورت ہے

327
00:22:52,335 --> 00:22:55,596
 یہ نہیں ہو سکتا کہ آپ مجھے صرف ایک سمت سے تحفظ فراہم کریں اور دوسری طرف سے تنہا چھوڑ دیں

328
00:22:55,621 --> 00:22:57,142
ادْخُلُوا فِي السِّلْمِ كَافَّةً

329
00:22:57,179 --> 00:23:02,767
دین اسلام کے معاملات میں آپ لین دین اور کچھ من پسند تعلیمات کا انتخاب نہیں کر سکتے،آپ کو اسلام کو مکمل اپنانا ہوگا

330
00:23:02,816 --> 00:23:06,820
اللہ عز و جل أغنى الشركاء عن الشرك

331
00:23:06,898 --> 00:23:11,507
اللہ عَزَّوَجَلْ، اپنے ساتھ کسی کو شریک نہیں بناتا

332
00:23:11,575 --> 00:23:14,809
 پس اگر تم اللہ کو کچھ دیتے ہو اور کسی اور کو بھی کچھ دیتے ہو

333
00:23:14,834 --> 00:23:17,359
اللہ تعالیٰ اسے ناپسند کرتا ہے

334
00:23:17,422 --> 00:23:21,026
کیونکہ اللہ عَزَّوَجَلْ چاہتا ہے کہ آپ سب کچھ اس کو دے دیں

335
00:23:21,066 --> 00:23:27,748
آپ کا دل اللہ کی محبت سے لبریز ہو اور اس کی رضا پہ چلتا ہو

336
00:23:27,793 --> 00:23:35,134
اس لیے ہم جزوی طور پر اللہ کے لۓ قربانی نہیں دے سکتے، لیکن اللہ کی رضا کے لیۓ ہمیں سب کچھ قربان کرنا ہے

337
00:23:35,166 --> 00:23:37,566
بہرحال یہ گفتگو کا اختتام تھا

338
00:23:37,648 --> 00:23:40,306
تو رسول اللہؐ چلے گئے

339
00:23:40,364 --> 00:23:42,276
حضرت علی بن ابی طالبؓ فرماتے ہیں؛

340
00:23:42,330 --> 00:23:48,831
ولقد رأيت رسول الله صلى الله عليه وسلم سرَّ بما کان من أمري أبي بكر ومعارفته با الناس

341
00:23:48,906 --> 00:23:58,730
اور میں نے دیکھا ہے کہ رسول اللہؐ،حضرت ابوبکر صدیقؓ کے طرز عمل سے اور لوگوں کے بارے میں آپؓ کے باعلم ہونے سے بہت خوش تھے

342
00:23:58,804 --> 00:24:02,617
رسول اللہؐ بہت خوش ہوئے

343
00:24:02,676 --> 00:24:08,365
میں نے اس گفتگو کا حوالہ آپ کو صرف حضرت ابوبکر صدیقؓ کی صلاحیتیوں سے روشناس کروانے کے لیے دیا

344
00:24:08,404 --> 00:24:12,673
جو حضرت ابوبکرؓ کی خداداد صلاحیتیں تھیں

345
00:24:12,719 --> 00:24:20,457
ہمارے سفر کا اگلا حصہ حضرت ابوبکر صدیقؓ کی زندگی کا انتہائی نازک واقعہ ہے

346
00:24:20,515 --> 00:24:25,673
اور یہ امت مسلمہ کی تاریخ کا ایک انتہائی نازک واقعہ بھی ہے

347
00:24:25,714 --> 00:24:28,086
اور وہ ہے ہجرتِ نبویؐ

348
00:24:28,124 --> 00:24:31,370
 اور بخاری شریف میں مذکور ہے کہ حضرت عائشہؓ فرماتی ہیں؛

349
00:24:31,432 --> 00:24:35,303
کہ ایک دن شدید گرم دوپہر میں

350
00:24:35,367 --> 00:24:40,824
ہم نے رسول اللہؐ کو اپنی طرف آتے ہوئے دیکھا کہ آپؐ نے چہرہ ڈھانپ رکھا تھا، آپؐ نقاب پوش تھے

351
00:24:40,889 --> 00:24:46,757
آپؐ نے اپنے عمامہ مبارک سے اپنے چہرے کو ڈھانپ رکھا تھا

352
00:24:46,803 --> 00:24:53,315
اب حضرت عائشہؓ فرماتی ہیں کہ رسول اللہؐ روزانہ ایک یا دو بار ہمارے پاس تشریف لاتے تھے

353
00:24:53,393 --> 00:24:56,648
 لیکن آپؐ کی اس وقت آمد خلافِ معمول تھی کیونکہ یہ دوپہر کا وقت تھا

354
00:24:56,732 --> 00:25:03,687
اور عرب میں گرمی کی وجہ سے لوگ عام طور پر دوپہر کے وقت قیلولہ(تھوڑی دیر سونا) کرتے ہیں

355
00:25:03,736 --> 00:25:10,797
کاروبارِزندگی اس وقت تک رک جاتا جب تک کہ آب و ہوا معتدل نہ ہو جاتی اور پھر لوگ دوبارہ باہر چلے جاتے

356
00:25:10,845 --> 00:25:13,999
چنانچہ یہ وہ وقت تھا جب مکہ کی گلیوں میں کوئی نہیں تھا

357
00:25:14,061 --> 00:25:18,839
اس وقت جب رسول اللہؐ ، حضرت ابوبکر صدیقؓ سے ملنے آۓ اور آپؐ اندر تشریف لاۓ

358
00:25:18,861 --> 00:25:20,581
حضرت عائشہؓ فرماتی ہیں؛

359
00:25:20,663 --> 00:25:22,288
حضرت ابو بکر صدیقؓ نے فرمایا

360
00:25:22,353 --> 00:25:27,100
رسول اللہؐ اس وقت نہیں تشریف لاتے جب تک کوئی اہم بات نہ ہو

361
00:25:27,165 --> 00:25:27,874
أمرٌ جلاً

362
00:25:28,296 --> 00:25:29,864
کوئی سنجیدہ معاملہ درپیش ہے

363
00:25:29,939 --> 00:25:32,306
چنانچہ آپؓ رسول اللہؐ سے ملنے گۓ، رسول اللہؐ نے فرمایا؛

364
00:25:32,359 --> 00:25:33,433
أخرج ما عندك

365
00:25:33,775 --> 00:25:35,786
اپنے اہل وایال کو باہر نکلنےک ابولیں

366
00:25:35,844 --> 00:25:41,219
رسول اللہؐ کا سفر خفیہ تھا اور آپؐ چاہتے تھے کہ گھرخالی رہے

367
00:25:41,278 --> 00:25:42,897
حضرت ابوبکر صدیقؓ نے فرمایا

368
00:25:42,975 --> 00:25:44,381
إنَّما هم أهلك

369
00:25:44,643 --> 00:25:48,838
یہ آپؐ کا ہی خاندان ہے

370
00:25:48,943 --> 00:25:52,581
میرے گھر میں  آپؐ کا اپنا خاندان ہے

371
00:25:52,663 --> 00:25:59,644
اِنہیں اپنا خاندان سمجھیں اور آپؐ کا راز اِن کا راز ہے

372
00:25:59,710 --> 00:26:05,953
رسول اللہؐ نے فرمایا؛ مجھے مدینہ کی طرف ہجرت کا حکم ملا ہے

373
00:26:06,018 --> 00:26:08,176
حضرت ابوبکر صدیقؓ نے سب سے پہلی بات یہی کہی

374
00:26:08,288 --> 00:26:09,346
أصُّحبه

375
00:26:10,336 --> 00:26:12,783
کیا میں آپ کا ہمسفر بنوں گا؟

376
00:26:12,856 --> 00:26:15,537
رسول اللہؐ نے فرمایا؛ ہاں

377
00:26:15,631 --> 00:26:25,036
حضرت عائشہؓ فرماتی ہیں کہ میں نے کبھی کسی آدمی کو خوشی سے روتے نہیں دیکھا جیسے اس دن اپنے والد کو روتے دیکھا

378
00:26:25,100 --> 00:26:27,918
حضرت ابوبکر صدیقؓ کیوں روئے؟

379
00:26:27,992 --> 00:26:31,705
کیا آپ(سامعین) اس سفر کے مضمرات سے آگاہ ہیں؟

380
00:26:31,778 --> 00:26:34,950
یہ ایک ایسا سفر ہے جہاں آپ اپنی جان کو خطرے میں ڈال رہے ہیں

381
00:26:35,001 --> 00:26:40,623
 کم سے کم سزا کیا ہے؟اگر آپ اس سفر میں رسول اللہؐ کے ساتھ گرفتار ہوجائیں

382
00:26:40,689 --> 00:26:45,170
 سب سے کم سزا پھانسی ہے

383
00:26:45,248 --> 00:26:46,993
تو حضرت ابوبکرؓ کیوں خوش ہوئے؟

384
00:26:47,046 --> 00:26:49,466
آپ کو کوئی تحفظ نہیں

385
00:26:49,539 --> 00:26:54,429
کیونکہ آپ جانتے ہیں کہ قریش آپ کی تلاش کے لیے سب کو فوراً حرکت میں لانے کی صلاحیت رکھتے ہیں

386
00:26:54,504 --> 00:26:58,309
اِس سفر میں تحفظ کے امکانات بہت کم ہیں کے

387
00:26:58,342 --> 00:27:05,371
  یہ بہت ہمت کی بات ہوتی اگر آپؓ اس سفر میں آپؐ کا ساتھ دینے کی حامی بھر لیتے اور فرماتے؛ اچھا میں آپؐ کے ساتھ جاؤں گا

388
00:27:05,432 --> 00:27:09,150
 یہ بذات خود ایک بہت بڑی سعادت تھی

389
00:27:09,190 --> 00:27:15,410
اور آپؓ کا صرف اس سفرِمبارک پر راضی ہوجانا کافی نہیں تھا لیکن اس قدر خوش ہوئے کہ وہ رسول اللہؐ کے ساتھ جارہے ہیں کہ خوشی سے آپؓ کے آنسو جاری ہوگئے

390
00:27:15,463 --> 00:27:18,076
یہ ایک ایسا ردِعمل ہےِ ، جس کی گہرائی تک پہنچنا ناممکن ہے

391
00:27:18,144 --> 00:27:22,835
آپ کو اگلے چند گھنٹوں میں قتل کیا جا سکتا ہے آپ مر سکتے ہیں

392
00:27:22,896 --> 00:27:26,048
لیکن حضرت ابوبکرصدیقؓ بہت خوش تھے، کہ خوشی سے آپؓ کے آنسو تھم نہیں رہے تھے

393
00:27:26,078 --> 00:27:28,858
کیونکہ دیکھیں حضرت ابوبکر صدیقؓ اس سفر میں ساتھ رہنے کو کس انداز سے دیکھتے ہیں

394
00:27:28,917 --> 00:27:39,780
حضرت ابوبکر صدیقؓ نے دیکھا کہ یہ ان کے لیے رسول اللہؐ کے ساتھ بغیر کسی تیسرے شخص کی موجودگی کے گیارہ دن گزارنے کا موقع ہے

395
00:27:39,810 --> 00:27:42,263
  آپؓ اور اللہ کے رسولؐ یہ وقت اکٹھا گزاریں گے،

396
00:27:42,330 --> 00:27:48,002
 آپؓ کے لیے گیارہ دن نبوت کے چشمے سے فیضیاب ہونے کے لیے خاص الخاص تھے

397
00:27:48,025 --> 00:27:57,441
یہ گیارہ دن حضرت ابوبکرؓ نے رسول اللہؐ کےساتھ سارا وقت بغیر مداخلت کے گزارنے تھے

398
00:27:57,495 --> 00:28:01,504
اس لیے حضرت ابو بکر صدیقؓ بہت خوش تھے

399
00:28:01,562 --> 00:28:04,201
حضرت ابوبکر صدیقؓ نے فرمایا؛

400
00:28:04,252 --> 00:28:06,576
 "یا رسول اللہؐ میرے پاس دو اونٹ تیار ہیں"

401
00:28:06,641 --> 00:28:10,770
حضرت ابوبکر صدیقؓ نے اس مقصد کے لیے پہلے ہی دو اونٹ تیار کر رکھے تھے

402
00:28:10,808 --> 00:28:20,132
چنانچہ انہوں نے بنودیل سے ایک غیرمسلم راہ نورد عبداللہ ابن عریقت کی خدمات حاصل کیں

403
00:28:20,138 --> 00:28:30,154
اور انہوں نے تین دن بعد مکہ کے جنوب میں غارثور کے مقام پر اس ملاقات کا وقت متعین کیا

404
00:28:30,197 --> 00:28:39,819
چنانچہ رات کو مقررہ وقت پر رسول اللہؐ اورحضرت ابوبکرؓ، حضرت ابوبکر صدیقؓ کے گھر کے پچھلے دروازے سے نکلے

405
00:28:39,879 --> 00:28:44,406
 انہوں نے مدینہ کے شمالی رستے کو انتخاب کرنے کے بجائے جنوبی رستے کا انتخاب کیا

406
00:28:44,445 --> 00:28:48,913
اور دونوں اصحاب نے غارِثور میں خفیہ قیام کیا

407
00:28:48,956 --> 00:28:59,071
اب فوراً ہی قریش نے ہرسمت آپ دونوں کی تلاش کے لیے تگ و دو کرنا شروع کر دی

408
00:28:59,124 --> 00:29:04,212
اور اہلِ قریش آپ دونوں کی گرفتاری کے لیے اپنی ساری قوت بروۓکار لے آۓ

409
00:29:04,254 --> 00:29:11,786
حضرت محمدﷺ  اورحضرت ابوبکر صدیقؓ کی تلاش میں

410
00:29:11,847 --> 00:29:17,478
قریش کے لوگ پہلے ہی حضرت محمدﷺ کے خلاف سازش تیار کر چکے تھے

411
00:29:17,503 --> 00:29:21,095
کیونکہ وہ جانتے تھے کہ نبیؐ کی ہجرت ناگزیر ہوچکی ہے، ہجرت کا وقت قریب ہے

412
00:29:21,161 --> 00:29:26,815
چنانچہ تمام کفار ایک مجلس میں موجود تھے اور وہ مشاورت کر رہے تھے کہ محمد ﷺ کے ساتھ کیا سلوک کیا جائے

413
00:29:26,871 --> 00:29:30,523
چنانچہ شیطان کفار کے پاس ایک آدمی کی شکل میں آیا اور وہ ان کے ساتھ بیٹھ گیا

414
00:29:30,570 --> 00:29:34,157
تو کفار میں سے ایک نے کہا؛ میرا خیال ہے کہ ہمیں محمدﷺکو قید کر دینا چاہیۓ

415
00:29:34,210 --> 00:29:38,010
تو شیطان نے اپنی راۓ دی اور کہا؛ نہیں! یہ نہ کرو ، ابلیس نے کہا؛ نہیں

416
00:29:38,076 --> 00:29:43,180
محمد (ﷺ) قید خانے سے خطوط کے زریعے اپنی تعلیمات بھیجے گا اور اس کے لوگ اس کا پیغام پھیلائیں گے

417
00:29:43,209 --> 00:29:47,689
اور آخر کار وہ اسے بچانے آئیں گے، یہ اچھا حل نہیں ہے

418
00:29:47,730 --> 00:29:52,081
دوسرے مشرک نے مشورہ دیا اور کہا؛ اچھا میرا خیال ہے کہ ہمیں اسے جلاوطن کر دینا چاہیے

419
00:29:52,111 --> 00:29:57,184
ابلیس نے کہا؛ نہیں! محمدﷺ کی گفتگو متاثرکُن ہے

420
00:29:57,237 --> 00:30:02,669
  انہیں کہیں اور پیروکار مل جائیں گے اور پھر وہ آکر آپ پر حملہ کریں گے

421
00:30:02,710 --> 00:30:04,716
تمہارے پاس اور کیا تجویز ہے؟

422
00:30:04,775 --> 00:30:08,522
اور اب ابوجہل کی تجویز دینے کی باری تھی

423
00:30:08,586 --> 00:30:17,167
تو ابوجہل نے کہا؛ اچھا میرا خیال ہے کہ ہمیں ہر قبیلہ سے ایک بہادر آدمی منتخب کرنا چاہیے

424
00:30:17,235 --> 00:30:22,665
اور تمام نوجوان بیک وقت محمدﷺ پر حملہ کریں

425
00:30:22,739 --> 00:30:29,131
پس جب (معازاللہ)محمدﷺ کو قتل کر دیا جاۓ گا تو اُن ک اخون تمام قریش کے قبائل میں تقسیم ہو جاۓ گا

426
00:30:29,197 --> 00:30:33,615
 اس لیے بنو ہاشم کے لیے محمدﷺ کے خون کا بدلہ لینا ناممکن ہو جاۓ گا

427
00:30:33,655 --> 00:30:36,177
 کیونکہ بدلہ لینے کے لۓ بنو ہاشم کو تمام قبائل سے جنگ کرنی پڑے گی

428
00:30:36,248 --> 00:30:41,571
ابلیس نے کہا؛ بس! یہ بہترین تجویز ہے، آپ کو اس پر عمل کرنا چاہیے

429
00:30:41,617 --> 00:30:42,487
چنانچہ اللہ تعالیٰ کا ارشاد ہے؛

430
00:30:42,512 --> 00:30:47,499
وَإِذْ يَمْكُرُ بِكَ الَّذِينَ كَفَرُوا لِيُثْبِتُوكَ أَوْ يَقْتُلُوكَ أَوْ يُخْرِجُوكَ

431
00:30:47,591 --> 00:30:51,580
وَيَمْكُرُونَ وَيَمْكُرُ اللَّهُ وَاللَّهُ خَيْرُ الْمَاكِرِينَ۝

432
00:30:51,702 --> 00:30:57,548
ترجمہ:"کہ اہل کفر، یعنی قریش مکروفریب کے جال بُن رہے ہیں، تمہارے خلاف سازشیں کر رہے ہیں

433
00:30:57,611 --> 00:31:04,323
 یا تو آپؐ کو قید کر دیں، یا آپؐ کو مار ڈالیں(معاذاللہ) یا آپؐ کو جلاوطن کر دیں

434
00:31:04,355 --> 00:31:09,790
 وہ تدبیر کر رہے تھے اور اللہ بھی تدبیر کر رہا تھا اور اللہ بہترین تدبیر کرنے والا ہے"

435
00:31:09,848 --> 00:31:13,256
چنانچہ حضرت محمدﷺ اورحضرت ابوبکرؓ غارثور میں ٹھہرے ہوۓ تھے

436
00:31:13,306 --> 00:31:19,396
جب کہ آپ دونوں کی تلاش کی کوششیں بڑے پیمانے پر ہر طرف جاری تھیں

437
00:31:19,449 --> 00:31:28,616
اور کفار غضبناک ہو کر ہر طرف حضرت محمدﷺ اور حضرت ابوبکرؓ کو تلاش کر رہے تھے

438
00:31:28,708 --> 00:31:33,368
اور آپ کو دکھانے کے لیے کہ یہ تلاش کتنی وسیع تھی، آپ دیکھیں

439
00:31:33,459 --> 00:31:37,481
کفارِمکہ کے جنوب میں واقع غارِثور تک جا پہنچے

440
00:31:37,542 --> 00:31:39,360
اب مدینہ،مکہ کے شمال میں ہے

441
00:31:39,412 --> 00:31:41,264
لیکن وہ ہر سمت دیکھ رہے تھے

442
00:31:41,294 --> 00:31:46,007
 اور یہ ظاہر کرتا ہے کہ کفار کوئی کسر نہیں چھوڑیں گے

443
00:31:46,072 --> 00:31:50,489
کفار، حضرت محمدﷺ اورحضرت ابوبکرؓ کو ہر طرف ڈھونڈتے پھرتے تھے

444
00:31:50,550 --> 00:32:01,434
وہ غارِ ثور تک پہنچے اور تقریباً حضرت محمد ﷺ اور حضرت ابوبکرؓ کے سر پر پہنچ گۓ

445
00:32:01,507 --> 00:32:05,870
تو حضرت ابوبکر صدیقؓ ان کو دیکھ رہے تھے اور آپؓ کفار کے پاؤں دیکھ رہے تھے

446
00:32:05,934 --> 00:32:09,443
اور آپؓ نے حضرت محمدﷺ سے سرگوشی کی اور کہا؛

447
00:32:09,519 --> 00:32:17,542
یا رسول اللہؐ اگر کفار میں سے کوئی نیچے اپنے پاؤں کی طرف دیکھے تو ہم ان کی نظر میں آجائیں گے

448
00:32:17,585 --> 00:32:21,976
 رسول اللہؐ نے فرمایا؛ اے ابوبکرؓ

449
00:32:22,044 --> 00:32:26,730
ہم دو ہیں اور ہمارے ساتھ تیسرا آسرا اللہ کا ہے

450
00:32:26,796 --> 00:32:31,837
ہم دو ہیں اور ہمارے ساتھ تیسرا اللہ ہے

451
00:32:31,893 --> 00:32:33,502
اور اسی وقت اللہ تعالیٰ نے وحی نازل فرمائی؛

452
00:32:33,606 --> 00:32:40,036
إِلَّا تَنصُرُوهُ فَقَدْ نَصَرَهُ ٱللَّهُ إِذْ أَخْرَجَهُ ٱلَّذِينَ كَفَرُواْ ثَانِىَ ٱثْنَيْنِ إِذْ هُمَا فِى ٱلْغَارِ

453
00:32:40,066 --> 00:32:44,685
 إِذْ يَقُولُ لِصَٰحِبِهِۦ لَا تَحْزَنْ إِنَّ ٱللَّهَ مَعَنَا

454
00:32:44,748 --> 00:32:50,685
آیت کا ترجمہ ہے،" اگر تم اس(آپؐ) کی مدد نہ کرتے تو اللہ پہلے ہی آپؐ کی مدد کر چکا ہے"

455
00:32:50,752 --> 00:32:57,665
جب کافروں نے انہیں اُن کے وطن سے نکال دیا تھا ، جب یہ دو میں سے دوسرے تھے ، دونوں غار میں تھے

456
00:32:57,795 --> 00:32:59,697
اور آپؐ نے اپنے ساتھی ابوبکرؓ سے کہا

457
00:32:59,766 --> 00:33:05,690
چنانچہ حضرت ابوبکر صدیقؓ کا ذکر قرآن میں بطور صحابی آیا ہے

458
00:33:05,748 --> 00:33:08,786
اللہ نے آپؓ کو "الصاحب" یا صاحبہ کا نام دیا ہے

459
00:33:08,827 --> 00:33:14,509
آپؐ نے اپنے ساتھی ابوبکرؓ سے فرمایا کہ غم نہ کرو، بے شک اللہ ہمارے ساتھ ہے

460
00:33:14,547 --> 00:33:19,842
اور اللہ نے ان پر سکینہ نازل کی اور اُن سپاہیوں سے ان کی مدد کی، جسے تم نہیں دیکھ سکتے

461
00:33:19,902 --> 00:33:22,552
 اور کافروں کی باتوں کو پست بنا دیا

462
00:33:22,597 --> 00:33:27,032
جبکہ اللہ کا کلام جو سب سے بلند ہے اور اللہ غالب اور حکمت والا ہے

463
00:33:27,098 --> 00:33:28,473
وَأَيَّدَهُ بِجُنُودٍ لَمْ تَرَوْهَا

464
00:33:28,498 --> 00:33:31,782
اللہ سبحانہ وتعالی نےایسے سپاہیوں کے زریعے حضرت محمدﷺ کی مدد کی جنہیں آپ دیکھ نہیں پاۓ

465
00:33:31,839 --> 00:33:33,442
یہ کیسے سپاہی تھے؟ والله اعلم

466
00:33:33,490 --> 00:33:38,241
لیکن ان میں سے ایک مکڑی ہو سکتی ہے

467
00:33:38,317 --> 00:33:44,758
اس سلسلے میں کبوتر کی کہانی ہے لیکن یہ ضعیف روایت ہے، مکڑی کی کہانی اس سے زیادہ مضبوط ہے

468
00:33:44,811 --> 00:33:49,731
قریش کے لوگ غار کے دہانے تک پہنچ گئے

469
00:33:49,776 --> 00:33:54,761
اور وہ اندر جانے ہی والے تھے، لیکن کسی مشرک نے انہیں کہا کہ نہیں، نہیں، نہیں اندر مت جاؤ

470
00:33:54,812 --> 00:33:57,707
غار کے دہانے پر مکڑی کا جالا ہے

471
00:33:57,754 --> 00:34:03,266
اگر وہاں کوئی ہوتا تو مکڑی کا جالا پھٹ جاتا

472
00:34:03,331 --> 00:34:17,486
اس لیے اس کمزور، معمولی نازک مکڑی کے جالے نے اللہ کے دشمنوں کو حضرت محمدﷺ اورحضرت ابوبکرؓ سے دور رکھا

473
00:34:17,532 --> 00:34:20,536
اللہ کا سپاہی کوئی بھی ہو سکتا ہے

474
00:34:20,593 --> 00:34:23,985
پانی اللہ کا سپاہی ہو سکتا ہے، جس میں فرعون غرق ہوا

475
00:34:24,029 --> 00:34:28,092
مچھر اللہ کا سپاہی ہو سکتا ہے جس نے نمرود کو غارت کیا

476
00:34:28,137 --> 00:34:31,802
زمین اللہ کی سپاہی ہو سکتی ہے، جو قارون کو نگل گئی

477
00:34:31,864 --> 00:34:35,082
ہوا اللہ کی سپاہی ہو سکتی ہے اس نے قومِ عاد کو تباہ کر دیا

478
00:34:35,149 --> 00:34:42,158
بجلی اللہ کا سپاہی ہو سکتی ہے، اپنی کڑک اور آواز سے اس نے قومِ ثمود کو تباہ کر دیا

479
00:34:42,209 --> 00:34:43,986
وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ

480
00:34:44,011 --> 00:34:46,811
اور آپ کے رب کے لشکروں کو اس کی اپنی ذات کے سوا کوئی نہیں جانتا

481
00:34:46,887 --> 00:34:51,247
مکڑی کے جالے نے غار کے داخلی راستے کو کفار کے لئے بند کر دیا

482
00:34:51,310 --> 00:34:54,561
اگر آپ کے پاس کنکریٹ کی دیوار ہوتی تو وہ اسے توڑ دیتے

483
00:34:54,601 --> 00:34:58,201
لیکن مکڑی کے جالے نے انہیں اندر جانے سے روک دیا

484
00:34:58,260 --> 00:35:00,894
تو یہ آپ کے ہتھیار اور طاقت نہیں ہے

485
00:35:00,936 --> 00:35:06,848
یہ اللہ عزوجل کی قدرت اور اس کی حکمت ہے

486
00:35:06,908 --> 00:35:10,770
تین دن بعد عبداللہ بن عریقت آئے

487
00:35:10,835 --> 00:35:15,119
اب ان تین دنوں میں ، وہ کیسے زندہ رہے؟

488
00:35:15,177 --> 00:35:22,465
حضرت عامر بن فہیرہؓ اپنی بھیڑ بکریوں کو ریگستان میں چرانے جاتے تھے

489
00:35:22,513 --> 00:35:27,721
اور پھر وہ غار کے پاس سے گزرتے، تاکہ بکریوں کا دودھ آپؐ اور حضرت ابوبکرؓ کو پہنچا سکیں

490
00:35:27,756 --> 00:35:31,955
اورعامر بن فہیرہ پر کسی کو شک نہیں تھا کیونکہ وہ صحرائی چرواہا تھا

491
00:35:32,023 --> 00:35:35,648
حضرت اسماء بنت ابوبکرؓ ان کے لیے کھانا لاتی تھیں

492
00:35:35,705 --> 00:35:38,717
اور آپؓ کو" ذات النطاقین" کہا جاتا تھا جیسا کہ ہم نے پہلے ذکر کیا

493
00:35:38,817 --> 00:35:44,031
حضرت عبداللہ بن ابوبکرؓ اورحضرت ابوبکر صدیقؓ کے خاندان کو دیکھیں

494
00:35:44,077 --> 00:35:45,930
ان سب نے اس موقع پر آپؐ کی مدد کی

495
00:35:45,989 --> 00:35:51,263
حضرت عبداللہ بن ابوبکرؓ دن کا وقت مکہ میں ایک مجلس سے دوسری مجلس میں گزارتے تھے

496
00:35:51,343 --> 00:35:56,107
 آپؓ ایک جاسوس کی طرح تمام معلومات اکٹھی کرتے اور رات کو ساری خبریں اپنے والد اور رسولؐ کے گوش گزارتے

497
00:35:56,175 --> 00:35:58,442
تو آپؓ حضرت محمدﷺ اور حضرت ابوبکرؓ کے ساتھ رات گزارتے

498
00:35:58,482 --> 00:36:03,265
اب چونکہ صحرا کے لوگ قدموں کے نشانات سے کھوج لگانے میں ماہر ہوتے ہیں

499
00:36:03,328 --> 00:36:06,625
اور وہ عبداللہ بن ابو بکرؓ کے قدموں کے نشانات سے حضرت ابوبکرؓ اور رسولؐ کا کھوج لگا سکتے تھے

500
00:36:06,670 --> 00:36:10,204
 اس لیے عامر بن فہیرہؓ اپنی بھیڑیں لے کر حضرت عبداللہ ؓ کے پیچھے پیچھے چلتے

501
00:36:10,258 --> 00:36:13,110
تاکہ، ان کے قدموں کے نشان مٹ جائیں

502
00:36:13,161 --> 00:36:20,097
اور ایک مکمل منصوبہ بندی کے تحت وہ غار کی طرف جاتے اور واپسی پر بھی ایسے ہی سفر کرتے

503
00:36:20,147 --> 00:36:30,210
تین دن بعد عبداللہ الدیلی بن عریقت، ایک غیر مسلم راہ نورد، دو اونٹ لاۓ جنہیں حضرت ابوبکر صدیقؓ نے پالا یا تیار کیا تھا

504
00:36:30,273 --> 00:36:36,709
 اور آپؐ اور حضرت ابوبکرؓ نے روایتی راستے کی بجاۓ ساحلی پٹی کے ساتھ سفر کا آغاز کیا

505
00:36:36,729 --> 00:36:42,597
اور وہ عبداللہ بن عریقت کے بغیر اس راستے پر سفر نہیں کر سکتے تھے کیوں کے انہیں اس راستے کا علم نہیں تھا

506
00:36:42,650 --> 00:36:45,687
چنانچہ عبداللہ بن عریقت دونوں شخصیات کو اس راستے سے لے کر گیا

507
00:36:45,742 --> 00:36:49,142
اور ویسے ہجرت کا یہ سفر سخت گرمی میں کیا گیا

508
00:36:49,204 --> 00:36:51,222
 جب موسم شدید گرم تھا

509
00:36:51,297 --> 00:36:55,562
چنانچہ رسول اللہؐ اور حضرت ابوبکرؓ رات کو سفر کرتے اور دن کو آرام کرتے

510
00:36:55,630 --> 00:36:58,615
اب اہل مدینہ کا جزبہ دیکھیں

511
00:36:58,686 --> 00:37:02,494
سبحان اللہ، جب اہل مکہ رسول اللہؐ کو اپنے علاقے سے نکال باہر کرنا چاہتے تھے

512
00:37:02,542 --> 00:37:06,334
اور دوسری طرف اہل مدینہ حضرت محمدﷺ کا بے تابی سے انتظار کر رہے تھے

513
00:37:06,380 --> 00:37:14,194
اہلِ مدینہ ، روزانہ شہر کے باہر داخلی راستے پر حضرت محمدﷺ کا انتظار کرتے

514
00:37:14,241 --> 00:37:17,081
اور یہاں تک کہ گرمی کی شدت اہلِ مدینہ کے لیے ناقابلِ برداشت ہوجاتی تب وہ واپس چلے جاتے

515
00:37:17,131 --> 00:37:20,492
وہ لوگ ہر روز فجر کے بعد شہر سے باہرجاتے اور چند گھنٹوں تک آپؐ کا انتظار کرتے

516
00:37:20,543 --> 00:37:22,863
جب گرمی کی شدت بڑھ جاتی تب وہ گھروں کو واپس چلے جاتے

517
00:37:22,904 --> 00:37:28,186
اور ان انتظار کے دنوں میں سے ایک دن اہلِ مدینہ شہرسے باہرحضرت محمد ﷺ  کی آمد کے منتظر تھے اور گرمی عروج پر تھی

518
00:37:28,262 --> 00:37:35,111
 چنانچہ جب وہ لوگ واپس روانہ ہوئے تو افق پر سفید لباس میں دو آدمی نمودار ہوئے

519
00:37:35,170 --> 00:37:40,290
 رسول اللہؐ اور حضرت ابوبکرؓ نے بلکل نیا سفید لباس زیبب تن کر رکھا تھا

520
00:37:40,347 --> 00:37:42,774
اور انہیں صحرا میں دور سے بھی آسانی سے دیکھا جا سکتا تھا

521
00:37:42,828 --> 00:37:49,403
کیونکہ حضرت زبیر بن عوامؓ ایک تجارتی سفر سے واپس آرہے تھے اور راستے میں ان دونوں شخصیات سے آپؓ کی ملاقات ہوئی

522
00:37:49,456 --> 00:37:53,085
چنانچہ آپؓ نے انہیں یہ دو لباس تحفہ دیئے

523
00:37:53,138 --> 00:37:58,298
 آپؓ نے ایک لباس رسول اللہؐ کو اور ایک حضرت ابوبکرؓ کو دیا، چنانچہ وہ نئے سفید کپڑوں میں ملبوس مدینہ منورہ آئے

524
00:37:58,340 --> 00:38:03,404
چنانچہ، کھجور کے درخت کی چوٹی پر ایک یہودی ایسے نمایاں مقام پر تھا جہاں سے اس نے ان دونوں شخصیات کو افق کے پار دیکھ لیا

525
00:38:03,479 --> 00:38:09,263
تو اس یہودی نے کہا؛ اے اہلِ عرب، یہی وہ شخص ہے جس کا تم انتظار کر رہے ہو، وہ آ گیا ہے

526
00:38:09,318 --> 00:38:12,292
چنانچہ تمام صحابہؓ اپنے اپنے گھروں سے نکل کر آپؐ کے استقبال کو لپکے

527
00:38:12,352 --> 00:38:15,606
اور انہوں نے باہر جانے کے لیے اپنے ہتھیار اٹھا لیئے

528
00:38:15,660 --> 00:38:19,597
یہ روایت تھی کہ جب صحابہ نبی پاکؐ کے استقبال میں سلام کے لیے کھڑے ہوں تب ان کے ہتھیار اُن کے پاس ہوں

529
00:38:19,630 --> 00:38:21,064
 صحابہؓ کے لئے یہ روایت(خاص الخاص مہمان کا استقبال) عام تھی

530
00:38:21,125 --> 00:38:28,206
صحابہ اپنے ہتھیار لے کر گئے اور جب حضرت محمدﷺ مدینہ تشریف لائے تو ان سے ملاقات اور استقبال کے لیے قطار میں کھڑے ہوگئے

531
00:38:28,248 --> 00:38:33,242
حضرت انس بن مالکؓ جو انصار میں سے تھے

532
00:38:33,314 --> 00:38:39,771
آپؓ فرماتے ہیں؛ میں نے مدینہ میں دو دن دیکھے ہیں

533
00:38:39,819 --> 00:38:46,924
ان میں سے ایک مدینہ کا بہترین دن تھا اور ایک مدینہ کا بدترین دن تھا

534
00:38:46,967 --> 00:38:52,717
وہ فرماتے ہیں کہ مدینہ میں بہترین دن وہ دن تھا جس دن رسول اللہ ﷺ مدینہ تشریف لائے

535
00:38:52,761 --> 00:38:58,999
اور مدینہ میں بدترین دن، وہ دن تھا جب رسول اللہؐ کا وصال ہوا

536
00:38:59,042 --> 00:39:03,345
اب وہ سب لوگ رسول اللہؐ اور ابوبکرؓ کے گرد جمع ہو گئے

537
00:39:03,417 --> 00:39:06,007
ان میں سے کچھ حضرت محمدﷺ کو جانتے تھے اور کچھ نہیں جانتے تھے

538
00:39:06,091 --> 00:39:12,511
تو کچھ لوگ حضرت ابوبکر صدیقؓ کے پاس جاتے اور یہ سوچ کر ہاتھ ہلاتے کہ وہ حضرت محمد ﷺ ہیں

539
00:39:12,566 --> 00:39:16,651
یہاں تک کہ پہلے وہ سائے کے تلے تھے اور اس وقت سورج کی تپش سے سائے نے رخ بدلہ

540
00:39:16,752 --> 00:39:18,323
تو جب ساۓ لمبے ہونے لگے

541
00:39:18,388 --> 00:39:20,423
 حضرت ابوبکرصدیقؓ کھڑے ہوگئے

542
00:39:20,494 --> 00:39:26,339
اورآپؓ نے کپڑے کا ایک ٹکڑا رسول اللہؐ کے اوپر تان لیا تاکہ آپؐ کو چھاوٰں ملے

543
00:39:26,398 --> 00:39:30,999
تب اہلِ مدینہ کو معلوم ہوا کہ جو بیٹھے ہیں وہ حضرت محمد ﷺ ہیں

544
00:39:31,040 --> 00:39:34,607
تو رسول اللہؐ اور حضرت ابو بکرؓ کے درمیان ایسا پرخلوص دوستی کا اٹوٹ رشتہ تھا

545
00:39:34,682 --> 00:39:37,279
آپؓ حضرت محمدﷺ کے غلام بھی تھے اور آپؐ کی خدمت کرنے پہ مامورتھے

546
00:39:37,332 --> 00:39:44,067
چنانچہ آپؓ حضرت محمدﷺ کو سایہ دینے کے لیے کپڑے کا ایک ٹکڑا پکڑ کر دھوپ میں کھڑے ہوگۓ

547
00:39:44,137 --> 00:39:45,976
یہ بات اہم ہے کہ ہم جو کچھ مرضی کر لیں

548
00:39:46,041 --> 00:39:52,280
ہم ان صحابہ کی طرح رسول اللہؐ کی خدمت کرنے کا مقام حاصل نہیں کر سکتے

549
00:39:52,333 --> 00:40:00,153
لیکن ہم کوشش کر سکتے ہیں صحابہ کی پیروی کرنے کی ،حضرت محمد ﷺ کی تعلیمات کی اتباع کرکے اور آپؐ کے پسندیدہ عمل پر عمل پیرا ہو کر

550
00:40:00,220 --> 00:40:06,162
اگر آپ حضرت محمد ﷺ سے محبت کرتے ہیں تو آپ وہی عمل کریں گے جو آپؐ کو پسند ہے اور اسی طرح آپ کو رسول اللہؐ کی محبت حاصل ہوگی

551
00:40:06,199 --> 00:40:10,129
  کچھ اسباق سفرِمدینہ سے، ہجرت سے

552
00:40:10,192 --> 00:40:12,712
ہمیں سب سے پہلے منصوبے کو دیکھنا چاہیۓ

553
00:40:12,775 --> 00:40:18,355
کیونکہ بدقسمتی سے ہمارے بہت سے اسلامی کام اس جہت سے محروم ہیں

554
00:40:18,418 --> 00:40:21,988
اور یہ سنت نہیں ہے

555
00:40:22,043 --> 00:40:24,922
رسول اللہؐ ایک غیر معمولی وقت میں مدینہ تشریف لے گئے

556
00:40:25,010 --> 00:40:27,768
 اِس جامع منصوبہ بندی کو دیکھیں

557
00:40:27,841 --> 00:40:31,364
اپنی شناخت چھپانے کے لیے آپؐ نے اپنا چہرہ ڈھانپا ھوا تھا

558
00:40:31,435 --> 00:40:35,797
اور سفرِمدینہ کے دوران

559
00:40:35,891 --> 00:40:39,508
لوگ آتے اورحضرت ابوبکر صدیقؓ سے بات چیت کرتے

560
00:40:39,532 --> 00:40:41,340
اور وہ حضرت ابوبکرؓ سے کہتے، یہ آدمی تمہارے ساتھ کون ہے؟ آپؓ فرماتے؛

561
00:40:41,380 --> 00:40:42,634
هذا هاديني الطريق

562
00:40:42,682 --> 00:40:44,040
یہ شخص سفر میں میری رہنمائی کر رہا ہے

563
00:40:44,083 --> 00:40:46,730
وہ لوگ سمجھتے کہ آپؐ صحرا میں آپؓ کی رہنمائی کر رہے ہیں

564
00:40:46,744 --> 00:40:51,006
جبکہ حضرت ابوبکرؓ کے کہنے کا مطلب یہ تھا کہ آپؐ جنت کی طرف میری راہنمائی کر رہے ہیں

565
00:40:51,057 --> 00:40:53,916
رسول اللہؐ نے حضرت ابوبکرؓ سے فرمایا کہ گھر خالی کردو

566
00:40:53,973 --> 00:40:59,556
رسولؐ اور حضرت ابوبکرؓ رات کو گھر کے پچھلے دروازے سے نکلے، وہ ایک انوکھے راستے پر چلے

567
00:40:59,615 --> 00:41:04,509
انہوں نے ایک صحرائی راہنما کی خدمات حاصل کیں

568
00:41:04,584 --> 00:41:08,188
حضرت عبداللہ ابن ابوبکرؓ ان کے لیے قریش کی مخبری کرتے

569
00:41:08,246 --> 00:41:09,987
حضرت اسماءؓ ان کے لیے کھانا لاتیں

570
00:41:10,040 --> 00:41:15,670
عامر بن فہیرہؓ، حضرت عبداللہؓ کے قدموں کے نشانات مٹاتے اور انہیں دودھ فراہم کرتے

571
00:41:15,716 --> 00:41:18,857
یہ سب منصوبہ بندی کے تحت تھا

572
00:41:18,930 --> 00:41:23,583
ایک غیر مسلم شخص کو راہنمائی کے لیۓ منتخب کرنا

573
00:41:23,637 --> 00:41:25,863
اس میں شریعت کا کیا حکم ہے؟

574
00:41:25,919 --> 00:41:31,525
شیخ ابوالکریم زیدان نے غیر مسلم سے مدد طلب کرنے کے بارے میں بیان کیا ہے

575
00:41:31,559 --> 00:41:36,154
  شیخ فرماتے ہیں؛ عام اصول یہ ہے کہ اس کی اجازت نہیں ہے

576
00:41:36,203 --> 00:41:41,495
لیکن غیرمسلم سے مدد اُس وقت استثناء ہے جب درج ذیل قوانین مدنظر ہوں

577
00:41:41,563 --> 00:41:47,525
نمبر ایک، کفار سے مدد حاصل کرنے کے لئے ایک مضبوط جواز ہونا چاہیۓ

578
00:41:47,563 --> 00:41:52,064
نمبر دو، کہ یہ کفار سے مدد، اُس(کافر) کی مالی معاونت کی غرض سے نہ ہو

579
00:41:52,123 --> 00:41:57,257
یا(یہ کفار سے مدد) کسی بھی صورت میں دعوتِ حق کو متاثر نہ کرے نہ ہی اُس میں رکاوٹ بنے

580
00:41:57,282 --> 00:42:05,189
نمبر تین، کہ غیرمسلم پر اعتماد اور بھروسے کی سطح تسلی بخش ہونی چاہیے

581
00:42:05,239 --> 00:42:11,572
اور آخری بات کہ اس( کفار سے مدد) سے مسلمانوں میں شکوک وشبہات پیدا نہ ہوں

582
00:42:11,659 --> 00:42:17,417
اگر یہ قواعد لاگو ہوتے ہیں تو کسی غیرمسلم سے مدد لینے میں کوئی حرج نہیں

583
00:42:17,442 --> 00:42:21,272
اور علماء نے ایک اور قاعدہ کا اضافہ کیا کہ کفار سے ایسی امداد لینے کی اجازت ہے جس سے کفار کی بالادستی قائم نہ ہو

584
00:42:21,378 --> 00:42:25,645
لیکن ہر صورت میں مسلمانوں کی بالادستی اور قیادت قائم رہے

585
00:42:25,693 --> 00:42:28,528
ہجرت کے چند اسباق

586
00:42:28,570 --> 00:42:32,702
نمبر ایک، رسول اللہؐ کی وسیع تنظیم سازی

587
00:42:32,761 --> 00:42:35,924
اب رسول اللہؐ، اللہ کے نبی ہیں

588
00:42:35,965 --> 00:42:39,577
شاید آپؐ کوان تمام اصولوں پر عمل کرنے کی ضرورت نہیں تھی

589
00:42:39,653 --> 00:42:43,097
لیکن رسول اللہؐ نے ہمیں سکھایا کہ یہ سنت ہے

590
00:42:43,117 --> 00:42:47,517
اس طرح اعمال کیے جائیں ، یہ صحیح طریقہ ہے

591
00:42:47,566 --> 00:42:51,037
 آپؐ ہمارے لیۓ بہترین نمونہ ہیں، وہ چونکہ وہ اللہ کے رسولؐ ہیں

592
00:42:51,129 --> 00:42:53,766
اور ہم توقع کر سکتے ہیں کہ اللہ آپؐ کی حفاظت فرماتا اور نگاھبانی کرتا اگر وہ یہ سب نہ بھی کرتے

593
00:42:53,791 --> 00:42:55,686
وَاللَّهُ يَعْصِمُكَ مِنَ النَّاسِ

594
00:42:55,749 --> 00:43:00,026
اللہ عزَّوَجَل نےحضرت محمد ﷺسے فرمایا کہ میں آپؐ کو دشمنوں سے محفوظ رکھوں گا

595
00:43:00,069 --> 00:43:02,723
 آپؐ کو اللہ کی طرف سے حفاظت کی ضمانت دی گئی تھی

596
00:43:02,757 --> 00:43:09,717
اس کے باوجود، آپؐ نے جامع منصوبہ بندی کو ہر زاویے سے جانچا اور ہمیں سکھانے کے لیے عمل درآمد کیا

597
00:43:09,785 --> 00:43:11,829
کہ یہ میری سنت ہے اور یہی میرا طریقہ ہے

598
00:43:11,861 --> 00:43:14,889
اور اگر تم ایسے عمل نہیں کرو گے تو تم میری سنت سے روگردانی کرو گے

599
00:43:14,953 --> 00:43:20,539
اب جس طرح اللہ سبحانہ وتعالیٰ کے قوانین فطرت ہیں

600
00:43:20,610 --> 00:43:25,565
دیکھیں اللہ تعالی نے قوانین بنائے ہیں

601
00:43:25,625 --> 00:43:30,072
ہم جنہیں فطرت کے قوانین کہتے ہیں دراصل وہ اللہ عَزَّوَجَلْ کے قوانین ہیں

602
00:43:30,112 --> 00:43:31,860
اور قوانین کے بارے میں اللہ تعالیٰ فرماتا ہے

603
00:43:31,945 --> 00:43:34,773
وَلَنْ تَجِدَ لِسُنَّتِ اللَّهِ تَحْوِيلً

604
00:43:35,252 --> 00:43:38,004
تم اللہ کے قوانین میں کوئی تبدیلی نہیں پاؤ گے

605
00:43:38,058 --> 00:43:40,228
وہ تبدیل نہیں ہوں گے، یہ دائمی اصول ہیں

606
00:43:40,274 --> 00:43:45,810
اگر آپ آکسیجن اور ہائیڈروجن لاکران دونوں گیسوں کو آپس میں ملا دیتے ہیں

607
00:43:45,888 --> 00:43:48,184
آپ پانی حاصل کرتے ہیں، آپ کو نائٹروجن نہیں ملے گی

608
00:43:48,250 --> 00:43:50,581
آپ کو ہمیشہ پانی ہی ملے گا

609
00:43:50,648 --> 00:43:54,524
یہ اللہ کا قانون ہے نہ کبھی ٹوٹتا ہے ،نہ ہی کبھی بدلتا ہے

610
00:43:54,572 --> 00:43:58,826
اب جس طرح فطری دنیا میں اللہ کے قوانین ہیں

611
00:43:58,922 --> 00:44:04,749
اللہ کے قوانین ہیں جو ہماری انفرادی زندگی، معاشرتی زندگی اور قوموں کے لئے لاگو ہوتے ہیں

612
00:44:04,811 --> 00:44:09,022
اللہ کے وہ قوانین ہیں جو جنگوں میں لاگو ہوتے ہیں، ایسے قوانین جن کے تحت پوری دنیا کا نظام چل سکے

613
00:44:09,064 --> 00:44:11,365
 دنیا کا سارا نظام اللہ کے قوانین کے تحت کنٹرول کیا جاتا ہے

614
00:44:11,411 --> 00:44:17,008
رسول اللہ ﷺ نے ہمیں بتایا کہ اللہ کے ان قوانین کے خلاف کوئی نہیں جاسکتا

615
00:44:17,053 --> 00:44:19,208
یہاں تک کہ میں بھی عمل کیوں نہ کروں

616
00:44:19,259 --> 00:44:24,722
 آپ کو اللہ تعالیٰ کے قوانین کے مطابق چلنا ہے، ان کے خلاف نہیں جانا، انہیں توڑنے کی کوشش نہیں کرنا

617
00:44:24,765 --> 00:44:34,067
کیونکہ اسلام میں کوئی تعصب نہیں ہے اللہ عَزَّوَجَلْ آپ کو کسی کافر پر محض اس لیے فضیلت نہیں دے گا کہ آپ مسلمان ہیں

618
00:44:34,138 --> 00:44:37,405
رسول اللہ ﷺ نے ترتیب کرنی تھی

619
00:44:37,449 --> 00:44:40,105
ہر کسی کو رزق تلاش کرنا ہے

620
00:44:40,158 --> 00:44:42,437
کیا قرآن میں رزق کی تلاش میں کوئی استثنیٰ ہے؟

621
00:44:42,495 --> 00:44:45,544
کیا قرآن کہتا ہے کہ مسلمان ہو کر، آپ کو رزق تلاش کرنے کی ضرورت نہیں ہے؟

622
00:44:45,575 --> 00:44:51,736
کیا اللہ عَزَّوَجَلْ سونے کی بنی ہوئی بارش کے قطرے آپ کے اوپر گرائے گا؟

623
00:44:51,793 --> 00:44:57,106
 دستورِ قدرت میں کوئی استثناء نہیں ہے، جیسا کہ کافر کو رزق کی تلاش میں جانا پڑتا ہے

624
00:44:57,160 --> 00:44:58,912
تمہیں بھی باہر جا کر رزق تلاش کرنا ہے

625
00:44:58,956 --> 00:45:00,922
پرندوں کو گھونسلوں سے نکل کر رزق تلاش کرنا پڑتا ہے

626
00:45:00,971 --> 00:45:02,792
حیوانوں کو نکل کر رزق تلاش کرنا پڑتا ہے

627
00:45:02,869 --> 00:45:05,738
قوانینِ فطرت میں کوئی رعایت نہیں، اللہ کا قانون ازل سے ایک سا ہے

628
00:45:05,816 --> 00:45:07,515
یہ سب پر لاگو ہوتا ہے

629
00:45:07,586 --> 00:45:13,529
لہٰذا ہمیں یہ نہیں سوچنا چاہیے کہ ہمیں ایک بے ساختہ ، غیرارادی عمل کا صلہ ملے گا

630
00:45:13,589 --> 00:45:16,602
صرف اس لیے کہ ہم مسلمان ہیں، اور اللہ کو چاہیے کہ ہم پر کوئی احسان کرے

631
00:45:16,654 --> 00:45:18,242
ليس بأمانيكم

632
00:45:18,281 --> 00:45:21,794
یہ آپ کی خواہشات کے تابع نہیں ہے

633
00:45:21,863 --> 00:45:25,852
یہ پہلا سبق ہے، نمبر دو، مستقبل کی منصوبہ بندی کرنا

634
00:45:25,925 --> 00:45:31,518
حضرت ابوبکر صدیقؓ کو ابھی تک معلوم نہیں تھا کہ وہ رسول اللہؐ کے ساتھ ہجرت کریں گے

635
00:45:31,616 --> 00:45:35,545
آپؓ کو اندازہ تھا کہ شاید وہ اس سفر میں رسول اللہؐ کے ہمسفر ہوں لیکن اس کی کوئی ضمانت نہیں تھی

636
00:45:35,584 --> 00:45:40,421
حتی کہ آخری لمحے تک آپؓ نہیں جانتے تھے، رسول اللہؐ نے اس فیصلے کو خفیہ رکھا

637
00:45:40,482 --> 00:45:45,035
اس کے باوجود حضرت ابوبکر صدیقؓ نے اپنے دو اونٹ خرید لیے

638
00:45:45,090 --> 00:45:47,168
اورآپؓ انہیں ایک خاص کھانا کھلاتے تھے

639
00:45:47,214 --> 00:45:48,388
ورقع السُمر

640
00:45:49,008 --> 00:45:54,111
اونٹوں کی خوراک جو کہ ایک خاص پودے کے پتے تھے جو گراں قیمت تھے، جس سے اونٹ طاقتور ہو جاتا

641
00:45:54,134 --> 00:45:56,808
  آپؓ اونٹوں کو وہ مہنگا چارہ کھلا رہے تھے

642
00:45:56,877 --> 00:46:03,997
کیونکہ آپؓ نے سوچا کہ شاید کسی دن مجھے ہجرت کے وقت رسول اللہ ﷺ کی صحبت سے فیضیاب ہونے کا موقع ملے

643
00:46:04,044 --> 00:46:08,123
یہ سفر ایک مہینے میں ہو سکتا ہے، یہ ایک سال میں بھی ہوسکتا ہے، یہ دس سال بعد ہو سکتا ہے، کوئی ضمانت نہیں تھی

644
00:46:08,174 --> 00:46:10,377
لیکن حضرت ابوبکرؓ مستقبل کی منصوبہ بندی کر رہے تھے

645
00:46:10,440 --> 00:46:12,289
آپ جانتے ہیں کہ مستقبل کی منصوبہ بندی کرنا آسان نہیں ہے

646
00:46:12,313 --> 00:46:14,712
جب کہ آپ یہ بھی نہیں جانتے کہ کیا ہونے والا ہے؟

647
00:46:14,753 --> 00:46:17,585
لیکن حضرت ابوبکر صدیقؓ نے ایسا کیا

648
00:46:17,639 --> 00:46:25,313
اور دیکھیں کہ غزوہ تبوک میں منافقین رسول اللہﷺ کے پاس آئے اور کہا

649
00:46:25,386 --> 00:46:28,161
ایک منافق آیا اور اس نے کہا یا رسول اللہؐ

650
00:46:28,219 --> 00:46:31,441
میں فلاں عُذر کی بناء پر آپؐ کے ساتھ جنگ تبوک میں شامل نہیں ہو سکتا

651
00:46:31,497 --> 00:46:33,643
جو ایک معقول وجہ معلوم ہوتی تھی

652
00:46:33,688 --> 00:46:35,393
ایک اور منافق آیا اور کہنے لگا

653
00:46:35,444 --> 00:46:41,983
 یارسول اللہؐ میں آپ کے ساتھ جنگ میں شامل نہیں ہو سکتا،میری فلاں مجبوری ہے تو اس کا پیش کردہ عُذر بھی قابلِ قبول لگتا تھا

654
00:46:42,042 --> 00:46:44,252
اور وہ رسول اللہؐ کے پاس آتے جاتے رہے

655
00:46:44,299 --> 00:46:46,463
اور رسول اللہؐ نے اس موقع پر تمام منافقین کے عذر قبول کیے

656
00:46:46,521 --> 00:46:50,169
منافقوں نے آپؐ کو عذر پیش کیے، اللہ عزَّوَجَل نےفرمایا؛

657
00:46:50,220 --> 00:46:52,926
عَفَا اللَّهُ عَنكَ لِمَ أَذِنتَ لَهُمْ

658
00:46:53,075 --> 00:46:55,926
اللہ تعالیٰ آپ کی مغفرت فرمائے

659
00:46:56,001 --> 00:46:57,320
آپؐ نے انہیں اجازت کیوں دی؟

660
00:46:57,377 --> 00:46:59,453
اور پھر اللہ تعالیٰ نے فرمایا؛

661
00:46:59,490 --> 00:47:02,466
وَلَوْ أَرَادُوا الْخُرُوجَ لَأَعَدُّوا لَهُ عُدَّةً

662
00:47:03,027 --> 00:47:06,459
اگر وہ دشمن پر چڑھائی کرنے کا پختہ ارادہ رکھتے تھے

663
00:47:06,534 --> 00:47:10,562
تو وہ اس کے لیے پہلے سے تیاریاں کر لیتے

664
00:47:10,639 --> 00:47:16,836
انہوں نے آخری لمحے تک انتظار کیا اور ہاں ان کے کچھ کاروباری معاملات ادھورے تھے

665
00:47:16,877 --> 00:47:20,826
لیکن اللہ عَزَّوَجَلْ فرماتا ہے، اگر وہ جنگ کے لیے باہر جانے کا ارادہ رکھتے

666
00:47:20,890 --> 00:47:25,326
تو وہ اس کے لیے پہلے سے تیار ہوتے

667
00:47:25,402 --> 00:47:26,748
وَلَٰكِن كَرِهَ ٱللَّهُ ٱنبِعَاثَهُمْ فَثَبَّطَهُمْ

668
00:47:26,772 --> 00:47:31,655
لیکن اللہ تعالیٰ نے یہ نہیں چاہا کہ وہ جنگ کے لیئے نکلتے، یہ منافقین تھے، یہ اس کے مستحق نہیں تھے

669
00:47:31,708 --> 00:47:33,641
تو آپ کو مستعد رہنا ہوگا، آپ کو تیار رہنا ہوگا

670
00:47:33,743 --> 00:47:37,944
مسئلہ یہ ہے کہ ہم آخری لمحے تک انتظار کرتے ہیں، ہم کام نہیں کر سکتے

671
00:47:38,009 --> 00:47:40,351
اور پھر ہم سوچتے ہیں کہ ہم شاید بری الزمہ ہیں

672
00:47:40,412 --> 00:47:44,226
اگر آپ کو پہلے نامکمل کاروباری معاملات کو ختم کرنے کا موقع ملا تھا اور آپ نے نہیں کیا

673
00:47:44,246 --> 00:47:47,257
آپ کو ذمہ دار ٹھہرایا جائے گا

674
00:47:47,277 --> 00:47:49,254
ہمیں اسلام کو سنجیدگی سے لینا ہو گا،

675
00:47:49,289 --> 00:47:57,706
ہم ایسے ہی تمام معاملات کو ادھورا چھوڑ کر یہ نہیں سوچنا چاہیے کہ معاملات خودبخود ٹھیک ہو جائیں گے

676
00:47:57,769 --> 00:48:02,638
تیسرا سبق ؛ رازداری ہے، آپ نے دیکھا کہ ہجرت کا پورا منصوبہ خفیہ تھا

677
00:48:02,689 --> 00:48:07,892
رازدارانہ طور پر، سب کچھ چھپ کر کیا گیا تھا

678
00:48:07,970 --> 00:48:14,785
رسول اللہؐ نے اپنی حیاتِ طیبہ میں دونوں انداز سے کام کیا ،علی الاعلان بھی اور خفیہ طور پر بھی

679
00:48:14,834 --> 00:48:17,137
اور یہ دعوتِ حق کے لیے ضروری ہے

680
00:48:17,179 --> 00:48:21,557
کچھ حالات میں، چیزیں کٹھن اور مشکل ہو جائیں گی

681
00:48:21,636 --> 00:48:24,528
لہذا، آپ کو روپوش بھی ہونا پڑے گا

682
00:48:24,597 --> 00:48:28,188
اور صرف اللہ عَزَّوَجَلْ کو معلوم ہے کہ مستقبل کیا ہے

683
00:48:28,239 --> 00:48:32,037
میرا مطلب ہے، مثال کے طور پر، جب آپ امام مہدیؑ کے زمانے میں ظاہر ہونے والے فتنوں سے متعلق احادیث پڑھتے ہیں

684
00:48:32,112 --> 00:48:35,807
 جب یہ کہا جاتا ہے کہ صرف 300 لوگ امام مہدیؑ کے ہاتھ پر بعیت کریں گے

685
00:48:35,868 --> 00:48:39,759
کیا یہ مسلم دنیا کے تمام لوگ ہیں، جو بعیت کرنا چاہتے ہیں؟

686
00:48:39,825 --> 00:48:42,569
یہ بعیت خفیہ طور پر لی جاۓ گی

687
00:48:42,625 --> 00:48:46,211
بصورت دیگر، عوام الناس کی بڑی تعداد اس بعیت کی خواہاں ہوتی

688
00:48:46,273 --> 00:48:53,149
جب رسول اللہؐ ان لشکروں کی بات کرتے ہیں جو عراق میں ہوں گے، اور شام میں ہوں گے اور یمن میں ہوں گے

689
00:48:53,217 --> 00:49:00,108
آپ حدیث کے متن سے یہ سمجھ سکتے ہیں کہ خفیہ طور پر بہت زیادہ کام ہو رہا ہے

690
00:49:00,172 --> 00:49:02,293
یہ سب اعلانیہ طور پر نہیں ہو گا

691
00:49:02,355 --> 00:49:11,005
اور ایک وقت ایسا بھی آ سکتا ہے، جب کام صرف چند خفیہ منظم احکامات کے ذریعے کیا جاۓ گا

692
00:49:11,063 --> 00:49:17,242
اور ایسے لوگ ان نوجوانوں کا عکس ہوں گے یہ اصحابِ کہف کی طرح اللہ تعالیٰ کی بندگی کے لیے خود کو وقف کریں گے

693
00:49:17,284 --> 00:49:22,581
اصحابِ کہف وہ نوجوان تھے، جو بادشاہِ وقت کے مظالم سے تنگ آکرفرار ہوۓ

694
00:49:22,648 --> 00:49:26,068
 لیکن وہ ایک گروہ تھے، وہ غار میں جا کرچھپ گئے

695
00:49:26,119 --> 00:49:32,821
اور دیکھیں کہ یہ وہی سورت ہے جو ہمیں دجال کے ظاہر ہونے پر پڑھنے کو کہا گیا ہے

696
00:49:32,880 --> 00:49:39,214
اور یہ خاص طور پر سورہ کہف کی پہلی آیات ہیں جو غار کے نوجوانوں کے بارے میں ذکر کر رہی ہیں

697
00:49:39,262 --> 00:49:47,983
کیونکہ یہ ایک مسلم گروہ تھا، جو اللہ کی خوشنودی کے لئے وقف تھا، اور یہ تمام نوجوان اللہ تعالیٰ کے لیے قربانی دینے کو تیار تھے

698
00:49:48,037 --> 00:49:52,839
اِن اصحابِ کہف کو ظلم و ستم سے بھاگ کر روپوش ہونا پڑا

699
00:49:52,892 --> 00:49:55,872
لیکن بات یہ ہے کہ دونوں سنت کے مطابق ہیں

700
00:49:55,929 --> 00:50:01,062
حالات کے مطابق، اعلانیہ کام بھی اور خفیہ کام بھی

701
00:50:01,156 --> 00:50:04,088
 کیونکہ ہم جانتے ہیں کہ اسلام کے بہت سے دشمن موجود ہیں

702
00:50:04,137 --> 00:50:07,728
شیطان یقیناً آپ کو اپنے جال میں پھانسنا چاہتا ہے

703
00:50:07,788 --> 00:50:13,241
لہذا، آپ کو شیطان کے منصوبے کا مقابلہ کرنے کے لیے ایک جوابی منصوبے کی ضرورت ہے

704
00:50:13,284 --> 00:50:16,991
آپ کو تریاق سے بیماری کا علاج کرنا ہے

705
00:50:17,079 --> 00:50:22,020
شیطان کے پاس زہر ہے آپ کے پاس اس مخصوص زہرکا تریاق ہونا ضروری ہے

706
00:50:22,085 --> 00:50:26,062
اللہ عزَّوَجل کو شیطان پیدا کرنے کی ضرورت نہیں تھی

707
00:50:26,125 --> 00:50:28,989
لیکن اللہ نے شیطان کی تخلیق کو دنیاوی زندگی کی آزمائش کا حصہ بنایا

708
00:50:29,061 --> 00:50:33,535
آزمائش لینے کا کیا فائدہ کیونکہ دنیا میں ہماری زندگی امتحان ہے

709
00:50:33,601 --> 00:50:35,823
وَنَبْلُوكُمْ بِالشَّرِّ وَالْخَيْرِ فِتْنَةً

710
00:50:36,014 --> 00:50:38,431
آپ کی آزمائش اچھائی اور برائی دونوں میں سے ہے

711
00:50:38,488 --> 00:50:42,877
آزمائش کروانے کا کیا فائدہ اگر آپ کے پاس صرف اچھے عمل کا انتخاب ہو

712
00:50:42,923 --> 00:50:45,870
 اگرآپ کو آزمایا جائے گا تو پھر چاہے آپ اپنے لیے بھلائی کا انتخاب کریں یا برائی کے رستے پہ چلیں

713
00:50:45,914 --> 00:50:50,196
آزمائش کا ضابطہ یہی ہے کہ آپ کے سامنے چناؤ کے لیے دونوں صورتیں رکھی جائیں

714
00:50:50,246 --> 00:50:52,573
تو اللہ عَزَّوَجَلْ نے بھی آپ کو دنیاوی زندگی میں خیر کا انتخاب کرنے کا موقع دیا ہے

715
00:50:52,680 --> 00:50:57,212
اور اللہ عَزَّوَجَلْ نے آپ کو برائی کا انتخاب بھی دیا ہے جو آزمائش کا حصہ ہے

716
00:50:57,236 --> 00:50:58,901
وَنَبْلُوكُمْ بِالشَّرِّ وَالْخَيْرِ فِتْنَة

717
00:50:59,398 --> 00:51:06,552
ترجمہ:"تاکہ آپ کو نیکی اور بدی سے آزمائے"

718
00:51:06,687 --> 00:51:14,505
رسول اللہؐ اور حضرت ابوبکر صدیقؓ مدینہ میں قیام پزیرہوئے

719
00:51:14,596 --> 00:51:20,698
اب بھائیو اور بہنو، مہاجرین مکہ مکرمہ سے آئے ہیں

720
00:51:20,748 --> 00:51:24,738
جو اللہ کے نزدیک محبوب ترین سرزمین(مکہ مکرمہ) ہے

721
00:51:24,798 --> 00:51:27,982
رسول اللہؐ جب مکہ سے روانہ ہونے لگے

722
00:51:28,055 --> 00:51:33,869
تو آپؐ "حزورہ" نامی جگہ پر کھڑے ہوۓ

723
00:51:33,942 --> 00:51:40,652
رسول اللہؐ حزورہ کے مقام پر کھڑے ہوۓ اور آپؐ نے مکہ مکرمہ کا آخری منظر دیکھا

724
00:51:40,725 --> 00:51:41,925
آپؐ نے فرمایا؛

725
00:51:41,970 --> 00:51:48,665
ولله إنكي لخيروأرض الله و أحب أرض الله إلى الله،

726
00:51:49,545 --> 00:51:52,530
ولو لا أنِّي أخرجتُ مِنكِي ما خرج

727
00:51:52,575 --> 00:51:58,641
 آپؐ نے فرمایا؛ اللہ کی قسم، اے سرزمینِ مکہ! تم اللہ کے نزدیک بہترین زمین ہو

728
00:51:58,691 --> 00:52:02,394
اور تم اللہ کی محبوب سرزمین ہو

729
00:52:02,455 --> 00:52:07,953
 اور اگر تیرے فرزند مجھے یہاں سے نکلنے پر مجبور نہ کرتے تو میں کبھی یہاں سے نہ نکلتا

730
00:52:08,000 --> 00:52:15,683
مکہ چھوڑنا آسان نہیں تھا، یہ رسول اللہؐ کے لیے آسان کام نہیں تھا اور نہ ہی صحابہ کرامؓ کے لیے آسان تھا

731
00:52:15,764 --> 00:52:19,532
 یہ وہ مقدس سرزمین تھی جہاں خانہ کعبہ تھا

732
00:52:19,599 --> 00:52:27,447
اور جس نے کعبہ کو دیکھا اور کعبہ کا طواف کیا وہ کعبہ سے دلی طور پر وابستہ ہو گیا

733
00:52:27,485 --> 00:52:32,134
مومن، جو دل میں ایمان رکھتے ہیں اور وہ کعبہ کا طواف کرتے ہیں

734
00:52:32,195 --> 00:52:35,570
پھر جب بھی وہ کعبہ چھوڑتے ہیں تو اداس و ملول رہتے ہیں

735
00:52:35,630 --> 00:52:38,871
اور آپ دیکھتے ہیں کہ اللہ عَزَّوَجَلْ قرآن میں فرماتا ہے کہ یہ حضرت ابراہیمؑ کی دعا تھی

736
00:52:38,896 --> 00:52:46,666
حضرت ابراہیمؑ نے اللہ سے دعا کی، لوگوں کے دلوں میں اس جگہ یعنی کعبہ کی محبت ڈال دے

737
00:52:46,742 --> 00:52:52,316
کیونکہ جب حضرت ابراہیمؑ نے اپنے بیٹےحضرت اسماعیلؑ اوران کی والدہ حضرت ہاجرہؑ کو حجاز کی وادی میں تنہا چھوڑا

738
00:52:52,376 --> 00:52:55,548
اور جب حضرت ابراہیمؑ نے اپنے خاندان کو وہاں چھوڑا تب مکہ کی وادی ویران تھی

739
00:52:55,609 --> 00:52:57,318
تو حضرت ابراہیمؑ نے دعا فرمائی؛

740
00:52:57,342 --> 00:52:59,062
فَاجْعَلْ أَفْئِدَةً مِّنَ النَّاسِ تَهْوِي إِلَيْهِمْ

741
00:52:59,087 --> 00:53:01,514
ترجمہ:"اور لوگوں کے دل اس(زمین) کی طرف پھیر دے"

742
00:53:01,589 --> 00:53:03,781
تو اب سب کے دل مکہ سے جڑے ہوئے ہیں

743
00:53:03,848 --> 00:53:07,953
اور جب حضرت ابراہیمؑ نے کعبہ تعمیر کر لیا تو اللہ عَزَّوَجَلْ نےحضرت ابراہیمؑ کو ایک اور حکم دیا

744
00:53:07,978 --> 00:53:14,107
 اللہ نے آپؑ کو حکم دیا کہ لوگوں کو حج کی دعوت دو، لوگوں کو حج کی طرف بلاؤ

745
00:53:14,164 --> 00:53:20,785
حضرت ابراہیمؑ صحرا میں کھڑے ہیں، ان کے اردگرد خانہ کعبہ کے سوا کوئی نہیں ہے

746
00:53:20,844 --> 00:53:22,644
 اور اللہ عَزَّوَجَلْ ،آپؑ کو حکم دے رہا ہے کہ لوگوں کو حج کے لۓ بلاؤ

747
00:53:22,684 --> 00:53:28,574
تو حضرت ابراہیمؑ نے فرمایا ؛ مجھے کون سنے گا میری آواز لوگوں تک نہیں پہنچے گی، آس پاس تو کوئی نہیں ہے

748
00:53:28,619 --> 00:53:33,547
اللہ عَزَّوَجَلْ نے آپؑ سے کہا کہ تم اذان دو میں پیغام پہنچا دوں گا

749
00:53:33,624 --> 00:53:36,284
 اللہ نے فرمایا آپؑ صداۓ حق بلند کریں ، میں لوگوں تک پیغام پہنچا دوں گا

750
00:53:36,350 --> 00:53:41,807
خیر پیغام پہنچا دیا گیا حضرت ابراہیمؑ کی دعوت ہم تک قرآن کے ذریعے پہنچائی گئی

751
00:53:41,871 --> 00:53:49,836
چنانچہ حضرت ابراہیمؑ کے الفاظ کروڑوں اربوں انسانوں تک پہنچ چکے ہیں

752
00:53:49,908 --> 00:53:52,869
حضرت ابراہیمؑ نےجو کام کرنا تھا، وہ اللہ کی طرف لوگوں کو بلانا تھا

753
00:53:52,942 --> 00:53:55,586
اور اللہ تعالیٰ نے آپؑ کے اس پیغام کو ہم تک پہنچایا

754
00:53:55,646 --> 00:53:59,666
چنانچہ وہ مکہ سے محبت کرتے تھے اور مہاجرین کے لیے مکہ چھوڑنا انتہائی مشکل تھا

755
00:53:59,762 --> 00:54:05,490
مزید یہ کہ مدینہ کوئی زیادہ خوشگوار جگہ نہیں تھی

756
00:54:05,548 --> 00:54:09,785
 مدینہ کو ٹھہرے ہوۓ پانی کی سرزمین کے طور پر بیان کیا گیا ہے

757
00:54:09,864 --> 00:54:12,775
جب سیلاب آتا تو پانی ٹھہرجاتا

758
00:54:12,828 --> 00:54:18,495
اور پانی بہت بدبودار ہو جاتا اور یہ بہت سے وبائی امراض کا سبب بن جاتا

759
00:54:18,548 --> 00:54:25,591
مدینہ کی مقامی آب و ہوا میں بہت سی متعدی بیماریاں پھیل جاتیں

760
00:54:25,649 --> 00:54:28,282
اب مدینہ کے لوگ وہیں پروان چڑھے تو وہ اس کے عادی ہو گئے

761
00:54:28,307 --> 00:54:31,733
 اور اہلِ مدینہ کے جسمانی نظام میں ان وبائی امراض کے خلاف فطری قوتِ مدافعت پیدا ہو گئی

762
00:54:31,850 --> 00:54:35,414
لیکن مہاجرین جب مدینہ آئے تو بیمار پڑ گئے

763
00:54:35,487 --> 00:54:40,940
اور مہاجرین شدید بخارمیں مبتلا ہو گۓ

764
00:54:41,006 --> 00:54:43,996
جدید علماء کا کہنا ہے کہ یہ ملیریا ہو سکتا ہے

765
00:54:44,070 --> 00:54:49,632
ٹھہرے ہوئے پانی کی موجودگی کی وجہ سے ملیریا کی وباء پھیل گئی ہو لیکن اللہ ہی بہتر جانتا ہے

766
00:54:49,690 --> 00:54:55,339
اسے ہماری سیرت کی کتابوں میں، بخار کے پھیلاؤ کی تاریخ کے طور پر بیان کیا گیا ہے

767
00:54:55,403 --> 00:55:00,566
میں صرف یہ چاہتا ہوں کہ آپ حضرت ابوبکر صدیقؓ یا صحابہ میں سے کسی ایک کا تصور کریں

768
00:55:00,635 --> 00:55:10,026
 اُداس ہونا فطری ہے اور لیکن مکہ سے دوری کا احساس زیادہ ازیت ناک ہے

769
00:55:10,119 --> 00:55:14,408
آپ اپنے گھر والوں سے الگ ہو گئے ہیں

770
00:55:14,498 --> 00:55:20,929
اور پھر آپ بیمار اور شدید بیمار ہو جاتے ہیں اور اگر آپ کے خاندان میں سے آپ کی دیکھ بھال کرنے والا بھی کوئی پاس نہ ہو

771
00:55:20,980 --> 00:55:27,145
اور آپ اپنے گھر میں نہیں رہ رہے ہیں، آپ نے اپنا بستر چھوڑ دیا ہے، اور آپ ایک پردیسی ہیں

772
00:55:27,215 --> 00:55:30,535
کیا آپ تصور کر سکتے ہیں کہ یہ احساسات کتنے تکلیف دہ ہیں؟

773
00:55:30,574 --> 00:55:36,833
حضرت ابو بکر صدیقؓ،حضرت بلالؓ اور اپنے غلام حضرت عامر بن فہیرہ کے ساتھ رہ رہے تھے

774
00:55:36,900 --> 00:55:38,986
وہ ایک ہی کمرے میں قیام پزیرتھے

775
00:55:39,040 --> 00:55:44,343
رسول اللہؐ نے حضرت عائشہؓ سے فرمایا ؛کہ اے عائشہؓ جاؤ اور ان کی دیکھ بھال کرو

776
00:55:44,409 --> 00:55:48,542
اللہ عَزَّوَجَلْ نےحضرت محمدﷺ پر خصوصی رحمت کی، آپؐ اس بخار سے متاثر نہیں ہوئے

777
00:55:48,615 --> 00:55:51,002
لیکن دیگر مہاجرین بھی تھے اور وہ اس بیماری سے نبردآزما تھے

778
00:55:51,059 --> 00:55:55,404
تو رسول اللہؐ نے سیدہ عائشہؓ سے فرمایا کہ جاؤ اور ان بیمار مہاجرین کی دیکھ بھال کرو

779
00:55:55,478 --> 00:55:58,514
 آپؐ کو اپنے صحابہ کی تکلیف کا احساس تھا اور آپؐ ان کا بہت خیال رکھتے تھے

780
00:55:58,574 --> 00:56:03,280
تو حضرت عائشہؓ فرماتی ہیں کہ میں وہاں گئی اور یہ پردہ فرض ہونے سے پہلے کی بات ہے

781
00:56:03,338 --> 00:56:09,380
چنانچہ میں وہاں گئی اور اپنے والد کے پاس جا کر میں نے کہا؛

782
00:56:09,445 --> 00:56:11,324
يا ابتي كيف تجدك؟

783
00:56:11,479 --> 00:56:14,133
بابا جان!آپ کی طبیعت کیسی ہے؟

784
00:56:14,204 --> 00:56:18,395
تو میرے والد نے شعر کی ایک سطر میں جواب دیا اور فرمایا؛

785
00:56:18,475 --> 00:56:23,418
كُلٌ مرِعٍ أصبحٌ في أهله والموت أدْنى مِشراكٍ أليه

786
00:56:24,178 --> 00:56:36,448
حضرت ابوبکرؓ نے کہا کہ ہم میں سے ہر ایک اپنا دن گزار رہا ہے جبکہ موت ان کے جوتے کے تسمے سے بھی زیادہ قریب ہو سکتی ہے

787
00:56:36,518 --> 00:56:42,902
 آپؓ نے موت کی قربت کو جوتے اور اسکے تسمے کی قربت سے تشبیہ دے کر بیان کیا

788
00:56:42,972 --> 00:56:46,401
حضرت عائشہؓ نے فرمایا؛ میرے والد نہیں جانتے کہ وہ کیا کہہ رہے ہیں

789
00:56:46,456 --> 00:56:52,574
آپؓ کا بخار اتنا شدید تھا کہ انہیں وہم ہونے لگا

790
00:56:52,646 --> 00:56:56,080
آپ اندازہ لگا سکتے ہیں کہ بخار کتنا شدید تھا،آپؓ فرماتی ہیں؛

791
00:56:56,158 --> 00:56:57,186
أبي لا يعقل ما يبقي

792
00:56:57,246 --> 00:56:59,046
میرے والد کو نہیں معلوم کہ وہ کیا کہہ رہے ہیں

793
00:56:59,119 --> 00:57:01,657
پھر آپؓ، عامر بن فہیرہؓ کے پاس گئیں اور فرمایا؛

794
00:57:01,681 --> 00:57:04,166
عامر! آپ کیسے ہو.؟

795
00:57:04,236 --> 00:57:06,218
تو عامر بن فھیرہ نے جواب دیا کہ

796
00:57:06,280 --> 00:57:10,751
لقد وجدت الموت قبل زوقيه إنَّ جبعنا حتْفهو من فوقه

797
00:57:10,811 --> 00:57:16,797
میں نے موت کا ذائقہ چکھنے سے پہلے ہی موت دیکھی ہے اور بزدل بھی آخرکار مر جائے گا

798
00:57:16,866 --> 00:57:21,376
حضرت عائشہؓ نے فرمایا؛ اور عامرؓ کو نہیں معلوم تھا وہ کیا کہہ رہے ہیں

799
00:57:21,422 --> 00:57:24,412
پھر آپؓ فرماتی ہیں کہ وہ حضرت بلالؓ کے پاس گئیں اور ان سے پوچھا کہ تم کیسے ہو؟

800
00:57:24,443 --> 00:57:28,361
اورحضرت عائشہؓ فرماتی ہیں کی حضرت بلالؓ بے ہوش تھے،جب بھی انھیں ہوش آتا

801
00:57:28,458 --> 00:57:30,292
 آپؓ کمرے کے بیچوں بیچ بیٹھ جاتے

802
00:57:30,354 --> 00:57:33,230
حضرت بلالؓ کمرے کے وسط میں بیٹھ جاتے، اور خود سے باتیں کرتے

803
00:57:33,255 --> 00:57:35,788
آپؓ بلند آواز میں یہ فرماتے؛

804
00:57:35,829 --> 00:57:38,194
ألا ليلة شهري هل أبيتنَّ ليلةً

805
00:57:38,474 --> 00:57:40,934
بوادٍ وحولي إزخَرًا وجليلُ

806
00:57:41,173 --> 00:57:46,010
وهل أردنا يومًا مياحه مجنةٍ وهل يبدوانَّ لي شامةٌ وطفيلُ

807
00:57:46,495 --> 00:57:51,949
حضرت بلال نے فرمایا؛ ہم کبھی "ازخر" اور" جلیل " سے گِھری وادی میں رات گزاریں گے

808
00:57:52,006 --> 00:57:54,858
 ازخر اور جلیل دو پودے ہیں جو مکہ میں اگتے ہیں

809
00:57:54,914 --> 00:58:01,665
آپؓ نے فرمایا؛ کیا کبھی ایسا وقت آئے گا جب میں ازخر اور جلیل سے گھری ہوئی وادی میں رات گزاروں گا؟

810
00:58:01,696 --> 00:58:04,588
  کیا میں کبھی مکہ مکرمہ میں مجنۃ کے پانیوں کی سیر کروں گا؟

811
00:58:04,647 --> 00:58:09,261
اور کیا میں کبھی مکہ مکرمہ کے بلند و بالا پہاڑ شامہ اور طفیل کو دیکھ سکوں گا؟

812
00:58:09,327 --> 00:58:11,821
حضرت بلالؓ مکہ مکرمہ کو بہت شدت سے یاد کر رہے تھے

813
00:58:11,887 --> 00:58:15,487
اور وہ شاعری کے زریعے بلند آواز میں اپنے جزبات کا اظہار کر رہے تھے

814
00:58:15,568 --> 00:58:19,247
حضرت عائشہؓ واپس حضرت محمدﷺ کے پاس گئیں

815
00:58:19,314 --> 00:58:24,459
اور آپؐ کو تمام صورتِ حال سے آگاہ کیا، رسول اللہؐ صحابہ کی حالت سن کر آبدیدہ ہو گۓ

816
00:58:24,549 --> 00:58:27,813
کیونکہ رسول اللہؐ ہی صحابہؓ کو مدینہ لائے تھے

817
00:58:27,845 --> 00:58:32,939
صحابہؓ نے اپنے گھر قربان کیے،انھوں نے اپنے خاندان قربان کیے

818
00:58:33,019 --> 00:58:42,411
وہ مکہ چھوڑ کر ایک پردیس میں آئے جہاں بیماریوں میں مبتلا تھے، انہوں نے یہ سب کچھ حضرت محمدﷺ کے لیے کیا

819
00:58:42,467 --> 00:58:46,717
تو رسول اللہؐ رو پڑے اور پھر دعا فرمائی؛

820
00:58:46,774 --> 00:58:52,066
اللهم حب إلينا المدينةَ كحبنا مكة أو أشدَّ حبَّا،

821
00:58:52,840 --> 00:58:57,095
 أللهم باركلنا في مدِّها وسعيها وأنقل هُمَّاحا إلى جهفة

822
00:58:57,809 --> 00:59:00,517
بخاری شریف میں روایت ہے کہ رسول اللہ ﷺ نے یہ دعا فرمائی اور فرمایا؛

823
00:59:00,580 --> 00:59:07,186
یا اللہ ہمیں مدینہ کی ایسی محبت عطا کر جیسی ہم مکہ سے محبت کرتے ہیں یا اس سے بھی زیادہ

824
00:59:07,260 --> 00:59:12,046
اور اے اللہ اس کو بابرکت بنا دے اور اے اللہ اس سرزمین کو بخار سے نجات دے

825
00:59:12,101 --> 00:59:17,153
اس مرض کومدینہ سے نکال کرالجعفہ میں منتقل فرمادے

826
00:59:17,196 --> 00:59:19,623
مکہ مکرمہ کیسے بابرکت ہوا؟

827
00:59:19,710 --> 00:59:23,349
حضرت ابراہیمؑ کی دعا کے ذریعے

828
00:59:23,410 --> 00:59:27,048
اس وقت مدینہ میں کچھ خاص نہیں تھا

829
00:59:27,129 --> 00:59:31,581
لیکن رسول اللہؐ نے یہ دعا مدینہ کی برکت کے لیے کی تھی

830
00:59:31,632 --> 00:59:36,501
اور رسول اللہؐ نے یہ دعا فرمائی کہ یہ مدینہ ہمیں مکہ مکرمہ سے زیادہ محبوب ہوجاۓ

831
00:59:36,571 --> 00:59:44,829
اور اس کے بعد سے ہرمومن مکہ سے بڑھ کر مدینہ سے محبت کرتا ہے

832
00:59:44,873 --> 00:59:50,565
اگر آپ مکہ مکرمہ اور مدینہ منورہ گئے ہیں تو آپ مدینہ کے اندر پہنچیں گے تو آپ کو یہ بالکل مختلف احساس ہوگا

833
00:59:50,623 --> 00:59:52,958
 ہوا میں طمانیت بخش احساس ہوتا ہے

834
00:59:53,023 --> 00:59:56,825
یہ رسول اللہؐ کی دعا کی برکت ہے

835
00:59:56,877 --> 01:00:00,939
اللهم حب إلينا المدينةَ كحبنا مكة أو أشدَّ حبَّا،

836
01:00:01,617 --> 01:00:07,754
اور درحقیقت مدینہ سے محبت کرنا ایمان کی نشانی ہے

837
01:00:07,824 --> 01:00:16,603
حضرت ابوبکر صدیقؓ اور صحابہ کرامؓ جو افسردہ تھے اور مکہ واپس جانے کی آرزو کر رہے تھے

838
01:00:16,681 --> 01:00:20,652
جب انہیں واپس مکہ جانے کا موقع ملا تب بھی واپس نہیں گۓ

839
01:00:20,689 --> 01:00:25,920
اور (فتح مکہ کے بعد)جب مکہ جانے کے تمام راستے ہموار ہو گۓ تب بھی تمام صحابہ، رسول اللہؐ کے ساتھ مدینہ واپس چلے گئے

840
01:00:25,979 --> 01:00:28,489
حضرت ابوبکر صدیقؓ نے اپنے دورِخلافت میں مدینہ کو دارالحکومت بنایا

841
01:00:28,539 --> 01:00:32,222
حضرت عمر بن خطابؓ اور حضرت عثمانؓ نے بھی اپنے ادوارمیں مدینہ کو دارالحکومت بنایا

842
01:00:32,292 --> 01:00:35,988
اور اگر وہ حالات نہ ہوتے جنہوں نے حضرت علیؓ کو باہر(عراق) جانے پر مجبور کیا

843
01:00:36,047 --> 01:00:41,695
تو حضرت علیؓ بھی دیگر صحابہ کرامؓ کی طرح مدینہ میں ہی قیام کرتے، رضی اللہ عنہ، رضي الله عن صحابه اجمعین

844
01:00:41,770 --> 01:00:48,364
وصلوات الله ولسلام علي سيد الأولين والآخرين والحمدلله رب العلمين

