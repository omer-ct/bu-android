1
00:01:48,276 --> 00:01:51,876
اَعُوْذُ بِاللهِ مِنَ الشَّيْطَانِ الرَّجِيْم ۞بِسمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ۞

2
00:01:51,893 --> 00:01:59,882
اَلْحَمْدُ لِلّٰه وَالصَّلَاةُ وَالسَّلَامُ عَلٰى سَيِّدِالْاَوَّلِيْنَ وَالْآخِرِيْنَ مُحَمَّدِ اِبْنِ عَبْدُ اللهِ وَعَلٰى اٰلِهِ وَصَحْبِهِ وَسَلِّمْ تَسْلِيْمًا كَثِيْرًا

3
00:01:59,903 --> 00:02:00,995
 اَمَّابَعْدُ

4
00:02:01,668 --> 00:02:05,826
اَلسَّلَامُ عَلَيْكُمْ وَرَحْمَةُ الله وَبَرَكَاتُهُ

5
00:02:06,452 --> 00:02:12,102
يَقُوْلُ تَعَالٰى؛ يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ حَقَّ تُقَاتِهِ وَلَا تَممُوتُنَّ إِلَّا وَأَنْتُمْ مُسْلِمُونَ۞

6
00:02:12,363 --> 00:02:18,254
اَللہ عَزَّ وَجَلَّ کا ارشاد ہے؛ اے ایمان والو اللہ سے ڈرو، موت تمہیں نہ آےؑ ماسواےؑ تقوٰی کی حالت کے

7
00:02:18,279 --> 00:02:21,774
ہم اَللہ تبارک وتعالی سے دُعا گو ہیں کہ وہ ہم سب کو تقوٰی عطا فرمائے

8
00:02:21,814 --> 00:02:28,600
سُنَنَ الْبَغْوی میں حضرت عَبدُاللہ اِبن مَسعُودؓ فرماتے ہیں؛

9
00:02:28,647 --> 00:02:35,952
مَنْ كَانَ مُسْتَنًّا فَلْيَسْتَنَّ بِمَنْ قَدْ مَاتْ، فَإنَّ الْحَيَّ لَا تُؤمَنُ عَلَيْهِ الْفِتْنَةَ

10
00:02:36,539 --> 00:02:42,414
أوْلٰئِكَ اَصْحَابُ مُحَمّدٍ، صَلَوَاتُ اللهِ وَسَلَامُ عَلَيْه

11
00:02:44,314 --> 00:02:46,364
كَانُوْا وَاللهِ اَفْضَلُ هَذِهِ الّأمَّۃ

12
00:02:46,768 --> 00:02:51,905
وَاَبَرُّهَا قُلُوْبًا ، وَأعْمَقُهَا عِلْمًا، وَأقَلُّهَا تَكَلُّفًا

13
00:02:52,767 --> 00:02:56,645
قَوْمُ اُخْتَارَهُمُ الله لِصَحْبَةِ نَبِيِّهِ وَإقَامَةِ دِيْنِه

14
00:02:57,597 --> 00:03:01,626
فَإعْرَفُوْا لَهُمْ فَضْلَهُمْ ، وَأتْبَعُوْ هُمْ فِيْ اٰثَارِهِمْ

15
00:03:02,114 --> 00:03:07,525
وَتَمَسَّكُوْا بِمَا اسْتَطَعْتُمْ مِنْ اَخْلَاقِهِمْ وَ دِيْنِهِمْ ، فَاِنَّهُمْ كَانُوْا عَلَى الصَّرَاطِ الّمُسْتَقٍيْمَ

16
00:03:09,530 --> 00:03:11,826
حضرت عَبْدُاللہِ اِبنِ مَسْعُودؓ  فرماتے ہیں کہ

17
00:03:11,847 --> 00:03:15,113
مَنْ كَانَ مُسْتَنًّا فَلْيَسْتَنَّ بِمَنْ قَدْ مَاتْ

18
00:03:16,393 --> 00:03:23,451
تم میں سے اگر کوئی کسی طریقت کا پیروکار بننا چاہتا ہے، تو اسے چاہیئے اپنے(گزرے ہوئے) اجداد کی پیروی کرے

19
00:03:23,472 --> 00:03:25,625
فَإنَّ الْحَيَّ لَا تُؤمَنُ عَلَيْهِ الْفِتْنَةَ

20
00:03:26,193 --> 00:03:30,410
کیونکہ زندہ لوگ آزمائشوں میں ناکام بھی ہوسکتے ہیں

21
00:03:30,439 --> 00:03:32,301
اُوْلٰئِكَ اَصْحَابُ مُحَمَّدٍﷺ

22
00:03:33,206 --> 00:03:38,019
اور وہ (پیروی کے قابل لوگ) حضرت مُحمّدﷺ کے صحابہ کرامؓ ہیں

23
00:03:38,039 --> 00:03:42,842
حضرت عَبدُاللہ اِبنِ مَسعُودؓ تَبع تابعِین سے مخاطب ہو کر فرما رہے ہیں

24
00:03:42,874 --> 00:03:47,997
(تابعین)جو صحابہ کرام کے بعد اُمت میں سے افضل ہیں، آپؓ اُن سے فرما رہے ہیں؛

25
00:03:48,018 --> 00:03:51,493
اپنے ساتھ رہنے والے لوگوں کی پیروی نہ کرو

26
00:03:51,522 --> 00:03:54,235
بِلاشُبہ اُن میں اَللہ عزّوَجَل کے اَولِیاء ہوں گے

27
00:03:54,254 --> 00:03:58,890
اُن میں سے بہت سے صَالِحِین، مُجاھِدین، عُلماء اور عِبادت گُزار بھی ہوں گے

28
00:03:58,911 --> 00:04:00,596
حضرت عَبدُاللہ اِبنِ مَسعُودؓ اُن(تابعین) سے فرما رہے ہیں کہ

29
00:04:00,643 --> 00:04:03,443
اپنے درمیان رہنے والے لوگوں کی پیروی نہ کرو بلکہ اپنے سے پہلے لوگوں کا اِتِّباع کرو

30
00:04:03,478 --> 00:04:06,162
یعنی رَسُولُ اللہؐ کے صحابہ کرامؓ

31
00:04:06,192 --> 00:04:07,095
کیوں؟

32
00:04:07,125 --> 00:04:14,474
کیونکہ کوئی ضمانت نہیں کہ زندہ شخص درپیش فتنوں میں نہیں پڑے گا

33
00:04:14,506 --> 00:04:19,789
لیکن صحابہ کرامؓ پر اللہ کی رضا و خوشنودی کی مہر لگی ہوئی ہے

34
00:04:19,829 --> 00:04:23,902
سو یاد رکھو، کہ ہم نہیں جانتے کہ جو زندہ ہیں اُن کا خاتمہ کیسے ہو گا؟

35
00:04:23,935 --> 00:04:25,361
کیونکہ رَسُولُ اللہؐ کا اِرشاد ہے؛

36
00:04:25,394 --> 00:04:31,195
کچھ لوگ ایسے ہوں گے، جو اہلِ جَنَّت کے راستے پر ہوں گے

37
00:04:31,227 --> 00:04:32,992
 اپنی عبادات اور اپنے اعمال میں

38
00:04:33,037 --> 00:04:37,738
 وہ اہلِ جَنَّت کی طرح عمل کریں گے لیکن مرنے سے پہلے

39
00:04:37,772 --> 00:04:43,041
وہ جَہنُّمی لوگوں جیسے اعمال کا ارتکاب کر بیٹھیں گے اور پھر وہ جَہنُّم کی آگ میں چلےجائیں گے

40
00:04:43,087 --> 00:04:46,723
کیوں؟  کیوںکہ وہ فتنہ میں مبتلا ہو جائیں گے

41
00:04:46,748 --> 00:04:49,157
ہم میں سے ہر ایک کو آزمائشوں سے گذرنا ہے

42
00:04:49,190 --> 00:04:52,750
اور کوئی نہیں جانتا کہ اِن آزمائشوں کا نتیجہ کیا نکلے گا؟

43
00:04:52,775 --> 00:04:54,378
اور اِسی لیے رَسُولُ اللہؐ فرمایا کرتے تھے

44
00:04:54,403 --> 00:04:57,879
يَا مُقَلِّبَ الْقُلُوْبِ وَالْاَبْصَارْ ثَبِّتْ قُلُوْبَنَا عَلَى دِيْنِكْ

45
00:04:58,433 --> 00:05:03,058
اے دِلوں کو پھیرنے والے ہمارے دِلوں کو اِسلام پر ثابت قدم رکھ(آمین)

46
00:05:03,096 --> 00:05:06,001
دل، لفظ ''قلب'' کا عربی زبان میں مطلب ہے "کوئی چیز جو بدل جائے"

47
00:05:06,026 --> 00:05:10,181
اُلٹ جانے والی شے، اوپر نیچے(لڑکھڑا) جانے والی شے

48
00:05:10,219 --> 00:05:14,338
چنانچہ حضرت عَبدُاللہ اِبن مَسعُودؓ فرما رہے ہیں؛ رَسُولُ اللہؐ کے صحابہؓ کی پیروی کرو

49
00:05:14,355 --> 00:05:18,681
آپؓ یہ بات تبع تابعینؒ سے فرما رہے تھے، جو صحابہؓ کےبعد افضل ترین ہستیاں ہیں

50
00:05:18,706 --> 00:05:22,820
کیا آج ہم کچھ بھی یقین سے کہنے کے قابل ہیں؟

51
00:05:22,842 --> 00:05:26,500
ہم میں سے کسی کے پاس ضمانت نہیں! کوئی بھی یقین سے نہیں کہہ سکتا کہ ہم جَنَّت میں جائیں گے

52
00:05:26,519 --> 00:05:28,840
کوئی بھی نہیں

53
00:05:28,867 --> 00:05:34,473
لیکن وہ لوگ جو رَسُولُ اللہؐ کے ہمراہ تھے، وہ لوگ جنھوں نے غَزوۂِ بدر میں شرکت کی

54
00:05:34,498 --> 00:05:37,792
وہ لوگ جنھوں نے بیعتِ رضوان کے موقع پر بیعت کی

55
00:05:37,825 --> 00:05:41,058
وہ لوگ جنہوں نے رَسُولُ اللہؐ کے ہمراہ جھاد کیا اور ثابت قدم رہے

56
00:05:41,101 --> 00:05:43,875
یہ وہ لوگ تھے کہ جب رَسُولُ اللہؐ کا وصال ہوا

57
00:05:43,909 --> 00:05:45,697
مَاتَ وَهُوَعَنْهُمْ رَاضٍی

58
00:05:46,398 --> 00:05:50,665
 رَسُولُ اللہؐ اُن سے راضی تھے، یہ تھے وہ لوگ جن کی ہمیں پیروی کرنی ہے

59
00:05:50,707 --> 00:05:54,542
اور پھر حضرت عبداللہ اِبِن مسعودؓ کچھ اور وجوہات بھی بیان فرماتے ہیں کہ کیوں ہمیں صحابہؓ کا اِتِّباع کرنا چاہیے؟ آپؓ فرماتے  ہیں؛

60
00:05:54,562 --> 00:05:56,175
كَانُوْا وَاللهِ أفْضَلَ هَذِهِ الّأمَّةَ

61
00:05:56,200 --> 00:05:59,582
وہ(صحابہ) اِس اُمَّت کے بہترین لوگ تھے

62
00:05:59,622 --> 00:06:01,631
خَيْرُالْقُرُوْنِ قَرْنِيْ

63
00:06:02,157 --> 00:06:06,358
رَسُولُ اللہؐ نے فرمایا؛ بہترین لوگ میرے زمانے کے لوگ ہیں

64
00:06:06,390 --> 00:06:09,213
یہ (صحابہؓ) بہترین لوگ ہیں

65
00:06:09,247 --> 00:06:12,132
كَانُوْا وَاللهِ أفْضَلَ هَذِهِ الّأمَّةَ؛

66
00:06:12,512 --> 00:06:14,298
وَأبَرُّهَا قُلُوْبًا

67
00:06:14,693 --> 00:06:17,736
اور اُن کے دلوں میں تقویٰ تھا

68
00:06:17,768 --> 00:06:19,964
اُن کے دِل خشیتِ الٰہی سے لبریز تھے

69
00:06:20,003 --> 00:06:24,801
  تقوٰی وپرہیزگاری میں صحابہ کا کوئی جوڑ نہیں تھا

70
00:06:24,848 --> 00:06:28,847
وہ(صحابہ کرام) اعلیٰ ترین مقام پر فائز ہوئے

71
00:06:28,872 --> 00:06:30,535
وَاَعْمَقُهَا عِلْمًا

72
00:06:32,094 --> 00:06:34,287
اور صحابہ کرامؓ کے پاس سب عمیق علم تھا

73
00:06:34,314 --> 00:06:37,087
اب یہاں حضرت عَبدُاللہ اِبن مَسعُودؓ کے الفاظ کے انتخاب پر غور فرمائیں

74
00:06:37,116 --> 00:06:38,380
حضرت عَبدُاللہ اِبن مَسعُودؓ نے یہ نہیں فرمایا کہ

75
00:06:38,401 --> 00:06:39,781
"وَاَكْثَرُهَا عِلْمًا"

76
00:06:40,386 --> 00:06:42,633
آپؓ نے یہ نہیں فرمایا کہ اُن کے پاس سب سے زیادہ عِلم تھا

77
00:06:42,676 --> 00:06:45,276
آپؓ نے فرمایا؛ اُن کے پاس عِلم کا گوہرِ نایاب تھا(یعنی حکمت بھی)

78
00:06:45,319 --> 00:06:47,442
کیونکہ صحابہ کرامؓ کے بعد آنے والے بہت سے لوگ ایسے تھے

79
00:06:47,463 --> 00:06:51,769
جو عِلم و حکمت کا ایسا بے بہا خزانہ رکھتے تھے، جو شائد صحابہ کرامؓ کے پاس بھی نہیں تھا

80
00:06:51,795 --> 00:06:57,814
مثال کے طور پر امام بخاریؒ ہیں، آپؒ علمِ حدیث پر کئی صحابہ پر سبقت رکھتے تھے

81
00:06:57,849 --> 00:07:00,349
کیوں؟ کیونکہ آپؒ کے پاس اُن احادیث کا بھی علم تھا جو کہ حضرت عُمرؓ کے پاس تھیں

82
00:07:00,370 --> 00:07:01,896
آپؒ ان احادیث سے بھی واقف تھے جو حضرت ابُوبکرؓ کے پاس تھیں

83
00:07:01,936 --> 00:07:03,873
امام بخاریؒ اُن  احادیث سے بھی واقف تھے، جو حضرت عُثمانؓ کے پاس تھیں

84
00:07:03,918 --> 00:07:06,760
امام بخاریؒ حدیث کا انسائیکلوپیڈیا(مجمع العلوم) تھے

85
00:07:06,794 --> 00:07:10,984
جب فِقہ کی بات آتی ہے تو اِس اُمَّت کے بعض عظیم فقہاء ایسے ہیں

86
00:07:11,022 --> 00:07:17,672
 جو نہ صرف ایک صحابیؓ کی فِقہ کو جمع کرتے تھے، بلکہ دیگر کئی صحابہ کے فقہی علوم سے بھی مستفیض ہوتے تھے

87
00:07:17,714 --> 00:07:20,413
چُنانچِہ حضرت عَبدُاللہِ اِبنِ مَسعُودؓ نے یہ نہیں فرمایا کہ وہ(صحابہ) سب سے زیادہ عِلم رکھتے تھے

88
00:07:20,438 --> 00:07:22,715
بلکہ آپؓ نے فرمایا کہ اُن(صحابہ) کے پاس عمیق عِلم تھا

89
00:07:22,742 --> 00:07:31,737
اگرچہ بعض عُلَماءِ حدِّیث یا فُقہ کے علماء، وہ چیزیں جانتے تھے جو بعض صحابہؓ کے عِلم میں نہ تھیں

90
00:07:31,771 --> 00:07:32,877
تاہم؛

91
00:07:32,905 --> 00:07:37,120
صحابہ کرامؓ کے بعد آنے والے لوگوں میں سے کسی کے پاس بھی عِلم کا وہ بیش بہا خزانہ نہیں جو صحابہؓ کے پاس تھا

92
00:07:37,145 --> 00:07:40,190
وہ(صحابہ) ہر لحاظ سے ہم سب پر برتری رکھتے ہیں

93
00:07:40,226 --> 00:07:44,156
صحابہ کرامؓ نُزولِ قرآن کے عینی شاہد تھے

94
00:07:44,173 --> 00:07:46,963
انہوں نے اس کی تعلیمات کے مطابق زندگی گزاری، قرآن پر سب سے پہلے عمل کیا

95
00:07:47,007 --> 00:07:51,658
پس ہر وہ شخص جو صحابہؓ کے بعد آیا، وہ اُس عِلم کے سمندر کی سطح تک ہی پہنچ پایا

96
00:07:51,701 --> 00:07:55,340
لیکن صحابہؓ کے پاس عِلم کی گہرائی تھی

97
00:07:55,360 --> 00:07:57,653
ان کا فہم عمیق تھا

98
00:07:57,684 --> 00:08:08,706
اور جب آپ کو(دین کا) مکمل فہم ہوگا تو آپ کا طرزِ زِندگی اور عمل اُس شخص سے بہتر ہو گا جو آپ سے زیادہ علم رکھتا ہے

99
00:08:08,755 --> 00:08:14,274
 اور اس لیے ہمیں صحابہ کرامؓ کی پیروی کرنی چاہیے

100
00:08:14,295 --> 00:08:19,408
کیونکہ وہ (صحابہ)علم و حکمت کے بحرِ بیکراں تھے

101
00:08:19,443 --> 00:08:21,364
وَأقَلُهَا تَكَلُفًا

102
00:08:23,157 --> 00:08:27,890
اور اُن کے اندر تَصَنُّع اور بناوٹ نہیں تھی

103
00:08:27,931 --> 00:08:33,722
صحابہ کرامؓ اسلام پر صرف ظاہری طور پہ عمل نہیں کرتے تھے

104
00:08:33,757 --> 00:08:38,699
وہ صرف دکھاوا نہیں کرتے تھے نہ ہی وہ ریاکار تھے

105
00:08:38,723 --> 00:08:41,719
وہ اپنی فصاحت و بلاغت کا پرچار نہیں کرتے تھے

106
00:08:41,750 --> 00:08:45,798
اب ہمارے پاس جو کتابیں ہیں ان کا علمی معیار یہ ہے

107
00:08:45,828 --> 00:08:49,364
کہ ایک بھائی آتا ہے اور کہتا ہے ماشاء اللہ یہ(فلاں) ایک شاندار کتاب ہے

108
00:08:49,403 --> 00:08:52,737
  میں نے یہ مکمل پڑھی ہے اور میں اس کا فہم حاصل نہیں کرسکا

109
00:08:52,769 --> 00:08:55,364
اتنی فصیح و بلیغ کتاب ہے

110
00:08:55,395 --> 00:08:57,983
 صحابہؓ کا یہ انداز نہیں تھا

111
00:08:58,014 --> 00:09:03,091
صحابہؓ کے طور طریقے سادہ تھے ، ان کے بیانات مختصر ہوتے تھے

112
00:09:03,124 --> 00:09:06,578
 اُن کے الفاظ مختصر اور عام فہم تھے

113
00:09:06,613 --> 00:09:16,170
وہ فصیح وبلیغ الفاظ کا استعمال کر کے، اور شاعرانہ زبان استعمال کر کے، یہ ثابت کرنے کی کوشش نہیں کرتے تھے کہ وہ عالم فاضل ہیں

114
00:09:16,208 --> 00:09:18,845
ان کی باتیں بہت سادہ تھیں

115
00:09:18,869 --> 00:09:23,458
کیونکہ صحابہ کرامؓ کا پسِ منظر سادہ تھا

116
00:09:23,489 --> 00:09:30,635
 عرب کے لوگ دیگر قوموں کی طرح مخلوط النسل نہیں تھے

117
00:09:30,671 --> 00:09:36,070
 وہ فارسیوں اور رومیوں کے پُرتَعیُّش طرزِ زندگی سے متأثر نہیں تھے

118
00:09:36,104 --> 00:09:39,030
وہ یونانی فلسفے سے متأثر نہیں ہوئے

119
00:09:39,067 --> 00:09:42,867
وہ لاطینیوں کے علمُ الٰہیات سے متأثر نہیں ہوئے

120
00:09:42,909 --> 00:09:48,396
صحابہ کرامؓ میں سے اکثر ناخواندہ تھے

121
00:09:48,424 --> 00:09:52,949
وہ بہت سادہ ،راست گو، ایماندار، با اخلاق انسان تھے

122
00:09:52,983 --> 00:09:57,969
حتّٰی کہ جاہلیت کے زمانے میں عربی شاعری بھی بہت سادہ تھی، فلسفیانہ نہیں تھی

123
00:09:58,008 --> 00:10:01,800
اُس شاعری کی زبان سادہ تھی، وہ فطرت پہ شاعری کرتے تھے، وہ عورتوں پہ شاعری کرتے تھے

124
00:10:01,825 --> 00:10:05,425
یہ اُن(عربوں) کی شاعری تھی

125
00:10:05,463 --> 00:10:12,378
حتّیٰ کہ جن رومانوی کہانیوں کا ذکر وہ اپنی شاعری میں کرتے، وہ بھی بہت سادہ تھیں

126
00:10:12,435 --> 00:10:19,638
یہ رُومیو اور جولیٹ کی طرح نہیں تھیں، یہ بہت سادہ تھیں

127
00:10:19,683 --> 00:10:27,284
اُن کے لباس میں سادگی تھی اور اُن کی خوراک بھی سادہ تھی

128
00:10:27,316 --> 00:10:32,303
اور اسی لیے صحابہ کرامؓ کی فطرت بہت پاکیزہ تھی

129
00:10:32,352 --> 00:10:36,450
چنانچہ جب انہوں نے اسلام قبول کیا

130
00:10:36,485 --> 00:10:45,026
اُن کے لیے اسلام پر عمل کرنا آسان تھا کیونکہ قرآن اُن کے خالص دلوں پہ نازل ہوا تھا

131
00:10:45,060 --> 00:10:50,857
جہاں تک دیگراقوام کا تَعلُّق ہے،  قرآن نے اُن قوموں کے دِلوں کو صاف کرنا تھا

132
00:10:50,890 --> 00:10:55,018
 قرآن نے گمراہی کی اُن نشانیوں کو دور کرنا تھا، جو اُن قوموں کی پہلی زِندگی(قبل از اسلام) میں موجُود تھیں

133
00:10:55,062 --> 00:10:57,953
کیونکہ اُن کا(نیک) فطرت مسخ ہوچکی تھی

134
00:10:57,973 --> 00:11:02,706
 اور اِسی لیے بدعات، اختراعات، مکّہ اور مدینہ میں شروع نہیں ہوئیں

135
00:11:02,733 --> 00:11:15,186
بلکہ وہ بدعات عراق اور شام سے شروع ہوئیں؛ اُن قوموں سے جو یونانی فلسفہ سے اور دیگر اقوام کی مذہبی تعلیمات سے  متأثر تھیں

136
00:11:15,214 --> 00:11:21,337
آپ جانتے ہیں کہ عربوں کے مذہب میں توہم پرستی، فرضی تصورات نہیں تھے، جیسے کہ ہندومت اور یونانی مذاہب میں ہوتے ہیں

137
00:11:21,372 --> 00:11:27,089
اُن کے پاس ایسے تصوُّرات نہیں تھے، عرب صرف پتھَّر اور بُتوں کو پوجتے تھے

138
00:11:27,121 --> 00:11:33,099
وہ سچائی، بہادری، وفاداری جیسی خوبیوں کے حامل تھے

139
00:11:33,126 --> 00:11:37,459
اپنے قبیلے کا وفادار ہونا، یہی اُن کا مذہب تھا

140
00:11:37,496 --> 00:11:41,645
حقیقت میں یہ(صرف) مذہب نہیں تھا، یہ اخلاقی اقدار کا ایک مجموعہ تھا

141
00:11:41,675 --> 00:11:45,934
وہ صرف ایک بُت کے آگے جُھکتے اور اس کے لئے جانور ذبح کرتے

142
00:11:45,968 --> 00:11:48,841
  لہذا ان کا مذہب سادہ تھا

143
00:11:48,861 --> 00:11:57,661
  چنانچہ جب وہ مسلمان ہوئے، انہوں نے اِسی سادگی، ایمانداری اور شائستگی کو فروغ دیا

144
00:11:57,692 --> 00:12:00,319
چنانچہ جب وہ مسلمان ہوئے تو وہ اسلامی تعلیمات کاعملی نمونہ بن گئے

145
00:12:00,344 --> 00:12:05,510
 وہ فلسفیانہ، تصوراتی مذہبی گفتگو کا حصہ نہیں بنے

146
00:12:05,557 --> 00:12:07,867
صحابہ کرامؓ کا یہ طرزِ عمل نہیں تھا

147
00:12:07,916 --> 00:12:12,833
یہ چیزیں بعد میں حضرت عُمرؓ و حضرت عُثمانؓ اور حضرت علیؓ کے دور خلافت میں آئیں

148
00:12:12,880 --> 00:12:22,149
جب دوسری قومیں اسلام قبول کر رہیں تھیں، اور وہ مسئلہِ تقدیر پہ بحث و مباحثہ کر رہیں تھیں، یہ شعبہ علم و الہیات؛ اُن کا موضوع بن گیا

149
00:12:22,177 --> 00:12:31,978
تو حضرت عُمر اِبن خطابؓ اپنی چھڑی لئے اُن کے سر پر کھڑے تھے(مطلب اِس مباحثے کی کسی صورت اجازت نہ تھی)

150
00:12:32,005 --> 00:12:33,441
قَوْمُ اُخْتَارَهُمُ الله

151
00:12:33,466 --> 00:12:34,922
حضرت عبداللہ اِبن مسعودؓ مزید فرماتے ہیں؛

152
00:12:34,947 --> 00:12:39,073
قَوْمُ اُخْتَارَهُمُ الله لِصَحْبَةِ نَبِيِّهِ وَإقَامَةِ دِيْنِه

153
00:12:39,757 --> 00:12:45,072
یہ(صحابہ کرام) وہ لوگ تھے جنہیں اللہ تعالٰی نے اپنے نبیؐ کی رفاقت کے لئے منتخب فرمایا

154
00:12:45,119 --> 00:12:50,077
اور اپنے دین کی اقامت کے لئے اُن کا انتخاب کیا، یہی وجہ تھی کہ اَللہ نے اُنہیں منتخب فرمایا

155
00:12:50,109 --> 00:12:53,713
 اللہ نے کیوں اُن کا انتخاب کیا؟ وہ اللہ کے خاص مُنتخب کردہ لوگ تھے

156
00:12:53,748 --> 00:12:56,699
کہ وہ لوگ عظیم المرتبت نبیؐ کے صحابہ کے بنے

157
00:12:56,742 --> 00:12:57,819
لِكُلِّ نَبِّيٍ حَوَارِيْ

158
00:12:57,844 --> 00:13:01,252
رَسُولُ اللہؐ فرماتے ہیں؛ ہر نبی کے ساتھی ہوتے ہیں

159
00:13:01,290 --> 00:13:09,623
اللہ تعالٰی نے اِن صحابہؓ کو کسی خاص مقصد سے رَسُولُ اللہؐ کا رفیق منتخب فرمایا

160
00:13:09,656 --> 00:13:13,746
کیونکہ وہ اس ذمہ داری کو نبھانے کے لیے اہل ترین لوگ تھے

161
00:13:13,789 --> 00:13:20,158
جب رَسُولُ اللہؐ کا وصال ہوا، اللہ کو قیامت تک کسی اور نبیؐ کو بھیجنے کی ضرورت نہیں

162
00:13:20,183 --> 00:13:29,384
کیوں؟ کیونکہ صحابہؓ اس(دین کی ترویج کی) ذمہ داری کو بطریق احسن نبھا سکتے تھے

163
00:13:29,424 --> 00:13:31,954
تو ہم آج کس لئے صحابہ کرامؓ سے متعلق بات کر رہے ہیں؟

164
00:13:31,984 --> 00:13:36,104
مذکورہ بالا تمام وجوہات کی بنا پر، اور اس لئے بھی کہ حضرت عبداللہ اِبن مسعودؓ فرماتے ہیں؛

165
00:13:36,152 --> 00:13:38,268
فَإعْرَفُوْا لَهُمْ فَضْلَهُمْ

166
00:13:39,228 --> 00:13:42,960
اُن(صحابہ کرام) کے مقام و مرتبہ کو پہچانو

167
00:13:42,991 --> 00:13:47,260
پس ہم صحابہؓ کے مقام کو سمجھیں کہ وہ ہستیاں کس اوجِ کمال پر تھیں

168
00:13:47,293 --> 00:13:54,123
ہم اُن کی عزّت و تکریم کریں، اُن کے اعلیٰ و برتر مقام کو ملحوظِ خاطر رکھیں، اُن کا احترام کریں

169
00:13:54,167 --> 00:14:01,023
تو اب ہم پورا مہینہ صحابہ کرام میں سے ایک صحابیؓ کی شخصیت سے متعارف ہونے کے لئے اکٹھے ہوئے ہیں، اور وہ صحابی ہیں حضرت عُمر بن خطابؓ

170
00:14:01,079 --> 00:14:04,046
 جو کہ ہماری ایک ادنیٰ سی کاوش ہے

171
00:14:04,080 --> 00:14:05,583
لِمَعْرِفَةِ فَضْلَهُمْ

172
00:14:06,700 --> 00:14:15,459
 اُن ہستیوں کو پہچان لیں کہ وہ کس درجے پہ فائز ہیں ،انھیں عزت و عظمت کے بلند مقام پہ رکھیں اور پھر فرمایا؛

173
00:14:15,493 --> 00:14:17,240
وَأتْبَعُوْ هُمْ فِيْ أثَارِهِمْ

174
00:14:17,532 --> 00:14:20,586
اور صحابہ کرامؓ کے نقشِ قدم پر چلیں

175
00:14:20,624 --> 00:14:25,565
اُن کی پیروی کریں، اگر آپ کامیاب ہونا چاہتے ہو تو ہر عمل میں صحابہ کرامؓ کا اتباع کریں

176
00:14:25,611 --> 00:14:31,480
وَتَمَسَّكُوْا بِمَا أسْتَطَعْتُمْ مِنْ أخْلَاقِهِمْ وَ دِيْنِهِمْ ، فَإنَّهُمْ كَانُوْا عَللَى الهُدَى المُسْتَقٍيْمَ

177
00:14:31,962 --> 00:14:41,621
 اور جہاں تک ہو سکے صحابہ کرامؓ کی پیروی کرو اور اِس پر استقامت اختیار کرو؛ اُن کے کردار اور اُن کے مذہبی عقائد کو اپناؤ اِس لیے کہ وہ صراطِ مستقیم پر تھے

178
00:14:41,660 --> 00:14:43,214
صحابہ وہ ہستیاں ہیں جو ہدایت یافتہ تھے

179
00:14:43,261 --> 00:14:47,760
وہ اللہ عَزّوَجَلّ کے مقبول ترین بندے تھے

180
00:14:47,816 --> 00:14:52,297
اس لیے ہم عام طور پر صحابہ کرام ؓ کے بارے میں بات کرتے ہیں

181
00:14:52,350 --> 00:14:56,896
اور پھر صحابہ کرامؓ  میں سے ہم خلفائے راشدین کی شخصیات کو خصوصی اہمیت دیتے ہیں

182
00:14:56,921 --> 00:14:58,566
کیوں؟ کیونکہ رَسُولُ اللہؐ نے فرمایا؛

183
00:14:58,591 --> 00:15:04,067
فَعَلَيْكُمْ بِسُنَّتِي وَسُنَّةِ الْخُلَفَاءِ الرَّاشِدِينَ الْمَهْدِيينَ مِن بَعْدِيْ ، عَضُّوا عَلَيْهَا بِالنَّوَاجِذِ

184
00:15:05,366 --> 00:15:07,953
 رَسولُ اللہؐ نے فرمایا کہ میری سُنّت پہ عمل کرنا

185
00:15:07,995 --> 00:15:11,783
اور میرے بعد خلفائے راشدین جو ہدایت کے چراغ ہیں اُن کی سنّت پہ قائم ہو جانا

186
00:15:11,821 --> 00:15:13,536
اوروہ(خلفا) کون ہیں؟

187
00:15:13,583 --> 00:15:17,649
حضرت ابوبکرؓ ، حضرت عُمرؓ، حضرت عثمانؓ ، اور حضرت علیؓ

188
00:15:17,706 --> 00:15:22,422
اور اُن چار میں سے ہم خاص طور پر حضرت ابوبکرؓ اور حضرت عُمرؓ کے بارے میں بات کریں گے

189
00:15:22,470 --> 00:15:24,628
کیونکہ ایک اور حدیث میں رَسُولُ اللہؐ فرماتے ہیں؛

190
00:15:24,675 --> 00:15:28,864
اِقْتَدُوا بِاللَّذَيْنِ مِنْ بَعْدِي أَبِي بَكْرٍ وَعُمَرَ

191
00:15:28,898 --> 00:15:34,284
میرے بعد دو اصحابؓ کی پیروی کرنا، حضرت ابوبکرؓ کی اور حضرت عُمرؓ کی اور یہ روایت ترمذی میں مذکور ہے

192
00:15:34,328 --> 00:15:36,528
 اللہ عَزَّ وَجَل صحابہ کرام کے بارے میں ارشاد فرماتا ہے؛

193
00:15:36,561 --> 00:15:44,605
مُحَمَّدٌ رَسُولُ اللَّهِ ۚ وَالَّذِينَ مَعَهُ أَشِدَّاءُ عَلَى الْكُفَّارِ رُحَمَاءُ بَيْنَههُمْ ۖ تَرَاهُمْ رُكَّعًا سُجَّدًا

194
00:15:45,678 --> 00:15:52,943
حضرت محمدﷺ ، رسول اللہؐ اور اُن کے ساتھی کفَّار کے معاملے میں جابر اور بے رحم ہیں

195
00:15:52,963 --> 00:15:57,028
 اوروہ(صحابہ) مُومنوں کے ساتھ مہربان، نرم رو اور شائستہ مزاج ہیں

196
00:15:57,058 --> 00:16:05,531
اللہ تعالیٰ فرماتا ہے؛ آپ انہیں سجدے میں جُھکے ہوئے اور رُکوع کرتے ہوئے پائیں گے

197
00:16:05,580 --> 00:16:13,014
 گزشتہ نشست میں ہم حضرت ابوبکر صِدِّیقؓ کے بارے میں بات کر چُکے ہیں

198
00:16:13,054 --> 00:16:15,101
اب ہمارا موضوعِ سخن حضرت عُمرؓ کی ذاتِ اقدس ہے

199
00:16:15,141 --> 00:16:19,024
عزیز بھائیو اور بہنو! حضرت عُمرؓ ایک جلیل القدر شخصیَّت ہیں

200
00:16:19,064 --> 00:16:24,189
ہم یہ کہتے ہیں کہ حضرت ابوبکرؓ کی ذات کا خاص پہلو اُن کا ایمانی استقلال تھا

201
00:16:24,231 --> 00:16:27,009
جبکہ حضرت عُمر بن خطابؓ کی انفرادیت اُن کی بارُعب شخصیت تھی

202
00:16:27,039 --> 00:16:29,505
آپؓ ایک منفرد شخصیَّت کے مالک تھے

203
00:16:29,537 --> 00:16:33,465
 حضرت عُمرؓ جیسی عہد ساز شخصیت ہر دور کو میسر نہیں ہوتی

204
00:16:33,500 --> 00:16:39,271
رَسُولُ اللہؐ کا ارشاد ہے اور یہ حدیث بخاری اور مسلم میں مذکور ہے

205
00:16:39,302 --> 00:16:47,606
لَقَدْ كَان فِيما قَبْلَكُمْ مِنَ الأُممِ محدَّثونَ، فَإنْ يَكُ في أُمَّتي أَحَدٌ، فإنَّهُ عُمَرُ

206
00:16:48,801 --> 00:16:52,220
رَسُولُ اللہؐ فرماتے ہیں؛ گزشتہ اُمَّتوں میں ''محدّثون'' تھے

207
00:16:52,245 --> 00:16:54,567
اور میں''محدّثُون'' کے معنی و مطالب کی وضاحت کروں گا

208
00:16:54,612 --> 00:16:58,300
آپؐ نے فرمایا؛ مجھ سے پہلے کی اُمَّتوں میں محدّثُون تھے

209
00:16:58,331 --> 00:17:02,644
اور اگر میری اُمَّت میں کوئی محدِّث ہوگا تو وہ حضرت عُمرؓ ہوں گے

210
00:17:02,679 --> 00:17:06,621
اب محدِّث کا کیا مطلب ہے؟

211
00:17:06,664 --> 00:17:10,030
اِبنِ حَجرعَسقلانیؒ اپنی تفسیر البخاری میں قلم آراء ہیں

212
00:17:10,062 --> 00:17:11,510
آپؒ نے اس لفظ کی کئی تشریحات پیش کی ہیں

213
00:17:11,553 --> 00:17:18,736
ایک، مُلْهَمُوْنَ، وہ لوگ جن کو اللہ کی طرف سے اِلہام ہوتا ہے

214
00:17:18,777 --> 00:17:19,956
نمبر دو

215
00:17:19,973 --> 00:17:27,906
اَلرَّجُلُّ الصَّادِقُ الظَّنْ ، وَهُوَ مَنْ أُلْقِيَ فِيْ رَوْعِهِ شَيْءٌ مِنْ قِبَلِ الْمَلَأِ الْأَعْلَى

216
00:17:28,245 --> 00:17:38,983
وہ آدمی جس کا وجدان ہمیشہ درست ہوتا ہے کیوںکہ کچھ باتیں اُس کے دل پر پہلے سے نقش ہوتی ہیں

217
00:17:39,025 --> 00:17:39,935
تیسری رائے یہ ہے

218
00:17:39,960 --> 00:17:42,856
مَنْ يَجْرِي الصَّوَابُ عَلَى لِسَانِهِ بِغَيْرِقَصْدَ

219
00:17:43,562 --> 00:17:49,979
جو سچ بولتا ہے، اُس کی زبان پہ فطری طور پہ حق و صداقت کے کلمات جاری رہتے ہیں، بلا اِرادہ سچ بولنے والا؛ صادق

220
00:17:50,012 --> 00:17:54,457
بلا اِرادہ اُس کی زبان پہ سچ ہی جاری رہتا ہے

221
00:17:54,493 --> 00:17:56,277
اور چوتھی رائے یہ ہے کہ

222
00:17:56,323 --> 00:17:59,035
تُكَلِّمُهُ الْمَلَائِكَه بِغَيْرِ نَبُوَّةَ

223
00:17:59,296 --> 00:18:05,690
یہ وہ شخص ہے جس سے فرشتے ہمکلام ہوتے ہیں اگرچہ وہ نبی نہیں ہے

224
00:18:05,712 --> 00:18:07,950
اور وہ ہستی حضرت عُمرؓ ہیں

225
00:18:07,982 --> 00:18:14,775
آپؓ کی زبان فطری طور پر حق وصداقت کا پرچار کرتی تھی، آپؓ کا وجدان ہمیشہ درست ہوتا تھا

226
00:18:14,808 --> 00:18:18,555
 گویا فرشتے آپؓ سے گفتگو کر رہے ہوں

227
00:18:18,595 --> 00:18:22,082
ہم بعد میں کچھ ایسے واقعات کو بھی بیان کریں گے

228
00:18:22,123 --> 00:18:29,913
جن میں حضرت عُمرؓ نے کچھ فرمایا(کسی معاملے پہ) اور پھر اُن کی کہی ہوئی بات کے اِثبات میں قرآن کی آیات نازل ہوئیں

229
00:18:29,960 --> 00:18:36,519
گویا آپؓ نورِ الٰہی کی روشنی میں کلام کر رہے ہیں

230
00:18:36,564 --> 00:18:40,552
اور اِسی لیے حضرت عُمرؓ کی شخصیّت بہت خاص ہے اور اِسی لیے ہمیں حضرت عُمرؓ کے طرزِ عمل کی پیروی کرنی چائیے

231
00:18:40,577 --> 00:18:46,420
کیونکہ حضرت عُمرؓ وہ شخصیّت ہیں جنہوں نے حق کو پہچانا، حق بات کہی اور اُس پر استقامت اختیار کی

232
00:18:46,455 --> 00:18:47,767
رَسُولُ اللہؐ کا ارشاد ہے

233
00:18:47,792 --> 00:18:52,439
اِنَّ الله جَعَلَ الْحَقّ عَلَى لِسَانِ عُمَر وَعَلَى قَلْبِهَ

234
00:18:53,920 --> 00:18:58,896
اللہ عَزَّ وَجَلّ حضرت عُمرؓ کی زبان اور دل پر حق نازل فرماتا ہے

235
00:18:58,937 --> 00:19:01,629
اور یہ حدیث ترمذی میں مذکور ہے

236
00:19:01,660 --> 00:19:06,375
اور ترمذی میں ایک اور حدیث ہے جو درجے میں حسَن ہے کہ رَسُولُ اللہؐ نے فرمایا؛

237
00:19:06,415 --> 00:19:09,707
لَوْ كَانَ بَعْدِيْ نَبِيٌ لَكَانَ عُمر

238
00:19:10,343 --> 00:19:14,427
اگر میرے بعد کوئی نبی ہوتا تو وہ(نبی) حضرت عُمرؓ ہوتے

239
00:19:14,467 --> 00:19:21,989
حضرت عمر بن خطابؓ کی شخصیت میں انبیاء کی بہت سی صِفات تھیں

240
00:19:22,037 --> 00:19:26,455
اِسی لئے آپؐ نے فرمایا کہ اگر اس اُمَّت میں (میرے بعد) کوئی نبی ہوتا تو اللہ تعالٰی حضرت عُمرؓ کو منتخب فرماتا

241
00:19:26,503 --> 00:19:31,434
اور آپؓ، اللہ تعالٰی کے انبیاء میں سے سب سے زیادہ کس سے مشابہہ تھے؟

242
00:19:31,454 --> 00:19:34,398
حضرت موسیٰؑ سے

243
00:19:34,464 --> 00:19:43,408
رَسُولُ اللہؐ نے ایک حدیث میں فرمایا کہ اے عُمرؓ! آپ حضرت نوحؑ اور حضرت موسیٰؑ سے مشابہ ہو

244
00:19:43,450 --> 00:19:49,283
یہ انبیاء قوت و استقلال کا پیکر تھے

245
00:19:49,324 --> 00:19:58,119
ہم جانتے ہیں کہ حضرت عُمرؓ، حضرت موسیٰؑ کی مانند عصا اُٹھائے رکھتے تھے

246
00:19:58,153 --> 00:20:04,935
اِس سلسلے میں  ہمارا علمی مَأخذ یا ذرائع کیا ہیں

247
00:20:04,983 --> 00:20:11,614
 ظاہر ہے جب ہم تاریخ کے بارے میں بات کرتے ہیں تو ہمیں "کلاسیکل ذرائِع" کی طرف رُجوع کرنا پڑتا ہے

248
00:20:11,651 --> 00:20:13,847
وہیں تاریخ موجود ہے

249
00:20:13,881 --> 00:20:21,843
ان کلاسیکل ذرائع کا اصل مسئلہ یہ ہے کہ ہمارے اِبتدائی عُلماء کا یہ انداز تھا کہ وہ ہر چیز کو احاطہ تحریر میں لاتے تھے

250
00:20:21,872 --> 00:20:25,465
 حتیٰ کہ اگر اُنھیں عِلم بھی ہوتا تھا کہ فلاں فلاں معلومات مُسْتَند نہیں ہیں

251
00:20:25,485 --> 00:20:32,205
وہ پھر بھی اسے محفوظ کرنے کی خاطر اسے لکھ لیتے، وہ ہر چیز کو دستاویزی طور پہ رکھنا چاہتے تھے

252
00:20:32,252 --> 00:20:41,068
اس لیے اگرچہ ہم ''طبری'' سے استفادہ کر رہے ہیں لیکن ہم اس میں احتیاط برتیں گے، کیونکہ ''طبری'' کی بعض روایات زیادہ مستند نہیں ہیں

253
00:20:41,105 --> 00:20:48,140
کہیں بہت زیادہ مبالغہ آرائی، ضعیف روایتیں، بعض اوقات من گھڑت روایات بھی ہیں، اس لیے روایات بیان کرنے میں احتیاط برتنے کی ضرورت ہے

254
00:20:48,173 --> 00:20:54,420
تاہم اس سلسلے میں بنیادی مَأخذ ایک ہم عصر تصنیف ہوگی

255
00:20:54,453 --> 00:21:00,928
شیخ علی الصلابیؒ کی تصنیف کردہ ایک کتاب ہے، جو کہ اسلامی علوم کے ایک ماہر استاد ہیں

256
00:21:00,972 --> 00:21:06,467
ہم اُن کے اِس مَأخذ پر انحصار کر رہے ہیں کیونکہ انہوں نے کلاسیکل مأخذ پہ کُلّی طور پہ عمیق تحقیق کی ہے

257
00:21:06,500 --> 00:21:12,036
 اور آپؒ نے ان قدیم تصانیف میں سے عِلمی جواہرات اور بیش بہا معلومات کےخزانے نکالے ہیں

258
00:21:12,070 --> 00:21:14,383
اور انہیں ایک بہترین انداز میں ایک جگہ مُرَتّب کیا

259
00:21:14,418 --> 00:21:22,272
لہذا جب ہم حالیہ مَاخِذ کی بات کرتے ہیں، تو اسکا مطلب یہ ہرگز نہیں کہ اُنہوں نے اپنے الفاظ استعمال کیے ہیں، بلکہ یہ قدیمی کُتُب سے ماخذ حوالہ جات ہیں

260
00:21:22,293 --> 00:21:27,730
کیونکہ وہ قدیم کلاسیکی نسخوں سے معلومات کو، ایک مُسْتَند حوالہ کی شکل میں ترتیب دے رہے ہیں

261
00:21:27,766 --> 00:21:33,645
لہٰذا، شیخ علی الصلابیؒ کتاب کو ایک بنیادی مَأخذ کے طور پر استعمال کیا جائے گا اور اس کے بعد ''الطبری'' سے بھی استفادہ کیا جائے گا

262
00:21:33,676 --> 00:21:38,393
جو تاریخ کی ابتدائی کتابوں میں سے ایک تصنیف ہے

263
00:21:38,435 --> 00:21:39,548
ہم کِس موضوع پہ بات کریں گے

264
00:21:39,568 --> 00:21:46,092
 ہم حضرت عُمرؓ کا نام، آپؓ کا کردار، آپؓ کا خاندان اور آپؓ کی قبل اَز اِسلام زندگی پہ بات کریں گے

265
00:21:46,123 --> 00:21:51,397
اس کے علاوہ ہم آپؓ کی حیات بعد اَزقُبولِ اسلام، آپؓ کی ہجرت، حضرت عُمرؓ اور قرآن کے حوالے سے گفتگو کریں گے مزید برآں

266
00:21:51,421 --> 00:21:57,198
 حضرت عُمرؓ کا جہاد اور کچھ واقعات جو مدینہ میں پیش آئے

267
00:21:57,232 --> 00:22:02,237
 ہم آپؓ کے فضائل پربھی بات کریں گے اور حضرت ابوبکرؓ کے دورِ خلافت میں حضرت عُمرؓ کی زندگی بھی موضوعِ بحث ہو گی

268
00:22:02,269 --> 00:22:06,529
اور پھر ہم حضرت عمر بن خطابؓ کے دورِ خلافت پر بات کریں گے

269
00:22:06,564 --> 00:22:10,976
ہم حضرت عُمرؓ اور آپؓ کے خاندان اور حضرت عُمرؓ کے دور میں طرزِ معاشرت پر بھی بات کریں گے

270
00:22:11,007 --> 00:22:14,056
حضرت عُمر بن خطابؓ کا دورِ حکومت بھی ہمارا موضوعِ بحث ہو گا

271
00:22:14,070 --> 00:22:19,864
ہم اُن اسلامی فُتوحات  کے بارے میں بات کریں گے جو حضرت عُمرؓ کے زمانے میں ہوئیں تھیں، جو کہ عراق اور شام میں ہوئیں

272
00:22:19,902 --> 00:22:22,998
 اور پھر ہم آپؓ کے وصال کے دنوں کے بارے میں بات کریں گے

273
00:22:23,036 --> 00:22:28,081
تو، یہ ہمارے کورس کا خلاصہ  ہے

274
00:22:28,118 --> 00:22:32,497
تو آئیے شروع کرتے ہیں اور ہم اللہ سے دُعا گو ہیں کہ وہ ہمیں(نیکی کی) توفیق عطا فرمائے

275
00:22:32,537 --> 00:22:36,230
ہم اللہ تعالٰی سے دُعا گو ہیں کہ وہ ہمیں(عمل میں) اِخلاص عطا فرمائے

276
00:22:36,270 --> 00:22:39,717
ہم اللہ عَزَّ وَجَلّ سے دُعا گو ہیں کہ وہ ہمیں اِن نشستوں سے مستفید فرمائے

277
00:22:39,766 --> 00:22:44,143
 اور اِن محفلوں کو ایسا بنائے کہ جن کے گرد فرشتوں کا حصار ہو

278
00:22:44,188 --> 00:22:49,583
اللہ عَزّ وجَلّ ہم پر سکینہ اور رحمت نازل فرمائے

279
00:22:49,615 --> 00:22:55,099
 کیونکہ ہم صالحین میں سے ایک عظیم ہستی  کے بارے میں بات کر رہے ہیں اور ہمارا مقصد اُن جیسا طرزِ زندگی اپنانے کی کوشش ہے

280
00:22:55,132 --> 00:23:04,105
اور ہم اللہ عَزَّ وَجَلّ سے دعا گو ہیں کہ وہ ہمیں اُن لوگوں میں شامل کرے جو بہترین الفاظ کا انتخاب کر کے ان پہ عمل پیرا ہوتے ہیں

281
00:23:04,143 --> 00:23:11,618
ایک روایت کے مطابق حضرت عُمر بن خطابؓ کی پیدائش عام الفیل کے گیارہویں سال میں ہوئی

282
00:23:11,663 --> 00:23:15,163
جبکہ رَسُولُ اللہؐ کی ولادت عامُ الْفِیل کے سال میں ہوئی

283
00:23:15,200 --> 00:23:18,901
اُس وقت جب ابرہہ کی فوج نے کعبہ کو ڈھانے کی کوشش کی

284
00:23:18,949 --> 00:23:23,028
حضرت عمر بن خطابؓ، رَسُولُ اللہؐ سے گیارہ سال چھوٹے تھے

285
00:23:23,060 --> 00:23:29,382
چنانچہ مذکورہ رائے کے مطابق، حضرت عُمرؓ اُنتیس برس کے ہوں گے جب رَسُولُ اللہؐ کو نُبُوّت ملی

286
00:23:29,412 --> 00:23:33,942
اور آپؓ جب آپؓ مسلمان ہوئے، اُس وقت آپؓ کی عمر کچھ زیادہ ہو گی

287
00:23:33,963 --> 00:23:38,754
البتہ السیُّوطیؒ کا قول ہے کہ حضرت عُمرؓ کی عُمر اِس سے بھی کم تھی

288
00:23:38,808 --> 00:23:44,593
چنانچہ،السیُّوطیؒ  کے مطابق آپؓ کی عمر بیس کی دہائی کے اواخر میں تھی، جب آپؓ نے اسلام قبول کیا

289
00:23:44,613 --> 00:23:50,144
جیسا کہ سیرتِ حضرت ابوبکرؓ کی طرح؛ ہم حضرت عُمرؓ کی شخصیت کا بھی ایک تصوراتی خاکہ بنائیں گے

290
00:23:50,165 --> 00:23:58,503
کیونکہ تخیلاتی تصویر سے کسی بھی شخصیَّت کے بارے میں جاننے میں مدد ملتی ہے

291
00:23:58,533 --> 00:24:04,203
تو حضرت عُمربن خطابؓ کی جسمانی خدوخال کیسے تھے

292
00:24:04,234 --> 00:24:11,512
عزیز بھائیو اور بہنو! حضرت عُمر بن خطابؓ ایک دراز قد شخصیَّت کے مالک تھے

293
00:24:11,549 --> 00:24:16,274
جب بھی، آپؓ کسی مجمع میں ہوتے تو سب سے بلند قامت لگتے

294
00:24:16,317 --> 00:24:22,379
اور اس کی مثال ایسے ہے کہ جب بھی آپؓ کسی مجمع میں ہوتے اور لوگ اُن کو دُور سے دیکھتے

295
00:24:22,411 --> 00:24:29,026
تو لگتا کہ آپؓ اپنے گھوڑے پر سوار ہیں اور لوگ آپؓ کے ارد گرد کھڑے ہیں

296
00:24:29,056 --> 00:24:33,468
یوں لگتا تھا کہ گویا آپؓ اُونٹ کے اُوپر ہیں اور باقی سب اُن کے گرد جمع ہیں

297
00:24:33,517 --> 00:24:36,386
آپؓ ایک قد آور شخصیَّت کے حامل انسان تھے

298
00:24:36,440 --> 00:24:42,612
آپؓ کسی بھی مجمع میں سب سے دراز قد لگتے

299
00:24:42,657 --> 00:24:47,464
آپؓ کا جسم متناسب تھا، آپؓ کا وزن زیادہ نہیں تھا

300
00:24:47,484 --> 00:24:49,930
لیکن آپؓ کو ''مَجْدُوْلَّ اللَحَمْ'' سمجھا جاتا تھا

301
00:24:49,960 --> 00:24:57,909
آپؓ کے جسم پر بہت گوشت تھا، مگر وہ پٹھے تھے(چست پٹھے)

302
00:24:57,953 --> 00:25:03,240
حضرت عُمربن خطابؓ ایک پہلوان تھے، آپؓ ایک پہلوانی جسم کے مالک تھے اور آپؓ کُشتی لڑتے تھے

303
00:25:03,282 --> 00:25:05,885
آپؓ دَورِ جاہلیَّت میں پہلوان ہوا کرتے تھے

304
00:25:05,931 --> 00:25:07,292
مَجْدُوْلَّ الّلَحَمْ،

305
00:25:09,292 --> 00:25:13,111
عَرِيْضَ الّقَدَمَيْنَ وَ الْيَدَيْنَ

306
00:25:13,166 --> 00:25:19,281
آپؓ بلند قامت اور مضبوط اور توانا جسم کے مالک تھے اور آپؓ دراز ورزشی جسامت کے حامل تھے

307
00:25:19,306 --> 00:25:23,582
آپؓ کے ہاتھ اور پاؤں بڑے تھے

308
00:25:23,620 --> 00:25:26,733
(دورِ خلافت میں) آپؓ کے سر کے سامنے کے بال جھڑ گئے تھے

309
00:25:26,753 --> 00:25:36,482
  اور آپؓ کی رنگت قدرے صاف تھی دیگر عرب باشندوں کی جِلد کی نسبت جو کہ زیادہ تر گہری سانولی ہوتی ہے

310
00:25:36,518 --> 00:25:40,210
تو باقی لوگوں کی نسبت آپؓ کی جِلد قدرے صاف(سفید) تھی

311
00:25:40,243 --> 00:25:43,837
''مشُّوب بالخمرہ'' یعنی آپؓ کا رنگ قدرے سُرخی مائِل تھا

312
00:25:43,878 --> 00:25:51,071
آپؓ مہندی استعمال کرتے تھے، جب آپؓ عمر رسیدہ ہوگئے تو سُرخ مہندی کا استعمال کرتے تھے

313
00:25:51,110 --> 00:25:56,937
آپؓ اپنے سَر اور داڑھی کو سُرخ کرنے کے لئے مہندی لگاتے تھے

314
00:25:56,985 --> 00:26:04,343
اور روایات میں آتا ہے کہ آپؓ کی مونچھیں قدرے لمبی اور بڑی تھیں

315
00:26:04,376 --> 00:26:09,969
اور جب آپؓ اضطراب میں ہوتے تو اپنی مونچھوں پراُنگلیاں پھیرا کرتے

316
00:26:10,001 --> 00:26:14,652
جب آپؓ برہم ہوتے تو اپنی لمبی مُونچھوں کو بَل دیتے تھے

317
00:26:14,692 --> 00:26:22,881
تو یہ عمل حضرت عمر بن خطابؓ کی شخصیَّت کو مزید بارُعب بناتا

318
00:26:22,937 --> 00:26:28,008
روایات میں آتا ہے کہ جب آپؓ چلتے تو تیز چلتے

319
00:26:28,040 --> 00:26:31,370
جب آپؓ گفتگو فرماتے تو آسانی سے سُنی جا سکتی تھی

320
00:26:31,402 --> 00:26:36,318
جب آپؓ دُشمن پر وار کرتے تو کاری وار کرتے

321
00:26:36,351 --> 00:26:37,597
وَإِذَا ضَرَبَ اَوْجَعْ

322
00:26:37,682 --> 00:26:41,203
آپؓ دشمن کو اپنے وار سے شدید ضَرب پہنچاتے

323
00:26:41,237 --> 00:26:47,004
تو آپؓ کی شخصیَّت بارُعب تھی اور آپؓ کی آواز پُرزور و مؤثر تھی

324
00:26:47,052 --> 00:26:58,346
آپ کی چال پُروقار تھی اور جب آپؓ دشمن پہ وار کرتے تو کاری ضرب لگاتے

325
00:26:58,391 --> 00:27:08,836
حضرت عُمر بن خطابؓ کی شخصیت میں ایسا دبدبہ تھا کہ  آپؓ کی موجودگی دُشمن پہ دہشت طاری کر دیتی تھی

326
00:27:08,883 --> 00:27:12,966
اور آپؓ کی شخصیَّت کا یہ جلال دوستوں پہ بھی رُعب طاری کرتا تھا

327
00:27:13,016 --> 00:27:19,452
صحابہ کرامؓ ، بہت سے مواقع پر حضرت عمرؓ کے غصے سے ہراساں ہوئے

328
00:27:19,492 --> 00:27:30,189
ایک دفعہ حضرت عمرؓ کی جانب سے، حضرت ابو موسیٰ اشعریؓ کو گواہ پیش کرنے کا کہا گیا تو آپؓ وہاں سے چلے گئے تو حضرت ابو موسیٰ الاشعریؓ کا رنگ زَرد پڑ گیا، (ہم اس متعلق بات کریں گے)

329
00:27:30,229 --> 00:27:37,081
صحابہؓ نے پوچھا کہ کیا معاملہ ہے؛ آپؓ نے فرمایا عمرؓ کی وجہ سے یہ سب ہوا، آپؓ کا چہرا زرد پڑ گیا تھا

330
00:27:37,111 --> 00:27:40,819
ایک اور موقع پر جب آپؓ، صحابہ کرامؓ کے ساتھ کہیں جا رہے تھے

331
00:27:40,860 --> 00:27:46,886
آپؓ نے اچانک مُڑ کر دیکھا تو ایک حاملہ عورت جو پیچھے آ رہی تھی، خوف سے اسکا حمل گِر گیا

332
00:27:46,941 --> 00:27:51,020
اور صحابہ کرامؓ کے مابین اُس دور میں یہ بحث ہوئی کہ خون بہا ادا کرنا چاہیے یا نہیں؟

333
00:27:51,061 --> 00:27:56,054
 لیکن آپؓ کا ارادہ اُس عورت کو تکلیف پہنچانے کا نہیں تھا

334
00:27:56,082 --> 00:28:00,168
لیکن پھر حضرت علی بن ابی طالبؓ نے فیصلہ دیا کہ خون بہا کی رقم ادا کی جائے گی، کیونکہ نقصان تو ہوا ہے

335
00:28:00,188 --> 00:28:05,751
لیکن حضرت عُمرؓ اسے ادا نہیں کریں گے بلکہ یہ قصاص مسلمانوں کے بیتُ الْمال سے ادا ہوگا

336
00:28:05,770 --> 00:28:15,953
جب اللہ تعالٰی کے دُشمن حضرت عُمرؓ کا نام سنتے تھے تو  اُن کی ٹانگیں کانپ جاتیں اور اُن کے دل لرز جاتے

337
00:28:16,050 --> 00:28:30,343
اب حضرت عُمرؓ کی شخصیَّت کی منفرد بات یہ تھی کہ اس تمام رُعب اور دبدبے کے باوجود آپؓ بہت جلدی آب دیدہ ہو جاتے تھے

338
00:28:30,384 --> 00:28:35,373
اور آپؓ نہایت ہمدرد اور مہربان دل رکھتے تھے

339
00:28:35,416 --> 00:28:40,901
اور آپؓ بہت عاجز بھی تھے اور یہ حضرت عُمرؓ کی شخصیَّت کی منفرد بات تھی

340
00:28:40,942 --> 00:28:48,237
عام طور پر جن لوگوں کا رُعب اور دبدبہ ہوتا ہے وہ سخت مزاج ، جارحانہ اور مُتکبِّر ہوتے ہیں

341
00:28:48,270 --> 00:28:53,239
اور جو لوگ ہمدرد اور نرم دل ہوتے ہیں وہ عمومًا عاجز اور کمزور ہوتے ہیں

342
00:28:53,279 --> 00:29:05,384
لیکن حضرت عُمر بن خطابؓ کی شخصیت میں بیک وقت یہ متضاد خوبیاں موجود تھیں، جس کی وجہ سے آپؓ منفرد تھے

343
00:29:05,434 --> 00:29:10,364
آپؓ کے والد'' الخطاب اِبن نُفیل'' تھے

344
00:29:10,403 --> 00:29:17,524
آپؓ کے والد بہت سخت مزاج آدمی تھے اور حضرت عُمرؓ اُن کی سخت مزاجی کو اکثر یاد کرتے تھے

345
00:29:17,557 --> 00:29:20,707
حضرت عُمرؓ کی پرورش بہت سختی والے ماحول میں ہوئی تھی

346
00:29:20,750 --> 00:29:23,154
آپؓ کے والد کا رویہ آپؓ کے ساتھ بہت سخت تھا

347
00:29:23,184 --> 00:29:38,272
حضرت عُمر بن خطابؓ جب خلیفہ تھے تو آپؓ اپنے کچھ ساتھیوں کے ہمراہ تھے اور وہاں تشریف لے گئے جہاں آپؓ اپنے والد کے اونٹ چرایا کرتے تھے

348
00:29:38,292 --> 00:29:39,066
آپؓ نے فرمایا

349
00:29:39,104 --> 00:29:44,939
لَا اِلَهَ اِلَّا الله اَلْعَلِيِّ الّعَظِيْمََ اَلْمُعْطِيْ مَا يَشَاءُ لِمَنْ يَشَآءُُ

350
00:29:44,975 --> 00:29:46,585
لَا اِلَهَ اِلَّا الله

351
00:29:46,881 --> 00:29:52,908
اللہ سب سے بلند و بزرگ ہے، وہ اللہ جو جسے چاہتا ہے اور جو چاہتا ہے اسے وہ عطا فرماتا ہے

352
00:29:52,951 --> 00:30:00,291
آپؓ نے فرمایا ؛ میں اِس جگہ اپنے والد کے اونٹ چرایا کرتا تھا

353
00:30:00,332 --> 00:30:01,681
فِيْ مَدْرَعَةٍ مِّن صُوْفَ

354
00:30:01,791 --> 00:30:05,976
اور میرا لباس کھردرا اور غیر آرام دہ ہوتا تھا

355
00:30:06,023 --> 00:30:08,477
وَكَانَ فَظًا يُتْعِبُنِيْ اِذَاعَمِلْتَ

356
00:30:08,910 --> 00:30:13,435
 اور میرے والد سخت مزاج تھے اور مجھ سے اتنی مشقت کرواتے کہ میں تھک جاتا تھا

357
00:30:13,475 --> 00:30:16,602
اور اگر میں کام نہ کرتا تو مجھے مار پڑتی

358
00:30:16,637 --> 00:30:20,910
وَيُضْرِبُنِيْ اِذَا قَصَّرْتََ وَقَدْ اَمْسَيْتُ لَيْسَ بَيْنِيْ وَ بَيْنَ الله اَحَدْ

359
00:30:21,349 --> 00:30:25,551
اور آج میرے اور اللہ کے درمیان کوئی نہیں ہے (میں صرف اللہ کو جواب دہ ہوں)

360
00:30:25,586 --> 00:30:31,206
 انسانی مراتب کی درجہ بندی میں آپؓ مسلمانوں کے خلیفہ کی حیثیت سے بلند مقام پہ فائز تھے، آپؓ کا درجہ سب سے بلند ہے

361
00:30:31,245 --> 00:30:33,572
میرے اور اللہ کے درمیان اب کوئی عہدے کے لحاظ سے بڑا نہیں ہے

362
00:30:33,607 --> 00:30:35,882
حضرت عُمرؓ فرمارہے تھے سبحان اللہ، ایک وقت تھا

363
00:30:35,899 --> 00:30:40,558
 جب میں اپنے والد کے اونٹ چرایا کرتا تھا اور وہ مجھے بہت مارتے تھے، پیٹتے تھے

364
00:30:40,598 --> 00:30:47,781
اور وہ میرے ساتھ بہت سختی کیا کرتے تھے اور اب دیکھو عُمرؓ کس مقام پر ہے

365
00:30:47,823 --> 00:30:48,513
تو آپؓ نے فرمایا؛

366
00:30:48,553 --> 00:30:49,224
لَا اِلَهَ اِلَّا الله

367
00:30:49,248 --> 00:30:51,732
اللہ جسے چاہتا ہے اور جس کو چاہتا ہے عطا کرتا ہے

368
00:30:51,771 --> 00:30:56,585
کوئی تَصَوُّر کرسکتا ہے کہ کل کے چرواہے حضرت عُمرؓ کو خلافت دی جائے گی

369
00:30:56,620 --> 00:31:02,358
آپؓ نہ صرف اپنے والد کے اونٹ چراتے تھے  بلکہ آپؓ دیگر خواتین مثلًا اپنی خالہ کے لیے بھی کام کرتے تھے

370
00:31:02,389 --> 00:31:15,827
آپؓ فرماتے ہیں کہ میری کچھ خالائیں تھیں اور میں اُن کی بکریاں یا بھیڑیں ایک وادی میں لے جاتا

371
00:31:15,868 --> 00:31:20,853
اور میں شام کو واپس آتا، اور وہ مجھے مُٹّھی بھر کشمش یا کھجوریں دیتیں

372
00:31:20,873 --> 00:31:25,746
حضرت عبدالرَّحمٰن بن عوفؓ نے یہ واقعہ بیان کیا ہے کہ

373
00:31:25,771 --> 00:31:30,359
ایک دفعہ حضرت عُمرؓ نے لوگوں کو مسجد میں بلایا اور جب وہ سب جمع ہو گئے

374
00:31:30,392 --> 00:31:36,818
حضرت عُمرؓ منبر پر کھڑے ہو گئے اور یہ تب کا واقعہ ہے جب آپؓ خلیفہ تھے

375
00:31:36,850 --> 00:31:42,054
آپؓ نے فرمایا، میں اپنی بعض پھوپھیوں کا چرواہا تھا

376
00:31:42,087 --> 00:31:45,588
اور جب میں شام کو واپس آتا

377
00:31:45,637 --> 00:31:56,357
اور وہ مجھے دن بھر کی محنت و مشقت کے بدلے ایک مُٹّھی کھجور یا کشمش دیتیں اور میرا دن قابلِ ترس ہوتا تھا

378
00:31:56,399 --> 00:31:59,648
اور پھر آپؓ منبر سے نیچے تشریف لائے

379
00:31:59,694 --> 00:32:04,541
  میرا قابلِ ترس دن سے مراد یہ ہے کہ میں نے دن بھر مشقت کی، اور مجھے محنت کا یہ صلہ ملا، مُٹّھی بھر کھجوریں؟

380
00:32:04,585 --> 00:32:08,267
 میری غربت کا یہ حال تھا

381
00:32:08,309 --> 00:32:09,388
حضرت عبد الرحمن بن عوفؓ نے فرمایا؛

382
00:32:09,422 --> 00:32:11,660
 "مَازِدْتَّ عَلى اَنْ قَمَّئْتَ نَفْسَكْ"

383
00:32:12,325 --> 00:32:16,201
اے عُمرؓ، آپؓ نے اپنی توہین کے سوا کچھ نہیں کیا، یہ کیسا خطبہ ہے؟

384
00:32:16,228 --> 00:32:17,352
کیا وجہ ہے؟

385
00:32:17,383 --> 00:32:22,667
آپؓ نے لوگوں کے سامنے اپنی کمتری ظاہر کی ہے

386
00:32:22,706 --> 00:32:23,565
حضرت عُمربن خطابؓ نے فرمایا؛

387
00:32:23,610 --> 00:32:24,646
 "وَيْحَكْ يَا اِبْنِ عَوْفَ"

388
00:32:25,170 --> 00:32:39,202
عوف کے بیٹے تجھ پر افسوس! میرا نفس مجھے احساس دلا رہا تھا، میں امیرُالمؤمنین ہوں تو مجھ سے بہتر کون ہو سکتا ہے؟

389
00:32:39,237 --> 00:32:45,239
لہذا، میں اپنےنفس کو سبق سکھانا چاہتا تھا اور بتانا چاہتا تھا کہ اِس کی حقیقت کیا ہے

390
00:32:45,279 --> 00:32:50,599
آپؓ نے فرمایا؛ میں نفس کو بتانا چاہتا تھا کہ اِسکی اصلیّت کیا ہے یہ کتنا عاجز ہے

391
00:32:50,642 --> 00:32:59,751
کیونکہ نفس مجھے ورغلا رہا تھا اور مجھے باور کرا رہا تھا کہ، میں امیرُالمؤمنین ہوں، اور کوئی مجھ سے بڑا نہیں

392
00:32:59,792 --> 00:33:05,267
 جب ہم حضرت عُمرؓ کی سیرت پر بات کر رہے ہوں تو میں چاہتا ہوں کہ آپ حضرت عمرؓ کے اقوال اور کردار کی جانچ پرکھ کریں

393
00:33:05,287 --> 00:33:08,805
کیونکہ وہ آپؓ کی شخصیّت کو مزید واضح کرے گا

394
00:33:08,843 --> 00:33:15,298
حضرت عمرِبن خطابؓ، وہ ہستی تھے کہ وہ اپنے نفس یا کسی شخص کے ہاتھوں بیوقوف نہیں بنتے تھے

395
00:33:15,337 --> 00:33:24,971
دیکھیں! اُن کا نفس اُن کو بہکا رہا تھا کہ تم سب سے بہتر ہو، دیکھو تمہارا کیا(بلند) مقام ہے

396
00:33:25,003 --> 00:33:34,676
بھائیو اور بہنو شیطان آپ کو نہیں بہکا سکتا جب تک کہ آپ اُسے اجازت نہ دیں

397
00:33:34,714 --> 00:33:38,681
قیامت کے دن لوگ شیطان کے پاس جائیں گے اور شکایت کریں گے تو شیطان کہے گا

398
00:33:38,712 --> 00:33:40,300
"مَا كَانَ لِيْ عَلَيْكُمْ مِنْ سُلْطَانْ"

399
00:33:40,639 --> 00:33:43,006
میرا تم پر کوئی اختیار نہیں تھا،(ہر عمل کے زمہ دار) تم خود تھے

400
00:33:43,045 --> 00:33:44,205
"كُنْتُمْ قَوْمً طَاغِيْنَ"

401
00:33:44,254 --> 00:33:47,346
تم لوگ خود ہی فاسق تھے

402
00:33:47,386 --> 00:33:52,532
شیطان آپ کے دل تک رَسائی حاصل نہیں کر سکتا جب تک کہ آپ اسے راستہ نہ دیں

403
00:33:52,563 --> 00:33:58,763
حضرت عمر بن خطابؓ، تمام شگافوں کو بند کر رہے تھے جن سے شیطان کو غالب آنے کا موقع ملتا

404
00:33:58,818 --> 00:34:03,976
جب کہ ہمارے پاس صرف شگاف ہی نہیں ، ہم نے تو اپنے دل کے دروازے کھول دیتے ہیں

405
00:34:04,017 --> 00:34:08,216
ہمارے دل کے دروازے شیطان کو خوش آمدید کہنے کیلئے کھُلے ہوتے ہیں

406
00:34:08,258 --> 00:34:11,068
شیطان آپ کے پاس نہیں آسکتا جب تک آپ اسے اجازت نہ دیں

407
00:34:11,089 --> 00:34:13,968
جب شیطان جَنّت میں حضرت آدمؑ کے پاس گیا

408
00:34:14,014 --> 00:34:15,157
شیطان نے حضرت آدمؑ سے کیا کہا؟

409
00:34:15,178 --> 00:34:18,048
کیا اُس نے آپؑ کو کہا کہ جا کر اُس شجرِ ممنوعہ کا پھل کھاؤ جسے اللہ نے کھانے سے منع کیا ہے؟

410
00:34:18,101 --> 00:34:19,894
جاؤ اور اس درخت سے کھاؤ جو حرام ہے؟

411
00:34:19,931 --> 00:34:22,015
جاؤ اور اللہ کی نافرمانی کرو؟

412
00:34:22,057 --> 00:34:23,992
 نہیں! اس نے حضرت آدمؑ سے کہا؛

413
00:34:24,020 --> 00:34:28,382
يَا آدَمْ هَلْ اَدُلُّكَ عَلَى شَّجَرَةِ الّخُلْدِ وَمُلْكِ لَا يَبْلَىً۞

414
00:34:28,643 --> 00:34:37,442
اے آدمؑ میں تمہیں ایک درخت کا پتا دوں، جو آپ کو ہمیشہ کی زندگی اور ایک عظیم بادشاہی دے گا

415
00:34:37,468 --> 00:34:43,416
شیطان جانتا ہے کہ ہمارے نفس کو کیا پسند ہے، ہم ہمیشہ زندہ رہنا چاہتے ہیں، ہم اقتدار چاہتے ہیں

416
00:34:43,436 --> 00:34:48,571
 تو یہ وہ دروازے ہیں جن کے ذریعے وہ حضرت آدمؑ کے دل میں آیا

417
00:34:48,595 --> 00:34:51,725
تو شیطان کو حاوی ہونے کے لئے راستہ چاہیے

418
00:34:51,758 --> 00:34:57,522
حضرت عمربن خطابؓ، ان تمام ممکنہ شگافوں پر مہر لگا رہے تھے، آپؓ انہیں بند کر رہے تھے

419
00:34:57,565 --> 00:34:58,538
حضرت عمر بن خطابؓ فرماتے ہیں کہ

420
00:34:58,558 --> 00:35:00,566
"لَسْتُ بِالْخِبِّ وَلَااَلْخِبِّ يَخْدَعْنِيْ"

421
00:35:01,891 --> 00:35:06,858
میں دھوکہ دینے والا نہیں ہوں اور نہ ہی کسی میں ہمت ہے کہ وہ مجھے دھوکہ دے

422
00:35:06,898 --> 00:35:11,378
آپؓ نے فرمایا؛ میں لوگوں کو دھوکہ نہیں دیتا لیکن یہ بھی حقیقت ہے کہ کوئی مجھے دھوکہ نہیں دے سکتا

423
00:35:11,409 --> 00:35:17,126
اسی لیے رَسُولُ اللہؐ فرماتے ہیں؛ جب بھی شیطان آپؓ کو کہیں راستے پر چلتے ہوئے دیکھتا ہے، وہ راستہ بدل لیتا ہے

424
00:35:17,165 --> 00:35:27,102
 شیطان حضرت عُمرؓ کو بہکانے میں ناکام ہو گیا ہے اُسے کوئی اُمید نہیں ملتی، شیطان کے نزدیک حضرت عُمرؓ کو بہکانا وقت کا ضیاع ہے

425
00:35:27,122 --> 00:35:40,999
تو حضرت عُمرؓ کے والد بہت سخت گیر شخص تھے اور اپنے بچوں کی پرورش میں سختی کرتے تھے

426
00:35:41,036 --> 00:35:44,149
 حضرت عُمرؓ کی والدہ؛

427
00:35:44,227 --> 00:35:50,547
ایک روایت یہ ہے کہ وہ(آپؓ کی والدہ) بنو مخزوم سے تھیں جوکہ حضرت خالد بن ولیدؓ کا خاندان تھا

428
00:35:50,584 --> 00:35:54,989
لیکن اکثر مُؤَرِّخین کا کہنا ہے کہ وہ ابوجہل کی خالہ زاد بہن تھیں

429
00:35:55,034 --> 00:35:56,636
وہ ابوجہل کی خالہ زاد تھیں

430
00:35:56,656 --> 00:35:58,898
حنطمہ بنت ہشّام

431
00:35:58,936 --> 00:36:02,902
 اُن کا نام حنطمہ بنت ہشّام تھا

432
00:36:02,955 --> 00:36:07,673
آپؓ کی ازواج! آپؓ نے کل سات یا آٹھ شادیاں کیں

433
00:36:07,693 --> 00:36:09,894
آپؓ نے زینب بنت مظعونؓ سے شادی کی

434
00:36:09,929 --> 00:36:13,827
جو کہ عظیم صحابی حضرت عُثمانؓ اِبن مظعون کی بہن تھیں

435
00:36:13,874 --> 00:36:16,574
آپؓ نے جاہلیت کے زمانے میں اُن سے شادی کی

436
00:36:16,594 --> 00:36:22,923
اور اُن کے بطن سے آپؓ کے بیٹے حضرت عبداللہؓ حضرت عبدالرحمٰنؓ اکبر، اور بیٹی حضرت حفصہؓ تھیں

437
00:36:22,962 --> 00:36:25,756
آپؓ  نے ملیکہ بنت جرولؓ سے شادی کی

438
00:36:25,783 --> 00:36:30,484
اور وہ حضرت عبید اللہؓ کی والدہ تھیں اور بعد ازاں آپؓ نے اُن کو طلاق دے دی

439
00:36:30,531 --> 00:36:35,140
حضرت عمرؓ نے قُرَیبہ بنت ابی مخزومؓ سے شادی کی اور بعد میں اُنہیں طلاق دے دی

440
00:36:35,188 --> 00:36:41,545
اور پھر قُرَیبہ بنت ابی مخزومؓ نے عبد الرَّحمن اِبن اَبی بَکرؓ سے شادی کی

441
00:36:41,594 --> 00:36:44,871
آپؓ  نے اُمِّ حکیم بنت الحارثؓ  سے شادی کی

442
00:36:44,913 --> 00:36:48,514
جو پہلے حضرت عکرمہؓ اِبن ابی جہل کی بیوی تھیں

443
00:36:48,546 --> 00:36:51,813
جب حضرت عکرمہؓ جنگ یرموک میں شہید  ہوئے تو

444
00:36:51,818 --> 00:36:54,576
حضرت عُمراِبن خطابؓ نے اُمِّ حکیم بنت الحارثؓ  سے شادی کی

445
00:36:54,632 --> 00:37:02,245
پھر جب حضرت عمرؓ کا انتقال ہو گیا تو اُمِّ حکیم بنت الحارثؓ  نے دوبارہ نکاح کر لیا، وہ فاطمہؓ کی والدہ تھیں

446
00:37:02,279 --> 00:37:06,365
آپؓ نے جمیلہ بنت عاصم بن ثابتؓ سے شادی کی

447
00:37:06,406 --> 00:37:10,607
آپؓ نے عاتقہؓ بنت زید بِن عَمرو بن نُفَیل سے نکاح کیا

448
00:37:10,661 --> 00:37:12,921
جو آپؓ  کی رشتہ دار تھیں

449
00:37:12,951 --> 00:37:16,364
  وہ عبداللہ اِبن اَبی بکرؓ سے طلاق یافتہ تھیں

450
00:37:16,409 --> 00:37:23,423
اور جب حضرت عُمرؓ کو شہید کر دیا گیا تو عاتقہ بنت زیدؓ نے حضرت زُبیر بن عوامؓ سے شادی کی

451
00:37:23,465 --> 00:37:30,671
حضرت عُمربن خطابؓ، حضرت ابوبکرؓ کی سب سے چھوٹی صاحبزادی سے شادی کرنا چاہتے تھے تھیں، جن کا نام حضرت اُمِّ کلثومؓ تھا

452
00:37:30,691 --> 00:37:36,371
وہ حضرت ابوبکرؓ کے انتقال کے بعد پیدا ہوئیں، وہ حضرت ابوبکرؓ کی سب سے چھوٹی بیٹی تھیں

453
00:37:36,399 --> 00:37:42,650
چنانچہ حضرت عُمر بن خطابؓ نے اُن کو نکاح کا پیغام بھیجا تو اُنہوں نے اِنکار کردیا

454
00:37:42,694 --> 00:37:43,328
حضرت عائشہؓ نے اُن سے کہا؛

455
00:37:43,363 --> 00:37:45,064
 "أَتَرْغَبِيْنَ عَنْ اَمِيْرُ الّمُؤمِنِيْنْ"

456
00:37:45,128 --> 00:37:47,286
کیا تم امیر المؤمنین سے شادی نہیں کرنا چاہتی؟

457
00:37:47,348 --> 00:37:47,696
آپؓ نے فرمایا؛

458
00:37:47,716 --> 00:37:49,535
 ''اِنَّ هُوْ خَشِنِ ا لْعَيْشْ''

459
00:37:50,332 --> 00:37:54,784
   آپؓ  کا طرزِ حیات مشکل ہے آپ جانتے ہیں خواتین سہل طرزِ زندگی پسند کرتی ہیں

460
00:37:54,814 --> 00:38:01,230
تو اُن دنوں میں بھی؛ وہ بھی چاہتی تھیں کہ اُن کا شوہر اُن کا خیال رکھے، اُن کی زندگی کو آرام دہ اور آسان بنائے

461
00:38:01,254 --> 00:38:04,370
تو حضرت اُمِ کلثومؓ نے فرمایا؛ میں حضرت عُمرؓ سے شادی نہیں کرسکتی

462
00:38:04,410 --> 00:38:06,749
چنانچہ حضرت عائشہؓ نے حضرت عمرو بن عاصؓ کو اس کے بارے میں بتایا

463
00:38:06,841 --> 00:38:09,961
حضرت عمرو بن عاصؓ حضرت عُمرؓ کے پاس گئے اور عرض کی

464
00:38:09,998 --> 00:38:14,421
میرا آپ کو ایک مشورہ ہے کہ آپؓ حضرت علیؓ کی بیٹی اُمِّ کلثوم سے شادی کیوں نہیں کرتے

465
00:38:14,456 --> 00:38:17,377
کیونکہ اُن سے شادی کرنے میں یہ حکمت ہے

466
00:38:17,415 --> 00:38:19,136
ثَبِّبْ اِلى رَسُولِ الله

467
00:38:20,064 --> 00:38:23,130
آپؓ کا رَسُولُ اللہؐ کے خاندان سے رشتہ جُڑ جائے گا

468
00:38:23,175 --> 00:38:25,073
کیونکہ حضرت اُمِّ کلثوم بِنت علیؓ ، حضرت فاطمہؓ کی بیٹی تھیں

469
00:38:25,098 --> 00:38:29,690
چنانچہ وہ رَسُولُ اللہؐ کی نواسی تھیں

470
00:38:29,730 --> 00:38:34,323
چنانچہ حضرت عُمرؓ نے پیغام نکاح بھیجا تو وہ راضی ہوگئیں اور آپؓ نے اُن سے نکاح کرلیا

471
00:38:34,357 --> 00:38:37,953
یہ حضرت علی بن ابی طالبؓ کی صاحبزادی تھیں

472
00:38:38,003 --> 00:38:48,517
اب حضرت علی بن اَبو طالبؓ ، حضرت عُمرؓ سے بہت چھوٹے تھے اس لیے آپؓ کی صاحبزادی بھی کم عمر تھیں

473
00:38:48,568 --> 00:38:53,249
لوحَيَّهْ  آپؓ کی لونڈی تھی یا بیوی، اس میں اختلاف ہے

474
00:38:53,297 --> 00:38:56,695
اور لوحَيَّهْ کے بیٹے حضرت عبدالرحمٰنؓ اصغر تھے

475
00:38:56,738 --> 00:39:04,391
اور پھر آپؓ کی ایک لونڈی تھی اس کا نام فُقَیہہ تھا اور وہ زینبؓ کی والدہ تھی

476
00:39:04,448 --> 00:39:08,504
چنانچہ آپؓ کی شادیوں سے کل تیرہ بچے ہوئے

477
00:39:08,529 --> 00:39:10,768
 زیدؓ بڑے اور زیدؓ چھوٹے

478
00:39:10,793 --> 00:39:13,902
میں لفظی ترجمہ کر رہا ہوں ''زیدُ الاَکبر''اور ''زیدُ الاَصغر''

479
00:39:14,341 --> 00:39:18,078
آپؓ نے اپنے دو بیٹوں کا نام زید رکھا کیونکہ حضرت عُمرؓ کے بھائی کا نام زید تھا

480
00:39:18,128 --> 00:39:23,388
حضرت عُمرؓ نے ان کا نام اپنے بھائی زید بن خطابؓ کے نام پر رکھا، جن سے آپؓ بہت مُحبّت کرتے تھے

481
00:39:23,420 --> 00:39:26,155
یہ حضرت عُمرؓ کے بڑے بھائی تھے، جو شہید ہوئے تھے

482
00:39:26,187 --> 00:39:28,280
اس کے بعد حضرت عاصمؓ ،حضرت عبداللہؓ

483
00:39:28,314 --> 00:39:32,293
اور سب سے بڑے صاحبزادے حضرت عبد الرَّحمنؓ تھے پھر ایک منجھلا بیٹا عبد الرحمنؓ تھا اور ایک سب سے چھوٹا بیٹا عبد الرَّحمنؓ تھا

484
00:39:32,334 --> 00:39:36,539
آپؓ کو عبد الرَّحمنؓ نام بہت پسند تھا، آپؓ نے اپنے تین بچوں کا نام عبد الرَّحمنؓ رکھا

485
00:39:36,583 --> 00:39:41,143
عبد الرَّحمنؓ  الاکبر(بڑا عبدالرّحمٰن)، عبد الرَّحمنؓ  الاوسط(منجھلا عبدالرّحمٰن)، عبد الرَّحمنؓ  الاصغر(چھوٹا عبدالرّحمٰن)

486
00:39:41,183 --> 00:39:46,631
حضرت عمرؓ کے صاحبزادے حضرت عبیداللہؓ اور حضرت ایازؓ بھی تھے

487
00:39:46,680 --> 00:39:53,260
پھر آپؓ کی چار بیٹیاں تھیں، حضرت حفصہؓ، حضرت رقیہؓ، حضرت زینبؓ اور حضرت فاطمہؓ، یہ آپؓ کی کل تیرہ اولادیں تھیں

488
00:39:53,281 --> 00:39:55,732
اُس دور کی شادیوں پر صرف ایک وضاحت کر دوں؛

489
00:39:55,753 --> 00:39:58,706
کیونکہ آپ لوگوں کے ذہن میں کچھ خیالات آئے ہوں گے

490
00:39:58,727 --> 00:40:00,472
جب ہم حضرت عُمرؓ کی شادیوں کی بات کر رہے تھے

491
00:40:00,502 --> 00:40:02,875
 سب سے پہلے آپ نے نوٹ کیا کہ اُنہوں نے چار سے زیادہ شادیاں کیں

492
00:40:02,899 --> 00:40:06,848
 ظاہر ہے، اُن کے پاس کسی ایک وقت پر چار سے زیادہ بیویاں نہیں تھیں

493
00:40:06,891 --> 00:40:14,687
ہم بات کر رہے ہیں کہ آپؓ نے اپنی حیات میں جن عورتوں سے شادی کی، اُن کی کُل تعداد سات یا آٹھ تھی

494
00:40:14,725 --> 00:40:19,084
آپ نے یہ بھی نوٹ کیا ہوگا کہ آپؓ نے اپنی دو بیویوں کو طلاق دی اور حالتِ اِسلام میں اُن کو طلاق دی

495
00:40:19,109 --> 00:40:21,022
یہ جاہلیَّت کے زمانے میں نہیں ہوا،

496
00:40:21,042 --> 00:40:24,582
حضرت ابوبکرؓ نے بھی اپنی بیوی کو طلاق دی

497
00:40:24,616 --> 00:40:29,309
رَسُولُ اللہؐ بھی تقریبًا  اپنی ازواج کو طلاق دینے والے تھے، بہت سے صحابہؓ نے اپنی بیویوں کو طلاق دی

498
00:40:29,340 --> 00:40:32,732
آج کل، ہم طلاق کو ناقابل قبول چیز سمجھتے ہیں

499
00:40:32,753 --> 00:40:37,932
درحقیقت جب ہم معاشرے کی بُرائیوں کی بات کرتے ہیں تو کہتے ہیں کہ آجکل طلاق کا تناسب بہت زیادہ ہے

500
00:40:37,968 --> 00:40:39,631
ٹھیک ہے اگر(طلاق) سماجی برائی ہے

501
00:40:39,655 --> 00:40:44,731
تو پھر صحابہؓ کے دور میں طلاق کا تناسب بہت زیادہ تھا

502
00:40:44,752 --> 00:40:50,541
لہذا، درحقیقت یہ(طلاق) سماجی فلاح و ترقی جانچنے کا معیار ہرگز نہیں ہے

503
00:40:50,569 --> 00:40:54,571
دراصل طلاق کے بارے میں اُن کا تصَوُّر ہم سے مختلف تھا

504
00:40:54,611 --> 00:40:58,771
وہ شادی کو دو رُوحوں کا رشتہ سمجھتے تھے

505
00:40:58,815 --> 00:41:02,528
لہٰذا ایک مطابقت ہونی چاہیے، اگر یہ مطابقت نہیں ہے،

506
00:41:02,548 --> 00:41:06,114
 تو یہ کاروباری معاہدے کی طرح ہے، اگر یہ مطابقت نہیں ہے،

507
00:41:06,143 --> 00:41:08,197
اگر یہ نہیں چلتا تو ہم اِس معاہدے سے الگ ہو سکتے ہیں

508
00:41:08,228 --> 00:41:11,557
آج کل، ہم طلاق کو ایک مختلف نقطہ نگاہ سے دیکھتے ہیں

509
00:41:11,590 --> 00:41:14,691
ہم طلاق کو ایسی چیز سمجھتے ہیں جو ہونی ہی نہیں چاہیئے

510
00:41:14,730 --> 00:41:16,254
اور پھر اگر کبھی طلاق ہو جائے

511
00:41:16,279 --> 00:41:21,697
یہ طلاق یافتہ شخص پر بدنما داغ بن جاتی ہے جب تک کہ اُن کی زندگی ہے، خاص طور پر خواتین پر

512
00:41:21,732 --> 00:41:30,136
ایک عورت جو طلاق یافتہ ہے، کوئی بھی اس سے شادی نہیں کرنا چاہتا اور یہ ناانصافی ہے، یہ ظلم ہے

513
00:41:30,176 --> 00:41:33,733
لہٰذا آپ لوگ صحابہؓ کے دور میں دیکھیں گے

514
00:41:33,769 --> 00:41:37,286
کوئی عورت غیر شادی شدہ نہیں رہتی تھی

515
00:41:37,320 --> 00:41:44,358
کیونکہ ایک مسلمان مرد ہو یا عورت اُس کے لیے خانگی زندگی کا اہم جُزْو ہے

516
00:41:44,398 --> 00:41:47,487
خاندان آپ کے لئے بہت زیادہ اہمیَّت کا حامل ہے

517
00:41:47,518 --> 00:41:51,830
بحیثیَّت مسلمان آپ کا خاندان بہت اہم ہے

518
00:41:51,869 --> 00:41:55,837
ہم غیر مسلموں کی طرح نہیں کہ اگر انکی شادی نہیں ہوئی تو کوئی بات نہیں

519
00:41:55,874 --> 00:41:59,131
وہ ایک کلب سے دوسرے کلب میں جائیں اور لُطف اندوز ہوں،

520
00:41:59,151 --> 00:42:02,177
لیکن یہ کسی مسلمان کا طرزِ زندگی نہیں ہے

521
00:42:02,222 --> 00:42:06,390
کفّار عورتیں مختلف مردوں کے ساتھ تعلُّق قائم کر کے زندگی گزارتی ہیں

522
00:42:06,416 --> 00:42:14,049
ایسی گزر بسر کرتی ہیں جوکہ حیواںیَّت نما زندگی ہے نا کہ انسانوں کی

523
00:42:14,111 --> 00:42:20,465
لہٰذا، ایک مسلمان مرد یا عورت کے لئے اولین ترجیح اس کا خاندان ہے

524
00:42:20,486 --> 00:42:24,277
چنانچہ صحابہ کرامؓ اپنی بہنوں میں سے کسی کو بھی غیرشادی شدہ نہیں رہنے دیتے تھے

525
00:42:24,298 --> 00:42:29,025
 وہ انہیں خانگی زندگی کے اس حق اور موقع سے محروم نہیں کرتے تھے

526
00:42:29,055 --> 00:42:33,095
اور یہی وجہ ہے کہ اس دور میں کثیرزوجگی عام تھی اور معاشرے میں یہ قابلِ قبول چیز تھی

527
00:42:33,127 --> 00:42:36,141
اور اگر عورت یا مرد کو طلاق ہو جاتی

528
00:42:36,172 --> 00:42:41,325
 یہ اُن پر بدنُما داغ نہیں تھا وہ آسانی سے دوبارہ شادی کر سکتے تھے

529
00:42:41,358 --> 00:42:47,008
 آپ یہ بھی دیکھیں گے کہ اُن(شادی شدہ جوڑوں) کی عُمر میں بہت زیادہ فرق ہوتا تھا

530
00:42:47,057 --> 00:42:50,849
جب دونوں فریقین مُتَّفق ہوتے تو معاشرہ میں ان کو کوئی سماجی مسئلہ درپیش نہ ہوتا

531
00:42:50,874 --> 00:42:55,186
حضرت عُمر بن خطابؓ عُمر رسیدہ تھے جب آپؓ نے حضرت اُمِّ کلثوم بنت علیؓ سے شادی کی

532
00:42:55,231 --> 00:42:59,918
اور حضرت اُمِّ کلثوم بنت ابوبکرؓ نے آپؓ سے شادی کرنے سے اسلئے انکار نہیں کیا، کہ آپؓ عُمر میں بڑے تھے

533
00:42:59,938 --> 00:43:05,887
 کیونکہ حضرت اُمِّ کلثوم بِنت ابوبکرؓ نے پھر حضرت طلحہ بن عبید اللہؓ سے بھی شادی کی وہ بھی عُمر میں اُن سے بڑے تھے

534
00:43:05,930 --> 00:43:10,734
لہٰذا، جب دونوں فریقین نکاح کے لئے باہم رضامند ہوتے تو یہ سماجی طور پہ قابلِ قبول عمل تھا

535
00:43:10,779 --> 00:43:15,220
پس نکاح اور طلاق کے بارے میں ہمارا تَصوُّر صحابہؓ کے تَصوُّر سے مختلف ہے

536
00:43:15,259 --> 00:43:19,527
صحابہؓ کے زمانے میں نکاح جلد اور آسان تھا

537
00:43:19,568 --> 00:43:26,032
اور سب کو کسی خاندان کا حصَّہ بننے کی اجازت تھی

538
00:43:26,065 --> 00:43:28,967
اب، مسلم دنیا میں لاکھوں خواتین ہیں جو غیرشادی شدہ ہیں

539
00:43:28,992 --> 00:43:30,782
یہ مغرب میں واقعی کوئی بڑا مسئلہ نہیں ہے

540
00:43:30,823 --> 00:43:34,232
لیکن مسلم ممالک میں یہ ایک خطرناک سماجی مسئلہ ہے

541
00:43:34,270 --> 00:43:40,452
لاکھوں عورتیں عُمررسیدہ ہو رہی ہیں اور وہ شادی نہیں کر سکتیں

542
00:43:40,507 --> 00:43:43,561
کیوں؟ کیونکہ جب وہ عُمررسیدہ ہو جاتی ہیں تو کوئی ان سے شادی نہیں کرنا چاہتا

543
00:43:43,609 --> 00:43:48,088
کوئی بھی کثیر زوجگی کو پسند نہیں کرتا

544
00:43:48,120 --> 00:44:00,073
اسی لیے ہمارے مسلم معاشرے میں غیر شادی شدہ خواتین زیادہ ہیں

545
00:44:02,081 --> 00:44:04,918
لہذا، جب آپ اسے اِس نُقطۂِ نظر سے دیکھتے ہیں

546
00:44:04,950 --> 00:44:08,885
 کثیر زوجگی عورت کے ساتھ انصاف ہے، یہ ظلم نہیں ہے

547
00:44:08,926 --> 00:44:13,516
کیونکہ اس سے معاشرے کی ہر عورت کو رشتہ ازدواج میں منسلک ہونے کا موقع ملتا ہے

548
00:44:13,537 --> 00:44:16,918
کیونکہ ہمیشہ عورتوں کی تعداد مردوں کے مقابلے میں زیادہ ہوتی ہے

549
00:44:16,960 --> 00:44:24,204
لہذا، اگر کثیرزوجگی کو قبول نہیں کیا جاتا ، تو اس کا مطلب ہے، بہت سی عورتوں کو نکاح سے محروم رہیں گی

550
00:44:24,258 --> 00:44:37,616
لہٰذا، خواتین کے حقوق کے علمبرداروں کو دراصل کثیرزوجگی کو قانونی حیثیَّت دینے کا مطالبہ کرنا چاہیے

551
00:44:37,656 --> 00:44:39,926
 حضرت عُمر بن خطابؓ کا ذریعہ معاش؛

552
00:44:39,950 --> 00:44:47,319
آپؓ کا پہلا پیشہ اپنے والد اور اپنی خالہ کے چرواہے کا تھا

553
00:44:47,339 --> 00:44:52,519
اور پھر آپؓ نے کاروبار شروع کر دیا اور آپؓ اس میں بہت کامیاب رہے

554
00:44:52,559 --> 00:44:56,919
آپؓ نے شام اور یمن کا سفر کیا اور تجارت کی اور بہت زیادہ مال کمایا

555
00:44:56,957 --> 00:45:00,598
آپؓ قریش کے امیر عمائدین میں سے ایک تھے

556
00:45:00,654 --> 00:45:03,058
اور آپؓ پہلوان بھی تھے

557
00:45:03,092 --> 00:45:09,144
یہی(پہلوانی) وہ وجہ تھی جس بنا پر آپؓ عُکَّاظ کے میلے میں شریک ہوتے تھے

558
00:45:09,183 --> 00:45:13,006
آپؓ ناقابلِ شکست پہلوان تھے

559
00:45:13,026 --> 00:45:21,348
دَورِ جاہلیَّت میں بھی؛ اپنے مزاج کی وجہ سے، حضرت عمرؓ ہرگز ایسے شخص نہیں تھے جو نیم دِلی سے بحالتِ مجبوری کچھ کرتے

560
00:45:21,395 --> 00:45:24,682
آپؓ  ہر عمل خلوصِ دل سے سرانجام دیتے تھے

561
00:45:24,719 --> 00:45:32,536
آپؓ بہت پُرعزم، نظم و ضبط رکھنے والے اور اپنے عقائد پہ کامل یقین کے ساتھ سرگرمِ عمل رہنے والے شخص تھے

562
00:45:32,572 --> 00:45:37,129
آپؓ گوشہ نشینی کے بجائے پرجوش عملی اقدامات کو ترجیح دیتے تھے

563
00:45:37,161 --> 00:45:50,222
اس لیے دور جاہلیَّت میں آپؓ کا شمار قریش کی بااثر ترین شخصیات میں ہوتا تھا، جو مسلمانوں کے خلاف سب سے زیادہ متحرک تھے

564
00:45:50,275 --> 00:45:53,747
 آپؓ مسلمانوں پر ظُلم و ستم ڈھانے والے افراد میں سے سب سے زیادہ جابر تھے

565
00:45:53,780 --> 00:45:58,227
کیونکہ یہ حضرت عُمرؓ کی فطرت تھی کہ آپؓ اپنے عقائد کی پیروی میں انتہا تک جاتے تھے

566
00:45:58,266 --> 00:46:00,394
آپؓ عمل کے جذبے سے عاری شخص نہیں تھے

567
00:46:00,422 --> 00:46:04,560
قبل از اسلام، آپؓ اسلام قبول کرنے والی ایک لونڈی کو سخت سزا دیتے تھے

568
00:46:04,603 --> 00:46:07,873
آپؓ اُسے کوڑے سے مارتے

569
00:46:07,931 --> 00:46:11,853
اور پھر جب آپؓ سزا دیتے دیتے تھک جاتے تو بیٹھ جاتے اور اُسے کیا کہتے؟

570
00:46:11,884 --> 00:46:12,866
"آپؓ اُسے کہتے! ''سُنو

571
00:46:12,913 --> 00:46:18,856
میں نے سزا دیتے ہوئے اِس لیے ہاتھ نہیں روکا کہ مجھے تم پر تَرس آتا  ہے، میں نے اس لئے توقف کیا کہ میں تھک گیا ہوں

572
00:46:18,893 --> 00:46:21,085
وہ کنیز جواباً کہتی؛

573
00:46:21,132 --> 00:46:23,518
"اللہ ہی ہے جس نے تمہیں روکا"

574
00:46:23,567 --> 00:46:29,215
یہ اُس کنیز کا ایمانی استقلال تھا

575
00:46:29,251 --> 00:46:38,852
اور یہ مسلمانوں کے لئے ایک ناقابلِ یقین بات تھی؛ کہ ایک دن حضرت عُمرؓ مسلمان ہو جائیں گے

576
00:46:38,949 --> 00:46:45,557
ایک دن جب حضرت عُمر بن خطابؓ مَکَّہ مُکَرَّمہ کی گلیوں میں گھوم رہے تھے تو آپؓ نے دیکھا

577
00:46:45,600 --> 00:46:51,027
صحابیاتؓ میں سے ایک صحابیہ حبشہ کی طرف جا رہی تھیں

578
00:46:51,074 --> 00:46:54,610
وہ(صحابیہ) حبشہ کی طرف ہجرت کر رہی تھیں

579
00:46:54,655 --> 00:46:58,249
اُن سے حضرت عُمرؓ کہنے لگے؛ تم کہیں جا رہی ہو؟

580
00:46:58,280 --> 00:47:00,415
تو وہ کہنے لگیں؛ جی ہاں

581
00:47:00,449 --> 00:47:04,918
کیونکہ تم نے ہم پر ظلم کیا ہے اور ہمیں ستایا ہے

582
00:47:04,963 --> 00:47:12,527
ہم اللہ کی زمین میں اس لیے ہجرت کر رہے ہیں کہ ہم اپنے دین پر آزادانہ عمل کر سکیں

583
00:47:12,573 --> 00:47:17,114
تو حضرت عُمرِبن خطابؓ نے کیا فرمایا، آپؓ نے فرمایا؛

584
00:47:17,196 --> 00:47:18,478
 آپؓ نے فرمایا؛ صَحِبَكُمُ اللہ

585
00:47:18,957 --> 00:47:23,466
اللہ آپ کا حامی و ناصر ہو

586
00:47:23,502 --> 00:47:27,179
یہ قول بظاہر حضرت عُمرؓ کی فطرت کے خلاف تھا

587
00:47:27,232 --> 00:47:31,737
کہ حضرت عُمرؓ کسی مسلمان سے ہمدردی کریں

588
00:47:31,783 --> 00:47:38,656
چنانچہ جب حضرت نُعَیم اِبن عبداللہؓ واپس آئے وہ (مذکورہ) صحابیہؓ کے ہمراہ تھے

589
00:47:38,702 --> 00:47:42,047
اُس صحابیہؓ نے اُنہیں(حضرت نُعیم کو) سارا واقعہ بتایا

590
00:47:42,089 --> 00:47:47,910
حضرت نُعَیم ابن عبداللہؓ نے فرمایا؛ ایسا لگتا ہے کہ آپؓ حضرت عُمرؓ کے مسلمان ہونے کی امید کر رہی ہیں؟

591
00:47:47,949 --> 00:47:50,794
وہ صحابیہ فرمانے لگی؛ جی ہاں ،حضرت نُعَیم ابن عبداللہؓ  نے فرمایا ؛ میری بات سُنو

592
00:47:50,830 --> 00:47:56,103
''اُس(عمرؓ) کے باپ کا گدھا مسلمان ہو سکتا ہے مگر عمرؓ نہیں''

593
00:47:56,135 --> 00:47:58,590
حضرت نُعَیم ابن عبداللہؓ  فرما رہے تھے کہ تم خواتین اپنے جذبات قابو میں رکھو

594
00:47:58,610 --> 00:48:01,806
 عُمرؓ کبھی مسلمان نہیں ہوں گے

595
00:48:01,841 --> 00:48:04,712
لیکن صحابیہؓ  کی بات درست نکلی اور حضرت نُعَیم ابن عبداللہؓ غلط ثابت ہوئے

596
00:48:04,747 --> 00:48:06,959
لیکن اس سے یہ ثابت ہوتا ہے کہ

597
00:48:06,995 --> 00:48:11,349
لوگوں کو یقین نہیں تھا کہ ایک دن یہ شخص(حضرت عمرؓ) مسلمان ہو جائے گا

598
00:48:11,381 --> 00:48:14,169
لیکن نورِ ہدایت اللہ کے ہاتھ میں ہے

599
00:48:14,217 --> 00:48:17,503
ہم نہیں جانتے کہ کس کے مُقدّر میں ہدایت ہے

600
00:48:17,539 --> 00:48:25,982
 آپؓ کے وہم وگمان میں بھی یہ بات نہیں تھی اور آپؓ کی یہ رائے تھی کہ گدھا مسلمان ہوسکتا ہے، مگر حضرت عُمرؓ نہیں

601
00:48:26,050 --> 00:48:31,942
اُن کے لیے اس بات کا تَصَوُّر کرنا بھی محال تھا

602
00:48:31,972 --> 00:48:35,918
حضرت عمرؓ کیسے مسلمان ہوئے؛

603
00:48:35,973 --> 00:48:41,272
ایک واقعہ آپؓ کے بیٹے حضرت عبداللہؓ نے بیان کیا ہے

604
00:48:41,326 --> 00:48:49,169
آپؓ فرماتے ہیں؛ ایک دن ایک حسین و جمیل شخص ہمارے سامنے سے گزرا تو میرے والد نے اُس کی طرف دیکھا

605
00:48:49,193 --> 00:48:54,451
میرے والد نے اس  کے چہرے کی طرف دیکھا اور فرمایا؛ اگر میرا وجدان درست ہے

606
00:48:54,486 --> 00:49:02,146
 یہ شخص ایک کاہن ہے، جو اپنے لوگوں کو قسمت کا احوال بتاتا ہے

607
00:49:02,197 --> 00:49:06,344
ہم اس کو'' فراسہ'' کہتے ہیں،اس کا مطلب ہے'' چہرہ پڑھنے کا فن''

608
00:49:06,380 --> 00:49:10,620
 اور حضرت عُمر بن خطابؓ میں یہ خداداد صلاحیَّت تھی

609
00:49:10,656 --> 00:49:15,205
کہ آپؓ  کسی شخص کے  چہرے کو دیکھتے تو اُس کی شخصیَّت کو جانچ لیتے

610
00:49:15,230 --> 00:49:17,985
اور حضرت عُمر بن خطابؓ کی فراست بہت اچھَّی تھی

611
00:49:18,020 --> 00:49:21,915
تو اُس شخص کے چہرے کو دیکھ کر جس سے وہ پہلے کبھی نہیں ملے تھے

612
00:49:21,960 --> 00:49:23,808
حضرت عُمرؓ نے اُس کا چہرہ پڑھا اور فرمایا کہ

613
00:49:23,844 --> 00:49:27,721
یہ شخص اپنی قوم کا کاہن ہے

614
00:49:27,758 --> 00:49:35,420
چنانچہ آپؓ نے اُس آدمی کو بلایا، تو اس کاہن نے کہا؛ میں نے اِس سے پہلے ایسا آدمی نہیں دیکھا (مطلب) وہ حضرت عُمرؓ کی فراست پر حیران رہ گیا

615
00:49:35,464 --> 00:49:39,514
 حضرت عُمرؓ نے اُس نجومی سے کہا کہ مجھے اپنے بارے میں بتاؤ

616
00:49:39,549 --> 00:49:43,843
ویسے'' فراسہ'' کو ایک فن کے طور پر دیکھا جاتا تھا

617
00:49:43,864 --> 00:49:46,281
کہتے ہیں کہ امام شافعیؒ فراسہ سیکھنے یمن گئے تھے

618
00:49:46,306 --> 00:49:49,156
تو، یہ ایک قسم کا فن تھا، جسے سیکھا جا سکتا تھا

619
00:49:49,182 --> 00:49:57,342
اور یہ کچھ ثقافتوں میں آج بھی موجود ہے مثال کے طور پر چینی ثقافت، ان کے پاس فراسہ کی مختلف صورتیں ہیں جیسے چہرہ پڑھنا

620
00:49:57,404 --> 00:49:58,508
لیکن رَسُولُ اللہؐ فرماتے ہیں

621
00:49:58,529 --> 00:50:01,032
 "إِتَّقُوْا فَرَاسَةِ الْمُؤمِنْ فَإِنَه’ يَرَى بِنُوْرِ الله"

622
00:50:01,497 --> 00:50:08,554
مومن کے فراست سے بچو کیونکہ وہ اللہ کے نورِ بصیرت سے منور ہوکر دیکھتا ہے

623
00:50:08,594 --> 00:50:11,529
پس یہ ایک نعمت ہے جو بعض لوگوں کو عطا کی جاتی ہے اور حضرت عُمرؓ کے پاس یہ نعمت تھی

624
00:50:11,574 --> 00:50:19,269
تو حضرت عُمرؓ نے اُس آدمی کو بلایا تو اُس نے کہا؛ ہاں! میں کاہن ہوں

625
00:50:19,317 --> 00:50:25,296
حضرت عبداللہ بن عُمرؓ فرماتے ہیں کہ میرے والد کی پیش گوئی بہت کم غلط ثابت ہوتی

626
00:50:25,325 --> 00:50:28,694
حضرت عمرؓ کی پیش گوئی ہمیشہ صحیح درست ثابت ہوتی

627
00:50:28,726 --> 00:50:33,593
تو حضرت عُمرؓ نےاُس کاہن سے کہا کہ مجھے سب سے عجیب بات بتاؤ جو تمہارے مؤکلات نے تمہیں بتائی ہو

628
00:50:33,636 --> 00:50:37,935
کیونکہ یہ نجومی لوگ تھے، جو جِنّات کے ذریعے قِسمت کا حال بتاتے

629
00:50:37,982 --> 00:50:40,042
 نجومی جِنّات سے کام لیتے ہیں

630
00:50:40,060 --> 00:50:44,595
تو حضرت عُمرؓ نے اُس سے پوچھا کہ مجھے سب سے عجیب بات بتاؤ جو تم نے اپنے جِنّات سے سُنی ہے

631
00:50:44,626 --> 00:50:52,026
تو اُس نے کہا کہ میرا جِن میرے پاس آیا ہے، اس نے کچھ شاعرانہ کلام پڑھا

632
00:50:52,056 --> 00:50:55,678
جو کہ کسی نبی کی آمد کی بشارت کی طرف اشارہ تھا

633
00:50:55,713 --> 00:50:58,158
حضرت عُمر بن خطابؓ نے فرمایا؛ ہاں! یہ سچ ہے

634
00:50:58,193 --> 00:51:04,357
ایک دن جب ایک شخص کعبہ کے سامنے بُتوں کے لیے قربانی کر رہا تھا

635
00:51:04,412 --> 00:51:08,627
میں نے بہت اونچی آواز سنی

636
00:51:08,666 --> 00:51:12,956
اور یہ آواز کچھ اس طرح کہہ رہی تھی کہ ایک نبی ہے، جس کا ظہور ہونے والا ہے

637
00:51:12,989 --> 00:51:18,019
اور پھر حضرت عمرؓ نے فرمایا کہ اُس کے کُچھ عرصہ بعد حضرت محمدﷺ  نے نبوت دعویٰ کیا

638
00:51:18,055 --> 00:51:24,726
چنانچہ یہ نشانیاں تھیں جو حضرت عُمرؓ کو قبولِ اسلام کی طرف راغب کرنے کے لیے ظاہر ہو رہی تھیں

639
00:51:24,746 --> 00:51:31,869
 تو ابتدا میں یہ سب کچھ ہوا تھا

640
00:51:31,898 --> 00:51:40,931
یہ بھی ایک اہم واقعہ تھا، جو آپؓ کے اور ایک صحابیؓہ کے درمیان پیش آیا، آپ دیکھ سکتے ہیں کہ آپؓ کا دل نرم ہو رہا تھا اور آپؓ اسلام کی طرف مائل ہو رہے تھے

641
00:51:40,975 --> 00:51:46,331
آپؓ کا مُؤَقف بدل رہا تھا

642
00:51:46,365 --> 00:51:57,424
ایک دن جب مُشرکین بحث و مباحثہ کر رہے تھے کہ حضرت محمدﷺ کے مسئلے سے کیسے نمٹا جائے؟

643
00:51:57,470 --> 00:52:01,154
اُنہوں نے کہا کہ (نَعُوذُ بِاللہ) آپؐ کو کون قتل کرے گا؟

644
00:52:01,195 --> 00:52:06,104
حضرت عُمرؓ نے کہا: میں کروں گا، مُشرکین  نے کہا؛ آپ اِس کام  کے لئے بہت بہتر ہو

645
00:52:06,141 --> 00:52:12,627
چنانچہ،حضرت عمر بن خطابؓ نے مکہ میں انتہائی گرم دن کی دوپہر میں تلوار سونت لی

646
00:52:12,647 --> 00:52:16,574
اور آپؓ گلیوں سے گزرتے ہوئے دارِ اَرقم کی طرف بڑھ رہے  تھے

647
00:52:16,595 --> 00:52:20,679
آپؓ کو خبر ملی تھی کہ وہاں رَسُولُ اللہؐ صحابہ کرام کے ساتھ ملاقات کر رہے ہیں

648
00:52:20,733 --> 00:52:25,692
اور یہ ہجرت حبشہ کے بعد کی بات ہے، بہت سے صحابہؓ حبشہ کی طرف جا چکےتھے

649
00:52:25,747 --> 00:52:28,743
چنانچہ رَسُولُ اللہؐ ایک چھوٹی سی جماعت کے ساتھ مکہ میں رہ گئے تھے

650
00:52:28,768 --> 00:52:34,278
حضرت حمزہ بن عبدالمطلبؓ، حضرت ابوبکر صدیقؓ اور چند دوسرے صحابہؓ تھے

651
00:52:34,332 --> 00:52:38,564
چنانچہ حضرت عُمر بن خطابؓ مَکَّہ مُکَرَّمہ کی گلیوں میں چلتے جا رہے تھے

652
00:52:38,614 --> 00:52:43,747
اُن کی آنکھوں میں خُون اُترا ہوا تھا

653
00:52:43,768 --> 00:52:51,035
چنانچہ ایک صحابیؓ جو خُفیہ طور پر اسلام قُبول کر چکے تھے

654
00:52:51,073 --> 00:52:55,842
اُنھوں نے حضرت عُمر بن خطابؓ کو دیکھا تو انھیں کچھ غلط ہونے کا اندیشہ ہوا

655
00:52:55,876 --> 00:52:59,962
اُن صحابیؓ  نے حضرت عُمرؓ سے پوچھا کہ آپ کہاں جا رہے ہو؟

656
00:53:00,003 --> 00:53:07,508
حضرت عُمر بن خطابؓ  نے کہا؛ اس شخص کی طرف  جس نے ہماری قوم میں تفرَّقہ ڈالا ہوا ہے

657
00:53:07,553 --> 00:53:19,132
اور جس نے ہمیں بے وقوف بنایا ہے اور جس نے ہمارے معبودوں کو لعن طعن کیا ہے، میں اُس کی جان لینے جا رہا ہوں

658
00:53:19,190 --> 00:53:27,778
تو اُن صحابیؓ نے فرمایا کہ ایسا لگتا ہے کہ آپ کو خود پر بہت زیادہ بھروسہ ہے

659
00:53:27,812 --> 00:53:31,652
کیا آپ سمجھتے ہیں کہ بنی عبد مناف، رَسُولُ اللہؐ کا جو خاندان ہے

660
00:53:31,690 --> 00:53:37,011
وہ اپنے خاندان کے آدمی کو قتل کرنے کے بعد تمہیں رُوئے زمین پر رہنے دیں گے؟

661
00:53:37,046 --> 00:53:40,357
یہ قبائلی نظام تھا

662
00:53:40,404 --> 00:53:44,983
حضرت عُمر بن خطابؓ طیش میں تھے تو آپؓ نے اُس صحابیؓ سے بحث شروع کردی

663
00:53:45,028 --> 00:53:47,409
پھر حضرت عُمرؓ اُس صحابیؓ سے کہنے لگے، فرمایا؛

664
00:53:47,452 --> 00:53:52,726
میرا خیال ہے کہ تم بھی مسلمان ہو گئے ہو، اگر یہ حقیقت ہے

665
00:53:52,759 --> 00:53:58,016
میں تمہاری جان لینے سے ابتدا کروں گا

666
00:53:58,062 --> 00:54:05,979
چنانچہ یہ صحابیؓ حضرت عُمرؓ سے بحث اس لیئے کر رہے تھے

667
00:54:06,010 --> 00:54:09,750
  کیونکہ وہ حضرت عُمرؓ کو اپنے ارادہ سے باز رکھنا چاہتے تھے

668
00:54:09,792 --> 00:54:11,270
وہ رَسُولُ اللہؐ کو بچانا چاہتے تھے

669
00:54:11,313 --> 00:54:15,579
تو، جب انہوں نے محسوس کیا کہ یہ ایک دشوار امر ہے

670
00:54:15,601 --> 00:54:22,162
حضرت عُمرؓ کے ساتھ اس بحث کو طول دینا مشکل ہے، تو انہوں نے حضرت عُمرؓ سے کہا؛

671
00:54:22,201 --> 00:54:26,475
اچھا آپؓ ، رَسُولُ اللہؐ کی طرف جانے سے پہلے اپنے گھر کی خبر کیوں نہیں لیتے؟

672
00:54:26,517 --> 00:54:29,981
آپؓ، پہلے اپنے گھر کے بارے میں تو معلوم کر لیں؟

673
00:54:30,002 --> 00:54:32,208
حضرت عمر بن خطابؓ کہنے لگے، کیا مطلب ؟

674
00:54:32,238 --> 00:54:40,210
اُن صحابیؓ  نے فرمایا؛ آپ کی بہن اور اُس کا شوہر مسلمان ہو گئے ہیں

675
00:54:40,243 --> 00:54:47,906
اُن صحابیؓ نے یہ بات صرف اُس وقت کہی جب حضرت عُمرؓ کو اُن کے مذموم ارادے سے باز رکھنے کے لئے دیگر تاویلیں بے سود ہوگئیں

676
00:54:47,940 --> 00:54:55,408
حضرت عُمرؓ کی بہن اور ان کے شوہر حضرت سعید ابن زیدؓ خُفیہ طور پر مسلمان ہو چکے تھے

677
00:54:55,445 --> 00:54:57,820
اب سوال یہ پیدا ہوتا ہے کہ اُن صحابیؓ نے ایسا کیوں کیا

678
00:54:57,856 --> 00:55:02,094
حضرت عمرؓ کی بہن اور ان کے شوہر کو بڑی مشکل میں ڈال دیا

679
00:55:02,149 --> 00:55:04,047
انہوں نے اُن کے اسلام لانے کو ظاہر کردیا

680
00:55:04,078 --> 00:55:06,834
 اُنہوں نے ایسا کیوں کیا؟

681
00:55:06,889 --> 00:55:11,057
انھوں نے رَسُولُ اللہؐ کی سلامتی کے لیے یہ سب کیا

682
00:55:11,098 --> 00:55:14,397
تو اس سے ایک بات یہ بھی معلوم ہوتی ہے کہ

683
00:55:14,429 --> 00:55:23,865
رَسُولُ اللہؐ کی سلامتی کے لیے سب کچھ قربان کیا جا سکتا ہے

684
00:55:23,925 --> 00:55:31,028
چنانچہ اب حضرت عُمرؓ نے اپنا رستہ بدلا اور سیدھے اپنی بہن کے گھر چلے گئے

685
00:55:31,074 --> 00:55:37,285
آپؓ جب دروازے کے پاس پہنچے تو اُنہیں قرآن کی تلاوت کرتے سُنا

686
00:55:37,322 --> 00:55:43,090
حضرت فاطمہ بِنت خطابؓ اور اُن کے شوہر حضرت سعید بن زیدؓ، جو حضرت عُمرؓ کے چچازاد بھائی تھے

687
00:55:43,171 --> 00:55:46,754
اور آپؓ ان دس لوگوں میں سے ہیں جنہیں جَنّت کی بشارت دی گئی (عشرہ مبشرہ)

688
00:55:46,796 --> 00:55:54,057
 اوراُن دونوں کو حضرت خبّاب بن ارتؓ قرآن پڑھا رہے تھے

689
00:55:54,113 --> 00:55:58,236
جب آپ نے دروازہ بجایا اور اُن لوگوں نے دیکھا کہ یہ تو(دروازے پہ) حضرت عُمرؓ ہیں

690
00:55:58,278 --> 00:56:01,256
 حضرت خبابؓ فوراً چھپ گئے

691
00:56:01,288 --> 00:56:07,655
اور حضرت فاطمہ بنت خطابؓ نے قرآن کا صحیفہ اپنی ران کے نیچے چھپا لیا

692
00:56:07,684 --> 00:56:12,960
حضرت عمرؓ اندر آئے اور کہنے لگے؛ یہ کیسی دھیمی آواز تھی جو میں نے سنی؟

693
00:56:12,999 --> 00:56:16,527
انھوں نے جواب دیا ؛ کچھ نہیں تھا ہم صرف باتیں کر رہے تھے

694
00:56:16,564 --> 00:56:17,932
حضرت عُمرؓ نے کہا؛ مجھ سے جھوٹ مت بولو

695
00:56:17,963 --> 00:56:25,134
وہ آواز کیا تھی! اور کیا تم مسلمان ہو گئے ہو؟

696
00:56:25,176 --> 00:56:29,846
حضرت سعید بن زیدؓ نے فرمایا؛ اچھا تو( اس میں کیا مضائقہ ہے) اگر اسلام تمہارے دین سے بہتر ہو تو؟

697
00:56:29,867 --> 00:56:33,846
اسی وقت حضرت عُمر بن خطابؓ نے حضرت سعیدؓ پر وار کیا

698
00:56:33,894 --> 00:56:40,899
 حضرت عُمرؓ نے انہیں زمین پر گرایا اور پھر آپؓ اُن کے سینے پر چڑھ گئے

699
00:56:40,931 --> 00:56:44,522
حضرت فاطمہؓ بنت خطاب نے جب یہ دیکھا تو اپنے شوہر کے دفاع کے لیے آگے بڑھیں

700
00:56:44,575 --> 00:56:48,149
حضرت عُمر بن خطابؓ نے اپنی بہن پہ بھی ہاتھ اُٹھایا

701
00:56:48,191 --> 00:56:53,311
آپؓ نے اُن کے چہرے پہ مارا اور اُن کے منہ سے خون بہنے لگا

702
00:56:53,357 --> 00:57:03,218
بہن نے  کہا؛ اے اللہ کے دشمن تم نے مجھے صرف اس لیے مارا کہ میں اللہ پر ایمان رکھتی ہوں؟

703
00:57:03,263 --> 00:57:08,089
چاہے تم اِسے پسند کرو یا نہ کرو

704
00:57:08,131 --> 00:57:11,515
میں گواہی دیتی ہوں کہ اللہ کے سوا کوئی معبود نہیں

705
00:57:11,536 --> 00:57:17,572
اور یہ کہ حضرت محمدﷺ، اللہ کے رَسُول ہیں،تم جو چاہو کرو

706
00:57:17,658 --> 00:57:20,705
جب حضرت عُمر بن خطابؓ نے اپنی بہن کا یہ ایمانی استقلال دیکھا

707
00:57:20,726 --> 00:57:25,091
 اور پُراعتماد لہجہ دیکھا اور اپنی بہن کے چہرے پر خون دیکھا

708
00:57:25,122 --> 00:57:27,754
آپؓ کو اپنے عمل پر شرمندگی محسوس ہوئی

709
00:57:27,794 --> 00:57:34,114
 عرب کے رسم و رواج میں عورت کو اِس طرح مارنا معیوب سمجھا جاتا تھا

710
00:57:34,163 --> 00:57:38,317
لہٰذا، آپؓ کو اپنی بہن کے ساتھ اپنے برتاؤ پر ندامت ہوئی

711
00:57:38,353 --> 00:57:44,416
چنانچہ آپؓ، حضرت سعیدؓ کے اوپر سے ہٹ گئے اور بیٹھ گئے

712
00:57:44,469 --> 00:57:50,762
حضرت عُمرؓ نے بہن سے کہا؛ اپنے صحائف مجھے دے دو، بہن نے کہا؛ میں نہیں دوں گی

713
00:57:50,793 --> 00:57:56,868
حضرت عُمرؓ نے فرمایا؛ تُم نے جو کہا، اُس نے میرے دل پر اثر کیا ہے

714
00:57:56,898 --> 00:58:02,588
اور میں آپ سے وعدہ کرتا ہوں کہ میں آپ کو صحیفہ محفوظ طریقے سے واپس کر دوں گا

715
00:58:02,625 --> 00:58:07,172
بہن نے کہا؛ آپ مشرک ہو اور ناپاکی کی حالت میں ہیں

716
00:58:07,211 --> 00:58:10,545
لہذا آپؓ کو پہلے غسل کرنا ہوگا

717
00:58:10,576 --> 00:58:16,568
حضرت عمر بن خطابؓ تشریف لے گئے اور غُسل فرمایا اور پھر واپس آئے

718
00:58:16,610 --> 00:58:19,414
پھر آپؓ کی بہن نے اُنہیں قرآن پاک دیا

719
00:58:19,465 --> 00:58:25,494
حضرت عمر بن خطابؓ نے آیات کی تلاوت شروع کی

720
00:58:25,565 --> 00:58:27,623
بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ۞

721
00:58:27,659 --> 00:58:28,909
 طه۞

722
00:58:29,163 --> 00:58:32,356
مَا أَنْزَلْنَا عَلَيْكَ الْقُرْآنَ لِتَشْقَى۞

723
00:58:33,298 --> 00:58:35,349
إِلَّا تَذْكِرَةً لِمَنْ يَخْشَى۞

724
00:58:36,338 --> 00:58:40,269
تَنْزِيلًا مِمَّنْ خَلَقَ الْأَرْضَ وَالسَّمَاوَاتِ الْعُلَى۞

725
00:58:41,240 --> 00:58:43,172
الرَّحْمَنُ عَلَى الْعَرْشِ اسْتَوَى۞

726
00:58:44,007 --> 00:58:48,393
لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ الثَّرَى۞

727
00:58:49,376 --> 00:58:52,413
وَإِنْ تَجْهَرْ بِالْقَوْلِ فَإِنَّهُ يَعْلَمُ السِّرَّ وَأَخْفَى ۞

728
00:58:53,028 --> 00:58:56,489
اللَّهُ لَا إِلَهَ إِلَّا هُوَ لَهُ الْأَسْمَاءُ الْحُسْنَى ۞

729
00:58:58,920 --> 00:59:00,536
آیات کا ترجمہ یہ ہے

730
00:59:01,603 --> 00:59:07,494
(اے نبیؐ ) نہیں نازل کیا ہم نے تم پر قرآن کہ تم مشقت میں پڑ جاو

731
00:59:07,528 --> 00:59:13,309
 مگر یہ نصیحت ہے اُن کے لئے جو اللہ سے ڈرتے ہیں

732
00:59:13,351 --> 00:59:17,689
یہ(قرآن) اُس کی طرف سے نازل کردہ ہے پیدا کیا ہے جس نے زمین اور بلند آسمانوں کو

733
00:59:17,726 --> 00:59:23,328
وہ (اللہ) رحمٰن عرش پر تمکنت سے جلوہ افروز ہوا

734
00:59:23,371 --> 00:59:27,061
جو کچھ آسمانوں اور زمین میں ہے سب اُسی کا ہے

735
00:59:27,102 --> 00:59:30,808
اور اسی کا ہے سب جو اس کے درمیان اور جو زمین کے نیچے ہے

736
00:59:30,853 --> 00:59:33,616
اگرچے تم تم بلند آواز سے پکارو

737
00:59:33,647 --> 00:59:40,605
 اِس سے کوئی فرق نہیں پڑتا کیونکہ وہ(اللہ) جانتا ہے جو کچھ پوشیدہ ہے، جو کچھ چھپا ہوا ہے

738
00:59:40,639 --> 00:59:47,543
اللہ کے سوا کوئی معبود نہیں ہے  تمام صفاتی نام اس(اللہ) کے لیے ہیں

739
00:59:47,575 --> 00:59:50,882
جب حضرت عمر بن خطابؓ نے یہ آیات پڑھیں تو فرمایا؛

740
00:59:50,922 --> 00:59:57,269
کیا قُریش اِسی کے خلاف تھے؟

741
00:59:57,309 --> 01:00:02,892
بیشک وہ معبودِ برحق ہے جس کا یہ کلام ہے

742
01:00:02,912 --> 01:00:04,296
دُلُّوْنِي عَلَى محمدﷺ

743
01:00:04,317 --> 01:00:07,291
حضرت محمدﷺکہاں ہیں؟

744
01:00:07,355 --> 01:00:10,318
تو جب آپؓ کے بہنوئی اور بہن  نے محسوس کیا کہ آپؓ اسلام قبول کرنے میں مخلص اور سنجیدہ ہیں

745
01:00:10,358 --> 01:00:12,528
آپؓ واقعی مسلمان ہونا چاہتے ہیں

746
01:00:12,566 --> 01:00:18,514
انہوں نے حضرت عُمرؓ کو بتایا کہ فلاں جگہ رَسُولُ اللہؐ  صحابہؓ کے ساتھ موجود ہیں

747
01:00:18,553 --> 01:00:22,091
حضرت عمربن خطابؓ اب مکَّہ مُکرَّمہ کی گلیوں میں رَسُولُ اللہؐ کی تلاش میں جا رہے تھے لیکن

748
01:00:22,116 --> 01:00:27,591
اس بار آپؓ کی نِیَّت مختلف تھی

749
01:00:27,634 --> 01:00:33,974
آپؓ دارِارقم پہنچے اور دروازے پر دستک دی

750
01:00:34,007 --> 01:00:37,846
آپؓ مکَّہ کی گلیوں سے گذرتے ہوئے

751
01:00:37,875 --> 01:00:42,940
 آپؓ دارِارقم پہنچے اور دروازے پر دستک دی

752
01:00:42,969 --> 01:00:50,467
صحابہؓ نے دیکھا کہ دروازے پر حضرت عُمرؓ ہیں چنانچہ وہ سب بیٹھ گئے

753
01:00:50,506 --> 01:00:56,173
حضرت حمزہؓ نے صحابہؓ  کی طرف دیکھا اور فرمایا؛ آپ سب کو کیا ہوا ہے؟ وہ کہنے لگے کہ یہ تو حضرت عُمرؓ ہیں

754
01:00:56,211 --> 01:00:57,820
حضرت حمزہؓ نے فرمایا؛

755
01:00:57,847 --> 01:01:00,300
تو کیا ہوا، اگر یہ عُمرؓ ہے

756
01:01:00,331 --> 01:01:06,582
یہ بات حضرت حمزہؓ کے علاوہ کوئی نہیں کہہ سکتا تھا کیونکہ باقی سب بیٹھ گئے تھے

757
01:01:06,647 --> 01:01:10,442
کوئی بھی دروازہ کھول کر حضرت عمر بن خطابؓ کا سامنا کرنے کی جرأت نہیں کرنا چاہتا تھا

758
01:01:10,493 --> 01:01:13,488
لیکن حضرت حمزہؓ ہی حضرت عُمرؓ کا سامنا کرسکتے تھے

759
01:01:13,521 --> 01:01:16,121
حضرت حمزہؓ قریش کے سردار تھے،

760
01:01:16,141 --> 01:01:18,281
آپؓ نے فرمایا؛ کیا ہوا جو عُمرؓ ہے ؟

761
01:01:18,315 --> 01:01:21,207
اگر وہ نیک ارادہ سے آیا ہے تو اسکا استقبال کریں گے

762
01:01:21,241 --> 01:01:26,343
اگر وہ(حضرت عمرؓ) برائی کی نیَّت سے آیا ہے تو اسے اسکی ہی تلوار سے قتل کر دیں گے

763
01:01:26,375 --> 01:01:32,509
کیونکہ حضرت عُمرؓ اپنی تلوار گردن پر لٹکائے ہوئے تھے

764
01:01:32,561 --> 01:01:38,407
حضرت حمزہؓ نے دروازہ کھولا اور اُنھوں نے اور ایک دوسرے صحابیؓ نے حضرت عُمرؓ کو بازو سے پکڑ لیا

765
01:01:38,442 --> 01:01:41,314
اور وہ انہیں رَسُولُ اللہؐ کے پاس لے آئے

766
01:01:41,346 --> 01:01:45,481
رَسُولُ اللہؐ نے فرمایا؛''اُرسِلُو'' اِسے چھوڑ دو

767
01:01:45,525 --> 01:01:50,503
چنانچہ حضرت حمزہؓ اور دوسرے صحابیؓ نے حضرت عُمرؓ کو چھوڑ دیا

768
01:01:50,542 --> 01:01:54,643
اگرچہ رَسُولُ اللہؐ کا قد حضرت عُمرؓ کے مقابلے میں چھوٹا تھا

769
01:01:54,688 --> 01:01:59,579
لیکن رَسُولُ اللہؐ کے پاس تیس آدمیوں کے برابر قوت تھی

770
01:01:59,627 --> 01:02:05,832
رَسُولُ اللہؐ نے حضرت عُمرؓ کو گریبان سے پکڑ کر اپنی طرف کھینچا اور فرمایا؛

771
01:02:05,872 --> 01:02:08,558
تم یہاں کیوں آئے ہو اِبن خطاب ؟

772
01:02:08,600 --> 01:02:13,020
آپؐ نے فرمایا؛ کیا تم اسلام سے لڑنا اس وقت تک نہیں چھوڑو گے، جب تک اللہ تمہیں ہلاک نہ کردے

773
01:02:13,076 --> 01:02:15,911
حضرت عمر بن خطابؓ نے فرمایا؛ یا رَسُولُ اللہؐ

774
01:02:15,965 --> 01:02:21,234
میں یہاں اللہ اور اس کے رَسُولؐ پر ایمان لانے کے علاوہ کسی اور نِیَّت سے نہیں آیا

775
01:02:21,273 --> 01:02:23,531
رَسُولُ اللہؐ نےنَعرۂِ تکبیر بلند فرمایا

776
01:02:23,560 --> 01:02:25,231
اب باقی صحابہؓ میں سے کوئی وہاں موجود نہیں تھا

777
01:02:25,249 --> 01:02:28,564
 اُنہیں نہیں پتا تھا کہ کیا ہو رہا ہے وہ تو چھپ کر بیٹھے تھے

778
01:02:28,602 --> 01:02:31,573
جب اُنہوں نے رَسُولُ اللہؐ کے نَعرۂِ تکبیر کو سُنا

779
01:02:31,616 --> 01:02:36,173
پورا گھر تکبیر کے نعروں سے گونج اٹھا، اُنہیں یقین نہیں آرہا تھا

780
01:02:36,208 --> 01:02:38,201
وہ نَعرۂِ تکبیر لگاتے ہوئے اتنے پُرجوش ہوگئے

781
01:02:38,221 --> 01:02:43,002
اور یہ کہ ان کی آواز اس قدر اونچی تھی کہ وہ دارارقم سے اٹھ اپنے اپنے گھروں کو چلے گئے

782
01:02:43,033 --> 01:02:46,056
 تا کہ سب کو حضرت عُمرؓ کے قبولِ اسلام کی خبر ہو جائے

783
01:02:46,092 --> 01:02:52,476
حضرت عمربن خطابؓ کا اسلام قبول کرنا اُن کیلئے بہت بڑی خُوشی تھی

784
01:02:52,514 --> 01:02:58,540
حضرت خباب بن ارتؓ، جب حضرت عُمرؓ قرآن پڑھ رہے تھے

785
01:02:58,596 --> 01:03:03,209
جب حضرت عمرؓ نے فرمایا کہ میں جا کر حضرت محمدﷺ سے ملنا چاہتا ہوں،آپؓ باہر نکل آئے

786
01:03:03,241 --> 01:03:09,853
اور حضرت خباب بن ارتؓ نے فرمایا؛ میرا خیال ہے کہ اللہ تعالیٰ نے رَسُولُ اللہؐ کی دعا قبول فرما لی ہے

787
01:03:09,873 --> 01:03:11,446
رَسُولُ اللہؐ نے دعا فرمائی تھی

788
01:03:11,467 --> 01:03:18,577
اَلَّلهُمَّ اَعِزَّ الّاِسْلَامْ بِاَحَبِّ الرَّجُلَيْنِ اِلَيْكْ عَمرو اِبن ہشَّام او عُمر اِبن الْخطاب

789
01:03:20,449 --> 01:03:26,985
اے اللہ اسلام کو دو آدمیوں میں سے ایک کے زریعے عزت عطا فرما؛ جو ان دونوں میں سے تجھے زیادہ محبوب ہو

790
01:03:27,010 --> 01:03:30,573
بِاَحَبِّ الرَّجُلَيْنِ اِلَيْكْ عَمرو اِبن ہشَّام او عُمر اِبن الْخطاب

791
01:03:30,760 --> 01:03:32,820
یا تو عَمرو اِبن ہشَّام یا عُمر اِبن الْخطاب میں سے

792
01:03:32,846 --> 01:03:36,400
عَمرو اِبن ہشَّام کون ہے ؟ ابوجہل

793
01:03:36,430 --> 01:03:40,672
رَسُولُ اللہؐ نے دعا کی اور فرمایا: اے اللہ اسلام کو دو افراد میں سے ایک کے زریعے سے قوت عطا فرما

794
01:03:40,714 --> 01:03:46,724
جو آپ کو سب سے زیادہ پسند ہے، ابوجہل یا عُمراِبن الْخطاب

795
01:03:46,761 --> 01:03:51,936
رَسُولُ اللہؐ نے اِن دو مخصوص آدمیوں کے لیے کیوں دعا فرمائی؟

796
01:03:51,973 --> 01:04:00,236
تا کہ اُن کی طاقت اسلام کی طاقت میں بدل جائے

797
01:04:00,281 --> 01:04:05,545
ابو جہل اپنی قوم کا سردار تھا، بہت عقلمند آدمی تھا

798
01:04:05,585 --> 01:04:09,610
آپ جانتے ہیں کہ لوگوں میں ابوجہل کے بارے میں یہ تأثُر ہے کہ وہ بہت بڑا فسادی تھا

799
01:04:09,654 --> 01:04:13,558
نہیں، ابوجہل ایک مضبوط آدمی تھا

800
01:04:13,588 --> 01:04:21,231
وہ ایک نڈرشخص تھا، وہ پُختہ عزم کا مالک تھا

801
01:04:21,285 --> 01:04:28,924
وہ ایک محنت کرنے والا، دانا اور ذہین شخص تھا

802
01:04:28,954 --> 01:04:32,092
اِس لیے لوگوں نے اسے خطاب دیا تھا اور اُس کا اصل نام عَمرو بن ہشَّام  ہے

803
01:04:32,117 --> 01:04:36,263
اس کا نام ابوجہل نہیں، اس کا نام عَمرو بن ہشَّام  ہے

804
01:04:36,301 --> 01:04:44,663
لیکن اس کی حکمت کی وجہ سے اسے ''اَبُوالْحَکم'' کا لقب دیا گیا، مطلب بابائے حکمت

805
01:04:44,705 --> 01:04:50,513
 رَسُولُ اللہؐ نے اُس کا نام ابوجہل رکھا، بابائے جاہلیَّت

806
01:04:50,575 --> 01:04:55,032
کیوں؟ کیونکہ آپ چاہے کتنے ہی ذہین کیون نہہ ہوں اور چاہے کتنے ہی عقلمند کیوں نہ ہوں

807
01:04:55,078 --> 01:04:58,048
اگر آپ کی ذہانت آپ کو اسلام کی طرف راغب نہ کر سکے

808
01:04:58,069 --> 01:05:00,432
 آپ میں کچھ بھی ذہانت اور عقل و شعور نہیں ہے

809
01:05:00,452 --> 01:05:02,354
اگر آپ کی ذہانت آپ کو اِس پر بات پر نہیں لا سکتی سکتی کہ

810
01:05:02,375 --> 01:05:04,640
لا اله الا الله و ان محمد رسول الله

811
01:05:04,701 --> 01:05:07,125
تو آپ باشعور نہیں

812
01:05:07,158 --> 01:05:09,233
چاہے لوگ آپ کو کتنا ہی ذہین سمجھتے رہیں

813
01:05:09,575 --> 01:05:16,224
اگر تُمہاری عقل تُمہیں اِسلام کی طرف نہ لےجائے  تو تُم میں کچھ بھی عقل نہیں

814
01:05:16,266 --> 01:05:19,116
اور یہ قیامت کے دن کُفَّار کی پُکار ہوگی

815
01:05:19,165 --> 01:05:24,290
وَقَالُوا لَوْ كُنَّا نَسْمَعُ أَوْ نَعْقِلُ مَا كُنَّا فِي أَصْحَابِ السَّعِيرِ۞

816
01:05:24,310 --> 01:05:30,372
اگر ہم عقل رکھتے اور(پیغامِ حق) سُن سکتے تو ہم یہاں نہ ہوتے

817
01:05:30,405 --> 01:05:33,032
ہم میں کچھ عقل نہ تھی

818
01:05:33,066 --> 01:05:36,485
چنانچہ آپؐ نے اُس کا نام ابو جہل رکھا

819
01:05:36,534 --> 01:05:45,307
اللہ تعالیٰ نے رَسُولُ اللہؐ کی دعا قبول فرمائی اور حضرت عُمربن خطابؓ کو منتخب فرمایا

820
01:05:45,819 --> 01:05:52,473
ایک اور واقعہ ہے جو حضرت عُمرؓ کے ساتھ پیش آیا

821
01:05:52,493 --> 01:05:56,866
اور یہ واقعہ آپؓ کو اسلام کے قریب لے آیا

822
01:05:56,905 --> 01:06:00,389
حضرت عمر بن خطابؓ اپنی جاہلیَّت کے دَورمیں بہت زیادہ شراب پیتے تھے

823
01:06:00,422 --> 01:06:03,975
اُنہیں شراب بہت پسند تھی

824
01:06:04,023 --> 01:06:10,978
اور اُن کے بہت سے نُدَماء تھے یعنی شرابی دوست تھے

825
01:06:11,023 --> 01:06:13,787
ایک رات بہت دیر ہو چکی تھی

826
01:06:13,836 --> 01:06:18,194
وہ مکّہ مکرَّمہ کے شراب خانوں میں گئے وہ سب بند تھے

827
01:06:18,226 --> 01:06:21,173
 پہلے شراب خانے میں کوئی نہیں تھا، دوسرے شراب خانے میں بھی کوئی نہیں تھا

828
01:06:21,203 --> 01:06:27,923
انہیں(حضرت عمرؓ کو) اپنا کوئی پینے والا ساتھی نہیں ملا، بہت دیر ہو چکی تھی

829
01:06:27,947 --> 01:06:33,675
چنانچہ آپؓ نے فیصلہ کیا کہ اگر اور کچھ نہیں کرنا تو کیوں نہ جا کر طواف ہی کر لوں

830
01:06:33,731 --> 01:06:38,948
تو، آپؓ کعبہ جاتے ہیں کہ اس سے بہتر کوئی چیز نہیں ہے

831
01:06:38,989 --> 01:06:45,144
اور آپؓ وہاں کس کو دیکھتے ہیں، رات گئے اُس وقت وہاں اور کوئی نہیں تھا، آپؓ کیا دیکھتے ہیں کہ

832
01:06:45,190 --> 01:06:51,880
حضرت محمدﷺ نماز ادا کررہے ہیں، رات کی اِس گھڑی میں جب سب سو رہے تھے

833
01:06:51,916 --> 01:06:57,877
رَسُولُ اللہؐ کعبہ کے سامنے کھڑے ہو کر رُکوع و سُجود کر رہے ہیں

834
01:06:57,919 --> 01:07:08,508
حضرت عمر بن خطابؓ نے فرمایا اچھا میں کیوں نہ آج محمدﷺ کو ڈراؤں اور اُن کو خوف زدہ کروں کہ وہ آج اکیلے ہیں

835
01:07:08,545 --> 01:07:14,318
تو آپؓ نے یہ کیا کہ کعبہ کے پیچھے چلے گئے، اس لیے رَسُولُ اللہؐ اُنہیں نہیں دیکھ سکتے تھے

836
01:07:14,338 --> 01:07:18,889
اور حضرت عمرؓ کعبہ اور کعبہ کے غلاف کے درمیان چھپ گئے

837
01:07:18,910 --> 01:07:20,544
کعبہ جو کہ ایک غلاف سے ڈھکا ہوا تھا

838
01:07:20,564 --> 01:07:23,980
چنانچہ حضرت عُمرؓ کعبہ اور اس کے غلاف کے درمیان کھڑے ہوئے تھے

839
01:07:24,013 --> 01:07:27,379
اور پھر آپؓ خاموشی سے کعبہ کے پردے سے باہر دیکھنے لگتے ہیں

840
01:07:27,411 --> 01:07:31,698
اس لیے رَسُولُ اللہؐ اُنہیں (حضرت عمرؓ) نہ دیکھ سکے؛ حتی کہ وہ  رَسُولُ اللہؐ کے عین سامنے آ گئے

841
01:07:31,729 --> 01:07:37,055
رَسُولُ اللہؐ اُنہیں نہیں دیکھ سکے کیونکہ وہ کعبہ کے غلاف کے پیچھے تھے

842
01:07:37,098 --> 01:07:42,135
حضرت عُمرؓ رَسُولُ اللہؐ پر گھات لگانا چاہتے تھے

843
01:07:42,178 --> 01:07:47,707
لیکن جب آپؓ، رسول اللہؐ کے قریب پہنچے تو اُن کو قرآن کی آیات سنائی دینے لگیں

844
01:07:47,746 --> 01:07:52,606
ایسے موقع پر قریش کانوں میں اُنگلیاں ٹھونس دیتے تھے، تا کہ وہ قرآن نہ سُن سکیں

845
01:07:52,652 --> 01:08:07,769
لیکن اب، حضرت عُمرؓ وہیں اللہ کے رسول کے سامنے، قرآن کی آیات کو غور سے سُن رہے تھے

846
01:08:07,815 --> 01:08:14,219
حضرت عُمرؓ نے دل میں کہا؛ یہ کسی شاعر کا کلام ہے یہ شاندار کلام ہے

847
01:08:14,267 --> 01:08:17,325
یہ ضرور کسی شاعر کا کلام ہے

848
01:08:17,366 --> 01:08:21,358
رسول اللہؐ سورۃ الحاقۃ کی تلاوت فرما رہے تھے

849
01:08:21,388 --> 01:08:26,918
 عین اسی وقت جب آپؓ کو یہ خیال آیا، رَسُولُ اللہؐ نے جو آیت تلاوت فرمائی وہ یہ تھی ؛

850
01:08:26,956 --> 01:08:30,038
وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَا تُؤْمِنُونَ۞

851
01:08:30,072 --> 01:08:35,671
یہ کسی شاعر کے الفاظ نہیں ہیں، تم کم ہی یقین کرتے ہو

852
01:08:35,702 --> 01:08:38,457
حضرت عُمر بن خطابؓ چونک گئے اور آپؓ نے فوراً کہا؛

853
01:08:38,477 --> 01:08:41,714
پھر یہ کسی کاہن کا کلام ہو گا، کسی نجومی کا

854
01:08:41,735 --> 01:08:44,839
اِنہیں کیسے معلوم ہوا کہ میرے دل میں کیا ہے؟ اگلی آیت جو آپؐ نے تلاوت فرمائی وہ یہ تھی

855
01:08:44,864 --> 01:08:47,107
وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَا تَذَكَّرُونَ۞

856
01:08:47,254 --> 01:08:52,485
اور نہ کسی کاہن کا قول ہے، افسوس بہت کم نصیحت لے رہے ہو

857
01:08:52,506 --> 01:08:57,938
حضرت عُمرؓ کے قدم وہیں سُن ہو گئے

858
01:08:57,994 --> 01:09:00,967
کہنے لگے، یہ ضرور اللہ کا کلام ہے

859
01:09:01,020 --> 01:09:06,797
چنانچہ اللہ تعالیٰ انہیں اس اہم کردار کے لیے تیار کر رہے تھے جو مستقبل میں حضرت عُمرؓ ادا کرنے والے تھے

860
01:09:06,818 --> 01:09:11,696
انہیں تمام صحابہؓ میں دوسرے عظیم صحابی کا مرتبہ ملنا تھا

