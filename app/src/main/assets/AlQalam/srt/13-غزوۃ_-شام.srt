1
00:00:22,037 --> 00:00:24,709
اَعُوْذُ بِاللهِ مِنَّ الشِّيْطَانِ الرَّجِيْمِ۝بِسْمِ اللهِ الرَّحْمَانِ الرَّحِيْمَ۝

2
00:00:24,741 --> 00:00:29,770
اَلْحَمْدُ لله ، وَالصَّلَاةُ وَالسَّلَامُ عَلى سَيِّدِنَا محمد وَعَلَى اَلِهِ وَصَحْبِهِ وَسَلِّمْ

3
00:00:31,061 --> 00:00:43,420
حضرت شارحبیل بن حسنہؓ اُن صحابہ میں سے تھے، جنہوں نے مرتدین کے خلاف لشکر کی قیادت کی تھی

4
00:00:43,466 --> 00:00:49,707
خلیفہ سیدنا حضرت ابوبکر صدیقؓ کے پاس آئے اور فرمایا؛

5
00:00:49,726 --> 00:00:59,347
اے رسول اللہؐ کے جانشین ! کیا آپؓ شام  کو فتح کرنے کا سوچ رہے ہیں؟

6
00:00:59,379 --> 00:01:03,090
کیا آپؓ رومیوں سے جنگ کرنے کا ارادہ رکھتے ہیں ؟

7
00:01:03,130 --> 00:01:09,823
حضرت ابوبکرصدیقؓ نے جواباً فرمایا؛ جی ہاں

8
00:01:09,856 --> 00:01:14,613
لیکن میں نے اپنے اس ارادے کا کسی سے ذکر نہیں کیا

9
00:01:14,650 --> 00:01:17,810
تو آپؓ کو اِس کا علم کیسے ہوا؟

10
00:01:17,859 --> 00:01:25,257
تو، حضرت ابوبکر صدیقؓ شام پر حملہ کرنے کا سوچ رہے تھے

11
00:01:25,329 --> 00:01:27,913
آپؓ اس پر غوروغوص کر رہے تھے

12
00:01:27,955 --> 00:01:39,663
دیکھیں، شام مسلمانوں کے ذہنوں میں اس وقت سے تھا، جب رسول اللہ ﷺ نے اسراء کا سفر کیا

13
00:01:39,695 --> 00:01:47,167
جب رسول اللہؐ یروشلم تشریف لے گئے اور آپؐ نے انبیاءؑ کی امامت فرمائی

14
00:01:47,203 --> 00:01:51,650
یہ(امامت) رسول اللہؐ کو ارضِ مقدس کی کُنجیاں ملنے کی علامت تھی

15
00:01:51,680 --> 00:01:55,617
اب آپؐ اِس مقدس سرزمین کے وارث ہیں

16
00:01:55,691 --> 00:01:57,911
الأَرض الَّتِي بَارَكْنَا فِيهَا

17
00:01:57,936 --> 00:02:04,063
اللہ عَزَّوَجَلْ فرماتا ہے کہ یہ وہ با برکت سرزمین ہے جس کا ذکر قرآن میں ہے

18
00:02:04,122 --> 00:02:09,950
چنانچہ، جب رسول اللہؐ وہاں جاتے ہیں اور انبیاءؑ کی امامت فرماتے ہیں،

19
00:02:09,970 --> 00:02:14,230
جن میں بہت سے انبیاءؑ اِس ارضِ مقدس پر مقیم تھے

20
00:02:14,265 --> 00:02:17,240
حقیقتََا؛ چونکہ رسول اللہؐ سب انبیاءؑ کی امامت فرما رہے ہیں،

21
00:02:17,292 --> 00:02:24,623
یہ اِس طرف اشارہ ہے کہ حضرت محمدﷺ اب ایک نئے رہنما ہیں، آپؐ ہی اب حق کے وارث ہیں

22
00:02:24,659 --> 00:02:28,803
اور آپؐ ہی مشعلِ حق کے علمبردار ہیں

23
00:02:28,839 --> 00:02:35,843
 اگرچہ، مسلمان ارضِ پاک(حجاز مقدس) کے مُستَولی نہیں تھے

24
00:02:35,884 --> 00:02:43,323
لیکن بہت جلد، انہوں نے اپنی نگاہیں ارضِ مقدس پر مرکوز کر لیں تھیں

25
00:02:43,355 --> 00:02:51,437
تو رسول اللہؐ اس سے پہلے عرب کو فتح کرنے کی جنگی سرگرمیاں ختم کریں،

26
00:02:51,469 --> 00:02:59,130
آپؐ نے حضرت زید ابن حارثہؓ  کی قیادت میں سرزمینِ شام میں واقع وادیِ مؤتہ کی طرف ایک لشکر بھیجا

27
00:02:59,162 --> 00:03:04,807
اور اس سے پہلے، آپؐ نے غسان کے بادشاہ(حارث) کو خط بھیجا

28
00:03:04,844 --> 00:03:09,380
 حارث غسانی نے جب دیکھا کہ مدینہ منورہ سے حضرت محمد ﷺ، اُسے اسلام کی دعوت دے رہے ہیں۔

29
00:03:09,415 --> 00:03:10,760
أسلِم تَسْلَمْ

30
00:03:10,969 --> 00:03:16,583
وہ سخت مشتعِل اور برہم ہوا، اُس نے مدینہ منورہ پر حملہ کرنا چاہا

31
00:03:16,632 --> 00:03:21,619
لیکن اِسے قیصرِ روم نے ایسا کرنے سے روک دیا، ہرقل ہی تھا جس نے حارث غسانی  کو پُر سکون رہنے کا کہا

32
00:03:21,639 --> 00:03:26,573
کیونکہ شہنشاہِ غسان، قیصر روم کا حلیف تھا

33
00:03:26,627 --> 00:03:39,863
اور پھر رسول اللہ ﷺ نویں ہجری میں خود غزوہ تبوک کے لیے روانہ ہوئے جوکہ حجاز اور شام کی وسطی حدود ہے

34
00:03:39,903 --> 00:03:44,886
اور پھر اگلے سال رسول اللہ ﷺ نےحضرت اسامہ بن زیدؓ کو علَم بردار بنایا

35
00:03:44,910 --> 00:03:50,957
اور آپؐ حضرت اسامہؓ کے لشکر کی روانگی سے قبل رحلت فرما گئے لیکن حضرت ابوبکرؓ نے اس لشکر کو فلفور روانہ کیا

36
00:03:50,993 --> 00:03:56,357
تو، مسلمان شام کے بارے میں کافی سوچ بچار کررہے، کہ یہ انبیاءؑ کی سرزمین ہے۔

37
00:03:56,397 --> 00:04:00,487
مسلمانوں کو اس کا وارث ہونا چاہیے۔

38
00:04:00,522 --> 00:04:04,557
چنانچہ، حضرت شرحبیل بن حسنہؓ ،حضرت ابوبکر صدیقؓ  کے پاس آئے، اور آپؓ اِس متعلق سوچ رہے تھے

39
00:04:04,591 --> 00:04:07,303
دیکھیں، وہاں پہلے ہی کچھ معاملات چل رہے تھے،

40
00:04:07,349 --> 00:04:13,003
حضرت ابوبکر صدیقؓ پہلے ہی حضرت خالد بن سعید بن العاصؓ کو شام میں بھیج چکے تھے

41
00:04:13,040 --> 00:04:17,997
لیکن یہ چھوٹے معرکے تھے، کوئی بڑی مہم نہیں تھی

42
00:04:18,042 --> 00:04:27,703
لیکن اب حضرت ابوبکرصدیقؓ بڑے پیمانے پر سلطنتِ روم کی سرزمین ،شام کو فتح کرنے کا سوچ رہے تھے،

43
00:04:27,739 --> 00:04:31,669
یہ معرکہ صرف فوج کو محدود حملے کی خاطر بھیجنے اور پھر واپس بلانے کا نہیں تھا

44
00:04:31,692 --> 00:04:36,197
چنانچہ، حضرت شرحبیل بن حسنہؓ خلیفہ حضرت ابوبکرؓ کے پاس آتے ہیں اور کہتے ہیں،

45
00:04:36,231 --> 00:04:39,770
کیا آپؓ رومیوں سے جنگ کرنے کا سوچ رہے ہیں؟

46
00:04:39,815 --> 00:04:41,803
 حضرت ابو بکر صدیقؓ نے فرمایا: جی ہاں! آپؓ کو کیسے علم ہوا؟

47
00:04:41,843 --> 00:04:45,610
آپؓ کے سوال کرنے کی ضرور کوئی خاص وجہ ہوگی

48
00:04:45,647 --> 00:04:49,350
 حضرت شرحبیل بن حسنہؓ نے کہا، میں نے ایک خواب دیکھا ہے

49
00:04:49,400 --> 00:04:51,050
کیا خواب تھا؟

50
00:04:51,084 --> 00:04:59,523
حضرت شرحبیل بن حسنہؓ نے بیان کیا کہ میں نے آپؓ کو لوگوں کے درمیان چلتے ہوئے دیکھا،

51
00:04:59,565 --> 00:05:04,990
اور پھر آپؓ انتہائی دشوار گزار راستے سے ایک پہاڑ پر چڑھے

52
00:05:05,025 --> 00:05:09,663
اور آپؓ اس پہاڑ کی چوٹی تک پہنچ گئے

53
00:05:09,705 --> 00:05:19,957
آپؓ اور آپؓ کے ساتھیوں نے اِس اونچے مقام سے اپنے ماتحت لوگوں پر ایک نظر ڈالی

54
00:05:19,994 --> 00:05:28,823
  پھر آپؓ اس چوٹی سے ایک بہت ہی زر خیز میدان میں اترے

55
00:05:28,863 --> 00:05:37,540
ایک میدان جس میں سرسبز درختوں اور پودوں کی بہتات تھی اور وہاں بہت سی بستیاں اور قلعے تھے

56
00:05:37,573 --> 00:05:47,907
 پھر آپؓ نے اپنے ساتھیوں سے فرمایا کہ، اللہ کے دشمنوں سے جنگ کرو، میں آپ کو فتح  اور مالِ غنیمت کی ضمانت دیتا ہوں

57
00:05:47,937 --> 00:05:50,560
اور آپؓ نے مجھے علَم دیا

58
00:05:50,592 --> 00:05:56,109
اور میں بھی اُس لشکر کے ساتھ آگے بڑھا اور ایک بستی میں پہنچا، بستی کے لوگوں نے مجھے امان دی

59
00:05:56,134 --> 00:06:01,477
چنانچہ میں نے اُس بستی کو بہت آسانی سے فتح کیا اور پھر میں آپؓ کے پاس واپس آیا

60
00:06:01,521 --> 00:06:06,997
اور میں نے آپؓ کو ایک بہت بڑے قلعے میں تخت پر بیٹھے پایا

61
00:06:07,032 --> 00:06:14,960
اور پھر آپؓ کو کسی نے پکارا اور فتح کی مبارکباد دی اور اللہ کا شکر ادا کرنے کو کہا

62
00:06:14,990 --> 00:06:18,510
 اور پھر اس آواز نے آپؓ کے سامنے سورت النصر پڑھی

63
00:06:18,543 --> 00:06:20,389
إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ ۝

64
00:06:20,762 --> 00:06:23,698
وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجًا ۝

65
00:06:23,904 --> 00:06:28,603
فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا۝

66
00:06:29,990 --> 00:06:38,237
 تو یہ خواب کا اختتام تھا، اس کے بعد میں بیدار ہوگیا۔

67
00:06:38,274 --> 00:06:42,710
حضرت شرحبیل ؓ جب بات مکمل کر چکے تو انہوں نے دیکھا کہ حضرت ابو بکر صدیقؓ کا چہرہ آنسوؤں سے تر تھا۔

68
00:06:42,743 --> 00:06:55,168
حضرت ابو بکرصدیقؓ نے فرمایا کہ آپؓ نے مجھے فتح کی بھی بشارت دی ہے اور میری موت کی بھی ۔

69
00:06:55,243 --> 00:06:58,473
حضرت ابوبکر صدیقؓ خوابوں کی تعبیر بیان کیا کرتے تھے۔

70
00:06:58,517 --> 00:07:02,349
یہاں تک کہ رسول اللہ ﷺ کی بارگاہ میں بھی،

71
00:07:02,380 --> 00:07:05,583
ایک بار رسول اللہ ﷺ کو ایک خواب سنایا گیا تو حضرت ابوبکر صدیقؓ نے فرمایا۔

72
00:07:05,608 --> 00:07:09,439
اے اللہ کے رسولؐ میں اِس خواب کی توضیح کرنا چاہتا ہوں۔

73
00:07:09,467 --> 00:07:13,183
آپؓ نے حضرت شرحبیلؓ کے سنائے گئے خواب کی تعبیر اِس طرح بیان کی۔

74
00:07:13,225 --> 00:07:17,509
جب آپؓ(حضرت شرحبیلؓ) نے مجھے مشکل اور کچے راستے سے چڑھائی کی طرف جاتے دیکھا۔

75
00:07:17,541 --> 00:07:30,189
اس کا مطلب یہ ہے کہ اِس معرکے میں مجھ پر، میرے سپاہیوں اور ہمارے دشمن پر بہت مشکل وقت آنے والا ہے۔

76
00:07:30,221 --> 00:07:34,216
 یہ معاملہ بہت کھٹن اور دشوار ہونے والا ہے۔

77
00:07:34,253 --> 00:07:38,836
کیونکہ سب سے پہلے آپؓ نے حضرت ابو بکر صدیقؓ کو لوگوں کے درمیان دیکھا، ان میں مسلم و غیر مسلم دونوں تھے۔

78
00:07:38,871 --> 00:07:44,149
اور پھر سیدنا حضرت ابوبکر صدیقؓ کھٹن راستے سے پہاڑ پر چڑھ رہے ہیں۔

79
00:07:44,189 --> 00:07:48,436
تو اس کا مطلب ہے کہ یہ ایک بہت ہی سنگین تنازع ہوگا۔

80
00:07:48,457 --> 00:07:53,544
اور جب آپؓ نے مجھے پہاڑ کی چوٹی پر دیکھا،

81
00:07:53,604 --> 00:08:00,136
اس کا مطلب ہے کہ آخر کار ہم ہی غالب آئیں گے، فتح ہمارا مقدر ہوگی۔

82
00:08:00,176 --> 00:08:04,576
کیونکہ اب حضرت ابوبکر صدیقؓ اپنے ساتھیوں کے ساتھ  پہاڑ کی چوٹی پر ہیں۔

83
00:08:04,612 --> 00:08:11,003
 اور غیر مسلم اب بھی پہاڑ کے دامن میں ہیں۔

84
00:08:11,040 --> 00:08:13,436
اور پھر خواب کا اگلا حصہ کیا تھا؟

85
00:08:13,461 --> 00:08:17,329
 ہم ایک بہت ہی زرخیز وادی اور میدان میں اترے،

86
00:08:17,367 --> 00:08:22,249
سبزہ زاروں اور پھلوں سے بھری وادی میں؛ جہاں بہت سے قصبے اور قلعے بھی موجود تھے۔

87
00:08:22,281 --> 00:08:33,003
حضرت ابوبکر صدیقؓ نے فرمایا، اور اِس کا مطلب یہ ہے کہ اس کے بعد، ہم  آرام دہ اور عیش و عشرت سے بھر پور زندگی گزاریں گے۔

88
00:08:33,066 --> 00:08:37,536
بہت سے غزوات اور فتوحات اور اس مشکل وقت کے بعد،

89
00:08:37,575 --> 00:08:41,843
اللہ عَزَّوَجَلْ ہماری زندگی کو بہت آسان اور پُرتعیش بنائے گا۔

90
00:08:41,890 --> 00:08:48,043
بہت سے قصبے، قلعے اور سرسبز باغات سب مسلمانوں کے قبضے میں ہو نگے،

91
00:08:48,089 --> 00:08:52,043
یعنی، مسلمانوں کا طرز زندگی بدل جائے گا۔

92
00:08:52,068 --> 00:08:56,623
اور جب آپؓ نے مجھے تخت پر بیٹھے دیکھا۔

93
00:08:56,660 --> 00:09:04,656
اِس سے مراد یہ ہے کہ اللہ عَزَّوَجَلْ مجھے عُروج عطا کرے گا اور اللہ کے دشمنوں کو پَست کر دے گا۔

94
00:09:04,699 --> 00:09:09,773
یعنی اللہ عَزَّوَجَلْ مجھے اللہ کے دشمنوں پر غالب کر دے گا۔

95
00:09:09,807 --> 00:09:12,443
وَرَفَعَ أَبَوَيْهِ عَلَى الْعَرْشِ

96
00:09:12,859 --> 00:09:17,116
یہ اس بات کی طرف اشارہ ہے کہ اللہ عَزَّوَجَلْ مجھے بلندی و سرفرازی سے ہَمکنار کرے گا۔

97
00:09:17,149 --> 00:09:22,193
اور پھر جب آپؓ نے غائب سے ایک آواز سنی، جو خوشخبری سنا رہی تھی کہ ہم فتح مند ہو نگے،

98
00:09:22,219 --> 00:09:26,763
اور یہ کہ اللہ عَزَّوَجَلْ کا شکر ادا کریں اور اُس سے بخشش طلب کریں۔

99
00:09:26,812 --> 00:09:32,203
اس کا مطلب ہے کہ میری موت قریب آرہی ہے۔

100
00:09:32,234 --> 00:09:36,359
کیونکہ یہ وہ سورت ہے جو رسول اللہؐ پر آپؐ کے وصال سے پہلے نازل کی گئی ۔

101
00:09:36,390 --> 00:09:38,178
إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ ۝

102
00:09:38,511 --> 00:09:42,065
وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجًا ۝

103
00:09:42,350 --> 00:09:46,374
فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا۝

104
00:09:47,135 --> 00:09:55,176
تو اس کا مطلب ہے کہ میری موت قریب ہے، اور پھر آپؓ اشکبار ہو گئے۔

105
00:09:55,207 --> 00:09:59,129
حضرت ابوبکر صدیقؓ نے فرمایا؛

106
00:09:59,159 --> 00:10:05,426
اللہ کے حکم سے، میں امر بالمعروف ونہی عن المنکر کروں گا

107
00:10:05,470 --> 00:10:13,936
اور میں اس روئے زمین کے مشرق و مغرب تک، اللہ کے دشمنوں کے خلاف، فوج کو منظم اور متحرک کروں گا۔

108
00:10:13,975 --> 00:10:21,963
یہاں تک کہ دشمنانِ دین یہ کہہ دیں کہ اللہ ایک ہے جس کا کوئی شریک نہیں یا جب تک وہ مجھے جزیہ ادا نہ کر دیں، اور انہیں میں زیر نہ کر لوں

109
00:10:22,004 --> 00:10:25,656
یہ اللہ کا حکم ہے اور یہی رسول اللہ ﷺ کی سنت ہے۔

110
00:10:25,715 --> 00:10:32,459
پس جب اللہ تعالیٰ میری روح قبض کرے گا تو وہ مجھے(اللہ کے دشمنوں پر) کمزور اور عاجز نہیں پائے گا۔

111
00:10:32,496 --> 00:10:40,113
بلکہ اللہ مجھے مجاہدین کے انعام و اکرام کی فکر میں پائے گا۔

112
00:10:40,150 --> 00:10:47,319
چنانچہ حضرت ابوبکر صدیقؓ نے پختہ ارادہ کر لیا۔

113
00:10:47,369 --> 00:10:51,236
کہ آپؓ روم کے غزوات کا سلسلہ شروع کرنے والے ہیں

114
00:10:51,268 --> 00:10:56,899
چنانچہ آپؓ نے صحابہ کرامؓ کی ایک مجلسِ شوریٰ کا اجلاس طلب کیا،

115
00:10:56,920 --> 00:11:01,316
تاکہ آپؓ اس اہم ترین مہم کے لیے صحابہ کرامؓ کے ساتھ مشاورت کر سکیں۔

116
00:11:01,365 --> 00:11:05,605
حضرت ابوبکر صدیقؓ نے جن صائب الرائے اشخاص کو طلب فرمایا ان میں حضرت عمر بن خطابؓ،

117
00:11:05,625 --> 00:11:12,356
حضرت عثمان بن عفانؓ، حضرت علی بن ابی طالبؓ،حضرت عبدالرحمن بن عوفؓ حضرت سعد بن ابی وقاصؓ

118
00:11:12,386 --> 00:11:22,103
حضرت طلحہ بن عبید اللہؓ حضرت زبیر بن عوامؓ اور مہاجرین وانصار کے نامور رہنماء شامل تھے۔،

119
00:11:22,138 --> 00:11:28,759
اس مجلس میں حضرت ابوبکر صدیقؓ اللہ کی حمد و ثنا کے بعد فرماتے ہیں کہ

120
00:11:28,793 --> 00:11:36,709
میں سلطنتِ روم سے جہاد کرنے اور شام کو فتح  کرنے کا ارداہ کر رہا ہوں۔

121
00:11:36,752 --> 00:11:41,516
تاکہ اگر کوئی مرے تو شہادت کی موت مرے

122
00:11:41,550 --> 00:11:49,443
اور اگر کوئی زندہ رہے تو ایک عظیم فتح  کے ساتھ مالِ غنیمت کا بھی حقدار ہو

123
00:11:49,490 --> 00:11:50,766
لہذا اِس معاملے میں آپ حضرات کی کیا رائے ہے؟

124
00:11:50,792 --> 00:11:54,229
اب آپؓ صحابہ کرامؓ اور انصار و مہاجرین کی رائے معلوم کرنا چاہتے ہیں۔

125
00:11:54,263 --> 00:11:58,029
فَليُشِّرَ عَلَيَّ كُلُّ امْراٍ بمَبلَغ رَائِ

126
00:11:58,089 --> 00:12:00,076
مجھے اپنی اپنی رائے دیں

127
00:12:00,109 --> 00:12:03,816
 حضرت عمر بن خطابؓ نے سب سے پہلے رائے دی۔

128
00:12:03,859 --> 00:12:09,753
حضرت عمر بن خطابؓ نے سب سے پہلے اللہ تعالیٰ کی مدح و ثنا بیان کی ،اور پھر یوں گویا ہوئے؛

129
00:12:09,778 --> 00:12:18,043
 حضرت عمرؓ نے فرمایا؛ اللہ عَزَّوَجَلْ اپنی نعمت جسے چاہتا ہے اُسے عطا کرتا ہے۔

130
00:12:18,083 --> 00:12:23,963
میں اِس مہم کے بارے میں پہلے سے سوچ رہا تھا اور میں اِس خیال کو آپؓ کے سامنے پیش کرنا چاہتا تھا۔

131
00:12:23,998 --> 00:12:27,003
لیکن آپؓ نے مجھ سے پہلے اِس خواہش کا اظہار کردیا۔

132
00:12:27,039 --> 00:12:31,923
کیونکہ اچھائی کے ہر معاملے میں ہمیشہ  آپؓ مجھ پر سبقت لے جاتے ہیں۔

133
00:12:31,965 --> 00:12:36,203
اور یہ اللہ کا فضل ہے کہ وہ جسے چاہتا ہے نواز دیتا ہے۔

134
00:12:36,235 --> 00:12:39,289
حضرت عمر بن خطابؓ نے فرمایا: میں بھی اِسی حوالے سے سوچ رہا تھا۔

135
00:12:39,321 --> 00:12:47,166
تو یہ اس امر کی تصدیق ہے کہ صحابہ کرامؓ، شام کے مسئلے پر سنجیدگی سے غو رو فکر کر رہے تھے

136
00:12:47,190 --> 00:12:51,663
اِس محاذ کو کیسے سَر  کیا جائے، یہ بات ان کے ذہنوں پر حاوی ہو چکی تھی۔

137
00:12:51,694 --> 00:12:55,033
تو، حضرت عمر بن خطابؓ نے فرمایا: میں اِس معاملے پر سوچ بچار کر رہا تھا۔

138
00:12:55,068 --> 00:13:00,406
اور میں کسی نیک کام میں آپؓ پہ سبقت نہیں لے جا سکا اور اس بار بھی ، اللہ تعالٰی نے آپؓ کو مجھ پہ امتیاز بخشا

139
00:13:00,444 --> 00:13:08,089
حضرت عمرؓ نے فرمایا: میری رائے یہ ہے کہ  آپؓ سرزمین شام  کی طرف مجاہدین کے لشکر یکے بعد دیگرے روانہ کریں

140
00:13:08,125 --> 00:13:10,136
حضرت عمرؓ کے صحیح الفاظ یہ ہیں کہ،

141
00:13:10,172 --> 00:13:18,316
سَرِّبْ اِلَيْهِمْ بالْخيل في إثر الخيل وبعث الرجال تتبعو الرجال والجنود تتلوه الجنود

142
00:13:18,362 --> 00:13:26,556
گھڑسواروں اور پیادہ دستوں کے بعد گھڑسواروں اور پیادہ دستوں کو بھیجیں، اور لشکر لشکروں کے پیچھے روانہ کریں

143
00:13:26,589 --> 00:13:28,756
حضرت عمر بن الخطابؓ کی اِس بات سے کی مراد یہ تھی کہ ،

144
00:13:28,812 --> 00:13:37,016
کہ حضرت ابو بکر صدیقؓ مجاہدین کو چھوٹے گروہوں میں تقسیم کر کے الگ الگ ، آگے پیچھے روانہ کریں۔

145
00:13:37,060 --> 00:13:44,126
اور یہ لشکر مختلف سمتوں سے حملہ کرتے ہوئے سرزمینِ روم میں داخل ہوجائیں۔

146
00:13:44,179 --> 00:13:48,539
یہ حضرت عمر بن الخطابؓ  کی رائے تھی۔

147
00:13:48,569 --> 00:13:53,566
فان الله عزوجل ناصرٌ الدین ومعز الإسلام واهل

148
00:13:53,624 --> 00:13:57,716
اللہ تبارک وتعالٰی اپنے دین کو فتح دے گا اور اسلام کو قدر و منزلت عطا کرے گا۔

149
00:13:57,759 --> 00:14:00,216
تو یہ حضرت عمر بن الخطابؓ کا قول تھا۔

150
00:14:00,250 --> 00:14:03,909
پھر ،حضرت عبدالرحمن بن عوفؓ کھڑے ہوئے اور فرمایا۔

151
00:14:03,947 --> 00:14:07,983
میں حضرت عمر بن خطابؓ کی بات سے متفق نہیں ہوں۔

152
00:14:08,010 --> 00:14:11,056
یہ سرزمینِ روم و بنو أصفر ہے،

153
00:14:11,081 --> 00:14:14,896
اہلِ عرب ، سفید فام  یورپیوں کو بنو اصفر کہتے تھے۔

154
00:14:14,932 --> 00:14:19,606
وہ رومیوں کو سفید فام یورپین نہیں بلکہ، بنوأصفر کہتے تھے، یعنی زرد چہروں والے۔

155
00:14:19,655 --> 00:14:23,259
  اہل روم، اصفرِ(زرد) نسل کی اولاد میں سے ہیں۔

156
00:14:23,296 --> 00:14:25,526
حدٌ حديد ورُكنٌ الشديد

157
00:14:26,067 --> 00:14:29,336
اُنہیں مضبوط پُشت پناہی حاصل ہے۔

158
00:14:29,367 --> 00:14:30,836
حضرت عبد الرحمٰن بن عوفؓ نے فرمایا۔

159
00:14:30,861 --> 00:14:35,729
یہ مہم کوئی معمولی مہم نہیں ، جسے ہلکے میں لیا جائے کیونکہ ہمارا سامنا عالمی طاقت روم سے ہونے جا رہا ہے ۔

160
00:14:35,764 --> 00:14:42,949
اور روم  کے پاس بہترین حکمتِ عملی اور وسیع اراضی ہے۔

161
00:14:42,978 --> 00:14:45,979
اور اگر ہم سرزمینِ روم میں داخل ہوتے ہیں،

162
00:14:46,010 --> 00:14:52,683
تو روم کے پیچھے اِس کے دَست پروردہ لوگوں کا ایک وسیع سمندر ہوگا، جو اس جنگ میں ہمارے خلاف اِن کا ساتھ دے گا۔

163
00:14:52,699 --> 00:14:56,523
اور یہ رومیوں کا ایک خاص وصف ہے۔

164
00:14:56,575 --> 00:15:06,063
رومی ایک وسیع و عریض خطے پر قابض تھے، جِس میں یورپ سمیت دیگر براعظموں شمالی افریقہ، مصر اور شام پر حکومت کر رہے تھے،

165
00:15:06,109 --> 00:15:09,389
تو ،حضرت عبدالرحمن بن عوفؓ، خلیفہ حضرت ابو بکر صدیقؓ سے مخاطب تھے کہ

166
00:15:09,429 --> 00:15:12,376
یہ کوئی عام دشمن نہیں ہے، ہمارا سامنا ایک بڑی طاقت سے ہے۔

167
00:15:12,414 --> 00:15:18,229
اس مسئلے کا سامنا کرنے کے لئے میرا نقطہ نظر یہ ہے کہ

168
00:15:18,257 --> 00:15:22,743
والله ما أرى أن تقحم الخيل عليهم إقحامًا، ولكن تبعث الخيل،

169
00:15:22,817 --> 00:15:27,728
فتغير في أداني أرضهم، ثم تبعثها فتغير، ثم ترجع إليك

170
00:15:28,071 --> 00:15:32,337
فإذا فعلوا ذلك مرارًا أضروا بعدوهم، وغنموا من أداني أرضهم،

171
00:15:32,530 --> 00:15:34,210
فقووا بذلك على قتالهم

172
00:15:34,337 --> 00:15:43,289
میرا خیال ہے کہ آپؓ روم کی سرزمین پر چھاپہ مار کاروائی کے لیے گھڑ سواروں کے دستے بھیجیں۔

173
00:15:43,322 --> 00:15:48,189
اور آپؓ رومی سلطنت کے دور دراز، علاقوں میں خفیہ حملے کے لئے لشکر روانہ کریں۔

174
00:15:48,229 --> 00:15:54,466
لہٰذا آپؓ روایتی طریقے سے فوجیں بھیجنے کے بجائے، چھاپہ مار حملے کریں

175
00:15:54,506 --> 00:16:01,139
چھوٹے لشکر جو خفیہ حملہ کرنے کے بعد مالِ غنیمت لے کر واپس آجائیں

176
00:16:01,162 --> 00:16:02,929
 حضرت عبد الرحمٰن بن عوفؓ کی رائے میں دو باتیں قابلِ غور تھیں

177
00:16:02,969 --> 00:16:06,115
سب سے پہلے، آپؓ اِن حملوں کے ذریعے آپ رومیوں کو کمزور کریں گے

178
00:16:06,145 --> 00:16:08,932
 وہ آپ کی اِس حکمتِ عملی کی وجہ سے مستقل دفاعی حالت میں رہیں گے

179
00:16:08,957 --> 00:16:13,653
اور آپؓ لگاتار دشمن کو نشانہ بناتے رہیں تاکہ وہ بدحواس ہو جائیں اور اسلامی لشکر پر واپس حملہ نہ کرسکیں۔

180
00:16:13,696 --> 00:16:17,922
 اور پھر حضرت عبدالرحمن بن عوفؓ نے جو کہا ، آپ دیکھ سکتے ہیں۔

181
00:16:17,962 --> 00:16:24,116
حضرت عبدالرحمٰن بن عوفؓ کاروباری ذہن سے اس جنگ کو دیکھ رہے تھے۔

182
00:16:24,141 --> 00:16:27,516
یعنی عبدالرحمن ابن عوف ایک تاجر تھے۔

183
00:16:27,566 --> 00:16:31,046
اس لیے آپؓ سوچ رہے تھے کہ اس عظیم مہم کی مالی اعانت کیسے کی جائے۔

184
00:16:31,089 --> 00:16:37,172
حضرت عبد الرحمٰنؓ کہ رہے تھے کہ ان چھاپوں سے نہ صرف رومی سلطنت کمزور ہوگی اور وہ ہمیشہ دفاعی حالت میں رہے گی

185
00:16:37,214 --> 00:16:39,926
اور اس مالِ غنیمت سے ہم اس جنگ کا اقتصادی بوجھ اُٹھا سکیں گے

186
00:16:39,950 --> 00:16:44,936
 اس طرح خلافتِ خزانہ کو اِس جنگ کا بوجھ نہیں سہنا پڑے گا۔

187
00:16:44,973 --> 00:16:49,856
لہٰذا اس جنگ کے مالی اخراجات ریاستِ مدینہ کے بجائے اُسی مالِ غنیمت سے وصول کیئے جائیں

188
00:16:49,894 --> 00:16:55,296
اور پھر جب آپؓ مطمئن ہوجائیں کہ اب وقت آچکا ہے، کہ شام کو ایک بڑے حملے میں زیر کر لیا جائے

189
00:16:55,329 --> 00:17:09,429
پھر میں آپؓ کو تجویز کروں گا کہ آپؓ قاصد بھیجیں، کہ یمن کے کونے کونے سے مجاہدین کو بھرتی کریں اور اہل ربیعہ اور اہل مضر سے بھی

190
00:17:09,458 --> 00:17:14,629
اور پھر آپؓ خود فوج کی قیادت کریں یا اپنی جگہ کسی اور کو فوج کا سپہ سالار مقرر کریں

191
00:17:14,667 --> 00:17:17,016
اور ان شاء اللہ ! اللہ آپؓ کو فتح سے ہمکنار کرے گا

192
00:17:17,059 --> 00:17:22,482
حضرت عمر ابن الخطابؓ کی رائے میں اُنؓ کی شخصیت کا(دلیرانہ) عکس دیکھ سکتے ہیں،

193
00:17:22,537 --> 00:17:25,109
حضرت عمر ابن الخطابؓ ایک مکمل حملہ چاہتے تھے،

194
00:17:25,162 --> 00:17:30,442
مجاہدین کے لشکر بھیج کر رومیوں سے ہر اطراف سے لڑیں، یہاں تک کہ سرزمینِ شام پر قبضہ کر لیں

195
00:17:30,476 --> 00:17:34,602
جبکہ حضرت عبدالرحمن ابن عوفؓ چاہتے تھے کہ پہلے حالات کا جائزہ لیا جائے

196
00:17:34,640 --> 00:17:39,682
 چھوٹے لشکروں سے رومیوں پر چھاپہ ماریں، مالِ غنیمت حاصل کریں

197
00:17:39,731 --> 00:17:44,736
جب آپؓ محسوس کریں کہ اب ہم بڑی جنگ کے لیے تیار ہیں اور حالات کا بغور جائزہ لیا جا چکا ہے

198
00:17:44,786 --> 00:17:49,266
پھر آپؓ ایک بھاری فوج  ترتیب دیں جو اِس مہم کو پایائے تکمیل تک پہنچا سکے

199
00:17:49,290 --> 00:17:53,872
حضرت عبدالرحمٰن بن عوفؓ چاہتے ہیں کہ خیلفئہ رسولؐ پہلے تھوڑی سی سرمایہ کاری کریں

200
00:17:53,899 --> 00:18:02,042
 اگر یہ ایک منافع بخش کاروبار ہے، تو اس میں اپنا مال لگائیں، لیکن اس میں ایک دم نہ کُودیں

201
00:18:02,067 --> 00:18:06,179
پھر حضرت عثمان بن عفانؓ نے اپنی رائے دی، آپؓ نے بیان کیا؛

202
00:18:06,204 --> 00:18:10,526
اے اللہ کے رسولؐ کے خلیفہ

203
00:18:10,550 --> 00:18:20,376
آپؓ کی رائے مبارک ہے لہذا جو بھی اقدام آپؓ کو مناسب لگے، اُس کے ساتھ  آگے بڑھیں، اور ہم آپؓ کی پیروی کریں گے۔

204
00:18:20,411 --> 00:18:23,256
حضرت عثمان بن عفانؓ فرما رہے ہیں کہ ہمیں خلیفہ رسولؐ کی رائے پر مکمل اعتماد ہے۔

205
00:18:23,289 --> 00:18:29,202
ہمیں آپؓ کے نظریے اور حکمت پر بھروسہ ہے، آپؓ فیصلہ کریں، اور ہم آپؓ کی اطاعت  کریں گے۔

206
00:18:29,227 --> 00:18:32,616
حضرت طلحہؓ ،حضرت زبیرؓ اور دیگر صحابہ کرامؓ نے بھی یہی فرمایا۔

207
00:18:32,652 --> 00:18:36,189
اِس دوران حضرت علی ابن ابی طالبؓ خاموش تھے۔

208
00:18:36,222 --> 00:18:40,246
تو حضرت ابوبکرؓ نے دریافت کیا؛ ہم نے ابھی تک آپؓ کی رائے نہیں جانی، آپؓ کیوں خاموش ہیں؟

209
00:18:40,266 --> 00:18:43,269
حضرت علی ابن ابی طالبؓ نے فرمایا؛

210
00:18:43,294 --> 00:18:51,629
میں سمجھتا ہوں کہ آپؓ ایک بابرکت انسان ہیں اور آپؓ کا وجود حقیقی سطح پر نیک شگون ہے۔

211
00:18:51,654 --> 00:18:57,579
اور اگر آپؓ خود فوج کی قیادت کرتے ہیں یا اپنی جگہ کسی اور اِس عہدے کے لئے منتخب کرتے ہیں

212
00:18:57,618 --> 00:19:00,306
تو آپؓ ہی فتح یاب ہوں گے۔

213
00:19:00,344 --> 00:19:04,011
حضرت ابوبکر صدیقؓ نے فرمایا: آپؓ کے الفاظ خوش آئیند ہیں۔

214
00:19:04,036 --> 00:19:05,197
لیکن آپؓ کیسے جانتے ہیں؟

215
00:19:05,228 --> 00:19:08,789
آپؓ نے یہ اندازہ کیسے لگایا ،کہ مجھے فتح حاصل ہو گی۔؟

216
00:19:08,826 --> 00:19:12,609
حضرت علی ابن ابی طالب نے فرمایا؛ میں نے رسول اللہؐ کو یہ فرماتے ہوئے سنا ہے۔

217
00:19:12,654 --> 00:19:20,802
لا يزال الدين ظاهرًا على كل من ناوأه، حتى يقوم الدين وأهله ظاهرين

218
00:19:20,846 --> 00:19:27,259
میں نے رسول اللہؐ سے سنا ہے کہ دینِ اسلام تمام دشمنوں پر غالب آ کر رہے گا۔

219
00:19:27,276 --> 00:19:33,612
یہاں تک یہ دین مستحکم نہ ہو جائے اور مسلمان، غالب نہ آ جائیں

220
00:19:33,655 --> 00:19:37,196
یہ رسول اللہؐ کا وعدہ ہے اور یہ ہو کر رہے گا۔

221
00:19:37,233 --> 00:19:40,436
اور یہی وہ مثبت پہلو ہے جو صحابہ کرامؓ میں موجود تھا۔

222
00:19:40,470 --> 00:19:44,882
جنگ سے پہلے ہی نتیجہ اخذ کیا جا چکا ہے کہ ہم فاتح ہیں

223
00:19:44,907 --> 00:19:46,862
اِس بات سے کوئی فرق نہیں پڑتا کہ حضرت ابوبکرؓ خود قیادت کریں

224
00:19:46,876 --> 00:19:49,076
یا آپؓ اپنی جگہ کسی اور کو قیادت سونپیں،

225
00:19:49,106 --> 00:19:53,832
 آپؓ جو قدم اٹھائیں گے، اللہ تبارک و تعالٰی ہمیں فتح عطا فرمائے گا۔

226
00:19:53,862 --> 00:20:00,449
حضرت ابوبکر صدیقؓ یہ الفاظ  سن کر بہت خوش ہوئے اور آپؓ نے فیصلہ کر لیا۔

227
00:20:00,467 --> 00:20:05,787
اس فیصلے میں دونوں آراء شامل تھیں، حضرت عمر بن خطابؓ کی رائے، اور حضرت عبدالرحمن بن عوفؓ  کی رائے بھی شامل تھی

228
00:20:05,826 --> 00:20:09,029
حضرت ابوبکرؓ  نے کیا طریقہ اپنایا۔؟

229
00:20:09,076 --> 00:20:15,722
آپؓ نے چار لشکر بھیجے اور یہ حضرت عمرؓ کی رائے کا حصہ ہے جو انہوں نے اختیار کیا

230
00:20:15,756 --> 00:20:19,639
اور پھر حضرت عبدالرحمنؓ کی نصیحت کے دوسرے حصے پر عمل کیا

231
00:20:19,659 --> 00:20:25,402
کہ آپؓ ہر کونے سے لوگوں کو جہاد کے لیے اکٹھا کریں اور انہیں اِس جنگ میں لڑنے کے لیے آگے لائیں۔

232
00:20:25,440 --> 00:20:31,509
آپؓ دور دراز علاقوں میں مقیم قبائل کو جہاد میں شرکت کے لیے مدعو کر رہے تھے

233
00:20:31,546 --> 00:20:35,421
اس کا مطلب ہے کہ یہ صحابہ کی جانب سے ایک اضافی کوشش تھی۔

234
00:20:35,446 --> 00:20:44,916
کیونکہ قبیلہِ ربیعہ کے مجاہدوں کو عراق سے، اور یمن کے جوانوں کو یمن سے لانا، اور پھر اُن سب کو شام کے محاذ پر روانہ کرنا، یہ ایک اضافی کوشش تھی

235
00:20:44,952 --> 00:20:51,206
لیکن چونکہ یہ اُس وقت کی عالمی طاقت کے ساتھ تصادم تھا،

236
00:20:51,251 --> 00:20:56,816
اور یہ ایک ایسا مقابلہ تھا جس کا مقصد ارضِ مقدس کو رومیوں کے اقتدار سے چھڑانا تھا، جس سرزمین سے وہ جذباتی طور پر وابستہ تھے

237
00:20:56,866 --> 00:21:02,972
یہ کوئی آسان معاملہ نہیں تھا اور اس لیے مجاہدینِ اسلام کو بھرتی کرنے کے لیے کچھ خاص کوشش کی ضرورت تھی۔

238
00:21:03,003 --> 00:21:08,769
چنانچہ ابوبکر صدیقؓ  نے انس بن مالکؓ  کو ایک خط کے ساتھ یمن بھیجا۔

239
00:21:08,794 --> 00:21:11,059
اس خط میں بیان کیا گیا کہ،

240
00:21:11,084 --> 00:21:14,629
اللہ کے نام سے جو بڑا مہربان نہایت رحم والا ہے

241
00:21:14,668 --> 00:21:20,142
رسول اللہؓ کے جانشین کی طرف سے، ہر اس شخص کی جانب جو اس پیغام کو سن سکے

242
00:21:20,167 --> 00:21:23,809
 اہل یمن کے مومنین کے لیے۔

243
00:21:23,834 --> 00:21:26,026
اسلامُ عليكم

244
00:21:26,051 --> 00:21:28,711
اللہ تعالیٰ نے مومنوں پر جہاد کا حکم نازل فرمایا ہے۔

245
00:21:28,736 --> 00:21:32,422
اور انہیں جہاد کے لیئے نکلنے کا حکم صادر فرمایا ہے چاہے وہ مالی، جسمانی اعتبار سے ہلکے ہوں یا بھاری

246
00:21:32,453 --> 00:21:38,822
اللہ سبحانہ وتعالی نے فرمایا کہ اللہ کی راہ میں اپنے مال اور اپنی جانوں سے لڑو۔

247
00:21:38,852 --> 00:21:43,496
جہاد اللہ کا حکم ہے اور اللہ کی طرف سے اِس کا اجرِ عظیم ہے۔

248
00:21:43,521 --> 00:21:48,129
ہم نے اپنے علاقے کے مسلمانوں کو شام میں رومیوں کے خلاف جہاد کے لیے جمع کیا ہے۔

249
00:21:48,154 --> 00:21:50,316
 اور وہ رومی لشکر سے لڑنے کے لیئے بے تاب ہیں

250
00:21:50,341 --> 00:21:52,687
مجاہدین کے لشکر نکل چکے ہیں،

251
00:21:52,714 --> 00:21:56,609
 اس لیئے بلا تاخیر، جنگ کے لئے کوچ کریں جیسا کہ آپؓ کے بھائیوں نے کیا۔

252
00:21:56,634 --> 00:22:02,549
تو پھر آپ کو دو بہترین انعامات میں سے ایک انعام عطا کیا جائے گا، یا تو شہادت، یا فتح کے ساتھ مالِ غنیمت۔

253
00:22:02,574 --> 00:22:05,889
اللہ تعالیٰ بغیر عمل کے صرف باتوں سے خوش نہیں ہوتا۔

254
00:22:05,914 --> 00:22:12,872
لہٰذا جہاد اس وقت تک جاری رہے گا جب تک کہ کفار دین حق پر عمل نہ کریں اور اللہ کی کتاب کی حکمرانی کو تسلیم نہ کر لیں۔

255
00:22:12,897 --> 00:22:17,482
اللہ آپ کے دین کی حفاظت فرمائے، آپ کے دلوں کو ہدایت دے، آپ کے اعمال کو پاک کرے،

256
00:22:17,507 --> 00:22:20,862
اور آپ کو مجاہدین کا مختص اجر عطا فرمائے۔

257
00:22:20,887 --> 00:22:27,646
اس خط میں حضرت ابو بکر صدیقؓ لوگوں کو جہاد فی سبیلِ اللہ کے مقاصد بتا رہے ہیں۔

258
00:22:27,669 --> 00:22:28,922
جو کہ دو ہیں۔

259
00:22:28,947 --> 00:22:31,142
نمبر ایک،

260
00:22:31,167 --> 00:22:37,509
کہ جہاد بلا شک و شبہ یہ عبادت کا حصہ ہے ۔

261
00:22:37,534 --> 00:22:42,002
آپؓ نے فرمایا کہ اللہ عَزَّوَجَلْ قول کو فعل کے بغیر قبول نہیں کرتا۔

262
00:22:42,027 --> 00:22:48,702
اس لیئے آپ کی زبان سے نکلے ہوئے الفاظ کی صداقت، کا عملی اظہار جہاد فی سبیل اللہ ہے

263
00:22:48,727 --> 00:22:53,789
دوسرا مقصد یہ ہے کہ لوگ یا تو مسلمان ہو جائیں یا جزیہ دیں۔

264
00:22:53,814 --> 00:22:55,556
اور کفار، ہر صورت اللہ کی کتاب کا حکم قبول کریں

265
00:22:55,557 --> 00:23:00,052
 کیونکہ جزیہ دینے سے، وہ قرآن میں اللہ عَزَّوَجَلْ کے حکم کو قبول کر لیں گے

266
00:23:00,087 --> 00:23:03,162
کیونکہ جزیہ قرآنی حکم ہے۔

267
00:23:03,187 --> 00:23:07,326
پس، جہاد فِی سبیل اللہ کے یہ دو مقاصد ہیں۔

268
00:23:07,351 --> 00:23:11,939
حضرت انس بن مالکؓ ہر قبیلے میں جاتے اور لوگوں کو یہ مراسلہ پڑھ کر سناتے

269
00:23:11,964 --> 00:23:16,771
حضرت انس بن مالکؓ واپس آئے، اور حضرت ابوبکر صدیقؓ کی خدمت میں حاضر ہوئے، آپؓ کو خوشخبری سنائی،یوں گویا ہوئے

270
00:23:16,796 --> 00:23:19,499
أبشر قد عطوك شعثًا غبرا

271
00:23:19,524 --> 00:23:22,619
ابطال اليمن وشجعانها وفرسانها

272
00:23:22,725 --> 00:23:27,059
وقد سارو الیك بضرار والحرم والأموال

273
00:23:27,678 --> 00:23:32,265
 فرمایا: خوش ہو جائیں! خاک اڑاتے گردو غبار میں اٹے

274
00:23:32,290 --> 00:23:42,189
یمن کے سردار، اُن کے بہادر مرد اور مسلح فرسان، وہ اپنی عورتوں، بچوں اور جمع پونجی کو لئے آپؓ کے پاس تشریف لا رہے ہیں

275
00:23:42,214 --> 00:23:46,956
تو یہ ایک ایسا معرکہ تھا جو اُن سے مطالبہ کررہا تھا کہ وہ اپنے علاقے سے ہجرت کریں۔

276
00:23:46,981 --> 00:23:54,869
کیونکہ طویل مسافت کی وجہ سے انہیں اپنی سرزمین سے، اپنے مال اور اہل وعیال سمیت جہاد فِی سبیل اللّٰہ کے لئے نکلنا پڑا۔

277
00:23:54,894 --> 00:24:02,306
پس قربانی کا یہ وہ عظیم درجہ ہے جس کا اُن دنوں مطالبہ کیا گیا

278
00:24:02,331 --> 00:24:07,989
قبائلِ یمن میں سے ایک سردار، جس کا نام ذوالکلاع الحمیری تھا

279
00:24:08,014 --> 00:24:19,189
اُنہوں نے حکم کی فوری تعمیل کی اور حضرت انس بن مالکؓ کے پہنچنے کے پانچ دن بعد تقریباً چند سو پیروکاروں کے ساتھ مدینہ منورہ تشریف لائے،

280
00:24:19,239 --> 00:24:31,406
وہ سر پر سونے کا تاج سجائے جس میں ہیروجوہرات کی چمک تھی اور نہایت قیمتی کامدار پوشاک زیب تن کیے مدینہ میں داخل ہوئے

281
00:24:31,455 --> 00:24:33,056
وہ اپنے علاقے کے سلطان تھے،

282
00:24:33,086 --> 00:24:45,882
جب وہ مدینہ پہنچے تو انہوں نے خلیفہ حضرت ابوبکر صدیقؓ کو دیکھا کہ آپؓ انتہائی معمولی اور سستے لباس میں زیب تن ہیں

283
00:24:45,907 --> 00:24:52,382
بغیر کسی محافظ کے، ایک کچے مکان میں مقیم ہیں

284
00:24:52,407 --> 00:24:57,496
خلیفۃ المسلمینؓ کے اِس سادہ طرز نے ذولکلاع الحمیری کو بہت متاثر کیا

285
00:24:57,539 --> 00:25:03,776
انہوں نے اپنی قیمتی پوشاک اتاری اور مدینہ کے بازار میں چلے گئے۔

286
00:25:03,801 --> 00:25:11,989
وہاں آپ کو جو کپڑا ملا وہ معمولی اور سستا، اُنہوں نے اِس لباس کا انتخاب کیا اور اسے پہن لیا۔۔

287
00:25:12,014 --> 00:25:16,786
ذولکلاع کے ساتھیوں نے کہا  کہ آپ ہمیں مہاجرین اور انصار کے سامنے شرمندہ کریں گے۔

288
00:25:16,811 --> 00:25:24,482
 ذولکلاع نے کہا کہ اب ہم نے اپنا دستور چھوڑ دیا ہے، اور اب ہم بھی زہد اور سادگی کی راہ پر چلیں گے۔۔

289
00:25:24,507 --> 00:25:30,382
جب لوگ اپنے سامنے مثالی شخصیت کو دیکھتے ہیں تو وہ الفاظ سے زیادہ کردار سے متاثر ہوتے ہیں۔

290
00:25:30,407 --> 00:25:38,629
اگر آپ ذوالکلاع الحمیری کو زہد کے متعلق درس دیں، تو ان الفاظ کا اُس پر اتنا اثر نہیں نہیں پڑے گا

291
00:25:38,654 --> 00:25:42,582
جتنا اثر انہیں خلیفہ حضرت ابوبکر صدیقؓ کے طرزِ زندگی کو دیکھ کر ہوا۔

292
00:25:42,607 --> 00:25:48,629
نیز لوگ عام طور پر اُس شخص کی پیروی کرتے ہیں، جو اقتدار میں ہو، اور یا جو قوم طاقتور ہو۔

293
00:25:48,654 --> 00:25:53,776
 لوگ عموماً طاقتور قوموں کی مشہور شخصیات کی پیروی کرتے ہیں،

294
00:25:53,801 --> 00:25:57,532
اُن کا ہر عمل لوگوں کی زندگی کا حصہ بن جاتا ہے۔

295
00:25:57,557 --> 00:26:04,376
 لوگ اُن کے گانے سنتے ہیں، ان کی فلمیں دیکھتے ہیں، ان جیسا ہی لباس پہنتے ہیں،

296
00:26:04,401 --> 00:26:09,349
اور یہ وہ چلن ہے جسے ابن خلدون نے کہا ہے کہ یہ انسانی خصلت ہے۔

297
00:26:09,374 --> 00:26:14,239
کمزور طاقتور کی پیروی کرتا ہے۔

298
00:26:14,264 --> 00:26:19,496
ذوالکلاع الحمیری جو کہ بادشاہ ہیں، لیکن اب وہ خلافت کے ماتحت ہیں۔

299
00:26:19,521 --> 00:26:27,336
جب اُنہوں نے دیکھا کہ خلیفہؓ کو انتہائی معمولی اور سستا لباس پہننے میں کوئی اعتراض نہیں

300
00:26:27,361 --> 00:26:33,006
تو وہ اپنے جسم پر موجود شاندار اور قیمتی لباس کو تبدیل کرنے کے لئے تیار ہوگئے،

301
00:26:33,031 --> 00:26:39,036
کیونکہ اب ذوالکلاع الحمیری کا رول ماڈل حضرت ابوبکر صدیقؓ تھے۔

302
00:26:39,061 --> 00:26:42,834
چنانچہ صحابہ کرامؓ اپنے پیشواؤں کے لیئے نئے معیار قائم کر رہے تھے۔

303
00:26:42,859 --> 00:26:46,176
اور وہ لوگوں کے لئے نئی مثال پیش کر رہے تھے۔

304
00:26:46,201 --> 00:26:51,949
لہذا جب صحابہ کرامؓ اُن سے بات کیئے بغیر باعزت فاتح بن کر اُن کے علاقوں میں جاتے

305
00:26:51,974 --> 00:26:56,539
دیکھیں صحابہ کرامؓ  التجائیہ طریقے سے دعوت دینے نہیں گئے۔

306
00:26:56,568 --> 00:27:01,818
انہوںؓ نے لوگوں کو منت سماجت کر کے، اپنے دین پر سمجھوتہ کر کے اسلام کی دعوت نہیں دی۔

307
00:27:01,848 --> 00:27:07,556
وہ عزت و جلال اور لشکروں کے ساتھ داخل ہوئے اور لوگوں کی زمینوں کو فتح کر لیا۔

308
00:27:07,581 --> 00:27:11,436
اور پھر صحابہ کرامؓ مساجد میں قیام پزیر ہوئے اور لوگ دین سیکھنے کے لیے جوق درجوق اُنؓ کے پاس آئے۔

309
00:27:11,461 --> 00:27:16,149
کیونکہ لوگ صحابہ کرامؓ کو بطور رول ماڈل کے دیکھتے اور اُنؓ کی پیروی کرتے۔

310
00:27:16,174 --> 00:27:22,149
تو وعظ و نصیحت کے بغیر لوگ، صحابہ کرامؓ  کے طَورواَطوار اپنا لیتے ۔

311
00:27:22,174 --> 00:27:27,456
اور تھوڑی سی کوشش سے تمام قبائل دائرہ اسلام میں داخل جاتے۔

312
00:27:27,481 --> 00:27:37,829
چنانچہ صحابہ کرامؓ کی دعوت کا یہ طریقہ، ایک ایسا طریقہ تھا جہاں وہ اسلام کو نہایت ہی باوقار انداز میں پیش کرتے تھے۔

313
00:27:37,859 --> 00:27:46,096
تو، اب خلیفہ حضرت ابوبکرصدیقؓ نے مجاہدین کو چار لشکروں میں تقسیم کیا۔

314
00:27:46,145 --> 00:27:50,042
پہلا لشکر حضرت یزید بن ابی سفیانؓ کا لشکر تھا۔

315
00:27:50,074 --> 00:27:58,296
آپؓ نے حضرت یزید بن ابی سفیانؓ کو سات ہزار سے زائد مجاہدین کا امیر مقرر فرمایا اور اُن کی منزل دمشق متعین کی ۔

316
00:27:58,328 --> 00:28:06,509
دوسرا لشکر حضرت شرحبیل بن حسنہؓ کی قیادت میں، تین ہزار مجاہدین کے ساتھ، تبوک کے لئے روانہ کیا۔

317
00:28:06,534 --> 00:28:11,166
اِس ہدایت کے ساتھ کہ مسلمانوں کے عقب کی حفاظت کریں، اور ضرورت پڑنے پر اضافی کمک مہیا کریں

318
00:28:11,196 --> 00:28:15,029
 کیونکہ تبوک مدینہ کا سب سے قریبی مقام ہے۔

319
00:28:15,071 --> 00:28:22,909
تیسرا لشکر حضرت ابوعبيدة عمرو بن جراحؓ  کی سرکردگی میں تین ہزار سپاہیوں کے ساتھ شام میں حمص کے محاذ کے لیے مامور فرمایا،

320
00:28:22,949 --> 00:28:27,259
چوتھا لشکر سات ہزار مجاہدین پر مشتمل تھا جس کی قیادت عمرو بن العاص کر رہے تھے۔

321
00:28:27,284 --> 00:28:32,059
اور اِس لشکر کو حضرت ابو بکر صدیقؓ نے فلسطين کی جانب روانہ کیا۔

322
00:28:32,093 --> 00:28:41,829
خلیفہ حضرت ابوبکرصدیقؓ، سپہ سالاروں کو رخصت کرتے وقت اُن کے ساتھ پیدل چلتے، جب کہ سپاہِ سالار اپنے گھوڑوں پر سوار تھے،

323
00:28:41,869 --> 00:28:45,939
اور آپؓ ، اُن میں سے ہر امیرِ فوج کو ہدایات اور نصائح تلقین فرماتے

324
00:28:45,970 --> 00:28:49,661
میں آپ کے سامنے وہ نصیحت پڑھوں گا جو آپؓ  نے حضرت یزید بن ابی سفیانؓ کو کی تھی۔

325
00:28:49,686 --> 00:28:53,799
 جو کہ روانہ ہونے والا پہلا لشکر تھا

326
00:28:53,841 --> 00:28:58,849
خیلفہ رسولؓ نے فرمایا: میں آپؓ کو اِس لشکر کی قیادت کے لیے منتخب کررہا ہوں، تاکہ آپؓ کا امتحان لوں اور آپؓ کو آزماؤں۔

327
00:28:58,892 --> 00:29:02,902
اگر آپؓ اچھی کارکردگی کا مظاہرہ کرتے ہیں تو میں آپؓ کو مزید فرائض سونپوں گا۔

328
00:29:02,927 --> 00:29:05,472
اور اگر آپؓ یہ فرض بخوبی ادا نہیں کر پائے تو میں آپؓ کو معزول کر دوں گا۔

329
00:29:05,495 --> 00:29:08,049
پس میں آپؓ کو اللہ کا تقویٰ اختیار کرنے کی نصیحت کرتا ہوں۔

330
00:29:08,088 --> 00:29:13,362
کیونکہ اللہ ظاہر اور باطن سے خوب واقف ہے۔

331
00:29:13,409 --> 00:29:17,842
میں آپؓ کو حضرت خالد بن سعید بن عاصؓ  کے عہدے پر مقرر کر رہا ہوں۔

332
00:29:17,879 --> 00:29:21,122
آپؓ غرور اور عَصبیت جیسی جاہلانہ خرافات  سے دور رہیں۔

333
00:29:21,160 --> 00:29:24,776
جب آپؓ اپنے سپاہیوں کے ساتھ ہوں تو اُن کے اچھے ساتھی بنیں۔

334
00:29:24,833 --> 00:29:30,339
اور اگر آپؓ سپاہیوں سے خطاب کرنا چاہتے ہیں ،تو مختصر کریں ورنہ وہ پیغام بھول جائیں گے۔

335
00:29:30,379 --> 00:29:35,922
آپؓ اپنی کارگردگی بہتر رکھیں، آپؓ کے سپاہیوں کی کارگردگی بہتر ہو جائے گی۔

336
00:29:35,961 --> 00:29:38,162
نماز مقررہ وقت پر ادا کریں،

337
00:29:38,203 --> 00:29:43,202
 سجود اور رکوع کو مکمل کریں اور نماز میں خشوع وخصوع کا خیال رکھیں۔

338
00:29:43,245 --> 00:29:47,936
جب آپؓ کو اپنے دشمن کی طرف سے ایلچی ملیں تو ان کے ساتھ نرمی سے پیش آئیں۔

339
00:29:47,979 --> 00:29:53,686
لیکن انہیں اپنے پاس تادیر قیام کی اجازت نہ دیں، ورنہ وہ آپ کی کمزوریوں کو جان لیں گے۔

340
00:29:53,714 --> 00:30:00,206
انہیں اپنی مضبوط ترین فوجی قوت کے درمیان ٹھہرائیں اور اپنے سوا کسی کو ان سے بات کرنے کی اجازت نہ دیں۔

341
00:30:00,230 --> 00:30:03,316
جب آپؓ مجلسِ مشاورت بلائیں تو صاف گوئی اور سچائی سے کام لیں ۔

342
00:30:03,347 --> 00:30:05,909
تاکہ آپ بہترین او عمدہ مشورہ حاصل کر سکیں

343
00:30:05,934 --> 00:30:09,256
رات کو اپنے سپاہیوں کے ساتھ بات چیت میں وقت گزاریں،

344
00:30:09,298 --> 00:30:14,002
پھر آپؓ کو مختلف خبریں ملیں گی اور بہت سے راز کھلیں گے،

345
00:30:14,027 --> 00:30:18,062
اپنے محافظوں کو ہر سمت پھیلائیں اور اُن کی جانچ پڑتال کرتے رہیں۔

346
00:30:18,075 --> 00:30:23,522
اور جب بھی آپؓ  اپنی فوج کے محافظوں میں کسی قسم کی کوئی کوتاہی دیکھیں تو انہیں معمولی سی سزا دیں۔

347
00:30:23,547 --> 00:30:26,179
اُن لوگوں کے ساتھ وقت مت گزاریں، جو اپنا وقت ضائع کرتے ہیں

348
00:30:26,208 --> 00:30:29,372
لیکن اپنا وقت اہل حق اور وفاداروں کے ساتھ گزاریں۔

349
00:30:29,397 --> 00:30:35,622
مالی ناانصافی اور غلول سے بچیں، کیونکہ یہ غربت کو قریب لاتا ہے اور فتح کو دور کرتا ہے۔

350
00:30:35,647 --> 00:30:41,549
آپؓ کو گرجا گھروں میں گوشہ نشینی اختیار کیے ہوئے لوگ ملیں گے، اُنہیں اُن کے حال پر چھوڑ دیں۔

351
00:30:41,574 --> 00:30:50,459
یہ نصیحت کا ایک شاہکار ہے، جو خلیفہؓ نے حضرت یزیدؓ کو ارشاد فرمائی، ہم اس سے سیکھے جانے والے چند اسباق پر ایک نظر ڈالتے ہیں

352
00:30:50,492 --> 00:30:53,582
نمبر ایک، حضرت ابو بکرصدیقؓ فرما رہے ہیں کہ

353
00:30:53,601 --> 00:30:57,336
امیرِ لشکرِ ہونے کے ناطے آپؓ جو بھی قدم اُٹھائیں گے اُس کے لیے آپؓ جوابدہ ہوں گے۔

354
00:30:57,361 --> 00:30:59,688
حضرت ابوبکر صدیقؓ نے فرمایا: میں نے آپؓ کو آزمانے کے لیے اِس عہدے پر مقرر کیا۔

355
00:30:59,713 --> 00:31:03,419
 یہ ہہلا موقع تھا کہ جب آپؓ  نے حضرت یزیدؓ کو قیادت کے لیے منتخب کیا۔

356
00:31:03,449 --> 00:31:04,309
آپؓ نے فرمایا؛

357
00:31:04,333 --> 00:31:08,009
میں آپؓ کو یہ فرض سونپ رہا ہوں تاکہ آپؓ کو آزما سکوں اور آپؓ کا متحان لے سکوں

358
00:31:08,034 --> 00:31:10,962
اگر آپؓ اچھی کارکردگی کا مظاہرہ کرتے ہیں تو میں آپؓ کی ذمہ داریاں مزید بڑھا دوں گا

359
00:31:10,987 --> 00:31:15,086
 اگر آپؓ یہ فرض احسن طریقے سے ادا نہ کر پائے تو میں آپؓ کو بدل دوں گا ۔ اور یہ عہدہ ہمیشہ کے لیے نہیں ہے،

360
00:31:15,111 --> 00:31:19,909
کیونکہ جب عہدے داران کو لگتا ہے کہ ان کی تقرری دائمی ہے، تو وہ سست ہو جاتے ہیں،

361
00:31:19,934 --> 00:31:26,582
حضرت ابوبکرؓ فرما رہے ہیں کہ آپؓ کی ذمہ داری تبدیل کی جا سکتی ہے، یہ آپؓ کی کارکردگی پر منحصر ہے

362
00:31:26,607 --> 00:31:31,629
اور آپؓ جو بھی قدم اٹھائیں گے، اُس کا آپؓ کو جوابدہ ٹھہرایا جائے گا

363
00:31:31,654 --> 00:31:34,196
نمبر دو، اللہ کا ڈر

364
00:31:34,221 --> 00:31:37,942
یہ سب سے اہم نصیحت ہے کہ اللہ تبارک وتعالٰی سے ڈریں ۔

365
00:31:37,967 --> 00:31:42,426
نمبر تین، آپؓ ،حضرت یزیدؓ کو قومیت پرستی اور قبائلیت پرستی کے خطرات سے خبردار کر رہے ہیں۔

366
00:31:42,451 --> 00:31:47,282
اب حضرت یزید بن ابی سفیانؓ کا تعلق قریش کے ایک بڑے خاندان سے تھا۔

367
00:31:47,307 --> 00:31:49,802
 آپؓ کے والد حضرت ابو سفیانؓ  قریش کے سردار تھے ،

368
00:31:49,827 --> 00:31:55,102
اور حضرت سفیانؓ وہ شخص ہیں جنہوں نے اپنی زندگی کا بڑا حصہ حضرت محمدؐ کے خلاف جنگ کی قیادت کرتے ہوئے گزارا۔

369
00:31:55,127 --> 00:31:58,099
لیکن پھر، جب مکہ فتح ہوا تو حضرت ابوسفیانؓ مسلمان ہو گئے۔

370
00:31:58,124 --> 00:32:01,882
چنانچہ، اب حضرت ابو بکر صدیقؓ ،حضرت سفیانؓ کے بیٹے حضرت یزیدؓ کو لشکر کی قیادت کے لیے مقرر کر رہے ہیں۔

371
00:32:01,907 --> 00:32:08,789
اِس لیے حضرت ابوبکرؓ، آپؓ کو زمانہ جاہلیت کی کسی بھی باقیات سے خبردار کر رہے جو اب بھی کسی نئے مسلمان کے دل میں ہو سکتی ہے۔

372
00:32:08,814 --> 00:32:11,616
قبائلیت پرستی اور قومیت پرستی سے دور رہو

373
00:32:11,641 --> 00:32:15,976
اب یہ اسلامی بھائی چارہ ہے

374
00:32:16,001 --> 00:32:18,822
فرمایا: مختصر رہیں

375
00:32:18,847 --> 00:32:25,496
 جب آپؓ اپنے سپاہیوں سے بات کریں تو انہیں لمبی ہدایات نہ دیں اور یہ ایک ایسی نصیحت ہے، جو ہر مقرر کو دینی چاہیے

376
00:32:25,526 --> 00:32:27,492
، سپاہیوں کو لمبی ہدایات نہ دیں کیونکہ

377
00:32:27,516 --> 00:32:29,509
يُنسي آخرالكلام أوَّلًا

378
00:32:29,534 --> 00:32:32,616
آخری بات آپ کو پہلی باتیں بھلا دیتی ہیں۔

379
00:32:32,641 --> 00:32:37,256
لہٰذا مختصر کلام کریں، خاص طور پر جب آپؓ سپاہیوں کو جنگ کی ہدایات دے رہے ہوں

380
00:32:37,281 --> 00:32:42,182
اگر آپؓ چاہتے ہیں کہ آپؓ کے الفاظ یاد رہیں تو بہت مختصر رہیں، اور پھر آپؓ نے فرمایا۔

381
00:32:42,207 --> 00:32:44,852
پہلے اپنا خیال رکھیں۔

382
00:32:44,877 --> 00:32:54,409
بطور خلیفہ آپؓ فوج کے سَربراہان کو سکھا رہے ہیں کہ اگر آپ چاہتے ہیں کہ آپ کے سپاہی بہترین کارگردگی دکھائیں

383
00:32:54,434 --> 00:32:56,422
 تو پہلے اپنے آپ کو بہتر کرنے کی ضرورت ہے

384
00:32:56,447 --> 00:32:58,976
اگر آپ میں تقویٰ ہے تو سپاہی بھی تقویٰ کا راستہ اختیار کریں گے

385
00:32:59,001 --> 00:33:03,149
اگر آپ اللہ کے احکام کے پابند رہیں گے تو آپ کی فوج بھی اللہ کے احکام کا خیال رکھے گی۔

386
00:33:03,174 --> 00:33:06,889
اگر آپ اللہ کے قوانیں پر عمل پیرا رہیں گے تو سپاہی بھی پابند رہیں گے۔

387
00:33:06,914 --> 00:33:11,996
لہٰذا جب لیڈر خود کو بہتر بناتا ہے تو وہ بہتری دراصل عوام کا سرمایہ ہے۔

388
00:33:12,021 --> 00:33:14,056
یہ بہتری عوام کو بھی بہتر بنائے گی

389
00:33:14,081 --> 00:33:16,829
جب آپ خود سچے نہیں ہیں تو آپ لوگوں سے سچا ہونے کی توقع نہیں کرسکتے ہیں۔

390
00:33:16,854 --> 00:33:20,469
جب آپ لوگوں کے ساتھ ایماندار نہیں ہیں، تو آپ اُن سے ایمانداری کی توقع نہیں رکھ سکتے۔

391
00:33:20,494 --> 00:33:24,482
جب قائد قربانی نہیں دے سکتا، تو آپ بھی عوام سے قربانی کی امید نہیں باندھ سکتے۔

392
00:33:24,507 --> 00:33:27,642
لیکن جب لوگ اپنے لیڈر میں یہ تمام صفات دیکھتے ہیں

393
00:33:27,667 --> 00:33:31,922
تو وہ اپنے قائد کی تقلید میں اِن تمام خوبیوں کو اپنا لیتے ہیں

394
00:33:31,947 --> 00:33:35,796
نمبرچھ، نماز کی اہمیت۔

395
00:33:35,821 --> 00:33:39,319
حضرت ابوبکرصدیقؓ دشمن سے لڑنے کے لیے لشکر بھیج رہے ہیں۔

396
00:33:39,344 --> 00:33:44,209
امیرِ لشکر فوجوں کی ترتیب اور تیاری میں بے حد مصروف ہوسکتا ہے لیکن یہ کبھی نہیں ہو سکتا کہ وہ اپنی نماز بھول جائے،

397
00:33:44,234 --> 00:33:48,682
درحقیقت آپؓ نماز کو کسی صورت نہیں چھوڑتے تھے اور نماز کی اہمیت پر اس قدر زور دیتے تھے

398
00:33:48,721 --> 00:33:52,762
 کیونکہ آپؓ جانتے تھے کہ فتح کا دارومدار ہماری عبادت پر ہے۔

399
00:33:52,787 --> 00:33:56,429
تو، آپؓ حضرت یزید بن سفیانؓ کو ہدایت دے رہے تھے کہ آپؓ وقت پر نماز ادا کریں

400
00:33:56,454 --> 00:34:00,549
اور رکوع اور سجود کا مکمل ہونا ضروری ہے۔

401
00:34:00,574 --> 00:34:05,894
کیونکہ لشکر کے ساتھ آپؓ ایک جگہ سے دوسری جگہ جا رہے ہوتے ہیں، آپؓ جنگی سرگرمیوں میں مصروف رہتے ہیں، آپؓ پر خوف طاری رہتا ہے

402
00:34:05,924 --> 00:34:10,882
، لیکن یہ کوئی عذر نہیں کہ آپؓ خشوع وخضوع  کے بغیر نماز پڑھیں،

403
00:34:10,907 --> 00:34:18,602
آپؓ کو اِس وقت بھی اپنی نماز میں خشوع برقرار رکھنا ہے، چاہے ہر سُو ہلچل اور افراتفری ہی کیوں نہ ہو

404
00:34:18,627 --> 00:34:23,541
   خلفشار کی جنگ سے بڑھ کر کوئی اور صورت نہیں ہوسکتی، کہ جب لشکر اللہ کی راہ میں جہاد کر رہا ہو

405
00:34:23,589 --> 00:34:27,486
تاہم اِس صورتحال میں بھی آپؓ کو خشوع سے نماز ادا کرنی ہے، اور رکوع اور سجود کا بھی مکمل ہونا لازمی ہے

406
00:34:27,511 --> 00:34:34,296
نہ جانے کون لوگ ہیں، جو ایک پرُتعیش زندگی گزار رہے ہیں، اُن کی زندگی میں کسی پریشانی کا وجود نہیں

407
00:34:34,336 --> 00:34:37,822
اور ان کی نماز صرف ایک مشق کی طرح ہے، عجلت کی نماز

408
00:34:37,847 --> 00:34:39,154
نمبر سات؛

409
00:34:39,184 --> 00:34:43,221
دشمن کے سفیروں کے ساتھ مہربانی اور دیکھ بھال

410
00:34:43,246 --> 00:34:48,609
آپؓ نے فرمایا؛ جب دشمن کی طرف سے کوئی قاصد، ایلچی یا وفد تمہاری طرف آئے

411
00:34:48,639 --> 00:34:54,286
تو اُن کے ساتھ نرمی سے پیش آؤ، اگرچہ وہ تمہارے دشمن ہیں لیکن اُن کے ساتھ مہربانی والا سلوک کرو، اور ان کے ساتھ فیاضی سے پیش آؤ

412
00:34:54,316 --> 00:34:57,376
  اور انہیں تادیر اپنے پاس قیام کے لئے نہ ٹھہرائیں۔

413
00:34:57,401 --> 00:35:04,146
سخاوت اور مہربانی الگ چیز ہے اور اُنہیں اپنی فوج تک رسائی دینا الگ چیز ہے،

414
00:35:04,192 --> 00:35:07,149
تو مہربانی کا مطلب یہ نہیں کہ دشمنوں کے سامنے بھولا بنا جائے۔

415
00:35:07,174 --> 00:35:10,642
آپؓ نے فرمایا: اُنہیں طویل وقت کے لیے نہ ٹھہرائیں ۔

416
00:35:10,667 --> 00:35:18,782
اور پھر آپؓ نے فرمایا : اُنہیں اپنی سب سے مضبوط اور طاقتور فوجی قوت کے حلقے میں ٹھرائیں۔

417
00:35:18,807 --> 00:35:23,969
تاکہ انہیں آپ کی کمزوری کا نہیں بلکہ آپ کی طاقت کا تاثر ملے۔

418
00:35:23,999 --> 00:35:26,729
اور پھر فرمایا: کسی کو اُن سے بات نہ کرنے دیں۔

419
00:35:26,754 --> 00:35:31,512
آپ اکیلے ہی اُن قاصدوں سے بات کریں۔

420
00:35:31,537 --> 00:35:35,149
نمبر آٹھ، مجلسِ شوریٰ کی کامیابی صرف سچائی اور ایمانداری پر منحصر ہے ۔

421
00:35:35,174 --> 00:35:41,802
جب آپ فوج کے سَربراہان کو مشاورت کے لیے طلب کریں ۔

422
00:35:41,827 --> 00:35:49,522
تو حالات کے مدّنظر، اُن کے سامنے حقائق کھول کر بیان کریں، تاکہ آپ کو بالکل درست مشورہ مل سکے

423
00:35:49,547 --> 00:35:56,069
یوں نہیں ہو سکتا کہ آپ اُنہیں مکمل معلومات فراہم کیئے بغیر گمان کریں کہ آپ کو درست تجویز ملے

424
00:35:56,094 --> 00:35:58,776
اگر آپ مشاورت طلب کرتے ہیں

425
00:35:58,801 --> 00:36:05,532
تو جو شخص آپ کو مشورہ دے، اُس کے پاس تمام حقائق کا ہونا ضروری ہے، تاکہ وہ صحیح نتیجے پر پہنچ کر آپ کی رہنمائی کر سکے

426
00:36:05,557 --> 00:36:10,809
کیونکہ آپ کہہ سکتے ہیں کہ اللہ سبحانہ وتعالی کا فرمان ہے اگر آپ مشورہ کرتے ہیں، تو آپ بہترین نتیجے پر پہنچیں گے

427
00:36:10,834 --> 00:36:12,687
 لیکن میں نے مشورہ کیا اور وہ درست ثابت نہیں ہوا،

428
00:36:12,712 --> 00:36:18,349
وجہ یہ ہے کہ آپ نے مجلسِ شوریٰ میں مکمل مدّعا بیان نہیں کیا

429
00:36:18,374 --> 00:36:23,729
لہذا، مشاورت کے تمام پہلوؤں کو مدنظر رکھنا ضروری ہے، اگر آپ شوریٰ کی کامیابی چاہتے ہیں

430
00:36:23,754 --> 00:36:28,179
نمبر نو، آپؓ مجاہدین کے ساتھ گھل مل کر رہیں اور اُن سے کسی بھی صورت الگ نہ ہوں۔

431
00:36:28,202 --> 00:36:30,589
آپؓ نے فرمایا: رات کو مجاہدین سے بات چیت کریں۔

432
00:36:30,614 --> 00:36:36,709
اور سب سے مناسب رات کا ہی وقت ہے، جب آپ کو معلومات اور خبریں ملتی ہیں

433
00:36:36,734 --> 00:36:40,954
سبحان اللہ! رات کے وقت بات کرنے کی خاصیت یہ ہے کہ

434
00:36:40,984 --> 00:36:44,042
اِس وقت جسم میں مزاحمت کم ہوتی ہے،

435
00:36:44,072 --> 00:36:48,679
لہذا رات کے وقت کوئی شخص اپنی نجی زندگی، معاملات یا رازوں کے بارے میں بات کرنے کے لئے رضا مند ہو جاتا ہے

436
00:36:48,709 --> 00:36:53,962
جبکہ وہی راز وہ دن کے وقت کبھی زبان پر نہیں لے کر آئے گا

437
00:36:53,987 --> 00:37:00,456
لہذا اگر آپ تفتیش کرنا چاہتے ہیں تو رات کا وقت نہایت موزوں ہے

438
00:37:00,481 --> 00:37:10,149
 رات کی صفات میں، چاند کی چاندنی، ستارے، اور رومانوی ماحول انسان کے دل کے پردے کھول سکتا ہے

439
00:37:10,174 --> 00:37:14,489
صحابہ کرامؓ کے پاس حکمت اور دانائی تھی وہ جانتے تھے کہ معاملات کو کیسے لے کر چلنا ہے۔

440
00:37:14,514 --> 00:37:19,382
تو آپؓ نے فرمایا: رات کو اپنے سپاہیوں کے ساتھ بات چیت کریں، اس وقت کئی بھید کُھلیں گے۔

441
00:37:19,407 --> 00:37:22,922
اگر آپؓ اپنے سپاہیوں کے حالات جاننا چاہتے ہیں

442
00:37:22,947 --> 00:37:26,441
صرف اِسی طرح ہی آپؓ کو معلومات اور خبروں تک رسائی ملے گی۔

443
00:37:26,466 --> 00:37:31,002
آپؓ سپاہیوں کے قریب جائیں، اُن کے ساتھ وقت گزاریں اور بات چیت کریں۔

444
00:37:31,027 --> 00:37:34,509
نمبر دس، مسلم فوج پر پہرہ داروں کی تعیناتی ۔

445
00:37:34,534 --> 00:37:40,429
آپؓ نے فرمایا: پہرہ داروں کو مقرر کریں اور پھر اُن پر نظر رکھیں

446
00:37:40,454 --> 00:37:47,292
اور اگر آپؓ کو اُن میں کوئی خامی، کوئی غلطی نظر آئے تو آپؓ انہیں اُس کی سزا دیں، لیکن معمولی سزا دیں

447
00:37:47,317 --> 00:37:49,642
بہت سخت سزا نہ دیں۔

448
00:37:49,672 --> 00:37:56,279
اُن کی کسی بھی غلطی یا کوتاہی کو ایسے ہی نہ چھوڑ دیں اور نہ ہی بہت زیادہ دُرشتی سے پیش آئیں ۔

449
00:37:56,306 --> 00:37:58,369
نمبر گیارہ، اچھی صحبت کی اہمیت۔

450
00:37:58,394 --> 00:38:01,536
اپنا وقت اُن لوگوں کے ساتھ نہ گزاریں جو اپنا وقت ضائع کرتے ہیں۔

451
00:38:01,561 --> 00:38:03,019
آپ کو سنجیدگی اِختیار کرنی ہے

452
00:38:03,051 --> 00:38:10,609
 خود کو اہل حق، اہلِ صدق اور باوفا لوگوں کے درمیان رکھیں

453
00:38:10,634 --> 00:38:12,894
آپ کو چاہیے کہ آپ شکرگزار لوگوں کے ساتھ وقت گزاریں،

454
00:38:12,924 --> 00:38:15,869
ایسے لوگ جو آپ کی مدد کریں، جب آپ کو مدد کی ضرورت ہو

455
00:38:15,899 --> 00:38:19,176
وہ لوگ جو مشکل کے وقت آپ کو دھوکہ نہ دیں۔

456
00:38:19,201 --> 00:38:22,469
کیونکہ کچھ لوگ ایسے ہوتے ہیں جو دل لگی میں ماہر ہوتے ہیں

457
00:38:22,494 --> 00:38:26,529
وہ آپ کو خوش کرنے کے لیے آپ کے ساتھ اچھا وقت گزارتے ہیں

458
00:38:26,554 --> 00:38:30,789
لیکن جب حالات سنگین ہو جاتے ہیں، تو وہ آپ کو چھوڑ کر چلے جاتے ہیں۔

459
00:38:30,814 --> 00:38:33,602
تو آپؓ حضرت یزیدؓ کو نصیحت کررہے ہیں کہ اپنے آس پاس اُن لوگوں کو رکھیں جو فادار ہوں ۔

460
00:38:33,627 --> 00:38:37,176
بطور سپاہی، آپ کو چاہیے کہ آپ کے ارد گرد وفادار لوگ ہوں

461
00:38:37,201 --> 00:38:43,206
آپؓ فوج کے امیرؓ کو ہدایات دے رہے ہیں کہ آپؓ وفاداروں کو اپنا قریبی ساتھی بنائیں۔

462
00:38:43,231 --> 00:38:46,256
نمبر بارہ، مال کی نگرانی.

463
00:38:46,281 --> 00:38:50,854
آپؓ نے فرمایا؛ اگر فوج میں لین دین میں ناانصافی یا غلول ہو،

464
00:38:50,879 --> 00:38:58,049
تو یہ عمل غربت کو قریب لائے گا اور فتح کو کوسوں دور کر دے گا۔

465
00:38:58,074 --> 00:39:01,917
 حضرت شرحبیل بن حسنہؓ کو محاذ پر روانہ کرتے ہوئے خلیفہ حضرت ابوبکرؓ ساتھ تھے؛

466
00:39:01,954 --> 00:39:06,122
پھر آپؓ نےحضرت شرحبیلؓ سے دریافت کیا، کہ کیا آپؓ نے وہ ہدایات سن لیں جو میں نے حضرت یزیدؓ کو بتائی ہیں۔؟

467
00:39:06,147 --> 00:39:07,269
حضرت شرحبیلؓ نے فرمایا؛ جی ہاں

468
00:39:07,299 --> 00:39:09,776
حضرت ابوبکرؓ نے فرمایا؛ اِن ہدایات پر آپؓ بھی عمل پیرا ہوں،

469
00:39:09,801 --> 00:39:14,887
اِن کے علاوہ کچھ اور نکات بھی ہیں جن کا میں حضرت یزیدؓ سے ذکر کرنا بھول گیا تھا، اور اب میں یہ نکات آپؓ کے سامنے پیش کرتا ہوں

470
00:39:14,931 --> 00:39:19,156
فرمایا؛ جب آپؓ اپنے دشمن سے ملیں تو صبر کریں۔

471
00:39:19,181 --> 00:39:20,776
صبر کامیابی کی کنجی ہے۔

472
00:39:20,801 --> 00:39:23,549
صْبِرُواْ وَصَابِرُواْ وَرَابِطُواْ

473
00:39:23,574 --> 00:39:26,542
اللہ عَزَّوَجَلْ فرماتا ہے: إصْبِرُو( صبر کرو)، وَصَابِرُو،

474
00:39:26,567 --> 00:39:30,389
وَصَابِرُو کا مفہوم یہ ہے کہ صبر کے ساتھ آپ دشمن پر سبقت لے جائیں۔

475
00:39:30,414 --> 00:39:34,374
تو آپ صبر کر سکتے ہیں، لیکن دشمن آپ سے زیادہ صابر بھی ہو سکتا ہے

476
00:39:34,399 --> 00:39:38,082
میرا مطلب ہے، آپ آیت کے پہلے حصے کی پیروی کر رہے ہیں ،إصْبِرُو؛ صبر کرو۔

477
00:39:38,107 --> 00:39:40,599
لیکن اگر آپ کا دشمن بھی صبر کرے تو آپ کیا کریں گے؟

478
00:39:40,629 --> 00:39:41,739
وَصَابِرُو

479
00:39:41,764 --> 00:39:47,399
جس کا مطلب ہے کہ آپ صبر کے درجے پر دشمنوں سے مقابلہ کریں، یہاں تک کہ آپ ان پر سبقت لے جائیں۔

480
00:39:47,424 --> 00:39:54,376
 ایک انتریٰ نامی کردار ہے جو ہمت اور بہادری کی مثال ہے

481
00:39:54,401 --> 00:39:59,396
أنترى سے کسی نے پوچھا کہ آپ ہمیشہ اپنے دشمن سے کیسے جیت جاتے ہیں؟

482
00:39:59,421 --> 00:40:02,642
کیا چیز ہے جو آپ کو ہمیشہ دشمن پر غالب رکھتی ہے؟

483
00:40:02,667 --> 00:40:03,979
اُس نے کہا؛ میں تمہیں بتاتا ہوں کہ کیسے،

484
00:40:04,009 --> 00:40:06,546
 میں تمہاری انگلی چباتا ہوں

485
00:40:06,571 --> 00:40:08,682
اور تم میری انگلی چباؤ

486
00:40:08,712 --> 00:40:11,482
 اور پھر ہم دونوں یک مشت ایک دوسرے کی انگلیاں چباتے ہیں ۔

487
00:40:11,507 --> 00:40:14,824
اُس شخص نے کہا؛ ٹھیک ہے اور پھر اُنھوں نے اپنی انگلیاں ایک دوسرے کے منہ میں رکھ دیں۔

488
00:40:14,849 --> 00:40:19,056
تو انترا اس شخص کی انگلی کاٹنے لگا اور وہ آدمی انترا کی انگلی کاٹنے لگا ۔

489
00:40:19,081 --> 00:40:22,916
اور وہ ایک دوسرے کی انگلیاں کچلنے لگے۔

490
00:40:22,941 --> 00:40:26,069
تھوڑی دیر بعد اُس آدمی نے چیخ کر کہا میں ہار مانتا ہوں۔

491
00:40:26,094 --> 00:40:27,796
انترا نے کہا؛

492
00:40:27,828 --> 00:40:33,109
اگر تم صرف ایک لمحہ اور انتظار کرتے تو میں ہار مان لیتا،

493
00:40:33,134 --> 00:40:36,442
اور اسی لیے میں ہمیشہ اپنے دشمن سے جیت جاتا ہوں۔

494
00:40:36,467 --> 00:40:46,569
تو یہی وہ لمحہ ہے جس کا اگر آپ نے انتظار کر لیا تو دشمن کو مات دے کر فتح حاصل کر سکیں گے، اِسی لمحے پر جیت منحصر ہے

495
00:40:46,594 --> 00:40:52,202
دوسری نصیحت، بیماروں اور زخمیوں کی عیادت اور جنازے میں شرکت کریں،

496
00:40:52,227 --> 00:40:54,522
امیرِ فوج ،سپاہیوں کی زندگی سے منسلک ہو

497
00:40:54,552 --> 00:40:56,766
جب کوئی سپاہی زخمی ہو تو اُس کی عیادت کریں

498
00:40:56,791 --> 00:40:58,769
جب کوئی سپاہی بیمار ہو تو اُس کی تیمارداری کریں

499
00:40:58,799 --> 00:41:02,642
 ، جب کوئی وفات پا جائے تو جنازے میں شرکت کریں

500
00:41:02,667 --> 00:41:08,642
مجاہدین سے الگ نہ رہیں، اپنے اور اُن کے درمیان کوئی رکاوٹ حائل نہ کریں۔

501
00:41:08,667 --> 00:41:11,782
پھر آپؓ نے فرمایا؛ اللہ کو کثرت سے یاد کریں۔

502
00:41:11,807 --> 00:41:13,776
وَذْكُرالله كَثِيْرَا

503
00:41:13,801 --> 00:41:15,752
اللہ کو کثرت سے یاد کریں۔

504
00:41:15,777 --> 00:41:20,722
یہ وہ ہدایت و نصائح ہیں جو حضرت ابوبکرصدیقؓ نے حضرت شرحبیل بن حسنہؓ کو دیں۔

505
00:41:20,747 --> 00:41:23,921
آپؓ نے حضرت عمرو بن العاصؓ کو بھی یہی نصیحت کی، لیکن اِس سے پہلے،

506
00:41:23,946 --> 00:41:27,179
حضرت عمرو بن العاصؓ عمان میں تعینات تھے۔

507
00:41:27,204 --> 00:41:31,696
حضرت عمرو بن العاصؓ کو رسول اللہؐ نے عمان کا گورنر مقرر کیا تھا۔

508
00:41:31,721 --> 00:41:33,149
 حروبِ رِدَّۃ کے دوران

509
00:41:33,174 --> 00:41:34,714
 آپؓ کو عمان چھوڑنا پڑا،

510
00:41:34,744 --> 00:41:38,317
لیکن پھر حضرت ابوبکرصدیقؓ نے آپؓ کو ایک خط بھیجا، جس میں بیان تھا؛

511
00:41:38,341 --> 00:41:42,739
میں نے آپؓ کو اُس عہدے پر رکھنا چاہتا ہوں جہاں اللہ کے رسولؐ نے آپؓ کو مقرر کیا تھا

512
00:41:42,764 --> 00:41:43,992
یعنی بطور گورنرِ عمان

513
00:41:44,022 --> 00:41:53,112
میں چاہتا ہوں کہ حضرت ابو عبداللہؓ(کنیت) کو اُس منصب پر فائز کروں جو آپؓ کی دنیاوی اور آخروی زندگی کے لیے بہتر ہے

514
00:41:53,128 --> 00:41:56,019
لیکن یہ آپؓ کی مرضی پر ہے کہ آپؓ کیا انتخاب کرتے ہیں

515
00:41:56,049 --> 00:41:57,962
حضرت ابوبکرصدیقؓ فرما رہے ہیں؛

516
00:41:57,995 --> 00:42:01,646
آپؓ کو رسول اللہؓ نے عمان میں تعینات کیا تھا، مجھے آپؓ کے اِس عہدے پر کوئی اعتراض نہیں

517
00:42:01,662 --> 00:42:06,792
البتہ، میرے پاس کے لیئے ایک عہدہ ہے جو اِس دنیا میں بھی آپؓ کے لیے بہتر ہے، اور آخرت میں بھی آپؓ کو سرخرو کرے گا

518
00:42:06,816 --> 00:42:13,926
حضرت ابوبکر صدیقؓ کسی کو اُس عہدے سے معزول نہیں کرنا چاہتے تھے، جس عہدے پر اُنہیں رسول اللہؓ نے تعینات کیا تھا،

519
00:42:13,971 --> 00:42:16,059
جب تک آپؓ اُنہیں بہتر متبادل فراہم نہ کریں۔

520
00:42:16,112 --> 00:42:20,069
 آپؓ نے کبھی کسی کو برطرف نہیں کیا جسے رسول اللہؐ نے مقرر کیا ہو۔

521
00:42:20,111 --> 00:42:23,936
 چونکہ،حضرت عمرو بن العاصؓ کو رسول اللہؓ  نے ریاستِ عمان کا امیر مقرر کیا تھا۔

522
00:42:23,966 --> 00:42:26,286
حضرت ابوبکر صدیقؓ نے فرمایا: میں یہ عہدہ دوبارہ آپؓ کے حوالے کر رہا ہوں۔

523
00:42:26,311 --> 00:42:30,426
تاہم، میرے پاس کچھ خاص ہے جس کا انتخاب میں آپؓ پر چھوڑ رہا ہوں۔

524
00:42:30,448 --> 00:42:36,139
 اور جو خاص بات حضرت ابوبکر صدیقؓ کے ذہن میں تھی وہ سرزمینِ فلسطين کی تسخیر تھی

525
00:42:36,169 --> 00:42:38,742
جو حضرت عمرو بن العاصؓ کے لیے بہتر دنیاوی منسب تھا

526
00:42:38,772 --> 00:42:45,132
اور دوسرا یہ جہاد کا میدان تھا جو آخرت میں کامیابی کا سبب ہے۔

527
00:42:45,171 --> 00:42:51,292
حضرت عمرو بن العاصؓ نے جواب میں خط بھیجا، اور فرمایا؛ میں اسلام کے تیروں میں سے ایک تیر ہوں۔

528
00:42:51,333 --> 00:42:55,826
اور اللہ کے بعد آپؓ اسلام کے تیروں کو اکٹھا کریں گے اور نشانہ باندھیں گے۔

529
00:42:55,854 --> 00:42:59,749
حضرت عمرو بن العاصؓ فرما رہے ہیں کہ: میں اسلام کا ایک تیر ہوں،

530
00:42:59,782 --> 00:43:01,886
اور خلیفہ حضرت ابو بکر صدیقؓ تیر انداز ہیں

531
00:43:01,915 --> 00:43:06,962
آپؓ سب سے مضبوط، سب سے زیادہ بھیانک اور بہترین ہدف تلاش کریں اور مجھے اُس طرف پھینک دیں

532
00:43:07,009 --> 00:43:08,776
اور میں آپؓ کا سپاہی بننے کوہی ترجیح دوں گا

533
00:43:08,818 --> 00:43:14,622
میں ایک تیر ہوں آپؓ جس طرف چاہیں اُس طرف چلا دیں

534
00:43:14,661 --> 00:43:16,409
اور میں آپؓ سپاہی ہوں

535
00:43:16,450 --> 00:43:20,396
چنانچہ حضرت ابوبکر صدیقؓ نے فوراً آپؓ کو مدینہ منورہ بلوایا

536
00:43:20,425 --> 00:43:25,056
 اور آپؓ کو فلسطين کے محاذ کے لیے مختص فوج کی قیادت کے لیے تعینات کیا

537
00:43:25,100 --> 00:43:31,529
اب چاروں لشکروں نے شام روانگی کے لیے الگ الگ راستے اختیار کیے

538
00:43:31,564 --> 00:43:38,296
اور ہراقل نے خطرے کو بھانپتے ہوئے انطاکیہ میں فوجی چھاؤنی قائم کی

539
00:43:38,344 --> 00:43:43,996
اور اُس نے بدلے میں فوجیں ترتیب دینا شروع کیں

540
00:43:44,043 --> 00:43:50,182
اور اُس نے صحابہ کرام کے چاروں لشکروں کا مقابلہ کرنے کے لیے چار لشکر بھیجے

541
00:43:50,228 --> 00:43:56,516
ہرقل کے پہلے لشکر کی قیادت اس کا بھائی تھیوڈور کر رہا تھا، جو کہ نوے ہزار سپاہیوں پر مشتمل تھا

542
00:43:56,541 --> 00:43:59,716
 اُس لشکر نے حضرت عمرو بن العاصؓ کے لشکر سے مقابلے کرنا تھا

543
00:43:59,749 --> 00:44:01,559
اب  حضرت عمرو بن العاصؓ کے پاس کتنے مجاہد تھے؟

544
00:44:01,594 --> 00:44:02,869
سات ہزار،

545
00:44:02,896 --> 00:44:05,456
سات ہزار کے مقابلے میں نوے ہزار،

546
00:44:05,488 --> 00:44:09,576
تھیوڈور کے بیٹے جارج کا  لشکر حضرت یزید بن ابی سفیانؓ کے مقابلے میں بھیجا گیا، اس لشکر کی تعداد کا ذکر نہیں کیا گیا

547
00:44:09,628 --> 00:44:12,989
دارقس کے ماتحت لشکر حضرت شرحبیل بن حسنہؓ کے مقابلے پر روانہ ہوا، ان کی تعداد کا بھی کوئی حوالہ نہیں

548
00:44:13,024 --> 00:44:19,608
 قبقر(وصاریس) کا لشکر ساٹھ ہزار تھا جو حضرت ابو عبیدہ عمرو بن جراحؓ کے مقابل آیا

549
00:44:19,633 --> 00:44:22,169
تو رومیوں کے لشکر کثیر تعداد تھے

550
00:44:22,209 --> 00:44:30,742
اب جب چاروں لشکروں کے سپہ سالاروں(صحابہ کرامؓ) نے اپنے مقابل لشکروں کی تعداد دیکھی

551
00:44:30,776 --> 00:44:34,729
 تو انہوںؓ نے خلیفہ حضرت ابو بکرصدیقؓ کو مدد کے لیے خط بھیجنا شروع کر دیئے،

552
00:44:34,765 --> 00:44:41,206
حضرت ابو عبیدہؓ ،حضرت عمرو بن العاصؓ اور حضرت زیدؓ، سب نے امداد کے لیے خظوط بھیجے،

553
00:44:41,251 --> 00:44:44,023
ألله أغلم ! شاید صحابہ کرامؓ کو اتنی تعداد کی توقع نہیں تھی یا کیا۔۔۔۔۔۔؟

554
00:44:44,048 --> 00:44:51,229
  لیکن رَزم گاہ میں موجود سپاہِ سالار، خلیفہ حضرت ابوبکر صدیقؓ سے مدد کی درخواست کر رہے تھے

555
00:44:51,269 --> 00:44:52,829
حضرت ابوعبیدہؓ نے خط بھیجا اور بیان کیا

556
00:44:52,854 --> 00:44:55,346
اللہ کے نام سے جو بڑا مہربان نہایت رحم والا ہے۔

557
00:44:55,376 --> 00:45:00,626
اللہ کے بندے اور رسول اللہؐ جانشین حضرت ابوبکر صدیقؓ، کے نام،

558
00:45:00,656 --> 00:45:02,439
حضرت ابو عبیدہ عمرو بن جراحؓ کی طرف سے

559
00:45:02,479 --> 00:45:03,696
السلام عليكم!

560
00:45:03,734 --> 00:45:09,572
میں اللہ کی حمد ثنا کرتا ہوں اور اللہ سے دعا کرتا ہوں کہ وہ اسلام اور اس کے پیروکاروں کو عزت دے اور انہیں فتح عطا فرمائے۔

561
00:45:09,601 --> 00:45:18,756
مجھے خبر ملی ہے کہ رومیوں کے بادشاہ ہرقل نے شام  کے ایک قصبے انطاکیہ میں اپنا فوجی اڈہ بنا لیا ہے،

562
00:45:18,801 --> 00:45:24,949
اور اس نے اپنی قوم اور اپنی ریاست کے لوگوں کو ہمارے خلاف متحرک کیا ہے

563
00:45:24,983 --> 00:45:28,259
اُس کی قوم نے کثیر تعداد میں اُس کی پُکار کا جواب دیا ہے

564
00:45:28,292 --> 00:45:31,976
میں آپؓ کو دشمن کی کثیر تعداد کی اطلاع دینا چاہتا تھا تا کہ آپؓ ہمیں اپنی رائے سے نوازیں

565
00:45:32,001 --> 00:45:35,102
 والسلام عليكم ورحمة الله وبركاته

566
00:45:35,149 --> 00:45:41,056
اس خط میں دو بنیادی باتیں ہیں نمبر ایک ، کہ ہرقل انطاکیہ میں ہے

567
00:45:41,081 --> 00:45:44,694
 آپؓ نے خلیفہ حضرت ابو بکرصدیقؓ سے فرمایا کہ ہراقل اِس معرکہ آرائی کو انتہائی سنجیدہ لے رہا ہے

568
00:45:44,744 --> 00:45:52,349
وہ اپنے دارالحکومت، قسطنطنیہ سے اس جنگ پر نظر رکھنے کی غرض سے انطاکیہ آچُکا ہے

569
00:45:52,391 --> 00:45:54,756
تو رومی اس جنگ کو بہت سنجیدہ لے رہے ہیں۔

570
00:45:54,793 --> 00:46:00,486
 دوسری بات یہ ہے کہ ہرقل نے اپنی سلطنت کے لوگوں کو بلایا اور کہا

571
00:46:00,511 --> 00:46:02,257
فجاعه على صعب والذلول

572
00:46:02,289 --> 00:46:06,834
مطلب وہ ہر طرف سے سیلاب کی طرح امڈتے چلے آرہے ہیں اور کثیر تعداد میں ہمارے خلاف منظم ہو رہے ہیں۔

573
00:46:06,859 --> 00:46:09,749
 خط میں یہ دو بنیادی باتیں تھیں۔

574
00:46:09,788 --> 00:46:12,989
حضرت ابوبکر صدیقؓ نے خط واپس بھیجا،

575
00:46:13,029 --> 00:46:16,139
آپؓ نے فرمایا؛ اللہ کے نام سے جو بڑا مہربان، نہایت رحم کرنے والا ہے۔

576
00:46:16,170 --> 00:46:20,776
مجھے آپؓ کا خط موصول ہوا اور رومیوں کے بادشاہ ہرقل کے اقدامات کا علم ہوا۔

577
00:46:20,801 --> 00:46:25,250
 اپنے قیام کے لئے انطاکیہ میں چھاؤنی قائم کرنا،

578
00:46:25,272 --> 00:46:28,429
یہ اُس کی ہار اور آپ کی جیت ہے۔

579
00:46:28,454 --> 00:46:35,582
حضرت ابو بوبکرصدیقؓ ایک ایسے رہنما تھے، جنہیں اللہ کی فتح پر مکمل بھروسہ تھا۔

580
00:46:35,615 --> 00:46:40,242
اور آپؓ اِس اعتماد کو ابھارنا چاہتے تھے۔

581
00:46:40,279 --> 00:46:48,629
آپؓ چاہتے تھے کہ یہ اعتماد صحابہ کرامؓ کے دلوں میں بھی سَرایَت کر جائے، جو اِن جنگوں کی قیادت کر رہے تھے۔

582
00:46:48,670 --> 00:46:53,086
خلیفہ حضرت ابوبکرصدیقؓ ایک انتہائی مشکل دور سے نبردآزما تھے۔

583
00:46:53,121 --> 00:46:55,662
نمبر ایک، کیونکہ یہ واحد کام نہیں تھا جو آپؓ کر رہے تھے۔

584
00:46:55,692 --> 00:47:00,016
بیک وقت، آپؓ دو الگ الگ مہمات چلا رہے تھے ، ایک عراق میں سلطنتِ فارس کے خلاف،

585
00:47:00,052 --> 00:47:03,049
اور دوسری شام میں رومیوں کے خلاف ۔

586
00:47:03,088 --> 00:47:06,609
تو، آپؓ ایک ہی وقت میں دو مختلف محاذوں سے نمٹ رہے تھے۔

587
00:47:06,650 --> 00:47:10,262
نمبر دو، آپؓ کے وسائل بہت کم تھے

588
00:47:10,299 --> 00:47:17,122
آپؓ کے پاس مزید سپاہی نہیں تھے، اور مالی معاملات کے لحاظ سے، ریاستی خزانہ دیوالیہ تھا۔

589
00:47:17,178 --> 00:47:19,803
لہٰذا حضرت ابوبکرؓ کے لیے بہت مشکل صورتحال تھی

590
00:47:19,828 --> 00:47:26,642
اور یہ ایسی صورت حال ہے جس سے صرف ایک انتہائی شجاع و بہادر لیڈر ہی نمٹ سکتا ہے

591
00:47:26,673 --> 00:47:30,339
پہلی بات، یہ جہاد ایک رضاکارانہ کام تھا، آپؓ کو لشکر بھیجنے کی ضرورت نہیں تھی

592
00:47:30,384 --> 00:47:35,776
کیونکہ فی الفور رومی مدینہ منورہ کے لیے کوئی خطرہ نہیں تھے، آپؓ انتظار بھی کر سکتے تھے

593
00:47:35,801 --> 00:47:41,381
لیکن حضرت ابوبکر صدیقؓ ایک لمحہ بھی ضائع نہیں کرنا چاہتے تھے، کہ جس میں وہ پیغامِ حق کو نہ پھیلائیں،

594
00:47:41,411 --> 00:47:45,469
  اور ہم نے گزشتہ نشست میں حضرت عمر ابن خطابؓ کو دی گئیں آپؓ کی ہدایات پڑھیں تھیں

595
00:47:45,503 --> 00:47:51,163
آپؓ حضرت عمر بن خطابؓ کو بتا رہے تھے کہ کیا آپؓ نے میرا عمل دیکھا، جس دن رسول اللہؓ کا وصال ہوا؟

596
00:47:51,203 --> 00:47:58,399
یعنی کسی بھی آفت میں اپنی زمہ داریاں نبھانے سے پیچھے نہ ہٹیں جس کے لیے اللہ تعالیٰ نے آپ کو مقرر کیا ہے۔

597
00:47:58,424 --> 00:48:03,149
حالانکہ رسول اللہؐ کا رحلت فرما جانا، اور یہ اب تک کا سب سے بڑا سانحہ تھا جو ہم پر آن پڑا تھا

598
00:48:03,184 --> 00:48:08,951
لیکن میں اب بھی خلافت کی توسیع پر کام کر رہا تھا، اور اس سانح کے تین دن بعد میں اسامہؓ کا لشکر بھیج رہا تھا

599
00:48:08,982 --> 00:48:16,506
 آپؓ حضرت عمرؓ کو ہدایت کر رہے ہیں کہ دعوتِ حق اور جہاد میں اپنا کردار ادا کیے بغیر ایک بھی لمحہ گزرنے نہ دیں۔

600
00:48:16,531 --> 00:48:27,780
حضرت ابوبکرصدیقؓ حضرت ابوعبیدہ عمرو بن جراحؓ اور دوسرے صحابہ کرامؓ کو ایک اچھی امید اور اعتماد دینا چاہتے تھے

601
00:48:27,805 --> 00:48:32,256
تو آپؓ نے حضرت ابوعبیدہؓ سے فرمایا؛ جیسا کہ آپؓ نے بتایا کہ ہرقل انطاکیہ میں ہے

602
00:48:32,291 --> 00:48:37,482
یہ آپؓ کے لیے خوشخبری ہے کہ وہ شکست کھانے والا ہے اور آپؓ غالب آئیں گے۔

603
00:48:37,538 --> 00:48:42,966
اگر وہ اِس معرکے کو اِس قدر سنجیدگی سے لے رہا ہے تو اِس کا مطلب ہے کہ وہ خوفزدہ ہے اور یہ ہمارے لیے فائدہ مند ہے۔

604
00:48:42,986 --> 00:48:46,349
تو میرے نزدیک یہ خوفزدہ ہونے والی بات نہیں ہے۔

605
00:48:46,392 --> 00:48:49,089
میری نظر میں یہ حقیقی خوشخبری ہے،

606
00:48:49,114 --> 00:48:52,962
 دیکھیں یہ صحابہ کرامؓ کی مثبتیت کو بھی ظاہر کرتی ہے۔

607
00:48:52,995 --> 00:48:56,576
کوئی بھی ایسی چیز جسے دوسرے برا شگون سمجھتے تھے،

608
00:48:56,612 --> 00:49:01,519
حضرت ابوبکر صدیقؓ اسے فعل الحسن کے طور پر دیکھتے تھے، آپؓ کے نزدیک یہ اچھی خبر تھی

609
00:49:01,544 --> 00:49:11,896
اور پھر، آپؓ نے رومیوں کا اپنی سلطنت سے مجاہدینِ اسلام  کے خلاف کثیر تعداد میں جمع ہونے کا، اور کمک اکٹھی کرنے کا جو ذکر کیا ہے،

610
00:49:11,934 --> 00:49:15,256
یہ ایسی بات ہے جو میں اور آپ پہلے سے جانتے ہیں کہ ایسا ہوگا

611
00:49:15,309 --> 00:49:18,022
حضرت ابو بکر صدیقؓ اُنہیں یہ بتانے کی کوشش کر رہے تھے، اِس میں کیا خاص خبر ہے؟

612
00:49:18,075 --> 00:49:20,362
آپؓ نے مجھے کوئی نئی بات نہیں بتائی

613
00:49:20,392 --> 00:49:21,342
ہم اور آپ،

614
00:49:21,366 --> 00:49:24,162
قد كنَّا نحن أنتم تعلمون أنَّه حاصل

615
00:49:24,316 --> 00:49:28,656
ہم اور آپ پہلے ہی جانتے تھے کہ یہ متوقع ہے اور ایسا ہی ہو گا اور پھر آپؓ نے فرمایا؛

616
00:49:28,710 --> 00:49:34,209
کوئی قوم اپنا وطن اور اپنی سلطنت سے بغیر لڑائی کے دستبردار نہیں ہو گی۔

617
00:49:34,256 --> 00:49:37,647
کیا آپؓ کو لگتا ہے کہ رومی شام کو آپؓ کے حوالے کرکے خود وہاں سے رخصت ہوجائیں گے۔؟

618
00:49:37,701 --> 00:49:41,152
یا آپؓ توقع کر رہے ہیں کہ وہ آپؓ سے ایک یا دو سپاہیوں سے لڑیں گے؟

619
00:49:41,180 --> 00:49:43,986
  سمجھ میں یہ آتا ہے کہ وہ اِس مہم میں اِس سے بھی زیادہ وسائل استعمال کریں گے۔

620
00:49:44,008 --> 00:49:47,892
 حضرت ابو بکرصدیقؓ نے فرمایا؛ آپؓ نے مجھے کوئی نئی بات نہیں بتائی،

621
00:49:47,937 --> 00:49:51,339
آپؓ کو پہلے ہی اچھی طرح معلوم ہونا چاہیے تھا کہ وہ آپؓ کو مات دینے کی ہرممکن کوشش کریں گے۔

622
00:49:51,373 --> 00:49:56,453
کیونکہ لوگ اپنے جاگیر سے دستبردار نہیں ہوتے، اور بغیر لڑے وہ اپنی سلطنت کو نہیں چھوڑتے،

623
00:49:56,480 --> 00:49:58,626
ایسا ہونا متوقع ہے،

624
00:49:58,651 --> 00:50:03,656
اور یہ وہ قیمت ہے جو آپ کو جہاد اور دعوت فی سبیل اللہ کے لیے ادا کرنی پڑے گی

625
00:50:03,682 --> 00:50:05,672
 پھر حضرت ابو بکرؓ آپؓ سے فرماتے ہیں؛

626
00:50:05,702 --> 00:50:13,489
اور آپؓ جانتے ہیں کہ دشمن پر حملہ کرنے والے وہ مرد ہیں جنھیں موت سے اِس قدر محبت ہے جس قدر دشمن زندگی سے پیار کرتے ہیں

627
00:50:13,528 --> 00:50:17,962
اور وہ جہاد کو کسی دوشیزہ اور مال سے زیادہ پسند کرتے ہیں۔

628
00:50:18,005 --> 00:50:21,232
اُن میں سے ایک آدمی ہزار دشمنوں سے زیادہ طاقتور ہے۔

629
00:50:21,257 --> 00:50:23,696
لہذا آپؓ اپنے سپاہیوں کے ساتھ اپنے دشمن کا مقابلہ کریں۔

630
00:50:23,732 --> 00:50:28,376
اور جو مسلمان اِس وقت آپؓ کے ساتھ نہیں ہیں اُن کی کمی محسوس نہ کریں، کیونکہ اللہ آپ کے ساتھ ہے۔

631
00:50:28,413 --> 00:50:31,156
آپؓ حضرت ابوعبیدہؓ کو بتا رہے ہیں کہ مجھ سے کوئی کمک نہ مانگیں۔

632
00:50:31,181 --> 00:50:36,029
کسی مسلمان سے مدد کی امید نہ رکھیں جو آپؓ کے ساتھ نہیں ہے، کیونکہ اللہ آپ کے ساتھ ہے۔

633
00:50:36,072 --> 00:50:39,902
ایسا کچھ  ہونے کا(کمک ملنے کا) انتظار نہ کریں۔

634
00:50:39,927 --> 00:50:43,469
تو، آپؓ حضرت ابوعبیدہؓ  کے دل میں ایمان کو پختہ کر رہے تھے۔

635
00:50:43,504 --> 00:50:47,002
کہ اللہ آپؓ کے ساتھ ہے، اللہ کے سوا آپؓ کو کسی اور کی ضرورت نہیں

636
00:50:47,042 --> 00:50:49,429
لیکن، اِس کے بعد آپ پلٹے اور فرمایا؛

637
00:50:49,471 --> 00:50:54,349
بہر حال، میں آپؓ کو اُس وقت تک مدد(کمک) دوں گا جب تک آپؓ مطمئن نہ ہو جائیں۔

638
00:50:54,374 --> 00:50:57,922
کوئی توقع نہ کریں، ذیادہ امید نہ رکھیں، صرف اللہ پر بھروسہ رکھیں۔

639
00:50:57,960 --> 00:51:02,882
بہرحال، میں آپؓ کو تب تک کمک بھیجوں گا جب تک آپؓ کو خوش نہ کر دوں۔

640
00:51:02,928 --> 00:51:05,725
ظاہر ہے کہ جب حضرت ابوعبيدہؓ ایسا خط مجاہدینِ اسلام کے سامنے پڑھیں گے،

641
00:51:05,749 --> 00:51:08,816
یہ مجاہدین کے لئے خوش کن خبر ہوگی ، اِس خبر سے اُن کے حوصلے بلند کیے ہوںگے۔

642
00:51:08,850 --> 00:51:12,749
 تعداد کوئی مسئلہ نہیں ہے، ہم میں سے ایک، ایک ہزار کے برابر ہے۔

643
00:51:12,795 --> 00:51:14,716
ہراقل انطاکیہ میں ہے،

644
00:51:14,753 --> 00:51:19,389
ہمیں اِسے اچھی خبر کے طور پر لینا چاہئے کہ یہ اُس کی سلطنت کا خاتمہ ہے۔

645
00:51:19,423 --> 00:51:26,202
اس سے آپ کو یہ بھی معلوم ہوتا ہے کہ صحابہ کرامؓ خاص کر رومیوں سے یہ توقع نہیں رکھتے تھے،

646
00:51:26,227 --> 00:51:32,726
صحابہ کرامؓ، جانتے تھے کہ رومی بغیر لڑے، اپنی سرزمین ہمارے حوالے نہیں کریں گے،

647
00:51:32,756 --> 00:51:34,595
 اور عبدالرحمن بن عوفؓ نے اپنی تجاویز پیش کرتے ہوئے فرمایا تھا

648
00:51:34,620 --> 00:51:37,049
حدٌ حديد ورُكنٌ الشديد

649
00:51:37,095 --> 00:51:41,219
صحابہ کرامؓ زندگی کے بارے میں بہت عملی نظریہ رکھتے تھے

650
00:51:41,243 --> 00:51:45,469
اور لوگوں تک کیسے اسلام کی دعوت پہنچائی جائے

651
00:51:45,511 --> 00:51:49,869
اب چاروں لشکر مَخمَصے میں تھے، دشمن کی تعداد کہیں زیادہ تھی،

652
00:51:49,909 --> 00:51:53,469
اور اگرچہ خلیفتہ المسلمینؓ صحابہؓ کو یہ حوصلہ دے رہے تھے،

653
00:51:53,504 --> 00:51:59,682
اور آپؓ نے حضرت یزید بن ابی سفیانؓ کو ایک خط بھیجا، مثال کے طور پر ہم ِاس خط کا مختصر جائزہ لیتے ہیں۔

654
00:51:59,707 --> 00:52:08,036
آپؓ نے فرمایا؛ الحمدللہ ! اللہ نے دشمن کے دلوں میں خوف ڈال کر ہمیں رسول اللہؐ کے زمانے میں فتح دی،

655
00:52:08,061 --> 00:52:10,302
اور اللہ نے فرشتوں کے ذریعے ہماری مدد کی

656
00:52:10,332 --> 00:52:16,456
اور وہ اللہ جس نے فرشتوں کے ذریعے ہماری مدد کی، اور دشمن کے دلوں میں خوف پیدا کرنے میں ہماری مدد کی

657
00:52:16,486 --> 00:52:19,316
وہ آج بھی ہمارا رب ہے۔

658
00:52:19,341 --> 00:52:20,622
اور ہم اُسی ایک مقصد کے لیے لڑ رہے ہیں۔

659
00:52:20,647 --> 00:52:27,006
اللہ جس نے کل ہماری مدد کی وہ آج بھی ہمارا رب ہے اور وہ آج بھی اور کل بھی ہماری مدد کرے گا۔

660
00:52:27,036 --> 00:52:30,136
آپؓ حضرت یزیدؓ کو اُن حالات کے بارے میں بتا رہے تھے، جن سے آپؓ ناواقف تھے۔

661
00:52:30,177 --> 00:52:36,882
حضرت یزید بن ابی سفیانؓ بعد میں مشرف بہ اسلام ہوئے، آپؓ نے مسلمانوں کی طرف سے غزوہ بدر میں شرکت نہیں کی تھی،

662
00:52:36,907 --> 00:52:41,119
تو حضرت ابو بکرصدیقؓ ،آپؓ کو بتا رہے تھے کہ اُن دنوں ہماری تعداد بہت کم تھی،

663
00:52:41,148 --> 00:52:43,296
لیکن اللہ عَزَّوَجَلْ نے پھر بھی ہمیں فتح عطا فرمائی ۔

664
00:52:43,321 --> 00:52:46,732
لہذا، جس تعداد کا آپؓ مجھ سے ذکر کر رہے ہیں اسکی فکر نہ کریں۔

665
00:52:46,757 --> 00:52:49,736
پھر فرمایا؛ اور وہ لوگ جو اس بات کی گواہی دیتے ہیں کہ اللہ ایک ہے،

666
00:52:49,767 --> 00:52:54,156
وہ اُن لوگوں کی طرح نہیں ہیں جو اللہ کے سوا دوسرے معبودوں کو شریک ٹھہراتے ہیں۔

667
00:52:54,199 --> 00:52:58,176
اور پھر فرمایا کہ ایک چھوٹا گروہ بڑے گروہ پر فتح حاصل کر سکتا ہے،

668
00:52:58,230 --> 00:53:01,569
اگر اُن کے پاس اللہ عَزَّوَجَلْ کا تقویٰ ہے اور پھر آخر میں یہ بھی فرمایا،

669
00:53:01,602 --> 00:53:04,322
اور میں کچھ کمک کے ساتھ آپؓ کی مدد کروں گا۔

670
00:53:04,366 --> 00:53:07,232
اور پھر آپؓ نے حضرت عمرو بن العاصؓ کے خط کا جواب دیا۔

671
00:53:07,263 --> 00:53:11,899
آپؓ نے لکھا؛ آپؓ مجھے بتا رہے ہیں کہ رومی آپؓ کے خلاف اکھٹے ہوگئے ہیں اور کثیر تعداد میں فوجیں مجتمع کرلی ہیں۔

672
00:53:11,935 --> 00:53:17,642
لیکن دورِ رسالتؐ میں اللہ تعالی نے ہمیں تعداد کے ذریعے کبھی فتح نہیں دی۔

673
00:53:17,667 --> 00:53:21,576
ہم رسول اللہؐ کے ہمراہ جنگ کرتے تھے اور ہمارے پاس صرف دو گھوڑے ہوتے تھے۔

674
00:53:21,609 --> 00:53:25,176
اور ہم اپنے اونٹوں پر باری باری سواری کرتے تھے۔

675
00:53:25,219 --> 00:53:27,506
احد کی جنگ میں ہمارے پاس صرف ایک گھوڑا تھا۔

676
00:53:27,531 --> 00:53:32,576
رسول اللہؐ اِس گھوڑے  پرسوار ہوتے اور پھر ہم میں سے کسی کو دے دیتے

677
00:53:32,601 --> 00:53:40,469
اور پھر آپؓ نےحضرت عمرو بن العاصؓ سے فرمایا کہ آپؓ اور آپؓ کے سپاہی گناہوں سے بچیں۔

678
00:53:40,494 --> 00:53:42,508
تو یہ خلیفہ حضرت ابوبکر صدیقؓ کی نصیحتیں تھیں۔

679
00:53:42,533 --> 00:53:45,249
اب، کیا منصوبہ تھا؟

680
00:53:45,281 --> 00:53:48,616
اس صورتحال سے نمٹنے کے لیے خلیفہ حضرت ابو بکر صدیقؓ کا منصوبہ کیا تھا ؟

681
00:53:48,641 --> 00:53:50,056
اب چیزیں مختلف تھیں۔

682
00:53:50,081 --> 00:53:54,896
 مجاہدین کو ایک بڑے حریف کا سامنا تھا

683
00:53:54,921 --> 00:54:05,346
اگرچہ حضرت ابوبکرصدیقؓ نے امرائے فوج کو ہدایت کی کہ حَرب گاہ میں اللہ کے سوا کسی سے مدد نہ لیں، اور کُمَک کی توقع نہ کریں

684
00:54:05,387 --> 00:54:09,682
آپؓ نے محسوس کیا کہ لشکرِ اسلام کو ابھی بھی کُمک کی ضرورت ہے۔

685
00:54:09,724 --> 00:54:16,116
حضرت ابوبکرصدیقؓ کو اِس ضرورت کا احساس تھا، لیکن آپؓ  کے پاس اور سپاہی نہیں تھے۔

686
00:54:16,141 --> 00:54:25,322
آپؓ نے سارے یمن کو کھنگھال ڈالا اور قبائلِ حمیر، کندہ اور حضرموت کے جنگجوؤں کو مدینہ طلب کرلیا اور وہ سب محاذ پر روانہ ہو چکے تھے

687
00:54:25,361 --> 00:54:28,162
اب آپؓ اور کہاں سے سپاہی لا سکتے تھے؟

688
00:54:28,204 --> 00:54:31,391
اِس مسئلے کا حل صرف اِس صورت میں نکل سکتا تھا کہ

689
00:54:31,417 --> 00:54:40,189
آپؓ ،حضرت خالد بن ولیدؓ سے کہیں کہ، عراق میں فوج کو تقسیم کریں اور شام میں مسلمانوں کی مدد کے لیے فورا روانہ ہوں،

690
00:54:40,237 --> 00:54:42,769
آپؓ اس وقت فوری طور پر یہی کام  کر سکتے تھے۔

691
00:54:42,794 --> 00:54:45,349
بس یہی ایک ذریعہ آپؓ کے پاس باقی بچا تھا۔

692
00:54:45,401 --> 00:54:51,019
ظاہر ہے کہ ایسا کرنے سے آپؓ عراق کے مسلمانوں کو کمزور کر دیں گے،

693
00:54:51,065 --> 00:54:53,589
کیونکہ آپؓ صرف نصف فوج کو عراق میں چھوڑیں گے۔

694
00:54:53,620 --> 00:54:57,219
لیکن آپؓ نے فیصلہ کیا کہ یہ کڑوا گھونٹ پینا ہی پڑے گا

695
00:54:57,242 --> 00:55:00,822
اور آپؓ چاہتے تھے کہ عراقی مجاہدین شام جائیں،

696
00:55:00,852 --> 00:55:05,809
شام میں اپنا فریضہ ادا کریں، اور فوری طور پر عراق واپس چلے جائیں، جہاں وہ تعینات کیے گئے تھے۔

697
00:55:05,851 --> 00:55:13,362
اور ہم نے گزشتہ نشست میں حضرت خالد بن ولیدؓ اور المثنیٰ بن حارثہؓ کے درمیان فوج کی اِس تقسیم کے بارے میں بات کی تھی۔

698
00:55:13,401 --> 00:55:18,362
لیکن ہم نے اس بارے میں بات نہیں کی کہ حضرت خالد بن ولیدؓ عراق سے شام  کیسے پہنچے۔

699
00:55:18,387 --> 00:55:23,289
حضرت خالد بن ولیدؓ  کو یہ خط خلیفہ حضرت ابو بکر صدیقؓ کی طرف سے ملا۔

700
00:55:23,314 --> 00:55:28,482
آپؓ نے حضرت خالد بن ولیدؓ سے فرمایا کہ، فورا مسلمانوں کی مدد کے لیے شام کی طرف روانہ ہو جائیں۔

701
00:55:28,528 --> 00:55:30,568
اور یہ حضرت خالد بن ولیدؓ کے حج کے بعد کا واقعہ ہے۔

702
00:55:30,593 --> 00:55:34,255
جس میں خلیفہؓ نے حضرت خالد ؓ کو حج کرنے کی وجہ سے سرزنش کی اور فرمایا کہ آئندہ کبھی ایسی غلطی نہ کرنا،

703
00:55:34,285 --> 00:55:39,389
اور پھر فرمایا؛ کیونکہ آپؓ کی طرح مسلمانوں کو آفت سے کوئی چھٹکارا نہیں دے سکتا

704
00:55:39,414 --> 00:55:42,722
اور کوئی بھی آپؓ کی طرح دشمن کو توڑ نہیں سکتا ،جس طرح آپؓ کر سکتے ہیں

705
00:55:42,747 --> 00:55:45,456
اس لیے دوبارہ ایسا کچھ نہ کرنا۔

706
00:55:45,481 --> 00:55:49,896
حضرت خالد بن ولیدؓ کو یہ خط موصول ہوا ،آپؓ نے خط میں حالات کی سنگینی کو محسوس کیا۔

707
00:55:49,921 --> 00:55:52,336
آپؓ کو فوراً شام پہنچنا چاہیے۔

708
00:55:52,378 --> 00:55:58,489
کیونکہ یہ چاروں رومی لشکر انتہائی پھرتی سے مسلمانوں کی طرف پیش قدمی کر رہے تھے۔

709
00:55:58,514 --> 00:56:02,379
اور اگر آپؓ فوری نہ پہنچے تو بہت دیر ہو جائے گی، لیکن مسئلہ یہ تھا کہ،

710
00:56:02,404 --> 00:56:09,449
وہ تمام راستے جو عراق کو شام سے ملاتے تھے رومی فوجی چھاؤنیوں سے متصل تھے

711
00:56:09,474 --> 00:56:15,622
لہٰذا اگر آپؓ اِن مخصوص راستوں کو اختیار کریں گے تو آپؓ کو  رومی محافظوں سے لڑنا ہوگا،

712
00:56:15,647 --> 00:56:22,442
اور یہ آپؓ کے لیے رکاوٹ بنیں گے اور اِس طرح شام میں مسلمانوں کی مدد کرنے میں تاخیر ہو جائے گی۔

713
00:56:22,467 --> 00:56:23,941
اور آپؓ کا فوری طور پر وہاں پہنچنا ناگزیر تھا،

714
00:56:23,971 --> 00:56:31,114
چنانچہ آپؓ نے تمام صحرا نورد اکٹھے کیے، کیونکہ صحابہ کرامؓ اِس علاقے کو نہیں جانتے تھے

715
00:56:31,139 --> 00:56:35,249
لہذا یہ مقامی صحرا نورد تھے، آپؓ نے اُن سب کو جمع کیا اور فرمایا؛

716
00:56:35,274 --> 00:56:40,109
میں چاہتا ہوں کہ، آپ مجھے تمام رومی چوکیوں سے بچا کر شام پہنچا دیں

717
00:56:40,134 --> 00:56:44,099
اور مجھے کسی بھی مزاحمت کا سامنا کیے بغیر، شام کے وسط میں پہنچائیں

718
00:56:44,124 --> 00:56:46,062
انہوں نے آپؓ سے کہا؛ یہ ناممکن ہے۔

719
00:56:46,087 --> 00:56:48,709
یہی مخصوص راستے ہیں۔

720
00:56:48,734 --> 00:56:50,807
اور ہم آپؓ کو اِنہی راستوں کے ذریعے شام پہنچا سکتے ہیں،

721
00:56:50,837 --> 00:56:52,601
آپؓ نے فرمایا:  آپ لوگوں کو کچھ کرنا ہوگا،

722
00:56:52,626 --> 00:56:53,854
 کوئی راستہ تلاش کریں۔

723
00:56:53,879 --> 00:56:56,182
انہوں نے کہا؛ اِس کے علاوہ کوئی راستہ نہیں ہے۔

724
00:56:56,207 --> 00:56:59,496
کیونکہ واحد راستہ جو صحرا کو پار کرتا ہے،

725
00:56:59,521 --> 00:57:04,409
وہ ایک ایسا راستہ ہے جسے پہلے کبھی کسی فوج نے عبور نہیں کیا ۔

726
00:57:04,434 --> 00:57:10,629
اور یہ ایک ایسا راستہ ہے کہ اگر اکیلا مسافر بھی اختیار کرے تو اُسے بھی اپنی جان کا خوف رہتا ہے۔

727
00:57:10,654 --> 00:57:12,917
 کبھی کبھی اکیلا مسافر ایسا کرنے میں کامیاب ہو جاتا ہے

728
00:57:12,950 --> 00:57:17,456
 لیکن ایسا کوئی خاص آدمی ہی کر پاتا ہے اور یہ عمل خطرے سے خالی نہیں

729
00:57:17,481 --> 00:57:26,416
 لیکن ہتھیاروں اور اسلحے سے لیس پوری فوج کے لیے، یہ ایک مشکل اور ناممکن کام ہے اور آج تک کسی نے ایسا نہیں کیا

730
00:57:26,441 --> 00:57:28,834
رومی یہاں صدیوں سے رہ رہے ہیں اور اِنہوں نے کبھی ایسا نہیں کیا۔

731
00:57:28,859 --> 00:57:31,585
فارسی اِس سرزمین پر کچھ عرصے سے مقیم ہیں اِنہوں نے کبھی ایسا قدم نہیں اُٹھایا

732
00:57:31,615 --> 00:57:32,825
اس سے پہلے کسی نے ایسا نہیں کیا

733
00:57:32,850 --> 00:57:37,469
حضرت خالد بن ولیدؓ نے کہا؛ بس یہی ایک طریقہ ہے

734
00:57:37,499 --> 00:57:39,202
مجھے بتاؤ کہ یہ کیسے ہو گا؟

735
00:57:39,227 --> 00:57:42,740
کوئی بھی صحرا نورد اس ذمہ داری کو اٹھانے کے لیے تیار نہیں تھا۔

736
00:57:42,765 --> 00:57:46,586
انہوں نے کہا؛ یہ مسلمانوں کے لیے ایک بہت بڑی آفت، ہلاکت ثابت ہو گا

737
00:57:46,611 --> 00:57:48,239
مسلمانوں کا خاتمہ ہو جائے گا۔

738
00:57:48,269 --> 00:57:52,089
سوائے ایک صحرا نورد حضرت رافعہ بن عمیرؓ کے،

739
00:57:52,114 --> 00:57:54,736
انہوںؓ نے کہا: میں آپؓ کی مدد کر سکتا ہوں۔

740
00:57:54,761 --> 00:57:58,916
اب مسلمان ،حضرت خالد بن ولیدؓ کو اِس معاملے پر مختلف آراء دینے لگے،

741
00:57:58,941 --> 00:58:04,936
کہ یہ پوری فوج  کے لیے آفت کا سبب بن سکتا ہے

742
00:58:04,961 --> 00:58:07,729
کہ مسلم نصف فوج عراقی صحرا میں نست و نابود ہو گئی

743
00:58:07,754 --> 00:58:11,189
صحرا نوارد، حضرت خالد بن ولیدؓ کو اپنی اپنی آراء پیش کر چکے تھے

744
00:58:11,214 --> 00:58:13,179
انہوں نے آپؓ سے کہا: آپؓ ایسا نہیں کر سکتے۔

745
00:58:13,214 --> 00:58:15,676
حضرت خالد بن ولیدؓ نے یہ کہتے ہوئے جواب دیا؛

746
00:58:15,701 --> 00:58:22,936
ان المسلم ينبغي اَلَا يكترس بشيء يقى فيه مع ماعونت الله له

747
00:58:23,165 --> 00:58:32,786
حضرت خالد نے فرمایا؛ مسلمان کو کسی چیز کی پرواہ نہیں کرنی چاہیے، اگر اُس کے ساتھ اللہ کی مدد و نصرت ہے،

748
00:58:32,811 --> 00:58:35,402
حضرت خالد بن ولیدؓ یہ خطرہ مول لینے کو تیار تھے۔

749
00:58:35,427 --> 00:58:40,807
 آپؓ شجاعت و شہامت اور عزم و ہمت کا پیکر تھے ،آپؓ یہ خطرہ مول لینے کو تیار تھے۔

750
00:58:40,832 --> 00:58:50,202
 اور آپؓ اپنے صحرا نوارد اور سپاہیوں  سے کہہ رہے ہیں کہ ہمیں پریشان نہیں ہونا چاہئے، ہمیں کسی چیز کی پرواہ نہیں کرنی چاہئے،

751
00:58:50,227 --> 00:58:52,622
اگر اللہ عَزَّوَجَلْ ہمارے ساتھ ہے۔

752
00:58:52,647 --> 00:58:55,802
مجھے بتائیں کہ ہم کیا کر سکتے ہیں؟ اور ہم کریں گے۔

753
00:58:55,827 --> 00:59:01,296
حضرت رافعہ بن عمیرؓ کھڑے ہوئے اور کہنے لگے؛ اے خالد ابن ولید

754
00:59:01,321 --> 00:59:04,746
اگر آپؓ ایسا کرنے پر اصرار کرتے ہیں تو ہم یہی کریں گے۔

755
00:59:04,771 --> 00:59:10,536
میں چاہتا ہوں کہ آپؓ وہ بیس طاقتور اونٹ مہیا کریں جو آپؓ کے لشکر میں موجود ہیں۔

756
00:59:10,561 --> 00:59:11,669
تو آپؓ نے وہ اونٹ رافعؓ کے حوالے کردیے،

757
00:59:11,699 --> 00:59:14,092
آپؓ نے اُن اُنٹوں کو پانی سے محروم رکھا،

758
00:59:14,117 --> 00:59:17,466
پھر جب وہ بہت پیاسے تھے تو آپؓ نے انہیں بہت سا پانی پلایا۔

759
00:59:17,491 --> 00:59:24,696
اور پھر اس نے اونٹوں کے ہونٹ اور منہ پر کپڑا باندھ دیا اور انہیں پیشاب کرنے سے بھی روک دیا۔

760
00:59:24,721 --> 00:59:29,562
اور آپؓ نے اس بات کو یقینی بنایا کہ ہر سپاہی کے پاس سواری موجود ہے،

761
00:59:29,587 --> 00:59:36,009
اور رافع نے سپاہیوں سے کہا کہ پانچ دن کا پانی بھر لیں، اور اللہ کے نام سے سفر کا آغاز کریں۔

762
00:59:36,034 --> 00:59:40,436
اور انہوں نے قراقر سے سفر کا آغاز کیا اور اُن کی منزل سؤیٰ تھی۔

763
00:59:40,462 --> 00:59:46,646
پانچ دن کا یہ سفر، جس میں میلوں تک پانی کا کوئی وجود نہیں تھا اور نہ ہی راستے میں کوئی آبادی تھی

764
00:59:46,671 --> 00:59:50,551
یہ علاقہ بلکل بنجر اور ناقابل عبور صحرا تھا

765
00:59:50,576 --> 00:59:52,199
 پانچ دن تک آپ کسی ذی روح کو وہاں نہیں دیکھ سکتے۔

766
00:59:52,229 --> 00:59:54,722
اگر آپ قراقر سے سؤیٰ تک پہنچنے میں کامیاب ہو جاتے ہیں

767
00:59:54,761 --> 00:59:58,389
پھر اِس کے بعد وہاں آپ کو آبادی ملے گی

768
00:59:58,414 --> 01:00:04,672
لیکن آپ نے اس پانچ دن کے سفر کو اضافی پانی اور خوراک کے بغیر طے کرنا ہو گا،

769
01:00:04,699 --> 01:00:05,839
اُنہوں نے سفر کا آغاز کیا

770
01:00:05,869 --> 01:00:14,762
حضرت خالد بن ولیدؓ نے اِس سفر کو ایسے ترتیب دیا کہ لشکر، رات اور صبح کے وقت دگنا فاصلہ طے کرنے کی انتھک کوشش کریں گے

771
01:00:14,787 --> 01:00:21,722
چنانچہ اسلامی لشکر اِس ناہموار صحرائی راستے پر رافع بن عمیرؓ کی رہنمائی میں روانہ ہوا

772
01:00:21,747 --> 01:00:28,296
پانچ دن کے بعد ذخیرہ شدہ پانی ختم ہو گیا تو وہ بیس اونٹ جِنہیں ڈھیر پانی پلایا گیا تھا

773
01:00:28,321 --> 01:00:33,019
انہوں نے اونٹوں کو ذبح کرنے کے بعد اُن پیٹ کا جمع شدہ پانی نکال کر گھوڑوں کو دیا،

774
01:00:33,044 --> 01:00:38,189
تاکہ گھوڑے اونٹوں کے پیٹ میں جمع شدہ پانی سے پیاس بجھا سکیں۔

775
01:00:38,214 --> 01:00:41,692
اور پھر مجاہدین نے اپنی پکھالوں سے پانی پیا۔

776
01:00:41,717 --> 01:00:47,449
پانچ دن کے بعد حضرت رافعؓ نے مجاہدین سے کہا کہ یہاں آپ کو پانی کے چشمے ملیں گے، اُن میں کچھ پانی ہوگا۔

777
01:00:47,474 --> 01:00:52,287
لیکن آپؓ پانی کے ذخائر نہیں دیکھ سکتے تھے، کیونکہ آپؓ آنکھوں کی بیماری میں مبتلا ہو چکے تھے

778
01:00:52,317 --> 01:00:54,529
 جس کی وجہ سے آپؓ عارضی طور پر کچھ دیکھ نہیں سکتے تھے

779
01:00:54,554 --> 01:00:57,949
 اب پانچ دن گزر چکے تھے، ہمارے پاس کوئی پانی نہیں بچا تھا،

780
01:00:57,974 --> 01:00:59,976
ہمیں بتائیں کہ پانی کہاں ہے؟

781
01:01:00,001 --> 01:01:02,116
حضرت رافعؓ دیکھ نہیں سکتے تھے۔

782
01:01:02,141 --> 01:01:04,932
سپاہیوں نے اصرار کیا کہ آپؓ کو ہمارے لیے کچھ کرنا ہوگا۔

783
01:01:04,962 --> 01:01:09,302
آپؓ نے کہا؛ اچھا، آپ فلاں درخت کو تلاش کریں۔

784
01:01:09,327 --> 01:01:11,516
اور آپؓ نے انہیں اُس درخت کی خاص نوع بتائی۔

785
01:01:11,541 --> 01:01:15,216
سپاہی اُس درخت کی تلاش میں نکلے لیکن وہ نہیں ملا، حضرت رافع نے کہا، دوبارہ تلاش کریں۔

786
01:01:15,241 --> 01:01:19,976
ایک بار پھر سپاہی درخت کی تلاش میں گئے، اب کی بار وہ درخت انہیں مل گیا لیکن وہ درخت پہلے سے کٹا ہوا تھا۔

787
01:01:20,001 --> 01:01:21,549
چنانچہ، اُنہیں صرف اُس درخت کا تنا ہی ملا۔

788
01:01:21,574 --> 01:01:24,169
آپؓ نے کہا:  اِس درخت کے پاس کھدائی کریں۔

789
01:01:24,194 --> 01:01:30,929
اور کھدائی کے دوران اُنہیں وہاں پانی کا ایک چشمہ مل گیا۔

790
01:01:30,970 --> 01:01:38,896
آپؓ نے سپاہیوں کو بتایا؛ میں یہاں صرف ایک بار، تیس سال پہلے اپنے والد کے ساتھ آیا تھا

791
01:01:38,930 --> 01:01:41,879
 لہذا آپؓ نے اِس جگہ اور درخت کو یاد رکھا اور آپؓ کو یہ بھی یاد تھا کہ یہاں پانی ہے۔

792
01:01:41,904 --> 01:01:45,011
 لیکن آپؓ تیس سال کے عرصے میں یہاں دوبارہ کبھی نہ آ سکے۔

793
01:01:45,036 --> 01:01:49,116
لیکن باساختہ آپؓ کو خیال آیا، اور آپؓ اندازہ لگانے میں کامیاب ہوئے کہ پانی کہاں موجود ہو گا۔

794
01:01:49,149 --> 01:01:51,533
اگرچہ آپؓ عارضی طور پر بینائی کھو چکے تھے،

795
01:01:51,558 --> 01:01:55,431
 کبھی کبھی صحرا میں سورج کی حدت کی وجہ سے ایسا ہو سکتا ہے، اور  اِس سے عارضی طور پر آپ کی بینائی بھی جا سکتی ہے،

796
01:01:55,442 --> 01:01:59,637
 کیونکہ سورج کی شعائیں ریت سے منعکس ہونے کے بعد آنکھوں کو چندھیا دیتی ہیں

797
01:01:59,661 --> 01:02:05,061
چنانچہ سب منزل تک پہنچ گئے اور اس واقع کے متعلق کچھ اشعار کہے گئے،

798
01:02:05,099 --> 01:02:07,854
لِلَّهِ دَرُّ رافِعٍ أَنّى اِهتَدى

799
01:02:08,097 --> 01:02:10,189
 فَوَّزَ مِن قَراقِرٍ إِلى سُوى

800
01:02:10,456 --> 01:02:12,692
خِمْسًا إِذَا سَارَ بِهِ الْجِبْسُ بَكَى

801
01:02:12,917 --> 01:02:15,358
ما سَارها من قبله إنسٌ يُرى

802
01:02:16,171 --> 01:02:19,956
اللہ تعالیٰ حضرت رافعؓ کو جزائے خیر دے، آپؓ نے کیسے ہماری رہنمائی کی۔

803
01:02:19,993 --> 01:02:23,619
قراقر سے سویٰ تک کے سفر میں

804
01:02:23,672 --> 01:02:27,542
پانچ دن اگر کوئی فوج اِس دشوار گزار راستے سے گزرے گی تو وہ چِلّا اُٹھے گی۔

805
01:02:27,585 --> 01:02:29,946
آپؓ سے پہلے کسی نے ایسا کرنے کا نہیں سوچا

806
01:02:29,978 --> 01:02:34,802
تو ایسا پہلی بار ہوا تھا۔

807
01:02:34,839 --> 01:02:39,896
حضرت خالد بن ولیدؓ اب شام کے وسط میں بوجود تھے

808
01:02:39,959 --> 01:02:42,999
یہ رومیوں کے لیے حیران کُن بات تھی۔

809
01:02:43,028 --> 01:02:45,262
آپؓ اِس قدر تیز رفتاری سے یہاں کیسے پہنچ سکتے ہیں؟

810
01:02:45,287 --> 01:02:47,582
آپؓ کسی کے مشاہدے میں کیوں نہ آئے

811
01:02:47,622 --> 01:02:50,842
ہماری فوجی چھاؤنیوں کے ساتھ کیا معاملات درپیش ہوئے؟

812
01:02:50,866 --> 01:02:52,662
رومی یہاں صدیوں سے موجود ہیں۔

813
01:02:52,687 --> 01:02:56,056
وہ تمام روایتی راستے جانتے ہیں اور اُن رستوں پر فوجی چھاؤنیاں ہیں۔

814
01:02:56,100 --> 01:03:00,399
اور اب اچانک رومی، حضرت خالد بن ولیدؓ کو اپنے لشکر کے ساتھ، اپنے درمیان پاتے ہیں،

815
01:03:00,423 --> 01:03:04,216
اور وہ حضرت خالد بن ولیدؓ  کی شہرت کے بارے میں پہلے ہی سن چکے تھے۔

816
01:03:04,249 --> 01:03:06,089
تو، رومیوں کے لیے یہ ایک معجزہ تھا۔

817
01:03:06,120 --> 01:03:09,416
حضرت خالد بن ولیدؓ جن کے بارے میں وہ بہت سی چہ مگوئیاں سنتے چلے آ رہے تھے ۔

818
01:03:09,452 --> 01:03:11,529
اور اب اُن کہانیوں کی تصدیق ہوگئی تھی۔

819
01:03:11,579 --> 01:03:15,709
حضرت خالد بن ولیدؓ ہماری سرزمین کے وسط میں کہیں سے اترے ہیں،

820
01:03:15,746 --> 01:03:18,099
 انتہائی پھرتی اور اچانک کسی کی نظروں میں آئے بغیر۔

821
01:03:18,151 --> 01:03:21,042
اور اِس بات نے اُن کے دلوں میں خوف پیدا کر دیا ۔

822
01:03:21,090 --> 01:03:22,789
حضرت خالد بن ولیدؓ شام میں داخل ہو چکے تھے،

823
01:03:22,836 --> 01:03:25,989
اور اب آپؓ مسلمانوں کی مدد کرنے کے لیے تیار تھے۔

824
01:03:26,030 --> 01:03:29,446
منصوبہ یہ تھا کہ ہم رومیوں سے الگ الگ نہیں لڑیں

825
01:03:29,476 --> 01:03:33,089
چار لشکروں کو شکست دینا آسان ہوتا ہے بنسبت ایک کے۔

826
01:03:33,128 --> 01:03:35,896
لہذا آپؓ نے لشکرِ اسلام کو حکم دیا کہ کہ سب اکٹھے ہو جائیں،

827
01:03:35,939 --> 01:03:39,802
آپؓ نے فرمایا جب آپکی تعداد کم ہو تو دشمن سے الگ الگ نہ لڑو۔

828
01:03:39,844 --> 01:03:42,442
اپنے لشکر ایک اکٹھے کریں

829
01:03:42,481 --> 01:03:48,442
چنانچہ تینوں لشکروں سے کہا گیا کہ وہ اُن تمام علاقوں سے پیچھے ہٹ جائیں جن پر وہ قابض ہو چکے تھے۔

830
01:03:48,490 --> 01:03:53,059
دمشق اور حمص کو چھوڑ دیں اور سب یرموک میں جمع ہوجائیں،

831
01:03:53,114 --> 01:03:54,642
جو کہ موجودہ اردن  ہے۔

832
01:03:54,677 --> 01:03:59,082
لہذا یہ جنگ کا میدان متعین ہوا جہاں مجاہدین کا مقابلہ، رومی فوجوں سے ہونا تھا

833
01:03:59,119 --> 01:04:01,442
تین لشکر وہاں سے نکلنے میں کامیاب ہوگئے

834
01:04:01,472 --> 01:04:06,249
حضرت یزیدؓ کا لشکر، حضرت شرحبیل بن حسنہؓ کا لشکر، اور حضرت ابوعبیدہ بن جراحؓ  کا لشکر۔

835
01:04:06,300 --> 01:04:11,242
حضرت عمرو بن العاصؓ فلسطين میں پھنس گئے۔

836
01:04:11,282 --> 01:04:15,159
کیونکہ آپؓ کے لشکر اور رومی فوج کے درمیان فاصلہ بہت کم تھا،

837
01:04:15,224 --> 01:04:19,562
آپؓ بغیر حملہ سہے رومیوں کی طرف پیٹھ نہیں کر سکتے تھے

838
01:04:19,603 --> 01:04:22,562
اس لیے آپؓ کو دھیرے دھیرے پسپا ہونا پڑا۔

839
01:04:22,601 --> 01:04:25,542
حضرت خالد بن بن ولیدؓ  کے پاس دو راستے تھے۔

840
01:04:25,574 --> 01:04:30,056
یا تو حضرت عمرو بن العاصؓ سے کہیں کہ آپؓ  مکمل پسپا ہو جائیں اور اِس کے کچھ برے نتائج بھگتیں،

841
01:04:30,103 --> 01:04:34,422
یا آپؓ خود وہاں جا کر حضرت عمرو بن العاصؓ کے دستِ بازو بن جائیں،

842
01:04:34,466 --> 01:04:40,109
اور رومیوں کی سب سے بڑی فوج کو پسپسا کر دیں جس کی تعداد نوے ہزار تھی

843
01:04:40,155 --> 01:04:44,309
حضرت خالد بن ولیدؓ نے آخری راستہ اپنایا، لہذا آپؓ فلسطین کی طرف لپکے،

844
01:04:44,340 --> 01:04:49,949
حضرت عمرو بن العاصؓ کے شانہ بشانہ جنگِ اجنادین لڑی۔

845
01:04:49,980 --> 01:04:55,829
جو مسلمانوں کے لیے ایک عظیم فتح اور رومیوں کے لیے ایک تباہ کن شکست تھی۔

846
01:04:55,874 --> 01:05:01,046
ہرقل تک یہ خبر پہنچی، اُس نے کہا؛ یہ ہماری شکست کا آغاز ہے۔

847
01:05:01,069 --> 01:05:04,922
حضرت خالد بن ولیدؓ اور حضرت عمرو بن العاصؓ واپس یرموک کی طرف روانہ ہو گئے۔

848
01:05:04,969 --> 01:05:08,459
اب ہراقل پہلے ہی خطرے کو محسوس کر رہا تھا۔

849
01:05:08,484 --> 01:05:14,566
اور وہ جانتا تھا کہ اُس کے سپاہیوں کے لیے مسلمانوں کے خلاف کھڑا ہونا آسان نہیں

850
01:05:14,600 --> 01:05:17,756
لہذا ہراقل نے اپنے سپاہِ سالاروں کو کہا کہ

851
01:05:17,798 --> 01:05:24,696
 ایسی جگہ کا انتخاب کرو جو جنگ کے لیے وسیع میدان فراہم کرے لیکن پسپائی اختیار کرنے کی گنجائش نہ ہو

852
01:05:24,743 --> 01:05:30,582
تاکہ ہماری فوجوں کے پاس پسپائی کا کوئی موقع نہ بچے۔

853
01:05:30,616 --> 01:05:34,336
اُس نے دیکھا کہ اِن مسلمانوں سے نمٹنے کا یہی واحد طریقہ ہے۔

854
01:05:34,392 --> 01:05:36,516
ہمارے سپاہی مسلمانوں کے سامنے نہیں ٹھہر سکتے۔

855
01:05:36,552 --> 01:05:40,249
سبحان اللہ ! قیصر کی فوج نے یرموک کا ایسا مقام منتخب کیا۔

856
01:05:40,282 --> 01:05:45,572
اُن کے سامنے ایک کھلا میدان تھا اور اُن کے پیچھے ایک چٹان تھی۔

857
01:05:45,615 --> 01:05:50,282
تو ظاہر ہے، اب آپ بھاگ نہیں سکتے، آپ کے پیچھے ایک چٹان ہے۔

858
01:05:50,314 --> 01:05:52,236
حضرت عمرو بن العاصؓ  نے یہ دیکھتے ہی کہا؛

859
01:05:52,261 --> 01:05:57,582
أبشرو قد جَآء نصر فولله قلَّى ما يعتي محصورٌ بخير

860
01:05:58,002 --> 01:05:58,938
آپؓ نے کہا خوش ہو جاؤ

861
01:05:58,978 --> 01:06:02,256
صحابہ کرامؓ کی مثبتیت کو دیکھیں کہ ہر معاملے میں کوئی نہ کوئی اچھی خبر نکال لیتے تھے۔

862
01:06:02,295 --> 01:06:05,469
 خوشیاں منائیں! فتح بہت قریب ہے۔

863
01:06:05,506 --> 01:06:11,466
کیوںکہ انہوں نے کونے کا انتخاب کیا ہے اور شازونادر ہی ایسا ہوتا ہے کہ میدان جنگ میں ایک کونے سے آنے والا حریف فاتح بن جائے

864
01:06:11,508 --> 01:06:15,122
آپ نے خود کو محصور کر لیا ہے، آپ نے خود ہی اس محلِ وقوع کا انتخاب کیا ہے۔

865
01:06:15,171 --> 01:06:18,826
شاید ہی ایسی حالت میں مبتلا شخص کبھی کامیاب ہوا ہو

866
01:06:18,857 --> 01:06:26,936
دشمن کی تعداد دو لاکھ پچاس ہزار تھی، جب کہ مسلمان جب اکٹھے ہوئے تو اُن کی تعداد چالیس ہزار تھی۔

867
01:06:26,981 --> 01:06:30,136
اور یہ جنگ یرموک تھی

868
01:06:30,172 --> 01:06:34,659
جس کے بارے میں ہم ان شاء اللہ پیر کے دن بات کریں گے۔

869
01:06:34,694 --> 01:06:39,086
صَلَّى الله عَلى سَيَّدِنَا محمد وَعَلى اَلِهِ وَ صَحْبِهِ وَسَلِّمْ

