1
00:00:20,613 --> 00:00:23,807
اَعُوْذُ بِاللهِ مِنَّ الشِّيْطَانِ الرَّجِيْمِ۝بِسْمِ اللهِ الرَّحْمَانِ الرَّحِيْمَ۝

2
00:00:23,841 --> 00:00:29,943
اَلْحَمْدُ لله ، وَالصَّلَاةُ وَالسَّلَامُ عَلى سَيِّدِنَا محمد وَعَلَى اَلِهِ وَصَحْبِهِ وَسَلِّمْ تَسْلِيْمًا كَثِيْرًا

3
00:00:29,984 --> 00:00:33,236
حروبِ ردہ یعنی فتنہ ارتداد کے معرکوں سے اخذ شدہ نتائج

4
00:00:33,261 --> 00:00:38,473
ہم ردّہ کی جنگوں پہ گفتگو کر چکے ہیں، ارتداد کے معرکوں پہ بات ہو چُکی ہے

5
00:00:38,503 --> 00:00:42,050
ان معرکوں سے سیکھنے کے لیے کچھ سبق ہیں ' نمبر ایک

6
00:00:42,088 --> 00:00:47,263
کہ حضرت ابوبکر صدیقؓ نے اسلام کو باقی سب مذاہب سے نمایاں و ممتاز کیا

7
00:00:47,304 --> 00:00:52,300
اور آپؓ نے اسلام میں شرک کی آمیزش کرنے کی اجازت کبھی نہ دی

8
00:00:52,339 --> 00:01:01,990
کوئی بھی مذہب ابتدائی مراحل میں تبدیل ہونے کی صلاحیت رکھتا ہے

9
00:01:02,020 --> 00:01:08,163
چنانچہ حضرت ابوبکر صدیقؓ کے لیے اس بات کو یقینی بنانا بہت ضروری تھا

10
00:01:08,195 --> 00:01:16,063
کہ اسلام، رسول اللہؐ کے وصال کے بعد کی انتہائی نازک حالات میں بھی کامل حالت میں رہے

11
00:01:16,104 --> 00:01:19,317
اور جیسا کہ ہم نے حضرت ابوبکر صدیقؓ کے ایک بیان میں ذکر کیا ہے کہ آٌپؓ نے فرمایا؛

12
00:01:19,357 --> 00:01:23,677
لقد انقطع الوحي وتم الدين، أينقص وأنا حي؟

13
00:01:23,708 --> 00:01:28,642
وحی کا سلسلہ ختم ہوا، یعنی اب حضرت جبرائیلؑ آ کر ہماری غلطیوں کی اصلاح نہیں کریں گے

14
00:01:28,685 --> 00:01:32,783
حضرت جبرائیلؑ، رسول اللہؐ کے وصال کے بعد کسی شخص پر نازل نہیں ہوں گے

15
00:01:32,829 --> 00:01:33,555
" وتم الدين"

16
00:01:33,595 --> 00:01:35,883
اور دین مکمل ہوگیا ہے

17
00:01:35,922 --> 00:01:39,907
اس لیے جب تک میں زندہ ہوں، دین میں اختراع لانے کی اجازت نہیں دوں گا

18
00:01:39,930 --> 00:01:44,637
آپؓ نے فرمایا؛ میں جب تک زندہ ہوں دین اسلام کو زوال پذیر نہیں ہونے دوں گا

19
00:01:44,670 --> 00:01:53,010
 اسلام اور عیسائیت کے ابتدائی دور کے درمیان موازنہ کرنا یا اس متعلق تحقیق کرنا بہت دلچسپ بحث ہوگی

20
00:01:53,041 --> 00:01:58,121
اور مذہب کی ترقی و ترویج میں حکومت کا کردار ،کیوںکہ

21
00:01:58,156 --> 00:02:02,723
حکومت کا ایک کردار ہوتا ہے کہ مذہب کو کس طرح دائرہ عمل میں لایا جائے

22
00:02:02,765 --> 00:02:09,427
لہٰذا مذہب پر حکومتی اثر و رسوخ کو نظرانداز نہیں کیا جا سکتا

23
00:02:09,457 --> 00:02:12,062
اور یہ حقیقت خلفائے راشدین کے زمانے میں بھی عیاں تھی

24
00:02:12,087 --> 00:02:16,103
یہ(حکومتی کردار) دورِ حاضر میں بھی واضح ہے اور یہ ہر مذہب کی ترویج میں شامل ہے

25
00:02:16,140 --> 00:02:22,437
عیسائیت میں، مذہب کی ترقی و ترویج میں حکومت کی طرف سے بہت زیادہ عمل دخل تھا

26
00:02:22,483 --> 00:02:37,010
  تو عیسائیت کی جو موجودہ صورت ہے، اس پہ رومی سلطنت کی ابتدائی حکومت کا قوّی اثر و رسوخ شامل ہے، کہ یہ عیسائ مذہب، دورِ حاضر کے مرحلے تک کیسے پہنچا

27
00:02:37,035 --> 00:02:44,170
چنانچہ اب حضرت ابوبکر صدیقؓ اسلامی حکومت کی بنیاد رکھ رہے تھے،

28
00:02:44,200 --> 00:02:51,112
  اور جو آج سے اسلامی طرزِ حکمرانی ہوگا، اور یعنی آپؓ اسلامی طرزِ حکومت کے بنیادی اصول طے کر رہے تھے، جیسا کہ میں نے آپ کو پہلے بتا چُکا ہوں

29
00:02:51,136 --> 00:02:55,403
چنانچہ حضرت ابوبکر صدیقؓ اس بات کو یقینی بنانا چاہتے تھے

30
00:02:55,446 --> 00:02:58,757
کہ وہ لوگ جو پہلے ہی مسلمان ہو چکے ہیں

31
00:02:58,793 --> 00:03:03,730
اسی انداز سے اسلام پر عمل پیرا ہوں گے جس طرح رسول اللہؐ کے زمانے میں عمل کرتے تھے

32
00:03:03,772 --> 00:03:10,823
اور آپؓ نے فرمایا کہ میں گھوڑے کی زین یا اونٹ کی مہار پر بھی سمجھوتہ نہیں کروں

33
00:03:10,857 --> 00:03:15,193
ایک رسی جو اونٹوں کے گلے میں باندھی جاتی ہے

34
00:03:15,223 --> 00:03:24,090
آپؓ نے فرمایا؛ میں ان(مرتدینِ زکوٰۃ) کو اونٹ کی گردن میں بندھی ہوئی رسی کے لئے بھی معاف نہیں کروں گا، جو وہ رسول اللہؐ کو ادا کرتے تھے

35
00:03:24,121 --> 00:03:30,350
اور حضرت ابوبکر صدیقؓ شدید خانہ جنگی اور مخاصمت کے بعد

36
00:03:30,382 --> 00:03:36,957
اللہ تعالی کے قانون کو ان لوگوں پر نافذ کرنے کے قابل ہوئے جو پہلے ہی مسلمان تھے

37
00:03:36,993 --> 00:03:43,007
چنانچہ ردّہ کی جنگوں کے اختتام پر عرب میں ہر کوئی اس نتیجے پر پہنچا

38
00:03:43,037 --> 00:03:46,374
کہ ہماری زندگیوں میں رائج اسلام رسول اللہؐ کے زمانے کا اسلام جیسا ہوگا

39
00:03:46,399 --> 00:03:52,403
اور یہ من وعن جاری رہے گا اور اس میں اختراع کی گنجائش نہیں آنے دیں گے

40
00:03:52,446 --> 00:03:56,360
آپؓ نے جزیرہ نما کو بھی شرک سے پاک کیا

41
00:03:56,400 --> 00:04:00,080
اور آپؓ نے اللہ عَزَّوَجَلْ کا حکم (تعلیمات) سب پر یکساں طور پر نافذ کیا

42
00:04:00,104 --> 00:04:10,983
نمبر دو؛ آپؓ نے جزیرہ نما کو شرک سے پاک کیا، اور اسے آئندہ فتوحات کے لیے مرکز بنایا

43
00:04:11,027 --> 00:04:16,410
کیونکہ آپ اس وقت تک توسیع و ترویج شروع نہیں کر سکتے جب تک کہ آپ کے پاس بنیاد نہ ہو

44
00:04:16,459 --> 00:04:20,553
اور اگر آپ فتوحات کے سلسلے کو جاری رکھنا چاہتے ہیں تو اس بنیاد کا مضبوط ہونا ضروری ہے

45
00:04:20,583 --> 00:04:30,583
چنانچہ حضرت ابوبکر صدیقؓ اس بات کو یقینی بنانا چاہتے تھے کہ اسلام کا جو گڑھ (بنیاد) ہو، وہ ہر قسم کے شرک سے پاک ہونی چاہیئے

46
00:04:30,620 --> 00:04:37,393
اور یہ کہ یہ ایک مضبوط و مستحکم جماعت ہو، جو قانون کی پابندی کرے اور امیر کی اطاعت گزار ہو

47
00:04:37,427 --> 00:04:43,607
لہٰذا یہ جماعت آگے بڑھنے اور روئے زمین کے ہر گوشے میں دین کا نور پھیلانے کے لئے تیار رہے

48
00:04:43,647 --> 00:04:48,110
اور حروبِ ردَّة کے بعد آپؓ ایسی جماعت تیار کرنے میں کامیاب ہوئے

49
00:04:48,148 --> 00:04:56,937
نمبر تین، ردّہ کی جنگیں خلیفہؓ کے لیئے مردوں کی صفات کو جانچنے کا ایک موقع تھیں

50
00:04:56,982 --> 00:04:58,840
کیونکہ آپ لوگوں کو صرف فتنوں کے وقت ہی جانچ پرکھ سکتے ہیں

51
00:04:58,879 --> 00:05:04,743
امن اور سلامتی کے دور میں ہر کوئی کامل ہونے کا دعویٰ کر سکتا ہے

52
00:05:04,776 --> 00:05:10,270
اور یہی وجہ ہے کہ امن کے وقت منافقین سر اُٹھانے لگتے ہیں

53
00:05:10,316 --> 00:05:19,523
رسول اللہؐ کے زمانے میں جب جنگ رُک جاتی یا امن کا دور ہوتا، منافقین سب سے بڑے مؤمن ہونے کا دعوہ کرتے

54
00:05:19,558 --> 00:05:21,960
اور پھر جیسے ہی جنگی صورتحال یا فتنہ درپیش آتا

55
00:05:22,000 --> 00:05:25,050
وہ(منافقین) اپنے گھروں میں دُبک جاتے اور آپ کو وہ کہیں دکھائی نہ دیتے

56
00:05:25,083 --> 00:05:33,237
تو آپ لوگوں کی خصوصیات کو نہیں جانچ سکتے، جب تک کہ آپ ان کو فتنہ و بلاء، یا آزمائشوں سے نہ گزاریں

57
00:05:33,271 --> 00:05:37,183
اور یہیں سے باطن کی حقیقت جزبہ ایمانی عیاں ہوتی ہے

58
00:05:37,231 --> 00:05:41,303
پس حروبِ ردہ حضرت ابوبکر صدیقؓ کے لیے یہ جاننے کا موقع تھا

59
00:05:41,353 --> 00:05:45,253
کون سچا مومن ہے اور کون جھوٹا ہے

60
00:05:45,291 --> 00:05:49,264
أَحَسِبَ النَّاسُ أَن يُتْرَكُوا أَن يَقُولُوا آمَنَّا وَهُمْ لَا يُفْتَنُونَ ۝

61
00:05:49,391 --> 00:05:53,518
کیا لوگ یہ سمجھتے ہیں کہ وہ مومن ہونے کا دعویٰ کریں گے، اور وہ آزمائش میں سے نہیں گزریں گے

62
00:05:53,548 --> 00:05:54,455
پھر اللہ عَزَّوَجَلْ فرماتا ہے؛

63
00:05:54,479 --> 00:05:57,217
فَلَيَعْلَمَنَّ اللَّهُ الَّذِينَ صَدَقُوا وَلَيَعْلَمَنَّ الْكَاذِبِينَ۝

64
00:05:57,255 --> 00:06:01,822
تو اللہ جان سکے کہ کون اپنے دعووں میں سچا ہے اور کون جھوٹا ہے(کوئی شک اللہ ان کے باطن کو جانتا ہے)

65
00:06:01,868 --> 00:06:04,470
ہر کوئی کہہ رہا ہے کہ ہم مسلمان ہیں ہم مؤمن ہیں

66
00:06:04,510 --> 00:06:12,957
لیکن فتنہ (آزمائش) اس بات کا تعین کرے گا کہ اپنے ایمان کے دعوے میں کون سچا ہے اور کون جھوٹا

67
00:06:12,993 --> 00:06:18,610
چنانچہ حضرت ابوبکر صدیقؓ نے ردہ کے حروب سے لوگوں کی صفات کی جانچ پرکھ کی

68
00:06:18,650 --> 00:06:21,103
اور اس نے آپؓ کو اپنے امیروں کے انتخاب میں مدد کی

69
00:06:21,150 --> 00:06:25,843
تو یہ(حروبِ ردہ) دراصل مستقبل کے قائدین کے لیے ایک تربیتی کورس تھا

70
00:06:25,893 --> 00:06:37,780
وہ لوگ جنہوں نے ردّہ کی جنگوں میں سب سے اہم کردار ادا کیا، وہی لوگ تھے جنہوں نے دین کو دورِ حاضر کی سلطنتوں تک پھیلایا

71
00:06:37,810 --> 00:06:41,210
نمبر چار، یہ ردّہ کا عملی فقہ تھا

72
00:06:41,247 --> 00:06:46,463
قرآن اور سنت میں ردّہ کے حوالے سے فقہی قانون موجود تھے

73
00:06:46,498 --> 00:06:53,047
 لیکن یہ نظریاتی تصور ہی رہا، کیونکہ یہ فتنہ رسول اللہؐ کے زمانے میں، حقیقی بنیادوں پہ مدینہ میں ظاہر نہیں ہوا تھا

74
00:06:53,077 --> 00:06:56,617
 اور رسول اللہؐ کے زمانے میں کوئی حقیقی ارتداد پیش نہیں آیا تھا

75
00:06:56,652 --> 00:07:06,477
تو یہ حضرت ابوبکرؓ ہی تھے جنہوں نے ہمیں رَدَّة کے متعلق رسول اللہؐ کی احادیث اور آیات کا فہم دیا،

76
00:07:06,527 --> 00:07:10,477
حضرت عمر بن خطابؓ اور بہت سے دیگر صحابہ بھی اس حدیث کے مفہوم کا معنی و مطالب نہیں سمجھ پائے

77
00:07:10,500 --> 00:07:14,837
أُمِرْتُ أَن أُقاتِلَ النَّاسَ حَتَّى يَشْهَدُوا أَن لا إِلهَ إِلاَّ اللَّه وأَنَّ مُحَمَّدًا رَسُولُ اللَّهِ

78
00:07:14,871 --> 00:07:19,593
یہ حضرت ابوبکرؓ تھے جنہوں نے سب کو اس حدیث کا معنی و مفہوم بتایا

79
00:07:19,635 --> 00:07:30,507
تو اب، اسلام کے گڑھ سے لشکر، اللہ تبارک وتعالٰی کی دعوت کو دنیا میں پھیلانے کے لیے تیار تھے

80
00:07:30,537 --> 00:07:36,643
تو اب ہم حضرت ابوبکر صدیقؓ کی فتوحات کے بارے میں بات کرنے جارہے ہیں

81
00:07:36,668 --> 00:07:39,530
اور ہم عراق کی فتح سے آغاز کریں گے

82
00:07:39,567 --> 00:07:44,490
غزوۃ عراق یا فتح عراق، عراق کی تسخیر

83
00:07:44,540 --> 00:07:50,893
حضرت المثنیٰ بن حارثہ الشعیبانیؓ کا تعلق عراق کے قبیلے بنو شعیبان سے تھا

84
00:07:50,923 --> 00:07:57,407
 آپؓ خلیفہ کے پاس تشریف لائے اور آپؓ نے انھیں ایک تجویز پیش کی، حضرت ابوبکرؓ پہلے ہی اس کے بارے میں غوروحوض کر رہے تھے

85
00:07:57,437 --> 00:07:58,834
آپؓ نے خلیفہ سے عرض کی؛

86
00:07:58,858 --> 00:08:04,863
میں چاہتا ہوں کہ آپ مجھے قیادت کی زمہ داری سونپ دیں اور مجھے میرے علاقے کے لوگوں پر امیر مقرر کر دیں

87
00:08:04,896 --> 00:08:10,140
تاکہ میں عراق میں اللہ کے دشمنوں کے خلاف محاذ آراء ہو سکوں

88
00:08:10,167 --> 00:08:14,637
 عراق سلطنت فارس کا حصہ تھا

89
00:08:14,686 --> 00:08:17,663
حضرت ابوبکر صدیقؓ نے ان کی تجویز منظور کرلی

90
00:08:17,701 --> 00:08:20,860
لہٰذا اب حضرت ابوبکرصدیقؓ کو فوج بھیجنے کی ضرورت نہیں تھی

91
00:08:20,890 --> 00:08:27,543
حضرت المثنیٰ بن حارثہؓ، حضرت ابوبکرؓ سے صرف اپنے عہدے کے لیے شرعی اجازت نامہ حاصل کرنا چا رہے تھے

92
00:08:27,596 --> 00:08:30,640
 حالانکہ یہ عہدہ آپؓ کے پاس پہلے سے موجود تھا،آپؓ اپنے قبیلے کے سردار تھے

93
00:08:30,679 --> 00:08:34,916
اور اس(اجازت نامے کے حصول) کے بعد وہ اپنے ہی لوگوں کے ساتھ مل کر اللہ کے دشمن سے لڑنے کے متمنی تھے

94
00:08:34,939 --> 00:08:38,130
حضرت ابوبکر صدیقؓ نے اس رائے سے اتفاق کیا

95
00:08:38,166 --> 00:08:50,147
حضرت ألمثنى بن حارثهؓ نے فارسی فوجوں کے خلاف "کَرَء و الفر" یعنی گوریلا جنگ کا آغاز کیا

96
00:08:50,167 --> 00:08:59,010
کیونکہ آپؓ کا فوجی دستہ بہت چھوٹا سا تھا اس لئے آپؓ دشمن سے رُوبَرُو جنگ کے متحمل نہیں ہو سکتے تھے

97
00:08:59,053 --> 00:09:01,294
چنانچہ آپؓ نے" کرء والفر" کا جنگی طریقہ استعمال کیا

98
00:09:01,333 --> 00:09:10,143
آپ دشمن پہ ایک جگہ گھات لگا کر حملہ کرتے ہیں اور پھر آپ پلٹ جاتے ہیں اور آپ پھر دوسری جگہ حملہ آور ہوتے ہیں، اور دشمن کو حواس باختہ رکھتے ہیں

99
00:09:10,188 --> 00:09:14,785
کیونکہ آپؓ کا جنگی لشکر بہت چھوٹا تھا اس وجہ سے آپؓ تیز رفتار نقل و حرکت کے متحمل تھے

100
00:09:14,805 --> 00:09:18,030
اور یہ جنگی انداز آپؓ کے لئے اورآپؓ کے گروہ کے لیے زیادہ محفوظ تھا

101
00:09:18,060 --> 00:09:23,020
بجائے اس کے کہ جنگ کے لئے ایک مقررہ فوجی اڈہ قائم کیا جائے، جہاں سے جنگ کی نگرانی کی جا سکے

102
00:09:23,055 --> 00:09:27,637
اب یہ بات ذہن میں رکھیں کہ حضرت المثنیٰ بن حارثہؓ وہی شخصیت ہیں جن کے بارے میں ہم پہلے ہی بات کر چکے ہیں

103
00:09:27,677 --> 00:09:31,197
 ہم نے اُن کے متعلق اس سلسلے کے آغاز میں بات کی تھی

104
00:09:31,235 --> 00:09:36,570
جب رسول اللہؐ مکہ میں مسلمانوں کے لئے امان کی تلاش میں تھے

105
00:09:36,602 --> 00:09:40,543
آپؐ کو مسلمانوں کے لئے ایسی جائے پناہ کی تلاش تھی جو انھیں تحفظ دے سکے

106
00:09:40,591 --> 00:09:48,593
حضرت ابوبکر صدیقؓ نے آپؐ سے فرمایا؛ یہ اچھے لوگ ہیں، مضبوط ومستحکم آدمی ہیں، چلیں ان سے بات کرتے ہیں

107
00:09:48,614 --> 00:09:51,950
 چنانچہ حضرت ابوبکر صدیقؓ تشریف لے گئے اور گفتگو فرمائی

108
00:09:51,986 --> 00:09:54,783
اور رسول اللہؐ کا پیغام پیش کیا

109
00:09:54,830 --> 00:09:59,917
چنانچہ انہوں نے رسول اللہؐ کو بات کرنے کو کہا تو آپؐ نے قرآن کی کچھ آیات تلاوت فرمائیں

110
00:09:59,963 --> 00:10:05,640
اور انہوں نے کہا؛ ہمیں یہ کلام بہت اچھا لگا اور یہ حق وصداقت پرمبنی ہے

111
00:10:05,676 --> 00:10:11,770
اور ایک قوم، جنہوں نے اس کلامِ حق کی وجہ سے آپؐ سے جنگ کی واقعی برے لوگ ہیں یعنی قریش کے لوگ

112
00:10:11,806 --> 00:10:14,370
 آپ کو وہ گفتگو یاد ہو گی

113
00:10:14,415 --> 00:10:18,520
اور پھرحضرت المثنیٰ بن حارثہؓ نے کیا فرمایا؟ آپؓ نے فرمایا؛

114
00:10:18,564 --> 00:10:23,583
ہم آپ کو ایک سرحد کی طرف سے تحفظ مہیا کر سکتے ہیں، لیکن ہم آپ کو دوسری سرحد سے تحفظ کی پیشکش نہیں کر سکتے

115
00:10:23,617 --> 00:10:25,623
ہم آپ کوعربوں کی طرف سے امان دینے کی پیشکش کر سکتے ہیں

116
00:10:25,647 --> 00:10:29,723
لیکن ہم آپ کو فارسیوں کی طرف سے امان دینے کی پیشکش نہیں کر سکتے کیونکہ

117
00:10:29,767 --> 00:10:37,730
ہم ان کا مقابلہ نہیں کر سکتے، ہم سلطنتِ فارس کے خلاف جاکر، اُن سے نہیں لڑ سکتے

118
00:10:37,767 --> 00:10:41,770
لیکن اب حالات بدل چکے ہیں اورحضرت المثنیٰ بن حارثہؓ مسلمان ہیں

119
00:10:41,806 --> 00:10:46,913
اور یہ وہ شخصیت ہیں جو خلیفہ کے پاس تشریف لاتے ہیں اورآپؓ کو تاکید کرتے ہیں، کہ وہ آپؓ کو رومیوں کے خلاف لڑنے کی اجازت دیں،

120
00:10:46,943 --> 00:10:49,650
 دیکھیں اسلام کس طرح دل کو بدلتا ہے

121
00:10:49,689 --> 00:10:56,093
اور اگر اسلام آپ میں یہ تبدیلی نہیں لاتا، تو پھر آپ کو اسلام کا مکمل فہم حاصل نہیں ہے، اسلام کو سمجھنے میں مسئلہ ہے

122
00:10:56,141 --> 00:11:00,320
 کیونکہ فرعون کے جادوگروں کو دیکھ لیں

123
00:11:00,345 --> 00:11:04,737
جو تھوڑی سی رقم کے عوض اللہ کے نبیؑ کے خلاف کھڑے ہونے کو تیار تھے

124
00:11:04,769 --> 00:11:07,290
قَالُواْ إِنَّ لَنَا لَأَجْرًا إِن كُنَّا نَحْنُ ٱلْغَٰلِبِينَ۝

125
00:11:07,315 --> 00:11:10,517
کیا آپ ہمیں ادائیگی کریں گے، اگر ہم جیت گئے تو ہمیں کچھ انعام واکرام دیں گے؟

126
00:11:10,565 --> 00:11:15,947
فرعون  نے کہا ؛ ہاں، میں تمہیں بہت زیادہ انعام واکرام  دوں گا اور تمہیں اپنے قریبی عمائدین میں شامل کرلوں گا

127
00:11:15,986 --> 00:11:23,103
لیکن جب وہ مومن بن گئے تو یہی لوگ جو پیسے کے لیے یہ سب کر رہے تھے

128
00:11:23,136 --> 00:11:27,313
اب جب فرعون نے کہا؛ میں تم سب کو قتل کرنے والا ہوں

129
00:11:27,342 --> 00:11:30,500
تو وہ کہنے لگے ؛ ہم اپنے دین کو چھوڑنے کے بجائے مرنا پسند کریں گے

130
00:11:30,525 --> 00:11:37,153
تو ایمان نے فوری طور پر انہیں نہ صرف مال و دولت کی چاہ سے بے نیاز کر دیا، بلکہ انھوں نے اللہ عَزَّوَجَلْ کے لیے اپنی جانیں تک دے دیں

131
00:11:37,176 --> 00:11:42,157
تو یہی وہ تبدیلی کی طاقت ہے جو ایمان کے اندر ہونی چاہیے

132
00:11:42,188 --> 00:11:45,930
چنانچہ حضرت المثنٰی بن حارثہؓ فرما رہے تھے کہ

133
00:11:45,965 --> 00:11:49,000
"میں چاہتا ہوں کہ آپؓ(حضرت ابوبکرؓ) مجھے اختیار دیں اور میں یہ فرض ادا کروں

134
00:11:49,036 --> 00:11:53,637
حضرت ابوبکر صدیقؓ نےحضرت المثنیٰ بن حارثہؓ کو یہ اختیار دے دیا

135
00:11:53,677 --> 00:12:00,943
اور آپؓ عراق کی فتح کی راہ پہ گامزن ہوئے

136
00:12:00,983 --> 00:12:05,813
آپؓ کی قوم میں سے ایک شخص تھا، بنو شعیبان یہ ایک بڑا قبیلہ تھا

137
00:12:05,835 --> 00:12:10,730
اور یہ ربیعہ سے تعلق رکھتے تھے، ان میں سے ایک شخص کا نام "مذعور بن عدی" تھا

138
00:12:10,769 --> 00:12:18,903
وہ شخص قیادت کے عہدے کے لئے حضرت المثنیٰ بن حارثہؓ کا حریف تھا اس عہدے کے لئے اس نے کوشش بھی کی

139
00:12:18,951 --> 00:12:23,497
اور اس(عدی بن مذعور) نے حضرت ابو بکرصدیقؓ کو خط بھیجا اور اس نے کہا؛

140
00:12:23,537 --> 00:12:26,240
ہم أحلاس ألخيل ہیں

141
00:12:26,273 --> 00:12:30,930
أحلاس ألخيل' کا مطلب ہے، ہم اپنے گھوڑوں کی پشت سے ہماوقت چپکے ہوئے ہیں

142
00:12:30,971 --> 00:12:36,157
دوسرے لفظوں میں، ہم اپنے گھوڑوں پر اس قدر سواری کرتے ہیں کہ ہم اس میں مہارت رکھتے ہیں، ہم گُھڑ سواری کے ماہر ہیں

143
00:12:36,197 --> 00:12:38,873
ہم "فرسان ألصباح" ہیں اور ہم طلوعِ صبح کے بہادر جنگجو ہیں

144
00:12:38,915 --> 00:12:41,063
ہم صبح پوُ پھٹتے ہی اپنے دشمنوں پر حملہ کرتے ہیں

145
00:12:41,095 --> 00:12:46,653
اور میرے ساتھ ایسے سُورما ہیں، ان میں سے ہر ایک جنگجو سو دشمنوں پہ حاوی ہے

146
00:12:46,683 --> 00:12:53,370
اور اس(عدی بن مذعور) نے حضرت ابوبکرؓ سے عرض کی کہ انھیں اپنے علاقے میں فوج کا سپہ سالار مقرر کیا جائے

147
00:12:53,401 --> 00:12:57,440
چنانچہ اب حضرت ابوبکر صدیقؓ کو ایک ایسی صورتحال درپیش تھی جہاں آپؓ پہلے ہی حضرت المثنیٰ بن حارثہؓ کو مقرر کر چکے تھے

148
00:12:57,480 --> 00:13:01,563
اور اب ایک اور دعویدار بھی اسی عہدے کا خواہشمند تھا

149
00:13:01,617 --> 00:13:06,123
اور حضرت المثنیٰؓ نے حضرت ابوبکرؓ کو خط بھیجا کہ میری قوم میں سے ایک شخص ہے

150
00:13:06,169 --> 00:13:14,057
جو قیادت کے عہدے کے لئے مجھ سے دست و گریبان ہوا اور میرے اس عہدے کے لئے جس پہ آپؓ نے مجھے مقرر فرمایا ہے،  چھیننے کی کوشش کرے گا

151
00:13:14,094 --> 00:13:16,737
تو، میں چاہتا ہوں کہ یہ معاملہ آپؓ کے علم میں ہونا چاہئے

152
00:13:16,781 --> 00:13:20,710
اب حضرت ابوبکر صدیقؓ زندگی کی حقیقتوں سے نمٹ رہے تھے

153
00:13:20,752 --> 00:13:25,500
آپ جانتے ہیں، کچھ باہمی ذاتی مسائل ہوتے ہیں… کچھ سرزنش کے معاملات ہوتے ہیں

154
00:13:25,525 --> 00:13:29,427
مسلمانوں میں بھی اس قسم کی عداوت اور بغض ہوتا ہے، مسلمان فرشتے نہیں ہوتے

155
00:13:29,454 --> 00:13:34,543
چنانچہ حضرت ابوبکر صدیقؓ جانتے تھے کہ جماعت کو کیسے لے کر چلنا ہے

156
00:13:34,580 --> 00:13:39,390
آپؓ لوگوں کی سماجی زندگی کے معاملات کو سنبھالنا جانتے تھے

157
00:13:39,437 --> 00:13:42,043
اور یہ ایک رہنما کی قائدانہ صلاحیتوں کا جزو ہے

158
00:13:42,093 --> 00:13:45,630
چنانچہ حضرت ابوبکر صدیقؓ نے اس معاملے کو سُلجھانے کے لئے

159
00:13:45,680 --> 00:13:50,267
چونکہ آپؓ پہلے ہی حضرت خالد بن ولیدؓ کو پورے لشکر کی قیادت کے لیے بھیج چکے تھے

160
00:13:50,299 --> 00:13:55,737
 آپؓ نے مذعور کو خط بھیجا،آپؓ نے فرمایا کہ آپ کی زبان پہ مجھے اعتبار ہے

161
00:13:55,768 --> 00:13:59,002
حالانکہ مذعور کی بیان کردہ فوجی صلاحیتوں میں مبالغہ آرائی بھی ہو سکتی تھی؛ ألله أعلم

162
00:13:59,077 --> 00:14:04,397
آپؓ نے فرمایا؛ میں نے آپ کی بات مان لی اور آپ پر یقین کرتا ہوں اور میں آپ کو حکم دے رہا ہوں

163
00:14:04,436 --> 00:14:10,820
کہ حضرت خالد بن ولیدؓ کے لشکر کے ساتھ شامل ہو جاؤ اور ان کے ساتھ رہو اور ہر عمل و اقدام میں اُن کی اطاعت و پیروی کرنا

164
00:14:10,850 --> 00:14:14,480
  مذعور اور حضرت مثنٰیؓ کو ایک ہی جھنڈے کے نیچے یکجا کرنے کی بجائے

165
00:14:14,503 --> 00:14:18,423
میرا مطلب ہے کہ آپؓ مذعور کو حضرت مثنٰیؓ کی زیرِ قیادت جانے کو کہہ سکتے تھے،

166
00:14:18,460 --> 00:14:23,692
جنہیں میں پہلے ہی مقرر کر چکا ہوں، آپؓ ایسا کر سکتے تھے اور اس صورت حال سے کچھ پیچیدگیاں پیدا ہو سکتی تھیں

167
00:14:23,716 --> 00:14:25,390
آپؓ نے مذعور سے فرمایا؛ نہیں! آپ خالد بن ولیدؓ کے ساتھ چلو

168
00:14:25,461 --> 00:14:27,366
چنانچہ آپؓ نے دونوں(مزعور اور المثنیٰؓ) کے راستے جدا کر دیئے

169
00:14:27,388 --> 00:14:29,570
حضرت المثنیٰ بن حارثہؓ ایک لشکر کی قیادت کر رہے تھے

170
00:14:29,606 --> 00:14:34,250
اور مذعور اپنے گروہ کے ساتھ حضرت خالد بن ولیدؓ کی قیادت میں آ گئے

171
00:14:34,281 --> 00:14:38,397
اور کوئی بھی قیادت کے معاملے میں حضرت خالدؓ کے ساتھ مقابلہ نہیں کر سکتا تھا

172
00:14:38,438 --> 00:14:43,180
اُن سب کو حضرت خالد بن ولیدؓ کی قابلیت اور قیادت پہ اعتماد تھا

173
00:14:43,204 --> 00:14:48,583
میرا مطلب ہے کہ رسول اللہؐ کے صحابہ جو آپؓ سے پہلے دائرہ اسلام میں داخل ہوئے،وہ سب تسلیم کرتے تھے

174
00:14:48,626 --> 00:14:55,140
کہ حضرت خالد بن ولیدؓ لشکر کی قیادت کرنے میں، ہم سب سے زیادہ قابل اور قائدانہ صلاحیتوں کے حامل ہیں

175
00:14:55,181 --> 00:14:57,260
حضرت ابوبکر صدیقؓ کا منصوبہ کیا تھا؟

176
00:14:57,301 --> 00:15:01,043
حضرت المثنیٰ بن حارثہؓ نے کچھ عرصے تک ایک اہم کردار ادا کیا

177
00:15:01,074 --> 00:15:10,420
لیکن اب حضرت ابو بکر صدیقؓ عراق کے علاقے میں ایک بڑی کاروائی کرنا چاہتے تھے

178
00:15:10,450 --> 00:15:18,810
چنانچہ آپؓ کا منصوبہ یہ تھا کہ دو لشکر بھیجے جائیں، ایک لشکر جنوب مشرق سے حملہ کرے

179
00:15:18,858 --> 00:15:23,397
اور دوسرا لشکر شمال مغرب سے حملہ کرے

180
00:15:23,439 --> 00:15:27,440
وہ لشکر جو جنوب مشرق سے حملہ کرے گا وہ حضرت خالد بن ولیدؓ کی زیرِ قیادت ہوگا

181
00:15:27,473 --> 00:15:31,330
 اور آپؓ نے انھیں خط بھیجا کہ عراق کی طرف پیش قدمی کریں

182
00:15:31,355 --> 00:15:37,803
چونکہ حضرت خالدؓ یمامہ میں تھے، جنگِ یمامہ، مسیلمہ کذاب کے ساتھ ہونے والا معرکہ کا ابھی ہی اختتام ہوا تھا

183
00:15:37,848 --> 00:15:40,877
حضرت ابوبکرؓ نے فرمایا؛ عراق کی طرف پیش قدمی کرو، یہاں تک کہ تم اس میں داخل ہو جاؤ

184
00:15:40,933 --> 00:15:45,243
پھر ہندوستان کے داخلی دروازے سے داخل ہو جاؤ جو ألأبلَّى ہے

185
00:15:45,293 --> 00:15:51,297
وہ بصرہ کے علاقے کو ہندوستان کا داخلی دروازہ کہتے تھے

186
00:15:51,345 --> 00:15:56,030
کیونکہ ہندوستان جانے والا کوئی بھی شخص بحیرہ فارس سے گزرتا تھا

187
00:15:56,079 --> 00:15:57,806
تو وہ اسے ہندوستان کا داخلی دروازہ کہتے،

188
00:15:57,836 --> 00:16:00,725
آپؓ نے فرمایا؛ اور ہندوستان کے داخلی دروازے سے شروع کرو

189
00:16:00,749 --> 00:16:06,263
اور سبحان اللہ یہ دلچسپ ہے کہ گویا حضرت ابوبکر صدیقؓ کے سامنے نقشہ رکھا ہوا ہے

190
00:16:06,296 --> 00:16:10,490
 جبکہ اس دور میں نقشے نہیں ہوا کرتے تھے

191
00:16:10,538 --> 00:16:15,443
آپؓ نے فرمایا؛ لہٰذا آپؓ ہندوستان کے داخلی دروازے سے عراق میں داخل ہوجاؤ، جو کہ الأبلَّى ہے

192
00:16:15,477 --> 00:16:21,017
وہاں موجود سلطنتِ فارس کے پُرامن لوگوں سے جنگ کئے بغیر معاہدہ کریں

193
00:16:21,062 --> 00:16:28,503
اور پھر آپؓ نے شمال مغرب کی طرف لشکر بھیجا، جس کی قیادت صحابہ میں سے ایک صحابی حضرت عیاض بن غنمؓ کر رہے تھے

194
00:16:28,544 --> 00:16:33,023
اور آپؓ نے اُنھیں شمال مغرب میں واقع"المصیخ" سے حملہ کرنے کا حکم دیا

195
00:16:33,059 --> 00:16:37,597
اور پھر حضرت ابوبکرصدیقؓ کی اس جنگی حکمتِ عملی کو دیکھیں

196
00:16:37,629 --> 00:16:42,610
آپؓ نے فرمایا؛ آپ دونوں عراق میں اندر کی طرف چڑھائی کرتے ہوئے حملہ آور ہوں

197
00:16:42,644 --> 00:16:45,477
اور حیرہ کی طرف تیزی سے پیش قدمی کرنے کی کوشش کریں

198
00:16:45,521 --> 00:16:49,690
اور جو سب سے پہلے حیرہ تک پہنچ گیا وہ دوسرے پر امیر ہوگا

199
00:16:49,746 --> 00:16:56,343
حیرہ،ألأبلَّى اور ألمصيخ کے درمیان واقع تھا

200
00:16:56,385 --> 00:17:00,370
اور حیرہ جنگی اعتبار سے موزوں ترین مقام تھا

201
00:17:00,417 --> 00:17:06,883
حیرہ، مدائن کے بہت قریب واقع ہے جو سلطنت فارس کا دارالحکومت تھا

202
00:17:06,916 --> 00:17:10,873
لیکن یہ جزیرہ نما عرب سے بنسبت قریب واقع ہے

203
00:17:10,901 --> 00:17:14,547
حضرت ابوبکر صدیقؓ چاہتے تھے کہ وہ حیرہ میں اپنا فوجی مرکز بنائیں

204
00:17:14,572 --> 00:17:17,853
چنانچہ دونوں فوجیں شمال اور جنوب سے حملہ آور ہوں

205
00:17:17,882 --> 00:17:20,220
وہ حیرہ کے مقام پہ ایک دوسرے سے جا ملیں، وہاں دونوں لشکر اکٹھے ہوں

206
00:17:20,241 --> 00:17:26,720
اور پھر وہ(دونوں لشکر) دارالحکومت کو ہدف بناتے ہوئے کاری ضرب لگائیں، جو کہ ایک بہت بہترین جنگی حکمتِ عملی تھی

207
00:17:26,745 --> 00:17:31,653
یہ حضرت ابوبکرؓ کا خط تھا ،آپؓ اس نے فرمایا؛ جب تم حیرہ میں ایک دوسرے سے جا ملو

208
00:17:31,685 --> 00:17:34,240
اور فارس کے دفاعی نظام کو توڑنے کے بعد

209
00:17:34,263 --> 00:17:38,190
اورآپ کو یقین ہو جائے کہ مسلمانوں پر پیچھے سے حملہ نہیں کیا جائے گا

210
00:17:38,223 --> 00:17:42,853
تم میں سے کوئی ایک امیر حیرہ میں رہ کر مسلمانوں کی پشت اور اپنے ساتھی سپہ سالاروں کا دفاع کرے

211
00:17:42,884 --> 00:17:53,303
جبکہ دوسرا لشکر اللہ کے دشمنوں اور تمہارے دشمنوں پر ان کے اپنے گھر اور ان کی طاقت کے سرچشمے مدائن پہ حملہ کرے

212
00:17:53,348 --> 00:17:58,210
مصالح كسرىٰ، جنوب میں واقع كسرىٰ کا فوجی اڈہ تھا

213
00:17:58,246 --> 00:18:02,727
چنانچہ یہ حضرت خالد بن ولیدؓ کی ذمہ داری تھی کہ وہ فوجی مراکز کو سنبھالیں

214
00:18:02,762 --> 00:18:06,343
اور حضرت عیاض بن غنمؓ صحرا کی طرف سے پیش قدمی کرتے ہوئے آئیں گے

215
00:18:06,355 --> 00:18:09,823
اور جنوب میں اتریں، یہاں تک کہ حیرہ میں دوسرے لشکر سے جا ملیں

216
00:18:09,871 --> 00:18:13,130
جو بھی حیرہ میں پہلے پہنچتا ہے وہ دوسرے لشکر کی بھی قیادت کرے گا

217
00:18:13,179 --> 00:18:18,863
اور پھر تم میں سے ایک پیچھے رہ کر فوج کے عقب کی حفاظت کرے گا

218
00:18:18,899 --> 00:18:24,940
اور دوسرے لشکر کو سلطنت فارس کے دارالحکومت مدین کی طرف پیش قدمی کرنی ہے

219
00:18:24,977 --> 00:18:26,250
 اس پر کچھ کہنا چاہتا ہوں،

220
00:18:26,280 --> 00:18:34,077
حضرت ابوبکر صدیقؓ یہ چاہتے تھے کہ دارالحکومت کو ہدف بنا کر سلطنت فارس کو نیست و نابود کر دیا جائے

221
00:18:34,112 --> 00:18:40,357
اسلام ایسی حکومت کو تسلیم نہیں کرتا جو اللہ عَزَّوَجَلْ کے حکم کے مطابق حکومت نہ کرے

222
00:18:40,404 --> 00:18:47,050
لیکن اسلام دیگر مذاہب کو اپنا تشخص قائم رکھنے کی اجازت دیتا ہے، اہل ذمۃ کی شکل میں

223
00:18:47,090 --> 00:18:51,117
پس اسلام میں دیگر مذاہب کے پیروکاروں یعنی اہل ذمّہ کے لئے رواداری ہے

224
00:18:51,152 --> 00:18:55,403
لیکن تمام زمین پر حکومت اللہ کی ہونی چاہیے

225
00:18:55,428 --> 00:19:01,063
لہٰذا اسلام میں کسی کافر/غیرمسلم حکومت کی کوئی پہچان نہیں ہے

226
00:19:01,115 --> 00:19:06,287
چنانچہ حضرت ابوبکرصدیقؓ سلطنت فارس کے دارالحکومت کو ہدف بنانا چاہتے ہیں

227
00:19:06,326 --> 00:19:09,977
اور اسے ختم کرنا چاہتے تھے اور یہ ایک بہت ہی جراؑت مندانہ منصوبہ تھا

228
00:19:10,026 --> 00:19:15,077
خاص طور پر یہ کہ حضرت ابوبکر صدیقؓ حال ہی میں حروبِ ردہ(مرتدین کے خلاف جنگوں) سے فارغ ہوئے تھے

229
00:19:15,104 --> 00:19:20,227
اور فوراً ہی آپؓ یہ دونوں لشکر روانہ کر رہے تھے، اور آپؓ انہیں صرف مضافات میں حملہ آور ہونے کے لیے نہیں کہہ رہے تھے

230
00:19:20,260 --> 00:19:23,480
بلکہ آپؓ فرما رہے تھے؛ کہ آپ سیدھے مدائن چلے جائیں

231
00:19:23,502 --> 00:19:26,077
اب اپنے خط میں، حضرت ابوبکرؓ نے فرمایا؛

232
00:19:26,106 --> 00:19:31,632
فارس کے لوگوں کو اور ان کی حکومت میں رہنے والی قوموں سے امن معاہدے کریں

233
00:19:31,665 --> 00:19:37,713
یہ فارسی سلطنت تھی، تمام لوگ فارسی نہیں تھے، کچھ عرب بھی آباد تھے، وہاں مختلف نسلیں آباد تھیں

234
00:19:37,746 --> 00:19:44,663
 کیونکہ ان(فارسیوں) کی حکمرانی ایشیا کے ایک بڑے حصے پر محیط تھی

235
00:19:44,697 --> 00:19:47,150
تو حضرت ابوبکر صدیقؓ فرما رہے تھے؛

236
00:19:47,174 --> 00:19:52,643
تعلف أهل الفارس ومن كان تحتهم من الأمم

237
00:19:52,798 --> 00:19:57,090
ان لوگوں کو پرامن رکھو، انہیں اسلام کی طرف راغب کرنے کی کوشش کرو

238
00:19:57,126 --> 00:20:01,993
یہ پیغام اس کے قطعاً برعکس تھا جو پیغام آپؓ نے مرتدین کے خلاف جنگ میں اپنے سپہ سالاروں کو دیا

239
00:20:02,017 --> 00:20:07,283
مرتدین کے بارے میں آپؓ فرما رہے تھے؛ جو تمہارے ہاتھ میں آئے، اسے ختم کردو

240
00:20:07,318 --> 00:20:12,134
لیکن یہاں آپؓ فرما رہے تھے کہ انہیں اسلام کی ترغیب دلانے کی کوشش کرو، انہیں اسلام کے قریب لانے کی کوشش کرو

241
00:20:12,159 --> 00:20:17,617
کیونکہ اس جنگ کا مقصد ردّہ کی جنگوں کے مقصد سے بالکل مختلف ہے

242
00:20:17,636 --> 00:20:23,097
ردّہ کی جنگوں کا مقصد مسلمانوں کو اسلام کی حکمرانی میں واپس لانا تھا

243
00:20:23,141 --> 00:20:32,490
جب کہ یہ جنگ اُن لوگوں کے خلاف تھی، جنہوں نے مسلمانوں کو نقصان نہیں پہنچایا تھا، اور نہ ان کے خلاف سازشیں کیں تھیں

244
00:20:32,531 --> 00:20:36,688
چنانچہ اب حضرت ابوبکر صدیقؓ ان علاقوں میں داخل ہو رہے تھے جن سے مسلمانوں کو کوئی نقصان نہیں پہنچا

245
00:20:36,732 --> 00:20:39,437
انہوں نے کسی مسلم قانون یا قاعدے کی خلاف ورزی نہیں کی تھی

246
00:20:39,462 --> 00:20:41,743
یہ دعوتِ توحید کی جنگ تھی۔

247
00:20:41,776 --> 00:20:44,640
اس جنگ کا مقصد "دعوت الی اللہ" تھا

248
00:20:44,673 --> 00:20:48,603
تو آپؓ اپنے سپہ سالاروں کو حکم دے رہے تھے جب تم سلطنتِ فارس میں داخل ہو جاؤ

249
00:20:48,643 --> 00:20:53,743
عام لوگوں کو اسلام کی طرف راغب کرنے کی کوشش کرو، انہیں دائرہ اسلام میں لانے کی کوشش کریں

250
00:20:53,791 --> 00:20:57,174
تو آپ دیکھ سکتے ہیں کہ حضرت ابوبکر صدیقؓ کا معیار اس جنگ میں مختلف تھا

251
00:20:57,204 --> 00:21:06,880
 یعنی حروب الردّہ اور ان فتوحات میں جو دعوت و تبلیغ کی مقصد سے شروع ہوا ، جس کا مقصد لوگوں کو اللہ کے دین کی طرف بلانا تھا

252
00:21:06,928 --> 00:21:16,927
آپؓ نے اپنے لشکر کو حکم دیا کہ مرتدین کے خلاف لڑنے والوں کو اپنی فوج میں شامل کریں، اور اُن لوگوں کو جو رسول اللہؐ کے وصال کے بعد دین اسلام پر ثابت قدم رہے

253
00:21:16,955 --> 00:21:23,623
 جب تک میں حکم نہ دوں کسی سابق مُرتد کو اپنے لشکر میں شامل نہ کریں

254
00:21:23,668 --> 00:21:28,420
حضرت ابوبکرؓ اپنے سپہ سالاروں کو واضح ہدایات دے رہے تھے

255
00:21:28,458 --> 00:21:34,257
کہ آپ سابقہ مرتدین میں سے کسی کو اپنی فوجوں میں شامل نہ ہونے دو

256
00:21:34,293 --> 00:21:41,350
اگرچہ وہ اب مسلمان ہو چکے ہیں لیکن وہ آپ کے شانہ بشانہ نہیں لڑیں گے

257
00:21:41,389 --> 00:21:44,413
حضرت ابوبکر صدیقؓ نے یہ رویہ کیوں اختیار کیا؟

258
00:21:44,442 --> 00:21:50,627
جب کہ اس وقت آپؓ کو زیادہ سے زیادہ فوجی کمک کی ضرورت تھی

259
00:21:50,655 --> 00:21:52,955
أللہ أعلم، لیکن آپ کہہ یہ سکتے ہیں کہ

260
00:21:52,985 --> 00:22:03,080
 حضرت ابوبکر صدیقؓ ایسے ضعیف العقیدہ لوگوں کو لشکر میں شامل نہیں کرنا چاہتے تھے جنہوں نے ایک وقت میں اسلام سے روگردانی اختیار کی،

261
00:22:03,132 --> 00:22:06,637
کیونکہ شاید ان کی نیت خالص نہ ہو۔

262
00:22:06,688 --> 00:22:09,937
یہ جہاد فی سبیل اللہ کی جنگیں تھیں

263
00:22:09,985 --> 00:22:14,503
یہ مال غنیمت کی جنگیں نہیں تھیں، یہ توسیع کی جنگیں نہیں تھیں

264
00:22:14,542 --> 00:22:20,567
یہ غرور و تکبر کی جنگیں نہیں تھیں، یہ عوام الناس پر ظلم کرنے کی جنگیں نہیں تھیں

265
00:22:20,589 --> 00:22:22,750
ان کا مقصد لوگوں کو دین اسلام کی دعوت دینا تھا

266
00:22:22,774 --> 00:22:25,843
پس جو لوگ(سابقہ مرتد) پہلے اسلام چھوڑ چکے تھے

267
00:22:25,888 --> 00:22:28,683
وہ باہر جا کر لوگوں کو اسلام کی دعوت کیسے دے سکتے تھے؟

268
00:22:28,708 --> 00:22:30,361
حالانکہ وہ ابھی مسلمان تھے

269
00:22:30,391 --> 00:22:30,944
اور پھر آپؓ نے فرمایا؛

270
00:22:30,968 --> 00:22:31,850
 " حتى أرَا رائ"

271
00:22:31,887 --> 00:22:36,083
جب تک میں کوئی حتمی فیصلہ نہ کروں،

272
00:22:36,113 --> 00:22:37,973
حضرت ابوبکرؓ انتظار کرنا چاہتے تھے

273
00:22:38,003 --> 00:22:44,917
اس لیے جو لوگ ردّہ میں شریک تھے ان میں سے کسی کو بھی مسلمانوں کی فوجوں میں شامل ہونے کی اجازت نہیں دی گئی

274
00:22:44,960 --> 00:22:50,003
صورت حال کی پیچیدگی کو دیکھتے ہوئے آپؓ نے ایک خط بھیجا جس میں آپؓ نے فرمایا؛

275
00:22:50,041 --> 00:22:52,037
ولا تستفتح بمستكرح

276
00:22:52,635 --> 00:22:55,363
اور کسی بھی شخص کو اپنے ساتھ (جنگ پہ) چلنے پر مجبور نہ کریں

277
00:22:55,401 --> 00:22:59,234
 میدانِ جنگ کے مجاہدین جوآپ کے ساتھ پہلے سے موجود ہیں

278
00:22:59,277 --> 00:23:03,223
اگر وہ اگلے محاذ پہ نہیں جانا چاہتے تو انہیں ساتھ جانے پر مجبور نہ کریں

279
00:23:03,248 --> 00:23:10,037
کیونکہ یہ ایک رضاکارانہ جنگ ہے، یہ دفاعی جنگ نہیں ہے، یہ ایک جارحانہ جنگ ہے

280
00:23:10,085 --> 00:23:12,543
اس لیے اسی کو جہاد الطلب کہتے ہیں

281
00:23:12,568 --> 00:23:14,243
ایک جهادألطلب ہے اور ایک جهادألدفع ہے

282
00:23:14,268 --> 00:23:17,857
"جهادألدفع "وہ جہاد ہے جب آپ اپنا دفاع کر رہے ہوں، یہ سب کے لئے فرض عین ہے

283
00:23:17,897 --> 00:23:22,853
لیکن اب یہ "جهادألطلب" ہے، اس میں آپ کسی اور کی سرزمین پر حملہ کر رہے ہیں

284
00:23:22,878 --> 00:23:26,203
لہذا یہ رضاکارانہ جنگ ہے، یہ فرض عین نہیں ہے

285
00:23:26,254 --> 00:23:27,630
یہ فرض کفایہ ہے

286
00:23:27,655 --> 00:23:31,250
تو حضرت ابوبکرؓ نے اپنے سپہ سالاروں سے فرمایا کہ کسی کو اپنے ساتھ محاذ پہ چلنے کے لئے مجبور نہ کریں

287
00:23:31,281 --> 00:23:35,448
تو، مرتدین کو ممانعت تھی اور مسلمانوں کو جنگ کے لئے جانے پہ مجبور نہ کیا جائے،

288
00:23:35,478 --> 00:23:37,111
صورتِ حال پیچیدہ ہوگئی،

289
00:23:37,141 --> 00:23:45,610
لیکن حضرت ابوبکر صدیقؓ نے موقع کی نزاکت کو دیکھتے ہوئے یہ مناسب اور موزوں حکمتِ عملی اختیار کی

290
00:23:45,641 --> 00:23:48,403
حضرت خالدؓ نے خلیفہ سے فوجی کمک طلب کی

291
00:23:48,428 --> 00:23:53,103
میرا مطلب ہے،کچھ لوگ حضرت خالدؓ کا ساتھ چھوڑ رہے تھے

292
00:23:53,141 --> 00:23:57,267
وہ یکے بعد دیگرے مختلف محازوں پہ لڑتے لڑتے تھک چکے تھے، میرے کہنے کا مطلب یہ ہے کہ

293
00:23:57,351 --> 00:23:59,280
حضرت خالد بن ولیدؓ کے بارے میں بیان کیا گیا ہے

294
00:23:59,312 --> 00:24:01,890
لا ينام ولا يترك أحد ينام

295
00:24:02,142 --> 00:24:06,007
آپؓ  نہ خود آرام کرتے تھے اور نہ کسی کو آرام کرنے دیتے تھے

296
00:24:06,049 --> 00:24:09,237
دوست ہو یا دشمن، حضرت خالدؓ سب کو مصروفِ عمل رکھتے تھے

297
00:24:09,274 --> 00:24:16,237
میرا مطلب ہے کہ اگر آپ حضرت خالد بن ولیدؓ کا ریکارڈ دیکھیں تو آپؓ یکے بعد دیگرے ایک محاذ سے دوسرے محاذ پہ جا رہے تھے

298
00:24:16,267 --> 00:24:20,890
آپؓ آندھی طوفان کی طرح ایک محاز سے دوسرے محاز پر پہنچ جاتے تھے

299
00:24:20,916 --> 00:24:25,400
تو ظاہر ہے، آپؓ کے کچھ سپاہیوں کو آپؓ کے ساتھ رہنے میں مشکل پیش آرہی تھی

300
00:24:25,423 --> 00:24:30,100
تو کچھ سپاہی آپؓ کو خیرباد کہہ رہے تھے، اس لیے حضرت خالدؓ کمک طلب کر رہے تھے

301
00:24:30,129 --> 00:24:32,170
حضرت ابوبکرؓ کس کو بھیج سکتے تھے؟

302
00:24:32,195 --> 00:24:34,140
آپؓ لوگوں کو جنگ پہ جانے کے لئے مجبور نہیں کرنا چاہتے تھے،

303
00:24:34,170 --> 00:24:36,946
آپؓ مرتدین کو لشکر میں شامل ہونے کی اجازت نہیں دینا چاہتے تھے

304
00:24:36,970 --> 00:24:40,623
چنانچہ آپؓ نے حضرت خالدؓ کی طرف ایک آدمی "ألقعقاع بن عمرو" کو بھیجا

305
00:24:40,673 --> 00:24:43,293
چنانچہ خلیفہ سے کہا گیا

306
00:24:43,323 --> 00:24:48,517
کیا آپ اس آدمی(حضرت خالدؓ) کی طرف کمک کی صورت میں صرف ایک آدمی بھیج رہے ہیں جس کے سپاہیوں نے میدان میں اسے تنہا کردیا ہے؟

307
00:24:48,542 --> 00:24:50,323
حضرت ابوبکر صدیقؓ نے فرمایا؛

308
00:24:50,357 --> 00:24:55,037
 کیا ایسی فوج کو شکست ہو سکتی ہے جس میں اس آدمی(ألقعقاع بن عمروؓ )جیسا سپاہی ہو؟

309
00:24:55,071 --> 00:25:00,103
اگر "ألقعقاع" فوج میں ہے تو فکر نہ کریں،اُس فوج کو شکست نہیں ہوگی

310
00:25:00,118 --> 00:25:06,340
چنانچہ آپؓ نے صرف ایک آدمی کو حضرت خالد بن ولیدؓ کے پاس کمک کے طور پر بھیجا

311
00:25:06,364 --> 00:25:14,603
حضرت خالد بن ولیدؓ عراق میں داخل ہوئے اور آپؓ کو تمام افواج کا سپہ سالارِ اعلیٰ مقرر کر دیا گیا

312
00:25:14,656 --> 00:25:19,423
 اس لیے اب آپؓ کی کمان میں اٹھارہ ہزار(18,000)سپاہی تھے

313
00:25:19,452 --> 00:25:27,467
تو حضرت خالد بن ولیدؓ نے پیغام بھیجا اور یہ ہمارے سپہ سالاروں کی سنت تھی

314
00:25:27,492 --> 00:25:31,323
جنگ سے پہلے وہ لوگوں کو دین کی دعوت دینے کے لئے خط بھیجتے تھے

315
00:25:31,348 --> 00:25:38,300
چنانچہ حضرت خالدؓ نے "ألهرمزان" کو خط بھیجا، جو "ألأبلَّى" کے علاقے میں تھا

316
00:25:38,325 --> 00:25:41,020
جو بصرہ کے بہت قریب ہے

317
00:25:41,045 --> 00:25:44,350
آپؓ نے خط میں فرمایا؛ میں تمہیں توحیدِ الٰہی اور اسلام کی دعوت ہوں

318
00:25:44,380 --> 00:25:47,937
اگر تم نے میری دعوت قبول کی تو ہم آپ سب کو مسلمان تصور کریں گے

319
00:25:47,973 --> 00:25:51,003
آپ کو تمام سہولیات میسر ہوں گی، جو کہ آپ کو رعایا سے ملیں گی

320
00:25:51,023 --> 00:25:54,424
 لیکن آپ کو مسلمان حکمران کی طرح تمام فرائض و زمہ داریوں کا بار اُٹھانا ہوگا

321
00:25:54,448 --> 00:25:58,200
 اگر آپ انکار کرتے ہیں تو آپ کو ہر صورت جزیہ ادا کرنا ہوگا

322
00:25:58,244 --> 00:25:59,997
اگرآپ جزیہ کی ادائیگی سے انکار کریں گے

323
00:26:00,023 --> 00:26:02,776
تو میں تمہارے اوپر قبائلی لوگوں کو لے کر آؤں گا

324
00:26:02,800 --> 00:26:06,633
جو موت کے ایسے تمنائی ہیں جیسے کہ تم زندگی کی تمنا رکھتے ہو

325
00:26:06,662 --> 00:26:10,557
پھر ہم تم سے اس وقت تک لڑیں گے جب تک اللہ ہمارے اور تمہارے درمیان فیصلہ نہ کر دے

326
00:26:10,600 --> 00:26:15,450
آپؓ نے بہت فیصلہ کُن، واضح، مدلل انداز میں بغیر لفاظی کے مدعا پیش کیا

327
00:26:15,470 --> 00:26:19,233
آپؓ نے یہ خط بھیجا، ألهرمزان نے انکار کردیا اور اس نے جنگ لڑنے کا فیصلہ کیا

328
00:26:19,274 --> 00:26:25,763
چنانچہ وہ میدان جنگ میں اُترے اور اس جنگ کو معركة السلاسل کہا گیا، یعنی یہ جنگ زنجیروں کی جنگ کے نام سے مشہور ہوئی

329
00:26:25,795 --> 00:26:33,117
کیونکہ دشمن اتنے بزدل تھے کہ انہیں ایک دوسرے کے ساتھ زنجیروں کے زریعے پابند ہونا پڑا

330
00:26:33,164 --> 00:26:35,383
تاکہ وہ میدان میں پیٹھ نہ پھیر سکیں

331
00:26:35,430 --> 00:26:42,503
جب کہ مسلمان شہادت کی موت کے لئے اس قدر بے تاب تھے، کہ اُن کی رفتار کو کم کرنے کے لئے انہیں زنجیروں کی ضرورت تھی

332
00:26:42,552 --> 00:26:47,137
 اور وہ دشمن پابندِ سلاسل ہے تاکہ وہ میدان سے فرار نہ ہوسکیں

333
00:26:47,162 --> 00:26:52,387
یہ دشمن کے لیے عبرتناک شکست تھی

334
00:26:52,415 --> 00:26:57,013
حضرت خالد بن ولیدؓ نے فوراً" ألمضار" کی طرف پیش قدمی کی، دشمن کے لئے ایک اور شکست تھی

335
00:26:57,052 --> 00:26:58,560
 "ألولجة"

336
00:26:58,604 --> 00:27:06,087
جب آپؓ "ألولجة" پہنچے تو اب آپؓ عراق کے دلکش مقامات میں داخل ہو رہے تھے جو کہ کھیتی باڑی اور پیداوار کے لحاظ سے بہت  حَسِین شمار ہوتے تھے

337
00:27:06,110 --> 00:27:10,370
چنانچہ حضرت خالد بن ولیدؓ نے جنگ سے پہلے اپنے لشکر سے خطاب کیا

338
00:27:10,395 --> 00:27:16,018
آپؓ نے فرمایا؛ تم اس زمین کی ساری پیداوار نہیں دیکھ سکتے؟

339
00:27:16,047 --> 00:27:25,690
اللہ کی قسم! اگر رضائے الٰہی کے لئے جہاد کرنا، اور لوگوں کو اسلام کی دعوت دینا ہم پر لازم نہ ہوتا

340
00:27:25,723 --> 00:27:28,953
اور اگر ہمارے پاس روزی کمانے کے سوا کوئی خیال اور مقصودِ حیات نہ ہوتا

341
00:27:28,978 --> 00:27:34,503
دانشمند رائے یہی ہوتی کہ ہم ان زرخیز دیہی علاقوں پر اس وقت تک حملے کرتے رہتے، جب تک اس پر قبضہ نہ کر لیتے

342
00:27:34,536 --> 00:27:39,883
اور یہ کہ ہم بھوک و افلاس اور غربت کو چھوڑ دیں اور اُسے بھی، جو پیچھے رہ گیا اور تمہارے ساتھ شامل نہ ہو سکا

343
00:27:39,920 --> 00:27:42,577
حضرت خالد بن ولیدؓ اس مبارک سرزمین کو دیکھ رہے تھے

344
00:27:42,616 --> 00:27:47,599
آپؓ فرما رہے تھے؛ اگر ہم پر جہاد فرض نہ ہوتا اور دعوت و تبلیغِ دین ہم پر فرض نہ ہوتی

345
00:27:47,626 --> 00:27:53,880
صرف اس سرزمین کی خوبصورتی اور اس کی زرخیزی، ہمیں اپنی طرف راغب کرنے کے لیے کافی تھی

346
00:27:53,915 --> 00:27:57,263
اور پھر حضرت خالدؓ نے فرمایا؛ چلو دنیاوی ہوس اُن(اہلِ کتاب) پہ چھوڑ دو

347
00:27:57,317 --> 00:27:59,060
تثاقل عما أنتم عليه

348
00:27:59,246 --> 00:28:03,023
ان لوگوں کے لیے جو دنیاداری کے جھمیلوں اور عیش و عشرت میں پڑے ہوئے ہیں

349
00:28:03,059 --> 00:28:09,110
جو اللہ کی راہ میں لڑنا نہیں چاہتے انھیں غربت کی زندگی گزارنے کے لئے چھوڑ دیں

350
00:28:09,149 --> 00:28:13,263
اور سبحان اللہ، اگرچہ جہاد کا مقصد مالِ غنیمت کا حصول نہیں ہوتا

351
00:28:13,288 --> 00:28:15,537
 نہ ہی جہاد مال غنیمت اور روزی روٹی کے لیے کیا جاتا ہے

352
00:28:15,569 --> 00:28:25,010
لیکن اللہ کی طرف سے انعام کے طور پر، اللہ عَزَّوَجَلْ مجاہدین کو مال و دولت سے نوازتا ہے اور طویل عمر عطا فرماتا ہے

353
00:28:25,048 --> 00:28:30,167
اور جو لوگ پیچھے رہ جاتے ہیں(جہاد سے روگردانی کرتے ہیں) اللہ ان پہ بوجھ ڈال کر اُنھیں موت دیتا ہے

354
00:28:30,212 --> 00:28:35,223
اور وہ بزدلی، مایوسی، ذلت کی زندگی گزارتے ہیں

355
00:28:35,270 --> 00:28:42,903
اگر ہم مرنے والے مسلمانوں کی تعداد کو گراف(دو مختلف مقداروں کا آپس میں مقابلہ) میں ظاہر کریں، جب انہوں نے جہاد کیا اور جب انہوں نے جہاد سے پہلوتہی اختیار کی

356
00:28:42,936 --> 00:28:49,293
آپ کو پتہ چلے گا کہ جب مسلمان میدانِ جہاد میں لڑتے تھے تو شرح اموات کم تھیں

357
00:28:49,318 --> 00:28:53,543
اور جب انھوں نے جہاد سے روگردانی اختیار کی تو مسلمانوں کی شرح اموات لاکھوں تک پہنچ گئی

358
00:28:53,578 --> 00:28:59,890
تو جہاد دراصل زندگی کا تحفظ ہے، حالانکہ یہ جان کی بازی ہارنے کے مترادف لگتا ہے

359
00:28:59,946 --> 00:29:07,190
اب حضرت خالد بن ولیدؓ لوگوں کو اس سرزمین یا انواع و اقسام کے کھانوں یا زمین سے حاصل ہونے والی خوراک کی طرف راغب نہیں کر رہے

360
00:29:07,210 --> 00:29:08,737
 آپؓ اپنے لشکر سے صرف یہ فرمارہے تھے کہ

361
00:29:08,784 --> 00:29:14,240
میرا مطلب ہے، ہمارے پاس ایک عظیم مقصد ہے، ہم مالِ غنیمت کی خاطر جہاد نہیں کر رہے

362
00:29:14,265 --> 00:29:20,117
بلکہ مالِ غنیمت ہماری جدوجہد کے ثانوی ثمرات کے طور پر آتا ہے

363
00:29:20,142 --> 00:29:23,180
مالِ غنیمت جہاد میں ضمنی پیداوار کے طور پر آتا ہے

364
00:29:23,231 --> 00:29:29,190
اور علمائے ربانی نے جہاد کی نیت اللہ کی رضا کے لیے خالص کرنے کے معاملے پر بات کی ہے

365
00:29:29,224 --> 00:29:32,150
اور خالصتـََا مالِ غنیمت کے لئے بھی لڑنے پہ بات ہوئی ہے

366
00:29:32,191 --> 00:29:36,277
بعض علماء کے نزدیک جہاد کی نیت مالِ غنیمت کے حصول کے لئے قابلِ قبول ہے اور بعض کہتے ہیں کہ نہیں

367
00:29:36,332 --> 00:29:39,330
نیت خالص اللہ کے لیئے جنگ لڑنے کی ہونی چاہئے

368
00:29:39,378 --> 00:29:43,327
لیکن یہ فقہ کا مسئلہ ہے، ہم اس بحث میں نہیں پڑتے

369
00:29:43,376 --> 00:29:45,830
دشمن کی ایک اور شکست

370
00:29:45,874 --> 00:29:49,779
میرا مطلب ہے کہ حضرت خالد بن ولیدؓ کے لئے فتوحات کا ایک لامتناہی سلسلہ ہے

371
00:29:49,819 --> 00:29:52,057
میرا مطلب ہے، ہم یہ کہتے رہیں گے کہ آپؓ کو فتح ہوئی، آپؓ جنگ جیت گئے، آپؓ نے میدان مار لیا

372
00:29:52,103 --> 00:29:55,840
کیونکہ آپؓ کے ساتھ یہی صورتحال رہی، آپؓ کو کبھی شکست نہیں ہوئی

373
00:29:55,883 --> 00:30:04,643
أليس اور أمكيشية کے معرکوں میں بھی، آپؓ نے ایک بار پھر دشمن کو شکست دی اور اس جنگ میں دشمن کی بڑی تعداد ماری گئی

374
00:30:04,683 --> 00:30:11,277
چنانچہ یہ تمام جیت کی خبریں حضرت ابوبکر صدیقؓ کو یکے بعد دیگرے مل رہی تھیں

375
00:30:11,308 --> 00:30:13,187
 تو حضرت ابوبکر صدیقؓ نے فرمایا؛

376
00:30:13,212 --> 00:30:19,440
اے قریش کے لوگو! تمہارے شیر(حضرت خالدؓ) نے دشمن کے شیر پر حملہ کر کے اسے پچھاڑ دیا ہے

377
00:30:19,460 --> 00:30:22,210
 اپنے شکار کے حصے بخرے کرتے ہوئے

378
00:30:22,266 --> 00:30:28,330
اور پھر آپؓ نے فرمایا؛ عورتیں کبھی بھی "خالدؓ" جیسے سپوت کو جنم نہیں دے سکیں گی

379
00:30:28,375 --> 00:30:32,037
عورتیں اس طرح کے مردِ مجاہد کو جنم نہیں دے سکتیں

380
00:30:32,062 --> 00:30:35,197
چنانچہ اب وہ حیرہ پہنچ گئے

381
00:30:35,248 --> 00:30:37,526
حضرت خالد بن ولیدؓ نہ صرف لڑائی میں ماہر تھے

382
00:30:37,566 --> 00:30:44,037
 بلکہ آپؓ بہت اچھے سفارت کار بھی تھے اور آپؓ بہت سے مواقع پر کامیاب ہوئے

383
00:30:44,074 --> 00:30:48,490
لوگوں کو اپنی گفتگو سے اپنا مطیع بنانے اور بغیر لڑائی کے دشمن سے ہتھیار ڈالنے میں آپؓ کامیاب ہوئے

384
00:30:48,519 --> 00:30:56,437
چنانچہ آپؓ نے حیرہ کے قلعوں یا بروج کے چار ممتاز اور اہم سرداروں سے گفتگو کی

385
00:30:56,491 --> 00:30:59,543
اور یہ عیسائی عرب تھے

386
00:30:59,577 --> 00:31:07,177
چنانچہ آپؓ نے انھیں تین انتخاب دئیے کہ مسلمان ہو جائیں یا جزیہ ادا کریں یا جنگ کریں

387
00:31:07,227 --> 00:31:10,063
تو انہوں نے کہا؛ ہم جزیہ ادا کریں گے

388
00:31:10,113 --> 00:31:13,710
حضرت خالدؓ نے ان سے فرمایا؛ تم ہلاک ہو جاؤ، تم پر افسوس ہے

389
00:31:13,754 --> 00:31:18,030
کفر ایک ایسا صحرا ہے جو انسان کو بھٹکا دیتا ہے

390
00:31:18,077 --> 00:31:22,530
عربوں میں سے صرف احمق ہی اس کی پیروی کرے گا

391
00:31:22,562 --> 00:31:26,717
اور اس سے یہ بھی معلوم ہوتا ہے کہ جہاد کی نیت جزیہ نہیں تھی، مال ودولت کا حصول نہیں تھا

392
00:31:26,756 --> 00:31:30,423
کیونکہ اگر لوگ مسلمان نہ ہوتے تو مسلمانوں کی مالی حالت زیادہ بہتر ہوتی

393
00:31:30,477 --> 00:31:36,267
مالی طور پہ جزیہ کی ادائیگی کی وجہ سے لوگوں کا اسلام قبول نہ کرنا حکومت کے لئے بہتر ہوتا

394
00:31:36,321 --> 00:31:38,579
لہٰذا، یہ لوگ خطیر رقم ادا کرنے پر راضی ہوگئے لیکن

395
00:31:38,604 --> 00:31:41,103
حضرت خالد بن ولیدؓ نے ان سے فرمایا؛ تم پر افسوس، خدا تمہیں غارت کرے

396
00:31:41,128 --> 00:31:47,570
کیا تم میں یہ شعور نہیں ہے کہ کفر ایک صحرا ہے جو انسان کو بھٹکا دیتا ہے

397
00:31:47,627 --> 00:31:50,497
لیکن وہ اپنی بات پہ مُصررہے اور کہنے لگا؛ ہم مسلمان نہیں ہونا چاہتے

398
00:31:50,522 --> 00:31:52,820
چنانچہ حضرت خالد بن ولیدؓ جانتے تھے کہ

399
00:31:52,855 --> 00:31:56,557
فو اللَّهِ لأنْ يهْدِيَ اللَّه بِكَ رجُلًا واحِدًا خَيْرٌ لكَ من حُمْرِ النَّعم

400
00:31:56,592 --> 00:32:02,223
اللہ کے نزدیک آپ کے توسط(ذریعے) سے ایک آدمی کو ہدایت دینا اونٹوں کے ریوڑ سے بہتر ہے

401
00:32:02,263 --> 00:32:04,067
بخاری میں یہ حدیث ہے

402
00:32:04,106 --> 00:32:06,402
چنانچہ انہوں نے حضرت خالد بن ولیدؓ سے تحریری معاہدہ طے کیا،آپؓ نے تحریر لکھی؛

403
00:32:06,427 --> 00:32:09,863
شروع اللہ کے نام سے جو بہت مہربان، نہایت رحم کرنے والا ہے

404
00:32:09,910 --> 00:32:16,383
یہ عہد ہے جو خالد بن ولیدؓ نے فلاں، فلاں چار سرداروں سے طے کیا ہے

405
00:32:16,414 --> 00:32:23,337
 حضرت خالدؓ نے انہیں سالانہ ایک لاکھ نوے ہزار درہم کے جزیہ کی ادائیگی کے عوض یہ(امن کا) ایک عہد دیا ہے

406
00:32:23,379 --> 00:32:28,673
 اُن افراد کا جزیہ جو دنیاداری کے کام دھندوں میں مشغول ہیں، بشمول ان کے راہب اور پادریوں کے،

407
00:32:28,709 --> 00:32:34,377
ما سوائے ان لوگوں کے جو تارک الدنیا ہیں یا وہ جو سفر میں ہیں

408
00:32:34,407 --> 00:32:40,050
دوسرے لفظوں میں وہ راہب جو خانقاہوں میں ہیں

409
00:32:40,090 --> 00:32:45,690
اور زہد و عقیدت کی زندگی گزار رہے ہیں اور دنیا سے دور ہیں جزیہ ادا نہیں کریں گے

410
00:32:45,724 --> 00:32:50,357
 لیکن دیگر راہب جو معمول کی دنیاوی زندگی گزار رہے ہیں انہیں جزیہ کی ادائیگی کرنی ہوگی

411
00:32:50,389 --> 00:32:52,617
حضرت خالدؓ نے انہیں تحفظ دینے کا وعدہ کیا

412
00:32:52,658 --> 00:32:58,270
تو وہ جزیہ دیں گے اور مسلمان اُن کے تحفظ کا وعدہ کرتے ہیں، اگر حضرت خالدؓ انھیں(غیر مسلموں) تحفظ نہیں دے سکے

413
00:32:58,302 --> 00:33:01,544
پھر ان پر جزیہ یا کوئی بھی ادائیگی فرض نہیں ہے، جب تک کہ مسلمان ان کی حفاظت نہ کریں

414
00:33:01,584 --> 00:33:05,317
اس لیے اگر مسلمان ان کی حفاظت نہ کر سکے تو وہ انھیں ان کی رقم (جزیہ) واپس کرنے کے پابند ہوں گے

415
00:33:05,342 --> 00:33:08,617
اگر وہ دھوکہ دیں یا اپنی زبان یا عہد سے پِِھر جائیں

416
00:33:08,666 --> 00:33:12,983
پھر مسلمان ان(غیر مسلموں) کی ہر قسم کی ذمہ داری سے آزاد ہیں

417
00:33:13,017 --> 00:33:16,463
چنانچہ یہ حضرت خالد بن ولیدؓ اور اہل حیرہ کے درمیان معاہدہ تھا

418
00:33:16,497 --> 00:33:20,977
لہٰذا اب "حیرہ" عراق میں مسلم افواج کا نیا مرکز تھا

419
00:33:21,020 --> 00:33:25,970
اب حضرت خالد بن ولیدؓ فارس کے بادشاہوں کو خط بھیج رہے تھے

420
00:33:26,005 --> 00:33:29,230
آپؓ کے پاس ان(فارسی سلاطین) کی سرزمین پہ ایک مضبوط مرکز تھا

421
00:33:29,270 --> 00:33:35,123
اس لیے اب آپؓ نے اپنے تمام سرکردہ رہنماؤں کو خط بھیجنے کا قدم اٹھایا

422
00:33:35,178 --> 00:33:41,567
مراسلے کا ایک نسخہ بادشاہوں کو بھیجا گیا اور دوسرا نسخہ گورنروں کو بھیجا گیا

423
00:33:41,600 --> 00:33:44,367
بادشاہوں کو جو خط کا نسخہ بھیجا گیا؛

424
00:33:44,406 --> 00:33:47,430
شروع اللہ کے نام سے جو بڑا مہربان نہایت رحم والا ہے

425
00:33:47,461 --> 00:33:50,790
خالد ابن ولیدؓ کی طرف سے فارس کے بادشاہوں کے نام

426
00:33:50,844 --> 00:33:53,957
اللہ کا شکر ہے جس نے تُمہاری حکومت کو تحلیل کیا

427
00:33:53,989 --> 00:33:58,437
تمہاری تدبیر کو کمزور کر دیا اور تمہیں آپس میں تقسیم کر دیا

428
00:33:58,474 --> 00:34:03,380
اس لیے ہمارے عقیدہ توحید پہ ایمان لے آؤ، ہم تمہیں اور تمہاری زمین کو خالی کردیں گے

429
00:34:03,403 --> 00:34:06,943
اور آپ کو چھوڑ کر آگے بڑھ جائیں گے ،دیگر مختلف لوگوں تک یہ پیغام پہنچائیں گے

430
00:34:06,986 --> 00:34:09,903
اگر نہیں، تو یہ(دعوت کا پھیلنا) بہرحال ہوگا

431
00:34:09,945 --> 00:34:14,860
مطلب مسلمان بنو تا کہ ہم تم سے آگے بڑھ کر دوسروں کو دعوت دے سکیں

432
00:34:14,906 --> 00:34:20,497
اگر تم مسلمان نہیں ہوئے تو پھر بھی ایسا ہی ہو گا، ہم تمہیں زِیر کر کے دوسروں تک پہنچیں گے

433
00:34:20,510 --> 00:34:24,084
اگر نہیں، تو بہرحال یہی ہوگا، چاہے تم جتنے بھی کبیدہ خاطر ہو جاؤ

434
00:34:24,126 --> 00:34:30,064
 وہ بزورِ طاقت آپ پر غالب آئیں گے جو موت کو ایسے پسند کرتے ہیں، جیسے تم زندگی سے پیار کرتے ہو

435
00:34:30,106 --> 00:34:35,424
اب اس خط نے ان کے بادشاہوں کو حیرت میں ڈال دیا،یہ اُن کے لئے ناقابلِ یقین بات تھی

436
00:34:35,481 --> 00:34:39,058
یہ لوگ(مسلمان) اچانک کہیں سے نکل کر ہماری سرزمین میں ٹھکانہ قائم کر چکے ہیں

437
00:34:39,100 --> 00:34:42,251
اور پھر ہم سے دھمکی آمیز جارحانہ اندازِ گفتگو میں کہہ رہے ہیں کہ یا تو مسلمان ہو جاؤ ورنہ

438
00:34:42,308 --> 00:34:51,138
 اور ان انتہائی سخت اور دوٹوک انداز نے انہیں نہ صرف غصے سے پاگل کر دیا اور وہ طیش میں آ گئے

439
00:34:51,174 --> 00:34:55,491
کیونکہ جب رسول اللہؐ نے فارس کے بادشاہ(کسریٰ) کو خط بھیجا تو اس نے کیا کیا؟

440
00:34:55,541 --> 00:34:58,598
دیکھیں یہ ایک عظیم الشان سلطنت تھی، وہ(فارسی) بڑے مغرور اور متکبر تھے

441
00:34:58,650 --> 00:35:01,784
اس(کسریٰ) نے رسول اللہؐ کا خط پھاڑ دیا

442
00:35:01,825 --> 00:35:04,191
یہ خبر سن کر رسول اللہؐ مسکرائے اور فرمایا؛

443
00:35:04,239 --> 00:35:05,801
مضَّك الله ملكة

444
00:35:05,950 --> 00:35:09,698
اللہ اس کی سلطنت کو ٹکڑے ٹکڑے کر دے گا

445
00:35:09,731 --> 00:35:14,388
حضرت خالدؓ نے گورنروں کو خطوط بھیجے، یہ مختلف ریاستوں کے گورنر تھے

446
00:35:14,415 --> 00:35:17,511
شروع اللہ کے نام سے جو بہت مہربان اور نہایت رحم کرنے والا ہے

447
00:35:17,556 --> 00:35:20,898
خالد بن ولیدؓ کی طرف سے فارس کے گورنروں کے نام

448
00:35:20,938 --> 00:35:23,978
اسلام قبول کرو تاکہ تم(جنگ وجدل سے) محفوظ رہو

449
00:35:24,011 --> 00:35:28,731
 اگر اسلام نہیں لاتے تو مجھ سے امن کا معاہدہ کرو اور جزیہ ادا کرو

450
00:35:28,761 --> 00:35:36,238
 ورنہ میں تمہارے مدِمقابل ایسی قوم لایا ہوں جو موت کو اسی طرح پسند کرتے ہیں جس طرح تم شراب پینا پسند کرتے ہو

451
00:35:36,279 --> 00:35:42,064
حضرت خالد بن ولیدؓ کے ساتھ حیرہ میں ایک کرامت بھی ظاہر ہوئی

452
00:35:42,099 --> 00:35:47,518
حیرہ کے لوگوں کے سرداروں میں سے ایک سردار جس نے حضرت خالدؓ کے ساتھ معاہدہ کیا تھا

453
00:35:47,556 --> 00:35:50,544
 اس شخص نے اپنی کمر بند پہ کچھ لپیٹ کرچھپا رکھا تھا

454
00:35:50,594 --> 00:35:52,451
تو حضرت خالد بن ولیدؓ نے اسے پکڑ لیا

455
00:35:52,500 --> 00:35:55,491
اور اسے اپنے ہاتھ پہ ڈالا اور پوچھا؛ یہ کیا ہے؟

456
00:35:55,516 --> 00:35:56,090
تو اس آدمی نے کہا؛

457
00:35:56,141 --> 00:35:58,321
هذا ولله صم الساعة""

458
00:35:58,346 --> 00:36:02,891
یہ وہ زہر ہے جو انسان کو فوراً مار ڈالتا ہے؟

459
00:36:02,924 --> 00:36:04,908
حضرت خالد بن ولیدؓ نے فرمایا؛ تم نے یہ کیوں اُٹھا رکھی ہے؟

460
00:36:04,954 --> 00:36:10,734
وہ شخص کہنے لگا؛ کیونکہ میں دیکھنا چاہتا تھا کہ تم لوگ سچے ہو یا نہیں؟

461
00:36:10,763 --> 00:36:15,131
کیونکہ اگر مسلمان حق پہ نہیں ہیں تو میں اپنے لوگوں کو آپ سے بچانے کے لیے آپ کو مارنے کی کوشش کروں گا

462
00:36:15,177 --> 00:36:20,624
تو وہ شخص یہ جاننا چاہتا تھا کہ کیا یہ لوگ واقعی حق وصداقت کاپرچار کر رہے ہیں یا نہیں؟

463
00:36:20,681 --> 00:36:22,598
حضرت خالد بن ولیدؓ نے فرمایا؛

464
00:36:22,642 --> 00:36:23,684
" بسم الله "

465
00:36:23,728 --> 00:36:25,324
شروع اللہ کے نام سے

466
00:36:25,349 --> 00:36:28,281
ألذي لا يضرُّ ما إسمه شيءٌ في ألسموات والأرض

467
00:36:28,509 --> 00:36:29,196
" بسم الله "

468
00:36:29,221 --> 00:36:30,529
 شروع اللہ کے نام سے

469
00:36:30,580 --> 00:36:34,591
جس کے نام کی برکت سے زمین و آسمانوں میں کوئی چیز آپ کو نقصان نہیں پہنچا سکتی

470
00:36:34,616 --> 00:36:38,158
اور آپؓ نے وہ زہر نگلنا چاہا

471
00:36:38,199 --> 00:36:44,311
تو حضرت خالدؓ کے اردگرد موجود ہر شخص آگے بڑھا اور اُنہیں روکا کہ یہ کیا کرنے جا رہے ہو؟

472
00:36:44,356 --> 00:36:48,768
اور آپؓ ان سے زیادہ برق رفتار تھے اور آپؓ نے وہ سارا زہر نگل لیا

473
00:36:48,812 --> 00:36:52,298
تو وہ آدمی اس پر چونک گیا

474
00:36:52,323 --> 00:36:57,658
اور وہ شخص کہنے لگا؛ اگر یہ سچ ہے تو تم لوگ دنیا پر حکومت کرنے والے ہو

475
00:36:57,695 --> 00:37:00,551
اور حضرت خالد بن ولیدؓ کو کچھ نہ ہوا، آپؓ کو کوئی نقصان نہیں پہنچا

476
00:37:00,601 --> 00:37:03,958
اب، یہ ایک بہت ہی حیرت انگیز کرامت تھی

477
00:37:03,992 --> 00:37:08,081
ہمارے بہت سے علماء نے اس روایت کا ذکر کیا ہے اور انہوں نے اسے ضعیف نہیں کہا

478
00:37:08,107 --> 00:37:15,051
اس روایت کو طبریؒ، ابن سعدؒ، ابن کثیرؒ، ابن حجرؒ، ابن تیمیہؒ ، سب نے اس قصے کا ذکر کیا ہے

479
00:37:15,099 --> 00:37:20,598
پس یہ حقیقت ہے کہ یہ مستند روایت ہے کیونکہ اس کا ذکر بہت سارے ذرائع سے ہوا ہے

480
00:37:20,644 --> 00:37:23,619
حضرت خالد بن ولیدؓ ایسا نہیں کرتے

481
00:37:23,644 --> 00:37:30,118
اگر آپؓ کو ذرا سا بھی شبہ ہوتا کہ آپؓ مَر جائیں گے کیونکہ پھر یہ خودکشی ہوتی

482
00:37:30,161 --> 00:37:33,481
چنانچہ جب حضرت خالد بن ولیدؓ نے یہ عمل کیا تو آپؓ یقینِ کامل کے بلند درجے پر تھے

483
00:37:33,521 --> 00:37:37,398
اور اللہ سبحانہ و تعالیٰ نے آپؓ کے دل پہ القاء(الہامی خیال) نازل کیا کہ کوئی چیز آپؓ کو نقصان نہیں پہنچائے گی

484
00:37:37,435 --> 00:37:45,698
اور یہ کہ آپ جو دعا مانگ رہے ہیں، وہ ایک تلوار ہے، جو آپ کے دشمن کو تباہ کر دے گی

485
00:37:45,736 --> 00:37:50,791
اور چونکہ دعا تلوار کی مانند ہے، اگر یہ کمزور ہاتھ میں ہو تو باریاب نہیں ہوگی

486
00:37:50,838 --> 00:37:55,484
آپ نے دیکھا کہ ہم کہتے ہیں کہ ہم دعا کرتے ہیں لیکن اللہ ہماری دعا قبول نہیں فرماتا

487
00:37:55,533 --> 00:37:59,384
مسئلہ دعا میں نہیں ہے، مسئلہ دعا مانگنے والے میں ہے

488
00:37:59,440 --> 00:38:03,011
کیونکہ دعا تلوار کی مانند ہے، یہ بہت تیزدھار ہے

489
00:38:03,049 --> 00:38:04,981
مسئلہ تلوار اٹھانے والے کا ہے

490
00:38:05,010 --> 00:38:08,621
کچھ لوگ مضبوط(مظبوط ایمان والے) ہیں وہ اسے استعمال کرسکتے ہیں اور کچھ لوگ کمزور ایمان ہیں وہ فیض یاب نہیں ہوسکتے

491
00:38:08,638 --> 00:38:13,118
تو مسئلہ خود تلوار کا نہیں ہے مسئلہ اس کا ہے جس نے اسے تھام رکھا ہے

492
00:38:13,154 --> 00:38:15,755
حضرت خالد بن ولیدؓ کا اللہ عَزَّوَجَلْ پہ کامل یقین تھا آپؓ نے یہ دعا پڑھی

493
00:38:15,780 --> 00:38:19,391
شروع اللہ کے نام سے، اللہ عَزَّوَجَلْ کا ذکر کیا اور آپؓ نے وہ زہر نگل لیا

494
00:38:19,431 --> 00:38:27,011
اور آپؓ کو کچھ نہیں ہوا، یہ وہ کرامت تھی جو حضرت خالد بن ولیدؓ کے ساتھ ظاہر ہوئی

495
00:38:27,048 --> 00:38:32,271
آپؓ دشمن کونیست و نابود کرتے ہوئے"الانبار" کی طرف بڑھے،"عین تمر" میں بھی یہی طرزِعمل تھا

496
00:38:32,299 --> 00:38:33,266
دومة الجندل میں بھی دشمن کو شکست دی

497
00:38:33,296 --> 00:38:35,798
اور اب حضرت خالد بن ولیدؓ عراق سے نکل چکے تھے

498
00:38:35,822 --> 00:38:45,238
اور آپؓ عرب اور سلطنتِ روم و فارس کے عین وسطی مقام، دومة الجندل پر پہنچ گئے جو انتہائی حساس مقام شمار ہوتا تھا

499
00:38:45,287 --> 00:38:46,551
تو حضرت خالدؓ دومۃ الجندل میں داخل ہو گئے

500
00:38:46,575 --> 00:38:50,900
اور رسول اللہؐ بھی اپنی زندگی میں ہی دومۃ الجندل میں دلچسپی رکھتے تھے

501
00:38:50,925 --> 00:38:55,478
چنانچہ آپﷺ نے "دومة الجندل" کی طرف فوجیں روانہ کیں کیونکہ یہ بہت اہم اور حساس مقام تھا

502
00:38:55,527 --> 00:39:01,924
یہ ایک تکون نما ہے جہاں جزیرہ نما عرب ،عراق اور رومی سلطنت سے ملتا ہے

503
00:39:01,961 --> 00:39:07,354
چنانچہ حضرت خالد بن ولیدؓ اب "دومۃ الجندل" کی طرف بڑھ رہے تھے اور آپؓ برق رفتاری سے آگے بڑھ رہے تھے

504
00:39:07,379 --> 00:39:10,664
 پس یہ خبر "دومۃ الجندل" تک پہنچی

505
00:39:10,698 --> 00:39:14,518
دومۃ الجندل دو آدمیوں کی زیرِ قیادت تھا، ان میں سے ایک کا نام" اوکیدر" تھا

506
00:39:14,543 --> 00:39:21,714
أوكيدر نے رسول اللہؐ کے ساتھ صلح کا معاہدہ کیا اور پھر اسے توڑ دیا

507
00:39:21,752 --> 00:39:28,144
ہوا یہ کہ حضرت خالد بن ولیدؓ، اوکیدر کو گرفتار کر کے مدینہ لے گئے

508
00:39:28,186 --> 00:39:29,903
 چنانچہ أوكيدر نے رسول اللہؐ سے ملاقات کی

509
00:39:29,935 --> 00:39:33,538
اور اس نے رسول اللہؐ سے وعدہ کیا کہ اب وہ آپؐ کی مخالفت نہیں کرے گا

510
00:39:33,575 --> 00:39:38,304
تو رسول اللہؐ نے اسے امان دی، صلح کا عہد دیا، چنانچہ وہ چلا گیا

511
00:39:38,353 --> 00:39:42,678
لیکن پھر أوكيدر نے رسول اللہؐ سے کیے گئے عہد کی خلاف ورزی کی

512
00:39:42,715 --> 00:39:46,651
اور مسلمانوں کے خلاف ہو گیا، تو یہ أوكيدر کا پسِ منظر ہے

513
00:39:46,684 --> 00:39:50,904
أوكيدر اب خبر سن رہا تھا کہ خالدؓ ہماری طرف پیش قدمی کر رہا ہے

514
00:39:50,943 --> 00:39:53,958
اور اوکیدر حضرت خالدؓ کو جانتا تھا، اسے حضرت خالدؓ نے گرفتار کیا تھا، وہ کہنے لگا؛

515
00:39:53,983 --> 00:39:57,864
"میں خالد کے بارے میں تم سب سے زیادہ جانتا ہوں"

516
00:39:57,904 --> 00:40:02,151
اس(حضرت خالدؓ) سے بڑھ کر کوئی صاحبِ فراست نہیں، آپؓ غیر معمولی فہم و فراست کے پیکر ہیں

517
00:40:02,203 --> 00:40:06,424
اوکیدر کہنے لگا؛ اور نہ ہی کوئی آپ سا جنگ میں ماہر ہے، جنگ میں آپؓ سے بڑھ کر کوئی مہارت نہیں رکھتا

518
00:40:06,469 --> 00:40:10,751
کوئی بھی حریف ہو، خواہ وہ تعداد میں کم ہوں یا زیادہ

519
00:40:10,782 --> 00:40:15,051
جب کبھی حضرت خالدؓ سے اُن کا سامنا ہوا تو شکست اُن کا مقدر بن گئی

520
00:40:15,104 --> 00:40:18,431
اس لیے میری بات پہ عمل کرو اور دشمن(حضرت خالدؓ) سے صلح کرو

521
00:40:18,467 --> 00:40:20,451
 اوکیدر کہنے لگا؛ سنو، میں اس آدمی کو جانتا ہوں،

522
00:40:20,481 --> 00:40:25,118
کوئی بھی خالدؓ سے کبھی مقابلہ کرنے کی جرات نہیں کرتا نہ ہی اس کا چہرہ دیکھنا چاہتا ہے، اگر ہمت کر بھی لے تو ہار جاتا ہے

523
00:40:25,143 --> 00:40:27,171
جنگ میں اس(حضرت خالدؓ) سے بڑھ کر کوئی ماہر نہیں

524
00:40:27,196 --> 00:40:30,758
اور خالدؓ جیسا خوش نصیب کوئی نہیں، وہ تقدیر کو موردِالزام ٹھہراتے

525
00:40:30,794 --> 00:40:33,361
اس نے کہا؛ اس سے صلح کرو، لیکن اوکیدر کی قوم نے انکار کر دیا

526
00:40:33,386 --> 00:40:35,364
تو اس نے کہا؛ پھرمیں تمہارا ساتھ چھوڑ دوں گا

527
00:40:35,414 --> 00:40:38,311
اور اس نے اپنے لوگوں کا ساتھ چھوڑنے کا فیصلہ کیا

528
00:40:38,336 --> 00:40:41,381
 حضرت خالدؓ کو یہ خبر ملی

529
00:40:41,444 --> 00:40:46,684
آپؓ اسے دوبارہ گرفتار کرنے میں کامیاب ہوگئے اور آپؓ نے اسے قتل کر دیا

530
00:40:46,721 --> 00:40:51,238
اس کی بدعہدی کی وجہ سے، اور حضرت خالد بن ولیدؓ نے دومۃ الجندل فتح کر لیا

531
00:40:51,263 --> 00:40:54,064
ألحصيد، آپؓ یہ جنگ بھی جیت گئے

532
00:40:54,089 --> 00:40:57,104
المصیخ کے معرکے میں بھی آپؓ فتح یاب ہوئے

533
00:40:57,129 --> 00:41:01,931
میں ان تمام معرکوں کی تفصیلات میں نہیں جانا چاہتا کیونکہ ناموں اور جگہوں کی بہت سی پیچیدگیاں ہیں

534
00:41:01,956 --> 00:41:05,684
لیکن "ألمصيخ" کے معرکے سے متعلق دو چیزیں حضرت عدیؓ نے بیان کی ہیں

535
00:41:05,709 --> 00:41:11,758
 ایک آدمی اپنے گھر میں اپنے خاندان، بیوی، بیٹیوں، اور اپنے بیٹوں کے ساتھ موجود تھا

536
00:41:11,783 --> 00:41:19,044
اور اس کے سامنے شراب کا ایک بڑا برتن تھا اور رات گہری ہو چکی تھی اور وہ انہیں جام پینے کو کہہ رہا تھا

537
00:41:19,077 --> 00:41:20,571
وہ سب کہنے لگے؛ بہت دیر ہوگئی ہے

538
00:41:20,596 --> 00:41:23,911
اُس شخص نے کہا؛ ایک آخری جام پیو

539
00:41:23,936 --> 00:41:27,518
کیونکہ میرا نہیں خیال کہ تم اس کے بعد کبھی شراب پیو گے

540
00:41:27,543 --> 00:41:31,844
یہ خالدؓ اور اس کی فوج ہمیں زندہ نہیں چھوڑیں گے

541
00:41:31,894 --> 00:41:35,904
خالدؓ ہماری طرف بڑھ رہا ہے، اپنا آخری جام پیو

542
00:41:35,960 --> 00:41:39,622
چنانچہ وہ جام پینے لگے اور اس نے اشعار کی سطریں سنائیں، اس نے کہا؛

543
00:41:39,672 --> 00:41:42,131
کیا بربادی سے پہلے ایک جام نہیں پیو گے؟

544
00:41:42,156 --> 00:41:45,791
کچھ لمحوں کے توقف سے لوگوں کو شراب نوشی کے کیف و مستی میں ڈوب جانا چاہئے

545
00:41:45,827 --> 00:41:51,119
اور ہماری موت سے پہلے اس جام کا لُطف اُٹھاؤ، جو تقدیر کے معینہ وقت پہ  آئے گی جو نہ مہلت دے گی نہ مدت میں کمی کرے گی؟

546
00:41:51,144 --> 00:41:56,844
میرا مطلب ہے، یہ شخص بدقسمتی کی انتہا پہ تھا، کافی حد تک زندگی سے مایوس ہو چکا تھا

547
00:41:56,869 --> 00:42:01,184
اس لیے وہ اس دنیا سے جانے سے پہلے صرف شراب کا آخری جام پینا چاہتا تھا

548
00:42:01,209 --> 00:42:05,378
حضرت عدی بن حاتمؓ فرماتے ہیں؛ ہم اس(مذکورہ شخص) کے خیمے میں داخل ہوئے

549
00:42:05,434 --> 00:42:09,958
اور ہم نے اس کا سر قلم کردیا اور وہ شراب کے برتن میں جا گرا

550
00:42:09,983 --> 00:42:15,528
اور پھر ہم نے اس کے بیٹوں کو قتل کر دیا اور اس کی بیوی اور بیٹیوں کو قیدی بنا لیا

551
00:42:15,553 --> 00:42:19,454
اسی طرح المصیخ میں ایک اور واقعہ پیش آیا

552
00:42:19,479 --> 00:42:23,892
دو مسلمان تھے جن کے پاس رسول اللہؐ کا عطاء کردہ صلح کا معاہدہ تھا

553
00:42:23,917 --> 00:42:28,778
ان کو امان دی گئی تھی اور وہ مسلمان تھے اور(دورانِ جنگ) قتل ہو گئے

554
00:42:28,826 --> 00:42:32,471
چنانچہ اُن کے لواحقین نے حضرت ابوبکر صدیقؓ سے شکایت کرتے ہوئے کہا

555
00:42:32,496 --> 00:42:34,904
یہ دو فلاں فلاں مسلمان ہیں اور یہ خانہ جنگی میں مارے گئے ہیں

556
00:42:34,929 --> 00:42:38,358
حضرت ابو بکر صدیقؓ نے خون بہا کی رقم ادا کی لیکن پھر فرمایا؛

557
00:42:38,383 --> 00:42:43,424
یہ حال ان لوگوں کا ہوتا ہے جو اہل حرب کے ساتھ اُن کی سرزمین پہ رہتے ہیں

558
00:42:43,449 --> 00:42:50,011
آپ سرزمینِ حرب میں رہ رہے ہیں اور جو لوگ ایسا کرتے ہیں ان کے ساتھ ایسا ہی ہوتا ہے

559
00:42:50,036 --> 00:42:53,661
آپؓ یہ فرما رہے ہیں کہ یہ اُن کی اپنی غلطی ہے

560
00:42:53,686 --> 00:42:56,318
تو وہاں غیرمقصود نقصان ہوا، وہ مسلم مارے گئے

561
00:42:56,364 --> 00:42:59,218
مسلم فوج کو علم نہیں تھا کہ وہ مسلمان ہیں

562
00:42:59,243 --> 00:43:04,468
چنانچہ اس دور میں مسلمانوں کا غیر مسلموں کے ساتھ رہنا بالکل قابل قبول نہیں تھا

563
00:43:04,505 --> 00:43:06,317
ہم ایک اثتثنائی دور میں رہ رہے ہیں

564
00:43:06,342 --> 00:43:10,589
 اللہ کی احکامات کا نفاذ نہ ہونے کی وجہ سے حالات مختلف ہیں

565
00:43:10,614 --> 00:43:16,064
لیکن ابتدائی مسلمانوں کی ذہنیت کو دیکھیں تو اُن کے لئے کفار میں رہنا قابل قبول نہیں تھا

566
00:43:16,094 --> 00:43:20,571
اور حضرت خالد بن ولیدؓ اب عراق اور شام کے مابین علاقوں میں پیش قدمی کر رہے تھے

567
00:43:20,617 --> 00:43:23,834
میرا مطلب ہے کہ اب حضرت خالدؓ عراق چھوڑ چکے تھے اور آپؓ وہاں اپنا مرکز قائم کر چکے تھے

568
00:43:23,867 --> 00:43:29,478
اور اب آپؓ اُس علاقے میں داخل ہو رہے تھے جو فارسیوں اور رومیوں کے درمیان واقع تھی

569
00:43:29,511 --> 00:43:33,578
اور آپؓ فرات تک جا پہنچے

570
00:43:33,613 --> 00:43:39,098
یہ معرکہ مشہور نہیں ہے لیکن بہت اہم واقعہ ہے

571
00:43:39,129 --> 00:43:44,838
کیونکہ فرات میں حضرت خالد بن ولیدؓ ایک بین الاقوامی اتحادی قوت کا سامنا کرنے جا رہے تھے

572
00:43:44,872 --> 00:43:50,931
اس وقت کی کٹھ پتلی عرب حکومتوں کے ساتھ دو عالمی طاقتوں(روم اور فارس) کا سامنا تھا

573
00:43:50,974 --> 00:44:01,378
آپ کے مدِمقابل سلطنت روم اور سلطنت فارس  کے ساتھ ساتھ تغلب، نمر اور عیاد کے عرب قبائل بھی شامل تھے

574
00:44:01,412 --> 00:44:05,661
طبریؒ بیان فرماتے ہیں کہ رومی طیش میں آگئے

575
00:44:05,692 --> 00:44:09,884
اور رومیوں نے فارسیوں کی قریبی چوکیوں سے مدد طلب کی

576
00:44:09,918 --> 00:44:12,711
جو غضبناک تھے اور غصے میں بھی آ گئے تھے

577
00:44:12,764 --> 00:44:16,311
اور انہوں نے تغلب، عیاد اور نمر سے بھی کمک طلب کی

578
00:44:16,356 --> 00:44:19,704
 اب رومی اور فارسی چوٹی کے حریف تھے

579
00:44:19,746 --> 00:44:22,684
لیکن رومی اس بات پر بہت غصے میں تھے کہ کیا ہو رہا ہے؟

580
00:44:22,720 --> 00:44:25,584
خالد بن ولیدؓ، اب ہماری سرزمین میں موجود ہے

581
00:44:25,637 --> 00:44:29,224
وہ فارسیوں سے فوجی مدد مانگ رہے تھے

582
00:44:29,266 --> 00:44:36,358
انہوں نے کہا؛ ہمیں کمک بھیجیں، آئیے ایک بین الاقوامی اتحاد قائم کریں اور ان لوگوں(مسلمانوں) کا مقابلہ کریں

583
00:44:36,402 --> 00:44:40,964
اور علاقے کے عیسائی عرب بھی ان کے ساتھ شامل ہو گئے

584
00:44:41,011 --> 00:44:49,131
چنانچہ یہ ایک بہت بڑا لشکر تھا، حضرت خالد بن ولیدؓ نے اس کا مقابلہ کیا اور آپؓ نے انہیں شکست دی

585
00:44:49,178 --> 00:44:53,398
جنگ سے پہلے ہوا یہ کہ؛ دیکھیں دریا نے دونوں فوجوں کو الگ کر رکھا تھا

586
00:44:53,434 --> 00:44:58,231
حضرت خالد بن ولیدؓ اور آپؓ کی فوج ایک کنارے پر اور دشمن دوسرے کنارے پر تھا

587
00:44:58,263 --> 00:45:04,824
تو انہوں نے کہا کہ خالد بن ولیدؓ یا تو ہماری طرف بڑھیں یا ہم آپ کی طرف دریا عبور کر کہ آئیں

588
00:45:04,861 --> 00:45:07,178
آپؓ نے فرمایا؛ نہیں، تم ہماری طرف آجاؤ

589
00:45:07,225 --> 00:45:10,677
انہوں نے کہا؛ ٹھیک ہے، پھر پیچھے ہٹ جاؤ تاکہ ہم دریا عبور کرسکیں

590
00:45:10,717 --> 00:45:13,201
آپؓ نے فرمایا؛ نہیں، میں پیچھے نہیں ہٹوں گا، وہاں سے آ جاؤ

591
00:45:13,222 --> 00:45:15,256
جگہ ڈھونڈو/راستہ بناؤ اور آؤ میں اپنی جگہ نہیں چھوڑنے والا ہوں

592
00:45:15,281 --> 00:45:19,238
 اس لیے انہیں چکر کاٹ کر جانا پڑا، دوسری جگہ سے دریا عبور کر کے آپؓ کا سامنا کرنا پڑا

593
00:45:19,272 --> 00:45:21,651
لیکن پھر، آپؓ نے انہیں شکست دے دی

594
00:45:21,672 --> 00:45:24,741
رومیوں اور فارسیوں نے حضرت خالد بن ولیدؓ کی صورت میں درپیش ممکنہ خطرے کا محسوس کرلیا

595
00:45:24,763 --> 00:45:26,921
وہ ایک دوسرے سے کہنے لگے اپنی سلطنتوں کا دفاع کرو

596
00:45:26,961 --> 00:45:29,889
یہ(حضرت خالدؓ) وہ شخص ہے جو مذہب کی بنیاد پر لڑ رہا ہے

597
00:45:29,990 --> 00:45:34,608
وہ ذہین اور باشعور ہے، وہ آپؓ کی باکمال شخصیت کے معترف تھے

598
00:45:34,645 --> 00:45:37,851
اب جب اس اتحاد کو شکست ہوئی

599
00:45:37,887 --> 00:45:39,676
حضرت خالد بن ولیدؓ اس سے مطمئن نہیں تھے

600
00:45:39,716 --> 00:45:42,571
آپؓ نے فرمایا؛ ان کا پیچھا کرو اور انہیں سنبھلنے کی مہلت نہ دو

601
00:45:42,596 --> 00:45:49,731
 انہیں آرام نہ کرنے دیں، بس ان کی پشت پر چپکے رہیں اور انہیں وقفہ نہ دیں اور جہاں تک ہو سکا؛ آپؓ نے ان کا تعاقب کیا

602
00:45:49,770 --> 00:45:56,571
چنانچہ حضرت خالد بن ولیدؓ اُن کا جنگی انداز یہ تھا، کہ جب بھی آپؓ دشمن کو مات دیتے، تو بہت دور تک وہ ان کا تعاقب کرتے

603
00:45:56,613 --> 00:46:01,065
اور آپؓ آخری حد تک دشمن کو تعاقب کے دام میں اُلجھائے رکھتے

604
00:46:01,097 --> 00:46:05,986
تو یہ آپؓ کی شہرت تھی یعنی دشمن پہ حضرت خالد بن ولیدؓ کی ہیبت طاری تھی

605
00:46:06,011 --> 00:46:08,478
 کیونکہ وہ جانتے تھے کہ خواہ وہ جنگ میں پیٹھ پھیر لیں

606
00:46:08,523 --> 00:46:10,245
 آپؓ انہیں ایسے فرار بھی نہیں ہونے دیں گے

607
00:46:10,270 --> 00:46:13,338
لہٰذا جنگ میں آنے سے پہلے ہی ان کی ٹانگیں لرز رہی ہوتیں

608
00:46:13,384 --> 00:46:18,551
جب انہوں نے حضرت خالد بن ولیدؓ کا نام اور ان سے متعلق تمام قصے سنے، کہ زہر نگلنے سے بھی آپؓ کو کچھ نہیں ہوا

609
00:46:18,588 --> 00:46:23,828
 اور یہ افواہیں گردش کر رہی تھیں کہ حضرت خالدؓ کو آسمان سے تلوار ملی ہے

610
00:46:23,853 --> 00:46:27,445
دیکھیں انہوں نے "سیف اللہ" کے لقب کو غلط سمجھا

611
00:46:27,478 --> 00:46:30,325
کیونکہ حضرت خالدؓ کا لقب" سیف اللہ" یعنی اللہ کی تلوار تھا

612
00:46:30,364 --> 00:46:34,298
انہوں نے اس کا معنی یہ سمجھا کہ آپؓ کو اللہ کی طرف سے تلوار عطاء ہوئی ہے

613
00:46:34,323 --> 00:46:39,238
 چنانچہ رومیوں کے ساتھ ایک جنگ میں انہوں نے حضرت خالدؓ کو سامنے آنے کو کہا

614
00:46:39,263 --> 00:46:42,105
اور فوج کے سپہ سالار نے اس معاملے کی تحقیق کی

615
00:46:42,130 --> 00:46:47,625
اس نے حضرت خالدؓ سے پوچھا، وہ کہنے لگا؛ کیا یہ سچ ہے کہ آپؓ کو آپؓ کے نبیؐ نے تلوار دی ہے جو اللہ کی طرف سے آئی ہے؟

616
00:46:47,650 --> 00:46:49,131
 آپؓ نے فرمایا؛ نہیں یہ حقیقت نہیں ہے

617
00:46:49,156 --> 00:46:53,511
بس اتنی سی بات ہے کہ نبیؐ نے فرمایا کہ میں اللہ کی تلواروں میں سے تلوار ہوں"

618
00:46:53,536 --> 00:46:56,345
حضرت خالدؓ نے جھوٹ نہیں بولا، آپؓ نے اس رومی سپہ سالار کو حقیقت بتائی

619
00:46:56,370 --> 00:46:59,646
اب، یہ ایک حیرت انگیز واقعہ ہے،

620
00:46:59,676 --> 00:47:03,638
حضرت خالد بن ولیدؓ اور آپؓ کی فوج فرات میں تھے

621
00:47:03,676 --> 00:47:09,375
جو شام اور عراق کے درمیان واقع ہے، بہت دوردراز مقام ہے

622
00:47:09,402 --> 00:47:13,058
آپؓ عراق واپس جانا چاہتے تھے، آپؓ حیرہ واپس جانا چاہتے تھے

623
00:47:13,107 --> 00:47:18,305
یہ وہ جگہ ہے جہاں آپؓ کا عسکری اڈہ تھا، آپؓ کا تعلق وہاں سے تھا اور آپؓ نے اب کافی زیادہ فاصلہ طے کر لیا تھا

624
00:47:18,348 --> 00:47:21,418
تو آپؓ واپس جانے کا ارادہ رکھتے تھے

625
00:47:21,466 --> 00:47:25,705
لہذا آپؓ نے اپنی فوج روانہ کی اور عام طور پر جب آپ فوج بھیجتے ہیں اور آپ طویل سفر کر رہے ہوتے ہیں

626
00:47:25,730 --> 00:47:28,651
 آپ فوج کو تقسیم کر دیتے ہیں

627
00:47:28,687 --> 00:47:36,798
اور اس بڑی فوج کے پیچھے ایک چھوٹا لشکر ہوتا ہے، جو پیش قدمی کرتی فوج کو عقب سے تحفظ فراہم کرتا ہے

628
00:47:36,852 --> 00:47:39,278
تو فوج دو حصوں میں پیش قدمی کر رہی ہوتی ہے

629
00:47:39,303 --> 00:47:43,531
ان کے درمیان ایک مخصوص فاصلہ ہوتا ہے، یہ فاصلہ گھنٹوں کا ہوسکتا ہے، اور یہ فاصلہ دنوں کا بھی ہوسکتے ہے

630
00:47:43,567 --> 00:47:47,291
چنانچہ آپؓ نے فوج کے بڑے حصے کو آگے بھیج دیا

631
00:47:47,330 --> 00:47:53,011
اور پھر آپؓ کے پاس لشکر کا ایک چھوٹا حصہ تھا، جو مرکزی لشکر کی حفاظت کے لیے اس کے پیچھے رواں دواں تھا

632
00:47:53,054 --> 00:47:57,145
تاکہ پیچھے سے گھات لگا کر حملہ نہ کیا جاسکے، خاص کر یہ کہ آپؓ ابھی معرکہ آراء ہو کر آئے تھے

633
00:47:57,179 --> 00:48:01,355
کیوںکہ آپؓ اس علاقے کی تین طاقتوں عربوں، رومیوں اور فارسیوں کے ساتھ جنگ لڑ کر فارغ ہوئے تھے

634
00:48:01,380 --> 00:48:04,425
آپؓ اس بات کو یقینی بنانا چاہتے تھے کہ لشکر، عقب سے محفوظ ہو

635
00:48:04,450 --> 00:48:11,905
چنانچہ آپؓ عراق کے انتہائی مغرب سے یا درحقیقت شام سے حیرہ کی طرف سفر کر رہے تھے

636
00:48:11,930 --> 00:48:17,335
 جو کربلا اور نجف کے قریب عراق کے وسطی علاقے میں واقع ہے

637
00:48:17,369 --> 00:48:22,611
چنانچہ حضرت خالد بن ولیدؓ آخری لشکر کے عقب میں سفر کر رہے تھے

638
00:48:22,647 --> 00:48:30,825
حضرت خالدؓ اپنے قریبی ساتھیوں کے پاس گئے اور ان سے دریافت کیا کہ کیا کہتے ہیں اس سال حج ادا کر لیں ؟

639
00:48:30,874 --> 00:48:33,935
اور وہ حج کا وقت تھا

640
00:48:33,978 --> 00:48:38,126
اور آپ میں سے جو لوگ مکہ گئے ہیں اور جنہوں نے کعبہ کو دیکھا ہے

641
00:48:38,151 --> 00:48:41,678
کعبہ ایک مقناطیس کی مانند ہے

642
00:48:41,712 --> 00:48:44,868
جو آپ کو اپنی جانب کھینچتا ہے چاہے آپ روئے زمین پر کہیں بھی ہوتے ہیں

643
00:48:44,893 --> 00:48:49,711
اگر آپ ایک بار کعبہ شریف کی زیارت کر لیں تو آپ اس کے شیدائی ہو جائیں گے

644
00:48:49,752 --> 00:48:52,106
"وَإِذْ جَعَلْنَا الْبَيْتَ مَثَابَةً لِّلنَّاسِ وَأَمْنًا"

645
00:48:52,146 --> 00:48:54,065
ہم نے اللہ کے گھر کو مثابۃ(باربار زیارت کیے جانے والی جگہ) بنایا ہے

646
00:48:54,095 --> 00:48:57,365
"مثابة" ایک ایسی جگہ ہے جہاں آپ ہمیشہ واپس جانے کے تمنائی رہتے ہیں" یطوبوعليه"

647
00:48:57,390 --> 00:48:59,331
آپ بار بار واپس جانا چاہیں گے

648
00:48:59,356 --> 00:49:01,818
آپ ایک بار اس(کعبہ) کی زیارت کرلیں، آپ کا دل تاحیات اس کی عقیدت میں بندھ جائے گا

649
00:49:01,860 --> 00:49:06,891
اور جن لوگوں میں یہ احساس ہوتا ہے، وہ حج کے ایام  سے پہلے اس عقیدت بھرے احساس کو محسوس کرنے لگتے ہیں

650
00:49:06,916 --> 00:49:08,945
آپ جانتے ہیں، ایک ایسا شخص جو نشہ کرتا ہو

651
00:49:08,983 --> 00:49:12,645
جب بھی وہ اس نشے کو دیکھے گا تو وہ محبت اور چاہت محسوس کرے گا

652
00:49:12,686 --> 00:49:17,014
چنانچہ جب حج کا موسم آتا ہے تو آپ اپنے اندر اضطراب و بے چینی محسوس کرتے ہیں، آپ وہاں(حرم میں) جانا چاہتے ہیں

653
00:49:17,039 --> 00:49:21,701
تو حضرت خالد بن ولیدؓ اب حج کی ادائیگی کے لئے جانا چاہتے تھے، تاخیر کے باعث وقت بھی بہت کم تھا

654
00:49:21,740 --> 00:49:26,318
وہ آپؓ سے کہنے لگے کہ آپؓ کیا بات کر رہے ہیں؟ ہم مکہ سے سینکڑوں میل دور ہیں

655
00:49:26,343 --> 00:49:29,505
حضرت خالدؓ نے فرمایا؛ تھوڑی ہمت کریں اور میرے ساتھ چلیں

656
00:49:29,530 --> 00:49:33,625
 لہٰذا حضرت خالدؓ نے(سفرِ حج کے لئے) اپنے قریبی ساتھیوں کا انتخاب کیا

657
00:49:33,650 --> 00:49:36,793
اور وہ فیصلہ کرتے ہیں کہ وہ برق رفتاری سے سفرکریں گے اور حج  ادا کرنے کی کوشش کریں گے

658
00:49:36,828 --> 00:49:40,848
اب وہ پہلے کبھی فرات میں داخل نہیں ہوئے تھے وہ اس علاقہ سے ناواقف تھے

659
00:49:40,875 --> 00:49:46,125
انہوں نے اس سرزمین میں پہلے کبھی سفر نہیں کیا تھا اور نہ ہی ان کا کوئی رہنما تھا

660
00:49:46,159 --> 00:49:49,705
حضرت خالد بن ولیدؓ اس دشوار سفر کو ہدف بنا کر یہ انجان راستہ عبور کرنا چاہتے تھے

661
00:49:49,730 --> 00:49:53,911
حضرت خالد بن ولیدؓ کے اقدام کو مدِنظر رکھتے ہوئے آپ گمان کریں گے کہ یہ مزاج اور رویہ کسی نوعمر جوان کا ہوگا

662
00:49:53,949 --> 00:49:57,178
حضرت خالد بن ولیدؓ اس وقت ایک اُدھیڑ عمر آدمی تھے

663
00:49:57,221 --> 00:49:59,491
لیکن حضرت خالد بن ولیدؓ ایک مُخترع شخص تھے

664
00:49:59,534 --> 00:50:02,865
ایک بیباک شخص تھے جو کوئی بھی خطرہ مول لینے کو تیار تھے

665
00:50:02,890 --> 00:50:06,385
یہی آپؓ کی شخصیت تھی، یہی آپؓ کا منفرد انداز تھا، آؤ کوشش کرتے ہیں

666
00:50:06,410 --> 00:50:09,638
یہ حج کا وقت ہے، آئیے حج کا فرض اداکرنے کی کوشش کریں

667
00:50:09,663 --> 00:50:11,630
اس لیے آپؓ نے کسی پہ اپنی نیت و ارادہ ظاہر نہیں کیا

668
00:50:11,655 --> 00:50:16,371
آپؐ نے صرف عقبی فوج کے چند اہم شرکاء کو اپنے ارادے سے آگاہ کیا

669
00:50:16,396 --> 00:50:20,851
آپؓ نے ان سے کہا کہ ہم کچھ عرصے کے لیے غیر حاضر رہیں گے، ہم حج پر جا رہے ہیں

670
00:50:20,884 --> 00:50:25,771
اب وہ ایک ایسی سمت میں جا رہے ہیں جس کے متعلق انھیں کوئی اندازہ نہیں کہ وہ کہاں جا رہے ہیں؟

671
00:50:25,796 --> 00:50:28,954
فسلك الطريق لم يسلقها إنسانٌ قبلهم قط

672
00:50:29,463 --> 00:50:36,918
طبریؒ فرماتے ہیں؛ وہ ایک ایسے راستے پہ گامزن ہوئے جس پہ اس سے پہلے کسی انسان نے قدم بھی نہیں رکھا تھا

673
00:50:36,948 --> 00:50:40,485
کیونکہ صحرا میں کچھ رستے ہی ہوتے ہیں جہاں لوگ سفر کرتے ہیں

674
00:50:40,536 --> 00:50:46,111
اور وہاں ہی لوگوں کی ضروریات کو پورا کرنے کے لئے راستے میں چوکیاں/سرائے بھی ہوتے ہیں

675
00:50:46,145 --> 00:50:53,771
حضرت خالد بن ولیدؓ اب وہ راستہ اختیار کر رہے تھے جو ان سے پہلے کسی نے سفر کے لئے استعمال نہیں کیا تھا

676
00:50:53,820 --> 00:51:00,811
وسارع إلى مكة في طريق لم يسلق قبله قط وتعتله في ذالك أمرٌلم يقعل لغيره

677
00:51:01,057 --> 00:51:06,050
اور آپؓ نے کچھ غیرمعمولی کارنامہ سرانجام دیا اور اللہ نے آپؓ کو کرامت عطا فرمائیں جو آپؓ سے پہلے کسی کو عطا نہیں ہوئی تھیں

678
00:51:06,085 --> 00:51:09,991
فجعل يسير متعصفًا على غير جاد حتى إنتهاء إلى المكة

679
00:51:10,175 --> 00:51:14,111
طبری فرماتے ہیں؛ آپؓ ایک بے نام و نشان راہ پہ برق رفتاری سے سفر کر رہے تھے

680
00:51:14,144 --> 00:51:18,955
ایک ایسے راستے پہ محوِِسفر تھے جس کا آپؓ کو علم نہیں تھا یہاں تک کہ آپؓ عرفہ میں جاپہنچے

681
00:51:19,026 --> 00:51:23,208
انہوں نے معمول سے ہٹ کہ اپنا الگ راستہ اختیار کیا اور طبریؒ فرماتے ہیں؛ یہ ایک غیر زمہ دارانہ اقدام تھا

682
00:51:23,234 --> 00:51:28,608
میرا مطلب ہے آپؓ کے پاس کوئی راہنما نہیں تھا، وہ اپنے راستے کی سمتوں سے مکمل واقفیت نہیں رکھتے تھے، آپؓ بس آگے بڑھتے گئے

683
00:51:28,653 --> 00:51:32,921
 حضرت خالد بن ولیدؓ اور اُن کے ہمراہ تمام افراد میدانِ جنگ کے تجربہ کار لوگ تھے

684
00:51:32,942 --> 00:51:36,595
وہ ایسی کسی بھی غیرمتوقع صورتحال کو سنبھال سکتے تھے لیکن یہ کافی بڑا خطرہ تھا

685
00:51:36,628 --> 00:51:40,045
انھوں نے یہ سفر کیا، میدانِ عرفہ میں پہنچ گئے اور حج ادا کیا

686
00:51:40,081 --> 00:51:44,245
کچھ دیر بعد سر منڈوائے اور کسی کو بتائے بغیر چپکے سے واپسی کے سفر پہ روانہ ہوگئے

687
00:51:44,301 --> 00:51:49,418
حضرت ابوبکر صدیقؓ کو یہ خبر اس وقت ملی جب اپؓ مدینہ واپس آئے اور آپؓ حضرت خالدؓ کے اس اقدام سے شدید برہم ہوئے

688
00:51:49,454 --> 00:51:52,178
حضرت خالد بن ولیدؓ سُرعت سے واپسی کی راہ پہ رواں دواں تھے

689
00:51:52,208 --> 00:51:58,478
اور آپ کے لئے یہ ناقابلِ یقین بات ہوگی کہ فوج کے حیرہ(عراق) میں داخل ہونے سے پہلے آپؓ اپنے لشکر کے عقبی دستوں سے جا ملے

690
00:51:58,513 --> 00:52:00,851
تو یہ فوج عراق کے اندر ہی سفر کر رہی تھی

691
00:52:00,904 --> 00:52:03,331
حضرت خالد بن ولیدؓ نے جلدی سے حج ادا کیا

692
00:52:03,365 --> 00:52:05,745
اور واپس جا کر اپنی فوج کے عقبی حصے سے جاملے

693
00:52:05,788 --> 00:52:08,665
اور "حیرہ " میں اس طرح سے داخل ہوئے جیسے کچھ ہوا ہی نہیں تھا

694
00:52:08,708 --> 00:52:11,568
اور کسی کو اس بات کا علم نہیں تھا ماسوائے اس کے کہ جب انہوں نے دیکھا کہ انہوں نے سر منڈوائے ہوئے ہیں

695
00:52:11,593 --> 00:52:13,621
انھوں نے استفسار کیا؛ تم نے کیا کیا ہے؟

696
00:52:13,661 --> 00:52:16,571
حضرت ابوبکرؓ، ذرا حضرت ابوبکرصدیقؓ کے احساسات کا تصور کریں

697
00:52:16,607 --> 00:52:22,208
جب انہوں نے یہ خبر سنی کر کہ خالدؓ نے اپنا لشکر چھوڑ دیا اور حج کیا اور واپس چلا گیا

698
00:52:22,238 --> 00:52:25,058
تو میں حضرت ابوبکر صدیقؓ کے محسوسات کا بخوبی تصور کرسکتا ہوں

699
00:52:25,083 --> 00:52:30,128
یہ غصے اور تعجب دونوں کا ایک مبہم احساس ہوگا

700
00:52:30,179 --> 00:52:33,571
اور آپؓ حیران ہوں گے کہ حضرت خالد بن ولیدؓ کیا کر رہے ہیں

701
00:52:33,602 --> 00:52:36,371
اور کوئی ایسا کیسے کر سکتا ہے؟

702
00:52:36,415 --> 00:52:38,505
تو حضرت ابوبکرؓ نے حضرت خالدؓ کو خط لکھا

703
00:52:38,561 --> 00:52:44,191
آپؓ نے فرمایا؛ جاؤ یہاں تک کہ آپؓ یرموک میں مسلمانوں کے لشکر سے جا ملو

704
00:52:44,224 --> 00:52:48,878
یرموک اب موجودہ اردن میں ہے، اس لیے آپؓ،حضرت خالدؓ کو دوبارہ واپس بھیج رہے تھے

705
00:52:48,919 --> 00:52:55,245
حضرت ابوبکرؓ نے فرمایا ؛ جاؤ یہاں تک کہ تم یرموک میں مسلمانوں کی فوجوں کے پاس پہنچ جاؤ کیونکہ وہ پریشان ہیں اور وہ بے چینی کا شکار ہیں

706
00:52:55,283 --> 00:52:58,245
 مسلمانوں کو رومیوں کے مقابلے میں سخت مشکلات کا سامنا تھا

707
00:52:58,277 --> 00:53:01,385
جاؤ اور ان کو بچاؤ اور پھر حضرت ابوبکرؓ نے فرمایا؛

708
00:53:01,423 --> 00:53:07,391
اور دوبارہ ہرگز ایسا کوئی غیرسنجیدہ قدم نہ اُٹھانا جیسے آپؓ نے پہلے کیا ہے

709
00:53:07,424 --> 00:53:12,385
حضرت خالدؓ کو واضح ہدایت دی کہ وہ پھر سے ایسا کوئی قدم نہ اُٹھائیں

710
00:53:12,422 --> 00:53:16,021
"ایسا نہ کرنا جو آپؓ کر چکے ہو"

711
00:53:16,056 --> 00:53:17,921
تو حضرت ابوبکرؓ کا لہجہ ترش و تلخ تھا

712
00:53:17,961 --> 00:53:23,498
لیکن جب میں نے حضرت ابوبکرؓ کے احساس کو ابہام کہا، کیوں کہ آپؓ نے فرمایا؛

713
00:53:23,539 --> 00:53:28,388
کیونکہ اللہ کی مدد کے بعد آپؓ کی طرح دشمن کو کوئی نہیں مات سکتا

714
00:53:28,415 --> 00:53:30,801
اپنے آپ کو خطرے میں نہ ڈالیں

715
00:53:30,831 --> 00:53:33,958
 کیونکہ آپ سے بڑھ کر اللہ کا دشمن کو کوئی شکست نہیں دے سکتا

716
00:53:34,001 --> 00:53:38,265
اور پریشان حال مسلمانوں کو آپؓ کے بغیر کوئی تقویت نہیں دے سکتا

717
00:53:38,300 --> 00:53:41,445
  رومی افواج کے خلاف محاذ آراء مسلم لشکر کے قدم اُکھڑنے لگے ہیں

718
00:53:41,480 --> 00:53:44,121
 آپؓ کے سوا کوئی بھی اُن کے حوصلے بلند نہیں کر سکتا

719
00:53:44,145 --> 00:53:45,868
تو اپنا خیال رکھیں

720
00:53:45,906 --> 00:53:49,831
اور پھر حضرت ابوبکرؓ نے فرمایا؛ مبارک ہو، ابو سلیمان

721
00:53:49,877 --> 00:53:52,725
آپؓ کے ارادوں اور آپؓ کے پسندیدہ مقام پر

722
00:53:52,780 --> 00:53:59,115
اب وقت آگیا ہے کہ خلیفہ (حضرت ابوبکرؓ)، حضرت خالد بن ولیدؓ کو مبارکباد دیں، اس کامیابی و رُتبے کے لئے جو آپؓ نے حاصل کیا ہے

723
00:53:59,158 --> 00:54:04,825
حضرت ابوبکرؓ نے فرمایا؛ اس لیے اپنے مقصد کی تکمیل کرو تاکہ اللہ اسے تمہارے لیے مکمل کر دے

724
00:54:04,856 --> 00:54:06,431
اپنا ہدف پورا کرو

725
00:54:06,469 --> 00:54:12,051
 آپؓ کا کردار ابھی ختم نہیں ہوا، اللہ آپ کو مزید شان اور رفعت عطا فرمائے گا

726
00:54:12,094 --> 00:54:15,704
حضرت ابوبکرؓ نے فرمایا؛ کبھی بھی خود ستائشی کا شکار مت ہونا

727
00:54:15,729 --> 00:54:20,171
دیکھئے حضرت ابوبکرؓ ان کے لیے نہ صرف رہنما تھے ،اور نہ ہی صرف خلیفہ تھے

728
00:54:20,221 --> 00:54:23,178
آپؓ تمام صحابہ کے لیے باپ کی مانند مشفق شخصیت تھے

729
00:54:23,220 --> 00:54:28,549
آپؓ عالم تھے، ان کے شیخ تھے کیونکہ حضرت ابوبکرؓ، رسول اللہؐ سے خصوصی قرب رکھتے تھے

730
00:54:28,574 --> 00:54:32,751
اورحضرت ابوبکرؓ اس وقت ساٹھ برس کے تھے اور آپؓ سب سے زیادہ باعلم شخصیت تھے

731
00:54:32,802 --> 00:54:38,578
لہٰذا، خلیفہ اور اُمت کے مابین تعلق، کسی سیاست دان کا ان کی کابینہ کے کسی رکن سا نہیں تھا

732
00:54:38,622 --> 00:54:41,091
یہ ایک بڑے بھائی کا رشتہ تھا

733
00:54:41,122 --> 00:54:42,428
تو حضرت ابوبکرؓ، حضرت خالدؓ کو نصیحت فرمارہے تھے

734
00:54:42,468 --> 00:54:45,358
میرا مطلب ہے، آپ کو یہ حیرت انگیز لگے گا، حضرت ابوبکرؓ لشکر روانہ کر رہے تھے

735
00:54:45,379 --> 00:54:48,778
اور آپؓ لشکر کے سپہ سالار کو نصیحت فرما رہے تھے کہ خشوع و خضوع سے صلاۃ(نماز)ادا کرنا

736
00:54:48,809 --> 00:54:52,825
آپ جانتے ہیں یہ وہ تعلیمات ہیں جو عام طور پر ایک استاد اپنے طالب علم کو دیتا ہے

737
00:54:52,861 --> 00:54:57,865
لیکن یہ خلیفہ کا اپنے معتقدین سے تعلق تھا،آپؓ نے فرمایا؛

738
00:54:57,916 --> 00:55:01,575
آپؓ خود پسندی کے ہر احساس سے اپنی ذات کو بچائیں کیونکہ

739
00:55:01,595 --> 00:55:04,478
حضرت خالد بن ولیدؓ ایک بلند مرتبے پر فائز ہیں

740
00:55:04,519 --> 00:55:07,098
خليفه حضرت ابوبکرؓ اس بات کو یقینی بنانا چاہتے تھے کہ حضرت خالدؓ کا دل صاف ہو

741
00:55:07,136 --> 00:55:10,161
 شیطان کبھی آپؓ کے دل میں وسوسہ نہ ڈال سکے

742
00:55:10,217 --> 00:55:16,645
کبھی بھی تکبر و خودپسندی میں مبتلا نہ ہوں، بصورتِ دیگر آپؓ شکست خوردہ ہوکر بکھر جائیں گے

743
00:55:16,691 --> 00:55:20,931
دیکھیں آپ اپنی کسی بھی کامیابی کو اپنا کمال نہ سمجھیں

744
00:55:20,976 --> 00:55:27,258
کیونکہ تمام نعمتیں اللہ کی عطاءکردہ ہیں اور وہی ہر کامیابی و کامرانی کا سرچشمہ ہے

745
00:55:27,310 --> 00:55:33,968
اپنے دل میں "عجب" کو داخل نہ ہونے دیں اور اپنے اعمال کے لئے خود پہ بھروسہ رکھنے کی بجائے اپنے اللہ پہ بھروسہ رکھیں

746
00:55:34,010 --> 00:55:36,551
چنانچہ یہ خط حضرت خالد بن ولیدؓ تک پہنچا

747
00:55:36,597 --> 00:55:42,708
اور آپؓ کو یہ فرمان ملا کہ آپؓ عراق چھوڑ کر شام، یرموک، اردن کے محازوں پہ لوٹ جائیں

748
00:55:42,740 --> 00:55:49,231
چنانچہ اب حضرت ابوبکرؓ نے حضرت خالدؓ کو لشکر کو آپؓ اور حضرت مثنیٰ بن حارثہؓ کے درمیان تقسیم کرنے کا حکم دیا

749
00:55:49,262 --> 00:55:52,168
حضرت ألمثنىٰؓ اب عراق کی فوجوں کی قیادت کریں گے

750
00:55:52,200 --> 00:55:56,225
جبکہ حضرت خالدؓ نصف فوج کے ساتھ شام کی طرف روانہ ہونگے

751
00:55:56,272 --> 00:55:58,978
چنانچہ حضرت خالدؓ نے فوج کو دو حصوں میں تقسیم کر دیا

752
00:55:59,021 --> 00:56:06,058
اور آپؓ کی حکمتِ عملی یہ تھی کہ آپؓ نے تمام صحابہ کرامؓ کو اپنے زیرِ قیادت لشکر میں شامل کیا

753
00:56:06,104 --> 00:56:08,251
حضرت المثنٰیؓ، آپؓ کے پاس تشریف لائے اور فرمایا؛

754
00:56:08,282 --> 00:56:10,915
مجھے آپؓ کی فوج کو تقسیم کرنے کی حکمتِ عملی پہ اعتراض ہے

755
00:56:10,937 --> 00:56:17,251
آپؓ تمام صحابہ کرامؓ کو ساتھ لے جائیں، مجھے یہ منظور نہیں

756
00:56:17,285 --> 00:56:21,931
 سبحان اللہ ،جذبہ دیکھیں میرا مطلب ہے کہ ان کے پاس لشکر میں مجاہدین برابر تعداد میں تھے

757
00:56:21,987 --> 00:56:25,852
حالانکہ رسول اللہؐ کا زمانہ گزر چُکا تھا

758
00:56:25,892 --> 00:56:31,538
وہ پھر بھی اس چیز کے لئے باہمی کشمکش کا شکار ہوئے جس سے رسول اللہؐ کی قریبی نسبت تھی؛ یعنی صحابہ کرامؓ

759
00:56:31,585 --> 00:56:34,848
آپﷺ نے ہی اُنھیں(صحابہ کرامؓ) تمام عظمتوں اور رفعتوں کی بنیاد فراہم کی

760
00:56:34,897 --> 00:56:37,231
چنانچہ وہ فتوحات جو حضرت ابوبکرؓ کے زمانے میں ہوئیں

761
00:56:37,256 --> 00:56:39,338
اور وہ فتوحات جوحضرت عمرؓ کے زمانے میں ہوئیں

762
00:56:39,372 --> 00:56:44,245
وہ صرف رسول اللہؐ کی تربیت اور صُحبت کا ثمر تھا

763
00:56:44,278 --> 00:56:47,985
ایک صحابی اپنی ایمانی قوت کی بناء پہ پوری فوج کے برابر سمجھا جاتا تھا

764
00:56:48,024 --> 00:56:51,688
رسول اللہؐ نے مدینہ میں ان کی تربیت فرمائی

765
00:56:51,729 --> 00:56:54,645
 سلطنتِ فارس اور رومی سلطنت کی نظر میں مدینہ بے ضرر اور بے وقعت تھا

766
00:56:54,670 --> 00:56:57,345
ان میں سے اکثر کو یہ بھی معلوم نہیں تھا کہ مدینہ کیا ہے؟

767
00:56:57,379 --> 00:57:01,168
مگر وہ نہیں جانتے تھے کہ ان کی تباہی وبربادی کی بنیاد مدینہ میں رکھی جا چکی ہے

768
00:57:01,208 --> 00:57:04,485
کہ اگرچہ رسول اللہؐ ان(سلطنتِ فارس،سلطنتِ روم) سے کوسوں دور تھے

769
00:57:04,520 --> 00:57:08,658
آپﷺ مدینہ کے غرباء میں توحید کے انقلابی تصور کو پروان چڑھا رہے تھے

770
00:57:08,691 --> 00:57:13,211
جو دنیا کے ہرگوشے کو اس نور سے منور کردیں گے

771
00:57:13,248 --> 00:57:15,568
تو حضرت ألمثنٰى نے حضرت خالدؓ سے فرمایا کہ میں آپؓ کو تمام صحابہ کرام اپنے حصے کے لشکر میں شامل کرنے کی اجازت ہرگز نہیں دوں گا

772
00:57:15,593 --> 00:57:18,211
چنانچہ حضرت خالد بن ولیدؓ نے یکے بعد دیگرے کئی صحابہ کو حضرت المثنیٰؓ کے لشکر میں شامل کیا

773
00:57:18,255 --> 00:57:19,109
" حتى ألرضى"

774
00:57:19,134 --> 00:57:21,412
حتیٰ کہ آپؓ نے اُنہیں مطمئن کر دیا

775
00:57:21,463 --> 00:57:24,658
اور پھر حضرت خالدؓ شام کی طرف کُوچ کرگئے

776
00:57:24,683 --> 00:57:28,128
اور یہ ایک دوسری مہم ہے جس کے متعلق ہم بعد میں بات کریں گے

777
00:57:28,159 --> 00:57:37,261
 دیکھیں، ہم نے رسول اللہؐ کے زمانے میں حضرت ألمثنٰىؓ کی دین اسلام کے متعلق رائے بیان کی، اور اسلام کی بدولت کیسے وہ حضرت ابوبکرؓ کے زمانے تبدیل ہوئے؟

778
00:57:37,291 --> 00:57:39,558
  آپؓ خود اس کے متعلق بات کرتے ہوئے کہتے ہیں کہ؛

779
00:57:39,607 --> 00:57:42,468
قد قاتلت العرب والعجم فی الجاهلیة والإسلام

780
00:57:42,794 --> 00:57:48,151
والله لمائة من العجم في الجاهلية كانوا أشد على من ألف من العرب

781
00:57:48,742 --> 00:57:54,388
ولمائة الیوم من العرب أشد على من ألف من العجم؛ إن الله أذهب مصدوقتهم

782
00:57:54,666 --> 00:57:59,014
ووهن كيدهم ؛ فلا يروعنكم زهاء ترونه

783
00:57:59,447 --> 00:58:04,619
ولا سواد ولا قسی فج، ولا نبال طوال، فإنهم إذا أعجلوا عنها

784
00:58:04,916 --> 00:58:09,188
أو فدوها، كالبهائم أينما وجهتموها اتجهت

785
00:58:10,065 --> 00:58:11,368
حضرت المثنیٰ نے فرمایا؛

786
00:58:11,420 --> 00:58:17,515
میں نے زمانہ جاہلیت اور دورِ اسلام میں عرب و عجم کے خلاف تلوار اُٹھائی ہے

787
00:58:17,555 --> 00:58:20,038
 عجم سے مراد غیر عرب ہیں

788
00:58:20,073 --> 00:58:23,605
آپؓ نے فرمایا؛ میں ان سے اسلام میں اور اسلام سے پہلے لڑتا آیا ہوں

789
00:58:23,636 --> 00:58:34,145
آپؓ فرماتے ہیں؛  ایسا ہوتا تھا کہ سو عجم ،ایک ہزار عربوں پہ غالب تھے

790
00:58:34,192 --> 00:58:41,478
لیکن اب ایک سو عرب اسلام کی بدولت ایک ہزار عجم سے زیادہ مضبوط ہیں

791
00:58:41,515 --> 00:58:48,145
اور پھر فرمایا؛ پس ان(دشمن) کی کثیر تعداد تمہارے دلوں میں خوف پیدا نہ کر پائے

792
00:58:48,175 --> 00:58:55,298
اور ان کے نیزے،بھالے اور طاقتور کمان آپ کے حوصلے پست نہ کر پائیں

793
00:58:55,339 --> 00:59:01,638
کیونکہ اگر اُن کے ہتھیار کھو جائیں یا اگر ان کا سامانِ حرب ان سے چھین لیا جائے

794
00:59:01,670 --> 00:59:07,171
وہ مویشیوں کے ریوڑ کی مانند ہو جاتے ہیں جنہیں آپ جس طرح چاہیں ہانک سکتے ہیں

795
00:59:07,210 --> 00:59:13,078
آپؓ فرما رہے تھے کہ کافر اپنے ہتھیاروں کے بغیر چوپایوں کی طرح ہیں

796
00:59:13,110 --> 00:59:16,068
انھیں جہاز کی سیٹ سے باہر نکالیں اور یہی اُن کا اختتام ہے

797
00:59:16,089 --> 00:59:23,231
چنانچہ حضرت المثنٰی بن حارثہؓ نے یہاں مسلمانوں کو واضح دوٹوک انداز میں ایک بیان دیا

798
00:59:23,256 --> 00:59:28,576
مسلمانوں کو بتا دیا، کہ دشمن کی کثیر تعداد سے آپ کو ڈرنا نہیں چاہیے، اور نہ ہی آپ دشمن کے سامانِ حرب اور ہتھیاروں سے مرعوب ہوں

799
00:59:28,624 --> 00:59:36,035
کیونکہ تعداد اور عدّت کے لحاظ سے، تیاری کے لحاظ سے وہ مسلمانوں سے کہیں زیادہ طاقتور تھے

800
00:59:36,076 --> 00:59:42,771
ابن قیمؒ  فرماتے ہیں کہ رومیوں اور فارسیوں کی تعداد زیادہ تھی

801
00:59:42,818 --> 00:59:51,671
اور رومی زیادہ ہتھیاروں سے لیس تھے اور وہ تربیت یافتہ مضبوط قد کاٹھ کے مالک تھے جب کہ ان کے مقابلے میں مسلمان کمزور جسامت کے حامل تھے

802
00:59:51,704 --> 00:59:54,605
میرا مطلب ہے کہ ہم کہتے ہیں کہ حضرت عمر بن خطابؓ اور حضرت خالد بن ولیدؓ بلند قامت تھے

803
00:59:54,630 --> 00:59:59,285
 لیکن در حقیقت یہ صحرا نورد تھے

804
00:59:59,323 --> 01:00:06,425
لہٰذا قد کاٹھ کے لحاظ سے یقیناً رومیوں کی فوجیں ان سے زیادہ مضبوط تھیں

805
01:00:06,455 --> 01:00:08,115
لیکن پھر ابن القیمؒ فرماتے ہیں؛

806
01:00:08,135 --> 01:00:11,308
ولكن قلوبهم خانتهم حين كان أهج ألناس عليها

807
01:00:11,668 --> 01:00:14,681
لیکن جب مقابلے کا وقت آیا تو اُن کے حوصلے پست ہوگئے ،وہ ہمت ہار گئے

808
01:00:14,707 --> 01:00:18,425
تو ان کے مضبوط قد کاٹھ بلند حوصلے اور مضبوط دل سے عاری تھے

809
01:00:18,472 --> 01:00:22,718
اور جب میدان میں مقابلے کا لمحہ آیا تو ان کے قدم اُکھڑ گئے، وہ ہمت ہار گئے

810
01:00:22,743 --> 01:00:26,821
اس لیے مسلمان کو ان تمام دنیاوی اعدادوشمار سے مرعوب نہیں ہونا چاہیئے

811
01:00:26,846 --> 01:00:31,491
جو کہ ہمارے سامنے تعداد، سازوسامان اور تمام جنگی ہتھیار کے صورت میں آتے ہے کیونکہ یہ بے معنی ہے

812
01:00:31,532 --> 01:00:36,225
میرا مطلب ہے "الوھن " یعنی کمزوری، ایمان کی کمزوری

813
01:00:36,266 --> 01:00:41,091
اللہ عَزَّوَجَلْ کسی کے دل میں "ألوهن" ڈال سکتا ہے

814
01:00:41,116 --> 01:00:45,741
جس کی انگلیاں روئے زمین کے سب سے طاقتور ہتھیار کے بٹن پر ہوں

815
01:00:45,766 --> 01:00:47,938
لیکن وہ اس ہتھیار کو استعمال نہیں کر سکے گا

816
01:00:47,963 --> 01:00:51,011
کیونکہ اللہ تعالیٰ نے اس کے دل میں "الوھن" ڈال دیا ہے

817
01:00:51,036 --> 01:00:54,625
اللہ عَزَّوَجَلْ یہودیوں کے خلاف رسول اللہؐ کی جنگ سے متعلق فرماتا ہے؛

818
01:00:54,650 --> 01:00:56,168
وَقَذَفَ فِى قُلُوبِهِمُ ٱلرُّعْبَ

819
01:00:56,489 --> 01:01:01,941
ترجمہ ؛اللہ نے ان کے دلوں میں ہیبت ڈال دی، ان(یہود) کے پاس مضبوط قلعے تھے

820
01:01:01,966 --> 01:01:05,465
لیکن اللہ عَزَّوَجَلْ نے جب ان کے دلوں پہ مسلمانوں کی ہیبت طاری کردی تو ان کی طاقت کچھ کام نہ آئی

821
01:01:05,490 --> 01:01:09,468
نہ اُن کے ہتھیاروں کام آئے اور نہ ہی ان کے کثیر لشکر نے ان کی مدد کی

822
01:01:09,493 --> 01:01:14,951
اور اللہ عَزَّوَجَلْ وہ ہے جو دلوں پر قدرت رکھتا ہے اور وہ "الوھن" یا یا رُعب کسی دل میں ڈال سکتا ہے

823
01:01:14,981 --> 01:01:15,829
 رسول اللہؐ فرماتے ہیں؛

824
01:01:15,854 --> 01:01:17,388
نصرت بالرعب مسيرة شهر

825
01:01:17,530 --> 01:01:20,905
مجھے دشمن کے دل پہ ایک ماہ پہلے ہیبت طاری کرکے اللہ نے فتح سے ہمکنار کیا ہے

826
01:01:20,930 --> 01:01:25,599
 اب عراق میں مکمل فوج کی کمان حضرت المثنیٰؓ کے سپرد کر دی گئی تھی

827
01:01:25,624 --> 01:01:27,548
تو آپؓ وہاں کے امیر تھے

828
01:01:27,573 --> 01:01:34,237
حضرت ألمثنى بن حارثه شعيبانيؓ ایک عظیم رہنما، اور کمانڈر تھے، یہ نام آپ کو یاد رکھنا ہے

829
01:01:34,270 --> 01:01:39,531
آپؓ ہی وہ شخصیت تھے جن کی وساطت سے عراق کی فتوحات کا آغاز ہوا

830
01:01:39,556 --> 01:01:45,078
اور آپؓ نے حضرت خالد بن ولیدؓ کی عدم موجودگی میں عراق میں فتوحات کے سلسلے کو جاری رکھا

831
01:01:45,103 --> 01:01:52,822
 لہذا، حضرت المثنیٰؓ کو کچھ کمک کی ضرورت تھی کیونکہ آپؓ دشمن کے علاقے میں مزید آگے پیش قدمی کر رہے تھے

832
01:01:52,847 --> 01:01:55,618
آپؓ نے حضرت ابوبکر صدیقؓ کو خط بھیجا

833
01:01:55,643 --> 01:02:01,305
لیکن اس وقت حضرت ابوبکرصدیقؓ کی ترجیح ایک زیادہ اہم معاملہ تھا

834
01:02:01,330 --> 01:02:05,591
اور یہ مقدس سرزمین(بیت المقدس) کی فتح تھی

835
01:02:05,616 --> 01:02:12,378
چنانچہ حضرت ابوبکر صدیقؓ نے مصروفیت کی بناء پہ حضرت المثنیٰؓ کے خط کا جواب دینے میں تاخیر کی

836
01:02:12,403 --> 01:02:17,131
جب حضرت ألمثنىٰ نے دیکھا کہ انہیں خلیفہ کی طرف سے کوئی جواب نہیں ملا

837
01:02:17,156 --> 01:02:21,465
آپؓ نے فیصلہ کیا کہ وہ خود جا کر خلیفہ سے ملاقات کریں گے

838
01:02:21,490 --> 01:02:25,251
چنانچہ آپؓ عراق سے روانہ ہوئے اور مدینہ پہنچ گئے اور خلیفہ سے ملاقات کی

839
01:02:25,276 --> 01:02:29,305
اور خلیفہ کو درپیش صورتحال سے آگاہ کیا، اب خلیفہ آپؓ کو کمک فراہم کرنے سے قاصر تھے

840
01:02:29,330 --> 01:02:39,965
کیونکہ خلیفہ نے متحرک اور یکجا کرتے ہوئے، تمام قبائل سے جنگی کمک لی اور انہیں مقدس سرزمین پر بھیج دیا

841
01:02:39,990 --> 01:02:48,938
تو حضرت ألمثنىٰ نے فرمایا؛ پھرمجھے مسلمانوں(سابق مرتدین) کی کمک دیں،

842
01:02:48,968 --> 01:02:52,845
حضرت ابوبکر صدیقؓ اس وقت بستر مرگ پر تھے

843
01:02:52,870 --> 01:02:57,918
چنانچہ آپؓ نے اپنے دورِخلافت میں مرتدین کو جنگ میں شامل ہونے کی اجازت دینے سے انکار کردیا تھا

844
01:02:57,943 --> 01:03:03,768
اب چونکہ حالات مختلف ہیں، مرتدین اسلام پر ثابت قدم تھے

845
01:03:03,793 --> 01:03:10,911
آپؓ نے دو سال تک ان(مرتدین) کو پَرکھا، حضرت ابوبکرصدیقؓ نے آپؓ کی بات کو سمجھا

846
01:03:10,936 --> 01:03:15,558
تو آپؓ نے حضرت عمرؓ سے فرمایا جو آپؓ کے ساتھ موجود تھے

847
01:03:15,583 --> 01:03:23,331
آپؓ نے فرمایا؛ اے عمرؓ‌! اے عمرؓ جو میں تم سے کہتا ہوں اسے سنو، پھر اس پر عمل کرنا

848
01:03:23,356 --> 01:03:26,025
مجھے محسوس ہورہا ہے کہ آج میرا آخری دن ہے

849
01:03:26,050 --> 01:03:34,085
اگر میں مرجاؤں تو آپ شام ڈھلنے سے پہلے مجاہدین کو المثنیٰ کے ساتھ روانہ کرنے کے لئے بلائیں

850
01:03:34,110 --> 01:03:37,805
اگر مجھے زندگی نے رات تک مہلت دی

851
01:03:37,830 --> 01:03:42,498
تو صبح ہونے سے پہلے تمام مردوں کو ألمثنىؓ کے ساتھ جانے کے لیے بلانا

852
01:03:42,523 --> 01:03:52,491
کسی بھی آفت یا پریشانی کو خود پہ حاوی نہ ہونے دینا، آپ کی ترجیح آپ کے مذہبی معاملات اور اللہ کے احکامات ہیں

853
01:03:52,516 --> 01:03:55,453
حضرت ابوبکرؓ نے فرمایا کہ آپ نے دیکھا کہ میں نے  رسول اللہؐ کے وصال والے دن کیا طرزِ عمل اختیار کیا

854
01:03:55,478 --> 01:03:57,165
دیکھیں؛ حضرت ابوبکرؓ،حضرت عمرؓ سے فرما رہے ہیں کہ

855
01:03:57,205 --> 01:04:03,377
کوئی مصیبت؛ اللہ اور اس کے رسولؐ کی طرف سے تفویض کردہ  فرائض کی انجام دہی؛ میں لغزش نہ لانے پائے

856
01:04:03,410 --> 01:04:06,011
 آپؓ اپنی موت کی طرف اشارہ کر رہے تھے

857
01:04:06,036 --> 01:04:08,083
آپؓ فرما رہے تھے کہ اگر میں مر بھی جاؤں

858
01:04:08,113 --> 01:04:16,265
 تو جس دن میں مر جاؤں اس دن بھی آپ فوجوں کو متحرک کرنے اور ألمثنىؓ کے ساتھ بھیجنے سے باز نہ آنا

859
01:04:16,290 --> 01:04:22,658
سبحان اللہ ،حضرت ابوبکرؓ ہلکا سا وقفہ دینے کو بھی تیار نہیں تھے

860
01:04:22,683 --> 01:04:28,365
پھر آپؓ نے فرمایا؛ آپ نے دیکھا کہ میں نے رسول اللہؐ کے وصال کے دن کیا طرزِ عمل اختیار کیا

861
01:04:28,390 --> 01:04:31,568
اور لوگ اس دن سے بڑھ کہ کبھی درد و غم سے دوچار نہیں ہوئے

862
01:04:31,593 --> 01:04:34,851
میرا مطلب ہے، آپ نے دیکھا کہ میں نے اس دن کیا عمل کیا تھا

863
01:04:34,876 --> 01:04:38,348
یہ وہ وقت تھا جب خلیفہ کو بیعت دی گئی تھی

864
01:04:38,373 --> 01:04:41,131
اس کے تین دن بعد میں نے اسامہؓ کی فوج روانہ کی

865
01:04:41,156 --> 01:04:45,305
پس رسول اللہؐ کا وصال میری موت سے بڑا نقصان تھا

866
01:04:45,330 --> 01:04:47,765
اس غم نے مجھے اپنے فرائض کی ادائیگی سے باز نہیں رکھا

867
01:04:47,790 --> 01:04:50,985
آپؓ نے فرمایا؛ پس میں چاہتا ہوں کہ آپ میرے طرزِ عمل کی پیروی کریں

868
01:04:51,010 --> 01:04:57,705
پھر آپؓ نے فرمایا؛ اللہ کی قسم! اگر میں اللہ اور اس کے رسول اللہؐ کے تفویض کردہ معاملہ میں کوتاہی کا مرتکب ہوا تو

869
01:04:57,730 --> 01:04:59,948
اللہ مجھے معاف نہیں کرے گا اور مجھے سزا دے گا

870
01:04:59,973 --> 01:05:03,045
تو میری کوتاہی کی بناء پہ مدینہ شعلوں کی لپیٹ میں آجائے گا

871
01:05:03,070 --> 01:05:05,722
حضرت ابوبکرؓ نے فرمایا؛ اگر اللہ نے شام میں مسلم قیادت کو فتح عطا فرمائی

872
01:05:05,758 --> 01:05:15,463
حضرت خالدؓ کے لشکر کو عراق واپس روانہ کر دینا، کیونکہ یہ وہاں کے مقامی ہیں؛ عراقی اللہ کی خشنودی، دشمن کے خلاف جرات مندی اور بہادری کا مظاہرہ کرنے والے لوگ ہیں

873
01:05:15,503 --> 01:05:20,828
آپؓ نے فرمایا؛ ارض مقدس کے محاذ پہ معاملات فیصلہ کُن مراحل پہ پہنچ جائیں تو لشکر میں موجود عراق کے لوگوں کو واپس عراق بھیج دیں

874
01:05:20,853 --> 01:05:27,038
یہ ان کی سرزمین ہے اور وہ اسلام دشمن کے خلاف بہادری اور جوش و جذبے سے سینہ سپر ہونے والے لوگ ہیں

875
01:05:27,063 --> 01:05:32,268
چنانچہ حضرت المثنیٰ بن حارثہ الشعیبانیؓ کو عسکری کمک ملی

876
01:05:32,293 --> 01:05:35,768
صَلَّى الله عَلى سَيَّدِنَا محمد وَعَلى اَلِهِ وَ صَحْبِهِ وَسَلِّمْ

