1
00:02:18,538 --> 00:02:20,106
اَعُوْذُ بِاللهِ مِنَّ الشِّيْطَانِ الرَّجِيْمِ۞

2
00:02:20,173 --> 00:02:22,442
بِسْمِ اللهِ الرَّحْمَانِ الرَّحِيْمَ۞

3
00:02:22,976 --> 00:02:27,847
رَبِّ اشْرَحْ لِي صَدْرِي۞ وَيَسِّرْ لِي أَمْرِي۞وَاحْلُلْ عُقْدَةً مِنْ لِسَانِيْ۞ يَفْقَهُوا قَوْلِيِ۞

4
00:02:27,947 --> 00:02:35,422
اَلْحَمْدُ لله، وَالصَّلَاةُ وَالسَّلَامُ عَلى سَيِّدِنَا محمدوَعَلَى اَلِهِ وَصَحْبِهِ وَسَلِّمْ تَسْلِيْمًا كَثِيْرا

5
00:02:35,522 --> 00:02:39,644
 اللہ تعالیٰ سے دعا ہے کہ وہ اس اجتماع میں برکت عطا فرمائے،

6
00:02:39,692 --> 00:02:43,917
 ہم اللہ تعالی سے دعا گو ہیں کہ ہم جو کچھ سیکھیں اس سے ہمیں فائدہ پہنچے

7
00:02:43,963 --> 00:02:49,130
 ہم اللہ سے یہ بھی دعا کرتے ہیں کہ وہ ہمیں علمِ نافع عطا فرمائے

8
00:02:49,169 --> 00:02:54,990
 اللہ تعالیٰ سے دعا ہے کہ وہ ہمیں ان لوگوں میں سے بنائے جو رسول اللہﷺ کے طریقے پر چلیں اور آپﷺ سے محبت کریں۔

9
00:02:55,041 --> 00:03:00,829
 اور ہم اللہ سے دعا گو ہیں کہ وہ ہمیں ان لوگوں میں سے بنائے جنہیں جنت میں آپ ﷺ کی رفاقت نصیب ہو۔

10
00:03:00,880 --> 00:03:05,281
سب سے پہلے ہم "سیرۃ" کی تعریف سے شروعات کرتے ہیں۔

11
00:03:05,305 --> 00:03:09,078
لفظ "سیرۃ "کا کیا مطلب ہے؟

12
00:03:09,122 --> 00:03:15,106
"سیرۃ" کا ایک لغوی معنی "راستہ" ہے،

13
00:03:15,161 --> 00:03:18,097
اورسَیر چلنے پھرنے کو کہتے ہیں۔

14
00:03:18,164 --> 00:03:21,852
جب آپ ایک جگہ سے دوسری جگہ چلتے ہیں تو یہ کہا جاتا ہے: سَارَ فُلَانْ۔

15
00:03:21,901 --> 00:03:25,545
فلُان چل رہا ہے، جیسے یہ شخص چل رہا ہے۔

16
00:03:25,605 --> 00:03:32,645
لہذا وہ راستہ جو انسان اپنی زندگی کے دوران اختیار کرتا ہے اسے سیرۃ کہتے ہیں۔

17
00:03:32,679 --> 00:03:39,605
اور ہنس ویہر کی لغت لفظ سیرة کا ترجمہ دیتی ہے؛

18
00:03:39,652 --> 00:03:46,635
طرز عمل، برتاؤ، طرزِ زندگی، رویہ، پوزیشن

19
00:03:46,659 --> 00:03:50,230
ردعمل، عمل کا طریقہ اور سوانح حیات۔

20
00:03:50,263 --> 00:03:53,924
یہ سب الفاظ سیرۃ کے معنی میں آتے ہیں۔

21
00:03:53,967 --> 00:03:58,471
اور سیرت کسی بھی شخص کی سوانح حیات ہوسکتی ہے، یہ ضروری نہیں کہ محمدﷺ کی ہی ہو۔

22
00:03:58,496 --> 00:04:05,536
 البتہ ہم نے محمدﷺ کے لیے یہ لفظ اتنا استعمال کیا ہے کہ جب ہم سیرۃ کہتے ہیں،

23
00:04:05,578 --> 00:04:11,026
تو تقریباً ہر وقت ہی اس سے مراد محمدﷺ کی زندگی ہوتی ہے۔

24
00:04:11,050 --> 00:04:15,444
لیکن آپ حضرت ابوبکرؓ کی سیرت،حضرت عمرؓ کی سیرت یا فلاں کی سیرۃ بھی کہہ سکتے ہیں۔

25
00:04:15,488 --> 00:04:18,391
 یعنی کسی شخص کی مکمل سوانح حیات۔

26
00:04:18,424 --> 00:04:22,317
پس لفظ سیرۃ کا یہی معنی ہے، انسان کی مکمل زندگی

27
00:04:22,362 --> 00:04:28,033
 اور اب ہم عظیم ترین ہستی محمدﷺ کی زندگی کا مطالعہ کر رہے ہیں۔

28
00:04:28,067 --> 00:04:31,633
سیرت کے مطالعہ کی کیا اہمیت ہے؟

29
00:04:31,671 --> 00:04:33,322
نمبر ایک

30
00:04:33,373 --> 00:04:38,422
محمد ﷺ کی زندگی دراصل اسلامی تاریخ ہے۔

31
00:04:38,478 --> 00:04:45,070
آپ محمد ﷺ کی زندگی کا مطالعہ کر کے اسلام کی مختصر تاریخ کا مطالعہ کر رہے ہیں۔

32
00:04:45,118 --> 00:04:55,279
ان کی زندگی، ان کی سیرت میں ہمیں ایسے حالات و واقعات ملیں گے جو ہماری مدد کریں گے

33
00:04:55,328 --> 00:05:01,222
ہر اس چیز کو جاننے میں جس کی ہمیں دعوتی میدان میں ضرورت پڑ سکتی ہے۔

34
00:05:01,267 --> 00:05:05,668
پس محمدﷺ کی زندگی واقعی اسلامی تاریخ کی عکاس ہے۔

35
00:05:05,705 --> 00:05:11,967
ہم صرف ایک شخص کی سوانح حیات کا ہی مطالعہ نہیں کر رہے بلکہ ہم اپنے دین کی تاریخ کا مطالعہ کر رہے ہیں۔

36
00:05:12,011 --> 00:05:14,967
محمد ابن سعد بن ابی وقاصؓ

37
00:05:15,014 --> 00:05:17,633
حضرت سعد ابن ابی وقاصؓ عشرہ مبشرہ میں سے ایک ہیں۔

38
00:05:17,684 --> 00:05:20,787
وہ اُن دس میں سے ایک ہیں جنہیں دنیا میں ہی جنت کی بشارت دی گئی۔

39
00:05:20,818 --> 00:05:23,411
ان کے بیٹے محمد ؒکہتے ہیں؛

40
00:05:23,456 --> 00:05:28,061
کہ ہمارے والد ہمیں رسول اللہ ﷺ کے غزوات کے بارے میں بتاتے تھے

41
00:05:28,127 --> 00:05:31,320
وہ ہمیں رسول اللہ ﷺ کی سیرت پڑھاتے تھے

42
00:05:31,360 --> 00:05:35,854
اور وہ ہمیں بتاتے تھے کہ یہ تمہارے باپ دادا کی روایات ہیں

43
00:05:35,902 --> 00:05:38,094
لہٰذا تم ان کا مطالعہ کرو۔

44
00:05:38,137 --> 00:05:41,327
اور وہ محمدﷺ کی سیرت کو لفظ "مغازی" سے منصوب کرتے

45
00:05:41,374 --> 00:05:43,190
مغازی سے مراد جنگیں ہیں۔

46
00:05:43,242 --> 00:05:47,223
کیونکہ رسول اللہ ﷺ کی زندگی کا آخری حصہ مغازی میں گزرا تھا۔

47
00:05:47,280 --> 00:05:52,302
پس وہ اس لفظ مغازی کو محمد ﷺ کی پوری زندگی کے لیے استعمال کرتے تھے۔

48
00:05:52,352 --> 00:05:57,785
اور علی بن حسین ابن حضرت علی ابن ابی طالبؒ، جو کہ حضرت علیؓ  کے پوتے ہیں، وہ فرماتے تھے کہ

49
00:05:57,824 --> 00:06:02,328
ہمیں رسول اللہ ﷺ کی سیرت اس طرح پڑھائی جاتی، جیسے ہمیں قرآن سکھایا جاتا۔

50
00:06:02,422 --> 00:06:04,928
ان کے نزدیک سیرت کی اتنی اہمیت تھی

51
00:06:04,964 --> 00:06:07,987
وہ اس کا مطالعہ اس طرح کرتے تھے جیسے وہ قرآن پڑھتے تھے

52
00:06:08,034 --> 00:06:15,263
اور اس کی وجہ بھی ہے، کیوں کہ اگر آپ موسیٰؑ کی زندگی کا مطالعہ کرنا چاہتے ہیں تو ہم کہاں جائیں؟

53
00:06:15,308 --> 00:06:17,263
ہم اس کا مطالعہ کہاں سے کرتے ہیں؟

54
00:06:17,310 --> 00:06:18,990
قرآن سے۔

55
00:06:19,045 --> 00:06:23,183
اگر ہم حضرت عیسیٰؑ کی زندگی کا مطالعہ کرنا چاہتے ہیں،

56
00:06:23,216 --> 00:06:25,636
ہم قرآن سے رجوع کرتے ہیں۔

57
00:06:25,685 --> 00:06:29,722
لیکن اگر ہم محمدﷺ کی سیرت کا مطالعہ کرنا چاہتے ہیں،

58
00:06:29,789 --> 00:06:35,672
 آپﷺ کی زندگی، اگرچہ اس کے کچھ پہلو قرآن میں مذکور ہیں،

59
00:06:35,728 --> 00:06:42,535
لیکن ہمارے پاس قرآن میں محمدﷺ کی زندگی کے بارے میں اتنی تفصیل نہیں ہے، جتنی کہ حضرت موسیٰؑ کے بارے میں ہے۔

60
00:06:42,568 --> 00:06:47,562
لہٰذا ہم رسول اللہﷺ کی زندگی کا مطالعہ کرنے کے لیے سیرۃ النبیﷺ کی طرف رجوع کرتے ہیں۔

61
00:06:47,607 --> 00:06:52,158
تمام انبیاء کی زندگیوں کے بارے میں قرآن میں درج ہے، سوائے محمد ﷺ کے،

62
00:06:52,211 --> 00:06:55,238
 محمد ﷺ کی زندگی کے بارے میں ہم سیرت سے جانیں گے،

63
00:06:55,281 --> 00:06:57,784
پس جب ہم انبیاءؑ کے بارے میں جاننا چاہتے ہیں، تو ہم قرآن کی طرف رجوع کرتے ہیں۔

64
00:06:57,817 --> 00:07:01,940
جب ہم محمدﷺ کے بارے میں جاننا چاہتے ہیں تو ہم ان کی سیرت کی طرف رجوع کرتے ہیں۔

65
00:07:01,988 --> 00:07:05,742
جیسا کہ پہلے بتایا کہ اگرچہ قرآن میں ان کی زندگی کے بارے میں کچھ حوالہ جات موجود ہیں۔

66
00:07:05,792 --> 00:07:10,056
ہم قرآن کو سمجھنے میں سیرت کے کردار کے اثر کے بارے میں بات کریں گے۔

67
00:07:10,096 --> 00:07:11,063
نمبر دو!

68
00:07:11,095 --> 00:07:15,022
سیرۃ کے مطالعہ کی دوسری وجہ۔

69
00:07:15,067 --> 00:07:20,206
اس سے ہمارے دلوں میں محمدﷺ کی خاص محبت پیدا ہوتی ہے۔

70
00:07:20,239 --> 00:07:22,888
محمدﷺ سے محبت کرنا عبادت ہے

71
00:07:22,942 --> 00:07:26,312
محمدﷺ سے محبت کرنا ہمارے دین کا حصہ ہے۔

72
00:07:26,379 --> 00:07:27,698
آپﷺ فرماتے ہیں؛

73
00:07:27,747 --> 00:07:33,970
لَا يُؤمِنُ أحَدَكُمْ حَتَّى أَكُوْنَ أَحَبَّ إِلَيْهِ مِنْ وَلِدَهِ وَوَالَدِهِ وَالنَّاسِ أَجْمَعِيْنْ۞

74
00:07:34,020 --> 00:07:36,710
تم میں سے کوئی مومن نہیں بن سکتا

75
00:07:36,756 --> 00:07:42,116
یہاں تک کہ تم مجھ سے اپنے والدین، اپنی اولاد اور پوری دنیا سے زیادہ محبت نہ کرو۔

76
00:07:42,161 --> 00:07:48,126
ہم اس وقت تک سچے مسلمان نہیں بن سکتے جب تک کہ ہم محمدﷺ کو ہر چیز سے زیادہ عزیز نہ رکھیں۔

77
00:07:48,167 --> 00:07:53,473
پس محمد ﷺ سے محبت کرنا اسلام کا حصہ ہے۔

78
00:07:53,506 --> 00:07:57,967
حضرت عمر بن الخطابؓ نبی کریم ﷺ کے پاس آئے اور کہا؛

79
00:07:58,010 --> 00:08:01,714
حضرت عمر ابن الخطابؓ نہایت سچے اور صاف گو انسان تھے۔

80
00:08:01,781 --> 00:08:08,346
وہ رسول اللہﷺ کے پاس گئے اور عرض کیا:" یا رسول اللہﷺ! میں اپنی ذات کے علاوہ ہر چیز سے بڑھ کر آپؐ سے محبت کرتا ہوں۔

81
00:08:08,387 --> 00:08:12,308
میں اپنے سوا ہر چیز سے زیادہ آپؐ سے محبت کرتا ہوں۔

82
00:08:12,358 --> 00:08:16,662
رسول اللہﷺ نے فرمایا؛

83
00:08:16,691 --> 00:08:19,238
 جب تک تم مجھ سے محبت نہیں کرتے۔

84
00:08:19,298 --> 00:08:26,790
یعنی تمہارا ایمان اس وقت تک کامل نہیں ہوسکتا جب تک کہ میں تمہیں اپنے نفس سے زیادہ محبوب نہ ہو جاؤں۔

85
00:08:26,891 --> 00:08:32,591
چنانچہ عمر بن الخطابؓ واپس آئے اور کہا: یا رسول اللہﷺ !اب میں آپ سے اپنی جان سے بھی زیادہ محبت کرتا ہوں۔

86
00:08:32,645 --> 00:08:33,822
رسول اللہﷺ نے فرمایا:

87
00:08:33,846 --> 00:08:34,423
اَلْآنَ اِذَنْ

88
00:08:34,447 --> 00:08:40,128
اب تمہارا ایمان کامل ہوگیا ہے۔

89
00:08:40,152 --> 00:08:44,299
آج بھی امتِ مسلمہ محمدﷺ سے محبت کا دعویٰ کرتی ہے

90
00:08:44,323 --> 00:08:48,770
اگر آپ کسی بھی مسلمان سے پوچھیں کہ: کیا آپ محمدﷺ سے محبت کرتے ہیں؟ وہ کہیں گے: ہاں

91
00:08:48,794 --> 00:08:56,011
لیکن محبت اس وقت تک گہری اور پرخلوص نہیں ہو سکتی، جب تک کہ آپ اس شخص کو نہ جانیں۔

92
00:08:56,035 --> 00:09:00,749
اگر آپ کسی کے بارے میں ادھوری معلومات رکھتے ہیں، تو آپ اس سے زیادہ محبت نہیں کر سکتے۔

93
00:09:00,773 --> 00:09:03,218
کسی شخص سے محبت کرنے کے لیے، آپ کو اسے اچھے سے جاننے کی ضرورت ہے۔

94
00:09:03,242 --> 00:09:07,122
اور یہ بات خاص طور پر محمدﷺ کے بارے میں ہے کیوں کہ آپ انہیں جتنا زیادہ جانیں گے

95
00:09:07,146 --> 00:09:11,760
آپ ان کی شخصیت سے اتنا ہی متاثر ہوں گے اور اتنی ہی آپ انؐ سے محبت کریں گے۔

96
00:09:11,784 --> 00:09:20,669
اگرچہ امتِ مسلمہ کی کثیر تعداد محمدﷺ کے بارے میں کم علم رکھتی ہے

97
00:09:20,693 --> 00:09:22,738
 لیکن پھر بھی وہ آپﷺ سے محبت کرتی ہے،

98
00:09:22,762 --> 00:09:30,045
لیکن ہم محمدﷺ سے اس وقت تک گہری محبت نہیں کر سکتے جب تک کہ ہم انہیں جان نہ لیں۔

99
00:09:30,069 --> 00:09:34,674
آپ جانتے ہیں کہ صحابہ کرامؓ آپ ﷺ کو جتنا جانتے جاتے

100
00:09:34,707 --> 00:09:36,585
وہ اتنا ہی آپﷺ کے قریب ہوتے جاتےاور اتنی ہی آپﷺ سے محبت کرتے۔

101
00:09:36,609 --> 00:09:38,320
مثال کے طور پر حضرت عمرو بن عاصؓ

102
00:09:38,344 --> 00:09:43,425
وہ محمدﷺ کے سخت ترین دشمنوں میں سے تھے

103
00:09:43,449 --> 00:09:48,163
وہ اسلام کے خلاف سازشیں کرنے والوں میں سے ایک تھے

104
00:09:48,187 --> 00:09:53,936
حضرت عمرو بن عاصؓ بعد میں مسلمان ہوگئے اور جب ان کی وفات کا وقت قریب آیا

105
00:09:53,960 --> 00:09:58,040
عمرو بن العاصؓ رونے لگے، وہ بستر مرگ پر رو رہے تھے۔

106
00:09:58,064 --> 00:10:00,842
تو ان کے بیٹے عبداللہ بن عمروؓ نے ان سے کہا؛

107
00:10:00,866 --> 00:10:04,713
ابا جان! کیا آپ کو رسول اللہﷺ نے اِس کی بشارت نہ دی تھی؟

108
00:10:04,737 --> 00:10:06,915
کیا آپﷺ نے آپ کو اُس کی خوش خبری نہیں دی تھی؟

109
00:10:06,939 --> 00:10:09,384
یعنی حدیث میں ہے کہ رسول اللہﷺ نے فرمایا؛

110
00:10:09,408 --> 00:10:10,786
آمَنَ عمرو

111
00:10:10,810 --> 00:10:14,623
کہ حضرت عمرو بن عاصؓ ایمان لے آئے

112
00:10:14,647 --> 00:10:17,893
چنانچہ رسول اللہﷺ نے یہ گواہی دی کہ عمرو بن العاصؓ مؤمن ہیں۔

113
00:10:17,917 --> 00:10:22,497
 نہ صرف مسلمان بلکہ وہ اعلیٰ درجے کے مومن ہیں ۔

114
00:10:22,521 --> 00:10:27,102
پس ان کے بیٹے اپنےوالد کو یہ بشارت یاد دلانے کی کوشش کر رہے تھے کہ وہ سچے مومن ہیں۔

115
00:10:27,126 --> 00:10:30,706
 یعنی کہ رسول اللہﷺ نے آپ کو یہ سب بشارتیں دی تھیں

116
00:10:30,730 --> 00:10:34,242
 آخر آپ اپنی موت سے قبل کیوں رو رہے ہیں؟

117
00:10:34,266 --> 00:10:38,513
حضرت عمرو بن عاصؓ نے کروٹ لی اور فرمایا؛

118
00:10:38,537 --> 00:10:42,017
میں اپنی زندگی میں تین مراحل سے گزرا ہوں

119
00:10:42,041 --> 00:10:44,119
پہلے مرحلے میں

120
00:10:44,143 --> 00:10:48,924
میرے نزدیک سب سے قابلِ نفرت شخص محمدﷺ تھے

121
00:10:48,948 --> 00:10:52,661
اور میری خواہش تھی کہ میں ان پر قابو پا سکوں

122
00:10:52,685 --> 00:10:55,230
کہ میں ان پر دسترس پا کر انہیں قتل کر ڈالوں۔

123
00:10:55,254 --> 00:11:01,536
یہی میری خواہش اور یہی میری چاہت تھی، محمدﷺ کو قتل کرنا میری آرزو تھی۔

124
00:11:01,560 --> 00:11:06,008
وہ فرماتے ہیں کہ اگر میں اس وقت مر جاتا تو میں ضرور جہنم میں جاتا۔

125
00:11:06,032 --> 00:11:09,778
انہوں نے فرمایا : پھر اللہ نے میرے دل میں اسلام کی محبت ڈال دی۔

126
00:11:09,802 --> 00:11:13,882
اور میں محمد ﷺوسلم کی خدمت میں حاضر ہوا اور کہا: اے محمدﷺ؛

127
00:11:13,906 --> 00:11:15,784
میں مسلمان ہونا چاہتا ہوں

128
00:11:15,808 --> 00:11:20,322
اپنا ہاتھ بڑھائیے تاکہ میں آپ کی بیعت کر سکوں

129
00:11:20,346 --> 00:11:25,961
حضرت عمرو بن عاصؓ فرماتے ہیں: محمدﷺ نے اپنا ہاتھ آگے بڑھایا

130
00:11:25,985 --> 00:11:28,230
اور میں نے اپنا ہاتھ پیچھے کھینچ لیا

131
00:11:28,254 --> 00:11:31,600
چنانچہ رسول اللہﷺ نے حضرت عمرو بن عاصؓ کے سامنے اپنا ہاتھ بڑھایا،

132
00:11:31,624 --> 00:11:34,970
اور جب رسول اللہﷺ اپنا ہاتھ ان کے ہاتھ میں دینے کو تیار تھے

133
00:11:34,994 --> 00:11:36,938
حضرت عمرو بن عاصؓ نے اپنا ہاتھ کھینچ لیا۔

134
00:11:36,962 --> 00:11:39,341
رسول اللہﷺ نے فرمایا: کیا بات ہے؟

135
00:11:39,365 --> 00:11:42,077
حضرت عمرو بن عاصؓ نے کہا: میری ایک شرط ہے۔

136
00:11:42,101 --> 00:11:43,812
اُرِيْدُ اَنْ تَشْتَرِطُ لِنَفْسِيْ

137
00:11:43,836 --> 00:11:46,448
رسول اللہ ﷺنے فرمایا: تمہاری شرط کیا ہے؟

138
00:11:46,472 --> 00:11:51,253
آپ ؓنے فرمایا: میری شرط یہ ہے کہ آپ مجھے معاف کر دیں۔

139
00:11:51,277 --> 00:11:52,054
آپ مجھے درگزر فرمائیں

140
00:11:52,078 --> 00:11:57,159
کیوں کہ حضرت عمرو بن عاصؓ جانتے تھے کہ انہوں نے ماضی میں جو کچھ کیا ہے؟

141
00:11:57,183 --> 00:12:04,599
انہوں نے مسلمانوں کے خلاف جتنے بڑے جرائم کیے، وہ ان کے قتل کے لیے کافی تھے۔

142
00:12:04,623 --> 00:12:10,072
لہٰذا، وہ اس بات کو یقینی بنانا چاہتے تھے کہ رسول اللہﷺ ان سے ماضی میں کیے گئے افعال پر باز پرس نہیں کریں گے

143
00:12:10,096 --> 00:12:11,840
رسول اللہ ﷺ مسکرائے اور فرمایا؛

144
00:12:11,864 --> 00:12:16,378
يَا عمرو: اَمَا تَدْرِي اَنَّ لْاِسْلَامَ يَجُبُّ مَا قَبْلَهَ،

145
00:12:16,402 --> 00:12:19,915
وَاَنَّ الْهِجْرَتَ تَجُبُّ مَا قَبْلَهَا،

146
00:12:19,939 --> 00:12:22,617
وَ اَنَّ الْحَجَّ يَجُبُّ مَا قَبْلَهَ

147
00:12:22,641 --> 00:12:28,790
اے عمروؓ ! کیا تم نہیں جانتے کہ قبولِ اسلام، پہلے کیئے گیے ہر گناہ کو مٹا دیتا ہے۔

148
00:12:28,814 --> 00:12:32,027
اور ہجرت بھی پہلے کے ہر گناہ کو مٹا دیتی ہے۔

149
00:12:32,051 --> 00:12:36,231
اور حج سے بھی پہلے کی ہر چیز کو مٹا دیا جاتا ہے۔

150
00:12:36,255 --> 00:12:39,167
حضرت عمرو بن عاصؓ نےفرمایا: پس میں مسلمان ہوگیا۔

151
00:12:39,191 --> 00:12:41,670
آپؓ نے فرمایا کہ اس مرحلے پر

152
00:12:41,694 --> 00:12:48,376
محمدﷺجو میرے بدترین دشمن تھے، مجھے دنیا میں سب سے محبوب ہو گئے۔

153
00:12:48,400 --> 00:12:50,879
انہوں نے فرمایا: میں آپﷺ سے بہت محبت کرتا تھا

154
00:12:50,903 --> 00:12:53,115
اور میں آپﷺ کی بہت عزت کرتا تھا،

155
00:12:53,139 --> 00:12:56,752
یہاں تک کہ میں آپ کے چہرے کی مکمل جھلک بھی نہیں دیکھ سکتا تھا۔

156
00:12:56,776 --> 00:12:59,855
جب بھی، میں انہیں دیکھتا تھا، میں اپنی نظریں جھکا لیتا تھا،

157
00:12:59,879 --> 00:13:06,061
آپؓ نے فرمایا: مجھے آپﷺ سے اتنی محبت اور عقیدت تھی کہ میں آپﷺ کے چہرے کو آنکھ بھر کر کے بھی نہ دیکھ پاتا۔

158
00:13:06,085 --> 00:13:10,699
اور اگر آج تم مجھ سے ان کی صورت بیان کرنے کا کہو تو میں نہیں کرسکتا

159
00:13:10,723 --> 00:13:14,703
آپؓ نے فرمایا : اگر میں اس مرحلے پر انتقال کرجاتا۔۔۔

160
00:13:14,727 --> 00:13:17,973
میں جنت میں داخل ہونے کی امید کرتا۔

161
00:13:17,997 --> 00:13:22,144
اور پھر آپؓ نے فرمایا: پھر بعد میں کئی مراحل آئے اور ہم نہیں جانتے کہ اب ہم کہاں کھڑے ہیں؟

162
00:13:22,168 --> 00:13:25,914
بہرحال حدیث کے مزید حصے بھی ہیں

163
00:13:25,938 --> 00:13:29,384
لیکن ہماری توجہ کا مرکز یہ ہے کہ حضرت عمرو بن العاصؓ

164
00:13:29,408 --> 00:13:34,389
جب محمدﷺ سے واقف ہوئے تو وہ آپﷺ کے قریب ہو گئے۔

165
00:13:34,413 --> 00:13:41,096
محمدﷺ جو ان کے سب سے بڑے دشمن تھے وہ ان کے سب سے محبوب دوست بن گئے۔

166
00:13:41,120 --> 00:13:48,621
حضرت سہیل بن عمروؓ کو قریش نے صلح حدیبیہ سے پہلے محمدﷺ سے مذاکرات کرنے کے لیے بھیجا

167
00:13:48,661 --> 00:13:51,940
سہیل بن عمروؓ بین الاقوامی معاملات طے کیا کرتے تھے۔

168
00:13:51,964 --> 00:13:59,381
وہ فارس کے شہنشاہ، رومی بادشاہ اور حبشہ کے حاکموں کے درباروں میں جا چکے تھے۔

169
00:13:59,405 --> 00:14:01,650
وہ وسیع تعلقات رکھتے تھے۔

170
00:14:01,674 --> 00:14:07,155
قریش نے انہیں محمدﷺ سے مذاکرات کے لیے بھیجا

171
00:14:07,179 --> 00:14:11,293
چنانچہ وہ مدینہ آئے

172
00:14:11,317 --> 00:14:19,034
اور انہوں نے براہِ راست محمدﷺ کے ساتھ صحابہ کے رویے کا مشاہدہ کیا

173
00:14:19,058 --> 00:14:24,172
چناچہ حضرت سہیل بن عمروؓ قریش کو خبر دینے کے لیے واپس گئے، انہوں نے کہا؛

174
00:14:24,196 --> 00:14:29,978
آپؓ نے کہا: میں رومی بادشاہ سے ملا ہوں

175
00:14:30,002 --> 00:14:32,314
میں شہنشاہِ فارس کے پاس بھی گیا ہوں

176
00:14:32,338 --> 00:14:35,520
میں حبشہ کے نجاشی سے بھی ملا ہوں۔

177
00:14:35,560 --> 00:14:47,376
لیکن میں نے اپنی زندگی میں کبھی کوئی ایسا راہنما نہیں دیکھا جس سے اس کے پیروکار اس قدر محبت کرتے ہوں اور اس کا قدر احترام کرتے ہوں، جیسا کہ محمد ﷺ سے کرتے ہیں۔

178
00:14:47,416 --> 00:14:51,372
میں نے دنیا میں ایسا کچھ نہیں دیکھا۔

179
00:14:51,392 --> 00:14:58,602
رومی بادشاہ، فارسی شہنشاہ، حبشہ کا نجاشی اگرچہ ان کے پاس طاقت اور سلطنتیں تھیں۔

180
00:14:58,633 --> 00:15:04,514
میں نے کبھی ایسی قوم نہیں دیکھی جو اپنے قائد سے اتنی محبت کرتی ہو جس طرح صحابہ کرامؓ محمدﷺ سے کرتے ہیں

181
00:15:04,538 --> 00:15:06,383
انہوں نے کہا: میں نے حیران کن چیزیں دیکھیں،

182
00:15:06,407 --> 00:15:17,160
 محمدﷺ جب وضو کرتے ہیں تو صحابہؓ آپؐ کے جسم سے ٹپکنے والے پانی کو پانے کے لیے لپکتے ہیں۔

183
00:15:17,184 --> 00:15:21,598
چنانچہ انہوں نے ان سے کہا: جو چاہو کرو! یہ وہ لوگ ہیں جو اپنے قائد کو کبھی نہیں چھوڑیں گے۔

184
00:15:21,622 --> 00:15:23,934
صحابہؓ انہیں کبھی تنہا نہیں چھوڑیں گے

185
00:15:23,958 --> 00:15:26,770
بلکہ پہلے اپنی جانیں قربان کریں گے

186
00:15:26,794 --> 00:15:29,940
وہ ان کے لیے سب کچھ قربان کر دیں گے۔

187
00:15:29,964 --> 00:15:33,577
لہذا، اگر آپ محمدﷺ سے محبت کرنا چاہتے ہیں، تو ہمیں ان کے بارے میں مزید جاننے کی ضرورت ہے۔

188
00:15:33,601 --> 00:15:37,438
جیسا کہ میں نے پہلے کہا کہ اگرچہ مسلمانوں کی اکثریت

189
00:15:37,471 --> 00:15:42,419
محمدﷺ کے بارے میں زیادہ معلومات نہیں رکھتی، ہم ان کی سیرت کے بارے میں بھی زیادہ نہیں جانتے

190
00:15:42,443 --> 00:15:47,591
کیونکہ یہ مسلم دنیا کے اسکولوں میں پڑھائے جانے والے نصاب کا حصہ نہیں ہے۔

191
00:15:47,615 --> 00:15:52,396
آپ ﷺ کی زندگی سے بے خبر ہونے کے باوجود

192
00:15:52,420 --> 00:15:56,751
وہ ہمارے لیے نوعَ انسان میں موجود اب تک کی سب سے محبوب شخصیت ہیں

193
00:15:56,771 --> 00:16:00,451
ان کا نام دنیا میں سب سے زیادہ رکھا جاتا ہے،

194
00:16:00,471 --> 00:16:03,874
دنیا میں کتنے ہی لوگ ہیں جن کا نام محمد رکھا گیا۔

195
00:16:03,898 --> 00:16:13,550
تاریخ میں محمدﷺ کے جیسا کوئی دوسرا شخص نہیں ہے جس کے نام پر اتنے لوگوں نے نام رکھے

196
00:16:13,574 --> 00:16:20,357
جب میں امریکہ کے کالج میں تھا تو ہمارے ایک امام تھے، ان کا تعلق نائیجیریا سے تھا۔

197
00:16:20,381 --> 00:16:25,562
وہ حافظِ قرآن تھے اور امریکہ کے چھوٹے سے کالج ٹاؤن میں ہمارے امام تھے۔

198
00:16:25,586 --> 00:16:27,898
اور ان کا نام محمد العاشر تھا۔

199
00:16:27,922 --> 00:16:31,134
لفظ "عاشر" کا معنی ہے "دسواں"

200
00:16:31,158 --> 00:16:37,240
چنانچہ میں ایک لمبےعرصے تک یہی سمجھتا رہا کہ "العاشر "ان کا خاندانی نام ہے۔

201
00:16:37,264 --> 00:16:39,343
محمد العاشر

202
00:16:39,367 --> 00:16:42,145
ایک دن میں اس کے پاس گیا اور پوچھا؛

203
00:16:42,169 --> 00:16:42,970
العاشر کیا ہے؟

204
00:16:43,004 --> 00:16:45,382
یعنی کیا یہ کسی قبیلے یا خاندان کا نام ہے؟

205
00:16:45,406 --> 00:16:46,950
انہوں نے کہا: نہیں

206
00:16:46,974 --> 00:16:53,023
انہوں نے بتایا: میرے والد اپنے ہر بیٹے کا نام محمدﷺ رکھتے تھے۔

207
00:16:53,047 --> 00:16:56,293
اپنے تمام بچوں کا نام انہوں نے محمد رکھا۔

208
00:16:56,317 --> 00:16:59,296
تو ہمارے درمیان فرق کرنے کے لیے، انہوں نے ہمیں شمارے دے دیے

209
00:16:59,320 --> 00:17:05,102
لہذا پہلے کا نام محمد اول تھا پھر محمد دوم، محمد سوم اسی طرح میں دسواں محمد ہوں

210
00:17:05,126 --> 00:17:10,974
میرا مطلب ہے کہ ان کے والد کوئی دوسرا نام نہیں رکھنا چاہتے تھے، ان کے سارے بچے محمد ہی ہیں۔

211
00:17:10,998 --> 00:17:19,540
اور اسی طرح پاکستان اور ہندوستان میں محمد ہارون، محمد سلیمان، محمد آدم، سب محمد ہیں۔

212
00:17:19,573 --> 00:17:23,711
تاریخ میں ایسی کوئی ہستی نہیں جس سے اس کی قوم نے اتنی محبت کی ہو جتنی محمد ﷺ سے ان کی امت کرتی ہے۔

213
00:17:23,744 --> 00:17:27,758
وہ تاریخ کی سب سے محبوب شخصیت ہیں۔

214
00:17:27,782 --> 00:17:31,161
اب اگر ہم ان کی زندگی کا مطالعہ کریں تو پھر کیا صورت حال ہوگی؟

215
00:17:31,185 --> 00:17:35,599
یعنی پھر ہم محمد ﷺ سے کتنی محبت کریں گے

216
00:17:35,623 --> 00:17:40,237
ان کا نام سب سے زیادہ ذکر کیا جانے والا نام ہے۔

217
00:17:40,261 --> 00:17:51,592
ہر وقت، کوئی نہ کوئی مؤذن، یا کسی مینار سے نماز کے لیے پکارا جا رہا ہوتا ہے اور وہ محمدﷺ کا نام لیا جا رہا ہوتا ہے ۔

218
00:17:51,639 --> 00:17:53,483
چوبیس گھنٹے

219
00:17:53,507 --> 00:17:55,485
کیونکہ مسلمان اب پوری دنیا میں ہیں

220
00:17:55,509 --> 00:17:59,313
لہذا ہر منطقہِ وقت میں مسلمان موجود ہیں۔

221
00:17:59,346 --> 00:18:03,751
تو دن کے ہر منٹ میں کوئی نہ کوئی موذن پکار لگائے گا

222
00:18:03,784 --> 00:18:07,998
اَشْهَدُ اَنْ لَّا اِلَه اِلَّا اللہ، وَ اَشْهَدُ اَنَّ محمد الرَسُوْلَ اللهَ

223
00:18:08,022 --> 00:18:09,733
چوبیس گھنٹے ان کا نام لیا جاتا ہے

224
00:18:09,757 --> 00:18:13,770
اور ویسے، "محمد "نام کا مطلب ہے "جس کی تعریف کی گئی ہو"۔

225
00:18:13,794 --> 00:18:17,231
اور ایسا کوئی نہیں جس کی محمدﷺ کے جتنی تعریف کی گئی ہو۔

226
00:18:17,264 --> 00:18:23,146
یعنی ان کے نام کا معنی واقعی پورا ہوا۔

227
00:18:23,170 --> 00:18:25,715
وہ ایسی شخصیت ہیں جن کی بے انتہا تعریف کی گئی

228
00:18:25,739 --> 00:18:29,219
ہمیشہ ان کی تعریف کی جاتی ہے، پس ہم جب بھی ان کا نام سنتے ہیں تو ہم کیا کہتے ہیں؟

229
00:18:29,243 --> 00:18:33,356
صلی اللہ علیہ وسلم

230
00:18:33,380 --> 00:18:37,994
پس ہم محمدﷺ سے محبت پیدا کرنا چاہتے ہیں اور ہم ایسا کس طرح سے کر سکتے ہیں؟

231
00:18:38,018 --> 00:18:40,430
آپﷺ کی زندگی کا مطالعہ کر کے

232
00:18:40,454 --> 00:18:44,568
جتنا ہم ان کے بارے میں جانیں گے اتنی ہی زیادہ ہم ان سے محبت کریں گے

233
00:18:44,592 --> 00:18:46,336
اللہ سبحانہ وتعالی فرماتے ہیں

234
00:18:46,360 --> 00:18:58,982
قُلْ إِنْ كَانَ آبَاؤُكُمْ وَأَبْنَاؤُكُمْ وَإِخْوَانُكُمْ وَأَزْوَاجُكُمْ وَعَشِيرَتُكُمْ وَأَمْوَالٌ

235
00:18:59,006 --> 00:19:07,624
وَأَمْوَالٌ اقْتَرَفْتُمُوهَا وَتِجَارَةٌ تَخْشَوْنَ كَسَادَهَا وَمَسَاكِنُ

236
00:19:07,648 --> 00:19:15,198
وَمَسَاكِنُ تَرْضَوْنَهَا أَحَبَّ إِلَيْكُمْ مِنَ اللَّهِ

237
00:19:15,222 --> 00:19:23,006
أَحَبَّ إِلَيْكُمْ مِنَ اللَّهِ وَرَسُولِهِ وَجِهَادٍ فِي سَبِيلِهِ

238
00:19:23,030 --> 00:19:32,682
فَتَرَبَّصُوا حَتَّىٰ يَأْتِيَ اللَّهُ بِأَمْرِهِ ۗ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْفَاسِقِينَ۞

239
00:19:32,706 --> 00:19:40,824
اے نبی آپ کہہ دیجیے کہ اگر تمہارے باپ، تمہارے بیٹے، تمہارے بھائی، تمہاری بیویاں، تمہارا خاندان

240
00:19:40,848 --> 00:19:42,859
اور وہ مال و دولت جو تم نے کمایا ہے

241
00:19:42,883 --> 00:19:48,031
اوروہ کاروبار جسکے نقصان کا تمہیں ڈر ہے، اور وہ مکانات جو تمہیں پسند ہیں

242
00:19:48,055 --> 00:19:53,270
اگر یہ تمہیں اللہ یا اس کے رسولﷺ سے یا اس کی راہ میں جہاد کرنے سے زیادہ محبوب ہیں

243
00:19:53,294 --> 00:19:56,806
پھر انتظار کرو یہاں تک کہ اللہ اپنا فیصلہ سنا دے۔

244
00:19:56,830 --> 00:19:59,843
اور اللہ سرکشوں کو ہدایت نہیں دیتا۔

245
00:19:59,867 --> 00:20:09,960
چنانچہ اس آیت میں بتایا گیا ہے کہ اللہ، اس کے رسولﷺ اور اس کی راہ میں جہاد کرنا ہمیں ہر چیز سے زیادہ محبوب ہونا چاہئے

246
00:20:10,010 --> 00:20:16,426
چاہے وہ ہمارے باپ، ہمارے بیٹے، ہمارے بھائی، ہماری بیویاں، ہمارے رشتہ دار، ہماری دولت، ہر چیز کیوں نہ ہو

247
00:20:16,450 --> 00:20:24,434
اللہ، اس کا رسولﷺ اور اسلام، ہم میں سے ہر ایک کے لیے سب سے زیادہ عزیز ہونا چاہیے۔

248
00:20:24,458 --> 00:20:27,771
نمبر تین، ہم سیرت کا مطالعہ کیوں کرتے ہیں؟

249
00:20:27,795 --> 00:20:30,974
محمد ﷺ کے طریقے پر چلنے کی خاطر

250
00:20:30,998 --> 00:20:33,210
ابن حزمؒ فرماتے ہیں؛

251
00:20:33,234 --> 00:20:36,646
جو شخص آخرت کی برتری چاہتا ہے،

252
00:20:36,670 --> 00:20:42,619
اِس زندگی کی حکمت، منصفانہ مقصد اور اخلاق و کردار کا مجسم بننا چاہتا ہے

253
00:20:42,643 --> 00:20:45,913
وہ اللہ کے نبی محمدﷺ کی پیروی کرے۔

254
00:20:45,946 --> 00:20:49,626
پس محمدﷺ اخلاق کا مجسمہ ہیں۔

255
00:20:49,650 --> 00:20:52,395
کامل کردار

256
00:20:52,419 --> 00:21:00,020
اور آپﷺ کی سیرت کا مطالعہ کرنے سے ہم آپﷺ کی سنت پر چلنے کے قابل ہو جائیں گے۔

257
00:21:00,060 --> 00:21:04,990
نمبر چار، فہم القرآن

258
00:21:05,032 --> 00:21:13,250
قرآن میں کچھ آیات ایسی ہیں جو حالاتِ نزول سے الگ ہیں

259
00:21:13,274 --> 00:21:23,277
مثال کے طور پر، الآخرة کے متعلق آیات اور الرقائق، یہ آیات حالات و واقعات سے جداگانہ ہیں۔

260
00:21:23,317 --> 00:21:28,965
لیکن پھر کچھ ایسی آیات ہیں جو محمدﷺ کے زمانے میں رونما ہونے والے واقعات سے متعلق ہیں۔

261
00:21:28,989 --> 00:21:33,270
اور کچھ ایسی آیات بھی ہیں جو کسی واقعے سے قبل نازل ہوئیں

262
00:21:33,294 --> 00:21:36,273
کچھ آیات کسی واقعے کے وقت نازل ہوئیں

263
00:21:36,297 --> 00:21:42,369
اور بعض آیات کسی واقعے کے بعد نازل ہوئیں،

264
00:21:42,436 --> 00:21:49,466
سیرت ہمیں ان تمام آیات کی وضاحت فراہم کرتی ہے۔

265
00:21:49,510 --> 00:21:52,269
مثلاً سورۃ الاحزاب

266
00:21:52,313 --> 00:21:58,895
سورۃ احزاب کی بیشتر آیات جنگِ احزاب کے متعلق نازل ہوئیں

267
00:21:58,919 --> 00:22:05,435
سورۃ ال عمران کی بہت سی آیات رسول اللہﷺ کے زمانے میں پیش آنے والے واقعات سے متعلق ہیں۔

268
00:22:05,459 --> 00:22:13,443
لہذا، سورۃ العمران کا ایک بڑا حصہ مسلمانوں اور عیسائیوں کے درمیان مکالمے پر مبنی ہیں

269
00:22:13,467 --> 00:22:18,648
کیونکہ اس وقت نجران سے ایک عیسائی وفد رسول اللہﷺ کی زیارت کے لیے آیا تھا۔

270
00:22:18,672 --> 00:22:26,289
یہ آیات رسول اللہﷺ کی عیسائیوں کے ساتھ گفتگو میں تائید کرنے کے لیے نازل ہوئیں

271
00:22:26,313 --> 00:22:33,663
اور پھر آخری حصہ بھی ہے، آلعمران کا آخری حصہ غزوہِ احد سے متعلق ہے۔

272
00:22:33,687 --> 00:22:38,301
غزوہ کی تفصیل سورۃ میں مذکور نہیں ہے، تو آپ ان آیات کو کیسے سمجھیں گے؟

273
00:22:38,325 --> 00:22:42,085
سیرت سے رجوع کر کے

274
00:22:42,129 --> 00:22:43,506
نمبر پانچ

275
00:22:43,530 --> 00:22:51,948
آپﷺ کی زندگی اسلامی تحریک کے منہج کی عکاسی کرتی ہے۔

276
00:22:51,972 --> 00:22:55,151
رسول اللہﷺ کئی مراحل سے گزرے،

277
00:22:55,175 --> 00:22:56,986
آپﷺ مختلف درجوں سے گزرے،

278
00:22:57,010 --> 00:23:00,990
خفیہ تبلیغ سے شروع ہوئے

279
00:23:01,014 --> 00:23:04,194
پھر علی الاعلان دعوت دی

280
00:23:04,218 --> 00:23:07,931
اور اس کے بعد جہاد۔

281
00:23:07,955 --> 00:23:10,166
یہ سب درجہ بدرجہ ہوا۔

282
00:23:10,190 --> 00:23:16,172
یہ تمام مراحل اسلامی تحریکوں کے سیکھنے اور مطالعہ کرنے کے لیے اہم ہیں

283
00:23:16,196 --> 00:23:18,508
منیر غردانؒ فرماتے ہیں؛

284
00:23:18,532 --> 00:23:27,350
اور ہم سمجھتے ہیں کہ نبیﷺ کی زندگی کا یہ مربوط ارتقا اللہ کے حکم سے ہے،

285
00:23:27,374 --> 00:23:30,620
کیونکہ اللہ تعالیٰ نے اپنے نبیﷺ کی ہر قدم پر رہنمائی فرمائی ہے۔

286
00:23:30,644 --> 00:23:36,326
اور یہ محض وقوع پذزیر ہونے والے حالات کے ردعمل کا نتیجہ نہیں تھے۔

287
00:23:36,350 --> 00:23:40,663
لہٰذا یہ واقعات جو رسول اللہﷺ کی زندگی میں پیش آئے کوئی اتفاق نہیں تھے۔

288
00:23:40,687 --> 00:23:44,234
ان کی منصوبہ بندی اللہ سبحانہ وتعالیٰ نے کی تھی،

289
00:23:44,258 --> 00:23:51,641
تاکہ وہ اسلام کو دوبارہ قائم کرنے کی کوششوں میں ہماری رہنمائی کر سکیں۔

290
00:23:51,665 --> 00:23:55,936
لہٰذا یہ بہت ضروری ہے کہ ہم ان مراحل جن سے رسول اللہﷺ گزرے تھے

291
00:23:56,036 --> 00:23:59,516
اور انﷺ کی دعوت کے ارتقا کو سمجھیں۔

292
00:23:59,540 --> 00:24:01,542
رشید رضاؒ کہتے ہیں؛

293
00:24:01,608 --> 00:24:07,357
 اگر تعلیم و تربیت نہ ہوتی تو زبانی ہدایات کفایت نہ کرتیں

294
00:24:07,381 --> 00:24:11,161
اس لیے سیرت نے انہیں سکھایا کہ قرآن سے رہنمائی کیسے حاصل کی جائے

295
00:24:11,185 --> 00:24:14,931
اور انہیں تمام معاملات میں عدل اور اعتدال کی تربیت دی،

296
00:24:14,955 --> 00:24:19,536
لہذا، قرآن اور سنت ہماری زبانی تعلیمات ہیں۔

297
00:24:19,560 --> 00:24:23,907
لیکن ہم ان زبانی تعلیمات کا اطلاق کیسے کریں؟

298
00:24:23,931 --> 00:24:29,245
 رسول اللہ ﷺ اور صحابہ کرامؓ کی زندگیوں پر ان کا اطلاق دیکھ کر

299
00:24:29,269 --> 00:24:33,016
لہٰذا، انہوں نے اس زبانی تعلیم کو عملی جامہ پہنایا

300
00:24:33,040 --> 00:24:36,653
اور یہ وہ چیز ہے جو صرف مسلمانوں کے پاس ہے۔

301
00:24:36,677 --> 00:24:42,592
یعنی باقی تمام انبیاءؑ کے پیروکاروں نے اپنے نبیوں کی سیرت کے سراغ کھو دیے ہیں۔

302
00:24:42,616 --> 00:24:45,762
لیکن ہم جانتے ہیں کہ قرآن پر کس طرح عمل کیا گیا تھا،

303
00:24:45,786 --> 00:24:49,790
ہم جانتے ہیں کہ رسول اللہ ﷺ کی سنت پر کس طرح عمل کیا گیا۔

304
00:24:49,823 --> 00:24:51,701
قرآن میں ایک آیت ہے،

305
00:24:51,725 --> 00:24:56,473
جس میں بیان کیا گیا ہے کہ رمضان کی راتوں میں کھانا پینا جاری رکھ سکتے ہیں

306
00:24:56,497 --> 00:25:03,012
یہاں تک کہ سفید دھاری سیاہ دھاری سے جدا نہ ہو جائے۔

307
00:25:03,036 --> 00:25:05,915
ایک صحابی نے اسے لفظی طور پر لیا،

308
00:25:05,939 --> 00:25:10,320
انہوں نے یہ کیا کہ اپنے تکیے کے نیچے دھاگا رکھا،

309
00:25:10,344 --> 00:25:16,392
وہ کھاتے اور پھر دھاگا اٹھا کر دیکھتے

310
00:25:16,416 --> 00:25:19,162
جب وہ تکیہ اٹھاتے تو انہیں دھاگا دکھائی نہ دیتا

311
00:25:19,186 --> 00:25:21,364
تو وہ کھانا جاری رکھتے

312
00:25:21,388 --> 00:25:26,836
اور وہ اسی طرح کرتے رہے پھر وہ رسول اللہ ﷺکی خدمت میں حاضر ہویے اور انہیں بتایا کہ میں نے یہ کیا۔

313
00:25:26,860 --> 00:25:28,805
رسول اللہ ﷺ مسکرائے اور فرمایا؛

314
00:25:28,829 --> 00:25:33,300
اس کا یہ مطلب نہیں ہے کہ آپ اپنے کمرے میں ایک دھاگا رکھیں اور اسے دیکھیں

315
00:25:33,367 --> 00:25:38,882
اس سے مراد وہ سفید دھاری ہے جو افق میں روشنی کی پہلی کرن سے بنتی ہے،

316
00:25:38,906 --> 00:25:40,683
اس کا یہی مطلب ہے۔

317
00:25:40,707 --> 00:25:45,321
تو رسول اللہﷺ نے صحابیؓ کو اس آیت پر عمل کرنا سکھایا۔

318
00:25:45,345 --> 00:25:48,091
یعنی اگر میں بنا کھڑکی والے تاریک کمرے میں ہوں،

319
00:25:48,115 --> 00:25:48,348
صحیح

320
00:25:48,415 --> 00:25:53,930
اور میرے پاس ایک دھاگا ہو اور دوپہر کا وقت ہو، لیکن میں اسے پھر بھی نہیں دیکھ سکتا تو میں تو کھانا جاری رکھوں گا۔

321
00:25:53,954 --> 00:26:08,523
چنانچہ آیات اور احادیث کا اطلاق ہمیں محمدﷺ کی سیرت سے معلوم ہوگا، اور صحابہؒ کی زندگیوں سے بھی، اللہ کی رحمت اور رضا ان کے ہمراہ ہو۔،

322
00:26:08,569 --> 00:26:10,413
نمبر چھ

323
00:26:10,437 --> 00:26:13,518
سیرت کا مطالعہ کرنا عبادت ہے،

324
00:26:13,543 --> 00:26:18,208
ہم یہ مطالعہ دل بہلانے کے لیے نہیں کر رہے۔

325
00:26:18,245 --> 00:26:22,892
یہ عبادت ہے، اس میں ثواب ہے اور اس کو پڑھنے سے اجر نصیب ہوگا۔

326
00:26:22,916 --> 00:26:29,644
ہم اکٹھے ہو کر اور محمدﷺ کی زندگی کا مطالعہ کر کے اللہ کی عبادت کر رہے ہیں۔

327
00:26:29,690 --> 00:26:32,068
یہ ذکر کی مجلس ہے،

328
00:26:32,092 --> 00:26:36,306
یہ ذکر کی محفل ہے۔ جب ہم جمع ہو کر محمدﷺ کے بارے میں گفتگو کرتے ہیں،

329
00:26:36,330 --> 00:26:39,042
تو ہم اللہ کی عبادت کر رہے ہوتے ہیں۔

330
00:26:39,066 --> 00:26:43,346
اور ہم یہ امید کرتے ہیں کہ یہ ایک ایسی مجلس ہے جس کے گرد فرشتے جمع ہیں،

331
00:26:43,370 --> 00:26:51,879
جس پر اللہ سبحانہ وتعالیٰ اپنی رحمت اور سکینت نازل فرمائیں گے، اور اس سے بہتر محفل میں ہمارا ذکر کیا جائے گا۔

332
00:26:51,912 --> 00:26:54,324
پس یہ عبادت ہے اور اللہ سبحانہ وتعالیٰ کا ارشاد ہے؛

333
00:26:54,348 --> 00:27:04,601
قُلْ إِنْ كُنْتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ

334
00:27:04,625 --> 00:27:08,938
وَاللَّهُ غَفُورٌ رَحِيمٌ۞

335
00:27:08,962 --> 00:27:10,707
اللہ سبحانہ وتعالی فرماتے ہیں؛

336
00:27:10,731 --> 00:27:13,610
اگر تم اللہ سے محبت کرتے ہو تو میری پیروی کرو

337
00:27:13,634 --> 00:27:15,511
یعنی محمدﷺ کی پیروی کرو

338
00:27:15,535 --> 00:27:18,414
اللہ تم سے محبت کرے گا اور تمہارے گناہوں کو بخش دے گا

339
00:27:18,438 --> 00:27:22,919
کیونکہ اللہ بخشنے والا مہربان ہے۔

340
00:27:22,943 --> 00:27:24,020
نمبر سات

341
00:27:24,044 --> 00:27:27,390
مسلم تشخص کو بہتر بنانا

342
00:27:27,414 --> 00:27:30,026
بھائیو اور بہنو

343
00:27:30,050 --> 00:27:40,770
روئے زمین پر ایک عالمی ثقافت چھائی ہے جسے اختیار کرنے پر ہر شخص کو مجبور کیا جا رہا ہے،

344
00:27:40,794 --> 00:27:45,041
اس عالمی ثقافت کی حفاظت اور اس کو فروغ دیا جا رہا ہے۔

345
00:27:45,065 --> 00:27:50,680
تھامس فریڈمین، جو امریکہ میں ایک مشہور مصنف ہیں اور نیویارک ٹائمز کے لیے لکھتے ہیں۔

346
00:27:50,704 --> 00:27:59,522
ان کا کہنا ہے کہ بازار کا پوشیدہ ہاتھ ایک پوشیدہ مُٹھی کے بغیر زندہ نہیں رہ سکتا

347
00:27:59,546 --> 00:28:05,194
میک ڈونلڈز کبھی بھی میکڈونل ڈگلس کے بغیر ترقی نہیں کر پائے گا،

348
00:28:05,218 --> 00:28:07,997
جو کہ ایف۔15 طیاروں کا ڈیزائنر ہے

349
00:28:08,021 --> 00:28:09,532
دوسرے الفاظ میں،

350
00:28:09,556 --> 00:28:14,637
ہمارا ایک ایسی عالمی ثقافت کے ساتھ واسطہ نہیں پڑا جو مہربان یا ہمدرد ہے

351
00:28:14,661 --> 00:28:18,141
یہ ایک ایسی ثقافت ہے جو آپ کے لیے کوئی چارہ نہیں چھوڑتی

352
00:28:18,165 --> 00:28:22,245
آپ یا تو میک ڈونلڈز کو قبول کریں

353
00:28:22,269 --> 00:28:27,884
ورنہ پھر میک ڈونیل ڈگلس آپ کے سر پر اپنے ایف-15 بھیج دے گا

354
00:28:27,908 --> 00:28:32,622
یہ ایسی ثقافت ہے جو کسی کو برداشت نہیں کرتی جو کسی اور چیز کے ساتھ نہیں رہ سکتی

355
00:28:32,646 --> 00:28:36,859
یہ زمین کے چہرے سے ہر دوسری ثقافت کو جڑ سے اکھاڑ پھینکے گا

356
00:28:36,883 --> 00:28:39,533
اس کا مقصد کسی بھی ثقافت کو نست و نابود کرنا ہے

357
00:28:39,566 --> 00:28:44,867
الیگزینڈر سولزینٹسن کا ایک اقتباس ہے

358
00:28:44,891 --> 00:28:48,838
وہ ایک مشہور روسی مورخ اور مصنف ہے، وہ کہتا ہے؛

359
00:28:48,862 --> 00:28:53,009
کسی قوم کو تباہ کرنا ہو تو سب سے پہلے اس کی جڑیں کاٹ دو

360
00:28:53,033 --> 00:28:56,345
تو یہ دراصل زمین والوں کی تباہی ہے،

361
00:28:56,369 --> 00:29:00,950
کیونکہ ہر دوسری ثقافت کی دھجیاں اڑائی جا رہی ہیں۔

362
00:29:00,974 --> 00:29:06,889
لہذا، یہ وہ عالمی ثقافت نہیں جو دوسروں کے ساتھ مل کر رہے، بلکہ یہ ان کی جگہ لے لے گی۔

363
00:29:06,913 --> 00:29:15,698
اور اسلام ہی وہ واحد نظریہ ہے جو اس عالمی ثقافت کے خلاف سینہ تان کر کھڑا ہے۔

364
00:29:15,722 --> 00:29:24,574
لیکن پھر بھی بحیثیت مسلمان اور خاص طور پر مغرب میں بسنے والے مسلمان، ہم ایک سنگین شناختی بحران کا شکار ہیں۔

365
00:29:24,598 --> 00:29:31,013
یعنی، اگرچہ کچھ بہن یا بھائی اسلام پر عمل پیرا ہیں

366
00:29:31,037 --> 00:29:36,352
لیکن وہ اسلامی شناخت بذاتِ خود کھو چکے ہیں

367
00:29:36,376 --> 00:29:40,623
 یعنی لوگ کسی گلوکار یا فٹ بال کھلاڑی کے ساتھ تو زیادہ مشابہت رکھنے کی کوشش کرتے ہیں

368
00:29:40,647 --> 00:29:43,893
لیکن رسول اللہﷺ کے صحابہؓ سے مشابہت نہیں رکھنا چاہتے۔

369
00:29:43,917 --> 00:29:50,090
آپ دیکھیں گے کہ نوجوان نسل صحابہ کرامؓ سے زیادہ پاپ سٹارز کے بارے میں جانتی ہے،

370
00:29:50,123 --> 00:29:53,536
درحقیقت بعض اوقات انبیاءؑ سے بھی زیادہ گلوکاروں کو جانتی ہے

371
00:29:53,560 --> 00:29:58,341
نوجوانوں میں سے کتنے ہیں جو تمام انبیاءؑ کے نام جانتے ہیں؟

372
00:29:58,365 --> 00:30:02,812
کتنے نوجوان صحابہ کرامؓ کے نام جانتے ہیں؟

373
00:30:02,836 --> 00:30:08,317
لیکن اسی شخص سے اس کی پسندیدہ فٹ بال ٹیم کے کھلاڑیوں کا نام پوچھیں

374
00:30:08,341 --> 00:30:13,189
یا ان کے پسندیدہ باسکٹ بال کھلاڑی کا پوچھیں، تو وہ ایک لمبی فہرست بتا سکتا ہے

375
00:30:13,213 --> 00:30:17,693
لہٰذا، مسلمانوں کی شناخت ایک سنگین بحران کا شکار ہے۔

376
00:30:17,717 --> 00:30:23,833
اور ہم کس طرح سے اس کا مقابلہ کر سکتے ہیں؟ کیسے ہم مسلم شناخت بنا سکتے ہیں؟

377
00:30:23,857 --> 00:30:25,434
نمبر ایک

378
00:30:25,458 --> 00:30:30,206
تاریخِ اسلامی کا گہرا مطالعہ کرکے

379
00:30:30,230 --> 00:30:38,500
جو اللہ کے انبیاءؑ کی سیرت، محمدﷺ کی حیاتِ طیبہ، صحابہ کرامؓ کی زندگیوں پر مشتمل ہے،

380
00:30:38,538 --> 00:30:41,350
اور پھر عمومی طور پراسلامی تاریخ کا مطالعہ کرکے۔

381
00:30:41,374 --> 00:30:42,785
تو یہ تھا پہلا نکتہ۔

382
00:30:42,809 --> 00:30:47,657
کہ آپ تاریخ سے لگاؤ رکھ کر آپنی شناخت بنائیں

383
00:30:47,681 --> 00:30:51,227
کیونکہ تاریخ ہمارے لیے ناگزیر ہے، یہی ہماری زندگی کی بنیاد ہے۔

384
00:30:51,251 --> 00:30:54,163
ہم اس امت کی توسیع ہیں،

385
00:30:54,187 --> 00:30:58,034
ہم نہ ایک دوسرے سے جدا ہیں، نہ ہی ہماری بنیادیں الگ ہیں

386
00:30:58,058 --> 00:31:02,038
ہم ایک عظیم امت کا حصہ ہیں جس کے بارے میں ہمیں مطالعہ کرنے کی ضرورت ہے۔

387
00:31:02,062 --> 00:31:03,472
نمبر دو

388
00:31:03,496 --> 00:31:08,411
دنیا بھر میں امت مسلمہ کا حصہ بن کر۔

389
00:31:08,435 --> 00:31:12,949
ہماری مقامی شناخت کو ہماری مسلم شناخت پر حاوی نہیں ہونا چاہیے۔

390
00:31:12,973 --> 00:31:25,733
تو، میری برطانوی شناخت،  یا امریکی، یا پاکستانی، یا کویتی یا کسی دوسرے ملک کی شناخت میری اسلامی شناخت پر حاوی نہ ہونے پائے

391
00:31:25,785 --> 00:31:29,999
دیکھیں! یہ قومیت وہ تصورہے جسے اسلام ختم کرنے کے لیے آیا ہے،

392
00:31:30,023 --> 00:31:34,537
 ہماری وفاداری اللہ سبحانہ تعالی اور اپنے دین کے ساتھ ہے

393
00:31:34,561 --> 00:31:37,540
اور ہم ایک عالمی امت کا حصہ ہیں۔

394
00:31:37,564 --> 00:31:42,445
اس لیے ہمیں پوری دنیا میں اپنے مسلمان بھائیوں کے بارے میں جاننے کی ضرورت ہے۔

395
00:31:42,469 --> 00:31:46,782
فلسطین میں جو کچھ ہوتا ہے اس کی تشویش ہر برطانوی مسلمان کو ہونی چاہیے

396
00:31:46,806 --> 00:31:50,987
کشمیر میں جو کچھ ہو رہا ہے اس کی فکر ہر امریکی مسلمان کو ہونی چاہیے۔

397
00:31:51,011 --> 00:31:53,956
مسلم دنیا کے کونے کونے میں جو ہو رہا ہے

398
00:31:53,980 --> 00:31:58,494
مجھے اس کے بارے میں اسی طرح فکر مند ہونا چاہئے جیسے یہ میرے اپنے گھر میں ہو رہا ہے۔

399
00:31:58,518 --> 00:32:02,365
لہذا، شناخت کی تعمیر میں یہ دو اہم عناصر ہیں۔

400
00:32:02,389 --> 00:32:06,435
نمبر ایک، اپنی تاریخ کا گہرا ادراک رکھنا۔

401
00:32:06,459 --> 00:32:08,037
اور نمبر دو

402
00:32:08,061 --> 00:32:11,407
امت کا حصہ ہونا اور امت کی فکر رکھنا۔

403
00:32:11,431 --> 00:32:20,140
 اور ایک بار پھر، الیگزینڈر سولزینٹسن کا یہ قول دہراتا ہوں کہ "کسی قوم کو تباہ کرنے کے لیے پہلے ان کی جڑوں کو کاٹنا ہو گا"،

404
00:32:20,273 --> 00:32:23,786
ہم نہیں چاہتے کہ ہماری جڑیں کٹ جائیں

405
00:32:23,810 --> 00:32:26,455
ہم چاہتے ہیں کہ ہماری جڑیں مزید گہری ہوں۔

406
00:32:26,479 --> 00:32:34,530
رسول اللہﷺ کی زندگی کا مطالعہ ہماری تاریخ کا سب سے اہم جز ہے۔

407
00:32:34,554 --> 00:32:36,332
نمبر آٹھ

408
00:32:36,356 --> 00:32:42,638
محمد ﷺ کی زندگی ان کی نبوت کی گواہی ہے۔

409
00:32:42,662 --> 00:32:46,642
محمد ﷺ کا سب سے بڑا معجزہ قرآن ہے۔

410
00:32:46,666 --> 00:32:51,480
اس کے علاوہ رسول اللہ ﷺ کے اور بھی بہت سے معجزات ہیں۔

411
00:32:51,504 --> 00:32:56,476
لیکن اگر ہم صرف ان کی زندگی کا مطالعہ کریں

412
00:32:56,543 --> 00:33:01,090
تو اس میں ہی ان کی نبوت کے ثبوت موجود ہیں۔

413
00:33:01,114 --> 00:33:09,865
یعنی، ایک آدمی، جو چالیس سال سے عام زندگی گزار رہا تھا۔

414
00:33:09,889 --> 00:33:18,407
محمد ﷺ کی زندگی کے پہلے چالیس سالوں میں سب سے نمایاں چیز ان کا اخلاق و کردار تھا۔

415
00:33:18,431 --> 00:33:26,082
لیکن رسول اللہﷺ نے کبھی اقتدار کی خواہش نہیں کی،

416
00:33:26,106 --> 00:33:29,785
 یا اثر و رسوخ کی یا ایسی کسی بھی چیز کی۔

417
00:33:29,809 --> 00:33:33,422
یعنی رسول اللہ ﷺ معمول کی زندگی گزار رہے تھے۔

418
00:33:33,446 --> 00:33:36,826
اور پھر اچانک، چالیس سال کی عمر کے بعد

419
00:33:36,850 --> 00:33:41,931
رسول اللہ ﷺ وہ عظیم تبدیلی لائے جو دنیا نے کبھی نہیں دیکھی تھی

420
00:33:41,955 --> 00:33:45,267
یہ ایک حیرت انگیز بات ہے، یہ ایک معجزہ ہے۔

421
00:33:45,291 --> 00:33:50,072
رسول اللہﷺ اُمّی تھے، یعنی پڑھ لکھ نہیں سکتے تھے۔

422
00:33:50,096 --> 00:33:57,947
اور پھر انہوں نےدنیا کےسامنے عظیم ترین کتاب پیش کی جس کی مثل آج تک نہیں۔

423
00:33:57,971 --> 00:34:03,853
اور ہم ان چیزوں کی طویل فہرست بنا سکتے ہیں جن کی وضاحت صرف اسی صورت دی جاسکتی ہے کہ

424
00:34:03,877 --> 00:34:08,824
محمدﷺ اللہ کے رسول ہیں جن کے ساتھ غیبی مدد ہے۔

425
00:34:08,848 --> 00:34:10,426
 دوسری صورت میں، یہ ناممکن ہے۔

426
00:34:10,450 --> 00:34:16,632
آپﷺ کی سیرۃ کی وضاحت کرنے کا کوئی طریقہ نہیں ہے، سوائے اس اعتراف کے کہ وہ اللہ کے نبی تھے۔

427
00:34:16,656 --> 00:34:21,170
محمدﷺ نے جو کچھ حاصل کیا اسے حاصل کرنا انسان کے لیے ناممکن ہے،

428
00:34:21,194 --> 00:34:26,842
 وحی اور اللہ سبحانہ تعالی کی مدد کے بغیر۔

429
00:34:26,866 --> 00:34:33,482
پس یہ ان کے نبی ہونے کی گواہی ہے، یہ دلائل النبوۃ میں سے ہیں۔

430
00:34:33,506 --> 00:34:39,088
محمدﷺ نے پہلے چالیس سال عام زندگی گزاری۔

431
00:34:39,112 --> 00:34:42,925
پھر اچانک وہ سیاسی رہنما بن گئے،

432
00:34:42,949 --> 00:34:45,428
عسکری رہنما،

433
00:34:45,452 --> 00:34:47,196
مذہبی رہنما،

434
00:34:47,220 --> 00:34:50,132
ایک بڑے گھرانے کے سربراہ،

435
00:34:50,156 --> 00:34:54,303
قانون ساز، استاد، امام

436
00:34:54,327 --> 00:34:59,675
اور رسول اللہ ﷺکی ذمہ داریوں کی فہرست بہت طویل ہے

437
00:34:59,699 --> 00:35:02,912
یہ سب کچھ تئیس سال کے مختصر عرصے میں کیا۔

438
00:35:02,936 --> 00:35:06,449
ناممکن

439
00:35:06,473 --> 00:35:11,921
یہ بات ہمیں اگلے نکتے کی طرف لے جاتی ہے کہ ہم عظیم ترین انسان کی زندگی کا مطالعہ کر رہے ہیں۔

440
00:35:11,945 --> 00:35:18,661
ہم اس زمین پر قدم رکھنے والے عظیم ترین انسان کی زندگی کا مطالعہ کر رہے ہیں۔

441
00:35:18,685 --> 00:35:21,564
محمد ﷺ سب سے عظیم ہیں۔

442
00:35:21,588 --> 00:35:27,937
اور آپ عظمت کا جو بھی معیار استعمال کرنا چاہتے ہیں کریں، وہ ہرصورت میں عظیم ترین ہی رہیں گے۔

443
00:35:27,961 --> 00:35:30,706
مائیکل ہارٹ، ایک امریکی مصنف ہے

444
00:35:30,730 --> 00:35:37,913
اس نے تاریخ میں موجود اب تک کے سب سے زیادہ بااثر افراد پر ایک کتاب لکھی ہے جس کا نام ہے؛ دی ہنڈریڈ

445
00:35:37,937 --> 00:35:40,850
مجھے یقین ہے کہ آپ میں سے بہت سے لوگ اس کتاب سے واقف ہیں۔

446
00:35:40,874 --> 00:35:45,721
تاریخ میں رہنماؤں کی زندگیوں کا مطالعہ کرنے کے بعد

447
00:35:45,745 --> 00:35:56,198
اس پر واضح ہو گیا کہ اب تک کے تمام انسانوں میں محمدﷺ بغیر کسی اختلاف کے سب سے عظیم ترین انسان ہیں۔

448
00:35:56,222 --> 00:36:02,905
وہ سب سے بہترین ہیں، اور کتاب کے تعارف میں اسے چار و ناچار لکھنا پڑا

449
00:36:02,929 --> 00:36:09,311
کیوںکہ وہ زیادہ تر غیر مسلموں کے لیے لکھتا ہے تو قارئین سوچیں گے

450
00:36:09,335 --> 00:36:14,083
اور اس کے محمدﷺکے انتخاب پر سوال اٹھائیں گے۔

451
00:36:14,107 --> 00:36:17,119
چنانچہ وہ کتاب کےتعارف میں لکھتا ہے؛

452
00:36:17,143 --> 00:36:23,025
 دنیا کے سب سے زیادہ بااثر افراد کی فہرست میں میرا سرفہرست محمدﷺ کو منتخب کرنا

453
00:36:23,049 --> 00:36:27,863
بعض قارئین کو حیران کر سکتا ہے، اور کچھ سوال بھی اٹھائیں گے۔

454
00:36:27,887 --> 00:36:30,666
لیکن وہ تاریخ کے واحد شخص تھے

455
00:36:30,690 --> 00:36:35,771
جو مذہبی اور دنیاوی دونوں سطحوں پر انتہائی کامیاب رہے۔

456
00:36:35,795 --> 00:36:42,845
اور پھر وہ مزید کہتا ہے: یہ دنیاوی اور مذہبی اثر و رسوخ کا بے مثال امتزاج ہے

457
00:36:42,869 --> 00:36:49,051
جس کی وجہ سے میں محسوس کرتا ہوں کہ محمدﷺ انسانی تاریخ کی سب سے زیادہ بااثر شخصیت ہیں۔

458
00:36:49,075 --> 00:36:53,756
پس، مائیکل ہارٹ حقائق کو تسلیم کرنے پر مجبور ہے۔

459
00:36:53,780 --> 00:36:58,360
یعنی اس میں کوئی شک نہیں کہ محمدﷺ سب سے عظیم ہیں۔

460
00:36:58,384 --> 00:37:02,198
پھر اسے اپنے قارئین سے معذرت کرنی پڑی، یعنی اسے کہنا پڑا کہ یہ میرے بس سے باہر ہے۔

461
00:37:02,222 --> 00:37:06,435
یعنی کسی بھی طرح میں کسی اور کو ان کے آگے نہیں رکھ سکتا۔

462
00:37:06,459 --> 00:37:08,304
میرا مطلب ہے کہ محمد ﷺ سب سے بہترین ہیں۔

463
00:37:08,328 --> 00:37:16,912
درحقیقت اگر ہم محمدﷺ کو عسکری رہنما کے طور پر لیں

464
00:37:16,936 --> 00:37:23,452
تو ان کی شخصیت کا صرف یہی پہلو ہی سب سے عظیم ترین ہوگا۔

465
00:37:23,476 --> 00:37:30,226
اگر ہم محمدﷺ کی زندگی کا صرف مذہبی پہلو لیں تو بھی وہ سب سے عظیم ہوں گے،

466
00:37:30,250 --> 00:37:35,264
 محمدﷺ ایک سیاسی رہنما کے طور پر بھی سب سے عظیم ترین ثابت ہوں گے۔

467
00:37:35,288 --> 00:37:40,736
لہٰذا، اگر آپ محمدﷺ کی زندگی کے مختلف پہلوؤں کو جدا کریں

468
00:37:40,760 --> 00:37:45,074
اور ان کا ایک ایک حصہ دیکھیں، ایک وقت میں ایک حصہ

469
00:37:45,098 --> 00:37:48,477
تب بھی وہ آج تک پیدا ہونے والے ہر شخص سے بہتریں ہوں گے۔

470
00:37:48,501 --> 00:37:53,148
پس ہم المصطفى کی زندگی کا مطالعہ کر رہے ہیں

471
00:37:53,172 --> 00:37:56,118
المصطفى کا مطلب ہے وہ جسے منتخب کیا گیا۔

472
00:37:56,142 --> 00:37:57,686
اللہ سبحانہ وتعالی نےمنتخب کیا

473
00:37:57,710 --> 00:37:59,221
اَلْمُصْطَفَى مِنْ خَلْقِ

474
00:37:59,245 --> 00:38:04,260
وہ اللہ کی تمام مخلوقات میں سے چنے گئے۔

475
00:38:04,284 --> 00:38:09,832
اورمزید وجوہات بھی ہوسکتی ہیں جن کی وجہ سے سیرت کا مطالعہ ضروری ہے۔

476
00:38:09,856 --> 00:38:14,036
ہم نے کون سے ذرائع استعمال کیے

477
00:38:14,060 --> 00:38:18,140
ہم اس نصاب کے لیے دو بنیادی ذرائع استعمال کریں گے

478
00:38:18,164 --> 00:38:20,009
نمبر ایک

479
00:38:20,033 --> 00:38:24,346
ابن کثیرؒ کی سیرت

480
00:38:24,370 --> 00:38:30,786
ابن کثیرؒ نے سیرت نامی کوئی کتاب نہیں لکھی

481
00:38:30,810 --> 00:38:36,592
ابن کثیرؒ نے ایک تاریخی انسائیکلوپیڈیا لکھا جس کا نام البدایہ والنہایہ ہے،

482
00:38:36,616 --> 00:38:39,228
آغاز اور اختتام

483
00:38:39,252 --> 00:38:41,864
اور یہ واقعی آغاز اور اختتام ہے

484
00:38:41,888 --> 00:38:50,606
انہوں نے تخلیق سے ابتداء کی اور اس کے بعد کے تمام حالات بیان کیے یہاں تک کہ لوگوں کے جنت اور دوزخ میں داخل ہونے تک۔

485
00:38:50,630 --> 00:38:56,378
ان میں سے ایک جلد رسول اللہﷺ کی سیرت پر مشتمل ہے۔

486
00:38:56,402 --> 00:38:58,771
اور دوسری جلد انبیاء کے بارے میں ہے

487
00:38:58,838 --> 00:39:01,450
اور پھر خلافت راشدہ کے بارے میں ایک جلد ہے،

488
00:39:01,474 --> 00:39:03,819
خلافتِ امویہ، خلافتِ عباسيه

489
00:39:03,843 --> 00:39:05,587
انہوں نے اپنے وقت تک لکھا۔

490
00:39:05,611 --> 00:39:11,860
اور پھر آخری جلد الفتن، جو قیامت کی نشانیوں، قیامت کے دن،

491
00:39:11,884 --> 00:39:14,330
اور جنت و دوزخ کے بارے میں ہے۔

492
00:39:14,354 --> 00:39:21,470
لہذا، ہم ان کے سیرت والے حصے کو بنیادی ماخذ کے طور پر لیں گے

493
00:39:21,494 --> 00:39:27,776
اور میں اس پر تھوڑی سی بات کروں گا کہ میں نے ابن کثیرؒ کو اپنا بنیادی ماخذ کیوں چنا ہے۔

494
00:39:27,800 --> 00:39:34,750
دوسری کتاب جو میں نے ان تحاریر کی تالیف میں استعمال کی ہے

495
00:39:34,774 --> 00:39:39,988
وہ صحیح السیرۃ النبویہ از ابراہیم العلي ہے

496
00:39:40,012 --> 00:39:50,532
روایتی طور پر، سیرت کا علم حدیث سے الگ ہے

497
00:39:50,556 --> 00:39:59,842
اگرچہ کچھ ایسے مواقع ہیں جہاں وہ ایک دوسرے سے ملتے ہیں، جہاں وہ ایک ساتھ بغیر ٹکراؤ کے چلتے ہیں

498
00:39:59,866 --> 00:40:07,583
 لیکن روایتی طور پر، حدیث کے مقابلے میں سیرت کے قواعد مختلف ہیں۔

499
00:40:07,607 --> 00:40:15,891
علمائے حدیث نہایت محتاط تھے اور ان کے اصول بہت کڑے تھے،

500
00:40:15,915 --> 00:40:20,796
جبکہ علماء سیرت زیادہ نرم اور لچکدار تھے۔

501
00:40:20,820 --> 00:40:31,073
وجہ یہ ہے کہ جب وہ احادیث پر کام کرتے، اور احکام اخذ کرتے تھے

502
00:40:31,097 --> 00:40:36,912
وہ اس بات کو یقینی بنانا چاہتے تھے کہ وہ صحیح احادیث سے احکام اخذ کر رہے ہیں۔

503
00:40:36,936 --> 00:40:46,188
وہ نہیں چاہتے کہ ہم کمزور ذرائع کی بنیاد پر اللہ کی عبادت کریں۔

504
00:40:46,212 --> 00:40:50,759
چنانچہ اسی لیے انہوں نے حدیث پر بہت سخت قوانین کا اطلاق کیا۔

505
00:40:50,783 --> 00:40:56,432
تاہم، جب سیرت کی بات آئی، تو انہوں نے قواعد میں نرمی کی

506
00:40:56,456 --> 00:41:01,770
کیونکہ انہوں نے اسے تاریخ کے طور پر دیکھا جو احکام کو متاثر نہیں کرتی

507
00:41:01,794 --> 00:41:06,542
 اس سے احکام پر کوئی اثر نہیں پڑتا، کوئی بھی حکم اس سے اخذ نہیں ہوتا۔

508
00:41:06,566 --> 00:41:10,646
چنانچہ امام احمد بن حنبل جو حدیث کے عالم ہیں، فرماتے ہیں؛

509
00:41:10,670 --> 00:41:13,282
اِذَا جِئْنَا اِلَى التَّارِيْخْ تَسَاھَلْنَا

510
00:41:13,306 --> 00:41:17,119
جب ہم تاریخ کے بارے میں بات کرتے ہیں، تو ہم نرمی اختیار کرتے ہیں۔

511
00:41:17,143 --> 00:41:25,761
تو آپ کو معلوم ہی ہوگا کہ سیرت کے مصنفین ایسی روایتوں کو قبول کرتے ہیں جنہیں وہ عام طور پر قبول نہیں کرتے،

512
00:41:25,785 --> 00:41:27,596
اگر وہ حدیث کے ساتھ معاملہ کر رہے ہوں۔

513
00:41:27,620 --> 00:41:32,134
لہذا، یہ ایک طریقہ ہے جس کی پیروی ہمارے ابتدائی علماء نے کی۔

514
00:41:32,158 --> 00:41:35,938
ابن اسحاقؒ نے ان اصولوں کے مطابق سیرت کو لکھا۔

515
00:41:35,962 --> 00:41:40,943
المقریزیؒ کی سیرت، ابن سعدؒ کی اور تمام پہلے کے علماء نے

516
00:41:40,967 --> 00:41:46,048
سیرت کے بیان میں نرم اصولوں کی پیروی کی۔

517
00:41:46,072 --> 00:41:52,254
حال ہی میں ہمارے بعض علماء میں ایک نیا رجحان پایا گیا ہے کہ

518
00:41:52,278 --> 00:41:58,227
وہ سیرت پر احادیث کے احکام کو لاگو کرنا چاہتے ہیں۔

519
00:41:58,251 --> 00:41:59,361
کیوں؟

520
00:41:59,385 --> 00:42:08,103
ان علماء کا خیال ہے کہ اب ہم ایک ایسے دور میں جی رہے ہیں جہاں رسول اللہ ﷺ کی تاریخ ہمارے لیے احكام کا درجہ رکھتی ہے۔

521
00:42:08,127 --> 00:42:12,407
امام احمد بن حنبلؒ کے زمانے میں خلافت قائم ہوئی

522
00:42:12,431 --> 00:42:18,046
چنانچہ جب انہوں نے رسول اللہﷺ کی زندگی کا مطالعہ کیا تاکہ اس سے عمومی اسابق حاصل کریں

523
00:42:18,070 --> 00:42:23,785
 لیکن منپجی رہنمائی حاصل کرنے کے لیے نہیں،

524
00:42:23,809 --> 00:42:26,255
کیونکہ اسلام پہلے ہی مستحکم ہو چکا تھا۔

525
00:42:26,279 --> 00:42:35,130
لیکن اب ہمیں سیرت کا مطالعہ کرنے کی ضرورت ہے تا کہ اس سے ہم دعوت کے احکام سیکھ سکیں

526
00:42:35,154 --> 00:42:37,299
اور یہ کہ اسلام کو دوبارہ کیسے قائم کیا جائے۔

527
00:42:37,323 --> 00:42:42,471
لہذا، ہمارے لیے یہ فقہ کی مانند ہے۔

528
00:42:42,495 --> 00:42:47,709
اس لیے وہ علماء کہتے ہیں کہ ہمیں سیرت پر حدیث کے ہی احکام لاگو کرنے چاہئیں۔

529
00:42:47,733 --> 00:42:55,484
دوسری کتاب جو کہ صحیح السیرۃ النبویہ ہے وہ احادیث کے اصولوں کے مطابق ہے۔

530
00:42:55,508 --> 00:43:05,258
تو ان علماء نے کیا یہ کہ وہ بخاری، مسلم، سنن ابن داؤد اور احادیث کی دیگر کتابوں سے رجوع کیا،

531
00:43:05,318 --> 00:43:09,064
انہوں نے سیرت کا حوالہ دینے والی چھوٹی بڑی احادیث کو جمع کیا

532
00:43:09,088 --> 00:43:15,771
اور انہوں نے حدیث کی بنیاد پر رسول اللہﷺ کی سیرت مرتب کی۔

533
00:43:15,795 --> 00:43:20,409
چنانچہ ابن اسحاقؒ کی کتاب سے رجوع کرنے کے بجائے انہوں نے بخاری سے رجوع کیا۔

534
00:43:20,433 --> 00:43:28,216
المقریزی یا دوسرے علماء یا ابن ہشام کے بجائے انہوں نے مسلم سے رجوع کیا۔

535
00:43:28,240 --> 00:43:36,124
سعید ھوا نے حدیث پر مبنی"اساس فی السنۃ " نامی کتاب لکھی۔

536
00:43:36,148 --> 00:43:41,697
ایک اور کتاب ہے جس کا ہم نے ذکر کیا تھا جو ابراہیم العلی نے لکھی ہے جس کا نام صحیح السیرۃ النبویہ ہے۔

537
00:43:41,721 --> 00:43:45,734
اور کچھ اور کتابیں بھی ہیں جو اسی طرز پر تصنیف کی گئی ہیں۔

538
00:43:45,758 --> 00:43:50,906
ابن کثیرؒ کو بنیادی ماخذ چننے کی میری وجہ یہ ہے

539
00:43:50,930 --> 00:43:58,914
کہ ابن کثیرؒ نے دونوں کو ایک کتاب میں یکجا کیا ہے۔

540
00:43:58,938 --> 00:44:06,045
چنانچہ انہوں نے سیرت کی کتابوں سے معلومات اکھٹی کیں، اور احادیث کی کتابوں کو بھی سیرت کے اعتبار سے پرکھا

541
00:44:06,078 --> 00:44:11,860
تو آپ انہیں بخاری اور ابن اسحاق سے روایات نقل کرتے ہوئے پائیں گے۔

542
00:44:11,884 --> 00:44:16,465
اور یہی بات ابن کثیر کی سیرت کو منفرد بناتی ہے۔

543
00:44:16,489 --> 00:44:20,326
ابن کثیر کی بیان کردہ سیرت میں ایک کمی ہے

544
00:44:20,393 --> 00:44:23,905
اور وہ یہ کہ اس کا استعمال قدرے پیچیدہ اور مشکل ہے

545
00:44:23,929 --> 00:44:26,541
کیونکہ وہ روایت کے تمام سلسلے کا ذکر کرتے ہیں

546
00:44:26,565 --> 00:44:30,212
اور کبھی کبھی، وہ تاریخ کی ترتیب پر قائم نہیں رہتے

547
00:44:30,236 --> 00:44:35,751
اور کبھی، وہ ایسی معلومات لاتے ہیں جن میں بظاہر تضاد نظر آتا ہے

548
00:44:35,775 --> 00:44:43,158
لیکن یہ ایک بہترین مصدر ہے، اور الحمدللہ اب یہ انگریزی زبان میں بھی موجود ہے۔

549
00:44:43,182 --> 00:44:50,432
 اس کا ترجمہ حال ہی میں ایک امریکی پروفیسر لی گیسک نے کیا ہے۔

550
00:44:50,456 --> 00:44:53,068
اوراس کا ترجمہ بہت اچھا ہے۔

551
00:44:53,092 --> 00:44:57,105
دوسری کتابیں جو شاید ہم استعمال کریں یا نا کریں

552
00:44:57,129 --> 00:45:04,212
اور ان میں سے کچھ میں سے میں نے اقتباسات لیے ہیں، لیکن میں صرف یہ چاہتا ہوں کہ آپ ان کتابوں سے واقف ہوں۔

553
00:45:04,236 --> 00:45:07,516
جیسے منیر غردان کی تصنیف کردہ؛ المنہاج الحرکی ہے

554
00:45:07,540 --> 00:45:17,759
اس کی خاص بات یہ ہے کہ مصنف نے سیرت سے تحریکی اسباق اخذ کرنے کی کوشش کی ہے۔

555
00:45:17,783 --> 00:45:25,133
چنانچہ انہوں نے سیرت کو خفیہ مرحلے، پھر اعلانیہ مرحلے میں تقسیم کیا اور پھر ہجرت کا ذکر کیا،

556
00:45:25,157 --> 00:45:26,835
اس کے بعد جہاد کے مختلف مراحل کا۔

557
00:45:26,859 --> 00:45:31,873
یعنی انہوں نے سیرت کی مدد سے تحریکی نصاب تیار کرنے کی کوشش کی۔

558
00:45:31,897 --> 00:45:34,543
یہ منیر غردان کی لکھی "المنہج الحرکی" ہے۔

559
00:45:34,567 --> 00:45:37,412
اسے حال ہی میں لکھا گیا ہے۔

560
00:45:37,436 --> 00:45:42,751
اس کے علاوہ محمد الغزالی رحمہ اللہ کی فقہ سیرۃ ہے۔

561
00:45:42,775 --> 00:45:47,689
اس کی خوبی یہ ہے کہ اس میں تربیت کے کچھ اسباق ہیں۔

562
00:45:47,713 --> 00:45:53,128
"فقہ السیرۃ" نامی ایک اور کتاب بھی ہے جسے البوطی نے تصنیف کیا ہے،

563
00:45:53,152 --> 00:45:58,600
از محمد سعید رمضان البوطي، اورانہوں نے فقہ پر زور دیا ہے

564
00:45:58,624 --> 00:46:02,671
انہوں نے سیرت سے کئی فقہی اسباق اخذ کیے ہیں۔

565
00:46:02,695 --> 00:46:07,275
اور مزید" شیخ سلمان العودة" کی ایک کتاب "الغرباء "ہے۔

566
00:46:07,299 --> 00:46:10,145
اور اس کا تعلق اس حدیث سے ہے:

567
00:46:10,169 --> 00:46:11,670
طُوبى لِلغُرَبَاء

568
00:46:11,737 --> 00:46:14,149
اجنبی!، اجنبیوں کی حدیث

569
00:46:14,173 --> 00:46:22,424
اور انہوں نے رسول اللہﷺ کے دور کے اجنبیوں اور آج کے اجنبیوں کے درمیان ربط پیدا کرنے کی کوشش کی ہے۔

570
00:46:22,448 --> 00:46:26,228
سعید ھوا کی کتاب" الاساس في السنة" جس کی ہم نے بات کی ہے،

571
00:46:26,252 --> 00:46:30,432
اور محمد العبدۃ کی تصنیف کردہ الطریق الی المدینہ،

572
00:46:30,456 --> 00:46:33,602
جس میں سیرۃ سے حاصل کردہ اسابق ہیں

573
00:46:33,626 --> 00:46:36,538
اور فقہ السیرۃ از البوطي۔

574
00:46:36,562 --> 00:46:39,965
کچھ اصطلاحات جو میں شروعات میں آپ کو بتانا چاہتا ہوں

575
00:46:40,032 --> 00:46:44,980
کیونکہ بعض اوقات میں عربی الفاظ استعمال کرتا ہوں اور ان کا ترجمہ کرنا بھول جاتا ہوں۔

576
00:46:45,004 --> 00:46:48,116
تو آئیے پہلے ان کے تراجم کو دیکھتے ہیں

577
00:46:48,140 --> 00:46:51,853
تاکہ اگر میں اس کا ترجمہ کرنا بھول بھی جاؤں، تو کم از کم آپ کو ان کا مطلب معلوم ہوگا۔

578
00:46:51,877 --> 00:46:54,289
صلی اللہ علیہ وسلم کا مطلب ہے:

579
00:46:54,313 --> 00:46:57,793
آپؐ پر اللہ کی رحمت اور سلامتی ہو

580
00:46:57,817 --> 00:47:01,196
جب ہم محمد ﷺ کا نام سنتے ہیں تو ہم یہی کہتے ہیں

581
00:47:01,220 --> 00:47:05,300
یہ کہنے کا حکم کیا ہے

582
00:47:05,324 --> 00:47:09,971
محمد ﷺ کا نام پہلی بار سن کر یہ کہنا لازم ہے۔

583
00:47:09,995 --> 00:47:13,175
اس کے بعد ایسا کہنا مستحسن ہے۔

584
00:47:13,199 --> 00:47:14,876
تو اس لیکچر میں

585
00:47:14,900 --> 00:47:20,582
پہلی بار جب آپ محمد ﷺ کا نام سنیں تو آپ پر صلی اللہ علیہ وسلم کہنا لازم ہے۔

586
00:47:20,606 --> 00:47:26,822
اور اس کے بعد کہنا مستحسن ہے جب تک کہ ہم اسی مجلس میں ہیں،

587
00:47:26,846 --> 00:47:28,347
تو یہ ہے اس کا حکم۔

588
00:47:28,447 --> 00:47:32,894
صلاة والسلام علی النبی محمد صلی اللہ علیہ وسلم

589
00:47:32,918 --> 00:47:37,899
رسول اللہ، لفظ رسول اللہ کا معنی اللہ کے رسول ہیں۔

590
00:47:37,923 --> 00:47:41,303
جاہلیہ بھی ایک لفظ ہے جس کا میں ذکر کروں گا

591
00:47:41,327 --> 00:47:46,341
جاہلیہ اسلام پہلے کا دورِ جاہلیت ہے۔

592
00:47:46,365 --> 00:47:51,813
تو یہ جاہلیت نہیں بلکہ،ایک دور ہے۔

593
00:47:51,837 --> 00:47:54,416
مگر یہ ایک طرزِ فکر بھی ہے۔

594
00:47:54,440 --> 00:48:01,590
جب بھی اسلام سے قبل کے زمانے سے کوئی مشابہت رکھتا ہے تو اسے جاہلیہ کہا جاتا ہے

595
00:48:01,614 --> 00:48:05,126
اور سید قطبؒ بھی یہ لفظ بہت استعمال کرتے تھے،

596
00:48:05,150 --> 00:48:13,768
موجودہ زمانے کے حوالے سے وہ کہتے ہیں کہ اس میں اور ابتدائی جاہلیت میں بہت زیادہ مشابہت ہے۔

597
00:48:13,792 --> 00:48:18,173
تو جاہلیہ لفظ جہل سے نکلا ہے جس سے مراد جہالت ہے۔

598
00:48:18,197 --> 00:48:22,377
پس یہ جہالت کا زمانہ ہے یعنی ہدایت کی عدم موجودگی

599
00:48:22,401 --> 00:48:26,514
بےشک ہدایت موجود ہے، لیکن لوگ اس پر عمل نہیں کر رہے۔

600
00:48:26,538 --> 00:48:28,283
اسے جاہلیہ کہا جائے گا

601
00:48:28,307 --> 00:48:36,391
"ایمان" یعنی یقین،"جنۃ " یعنی جنت اور "نار" جہنم کی آگ ہے۔

602
00:48:36,415 --> 00:48:41,363
آخر میں علمائے حدیث اور علمائے سیرت کے درمیان فرق پر بات ہے۔ جیسا کہ میں نے پہلے بتایا تھا

603
00:48:41,387 --> 00:48:46,067
حدیث کے علماء کرام غلط احکام کے خوف سے روایات کے معاملے میں زیادہ سخت ہیں

604
00:48:46,091 --> 00:48:49,804
سیرت کے علماء اتنی سختی نہیں کرتے ہیں کیونکہ وہ واقعات حاصل کرنا چاہتے ہیں

605
00:48:49,828 --> 00:48:51,997
اور روایات کی نقل میں نرمی اختیار کرتے ہیں۔

606
00:48:52,031 --> 00:48:55,977
 اور جیسا ہم نے پہلے ذکر کیا، ہم ایک مشترکہ راہ استعمال کررہے ہیں۔

607
00:48:56,001 --> 00:49:03,485
لہذا، میں حدیث استعمال کروں گا اور ان جن حالات کے متعلق حدیث نہ ہو،

608
00:49:03,509 --> 00:49:08,347
تو ہم اس خلاء کو پُر کرنے کے لیے سیرت کا سہارا لیں گے

609
00:49:08,380 --> 00:49:11,517
بہت خوب، یہ اس سلسلے کا تعارف تھا

610
00:49:11,550 --> 00:49:17,098
ان شاء اللہ تعالی، اگلے سیشن میں پس منظر کی تاریخ پر کچھ گفتگو کریں گے۔

611
00:49:17,122 --> 00:49:20,702
صَلَّى الله عَلى سَيَّدِنَا محمد وَعَلى اَلِهِ وَ صَحْبِهِ وَسَلِّمْ سُبْحاَنَكَ الله هُمَّ وَبِحَمْدِك

612
00:49:20,726 --> 00:49:25,698
نَشْهَدُ الله اِلَهَ اِلَّا اَنْتْ نَسْتَغْفِرُكَ وَ نَتُوْبُ عَلَيْكْ

