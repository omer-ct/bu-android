1
00:00:22,223 --> 00:00:24,267
اَعُوْذُ بِاللهِ مِنَّ الشِّيْطَانِ الرَّجِيْمِ۝

2
00:00:24,317 --> 00:00:25,920
بِسْمِ اللهِ الرَّحْمَانِ الرَّحِيْمَ۝

3
00:00:25,981 --> 00:00:32,530
اَلْحَمْدُ لله ، وَالصَّلَاةُ وَالسَّلَامُ عَلى سَيِّدِنَا محمد وَعَلَى اَلِهِ وَصَحْبِهِ وَسَلِّمْ تَسْلِيْمًا كَثِيْرا

4
00:00:35,555 --> 00:00:43,757
حضرت ابوبکر صدیقؓ نے مسلم ریاستوں کی گورنری سے متعلق

5
00:00:43,807 --> 00:00:54,763
  رسول اللہؐ کے مقرر کردہ گورنروں اور سپہ سالاروں کو اُن کے عہدوں پر برقرار رکھنے کی پالیسی اختیار کی

6
00:00:54,806 --> 00:01:02,530
تمام أمراء ألجُنْد(فوجی جرنیل) اور امراء البلدان(ریاستی گورنر)

7
00:01:02,564 --> 00:01:04,928
آپ دیکھتے ہیں کہ تقرریوں کی دو اقسام تھیں

8
00:01:04,992 --> 00:01:12,890
ایک فوج کا سپہ سالار اور دوسرا اسلامی ریاست کا گورنر

9
00:01:12,914 --> 00:01:19,700
 رسول اللہؐ نے جنھیں مقرر کیا، حضرت ابوبکر صدیقؓ نے کبھی اُن میں سے کسی کو تبدیل نہیں کیا

10
00:01:19,771 --> 00:01:25,427
  تاوقتیکہ آپؓ اس شخص کو کسی بہتر عہدے پر فائز نہ فرماتے

11
00:01:25,476 --> 00:01:30,093
یا انہیں دو مختلف عہدوں کے درمیان انتخاب دیتے

12
00:01:30,130 --> 00:01:38,023
چنانچہ مثال کے طور پر حضرت عمرو بن العاصؓ کو رسول اللہؐ نے عمان کا گورنر مقرر کیا تھا

13
00:01:38,084 --> 00:01:41,863
چنانچہ حضرت ابوبکر صدیقؓ نے انہیں ایک خط بھیجا

14
00:01:41,913 --> 00:01:46,316
آپؓ نے فرمایا؛ میں آپؓ کو فوج کا سپہ سالار مقرر کرنے کا سوچ رہا ہوں

15
00:01:46,341 --> 00:01:48,503
میں آپؓ کو فلسطین بھیجنے جا رہا ہوں

16
00:01:48,551 --> 00:01:53,353
 اس لیے یہ آپ کی مرضی ہے کہ آپ جہاں ہیں وہیں رہنا چاہتے ہیں، یا جا کر اس فوج کی قیادت سنبھالیں

17
00:01:53,392 --> 00:01:59,650
 چنانچہ حضرت عمرو بن العاصؓ خلیفہ کی سفارش پر عمل درامد کرتے ہوئے عمان چھوڑ دیا

18
00:01:59,696 --> 00:02:03,517
اور آپؓ نے فلسطین جانے والی فوج کی قیادت سنبھال لی

19
00:02:03,547 --> 00:02:09,630
اورحضرت مہاجر بن ابی امیہؓ کو حضرت ابوبکر صدیقؓ نے پیغام بھیجا

20
00:02:09,667 --> 00:02:12,797
اور آپؓ سے پوچھا کہ کیا وہ صنعاء کا امیر بننا چاہتے ہیں؟

21
00:02:12,840 --> 00:02:14,001
 یا حضرالموت کا امیر مقرر ہونا چاہیں گے؟

22
00:02:14,025 --> 00:02:17,303
اور اس سے بیشتر آپؓ کو رسول اللہؐ نے یمن کا امیر مقرر فرمایا تھا

23
00:02:17,349 --> 00:02:21,143
چنانچہ حضرت مہاجر بن ابی امیہؓ نے صنعاء میں فرائض سرانجام دینا پسند کیا

24
00:02:21,195 --> 00:02:29,850
 علاوہ ازیں آپؓ نے کسی ایسے عہدے دار کو برطرف نہیں کیا جسے حضرت محمدﷺ نے مقرر فرمایا تھا

25
00:02:29,910 --> 00:02:33,090
ان امراء کی ذمہ داریاں کیا تھیں؟

26
00:02:33,138 --> 00:02:37,163
اور امیر کا مطلب ہے لیڈر یا کسی چیز کا سربراہ

27
00:02:37,212 --> 00:02:42,430
نمبر ایک، نماز کی امامت کروانہ اور جمعہ پڑھانا

28
00:02:42,482 --> 00:02:47,290
 نماز کی امامت بھی امیر کی زمہ داریوں میں شامل تھی

29
00:02:47,331 --> 00:02:53,460
اور نماز کی امامت کسی بھی شخص کی مذہبی قیادت کی عکاسی بھی کرتی ہے

30
00:02:53,503 --> 00:02:55,681
اور چونکہ یہ شخص دین میں رہنمائی کر رہا ہے

31
00:02:55,713 --> 00:03:03,517
 اس سے یہ ظاہر ہوتا ہے کہ وہ ایسے معاملات میں بھی راہنمائی کرے جس کی اہمیت کم ہے اور وہ ہیں دنیاوی معاملات

32
00:03:03,547 --> 00:03:13,880
اب معاملہ اس کے برعکس ہوگیا ہے، ہم امام کے کردار کو سیاسی یا عسکری عہدے داری سے کم اہمیت دیتے ہیں

33
00:03:13,909 --> 00:03:19,423
لیکن صحابہ کرامؓ نے جب دیکھا کہ حضرت ابوبکر صدیقؓ نماز کے امام تھے

34
00:03:19,472 --> 00:03:27,983
 انہوں نے دیکھا کہ امامت اس بات کی دلیل ہے کہ اصل میں آپؓ ہی وہ شخصیت ہیں جو رسول اللہؐ کے وصال کے بعد قیادت سنبھالیں گے

35
00:03:28,037 --> 00:03:31,225
چنانچہ آپؓ مسجد میں باجماعت نماز کی امامت کرواتے تھے

36
00:03:31,249 --> 00:03:34,033
اور آپؓ خطبہ جمعہ بھی دیتے تھے

37
00:03:34,071 --> 00:03:38,097
چنانچہ خلیفہ اسلامی دارالحکومت میں جمعہ کا خطبہ دیتا

38
00:03:38,133 --> 00:03:43,630
اور پھر ہر علاقے کا امیر(گورنر) اپنے علاقے کی جامع مسجد میں خطبہ دیتا

39
00:03:43,665 --> 00:03:46,930
اس شہر یا علاقے کی بڑی مسجد(جامع مسجد)

40
00:03:46,981 --> 00:03:51,830
چنانچہ مثال کے طور پر صنعاء میں جامع الکبیر نامی عظیم الشان مسجد تھی

41
00:03:51,886 --> 00:03:55,077
 اور یہی وہ جگہ تھی جہاں امیر(گورنر) خطبہ دیا کرتا تھا

42
00:03:55,119 --> 00:04:00,747
 دمشق کے شمال میں واقع ایک عظیم الشان مسجد" الجامع الاموی" اس علاقے کی مرکزی مسجد تھی

43
00:04:00,775 --> 00:04:04,913
 اندلس میں جامع قرطبہ یعنی مسجد قرطبہ تھی

44
00:04:04,951 --> 00:04:08,530
چنانچہ اس مقام پر امیر(گورنر) خطبہ دیتا

45
00:04:08,583 --> 00:04:13,903
لہٰذا، جمعہ کا خطبہ عوام کو اپنے مذہب سے روشناس کروانے کے لیے ایک پیغام ہوتا تھا

46
00:04:13,940 --> 00:04:20,457
 یہ خطبہ امیر کے لیے ایک موقع ہوتا تھا کہ وہ اپنے مقلدین سے امت کے حالات حاضرہ پر گفتگو کرے

47
00:04:20,517 --> 00:04:25,050
چنانچہ جمعہ کے خطبہ کا عوام الناس کو فقہ کی تعلیم دینے میں جامع کردار تھا

48
00:04:25,094 --> 00:04:31,663
انہیں اپنا دین سکھانا اور امت کے اجتماعی امور سے آگاہ کرنا

49
00:04:31,704 --> 00:04:38,360
  جہاد سے متعلق ہر امر کو ملحوظِ خاطر رکھنا امراء کی دوسری ترجیح تھی

50
00:04:38,407 --> 00:04:41,680
 لہذا، مثال کے طور پر لشکر میں نئے سپاہیوں کی بھرتی امراء کے توسط سے ہوتی تھی

51
00:04:41,709 --> 00:04:47,598
 جب حضرت ابوبکر صدیقؓ کی خواہش تھی کہ سپاہی جائیں اور ان اسلامی لشکروں کی عسکری طاقت بڑھائیں

52
00:04:47,638 --> 00:04:50,650
 جو فارس(ایران) اور رومی سلطنت کی طرف روانہ کیے گئے تھے

53
00:04:50,703 --> 00:04:56,687
مثال کے طور پر آپؓ نے یمن میں اپنے امراء کو خط بھیجا اور حکم صادر کیا کہ نئے سپاہی بھرتی کریں اور انہیں محاز پر بھیجیں

54
00:04:56,729 --> 00:04:59,110
تو امیر،لشکر میں نئی بھرتیوں کے عمل میں کلیدی کردار ادا کرتا تھا

55
00:04:59,152 --> 00:05:04,100
 امیر،جہاد کے مالی امورکی زمہ داریاں بھی نبھاتا تھا

56
00:05:04,142 --> 00:05:05,740
کیونکہ آپ کے پاس مالِ غنیمت بھی ہوا کرتا تھا

57
00:05:05,787 --> 00:05:08,110
آپ کے پاس سپاہیوں کا راشن بھی تھا

58
00:05:08,143 --> 00:05:13,253
آپ کے پاس تنخواہیں بھی تھیں، لہذا امارت میں بہت زیادہ مالی ذمہ داریاں شامل تھیں

59
00:05:13,282 --> 00:05:15,883
اور یہ سب کچھ بھی امیر کی ذمہ داری تھی

60
00:05:15,930 --> 00:05:22,177
مزید برآں دشمن کے ساتھ مذاکرات، کوئی امن معاہدہ یا جنگ بندی

61
00:05:22,207 --> 00:05:26,270
یہ سب امور ایسے ہیں جو امیر، خلیفہ کے قائم مقام کی حیثیت سے سرانجام دیتا

62
00:05:26,340 --> 00:05:29,830
 اور عام طور پر دونوں(خلیفہ وامیر) کے درمیان دو طرفہ مواصلت ہوتی تھی

63
00:05:29,880 --> 00:05:38,983
لیکن حضرت ابوبکر صدیقؓ نے امراء کو فیصلے کرنے میں بہت زیادہ آزادی اور اختیارات دیے

64
00:05:39,015 --> 00:05:47,013
لیکن ظاہر ہے اعلیٰ سطح کے معاملات میں وہ ہمیشہ خلیفہ سے مشاورت کرنے کے لیے ایک قاصد بھیجتے تھے

65
00:05:47,050 --> 00:05:58,000
نمبر تین، ججوں کی تقرری اور  غارمینِ زکوٰۃ و جزیہ کی تقرری وغیرہ جیسے امور کی انجام دہی بھی امیر ہی کرتا تھا

66
00:05:58,021 --> 00:06:02,290
نمبر چار، تمام امراء خلیفہ کے لیے عوام سے بیعت لیں گے

67
00:06:02,342 --> 00:06:05,565
کیونکہ ان دنوں ذرائع مواصلات سست رفتار تھے

68
00:06:05,647 --> 00:06:10,153
لہذا آپ بیک وقت سب سے بیعت نہیں لے سکتے تھے

69
00:06:10,193 --> 00:06:16,130
چنانچہ مدینہ میں حضرت عمر بن خطابؓ نے حضرت ابوبکر صدیقؓ کے لیے بیعت لی

70
00:06:16,181 --> 00:06:20,943
 یا آپؓ نے ہی حضرت ابوبکرؓ کے خطبے کا آغاز کیا جیسا کہ ہم نے پچھلے اجلاس میں ذکر کیا تھا

71
00:06:20,970 --> 00:06:23,241
لیکن حضرت ابوبکر صدیقؓ موجود تھے

72
00:06:23,266 --> 00:06:26,717
 آپؓ منبر پر کھڑے تھے اور لوگوں نے آ کر آپؓ کو بیعت دی

73
00:06:26,746 --> 00:06:31,513
لیکن دیگر ریاستوں کے لوگ خلیفہ کو بیعت کیسے دیتے تھے؟

74
00:06:31,552 --> 00:06:36,717
وہ خلیفہ کو بیعت اس کے امیر کے توسط سے دیتے تھے

75
00:06:36,764 --> 00:06:39,410
نمبر پانچ، وہ اسلامی حدود کو قائم کریں گے

76
00:06:39,455 --> 00:06:43,503
اور وہ قوانین نافذ کرتے اور اس پر اجتہاد کرتے

77
00:06:43,551 --> 00:06:47,183
مثال کے طور پر، حضرت المہاجرؓ کا معاملہ دیکھیں

78
00:06:47,237 --> 00:06:50,137
 آپؓ اس وقت حضرالموت کے امیر تھے

79
00:06:50,177 --> 00:06:53,200
دو عورتیں تھیں، جو گیت گاتی تھیں

80
00:06:53,247 --> 00:06:58,537
اور ان میں سے ایک عورت رسول اللہؐ کی شان میں گستاخی کر رہی تھی اور رسول اللہؐ کے بارے میں نازیبا گیت گا رہی تھی

81
00:06:58,586 --> 00:07:03,307
جبکہ دوسری عورت مسلمانوں کی مخالفت میں گیت گا رہی تھی

82
00:07:03,344 --> 00:07:07,210
چنانچہ حضرت المہاجرؓ نے اس مسئلہ میں اجتہاد کیا

83
00:07:07,258 --> 00:07:11,570
کیوںکہ آپؓ ایسی صورتِ حال سے متعلق کسی واضح حد یا حکم سے آگاہ نہیں تھے

84
00:07:11,610 --> 00:07:17,517
چنانچہ آپؓ نے ان گستاخ عورتوں کے اگلے دانت توڑ دیے اور پھر اپنی اس کاروائی کی تفصیل خلیفہ کے طرف بھیجی

85
00:07:17,573 --> 00:07:20,927
تو حضرت ابوبکر صدیقؓ نے حضرت مہاجِرؓ کو پیغام بھیجا؛

86
00:07:20,963 --> 00:07:28,800
رسول اللہؐ کی شان میں نازیبا کلمات گانے والی عورت کو سزائے موت دی جانی چاہئے تھی

87
00:07:28,851 --> 00:07:31,920
آپؓ نے فرمایا ؛ اور وہ عورت جو مسلمانوں کے خلاف گاتی تھی

88
00:07:31,973 --> 00:07:37,823
 آپؓ کو اس کے دانت نہیں توڑنا چاہئے تھے بلکہ اسے ہلکی سی سزا دینی چاہئے تھی

89
00:07:37,884 --> 00:07:42,410
کیونکہ پہلی صورت کفر ہے جبکہ دوسری صورت گناہ ہے

90
00:07:42,443 --> 00:07:45,343
چنانچہ آپؓ نے حضرت المہاجرؓ کے فیصلے کی اصلاح فرمائی

91
00:07:45,385 --> 00:07:50,843
لیکن حضرت المہاجرؓ پہلے ہی غلط اجتہاد کی بنیاد پر قانون نافذ کر چکے تھے

92
00:07:50,890 --> 00:07:58,050
نمبر چھ، تمام امراء مساجد میں مطالعاتی حلقے منعقد کرنے کے پابند ہوں گے

93
00:07:58,101 --> 00:08:03,320
تو امیر، جو سیاسی قائد یا فوج کا سپہ سالار ہوتا

94
00:08:03,366 --> 00:08:07,403
مسجد میں بیٹھ کر حلقہ منعقد کرواتا اور لوگوں کو قرآن کی تعلیم دیتا

95
00:08:07,455 --> 00:08:10,043
انہیں رسول اللہؐ کی حدیث کی تعلیم دیتا

96
00:08:10,085 --> 00:08:13,650
امراء(گورنروں) نے اسے اپنا فرض سمجھا

97
00:08:13,687 --> 00:08:16,978
چنانچہ حضرت مہاجر بن ابی امیہؓ مسجد میں بیٹھ کر لوگوں کو درس دیتے

98
00:08:17,039 --> 00:08:21,777
حضرت معاذ ابن جبلؓ جو امیر تھے، آپؓ بھی مسجد میں بیٹھ کر لوگوں کو دینی تعلیم دیتے تھے

99
00:08:21,823 --> 00:08:28,427
حضرت ابودرداءؓ اور دیگر صحابہ کرامؓ جن کے پاس یہ سیاسی اور عسکری مناصب تھے

100
00:08:28,475 --> 00:08:38,080
لیکن وہ سب عوام الناس کو دینی تعلیم دینا اپنا فرض سمجھتے تھے، بطور قائد لوگوں کو مذہب سکھاتے اور ان تک دین پہنچاتے

101
00:08:38,116 --> 00:08:46,643
اب یہ قصے ہیں کہ حضرت علی بن ابی طالبؓ اور حضرت زبیرؓ نے بیعت کرنے میں تاخیر کی

102
00:08:46,696 --> 00:08:50,800
 تو اس میں حقیقت کیا ہے کہ دراصل ہوا کیا تھا؟

103
00:08:50,849 --> 00:09:00,757
اب ہم اس موضوع پر پہلے بات کر چکے ہیں کہ ہاں حضرت علی بن ابی طالبؓ بنو سعدہ کی بیٹھک میں موجود نہیں تھے

104
00:09:00,788 --> 00:09:07,150
کیونکہ آپؓ رسول اللہؐ کی تجہیزوتکفین میں مصروف تھے

105
00:09:07,208 --> 00:09:11,690
البتہ اگلے دن جب بیعتِ عام ہوئی

106
00:09:11,714 --> 00:09:17,710
جب حضرت ابوبکر صدیقؓ مسجد میں عوام الناس سے بیعت لے رہے تھے

107
00:09:17,762 --> 00:09:26,057
 آپؓ نے آس پاس دیکھا، آپؓ کو حضرت زبیر بن عوامؓ نظر نہ آئے تو آپؓ نے انہیں بلوایا

108
00:09:26,099 --> 00:09:27,570
 چنانچہ حضرت زبیرؓ تشریف لائے

109
00:09:27,614 --> 00:09:30,273
اور حضرت ابوبکر صدیقؓ نے فرمایا؛

110
00:09:30,317 --> 00:09:33,680
أتريدو أنت شُقَّ عصل مسلمين

111
00:09:33,879 --> 00:09:37,773
کیا آپ مسلمانوں میں نفاق ڈالنا چاہتے ہیں؟

112
00:09:37,810 --> 00:09:38,907
تو حضرت زبیرؓ نے فرمایا؛

113
00:09:38,956 --> 00:09:43,250
 لا تصليب عليك يا خليفة رسول الله

114
00:09:43,429 --> 00:09:49,250
ہم رسول اللہؐ  کے خلیفہ سے اختلاف نہیں رکھتے، آپؓ تشریف لائے اور حضرت ابوبکرؓ کو بیعت دی

115
00:09:49,278 --> 00:09:54,380
 آپؓ نے فرمایا؛ میں نے اس لیے تاخیر نہیں کی کہ مجھے آپؓ سے کوئی اختلاف تھا

116
00:09:54,428 --> 00:09:57,567
چنانچہ آپؓ آئے اور خلیفہ کو بیعت دی

117
00:09:57,602 --> 00:10:01,983
پھر حضرت ابوبکر صدیقؓ نے آس پاس نگاہ دوڑائی کہ حضرت علیؓ دکھائی نہیں دئیے

118
00:10:02,026 --> 00:10:03,890
پھر حضرت علیؓ نہایت سُرعت(تیزرفتاری) سے تشریف لائے

119
00:10:03,924 --> 00:10:05,067
تو حضرت ابوبکر صدیقؓ نے فرمایا؛

120
00:10:05,091 --> 00:10:07,531
أتريدو أنت شُقَّ عصل مسلمين

121
00:10:07,555 --> 00:10:10,268
کیا آپؓ مسلمانوں میں رخنہ ڈالنا چاہتے ہیں؟

122
00:10:10,350 --> 00:10:13,763
چونکہ آپؓ نے بیعت نہیں دی تھی اس کا مطلب یہ ہے کہ آپ مسلمانوں کی جماعت سے باہر کھڑے ہیں

123
00:10:13,813 --> 00:10:14,776
حضرت علی بن ابو طالبؓ نے فرمایا؛

124
00:10:14,801 --> 00:10:17,277
 لا تصليب عليك يا خليفة رسول الله

125
00:10:17,327 --> 00:10:20,677
 اے رسول اللہؐ کے خلیفہ مجھے آپؓ سے کوئی اختلاف نہیں

126
00:10:20,740 --> 00:10:24,530
پھر آپؓ نے حضرت ابوبکر صدیقؓ کو بیعت دی

127
00:10:24,583 --> 00:10:28,007
اب اس حدیث کو ابن کثیرؒ نے مذکور کیا

128
00:10:28,058 --> 00:10:30,537
اور ابن کثیرؒ نے یہ بھی بیان کیا ہے

129
00:10:30,575 --> 00:10:38,707
کہ امام مسلمؒ، شیخ ابن خزیمہؒ کے پاس ان کو یہ حدیث سکھانے کی غرض سے گئے

130
00:10:38,752 --> 00:10:41,630
اور آپؒ نے یہ حدیث تحریر فرمائی

131
00:10:41,669 --> 00:10:43,736
اور پھر امام مسلمؒ نے فرمایا؛

132
00:10:43,761 --> 00:10:45,787
"یہ حدیث اونٹ کے برابر ہے"

133
00:10:45,811 --> 00:10:48,943
یعنی یہ بیش بہا ہے، یہ حدیث اونٹ کے برابر ہے

134
00:10:48,988 --> 00:10:49,938
ابن خزیمہؒ نے آپؒ سے فرمایا؛

135
00:10:49,978 --> 00:10:56,693
یہ نہ صرف اونٹ کے برابر ہے بلکہ سونے کے سکوں کے ایک بڑے ڈھیر کے برابر ہے

136
00:10:56,746 --> 00:11:03,043
پس یہ حدیث گراں قدر ہے کیونکہ یہ ہمیں حالات کی حقیقت بتاتی ہے کہ کیا ہوا تھا

137
00:11:03,090 --> 00:11:08,619
 اور حضرت علی بن ابی طالبؓ گھر پر تھے جب مسلمان مسجد میں جمع ہو رہے تھے

138
00:11:08,651 --> 00:11:10,957
تو کسی نے آ کر آپؓ کو بتایا

139
00:11:10,993 --> 00:11:13,620
کہ مسجد میں خلیفہ کو بیعت دی جا رہی ہے

140
00:11:13,643 --> 00:11:17,863
حضرت علی بن ابی طالبؓ جلدی سے باہر نکلے، آپؓ دیر نہیں کرنا چاہتے تھے

141
00:11:17,901 --> 00:11:24,157
اور آپؓ اپنے ساتھ اپنا کُرتا یا چادر بھی نہیں لے کر گئے

142
00:11:24,190 --> 00:11:26,070
 آپؓ دوڑتے ہوئے مسجد میں پہنچے

143
00:11:26,109 --> 00:11:29,976
اور پھر آپؓ کی چادر(جس سے أپؓ اپنے شانے ڈھانپتے تھے) اس وقت پہنچائ گئی جب آپؓ مسجد میں تھے

144
00:11:30,014 --> 00:11:32,533
کیونکہ آپؓ بیعت دینے میں دیر نہیں کرنا چاہتے تھے

145
00:11:32,581 --> 00:11:35,790
جب بیعت رسول اللہؐ کے خلیفہ کو دی جا رہی تھی

146
00:11:35,858 --> 00:11:42,197
تو کوئی کیسے کہہ سکتا ہے کہ حضرت زبیرؓ اورحضرت علیؓ، حضرت ابوبکر صدیقؓ کو بیعت نہیں دینا چاہتے تھے؟

147
00:11:42,253 --> 00:11:46,647
جبکہ یہ دونوں وہ صحابہ تھے جو حضرت ابوبکر صدیقؓ کو سب سے بہتر جانتے تھے

148
00:11:46,696 --> 00:11:50,557
یہ حضرت علی بن ابی طالبؓ تھے جنہوں نے حضرت ابوبکر صدیقؓ کے بارے میں فرمایا؛

149
00:11:50,611 --> 00:11:51,407
ھو السباق

150
00:11:51,431 --> 00:11:53,877
آپؓ ہم سب پر سبقت لے جاتے تھے

151
00:11:53,925 --> 00:11:56,920
ما سبقنا إلى سبقٍ قط إلَّا خير سبقنا

152
00:11:57,006 --> 00:12:01,963
ہم نے کبھی آپؓ سے کسی نیکی میں مقابلہ کرنے کی جرات نہیں کی کیونکہ آپؓ ہر نیک عمل میں پہل کرتے تھے

153
00:12:02,008 --> 00:12:07,210
اور حضرت علی بن ابی طالبؓ، حضرت ابوبکر صدیقؓ سے بہت محبت کرتے تھے

154
00:12:07,280 --> 00:12:09,330
کہ جب حضرت ابوبکر صدیقؓ کا وصال ہوا

155
00:12:09,359 --> 00:12:17,290
یہ حضرت علی بن ابی طالبؓ ہی تھے جنہوں نے حضرت محمد بن ابوبکرؓ کو اپنی نگہبانی میں لیا، اور آپؓ کی پرورش اپنے گھر میں کی

156
00:12:17,378 --> 00:12:21,610
چنانچہ حضرت علی بن ابو طالبؓ نے حضرت ابوبکرؓ کے صاحبزادے محمدؓ کی زمہ داری اُٹھائی اور آپؓ کی پرورش کی

157
00:12:21,635 --> 00:12:28,557
اورحضرت علیؓ،اُن سے اس قدر محبت کرتے تھے کہ آپؓ  نے اُنھیں مصر میں اپنا امیر( گورنر) بنایا

158
00:12:28,612 --> 00:12:31,583
حضرت زبیر بن عوامؓ کس سے بیاہے ہوئے تھے؟

159
00:12:31,641 --> 00:12:35,263
 آپؓ کی شادی حضرت ابوبکرؓ کی صاحبزادی حضرت اسماءؓ سے ہوئی

160
00:12:35,313 --> 00:12:39,097
چنانچہ حضرت ابوبکرؓ کے ساتھ حضرت زبیرؓ کے خاندانی تعلقات تھے اور وہ آپؓ سے بہت محبت کرتے تھے

161
00:12:39,142 --> 00:12:44,377
یہ سب جھوٹے دعوے ہیں جن میں کوئی صداقت نہیں ہے

162
00:12:44,425 --> 00:12:52,623
اہل سنت والجماعت کے علماء حضرت ابوبکر صدیقؓ کی بیعت کو تمام مسلمانوں کا اجماع سمجھتے ہیں

163
00:12:52,664 --> 00:12:57,890
صحابہ میں سے کسی نے بھی اس عہد(بیعت) کو نہیں توڑا

164
00:12:57,946 --> 00:13:01,292
اور صحابہ میں سے ایک صحابی حضرت سعید بن زیدؓ تھے

165
00:13:01,317 --> 00:13:04,308
آپؓ جنت کی بشارت پانے والے عشرہ مبشرہ میں سے تھے

166
00:13:04,332 --> 00:13:06,310
 آپؓ سے مندرجہ ذیل سوال پوچھا گیا

167
00:13:06,345 --> 00:13:09,603
أشَّهِدتَا وفَات رسول اللہ صلی اللہ علیہ وسلم

168
00:13:09,661 --> 00:13:14,773
کیا آپؓ رسول اللہؐ کے وصال کے وقت موجود تھے؟ آپؓ نے فرمایا؛ ہاں

169
00:13:14,810 --> 00:13:17,102
قال له متع بُعْيَى أبا بكر

170
00:13:17,274 --> 00:13:19,477
آپؓ سے پوچھا گیا کہ حضرت ابوبکرؓ کو بیعت کب دی گئی؟

171
00:13:19,517 --> 00:13:27,537
قال سعيد يوم مات رسول الله صلى الله عليه وسلم كره المسلمون أن يبقه بعد يومٍ وليس في جماعة

172
00:13:27,592 --> 00:13:32,738
حضرت سعیدؓ نے فرمایا؛حضرت ابوبکرؓ کو بیعت اسی دن دی گئی، جس دن رسول اللہؐ کا وصال ہوا

173
00:13:32,775 --> 00:13:38,797
کیونکہ مسلمان جماعت کے بغیر ایک دن بھی نہیں رہنا چاہتے تھے

174
00:13:38,855 --> 00:13:40,644
قال هل خلف أحدٌ أبا بكر

175
00:13:40,668 --> 00:13:44,110
پھر پوچھا گیا کہ کیا کوئی شخص تھا جو حضرت ابوبکرؓ کی بیعت کے خلاف تھا؟

176
00:13:44,135 --> 00:13:45,110
قال سعید: لا

177
00:13:45,163 --> 00:13:45,810
 حضرت سعیدؓ نے فرمایا؛ نہیں

178
00:13:45,874 --> 00:13:48,200
لم يخالفه إلَّا مرتد

179
00:13:48,487 --> 00:13:52,837
 مرتد کے علاوہ کسی بھی شخص نے حضرت ابوبکر صدیقؓ کی بیعت سے انکار نہیں کیا اور نہ مخالفت کی

180
00:13:52,876 --> 00:13:53,853
أوكاد أن يرد

181
00:13:53,878 --> 00:13:56,837
یا ایسا شخص جو مرتد ہونے کا سوچ رہا تھا

182
00:13:56,889 --> 00:13:58,320
وقد أنقضى الله أنصار

183
00:13:58,345 --> 00:14:00,610
اور اللہ عَزَّوَجَلْ نے انصار کو محفوظ رکھا

184
00:14:00,656 --> 00:14:02,503
فجمعهم عليه وَ اَبايعهم

185
00:14:02,689 --> 00:14:06,397
اللہ تعالیٰ نے انصار کو بچایا اور ان کی حفاظت فرمائی اور ان سب کو بیعت سے نوازا

186
00:14:06,468 --> 00:14:09,817
کیونکہ ہم انصار کو درپیش صورتحال کے متعلق بات کر چُکے ہیں

187
00:14:09,872 --> 00:14:12,103
تو اللہ عَزَّوَجَلْ نے انہیں بچا لیا

188
00:14:12,164 --> 00:14:15,800
اور انہیں حضرت ابوبکر صدیقؓ کی بیعت عطا فرمائی

189
00:14:15,852 --> 00:14:16,640
اور پھر حضرت سعیدؓ سے پوچھا گیا؛

190
00:14:16,681 --> 00:14:19,197
هل قاعدة أحدٌ من المهاجرين عن بيعتِ؟

191
00:14:19,440 --> 00:14:23,690
کیا مہاجرین میں سے کوئی تھا جس نے آپؓ کو بیعت نہ دی ہو؟

192
00:14:23,743 --> 00:14:24,917
  آپؓ نے جواب میں فرمایا؛

193
00:14:24,957 --> 00:14:27,611
لأ لقد تتابع على مهاجرون على بيعة

194
00:14:27,635 --> 00:14:31,683
نہیں! سب نے آکر حضرت ابوبکرؓ کو بیعت دی

195
00:14:31,724 --> 00:14:34,397
تو یہ ایک بہت واضح معاملہ ہے

196
00:14:34,432 --> 00:14:39,903
دوسرا مسئلہ جو پیش آیا وہ وراثت کا مسئلہ تھا

197
00:14:39,945 --> 00:14:53,550
حضرت فاطمہؓ اور رسول اللہؐ کے چچا حضرت عباسؓ ، حضرت ابوبکر صدیقؓ کے پاس تشریف لائے اور رسول اللہؐ سے اپنی وراثت طلب کی

198
00:14:53,585 --> 00:14:56,357
حضرت ابوبکر صدیقؓ نے فرمایا؛

199
00:14:56,414 --> 00:15:01,188
میں نے رسول اللہؐ کو انبیاء کے بارے میں فرماتے سنا ہے

200
00:15:01,244 --> 00:15:04,370
لا نورث ما تركنا صدقه

201
00:15:04,427 --> 00:15:09,330
اللہ کے انبیاء کی وراثت نہیں ہوتی ، جو ترکہ وہ چھوڑ جاتے ہیں وہ صدقہ ہے

202
00:15:09,378 --> 00:15:14,790
اللہ کے انبیاء وراثتی قوانین سے مثتثنیٰ ہیں

203
00:15:14,833 --> 00:15:18,719
اللہ عَزَّوَجَلْ کے انبیاء ورثہ نہیں چھوڑتے

204
00:15:18,751 --> 00:15:25,263
اللہ کے انبیاء، اپنی امت کے لیے سرپرست یا والِد کا درجہ رکھتے ہیں

205
00:15:25,305 --> 00:15:27,767
نبی اپنی امت کے سربراہ(والد) ہیں

206
00:15:27,792 --> 00:15:30,307
ہم رسول اللہؐ کی ازواج کو کیا کہتے ہیں؟

207
00:15:30,353 --> 00:15:34,193
امہات المؤمنین، مومنوں کی مائیں

208
00:15:34,218 --> 00:15:36,880
اور حضرت ابراہیمؑ کو کیا کہا جاتا ہے؟

209
00:15:36,917 --> 00:15:40,517
اباک ابراهیم هو سماک المسلمین من قبل وفی هذا

210
00:15:40,581 --> 00:15:44,690
کہ وہ تمہارا باپ ابراہیمؑ ہے اور وہی ہے جس نے تمہیں مسلمان کہلوایا ہے

211
00:15:44,738 --> 00:15:47,827
وہی ہیں جنہوں نے ہمیں مسلمان کا لقب دیا ہے

212
00:15:47,868 --> 00:15:51,160
پس انبیاء علیہم السلام کی وراثت نہیں ہوتی

213
00:15:51,233 --> 00:15:55,890
چنانچہ جب حضرت فاطمہؓ اور حضرت عباسؓ، حضرت ابوبکرؓ کے پاس تشریف لائے تو انہیں اس حدیث کا علم نہیں تھا

214
00:15:55,930 --> 00:16:00,343
حضرت ابوبکر صدیقؓ نے انہیں بتایا تو انہوں نے اس بات کو تسلیم کر لیا

215
00:16:00,381 --> 00:16:03,097
اس لیے انہیں میراث نہیں ملی

216
00:16:03,123 --> 00:16:05,010
اور پھر حضرت ابو بکر صدیقؓ نے فرمایا؛

217
00:16:05,050 --> 00:16:09,369
لست تاركً شيئًا كان رسول الله صلى الله عليه وسلم يعمل به إلَّا عملتُ به

218
00:16:09,608 --> 00:16:12,039
فإنِّي أخش إن تركت شيعًا من أمره أنظير

219
00:16:12,363 --> 00:16:16,080
آپؓ نے فرمایا ؛ اور میں رسول اللہؐ کے کسی حکم کی خلاف ورزی نہیں کروں گا

220
00:16:16,116 --> 00:16:21,517
اور میں آپؐ کے نقشِ قدم پہ چلوں گا کیونکہ اگر میں ایسا نہیں کروں گا تو میں گمراہ ہو جاؤں گا

221
00:16:21,547 --> 00:16:23,320
القاضی ایازؒ فرماتے ہیں؛

222
00:16:23,361 --> 00:16:28,413
وفي تركي فاطمه منازعت أبي بكرٍ بعد إحتجاجه عليها بالحديث

223
00:16:28,996 --> 00:16:35,696
ألتسليم لالعجماع على قضية وانَّها لمَّا بلغها الحديث وبين لها تعويل تركت رائها

224
00:16:35,720 --> 00:16:41,217
ثم لم يكن منها ولا منزريتها بعد ذالك طلبٌ ميراث

225
00:16:41,424 --> 00:16:46,298
 ثم وليَّ عليٌ خلاف فلم يعدل بها عمَّا فعله ابوبکرو عمر رضی الله عنهم

226
00:16:46,608 --> 00:16:47,797
القاضی ایازؒ فرماتے ہیں؛

227
00:16:47,854 --> 00:16:54,123
 کہ حضرت فاطمہؓ نے جب حضرت ابوبکرؓ سے ترکے کے معاملے پر یہ حدیث سنی تو آپؓ نے کوئی اعتراض نہیں کیا اور انہوں نے اسے قبول کر لیا

228
00:16:54,172 --> 00:16:57,677
اور یہاں تک کہ بعد میں جب حضرت علی بن ابی طالبؓ خلیفہ بنے

229
00:16:57,722 --> 00:17:00,277
 آپؓ نے حضرت ابوبکرؓ کے فیصلے کو تبدیل نہیں کیا

230
00:17:00,314 --> 00:17:04,909
چنانچہ حضرت علی بن ابی طالبؓ بھی جو رسول اللہؐ کے خاندان کے فرد تھے

231
00:17:04,934 --> 00:17:13,770
آپؓ نے بھی حضرت ابوبکر صدیقؓ کے رسول اللہؐ کی وراثت کے حوالے سے فیصلے میں ترمیم نہیں کی،

232
00:17:13,826 --> 00:17:20,423
ہم اگلے موضوع کی طرف بڑھتے ہیں، اور وہ ہے حضرت اسامہؓ کا لشکر

233
00:17:20,483 --> 00:17:24,530
رسول اللہؐ کے وصال کے تین دن بعد

234
00:17:24,577 --> 00:17:28,090
اور حضرت ابوبکر صدیقؓ کی بطور خلیفہ تقرری کے بعد

235
00:17:28,127 --> 00:17:29,530
حضرت ابو بکرصدیقؓ نے فرمایا؛

236
00:17:29,575 --> 00:17:39,623
لِيُتِمَّا بعث أسامة على لا يبقين فى المدينة أحدٌ من جندٍي أسامه إلَّا خرج إلى عسکریہ بالجرف

237
00:17:40,067 --> 00:17:44,520
حضرت ابوبکر صدیقؓ نے فرمایا کہ حضرت اسامہؓ کا لشکر نکلے گا

238
00:17:44,554 --> 00:17:52,670
حضرت اسامہؓ کے لشکر میں سے کوئی بھی مدینہ میں نہ رہے، اور وہ سب الجرف کے مقام پہ پڑاؤ کریں

239
00:17:52,716 --> 00:17:54,917
پس منظر کا تھوڑا سا جائزہ لیتے ہیں

240
00:17:54,947 --> 00:18:08,547
آٹھ ہجری میں رسول اللہؐ نے پہلی بار رومیوں کا سامنا کرنے کے لیے ایک لشکر تعینات کیا

241
00:18:08,596 --> 00:18:17,130
اور رسول اللہؐ نے اپنے عزیز صحابی حضرت زید بن حارثہؓ کو اس لشکر کی قیادت سونپی

242
00:18:17,169 --> 00:18:23,023
  نائب سپہ سالار حضرت جعفر بن ابی طالبؓ تھے، جو آپؐ کے چچا زاد بھائی تھے

243
00:18:23,082 --> 00:18:28,223
لشکر کے تیسرے نامزد سپہ سالار حضرت عبداللہ بن رواحہؓ تھے جو ایک انصاری تھے

244
00:18:28,260 --> 00:18:33,930
 اسلامی لشکر کی تعداد تین ہزار تھی اور وہ شام کی طرف روانہ ہونے والے تھے

245
00:18:33,975 --> 00:18:37,510
یہ پہلا موقع تھا جب مسلمان رومیوں کا سامنا کرنے جا رہے تھے

246
00:18:37,552 --> 00:18:49,877
چنانچہ یہ لشکر نکلا اور اپنے سامنے تاحدِ نگاہ پھیلے لشکر کو دیکھ کر متعجب ہو گیا

247
00:18:49,916 --> 00:18:53,043
جہاں تک آپ کی نگاہ جاتی،سپاہی ہی سپاہی تھے

248
00:18:53,097 --> 00:18:59,407
وہ تین ہزار مجاہدین تھے جب کہ دشمن کے سپاہیوں کی تعداد دو لاکھ تھی

249
00:18:59,455 --> 00:19:03,997
صحابہ کرامؓ نے اپنی زندگی میں کبھی ایسا جمِ غفیر نہیں دیکھا

250
00:19:04,033 --> 00:19:10,837
آپ جانتے ہیں، عرب میں اتنی آبادی ہی نہیں تھی کہ آپ کے پاس دو لاکھ  سپاہیوں کا لشکر ہو

251
00:19:10,875 --> 00:19:14,697
عرب چھوٹے قبائل پر مشتمل کم گنجان آباد علاقہ تھا

252
00:19:14,724 --> 00:19:17,003
آپ کے پاس اتنی زیادہ تعداد نہیں ہو سکتی تھی

253
00:19:17,059 --> 00:19:24,277
چنانچہ صحابہ کرامؓ اب دو لاکھ کا لشکر دیکھ رہے تھے جو انہوں نے پہلے کبھی نہیں دیکھا تھا

254
00:19:24,329 --> 00:19:26,970
اور وہ صرف تین ہزار تھے

255
00:19:27,026 --> 00:19:29,830
چنانچہ مسلمانوں نے باہم مشاورت کی

256
00:19:29,898 --> 00:19:36,765
ان میں سے کچھ لوگوں کی رائے تھی کہ یہ دشمن کا لشکر تعداد میں زیادہ ہے تو ہم پسپا ہونے پہ مجبور ہیں

257
00:19:36,828 --> 00:19:41,290
اور ہم جانتے ہیں کہ قرآن میں یہ کہا گیا ہے کہ، اگر آپ مضبوط ہیں تو ایک شخص دس کا مقابلہ کرسکتا ہے

258
00:19:41,326 --> 00:19:45,763
اگر آپ کمزور ہیں تو ایک شخص دو کا مقابلہ کر سکتا ہے

259
00:19:45,820 --> 00:19:49,230
تو ان کے پاس ایک جواز تھا، انہیں واپس جانے کا حق حاصل تھا

260
00:19:49,274 --> 00:19:53,597
لیکن حضرت عبداللہ بن رواحہؓ نے فرمایا؛

261
00:19:53,638 --> 00:19:58,197
ہم یہاں شہادت کے جذبے سے سرشار ہو کر آئے ہیں تو واپس کیوں جائیں

262
00:19:58,239 --> 00:20:01,530
 جب ہمارا یہاں آنے کا مقصد ہی یہی ہے تو اب پیچھے کیوں ہٹیں؟

263
00:20:01,563 --> 00:20:06,403
ہم شہادت کی جستجو رکھتے ہیں تو ہم واپس کیوں جائیں؟

264
00:20:06,453 --> 00:20:08,590
چنانچہ انہوں نے آگے بڑھ کر مقابلہ کرنے کا فیصلہ کیا

265
00:20:08,628 --> 00:20:12,410
وہ پہلے دن، دوسرے دن، تیسرے دن لڑے

266
00:20:12,440 --> 00:20:15,010
حضرت زید بن حارثہؓ شہید ہوگئے

267
00:20:15,059 --> 00:20:17,103
تو کس نے لشکر کی قیادت سنبھالی؟

268
00:20:17,178 --> 00:20:18,154
حضرت جعفر بن ابی طالبؓ نے قیادت سنبھالی

269
00:20:18,231 --> 00:20:20,033
اور ہم اس کے بارے میں بات کر چکے ہیں اور پھر آپؓ شہید ہو گئے

270
00:20:20,058 --> 00:20:21,863
اور پھر حضرت عبداللہ بن رواحہؓ شہید ہو گئے

271
00:20:21,907 --> 00:20:25,383
یہ تینوں شہید ہوگئے اور پھر حضرت خالد بن ولیدؓ نے لشکرکی قیادت سنبھالی

272
00:20:25,408 --> 00:20:30,383
اور آپؓ اپنے لشکر کے ساتھ کامیاب و کامران ہو کر واپس لوٹے

273
00:20:30,451 --> 00:20:36,170
اگلے سال رسول اللہؐ اپنی قیادت میں لشکر لے کر نکلنا چاہتے تھے

274
00:20:36,242 --> 00:20:43,243
چنانچہ آپؐ نے غزوہ تبوک کے لیے لشکر تیار کیا

275
00:20:43,302 --> 00:20:46,663
وہ مہم کے لیے روانہ ہوئے اور رومیوں کو ان کا سامنا کرنے کی جرأت نہ ہوئی

276
00:20:46,709 --> 00:20:52,747
چنانچہ کوئی جنگ نہیں ہوئی اور رسول اللہؐ بغیر کسی نقصان کے واپس آئے

277
00:20:52,815 --> 00:20:54,433
 اور کوئی لڑائی نہیں ہوئی

278
00:20:54,485 --> 00:21:00,590
تیسرے سال رسول اللہؐ، حضرت اسامہ بن زیدؓ کی قیادت میں  ایک لشکر روانہ کرنا چاہتے تھے

279
00:21:00,646 --> 00:21:09,143
 اور آپؐ نے اُن سے فرمایا کہ میں چاہتا ہوں کہ تم جاؤ اور اپنے گھوڑوں کے ساتھ اُسی جگہ قدم رکھو جہاں تمہارا باپ شہید ہوا تھا

280
00:21:09,213 --> 00:21:12,155
چنانچہ رسول اللہؐ نے حضرت اسامہ بن زیدؓ کو لشکر کی قیادت کے لیے مقرر کیا

281
00:21:12,179 --> 00:21:18,543
اور آپؓ جا کر لڑیں اور اسی جگہ قدم رکھیں جہاں حضرت زید بن حارثہؓ شہید ہوئے تھے

282
00:21:18,616 --> 00:21:22,243
اس کے چند دن بعد رسول اللہؐ کا وصال ہوگیا

283
00:21:22,311 --> 00:21:30,490
چنانچہ اب تین سال سے رسول اللہؐ ایک منظم لشکرترتیب دے رہے تھے، تاکہ رومی سلطنت کو فتح کیا جا سکے

284
00:21:30,543 --> 00:21:37,193
غزوہ موتہ، غزوہ تبوک اور پھر تیسرے سال حضرت اسامہ بن زیدؓ کا لشکر

285
00:21:37,245 --> 00:21:43,257
جس طریقے سے وہ فوج کو منظم کرتے تھے کیونکہ ان کے پاس وردی والے سپاہی نہیں تھے وہاں پیشہ ور تربیت یافتہ فوج نہیں تھی

286
00:21:43,305 --> 00:21:49,323
میرا مطلب ہے کہ ہر صحابی کی جہاد میں شرکت متوقع تھی

287
00:21:49,375 --> 00:21:50,629
تو جو جنگی حکمتِ عملی وہ اختیار کرتے وہ یہ تھی کہ

288
00:21:50,653 --> 00:21:53,823
اُن کا پڑاؤ مدینہ سے باہر ایک میدان میں ہوتا

289
00:21:53,866 --> 00:22:00,077
اور پھر تمام سپاہی میدان میں جمع ہو جاتے جب تک کہ لشکر روانگی کے لیے تیار ہو جاتا اور پھر وہ مہم پر روانہ ہو جاتے

290
00:22:00,132 --> 00:22:02,290
چنانچہ یہ پڑاؤ الجرف کے مقام پرتھا

291
00:22:02,336 --> 00:22:05,783
رسول اللہؐ نے فوج کو حکم دیا کہ جاؤ اور الجرف میں پڑاؤ ڈالو

292
00:22:05,843 --> 00:22:08,757
کچھ لوگ ایک گھنٹہ میں تیار ہو سکتے تھے، کچھ لوگوں کو تیار ہونے میں دن لگ جاتے

293
00:22:08,814 --> 00:22:11,997
لہٰذا فوج کو مدینہ سے باہر قیام کرنا ہوتا تھا

294
00:22:12,059 --> 00:22:15,354
تاکہ فوج کا امیر باخبر رہے کہ لشکر کے سپاہیوں کی تعداد کتنی ہے

295
00:22:15,378 --> 00:22:20,413
اور انہیں مدینہ کے مکینوں سے الگ کرنا ناگزیر تھا

296
00:22:20,433 --> 00:22:25,720
جب رسول اللہؐ کا وصال ہوا تو تمام سپاہی جو الجرف میں تھے واپس مدینہ آگئے

297
00:22:25,753 --> 00:22:33,423
تین دن بعد حضرت ابوبکر صدیقؓ انہیں واپس جانے کا کہہ رہے تھے

298
00:22:33,469 --> 00:22:37,797
حضرت اسامہ بن زیدؓ نے حکم کی تعمیل کی اور آپؓ الجرف کی طرف چلے گئے، اور کچھ سپاہی آپؓ کے ساتھ چلے گئے

299
00:22:37,865 --> 00:22:41,003
لیکن اب صحابہ کرامؓ، حضرت ابوبکرؓ کے پاس آ رہے تھے

300
00:22:41,033 --> 00:22:46,190
اور صورت حال کا تصور کرنے کی کوشش کریں، یہ رسول اللہؐ کے وصال کے صرف تین دن بعد کے حالات تھے

301
00:22:46,231 --> 00:22:50,644
میرا مطلب ہے کہ وہ سب ابھی تک رسول اللہؐ کے وصال کے درد اور کرب سے گزر رہے تھے

302
00:22:50,715 --> 00:22:52,440
وہ اس درد ناک صورتحال سے نبردآزما تھے

303
00:22:52,492 --> 00:22:58,450
اورحضرت ابوبکر صدیقؓ ان سے کہہ رہے تھے کہ نکلو اور رومیوں سے لڑو

304
00:22:58,493 --> 00:23:01,500
چنانچہ وہ حضرت ابوبکر صدیقؓ کے پاس آئے

305
00:23:01,530 --> 00:23:06,410
اور ابن کثیرؒ بیان فرماتے ہیں، وہ کہتے ہیں کہ انہوں نے حضرت ابو بکرؓ سے کہا؛

306
00:23:06,450 --> 00:23:11,702
إن هؤلاء جل المسلمين، والعرب على ما ترى قد انتقضت بك

307
00:23:12,019 --> 00:23:16,077
فليس ينبغي لك أن تفرق عنك جماعة المسلمين

308
00:23:16,628 --> 00:23:20,870
کہنے لگے؛ اس لشکر میں مسلمانوں کی اکثریت ہے

309
00:23:20,916 --> 00:23:26,333
اور عرب آپؓ سے تمام معاہدے توڑ چکے ہیں

310
00:23:26,389 --> 00:23:33,757
اس لیے ہمارے خیال میں یہ آپؓ کے قطعی ناموزوں ہوگا کہ مسلمانوں کی جماعت کو مختلف سمتوں میں بھیجا جائے

311
00:23:33,808 --> 00:23:38,230
صحابہ نے کہا؛ یہ لشکر مسلمانوں کی جماعت ہے اور اب آپؓ انہیں باہر بھیجنے جا رہے ہیں

312
00:23:38,287 --> 00:23:43,337
جب کہ ہمارے اردگرد کے تمام عرب قبائل ہم پر حملہ آور ہونے کا سوچ رہے ہیں

313
00:23:43,385 --> 00:23:46,797
اور یہ بحث و مباحثہ جاری تھا

314
00:23:46,830 --> 00:23:49,552
انہوں نے دوبارہ خلیفہ کو قائل کرنے کی کوشش کی

315
00:23:49,576 --> 00:23:54,180
 اور ان میں سب سے زیادہ صاف گو اور بےباک حضرت عمر بن خطابؓ تھے

316
00:23:54,207 --> 00:23:57,057
 آپؓ نے خلیفہ سے فرمایا؛

317
00:23:57,098 --> 00:23:58,040
إن معي

318
00:23:58,162 --> 00:24:02,372
اور حضرت عمر بن خطابؓ وہاں حضرت اسامہ بن زیدؓ کا پیغام لے کر آئے تھے

319
00:24:02,447 --> 00:24:05,680
کیونکہ حضرت اسامہ بن زیدؓ وہاں موجود نہیں تھے، وہ الجرف میں تھے

320
00:24:05,733 --> 00:24:10,677
چنانچہ حضرت اسامہؓ نے حضرت عمر بن خطابؓ سے فرمایا کی آپؓ خلیفہ کے پاس جائیں، اور میرا پیغام آپؓ تک پہنچائیں،

321
00:24:10,737 --> 00:24:11,199
 آپؓ نے فرمایا؛

322
00:24:11,229 --> 00:24:17,704
إن معي وجوه المسلمين وجلتهم ولا آمن على خليفة رسول الله

323
00:24:17,998 --> 00:24:22,723
وحرم رسول اللہ والمسلمین أن يتخطفهم المشركون

324
00:24:23,781 --> 00:24:30,477
حضرت اُسامہؓ نے فرمایا ؛ میرے پاس لشکر میں مسلمانوں کی قیادت اور ان کے مردوں کی اکثریت ہے

325
00:24:30,544 --> 00:24:34,283
اور میں رسول اللہؐ کے خلیفہ کو محفوظ نہیں سمجھتا

326
00:24:34,321 --> 00:24:38,270
اور آل رسول اللہؐ کو مشرکین سے غیرمحفوظ سمجھتا ہوں

327
00:24:38,311 --> 00:24:39,626
حضرت اسامہ بن زیدؓ نے فرمایا؛

328
00:24:39,690 --> 00:24:45,700
 میرے اس لشکر میں مسلم جمیعت کی بیشتر قیادت موجود ہے اور اس میں مجاہدین ہیں

329
00:24:45,741 --> 00:24:51,817
اور مجھے اندیشہ ہے کہ مشرکین خلیفہ پر حملہ آور ہوں گے، اور رسول اللہؐ کی آل کو بھی خطرہ ہے

330
00:24:51,873 --> 00:25:01,067
اب صحابہ کرامؓ ، آلِ رسول اللہؐ کی حفاظت کی ذمہ داری کا بوجھ محسوس کر رہے تھے

331
00:25:01,102 --> 00:25:08,637
رسول اللہؐ کے وصال کے بعد ازواج مطہرات کی حفاظت صحابہ کی ذمہ داری تھی

332
00:25:08,682 --> 00:25:13,960
چنانچہ حضرت اسامہ بن زیدؓ، حضرت ابوبکرؓ سے فرما رہے تھے، اور یہ تمام صحابہ کی رائے بھی تھی کہ

333
00:25:14,034 --> 00:25:19,417
اب ہماری ترجیح خلیفہ کی حفاظت کرنا، اور رسول اللہؐ کی ازواج کی حفاظت کرنا ہے

334
00:25:19,458 --> 00:25:22,800
اور اسلام کے قلعے، اسلام کے شہر مدینہ کی حفاظت کرنا ہے

335
00:25:22,870 --> 00:25:27,580
کیونکہ ہمارے چاروں طرف مرتدین حرکت میں ہیں

336
00:25:27,624 --> 00:25:32,283
مسلمانوں کا صدرِمقام مدینہ ہے اور یہیں فوج کو ٹھہرنا چاہیے

337
00:25:32,327 --> 00:25:35,210
اور یہ ایک مضبوط جواز تھا اور یہ واضح دلائل پرمبنی تھا

338
00:25:35,242 --> 00:25:40,343
اب ہماری ترجیح رومی سلطنت سے لڑنا کیوں ہے؟

339
00:25:40,382 --> 00:25:44,197
  جو اس بحرانی کیفیت میں کوئی نمایاں خطرہ نہیں تھی

340
00:25:44,242 --> 00:25:50,423
 اور مدینہ چھوڑ دینا جہاں شب وروز میں کسی بھی وقت گھات لگا کر حملہ ہوسکتا تھا

341
00:25:50,485 --> 00:25:55,963
حضرت ابوبکر صدیقؓ نے تمام مختلف آراء سننے کے بعد

342
00:25:56,000 --> 00:26:00,303
اور صحابہ کرامؓ بالخصوص حضرت عمرؓ کے نفسیاتی دباؤ کے بعد

343
00:26:00,343 --> 00:26:07,597
 حتیٰ کہ روانہ ہونے والے لشکر کے سپہ سالار حضرت اسامہ بن زیدؓ کا بھی یہی خیال تھا کہ انھیں مدینہ کو غیر محفوظ چھوڑ کر باہر نہیں جانا چاہئے

344
00:26:07,622 --> 00:26:10,656
 حضرت ابوبکر صدیقؓ نے تمام مسلمانوں کو مسجد میں جمع فرمایا

345
00:26:10,697 --> 00:26:16,197
 اور آپؓ کھڑے ہوئے اور آپؓ نے مندرجہ ذیل بہت ہی مختصر خطبہ دیا، آپؓ نے فرمایا؛

346
00:26:16,254 --> 00:26:24,599
والذي نفس أبي بكر بيده، لو ظننت أن السباع تخطفني لأنفذت بعث أسامة

347
00:26:24,986 --> 00:26:32,057
كما أمر به رسول الله صلى الله عليه وسلم، ولو لم يبق في القرى غيري لأنفذته

348
00:26:32,739 --> 00:26:36,807
آپؓ نے فرمایا ؛ اس ذات کی قسم جس کے ہاتھ میں ابوبکر کی جان ہے

349
00:26:36,832 --> 00:26:41,157
  حتیٰ کہ اگر میں یہ سوچوں کہ شکاری درندے مجھے جھپٹ لیں گے

350
00:26:41,195 --> 00:26:44,377
پھر بھی میں اسامہؓ کا لشکر روانہ کروں گا

351
00:26:44,427 --> 00:26:47,290
جیسا کہ رسول اللہؐ کا حکم تھا

352
00:26:47,339 --> 00:26:52,810
آپؓ نے فرمایا اگر مدینہ میں میرے علاوہ کوئی بھی نہ رہے تب بھی میں لشکر روانہ کروں گا

353
00:26:52,870 --> 00:26:56,149
حضرت ابوبکر صدیقؓ نے تمام دلائل کو بالائے طاق رکھا

354
00:26:56,226 --> 00:27:00,390
 آپؓ فرما رہے تھے کہ اگر دشمن مدینہ پر چڑھائی کر کے قبضہ کر لیں

355
00:27:00,435 --> 00:27:04,523
اگر وہ پورے علاقے کو تہہ وبالا کرنے میں کامیاب ہو جائیں

356
00:27:04,555 --> 00:27:08,347
اور میرے سوا کوئی باقی نہ بچے اور میں اکیلا ہی رہ جاؤں

357
00:27:08,410 --> 00:27:12,770
میں تب بھی اس لشکر کو روانہ کروں گا

358
00:27:12,818 --> 00:27:16,790
حضرت ابوبکر صدیقؓ یہاں جنگی حکمت عملی کی بات نہیں کر رہے تھے

359
00:27:16,815 --> 00:27:20,923
آپؓ یہ بھی نہیں فرما رہے تھے کہ کیا زیادہ فائدہ مند ہے؟

360
00:27:20,993 --> 00:27:24,250
حضرت ابوبکرصدیقؓ فرما رہے تھے کہ سنتِ رسولؐ کیا ہے؟

361
00:27:24,290 --> 00:27:26,563
رسول اللہؐ کی اطاعت کیا ہے؟

362
00:27:26,609 --> 00:27:29,625
إِنَّمَا أَنَا مُتَّبِعٌ وَلَسْتُ بِمُبْتَدِعٍ،

363
00:27:30,232 --> 00:27:35,430
آپؓ نے فرمایا ؛ میں رسول اللہؐ کی سنت کی اطباع کرنے والا ہوں اور میں بدعتی نہیں ہوں

364
00:27:35,497 --> 00:27:45,423
 آپؓ واضح فرما رہے تھے کہ آپؓ کا طرزِ حکمرانی، آپؓ کا اصولِ خلافت رسول اللہؐ کے نقش قدم پر چلنا ہے، چاہے کچھ بھی ہو جائے

365
00:27:45,473 --> 00:27:49,303
اس کا مطلب ہے چاہے سارا اسلامی معاشرہ تہہ و بالا ہو جائے

366
00:27:49,340 --> 00:27:52,237
میں پھر بھی رسول اللہؐ کے طریقے پر چلوں گا

367
00:27:52,298 --> 00:27:56,517
آپؓ نے فرمایا؛ یہاں تک کہ اگر میں پیچھے رہ جانے والا واحد شخص کیوں نہ ہوں

368
00:27:56,547 --> 00:28:01,330
اور یہ ایک نہایت کٹھن موقف تھا

369
00:28:01,387 --> 00:28:06,299
اور سامعین آپ اس وقت صحابہ کرامؓ کی ذہنی حالت کے متعلق سوچیں

370
00:28:06,386 --> 00:28:07,943
رسول اللہؐ کا وصال حال ہی میں ہوا ہے

371
00:28:08,005 --> 00:28:12,266
 میرا مطلب ہے کہ حضرت عائشہؓ کی کیفیت کی اندازہ لگائیں

372
00:28:12,306 --> 00:28:12,868
  آپؓ فرماتی ہیں؛

373
00:28:12,958 --> 00:28:16,413
لما قبض رسول الله صلى الله عليه وسلم ارتدت العرب قاطبة!

374
00:28:16,747 --> 00:28:22,320
واشرأب النفاق والله قد نزل بي ما لو نزل بالجبال الرَّاسيات لهاضها

375
00:28:22,671 --> 00:28:25,917
وصار أصحاب محمَّد كأنَّهم مِعْزَى مطيرة

376
00:28:26,089 --> 00:28:29,520
في حشٍّ في ليلةٍ مطيرةٍ بأرض مسبعةٍ

377
00:28:29,884 --> 00:28:31,360
حضرت عائشہؓ نے فرمایا؛

378
00:28:31,461 --> 00:28:36,583
جب رسول اللہؐ کا وصال ہوا تو تمام عرب مرتد ہو گئے

379
00:28:36,622 --> 00:28:41,190
اور منافقین کی سازشیں سر اُٹھانے لگیں

380
00:28:41,223 --> 00:28:49,310
اللہ کی قسم! میرے والد جو بارِگراں(بھاری بوجھ) اٹھائے ہوئے تھے اگر اسے پہاڑوں پر رکھ دیا جاتا تو وہ بھی ریزہ ریزہ ہو جاتے

381
00:28:49,370 --> 00:28:56,117
اور رسول اللہؐ کے صحابہ طوفانی سرد رات میں بچھڑ جانے والی بکریوں کی مانند منتشر ہو گئے

382
00:28:56,197 --> 00:29:00,063
 جو اندرون خانہ بھیڑیا صفت سازشی لوگوں کا شکار تھے

383
00:29:00,096 --> 00:29:03,603
آپؓ نے فرمایا کہ رسول اللہؐ کے صحابہ کرام، بکریوں کے منتشر ریوڑ کی طرح ہو گئے

384
00:29:03,640 --> 00:29:05,637
کیونکہ نگہبان(چرواہے) کا وصال ہو چکا تھا

385
00:29:05,667 --> 00:29:14,417
وہ تاریک طوفانی رات میں بکھری بکریوں کی طرح تھے اور علاقے میں بھیڑیے کثرت سے تھے

386
00:29:14,463 --> 00:29:18,450
یہ صحابہ کرام کی صدماتی کیفیت سے متعلق حضرت عائشہؓ کا بیان ہے؛

387
00:29:18,499 --> 00:29:22,607
 خوف تھا، مشکلات درپیش تھیں، ہر طرف دشمن تھے

388
00:29:22,645 --> 00:29:25,877
اور حضرت ابوبکرؓ فرما رہے تھے؛ مجھے اس کی کوئی پرواہ نہیں

389
00:29:25,931 --> 00:29:29,817
میں رسول اللہؐ کے طریقے پر چلنے والا ہوں اور تم سب کو میری پیروی کرنی پڑے گی

390
00:29:29,862 --> 00:29:31,896
ابن حجر عسقلانیؒ فرماتے ہیں،کہ

391
00:29:31,926 --> 00:29:38,020
 حضرت ابوبکرؓ کی فقہ سے یہ ظاہر ہوتا ہے کہ کئی صورتحال میں اکثریت کی رائے غلط ہوسکتی ہے

392
00:29:38,066 --> 00:29:41,863
 کبھی کبھی صرف فردِ واحد کی تجویز بھی بہترین ہو سکتی ہے

393
00:29:41,911 --> 00:29:46,643
 صحابہ کی اکثریت حضرت ابوبکر صدیقؓ کے فیصلے کے خلاف تھی

394
00:29:46,684 --> 00:29:48,780
لیکن آپؓ کا فیصلہ درست تھا

395
00:29:48,825 --> 00:29:55,977
جیسا کہ قرطبیؒ فرماتے ہیں کہ آپؓ رسول اللہؐ کے تمام صحابہ میں سب سے بہترین رائے رکھنے والے تھے

396
00:29:56,023 --> 00:30:00,450
اس لیے کہ آپؓ کا رسول اللہؐ کے ساتھ بہت وقت گزرا

397
00:30:00,492 --> 00:30:06,643
اور نبوت کے چشمے سے سیراب ہوئے جیسا کہ میں آپ کو بتا چکا ہوں

398
00:30:06,729 --> 00:30:09,007
اور یہ یقین کا مقام ہے

399
00:30:09,049 --> 00:30:13,603
جب تک آپ کے پاس یقینِ کامل نہ ہو تو آپ برمحل رویہ اختیار نہیں کرسکتے

400
00:30:13,641 --> 00:30:16,568
میرا مطلب ہے کہ یہ ایسی چیز ہے جو ذہانت پر مبنی نہیں ہے

401
00:30:16,602 --> 00:30:19,330
اور یہ وہ چیز ہے جو ایمان پر مبنی ہے

402
00:30:19,390 --> 00:30:21,877
 آپ کا ایمان کتنا کامل ہے

403
00:30:21,923 --> 00:30:24,903
جیسا کہ جو کیفیت حضرت موسیٰ علیہ السلام کی تھی

404
00:30:24,937 --> 00:30:29,970
جب آپؑ کے سامنے سمندر تھا اور فرعون کا لشکر آپؑ کے تعاقب میں تھا

405
00:30:30,026 --> 00:30:34,330
 آپؑ نے بنی اسرائیل سے فرمایا کہ اللہ ہمیں فتح دے گا، اللہ ہماری حفاظت فرمائے گا

406
00:30:34,375 --> 00:30:39,017
لیکن اب حقیقی دنیا آپ کو متنازع اور شک میں مبتلا کر رہی ہے،

407
00:30:39,079 --> 00:30:43,963
 آپؑ کی آنکھیں احساس دلا رہی تھیں کہ فوج آپ کے پیچھے ہے اور سمندر آپ کے سامنے ہے

408
00:30:44,007 --> 00:30:47,970
اور آپؑ کے کان بنی اسرائیل کے شکوے شکایات کے سوا کچھ نہیں سن پا رہے

409
00:30:48,029 --> 00:30:51,720
آپؑ نے ہم سے جھوٹ بولا، آپؑ نے ہم سے وعدہ کیا کہ ہم بچ جائیں گے

410
00:30:51,745 --> 00:30:54,272
اور فرعون کا لشکر ہمارے پیچھے ہے

411
00:30:54,296 --> 00:30:57,138
اور آپ گردوپیش کے لوگوں کی آراء سے متاثر ہوتے ہیں

412
00:30:57,162 --> 00:31:00,577
خاص طور پر جب آپ بار بار ایک ہی بات سن رہے ہوں

413
00:31:00,637 --> 00:31:06,363
 جیسے ہٹلر کے وزیر اطلاعات کہتا تھا؛ ہم جھوٹ بولتے رہیں گے، حتیٰ کہ عوام یقین کر لے

414
00:31:06,398 --> 00:31:10,623
آپ جھوٹ دہراتے رہیں اور آخر میں لوگ اسے قبول کرلیں گے

415
00:31:10,658 --> 00:31:14,203
لیکن حضرت موسیٰ نے اپنے یقین کی بناء پر فرمایا؛

416
00:31:14,228 --> 00:31:16,813
كَلا إِنَّ مَعِيَ رَبِّي سَيَهْدِينِ

417
00:31:16,918 --> 00:31:20,180
نہیں! اللہ میرے ساتھ ہے اور وہی میری رہنمائی کرے گا

418
00:31:20,220 --> 00:31:23,180
 مجھے اپنی بصارت پر یقین نہیں ہے، مجھے اپنی سماعت پر بھروسہ نہیں ہے

419
00:31:23,210 --> 00:31:26,727
اللہ نے مجھ سے وعدہ فرمایا ہے اور یہ ضرور پورا ہو گا

420
00:31:26,757 --> 00:31:32,090
اور یہ اللہ عَزَّوَجَلْ کی طرف سے ایک آزمائش تھی اور پھر اللہ نے آپؑ سے فرمایا کہ اپنے عصا(چھڑی) سے سمندر کو ضرب لگاؤ اور اللہ نے انہیں بچا لیا

421
00:31:32,142 --> 00:31:36,430
یا پھر رسول اللہؐ جیسا طرزِِعمل رکھنا کہ جب کسی شخص نے آ کر آپؐ سےعرض کی کہ اس کا بھائی بیمار ہے

422
00:31:36,484 --> 00:31:39,597
رسول اللہؐ نے فرمایا؛ اسے(مریض کو) شہد دو

423
00:31:39,646 --> 00:31:42,760
وہ شخص پھر حاضر ہوا اور کہنے لگا مریض کو افاقہ نہیں ہوا

424
00:31:42,785 --> 00:31:44,583
رسول اللہؐ نے فرمایا؛ اسے شہد کھلاؤ

425
00:31:44,624 --> 00:31:48,000
پھر وہ شخص تیسری بار واپس آیا اور عرض کی؛ میرا بھائی شفایاب نہیں ہوا

426
00:31:48,035 --> 00:31:49,850
آپؐ نے فرمایا ؛ اسے شہد کھلاؤ

427
00:31:49,889 --> 00:31:54,017
چوتھی بار پھر وہ شخص واپس آیا اور کہنے لگا کہ میرا بھائی صحت یاب نہیں ہوا

428
00:31:54,054 --> 00:32:00,677
رسول اللہ نے فرمایا کہ اللہ سچ فرما رہا ہے، اور تمہارے بھائی کا معدہ جھوٹ بول رہا ہے

429
00:32:00,717 --> 00:32:02,140
اللہ کا فرمان سچا ہے

430
00:32:02,226 --> 00:32:03,670
اللہ جو فرماتا ہے وہ حق پر مبنی ہے

431
00:32:03,699 --> 00:32:08,643
اللہ تعالیٰ نے شہد کو شفاء قرار دیا ہے، تو یہ شفاء ہے

432
00:32:08,689 --> 00:32:12,577
تمہارے بھائی کا معدہ جھوٹ بول رہا ہے

433
00:32:12,621 --> 00:32:14,599
ابن القیمؒ اس حدیث کی وضاحت کرتے ہوئے فرماتے ہیں؛

434
00:32:14,624 --> 00:32:19,557
یہاں مسئلہ یہ ہے کہ اس نے اپنے بھائی کو دوا کی مناسب خوراک نہیں دی تھی

435
00:32:19,614 --> 00:32:22,317
اس نے بھائی کو دوا کی معقول مقدار نہیں دی تھی

436
00:32:22,372 --> 00:32:27,627
پس اگر آپ اللہ عَزَّوَجَلْ پہ یقین رکھتے ہیں اور آپ اس پر ایمان رکھتے ہیں جس کا اللہ تبارک و تعالٰی نے وعدہ فرمایا ہے

437
00:32:27,657 --> 00:32:29,730
حضرت ابوبکر صدیقؓ فرما رہے تھے؛

438
00:32:29,785 --> 00:32:33,043
میں رسول اللہؐ کے نقشِ قدم کی پیروی کرنے والا ہوں

439
00:32:33,078 --> 00:32:38,817
یاد رہے کہ حضرت ابوبکرؓ یہاں خلافت کے بنیادی اصول وضع فرما رہے تھے

440
00:32:38,861 --> 00:32:42,950
خلیفہ کو نبیؐ کے نقش قدم پر چلنا چاہیے

441
00:32:42,999 --> 00:32:45,517
إِنَّمَا أَنَا مُتَّبِعٌ وَلَسْتُ بِمُبْتَدِعٍ،

442
00:32:45,806 --> 00:32:48,880
میں ایک پیروکار ہوں اور میں اختراعی(مذہبی امور میں بدعات شامل کرنے والا) نہیں ہوں

443
00:32:48,909 --> 00:32:55,880
جب یہ سب کچھ ہوا تو انصار نے حضرت عمرؓ سے کہا کہ واپس جا کر خلیفہ کو بتا دیں کہ

444
00:32:55,912 --> 00:33:01,967
اگر وہ لشکر کو مدینہ میں رکھنے پر رضامند نہیں ہیں، پھر کم از کم کسی ایسے شخص کو سپہ سالار مقرر کریں جو عمررسیدہ، تجربہ کار ہو

445
00:33:02,004 --> 00:33:06,940
 حضرت اسامہ بن زیدؓ کی عمر اٹھارہ برس تھی اور اب صورتحال بہت نازک تھی

446
00:33:06,988 --> 00:33:12,057
ہم چاہتے ہیں کہ کوئی ایسا شخص ہو جو پختہ زہن کا مالک ہو اور زیادہ دانش مند ہو جس کی عمر زیادہ ہو

447
00:33:12,087 --> 00:33:18,537
 اب اس سے قبل بھی جب حضرت اسامہؓ کی قیادت کے متعلق چہ مگوئیاں ہو رہی تھیں، اور رسول اللہؐ نے فرمایا؛

448
00:33:18,583 --> 00:33:23,837
اگر آپ حضرت اسامہؓ کی قیادت پرسوال اُٹھا رہے ہیں

449
00:33:23,871 --> 00:33:27,763
تو آپ نے پہلے اُن کے والد(حضرت زید بن حارثہؓ) کے بارے میں بھی یہی کہا تھا

450
00:33:27,814 --> 00:33:33,197
اور اُن کے والد اس عہدے کے لیے موزوں تھے

451
00:33:33,235 --> 00:33:36,997
آپؐ نے فرمایا اور مجھے ان کے والد محبوب ہیں اور میں ان کے بیٹے سے بھی محبت کرتا ہوں

452
00:33:37,050 --> 00:33:40,737
چنانچہ حضرت عمر بن خطابؓ، حضرت ابوبکرؓ کے پاس گئے اور فرمایا؛

453
00:33:40,768 --> 00:33:44,517
کیا آپ سپہ سالار کے عہدے پر کسی ایسے شخص کو مقرر کرنے پر غور کریں گے جو پختہ عمر ہو؟

454
00:33:44,568 --> 00:33:48,882
حضرت ابوبکر صدیقؓ غصے سے اٹھے اور فرمایا؛

455
00:33:48,907 --> 00:33:57,850
ثكلتك أمك وعدمتك يا ابن الخطاب، استعمله رسول الله وتأمرني أن أنزِعَه

456
00:33:58,760 --> 00:34:00,383
اس پر حضرت ابوبکرؓ طیش میں اٹھے اور فرمایا؛

457
00:34:00,450 --> 00:34:04,917
اے ابن خطابؓ آپ اپنی والدہ کو نصیب نہ ہوں اور وہ آپ سے محروم رہیں

458
00:34:04,969 --> 00:34:09,883
رسول اللہؐ نے حضرت اسامہؓ کو سپہ سالار مقرر کیا اور آپ مجھے حکم دے رہے ہیں کہ میں انھیں برطرف کردوں

459
00:34:09,921 --> 00:34:13,380
رسول اللہؐ نے ہی حضرت اسامہؓ کو قیادت سونپی تھی، آپ چاہتے ہیں کہ میں انھیں برطرف کردوں

460
00:34:13,415 --> 00:34:15,227
چنانچہ آپؓ نے حضرت اسامہؓ کو لشکر کی قیادت سے معزول کرنے سے انکار کر دیا

461
00:34:15,270 --> 00:34:19,677
اور اس کے بعد آپؓ نے اپنے أمراء(عہدے داروں) میں سے کسی کو بھی معزول یا برطرف کرنے سے انکار کر دیا جیسا کہ ہم نے پہلے ذکر کیا ہے

462
00:34:19,725 --> 00:34:27,723
چنانچہ اب جب الجرف کے خیموں میں لشکر مکمل ہوگیا، اور مہم پر روانہ ہونے کے لئے تیار ہو گیا، اس کر بعد أپؓ

463
00:34:27,763 --> 00:34:32,680
حضرت ابوبکر صدیقؓ اپنے اونٹ پر سوار تھے

464
00:34:32,715 --> 00:34:37,700
اور حضرت عبدالرحمٰن بن عوفؓ، آپؓ کی اونٹنی کی مہار تھامے چل رہے تھے

465
00:34:37,725 --> 00:34:43,067
چنانچہ وہ مدینہ سے باہر "تشيع ألجيش" نامی مقام پر پہنچے

466
00:34:43,110 --> 00:34:45,220
فوج کو رخصت کرتے ہوئے

467
00:34:45,283 --> 00:34:49,477
رسول اللہؐ بھی یہی طرزِ عمل اختیار فرماتے،آپؐ لشکر کے ساتھ چلتے، یہاں تک کہ وہ روانہ ہوجائے

468
00:34:49,514 --> 00:34:52,117
اور پھر آپؐ انہیں الوداع فرماتے

469
00:34:52,157 --> 00:34:54,757
تو حضرت ابوبکرؓ بھی اسی سنت پر عمل پیرا ہوئے

470
00:34:54,788 --> 00:35:02,450
تو حضرت ابوبکرؓ چل رہے تھے اور اٹھارہ سالہ حضرت اسامہ بن زیدؓ اپنے اونٹ پر سوار تھے

471
00:35:02,494 --> 00:35:08,770
اور آپ جانتے ہیں، حدِ ادب کے پیشِ نظر آپ اپنے اونٹ سے نیچے اُتر آئیں، اور اونٹ پر سوار بڑی عُمر کا شخص ہونا چاہیے

472
00:35:08,837 --> 00:35:14,657
ليس منا من لم يعقر كبيرنا ويعطف على صغيرنا

473
00:35:14,917 --> 00:35:19,103
حدیثِ مبارکہ ہے" جو بڑوں کا احترام نہیں کرتا وہ ہم میں سے نہیں"

474
00:35:19,141 --> 00:35:24,157
"اور جو ہمارے چھوٹوں( بچوں) پر رحم نہیں کرتا وہ ہم میں سے نہیں ہے"

475
00:35:24,203 --> 00:35:27,837
چنانچہ حضرت اسامہ بن زیدؓ اپنے اونٹ سے نیچے اترنا چاہتے تھے

476
00:35:27,899 --> 00:35:33,327
اور آپؓ حضرت ابوبکرؓ سے فرمانے لگے کہ میں نیچے اُترتا ہوں اور آپؓ اونٹ پر سوار ہو جائیں

477
00:35:33,369 --> 00:35:42,497
حضرت ابوبکرصدیقؓ نے فرمایا؛ میں چاہتا ہوں کہ اللہ کے راستے میں میرے پاؤں گرد آلود ہوں

478
00:35:42,559 --> 00:35:45,243
کیونکہ رسول اللہؐ کا فرمان ہے کہ؛

479
00:35:45,296 --> 00:35:56,030
جس شخص کے پاؤں فی سبیل اللہ یعنی اللہ کی راہ میں چلتے ہوئے غبار آلود ہوئے وہ جہنم کی آگ سے آزاد ہوجائے گا

480
00:35:56,083 --> 00:36:03,283
چنانچہ حضرت ابوبکر صدیقؓ مٹی پر، ریت پر چل کر اپنے پاؤں گرد آلود کرنا چاہتے تھے

481
00:36:03,333 --> 00:36:07,209
تاکہ آپؓ اللہ کی راہ میں کم از کم چند قدم تو چلیں

482
00:36:07,233 --> 00:36:12,040
اگر آپؓ، لشکر کے ہمراہ مہم پر نہیں جا رہے تو کم از کم آپؓ کے پاس چند قدم اللہ کے رستے میں تو ہوں گے

483
00:36:12,096 --> 00:36:17,157
اور پھر آپؓ نے فوج سے خطاب کیا

484
00:36:17,191 --> 00:36:22,423
جب جنگی معاملات کی بات آتی ہے تو یہ مسلم آئین کی طرح ہیں

485
00:36:22,507 --> 00:36:27,337
اسلام میں جنگ کے اصول و ضوابط؛

486
00:36:27,375 --> 00:36:33,879
لا تخونُوا، ولا تَغُلُّوا، ولا تغدرو، ولا تُمثِّلوا، ولا تقتُلُوا طفلاً صغیراً،

487
00:36:34,039 --> 00:36:40,325
ولا شيخاً، ولا امرأة، ولا تَعْقِروا نخلاً ولا تُحْرِقُوه، ولا تَقْطَعوا شَجَرَةً مُثْمِرَةً،

488
00:36:40,607 --> 00:36:44,332
ولا تَذْبَحُوا شاةً ولا بقرةً ولا بعيراً إلا لَمأكَلَةٍ

489
00:36:44,965 --> 00:36:48,658
وسوفَ تمرُّونَ بأقوامٍ قد فرَّغُوا أنفسَهم في الصَّوامعِ

490
00:36:49,038 --> 00:36:51,595
فدعوهمْ وما فرّغُوا أنفسَهم له

491
00:36:52,042 --> 00:37:00,330
وسوف تَقْدَمُون على أتَقْدَمُون على قوم یاتونکم بآنیۃ فیھا الوان الطعام فاذا اکلتم منھا شیئا فاذکرو اسم اللہ علیھا

492
00:37:02,105 --> 00:37:09,030
اے میرے لشکر؛ رُکو، اور میں تمہیں دس چیزوں کا حکم دوں گا، وہ زہن نشین کرلو

493
00:37:09,070 --> 00:37:11,677
تم کبھی خیانت کے مرتکب نہ ہونا

494
00:37:11,714 --> 00:37:14,217
مالِ غنیمت چوری نہ کرنا

495
00:37:14,265 --> 00:37:16,463
آپ کبھی بے ایمانی مت کرنا

496
00:37:16,505 --> 00:37:19,123
 آپ کبھی دغابازی نہ کرنا

497
00:37:19,180 --> 00:37:21,483
آپ کبھی دشمن کو زیر کرنے کے بعد اُن کے جسموں کی تذلیل نہ کرنا

498
00:37:21,527 --> 00:37:26,517
تم جنگ میں کسی بچے ، کسی بزرگ اور کسی عورت کو قتل نہ کرنا

499
00:37:26,554 --> 00:37:29,570
تم کبھی کھجور کے درختوں کو نہ گرانا اور نہ جلانا

500
00:37:29,615 --> 00:37:32,650
تم کبھی پھل دار درخت کو نہ کاٹنا

501
00:37:32,697 --> 00:37:37,583
تم کسی بھیڑ یا گائے یا اونٹ کو کھانے کے علاوہ کبھی ذبح مت کرنا

502
00:37:37,656 --> 00:37:43,023
آپ ایسے لوگوں کے پاس سے گزریں گے جو خانقاہوں میں مقیم ہوں گے

503
00:37:43,063 --> 00:37:48,077
 انھیں اکیلا چھوڑ دینا اور ان کو اسی کیفیت میں تنہا چھوڑ دینا جس میں وہ مصروفِ عمل ہوں

504
00:37:48,123 --> 00:37:52,637
 آپ ایسی قوم کے پاس جا رہے ہیں جو آپ کے لیے ایسے برتن لائیں گے جن میں انواع و اقسام کے پکوان ہوں گے

505
00:37:52,672 --> 00:37:58,727
اگر آپ ان پکوانوں میں سے کچھ کھائیں تو ان پر اللہ کے نام کا زکر کریں

506
00:37:58,766 --> 00:38:05,810
یہ وہ نصیحانہ الفاظ تھے جوحضرت ابوبکرؓ نے اپنے لشکر سے فرمائے

507
00:38:05,856 --> 00:38:10,773
یہاں چند بیانات ہیں جس کی میں تشریح کرنا ضروری سمجھتا ہوں

508
00:38:10,806 --> 00:38:11,794
حضرت ابوبکر صدیقؓ نے فرمایا؛

509
00:38:11,819 --> 00:38:15,197
آپ کو خیانت یا دھوکہ دہی میں ملوث نہیں ہونا چاہئے

510
00:38:15,227 --> 00:38:17,435
جب کہ ہم جانتے ہیں کہ رسول اللہؐ نے ایک حدیث میں فرمایا

511
00:38:17,460 --> 00:38:18,600
ألحرب خدعا

512
00:38:18,931 --> 00:38:23,310
میں ان تضادات کو سامنے لاؤں گا اور پھر ان پر تبصرہ کروں گا

513
00:38:23,373 --> 00:38:27,170
حضرت ابوبکرؓ فرما رہے ہیں کہ دھوکے بازی مت کرو

514
00:38:27,230 --> 00:38:31,283
اور رسول اللہؐ نے حدیث میں فرمایا ہے کہ جنگ فریب ہے

515
00:38:31,317 --> 00:38:37,470
حضرت ابوبکر صدیقؓ نے فرمایا؛ نہ کسی چھوٹے بچے کو، نہ بوڑھے کو اور نہ کسی عورت کو قتل کرو

516
00:38:37,523 --> 00:38:40,549
لیکن کوئی آکر کہہ سکتا ہے کہ ہمیں کم از کم دو معاملات کا علم ہے

517
00:38:40,570 --> 00:38:45,553
جہاں رسول اللہؐ نے عورت کو قتل کرنے کا حکم دیا ہے

518
00:38:45,584 --> 00:38:49,837
اور ہم جانتے ہیں کہ رسول اللہؐ نے عملی طور پر یا کم از کم آپؐ نے لشکر بھیجا

519
00:38:49,876 --> 00:38:54,910
جنہوں نے" تبیت" کے انداز میں جنگ کی اور جس میں رات کو دشمن پر اس کی رہائش گاہ پر حملہ کیا جاتا ہے

520
00:38:54,954 --> 00:39:02,967
 اور جہاں نہ چاہتے ہوئے کچھ بے گناہ لوگ عورتیں، بچے، بوڑھے بھی مارے جاتے ہیں

521
00:39:02,998 --> 00:39:06,737
اور پھر آپ کے پاس حضرت ابوبکر صدیقؓ کا بیان ہے؛

522
00:39:06,778 --> 00:39:09,543
تم کھجور کے درختوں کو نہ گرانا اور نہ جلانا

523
00:39:09,611 --> 00:39:16,590
اور ہم اس حقیقت سے واقف ہیں کہ رسول اللہؐ نے غزوۃ بنو نضیر کے دوران کھجور کے درختوں کو کاٹ کر جلا دیا تھا

524
00:39:16,627 --> 00:39:23,733
تو آپ ان سارے معالات کو کیسے زیرِ بحث لا سکتے ہیں جو ایک دوسرے کے برعکس ہیں

525
00:39:23,773 --> 00:39:27,390
پہلا مسئلہ، آپ کو دھوکہ دہی سے بچنا چاہئے

526
00:39:27,434 --> 00:39:30,590
اور رسول اللہؐ نے فرمایا ؛ جنگ فریب ہے

527
00:39:30,644 --> 00:39:36,283
جنگ کے دوران، آپ دھوکے کے مرتکب ہو سکتے ہیں، اور آپ اپنے دشمن کو فریب دے سکتے ہیں

528
00:39:36,327 --> 00:39:42,020
لیکن جب آپ اپنے دشمن کے ساتھ کوئی معاہدہ طے کرتے ہیں تو آپ کو بدعہدی نہیں کرنی چاہئے

529
00:39:42,057 --> 00:39:46,557
اگر دشمن کے ساتھ جنگ بندی کا معاہدہ ہو، اگر دشمن سے مذاکرات کرو

530
00:39:46,604 --> 00:39:51,057
اگر دشمن سے جنگ بندی پر مذاکرات کریں تو دھوکہ نہیں دے سکتے

531
00:39:51,104 --> 00:39:56,777
لہٰذا جب جنگ جاری ہے تب آپ دشمن کو جھانسہ دے سکتے ہیں

532
00:39:56,830 --> 00:40:02,177
لیکن جب آپ دشمن کے ساتھ باہمی گفت و شنید کے لیے بیٹھتے ہیں اور یہ توقع کی جاتی ہے کہ آپ اپنی بات پر قائم رہیں گے

533
00:40:02,226 --> 00:40:05,099
پھر آپ کو دھوکہ نہیں دینا چاہئے،

534
00:40:05,119 --> 00:40:08,866
لہذا میں امید کرتا ہوں کہ میں نے ان دونوں معاملات کی وضاحت کردی ہے

535
00:40:08,886 --> 00:40:16,157
اگلا مسئلہ جب حضرت ابوبکرؓ نے فرمایا ؛ نہ چھوٹے بچے کو، نہ بوڑھے کو اور نہ عورت کو قتل کرو

536
00:40:16,188 --> 00:40:18,740
رسول اللہؐ اس بات پر عمل پیرا رہے

537
00:40:18,779 --> 00:40:25,503
اور کبھی خواتین، بوڑھوں اور بچوں کو قتل نہیں کیا، کیونکہ وہ جنگجو نہیں تھے

538
00:40:25,542 --> 00:40:33,423
لیکن ایسی صورت حال میں جہاں کوئی عورت کسی نہ کسی صورت مسلمانوں کے ساتھ جنگ میں شریک کار ہوئی

539
00:40:33,460 --> 00:40:36,823
رسول اللہؐ نے اُن کی سزائے موت کی منظوری دی

540
00:40:36,870 --> 00:40:42,157
تو کس دلیل یا منطق کے پیشِ نظرعورت یا بوڑھے مرد کی جان بخشی جاتی ہے

541
00:40:42,211 --> 00:40:46,210
 اس کی وجہ یہ ہے کہ وہ نہتے ہیں، لیکن جس وقت وہ جنگجو بن جاتے ہیں

542
00:40:46,260 --> 00:40:50,250
پھر دیگرجنگجوؤں جیسا اصول ان پر بھی لاگو ہوتا ہے

543
00:40:50,284 --> 00:40:56,803
اور تبیت کا معاملہ،  کہ جب لشکر رات کے وقت دشمن پر حملہ کرتا ہے

544
00:40:56,841 --> 00:41:00,840
غیر مسلح یا نہتے افراد کو نقصان نہیں پہنچانا چاہئے

545
00:41:00,878 --> 00:41:05,200
لیکن ایسی صورت حال میں جہاں مسلم آبادی کو نقصان پہنچ سکتا ہے

546
00:41:05,233 --> 00:41:07,917
پھر مسلمانوں کا تحفظ اولین ترجیح ہے

547
00:41:07,961 --> 00:41:11,410
مسلمانوں کی حفاظت ہمہ وقت مقدم ہے

548
00:41:11,457 --> 00:41:15,300
مسلمانوں کا تحفظ دوسروں کے تحفظ سے بڑھ کر ہے

549
00:41:15,350 --> 00:41:19,677
پس وہ تمام حالات جن کے پیشِ نظر تبیت ناگزیر تھی

550
00:41:19,726 --> 00:41:22,254
یا طائف کے محاصرے جیسی صورتحال ہو

551
00:41:22,279 --> 00:41:27,963
جہاں منجنیق استعمال کی گئی تھی، آپ کو قطعی اندازہ نہیں ہوتا کہ گولے کہاں گریں گے؟

552
00:41:28,011 --> 00:41:35,637
لیکن عام اصول یہ ہے کہ غیر مسلح /نہتے عوام کو نقصان نہیں پہنچنا چاہیے

553
00:41:35,673 --> 00:41:41,237
آپ کھجور کے درختوں کو نہ گرائیں اور نہ ہی انہیں جلائیں

554
00:41:41,288 --> 00:41:44,023
غزوة بنونضیر میں

555
00:41:44,048 --> 00:41:50,087
بنونضیر نے فیصلہ کیا کہ وہ اپنے قلعوں میں چھپ جائیں گے

556
00:41:50,140 --> 00:41:54,763
بنو نضیر کے پاس طاقتور حفاظتی قلعے تھے

557
00:41:54,813 --> 00:42:02,803
اور ان قلعوں میں اُن کے پاس بہت زیادہ گولہ بارود اور وافر خوراک موجود تھی

558
00:42:02,872 --> 00:42:07,213
 اسلیئے وہ ایک طویل محاصرے میں بھی زندہ رہ سکیں گے

559
00:42:07,249 --> 00:42:11,077
اب ان کی زرعی زمینیں قلعوں سے باہر تھیں

560
00:42:11,125 --> 00:42:15,384
 یہی روایت تھی کہ آپ کے پاس قلعے ہوتے تھے اور زرعی زمینیں اُن  قلعوں سے باہر ہوتی تھیں

561
00:42:15,409 --> 00:42:21,090
قلعوں کے اندر زرعی زمینیں نہیں ہوتی تھیں، بصورت دیگر قلعہ بہت بڑا اور وسیع ہو جاتا

562
00:42:21,145 --> 00:42:28,717
چنانچہ قلعوں میں لوگوں کی رہائش ہوتی اور اُن کی زرعی زمینیں قلعوں سے باہر ہوا کرتیں تھیں

563
00:42:28,772 --> 00:42:31,050
تو انہوں نے کہا؛ ہم اپنے قلعوں میں چُھپے رہیں گے

564
00:42:31,077 --> 00:42:34,363
اور یہ سب رسول اللہؐ کو دھوکہ دینے کے بعد، اُن کا خیال تھا کہ ہم اپنے قلعوں میں چھپ جائیں گے

565
00:42:34,413 --> 00:42:38,983
اور چونکہ حضرت محمدﷺ زمین میں فساد کرنے کے خلاف ہیں

566
00:42:39,032 --> 00:42:42,483
 آپؐ ہمارے کھیتوں کو برباد نہیں کریں گے

567
00:42:42,545 --> 00:42:50,270
 وہ ششدر رہ گئے جب اُنھوں نے حضرت محمدﷺ کو کھجور کے درختوں کو کاٹتے اور انہیں جلاتے دیکھا

568
00:42:50,309 --> 00:42:56,237
اب انہیں معلوم تھا کہ وہ اپنے کھیتوں کے بغیر طویل محاصرے میں زندہ نہیں رہ سکتے، وہ کیسے گزارہ کریں گے؟

569
00:42:56,276 --> 00:43:00,230
 تو اس چیز نے بنو نضیر کے حوصلے پست کر دیئے

570
00:43:00,268 --> 00:43:02,870
جب رسول اللہؐ نے درختوں کو کاٹ کر جلایا

571
00:43:02,911 --> 00:43:08,577
 اس جنگی جارحیت نے بنو نضیر کی مزاحمت کو توڑا اور پھر ان کے قلعے یکے بعد دیگرے فتح کر لیے گئے

572
00:43:08,641 --> 00:43:09,937
اور بنو نضیر گردوپیش میں یہ کہتے پھرتے تھے؛

573
00:43:09,962 --> 00:43:12,837
ينهى محمد على الفساد في الارض ثم يحرقون خيلنا

574
00:43:13,144 --> 00:43:15,844
محمدﷺ دعویٰ کرتے ہیں کہ آپؐ زمین میں فساد نہیں کرتے

575
00:43:15,868 --> 00:43:19,487
اور یہاں وہ ہمارے کھجور کے درختوں کو کاٹ رہے ہیں

576
00:43:19,535 --> 00:43:21,747
تو کیا یہ فساد ہے یا نہیں؟

577
00:43:21,795 --> 00:43:25,730
اللہ عَزَّوَجَلْ نے صورت حال کو واضح کرنے کے لیے ایک آیت  نازل فرمائی، اللہ تبارک و تعالٰی فرماتے ہیں؛

578
00:43:25,774 --> 00:43:31,785
مَا قَطَعْتُمْ مِنْ لِينَةٍ أَوْ تَرَكْتُمُوهَا قَائِمَةً عَلَى أُصُولِهَا فَبِإِذْنِ اللَّهِ وَلِيُخْزِيَ الْفَاسِقِينَ۝

579
00:43:32,250 --> 00:43:37,920
ترجمہ؛ آپؐ نے جو کھجور کے درخت کاٹے یا ان کو تنوں پر کھڑا چھوڑ دیا

580
00:43:37,959 --> 00:43:43,637
یہ اللہ کے حکم سے تھا تاکہ وہ اس سے نافرمانوں کو رسوا کر دے

581
00:43:43,704 --> 00:43:47,400
تو اللہ تعالیٰ فرماتا ہے کہ جو عمل بھی رسول اللہؐ نے کیا میری مرضی سے ہوا

582
00:43:47,432 --> 00:43:51,737
لہٰذا، یہ فساد نہیں ہے، اسے زمین میں فساد پھیلانا نہیں کہا جا سکتا

583
00:43:51,773 --> 00:44:00,200
دشمن کا خیال تھا کہ وہ مسلمانوں کی رحمدلی اور رواداری سے فائدہ اُٹھائے اور اسے ان کے خلاف استعمال کرے

584
00:44:00,230 --> 00:44:05,460
 لیکن رسول اللہؐ اپنے عمل سے واضح فرما رہے تھے کہ تم مجھ سے کوئی ناجائز فائدہ نہیں اٹھا پاؤ گے

585
00:44:05,519 --> 00:44:10,967
ہاں، مجھے درخت کاٹنا اور کھیتیوں کو تباہ کرنا پسند نہیں

586
00:44:11,026 --> 00:44:16,529
لیکن اگر أپ میری اس رواداری کو میرے خلاف استعمال کرو گے اور ایسا کر کے میرا اور میری مسلم جمیعت کا فائدہ اٹھانے کی کوشش کرو گے

587
00:44:16,554 --> 00:44:18,757
میں آپ کو ایسا کرنے کی اجازت نہیں دوں گا

588
00:44:18,814 --> 00:44:23,430
تو یہاں آپؐ نے ایک اصول متعین فرمایا کہ مسلمان روادار ہیں

589
00:44:23,478 --> 00:44:27,403
اور مسلمان عوام کے لیے امن و سلامتی چاہتے ہیں

590
00:44:27,470 --> 00:44:32,677
تاہم مسلمانوں کی رواداری کو اُن کے اپنے خلاف استعمال نہیں کیا جا سکتا

591
00:44:32,708 --> 00:44:38,423
اس لیے عام اصول یہ ہے کہ ہم درخت نہ کاٹیں اور نہ ہی جانوروں کو ناحق نہ ماریں

592
00:44:38,457 --> 00:44:40,562
یہاں حضرت ابوبکر صدیقؓ فرماتے ہیں؛

593
00:44:40,586 --> 00:44:43,987
ان جانوروں میں سے کسی کو بھی ذبح نہ کریں تاوقتیکہ ان کا گوشت کھانے کی نیت نہ ہو

594
00:44:44,020 --> 00:44:49,903
تو یہ عام اصول ہے، لیکن اگر یہ کبھی مسلم جماعت کے خلاف استعمال ہونے والا ہے

595
00:44:49,928 --> 00:44:53,263
 پھر آپ اپنے دشمن سے یہ رحمدلی کا عنصر چھین سکتے ہیں

596
00:44:53,303 --> 00:44:56,540
اور اسی کے ساتھ ہے" ولا تُمثِّلوا " یعنی مسخ نہ کرو

597
00:44:56,592 --> 00:45:04,510
رسول اللہؐ نے اپنے دشمن کی لاشوں کو کبھی مسخ نہیں کیا اور نہ ہی انہیں کبھی اذیت دی

598
00:45:04,574 --> 00:45:08,150
 لیکن ایک صورت حال تھی جو صحیح بخاری میں مذکور ہے

599
00:45:08,210 --> 00:45:14,623
اور یہ معاملہ واضح ہے، میرا مطلب ہے کہ یہ وہ عمل ہے جو رسول اللہؐ نے نہ اس سے پہلے کبھی کیا تھا اور نہ بعد میں کبھی کیا

600
00:45:14,666 --> 00:45:18,253
جب رسول اللہؐ نے ان چرواہوں کو گرفتار کیا

601
00:45:18,287 --> 00:45:24,650
اور آپؐ نے ان کی آنکھیں نکال دی تھیں اور ان کے بازو اور ٹانگیں کاٹ دی تھیں

602
00:45:24,675 --> 00:45:29,777
اور پھر آپؐ نے انھیں صحرا میں خون بہنے اور پیاس سے مرنے کے لیے چھوڑ دیا

603
00:45:29,807 --> 00:45:31,440
اور حدیث کا راوی بیان کرتا ہے؛

604
00:45:31,470 --> 00:45:35,770
کہ میں نے انہیں صحرا میں لڑھکتے اور پیاس کی شدت سے پتھروں اور ریت کو  چاٹتے دیکھا

605
00:45:35,829 --> 00:45:37,703
اور کسی نے انھیں پانی نہیں دیا

606
00:45:37,754 --> 00:45:41,510
اب یہ وہ عمل ہے جو رسول اللہؐ نے نہ پہلے کبھی کیا اور نہ بعد میں کیا

607
00:45:41,549 --> 00:45:46,630
لیکن آپؐ نے یہ عمل چرواہوں کے اس ظلم کی وجہ سے کیا جس کے وہ مرتکب تھے

608
00:45:46,678 --> 00:45:50,777
وہ چرواہے نہیں تھے، عُرنہ کے آدمی تھے

609
00:45:50,819 --> 00:45:55,613
ان لوگوں نے رسول اللہؐ کے چرواہوں کو قتل کیا

610
00:45:55,662 --> 00:45:58,440
اور جس طرح سے انہوں نے اُن مسلم چرواہوں کو قتل کیا،  ان کی آنکھیں نکال دیں

611
00:45:58,484 --> 00:46:01,837
اور انہیں صحرا میں پیاس سے مرنے کے لیے چھوڑ دیا

612
00:46:01,875 --> 00:46:04,074
یہ لوگ مدینہ آئے اور کہنے لگے؛

613
00:46:04,116 --> 00:46:06,203
 ہم مسلمان ہیں اور انہوں نے کلمہ پڑھ کہ اسلام قبول کیا

614
00:46:06,251 --> 00:46:09,617
اشهدأنَّ اله الَا الله وأشهدوان محمدً رسول الله

615
00:46:09,729 --> 00:46:12,383
لیکن پھر مدینہ میں بیمار ہو گئے

616
00:46:12,436 --> 00:46:15,497
تو انہوں نے رسول اللہؐ سے علاج کی درخواست کی

617
00:46:15,541 --> 00:46:20,863
رسول اللہؐ نے ان سے فرمایا کہ صحرا میں جا کر اونٹوں کا دودھ اور پیشاب پیو

618
00:46:20,910 --> 00:46:24,983
 اُن کے اس خاص مرض کے علاج کے لیے یہ ان کی یہ دوا تھی

619
00:46:25,039 --> 00:46:33,130
وہ اونٹوں کے ساتھ نکلے، جن میں سے کچھ صدقہ کے اونٹ تھے، اور کچھ اونٹ رسول اللہؐ کی ذاتی ملکیت تھے

620
00:46:33,184 --> 00:46:37,077
جب وہ صحتیاب ہوگئے تو انہوں نے رسول اللہؐ کے ساتھ خیانت کی

621
00:46:37,128 --> 00:46:39,897
اُنہوں نے آپؐ کے چرواہوں کو اِس ظالمانہ طریقے سے قتل کردیا

622
00:46:39,922 --> 00:46:41,683
اور وہ اونٹ لے کر فرار ہوگئے

623
00:46:41,708 --> 00:46:44,713
رسول اللہؐ نے فوراً ان کو گرفتار کرنے کے لیے دستہ بھیجا

624
00:46:44,750 --> 00:46:48,637
خیانت کی وجہ سے اور ظلم کی وجہ سے، جس میں وہ ملوث تھے

625
00:46:48,676 --> 00:46:53,840
رسول اللہؐ اِن اعرابیوں کو، اِن ڈاکوؤں کو یہ سبق سکھانا چاہتے تھے

626
00:46:53,868 --> 00:46:58,613
اور یہ ایک سخت بالمثل عمل تھا، کہ تم ہماری ہمدردی و خلوص کا فائدہ نہیں اٹھا سکتے

627
00:46:58,653 --> 00:47:01,817
اورتم مجھ سے جھوٹ نہیں بول سکتے کہ تم مسلمان ہو

628
00:47:01,872 --> 00:47:05,273
اور پھر تم جاؤ اور میرے چرواہوں کو مار ڈالو اور میرے اونٹ لے جاؤ

629
00:47:05,310 --> 00:47:09,517
یہ بہت سخت سزا تھی جو رسول اللہؐ نے ان کو دی تھی

630
00:47:09,575 --> 00:47:13,214
لیکن اس نے باقی قبائل کے لیے ایک مصفی(مخالفانہ اقدام کو جڑ سے ختم کرنے والا عمل) کا کام کیا

631
00:47:13,239 --> 00:47:16,057
اور وہ دوبارہ کبھی بھی ایسے کسی تشدد آمیز عمل میں ملوث نہیں ہوئے

632
00:47:16,091 --> 00:47:19,880
میرا مطلب ہے کہ ہمیں تاریخ میں نہیں ملتا کہ اس کے بعد کسی ڈاکو نے کسی مسلمان کے ساتھ ایسا کیا ہو

633
00:47:19,915 --> 00:47:29,563
 لہٰذا مسلمانوں کے امیر پہ منحصر ہے کہ عام قوانین کو اپنانا ہے یا قانون سے ہٹ کر سخت گیر قدم اُٹھانا ہے

634
00:47:29,606 --> 00:47:34,520
لیکن عام قاعدہ وہی ہے جس کا ذکر حضرت ابوبکر صدیقؓ یہاں کر رہے ہیں

635
00:47:34,554 --> 00:47:38,783
 مثال کے طور پر حضرت ابوبکر صدیقؓ نے راہبوں کے متعلق فرمایا؛

636
00:47:38,820 --> 00:47:44,067
آپ کو یہ راہب ملیں گے اور یہ عیسائی راہب تھے

637
00:47:44,119 --> 00:47:53,213
جنہوں نے زُہد اور عبادت کے سادہ طرزِ زندگی کو اپنایا

638
00:47:53,269 --> 00:47:58,320
 وہ خانقاہوں میں رہتے تھے، اور بنا شادی کے زندگی گزارتے

639
00:47:58,368 --> 00:48:01,050
وہ اپنے أپ کو کچھ انتہائی اقدامات میں مشغول رکھتے

640
00:48:01,093 --> 00:48:06,057
اندلس میں ایک ایک راہبہ صوفی عورت تھی،

641
00:48:06,122 --> 00:48:07,809
 وہ عورت اپنے اعمال پر فخر کرتی

642
00:48:07,833 --> 00:48:14,177
اس نے کہا، میں اپنی زندگی میں کبھی بھی نہیں نہائی

643
00:48:14,207 --> 00:48:20,103
 ماسوائے اپنی انگلی کی پوروں کے، جب مجھے کوئی خاص عبادت کرنی ہو

644
00:48:20,141 --> 00:48:25,650
تو وہ اس سخت عبادت میں مگن رہتے جس کا اللہ سبحانہ تعالیٰ نے حکم نہیں دیا

645
00:48:25,692 --> 00:48:29,193
حضرت ابوبکر صدیقؓ نے فرمایا؛ انھیں تنہا چھوڑ دو

646
00:48:29,222 --> 00:48:31,223
انہیں قتل مت کرنا، انہیں نقصان نہ پہنچانا

647
00:48:31,258 --> 00:48:32,640
دعوهم ما هم فيه

648
00:48:33,084 --> 00:48:37,423
انہیں چھوڑ دو! یہ تم سے لڑنے والے نہیں ہیں ، وہ جنگجو نہیں ہیں

649
00:48:37,494 --> 00:48:40,753
انہیں نقصان نہ پہنچاؤ! اگرچہ وہ بھٹکے ہوئے تھے

650
00:48:40,828 --> 00:48:44,797
حضرت ابوبکر صدیقؓ فرما رہے تھے کہ ہمیں انھیں محفوظ رکھنا چاہیئے

651
00:48:44,840 --> 00:48:50,677
اب، کیا اس اصول کو ٹیمپلرز(یروشلم کی مسیحی جماعت) کے ساتھ برقرار رکھنا چاہیے؟

652
00:48:50,733 --> 00:48:55,850
ٹیمپلر پادری تھے، لیکن وہ کیتھولک چرچ کے جنگجو تھے

653
00:48:55,898 --> 00:49:03,597
اور وہ تمام صلیبی لشکروں میں سے سب سے زیادہ بے رحم،سخت اور ظالم تھے

654
00:49:03,675 --> 00:49:08,583
صلیبی فوجوں میں بدترین اور سب سے سفاک اور ظالم ٹیمپلر تھے

655
00:49:08,642 --> 00:49:11,370
اور یہ راہب تھے، یہ جنگجو راہب تھے

656
00:49:11,409 --> 00:49:13,513
تو کیا یہ اصول یہاں لاگو ہو سکتا ہے؟

657
00:49:13,556 --> 00:49:16,414
وہ عیسائیوں ایک انتہائی سخت اور جنونی دستہ تھا

658
00:49:16,438 --> 00:49:20,863
اور انہوں نے فلسطین میں مسلمانوں کی سرزمین پہ تباہی مچائی تھی

659
00:49:20,897 --> 00:49:24,639
لہٰذا، اس بات کا فیصلہ واضح ہونا چاہیے کہ حکم کا نفاز کہاں کرنا ہے اور کہاں نہیں

660
00:49:24,664 --> 00:49:29,037
اور یہ وہ عمل ہے جو خلیفہ بطور مجتہد کرتا ہے

661
00:49:29,078 --> 00:49:36,723
غور کریں کہ بہت سے اجتہاد خلفاء اور أمراء نے کیے، کیونکہ یہ ان کے عہدے کا تقاضا تھا

662
00:49:36,758 --> 00:49:40,560
جیسا کہ حضرت عمر بن عبدالعزیزؓ کا شمار اُمت کے علماء ربانی میں ہوتا ہے

663
00:49:40,633 --> 00:49:45,867
اور بہت سارے اجتہاد ہیں جو آپؓ نے خود کیے یہ مفتی یا عالم سے کہیں زیادہ تھے

664
00:49:45,915 --> 00:49:53,810
 کیونکہ بحیثیت خلیفہ یا امیر آپ ہی وہ شخص ہوتے ہیں جنہیں ایسے حالات کا سامنا کرنا پڑتا ہے، اور آپ کا سامنا حقیقی دنیا سے ہوتا ہے

665
00:49:53,853 --> 00:50:00,440
تو اس خصوصی علم کی ضرورت ہوتی ہے، اور اسی لیے خلافت کی ایک شرط علم  ہے

666
00:50:00,500 --> 00:50:02,167
خلیفہ کو باعلم ہونا چاہیے

667
00:50:02,206 --> 00:50:08,853
تاکہ وہ ان حالات میں اجتہاد کر سکیں جو انہیں درپیش ہوں

668
00:50:08,896 --> 00:50:13,430
 تو حضرت ابوبکرؓ کے لشکر بھیجنے کا نتیجہ کیا نکلا؟

669
00:50:13,485 --> 00:50:16,488
کیا مدینہ پر گھات لگائی گئی; کیا مدینہ تباہ کیا گیا; یا مسلمان قتل ہوئے؟

670
00:50:16,512 --> 00:50:19,500
سبحان اللہ دیکھیں کیا ہوا

671
00:50:19,542 --> 00:50:26,810
لشکر روانہ ہوا اور یہ لمبا سفر مدینہ سے شام کی طرف تھا

672
00:50:26,858 --> 00:50:31,490
تو یہ شمالی عرب کو چیرتا ہوا گزرا

673
00:50:31,530 --> 00:50:38,697
یہ ان تمام قبائل کے سامنے طاقت کا مظاہرہ تھا، جو مدینہ پر حملے کی منصوبہ بندی کر رہے تھے

674
00:50:38,758 --> 00:50:41,960
اور یہ صحرا کا قانون ہے، اگر تم کمزور ہو، تم پر حملہ کیا جائے گا

675
00:50:41,992 --> 00:50:46,477
چنانچہ وہ تمام قبائل جو رسول اللہؐ کے وصال کا فائدہ اٹھانے کی کوشش کر رہے تھے

676
00:50:46,526 --> 00:50:52,950
اور اسلامی ریاست کا خاتمہ کرنا چاہتے تھے

677
00:50:52,983 --> 00:51:00,277
تو فوج ان تمام قبائل کے بیچ سے گزر رہی تھی، جو مدینہ پر حملے کا ارادہ اور منصوبہ بندی کر رہے تھے

678
00:51:00,317 --> 00:51:01,903
اور وہ کہہ رہے تھے

679
00:51:01,941 --> 00:51:04,987
رسول اللہؐ کا وصال ابھی چند روز قبل ہی ہوا ہے

680
00:51:05,025 --> 00:51:09,853
اور یہ لوگ لشکر بھیج رہے ہیں وہ بھی رومی سلطنت کی طرف

681
00:51:09,885 --> 00:51:15,770
اب عرب قبائل میں رومیوں سے جنگ کرنا ایک ایسی چیز تھی، جو آپ جانتے ہیں کہ آپ ایسا کر ہی نہیں سکتے

682
00:51:15,825 --> 00:51:20,183
یہ عظیم رومی سلطنت ہے، رومی سلطنت نے ان کے دلوں میں دھاک بٹھا رکھی تھی

683
00:51:20,223 --> 00:51:24,047
میرا مطلب ہے کہ وہ اس کے بارے میں سوچ بھی نہیں سکتے تھے

684
00:51:24,090 --> 00:51:30,650
بالکل ایسے ہی جیسے ہم نے اس وقت کا زکر کیا جب رسول اللہؐ بنو شیبان سے حفاظت طلب کر رہے تھے

685
00:51:30,693 --> 00:51:32,537
 جو فارس کی سرحد سے متصل تھے

686
00:51:32,582 --> 00:51:34,149
انہوں نے کہا کہ ہم آپ کو عربوں سے بچا سکتے ہیں

687
00:51:34,174 --> 00:51:37,057
لیکن ہم آپ کو فارس کی طرف سے تحفظ کا وعدہ نہیں کر سکتے

688
00:51:37,099 --> 00:51:39,203
یہ ہمارے بس کی بات نہیں

689
00:51:39,242 --> 00:51:45,237
چنانچہ عرب رومیوں اور فارسیوں کا احترام کرتے تھے اور وہ ان کے خلاف جنگ کرنے کی جرأت نہیں کرتے تھے

690
00:51:45,280 --> 00:51:50,774
چنانچہ جب ان قبائل نے دیکھا کہ حضرت ابوبکرصدیقؓ پہلے ہی ایک لشکر جمع کر چکے ہیں

691
00:51:50,814 --> 00:51:52,328
اور آپؓ یہ لشکر رومیوں سے لڑنے کے لیے بھیج رہے ہیں

692
00:51:52,377 --> 00:51:55,823
انہوں نے کہا؛ یہ لوگ بہت مضبوط ہوں گے

693
00:51:55,872 --> 00:52:00,163
ہمیں اپنی سوچ بدلنی چاہیے اور مدینہ پر حملہ کرنا بھول جانا چاہیے

694
00:52:00,196 --> 00:52:02,370
اور اُنھوں نے اپنے منصوبے بدل دیے

695
00:52:02,412 --> 00:52:06,590
چنانچہ اسلامی ریاست کے خلاف سب سے کم مزاحمت شمالی عرب سے ہوئی

696
00:52:06,627 --> 00:52:09,590
وہ قبائل جنہوں نے حضرت اُسامہ کی فوج کو اپنی آنکھوں سے دیکھا

697
00:52:09,622 --> 00:52:12,340
اُن قبائل  نے نہ کبھی مدینہ پر حملہ کیا اور نہ کبھی اس کے بارے میں سوچا

698
00:52:12,373 --> 00:52:17,757
اور یہ ایک بہت ہی محفوظ علاقہ تھا حتیٰ کہ حروب الردة(مرتدین کے خلاف جنگ) کے زمانے میں بھی

699
00:52:17,798 --> 00:52:22,197
یہ شورش زدہ علاقہ نہیں تھا، حالانکہ وہاں بہت سارے قبائل تھے

700
00:52:22,231 --> 00:52:26,803
کیونکہ وہ مدینہ پر حملہ کرنے کے اپنے منصوبے کو مکمل طور پر ختم کر دیتے ہیں

701
00:52:26,834 --> 00:52:35,450
اب، ہرقل رومی شہنشاہ، اسلام کے اس نئے رجحان سے بہت پریشان تھا

702
00:52:35,501 --> 00:52:37,503
 اس نے اپنا دارالحکومت چھوڑ دیا

703
00:52:37,572 --> 00:52:44,337
اور اس نے انطاکیہ میں، موجودہ شام میں انطاکیہ کے مقام پر اپنا اڈہ قائم کیا

704
00:52:44,385 --> 00:52:49,424
کیونکہ وہ عرب کی اس بھولی بسری سرزمین میں رونما ہونے والے واقعات سے قریب ہونا چاہتا تھا

705
00:52:49,457 --> 00:52:51,623
میرا مطلب ہے وہاں ماضی میں کچھ نہیں ہو رہا تھا

706
00:52:51,648 --> 00:52:57,513
فوجیں دنیا کے کونے کونے میں جاتیں لیکن صحرا میں کسی کو نہ ہی کوئی دلچسپی ہوتی اور نہ ہی کوئی أنکھ بھر کے اسے دیکھتا

707
00:52:57,569 --> 00:53:01,207
وہاں کوئی وسائل نہیں تھے، وہاں شاذ و نادر ہی کوئی آبادی تھی

708
00:53:01,250 --> 00:53:03,440
ایسی بنجر زمین سے آپ کیا چاہیں گے؟

709
00:53:03,477 --> 00:53:05,468
چنانچہ سلطنت فارس نے اپنی طاقت کے عروج پر

710
00:53:05,493 --> 00:53:07,637
اور رومی سلطنت نے اپنی طاقت کے عروج پر

711
00:53:07,673 --> 00:53:09,023
سرزمینِ عرب پر حملہ کرنے کے بارے میں کبھی نہیں سوچا

712
00:53:09,047 --> 00:53:13,147
اس ویران زمین کا کیا حاصل، وہ جزیرہِ عرب کو بے فائدہ سمجھتے تھے

713
00:53:13,194 --> 00:53:18,547
اور اب، رومی بادشاہ اپنا دارالحکومت چھوڑ کر انطاکیہ أ بسا

714
00:53:18,596 --> 00:53:22,197
صرف مدینہ میں ہونے والے واقعات کو بغور جانچنے کی غرض سے

715
00:53:22,240 --> 00:53:27,530
وہ اس کے بارے میں اتنا پریشان ہوا کہ اُس نے اپنا دارالحکومت چھوڑ دیا

716
00:53:27,591 --> 00:53:36,503
اللہ کی قدرت یہ کہ اسے حضرت اسامہؓ کے لشکر کے حملہ أور ہونے کی اور رسول اللہؐ کے وصال کی خبر ایک ہی دن موصول ہوئی

717
00:53:36,546 --> 00:53:39,077
ہرقل نے کہا؛ یہ سب کیا ہو رہا ہے؟

718
00:53:39,121 --> 00:53:42,330
مسلمانوں کے نبی، ان کے قائد کا حال ہی میں وصال ہوا ہے

719
00:53:42,385 --> 00:53:45,823
اور وہ مجھ سے جنگ کے لیے فوج بھیج رہے ہیں

720
00:53:45,882 --> 00:53:53,430
چنانچہ ہرقل نے اپنا ارادہ بدل دیا اور حضرت اسامہؓ کی فوج کو رومی سلطنت کے اندر تک أنے کی اجازت دی

721
00:53:53,487 --> 00:53:57,777
 تاکہ یہ مسلمان لشکر مالِ غنیمت لے سکے اور بغیر کسی نقصان مدینہ لوٹ سکے

722
00:53:57,812 --> 00:54:04,257
حضرت اسامہ بن زیدؓ اپنے گھوڑوں کے ساتھ اس سرزمین پر قدم رکھ رہے تھے جہاں آپؓ کے والد کو شہید کیا گیا تھا

723
00:54:04,302 --> 00:54:08,260
 آپؓ نے علاقے کے عرب قبائل کے ساتھ مذاکرات اور معاملات طے کیے

724
00:54:08,301 --> 00:54:11,237
  آپؓ نے ان کے ساتھ مذاکرات اور جنگ بندی کے معاہدے طے کیے

725
00:54:11,280 --> 00:54:15,503
آپؓ نے جزیہ لیا، اور مال غنیمت لے کر واپس پہنچے

726
00:54:15,558 --> 00:54:20,171
اور ہرقل وہیں موجود تھا، اور وہ حضرت اُسامہؓ کا سامنا کرنے کے لیے لشکر بھیجنے کی ہمت نہ کر سکا

727
00:54:20,224 --> 00:54:25,613
یہ حضرت ابوبکر صدیقؓ کے یقین کے نتائج تھے

728
00:54:25,662 --> 00:54:27,677
جب آپ اللہ پر یقین رکھیں تو ایسا ہی ہوتا ہے

729
00:54:27,738 --> 00:54:34,183
حضرت موسیٰ کی والدہ کو دیکھیں، اگر انہیں اللہ عَزَّوَجَلْ پہ یقین نہ ہوتا

730
00:54:34,212 --> 00:54:38,383
اور اپنے بچے کو دریا میں پھینکنے کے بجائے؛ جو کہ بظاہر یقینی موت تھی

731
00:54:38,426 --> 00:54:39,697
 کیونکہ اللہ عَزَّوَجَلْ نے انھیں بتایا تھا

732
00:54:39,746 --> 00:54:43,703
اگر آپ کو اپنے بچے کی حفاظت کی خواہشمند ہیں تو کیا کریں؟ اسے دریا میں ڈال دیں

733
00:54:43,770 --> 00:54:46,317
   کسی ماں کے بارے میں مجھے بتائیں جو اپنے بچے کو دریا میں پھینک سکتی ہے؟

734
00:54:46,373 --> 00:54:47,727
میرا مطلب ہے، حل دیکھیں

735
00:54:47,751 --> 00:54:50,990
 اگر تم فرعون سے ڈرتی ہو تو ایسا کرو کہ اپنے نومولود بچے کو دریا میں پھینک دو

736
00:54:51,032 --> 00:54:55,837
اس کا حل بد سے بدتر معلوم ہو رہا تھا، لیکن اللہ نے آپؑ کی والدہ سے فرمایا؛

737
00:54:55,868 --> 00:54:58,991
وَلَا تَخَافِي وَلَا تَحْزَنِي ۖ إِنَّا رَادُّوهُ إِلَيْكِ وَجَاعِلُوهُ مِنَ الْمُرْسَلِينَ۝

738
00:54:59,016 --> 00:55:05,353
اگر تم ایسا کرو(جو اللہ کا حکم ہے) تو نہ خوف کھاؤ اور نہ ہی غم کرو کیونکہ وہ(موسیٰ) تمہارے پاس واپس آئے گا اور میں اسے رسول بناؤں گا

739
00:55:05,399 --> 00:55:07,250
"جو میں تم سے کہتا ہوں وہ کرو اور ایسا ہی ہوگا"

740
00:55:07,281 --> 00:55:13,230
انہیں اللہ پہ یقین تھا اور انھوں نے اپنے نومولود بیٹے حضرت موسیٰ کو دریا میں ڈال دیا

741
00:55:13,260 --> 00:55:18,450
اگرآپؑ حضرت موسیٰ کو اپنی آغوش میں رکھتیں اور اللہ کے وعدے پر ایمان نہ لاتیں

742
00:55:18,486 --> 00:55:21,503
فرعون کے سپاہی، اس کے خفیہ کارندے

743
00:55:21,535 --> 00:55:24,168
وہ تلاش کر لیتے اور حضرت موسیٰ کو قتل کر دیتے

744
00:55:24,234 --> 00:55:28,530
کیونکہ آپؑ بنی اسرائیل میں پیدا ہونے والے لڑکے تھے

745
00:55:28,585 --> 00:55:32,717
لیکن چونکہ آپؑ کی والدہ اللہ کے وعدے پر ایمان رکھتی تھیں، آپؑ کو اللہ کے ایک سپاہی نے اٹھا لیا

746
00:55:32,777 --> 00:55:36,090
فرعون کی بیوی ، وہ اللہ کی سپاہی تھی

747
00:55:36,133 --> 00:55:40,270
اور وہ آپؑ سے محبت کرتی تھیں اور اُنھوں نے آپؑ کو اپنا بیٹا بنا لیا

748
00:55:40,325 --> 00:55:44,970
اور چونکہ حضرت موسیٰ اپنی ماں کے علاوہ کسی کا دودھ نہیں پیتے تھے

749
00:55:45,009 --> 00:55:50,490
حضرت موسیٰؑ کو شاہی محافظوں کے حصار میں ان کی والدہ کے گھر لے جایا جاتا

750
00:55:50,551 --> 00:55:55,237
اور وہ حضرت موسیٰ کی والدہ کو تنخواہ، وظیفہ ادا کر رہے تھے

751
00:55:55,291 --> 00:55:59,157
تاکہ وہ اپنے ہی بچے کو دودھ پلا سکیں

752
00:55:59,190 --> 00:56:02,583
 کیونکہ انھیں اللہ عَزَّوَجَلْ پہ بھروسہ تھا اور ایسا ہی ہوا

753
00:56:02,615 --> 00:56:03,610
 اللہ عَزَّوَجَلْ نے فرمایا؛

754
00:56:03,639 --> 00:56:07,327
فَٱلْتَقَطَهُۥٓ ءَالُ فِرْعَوْنَ لِيَكُونَ لَهُمْ عَدُوًّا وَحَزَنًا ۗ

755
00:56:07,354 --> 00:56:11,917
"فرعون کے سپاہیوں نے حضرت موسیٰ کو اٹھا لیا، لیکن وہ ان کا دشمن ثابت ہونے والا تھا"

756
00:56:11,953 --> 00:56:17,807
وہ یہ نہیں جانتے تھے، کہ یہ بچہ، یہ نوزائیدہ بچہ جو بمشکل دیکھ سکتا تھا

757
00:56:17,854 --> 00:56:22,080
 وہی ہے جو ان کا خاتمہ کرے گا

758
00:56:22,122 --> 00:56:24,870
 یہ اللہ عَزَّوَجَلْ پہ بھروسہ رکھنے کا ثمر ہے

759
00:56:24,909 --> 00:56:28,770
 حضرت اسامہؓ کی فوج شاندار اندازمیں واپس آئی

760
00:56:28,806 --> 00:56:33,597
مدینہ میں ان کا استقبال ہوا ، آپؓ کامیاب ہوئے، آپؓ فتح یاب ہوئے

761
00:56:33,646 --> 00:56:37,487
چنانچہ حضرت ابوبکرؓ کی پالیسی نے مثبت نتائج اخذ کئے

762
00:56:37,531 --> 00:56:41,477
اسی لیے اس کے بعد تمام صحابہ کو اس کا احساس ہوا

763
00:56:41,533 --> 00:56:45,650
حضرت ابوبکر صدیقؓ جب کوئی بات کہیں تو اس پر عمل کرو، اسے تسلیم کرو

764
00:56:45,720 --> 00:56:51,197
کیونکہ آپؓ کے ساتھ اللہ کی تائید تھی، آپؓ کو اللہ عَزَّوَجَلْ کی خاص مدد حاصل تھی

765
00:56:51,250 --> 00:56:58,963
اگلا حصہ "حروب الردۃ" ہے، مرتدین کے خلاف جنگیں

766
00:56:58,988 --> 00:57:02,447
سب سے پہلے ،ردّہ کی تعریف کیا ہے؟

767
00:57:02,500 --> 00:57:04,691
النووی فرماتے ہیں؛

768
00:57:04,767 --> 00:57:13,697
هي قَطعُ الإسلامِ،بنيتٍ أو قول كفرٍ، أو فعلٍ، سواء قال استهزاءً، أو عِنادً، أو اعتقادً

769
00:57:13,876 --> 00:57:22,797
فمن نفثَّانا أو رسل أو كذب رسولًا أو حلل محرمًا بالإجماع كزن أو عكسه أو نف وجوب

770
00:57:22,973 --> 00:57:28,440
مجمعً عليه أو عكس ذالك أو عزم على الكفر أو ترد فيه كفر

771
00:57:28,828 --> 00:57:35,397
علامہ النویؒ فرماتے ہیں ؛ردّہ، ردّہ کی تعریف اسلام سے قطع تعلق ہو جانا ہے یعنی اسلام ترک کر دینا

772
00:57:35,439 --> 00:57:36,141
 قَطعُ الإسلامِ

773
00:57:36,214 --> 00:57:37,254
 أپ نے اسلام کو ترک کر دیا(مرتد ہو جانا)

774
00:57:37,318 --> 00:57:43,650
مثلاً آپ مسلمان تھے اور پھر آپ کی نیت بدل گئی یا آپ اس سے منحرف ہو گئے

775
00:57:43,706 --> 00:57:47,863
پس اگر کوئی شخص دین اسلام چھوڑنے کی نیت رکھتا ہے تو وہ دائرہ اسلام سے خارج ہو گیا

776
00:57:47,888 --> 00:57:50,124
 أو قول كفرٍ

777
00:57:50,410 --> 00:57:55,100
یا کوئی بیان، کچھ الفاظ انسان کو مرتد کر سکتے ہیں

778
00:57:55,125 --> 00:57:55,918
أو فعلٍ

779
00:57:56,057 --> 00:58:00,560
 یا ایک عمل، تو کبھی کبھّار کوئی عمل بھی ردّہ ہو سکتا ہے

780
00:58:00,590 --> 00:58:02,290
سواء قال استهزاءً

781
00:58:02,469 --> 00:58:07,423
چاہے وہ عمل یا بیان طنزاً کیا گیا ہو

782
00:58:07,465 --> 00:58:11,965
خواہ تمسخر اُڑایا گیا ہو، مثال کے طور پر اگر کوئی رسول اللہؐ کا مذاق اڑائے(معاذاللہ)

783
00:58:11,996 --> 00:58:15,207
اور وہ صرف مذاق کر رہے ہوں ، یہ ردہ ہے

784
00:58:15,234 --> 00:58:15,961
أو عِنادًا

785
00:58:16,072 --> 00:58:18,137
یا ضد میں کیا جانے والا قول و فعل

786
00:58:18,170 --> 00:58:19,055
أو اعتقادًا

787
00:58:19,095 --> 00:58:21,462
یا عقیدے میں کوئی بڑی خامی ہو

788
00:58:21,504 --> 00:58:25,437
اور پھر وہ کہتے ہیں، اور اگر تم حلال کو حرام یا حرام کو حلال قرار دیتے ہو

789
00:58:25,481 --> 00:58:28,587
 یہ بھی ردّہ ہے

790
00:58:28,652 --> 00:58:33,337
یا اُس کی مرتد ہونے کی نیت ہے؟

791
00:58:33,380 --> 00:58:35,610
یا اس پر بحث ہو رہی ہو کہ مرتد ہوا جائے یا نہیں

792
00:58:35,634 --> 00:58:39,753
 مثال کے طور پر، مجھے یقین نہیں ہے کہ میں اسلام چھوڑنا چاہتا ہوں یا نہیں، یہ بھی ردّہ ہے

793
00:58:39,820 --> 00:58:43,053
پس یہی ردّہ کی تعریف ہے

794
00:58:43,097 --> 00:58:44,728
ردّہ کی مختلف صورتیں ہیں

795
00:58:44,786 --> 00:58:48,772
مثال کے طور پر اللہ تعالیٰ کے حکم کا نفاز نہ کرنا

796
00:58:48,790 --> 00:58:49,488
اللہ عَزَّوَجَلْ فرماتا ہے؛

797
00:58:49,512 --> 00:58:52,990
وَمَنْ لَمْ يَحْكُمْ بِمَا أَنزَلَ اللَّهُ فَأُوْلَئِكَ هُمُ الْكَافِرُونَ۝

798
00:58:53,341 --> 00:58:59,130
ترجمہ؛ " جو اللہ عَزَّوَجَلْ کے قانون پر عمل نہیں کرتے وہی کفر کرنے والے ہیں"

799
00:58:59,176 --> 00:59:00,205
فَأُوْلَئِكَ هُمُ الْكَافِرُونَ

800
00:59:00,229 --> 00:59:01,530
وہی لوگ کافر ہیں

801
00:59:01,598 --> 00:59:04,508
آج کل ردّہ کی ایک اور عام صورت ہے یہ ہے کہ

802
00:59:04,547 --> 00:59:11,130
يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تُطِيعُوا الَّذِينَ كَفَرُوا يَرُدُّوكُمْ عَلَى أَعْقَابِكُمْ فَتَنْقَلِبُوا خَاسِرِينَ۝

803
00:59:11,399 --> 00:59:16,643
ترجمہ؛ اے ایمان والو! اگر تم کافروں کی روش پر چلو

804
00:59:16,840 --> 00:59:21,637
وہ(کفار) تمہیں پھیر (بھٹکا) دیں گے، ردّہ کا مطلب ہے پِھر جانا یعنی مرتد ہونا

805
00:59:21,682 --> 00:59:23,200
يَرُدُّوكُمْ عَلَى أَعْقَابِكُمْ

806
00:59:23,416 --> 00:59:24,983
وہ(کفار) آپ کو پھیر(پسپا) دیں گے

807
00:59:25,030 --> 00:59:26,372
فَتَنْقَلِبُوا خَاسِرِينَ

808
00:59:26,525 --> 00:59:28,766
اور تم خسارے میں پڑ جاؤ گے، اور رسول اللہؐ فرماتے ہیں؛

809
00:59:28,798 --> 00:59:31,791
ومن يتولهم منكم فإنه منهم

810
00:59:32,046 --> 00:59:36,757
 جو ان(کفار) کے راستے پر چلے گا وہ ان میں سے ہو جائے گا

811
00:59:36,806 --> 00:59:39,997
اور یہ ایک آیت ہے، رسول اللہؐ حدیث میں فرماتے ہیں کہ؛

812
00:59:40,022 --> 00:59:45,163
اگر تم کسی قوم سے محبت کرو گے تو تم ان کے ساتھ ہو گے

813
00:59:45,221 --> 00:59:50,120
حضرت ابوبکر صدیقؓ کے زمانے میں ردّہ کے زمرے میں تین اقسام تھیں

814
00:59:50,196 --> 00:59:51,803
القاضی ایازؒ فرماتے ہیں؛

815
00:59:51,861 --> 00:59:54,640
صنف عادوا إلى عبادة ألأوسان

816
00:59:54,886 --> 00:59:58,372
پہلی صورت یہ تھی کہ ؛ یہ لوگ بت پرستی کی طرف پلٹ  گئے

817
00:59:58,478 --> 01:00:03,903
 وہ اس کی طرف چلے گئے جو وہ اسلام سے پہلے کرتے تھے،بتوں کی پرستش

818
01:00:03,943 --> 01:00:04,757
ردّہ کی دوسری قسم

819
01:00:04,820 --> 01:00:09,803
وصنفٌ تبع مسيلمة ولأسود ألعنسي وكل منهم مدع من النبوة

820
01:00:09,987 --> 01:00:15,343
مرتدین کی دوسری قسم وہ لوگ تھے جنہوں نے مسیلمہ کذاب اور اسود عنسی کی پیروی کی

821
01:00:15,396 --> 01:00:17,717
اور ان دو افراد نے نبوت کا دعویٰ کیا تھا

822
01:00:17,765 --> 01:00:19,830
پس یہ ردّہ کی دوسری قسم تھی

823
01:00:19,865 --> 01:00:21,850
تیسری قسم؛

824
01:00:21,889 --> 01:00:29,498
وصنفٌ ثالث لإستمرُّ على الإسلام ولكنهم جهد زكوة وتأول باَنَّ خاصه من زمن النبي

825
01:00:29,892 --> 01:00:34,663
مرتدین کی تیسری قسم، وہ مسلمان تھے اور مسلمان ہی رہے

826
01:00:34,715 --> 01:00:37,370
 لیکن انہوں نے زکوٰۃ دینے سے انکار کر دیا

827
01:00:37,418 --> 01:00:41,550
کیونکہ ان کا کہنا تھا کہ زکوٰۃ صرف رسول اللہؐ کو دی جانی چاہیے

828
01:00:41,625 --> 01:00:44,764
یہ مرتدین میں شمار ہوتے تھے حالانکہ وہ نماز پڑھتے تھے

829
01:00:44,789 --> 01:00:47,039
 اور وہ اسلامی عبادات پر بھی عمل پیرا تھے

830
01:00:47,064 --> 01:00:49,890
مسئلہ صرف یہ تھا کہ انہوں نے زکوۃ ادا کرنے سے انکار کیا

831
01:00:49,935 --> 01:00:52,729
چنانچہ حضرت ابوبکر صدیقؓ نے انہیں مرتد قرار دیا

832
01:00:52,753 --> 01:00:56,047
اور ہم اس کے بارے میں اپنی گفتگو کے اگلے سلسلے میں بات کریں گے

833
01:00:56,100 --> 01:00:57,610
ردّہ کا آغاز کب ہوا؟

834
01:00:57,635 --> 01:01:02,077
ردّہ کا آغاز دراصل رسول اللہؐ کے زمانے میں ہوا، اس کی ابتداء حضرت ابوبکرؓ کے زمانے میں نہیں ہوئی

835
01:01:02,121 --> 01:01:11,690
دس ہجری میں جب رسول اللہؐ کی حکومت ہر طرف پھیل رہی تھی

836
01:01:11,732 --> 01:01:14,363
 آپؐ کے ساتھ بہت سے ضعیف الاعتقاد لوگ تھے

837
01:01:14,417 --> 01:01:18,203
جو صرف تلوار کے خوف سے اسلام میں شامل ہوئے

838
01:01:18,234 --> 01:01:22,854
صرف اس لیے کہ اسلام مضبوط تھا، انہوں نے اسلام قبول کیا، یہ لوگ منافقین تھے

839
01:01:22,891 --> 01:01:27,210
وہ درحقیقت دل سے اسلام پر ایمان نہیں رکھتے تھے

840
01:01:27,261 --> 01:01:29,710
وہ صرف دکھاوا کر رہے تھے

841
01:01:29,748 --> 01:01:33,583
 أپؐ کی بعثت اس سے پہلے عرب نبوت سے ناواقف تھے

842
01:01:33,643 --> 01:01:38,303
لیکن اب جب کچھ لوگوں نے حضرت محمد ﷺ کے مقصد کی کامیابی کو دیکھا

843
01:01:38,342 --> 01:01:41,103
کہنے لگے؛ ارے کیوں نہ ہم بھی نبی ہونے کا دعویٰ کریں

844
01:01:41,142 --> 01:01:46,357
عرب میں حضرت محمدﷺ سے پہلے کسی نے بھی نبی ہونے کا دعویٰ نہیں کیا

845
01:01:46,395 --> 01:01:52,730
لیکن جب عربوں نے دیکھا کہ حضرت محمدﷺ عرب کے غیر متنازعہ رہنما بن گئے ہیں

846
01:01:52,755 --> 01:01:55,283
کہنے لگے؛ اچھا چلو کیوں نہ ہم بھی کوشش کریں

847
01:01:55,313 --> 01:01:58,170
تو مسیلمہ کذاب، اسود عنسی

848
01:01:58,219 --> 01:02:00,690
 طلیحہ اسدی اور سجاح

849
01:02:00,732 --> 01:02:03,650
ان سب نے نبوت کا جھوٹا دعویٰ کیا، اِن میں تین مرد اور ایک عورت شامل تھی

850
01:02:03,680 --> 01:02:07,082
چاروں میں سب سے خطرناک مسیلمہ اور اسود تھے

851
01:02:07,160 --> 01:02:10,277
مسیلمہ کا تعلق یمامہ سے تھا اور اسود عنسی کا تعلق یمن سے تھا

852
01:02:10,328 --> 01:02:16,490
   ان دونوں کا اثرورسوخ بڑھ رہا تھا اور وہ تیزی سے سادہ لوح افراد کے ایمان کے لیے خطرہ بن رہے تھے

853
01:02:16,554 --> 01:02:25,177
 کہ وہ بہت بڑے لشکر جمع کر رہے تھے جو مسلمانوں کے خلاف حقیقی خطرہ بننے والے تھے

854
01:02:25,221 --> 01:02:35,100
 مسیلمہ اور اسود عنسی دونوں نے، ہجرت کے دسویں سال میں رسول اللہؐ کے زمانے میں نبی ہونے کا دعویٰ کیا

855
01:02:35,164 --> 01:02:38,267
لیکن رسول اللہؐ نے وصال سے پہلے ایک خواب دیکھا

856
01:02:38,314 --> 01:02:44,080
آپؐ نے فرمایا ؛میں نے دیکھا، گویا میں نے سونے کے دو کنگن پہن رکھے ہیں

857
01:02:44,109 --> 01:02:48,047
رَأَيْتُ أنَّ في زراية سِوارَيْنِ مِن ذَهَبٍ، فكرحتُهُما

858
01:02:48,248 --> 01:02:49,997
آپؐ نے فرمایا ؛ اور میں نے انھیں ناپسند کیا

859
01:02:50,038 --> 01:02:50,887
فَنَفَخْتُهُما

860
01:02:50,927 --> 01:02:53,963
آپؐ نے فرمایا ؛ چنانچہ میں نے ان پر پھونک ماری اور وہ اڑ گئے

861
01:02:54,004 --> 01:03:01,750
رسول اللہؐ نے فرمایا؛ میری تعبیر یہ ہے کہ دو کنگن یمامہ اور یمن کے جھوٹے ہیں

862
01:03:01,783 --> 01:03:05,263
رسول اللہؐ نے ان کا زکر اسی لقب سے کیا؛ جھوٹا

863
01:03:05,302 --> 01:03:08,537
یمامہ کا جھوٹا اور یمن کا جھوٹا

864
01:03:08,581 --> 01:03:11,230
رسول اللہؐ خواب میں دو کنگن دیکھ رہے ہیں

865
01:03:11,271 --> 01:03:14,633
سونے کے کنگن، بازوؤں کو گھیرنے کا مطلب ہے

866
01:03:14,683 --> 01:03:18,867
یہ دونوں امت کے لیے خطرہ ہوں گے کیونکہ تیسرا نبی طلیحہ تھا

867
01:03:18,894 --> 01:03:21,090
 لیکن رسول اللہؐ نے صرف دو کنگن دیکھے

868
01:03:21,152 --> 01:03:24,413
 مطلب یہ دونوں سب سے خطرناک ثابت ہونے جا رہے تھے

869
01:03:24,508 --> 01:03:25,394
فكرھتُهُما

870
01:03:25,500 --> 01:03:29,973
آپؐ نے فرمایا؛ میں نے انہیں ناپسند کیا اور رسول اللہؐ نے فرمایا؛ وہ سونے کے تھے

871
01:03:30,003 --> 01:03:36,445
 سونا اس دنیا کی زینت ہے، سونا اس دنیا سے وابستگی ہے

872
01:03:36,470 --> 01:03:41,993
 تو مسیلمہ اور اسود یہ کام آخرت کے لیے نہیں کر رہے تھے، وہ دنیا کے لیے کر رہے تھے

873
01:03:42,040 --> 01:03:47,990
اور عام طور پر، سونا خوابوں کی تعبیر میں منفی معنی رکھتا ہے

874
01:03:48,030 --> 01:03:52,826
رسول اللہؐ کے پھونکنے کا مطلب یہ ہے کہ اگرچہ یہ بہت خطرناک ہیں

875
01:03:52,851 --> 01:03:56,810
یہ دونوں بہت خطرناک ہیں، یعنی وہ آپؐ کے دونوں بازوؤں کو گھیرے ہوئے ہیں

876
01:03:56,850 --> 01:04:00,417
لیکن دراصل صرف ایک پھونک سے وہ اُڑ گئے(ختم ہو گئے)

877
01:04:00,447 --> 01:04:03,410
اس کا مطلب یہ ہے کہ اگرچہ وہ بہت مضبوط ہو جائیں گے

878
01:04:03,459 --> 01:04:07,530
لیکن آخر میں وہ ختم ہو جائیں گے، اور اُن کا کچھ بھی باقی نہیں رہے گا

879
01:04:07,581 --> 01:04:14,840
پس اگرچہ مسیلمہ اور اسود مسلمانوں کے لیے بہت بڑا خطرہ تھے، آج ان میں سے کوئی بھی باقی نہیں رہا

880
01:04:14,891 --> 01:04:17,283
میرا مطلب ہے کہ وہ نیست و نابود ہوئے اور صفحہ ہستی سے مٹ گئے

881
01:04:17,331 --> 01:04:25,497
رسول اللہؐ نے ان پر پھونک ماری یعنی رسول اللہؐ کا دین، ان دونوں جھوٹوں پر پھونک مارے گا اور انھیں غارت کر دے گا، ان دونوں کو تباہ کر دے گا

882
01:04:25,533 --> 01:04:28,167
اور یہ حضرت ابوبکر صدیقؓ کے زمانے میں ہوا

883
01:04:28,191 --> 01:04:32,997
پس ردّہ کی یہ تین صورتیں اس وقت موجود تھیں

884
01:04:33,040 --> 01:04:36,790
صَلَّى الله عَلى سَيَّدِنَا محمد وَعَلى اَلِهِ وَ صَحْبِهِ وَسَلِّمْ

